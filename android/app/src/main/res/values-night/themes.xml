<?xml version="1.0" encoding="utf-8"?>
<!-- The same window in dark: the bars in Iris's dark surface. -->
<resources>
    <style name="Iris" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowOptOutEdgeToEdgeEnforcement">true</item>
        <item name="android:statusBarColor">#1e1e1e</item>
        <item name="android:navigationBarColor">#1e1e1e</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowBackground">#1e1e1e</item>
    </style>
</resources>
