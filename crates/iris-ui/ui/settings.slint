import { Tokens } from "tokens.slint";
import { Floating } from "glass.slint";
import { ThemeSwatchData } from "types.slint";
import { CheckBox, SpinBox } from "std-widgets.slint";

// Un intitulé de section.
component GroupLabel inherits Text {
    font-size: 9px;
    letter-spacing: 1px;
    color: Tokens.text-muted;
}

// Un choix parmi quelques-uns, en pastilles.
//
// Une liste déroulante cacherait les options ; ici il y en a trois ou quatre, et
// les montrer toutes coûte moins cher qu'un clic pour découvrir ce qui existe.
component ChipRow inherits HorizontalLayout {
    in property <[string]> options;
    in property <int> selected;

    callback chosen(int);

    spacing: Tokens.space-1;

    for label[i] in root.options: Rectangle {
        height: 26px;
        border-radius: 99px;

        accessible-role: tab;
        accessible-label: label;
        accessible-item-selected: root.selected == i;
        accessible-action-default => { root.chosen(i); }

        background: root.selected == i
            ? Tokens.accent
            : (touch.has-hover ? Tokens.surface-hover : Tokens.surface);
        animate background { duration: Tokens.instant; }

        HorizontalLayout {
            padding-left: Tokens.space-3;
            padding-right: Tokens.space-3;

            Text {
                text: label;
                font-size: Tokens.size-small;
                font-weight: root.selected == i ? Tokens.weight-bold : Tokens.weight-body;
                color: root.selected == i ? Tokens.accent-text : Tokens.text-secondary;
                vertical-alignment: center;
            }
        }

        touch := TouchArea {
            clicked => { root.chosen(i); }
        }
    }

    Rectangle {}
}

// The theme picker.
//
// Each entry shows the theme rather than naming it: three bands of its own colours,
// in the order the eye meets them on screen — ground, surface, accent. Naming alone
// makes people try each one to find out, and every trial repaints the window.
component ThemePicker inherits HorizontalLayout {
    in property <[ThemeSwatchData]> themes;
    in property <int> selected;

    callback chosen(int);

    spacing: Tokens.space-2;

    for theme[i] in root.themes: Rectangle {
        width: 78px;
        height: 46px;
        border-radius: Tokens.radius-small;
        background: theme.background;
        border-width: root.selected == i ? 2px : 1px;
        border-color: root.selected == i ? Tokens.accent : Tokens.border;
        clip: true;

        accessible-role: tab;
        accessible-label: theme.label;
        accessible-item-selected: root.selected == i;
        accessible-action-default => { root.chosen(i); }

        VerticalLayout {
            padding: Tokens.space-1;
            spacing: 3px;

            // A band of the surface colour, then one of the accent: the two things
            // that actually differ between themes at a glance.
            Rectangle {
                height: 8px;
                border-radius: 2px;
                background: theme.surface;
            }
            Rectangle {
                height: 5px;
                width: 26px;
                border-radius: 2px;
                background: theme.accent;
            }

            Rectangle {}

            Text {
                text: theme.label;
                font-size: 9px;
                color: theme.text;
                overflow: elide;
            }
        }

        touch := TouchArea {
            clicked => { root.chosen(i); }
        }
    }

    Rectangle {}
}

// Un interrupteur avec son explication.
//
// L'explication n'est pas décorative : un automatisme qu'on ne comprend pas, on le
// coupe par précaution, et l'application perd ce qui la rend utile.
component SettingToggle inherits VerticalLayout {
    in property <string> label;
    in property <string> hint;
    in-out property <bool> value;

    callback toggled(bool);

    spacing: 2px;

    CheckBox {
        text: root.label;
        checked <=> root.value;
        toggled => { root.toggled(self.checked); }
    }

    Text {
        text: root.hint;
        font-size: Tokens.size-small;
        color: Tokens.text-muted;
        wrap: word-wrap;
    }
}

// Les réglages.
//
// Trois sections, parce que ce sont les trois choses qui se règlent : l'apparence,
// la densité, et ce que l'application fait toute seule. Tout le reste appartient au
// thème, qui est un fichier.
export component SettingsPanel inherits Rectangle {
    in property <[ThemeSwatchData]> themes;
    in property <int> active-theme;
    in property <int> density;
    in-out property <bool> reply-marks-waiting;
    in-out property <bool> new-message-reopens;
    in-out property <bool> follow-up-enabled;
    in-out property <int> follow-up-days;

    callback theme-chosen(int);
    callback density-chosen(int);
    callback automation-changed();
    callback dismissed();

    background: #00000066;

    TouchArea {
        clicked => { root.dismissed(); }
    }

    Floating {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: min(520px, parent.width - 80px);
        height: min(560px, parent.height - 80px);

        // Le panneau avale les clics : sans cela, régler une case fermerait la
        // fenêtre en touchant le voile derrière.
        TouchArea {}

        VerticalLayout {
            padding: Tokens.space-4;
            spacing: Tokens.space-3;

            HorizontalLayout {
                Text {
                    text: "Settings";
                    font-family: Tokens.font-family;
                    font-size: Tokens.size-title;
                    font-weight: Tokens.weight-bold;
                    color: Tokens.text;
                }

                Rectangle {}

                Rectangle {
                    width: 24px;
                    height: 24px;
                    border-radius: Tokens.radius-small;
                    background: fermer.has-hover ? Tokens.surface-hover : transparent;

                    accessible-role: button;
                    accessible-label: "Close settings";
                    accessible-action-default => { root.dismissed(); }

                    Text {
                        text: "✕";
                        font-size: Tokens.size-small;
                        color: Tokens.text-muted;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    fermer := TouchArea {
                        clicked => { root.dismissed(); }
                    }
                }
            }

            Rectangle { height: 1px; background: Tokens.border; }

            GroupLabel { text: "THEME"; }

            ThemePicker {
                themes: root.themes;
                selected: root.active-theme;
                chosen(i) => { root.theme-chosen(i); }
            }

            GroupLabel { text: "LIST DENSITY"; }

            ChipRow {
                options: ["Compact", "Normal", "Comfortable"];
                selected: root.density;
                chosen(i) => { root.density-chosen(i); }
            }

            GroupLabel { text: "AUTOMATIONS"; }

            SettingToggle {
                label: "Replying marks the thread as waiting";
                hint: "The thread leaves your queue and waits for the other side.";
                value <=> root.reply-marks-waiting;
                toggled => { root.automation-changed(); }
            }

            SettingToggle {
                label: "A new message reopens the thread";
                hint: "A finished thread that gets a follow-up comes back to your queue.";
                value <=> root.new-message-reopens;
                toggled => { root.automation-changed(); }
            }

            SettingToggle {
                label: "Follow up on unanswered threads";
                hint: "A thread waiting too long comes back on its own.";
                value <=> root.follow-up-enabled;
                toggled => { root.automation-changed(); }
            }

            if root.follow-up-enabled: HorizontalLayout {
                spacing: Tokens.space-2;

                Text {
                    text: "After";
                    font-size: Tokens.size-body;
                    color: Tokens.text-secondary;
                    vertical-alignment: center;
                }

                SpinBox {
                    minimum: 1;
                    maximum: 365;
                    value <=> root.follow-up-days;
                    edited => { root.automation-changed(); }
                }

                Text {
                    text: "days";
                    font-size: Tokens.size-body;
                    color: Tokens.text-secondary;
                    vertical-alignment: center;
                }

                Rectangle {}
            }

            Rectangle {}

            Text {
                text: "Settings are saved as you change them.";
                font-size: Tokens.size-small;
                color: Tokens.text-muted;
            }
        }
    }
}
