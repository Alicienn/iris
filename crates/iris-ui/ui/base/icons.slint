    out property <string> table: "M 5.5 4.5 H 18.5 A 1 1 0 0 1 19.5 5.5 V 18.5 A 1 1 0 0 1 18.5 19.5 H 5.5 A 1 1 0 0 1 4.5 18.5 V 5.5 A 1 1 0 0 1 5.5 4.5 Z M 4.5 9.5 H 19.5 M 4.5 14.5 H 19.5 M 10 9.5 V 19.5";
    out property <string> align-left: "M 4 6 H 20 M 4 10 H 14 M 4 14 H 20 M 4 18 H 14";
    out property <string> align-center: "M 4 6 H 20 M 7 10 H 17 M 4 14 H 20 M 7 18 H 17";
    out property <string> align-right: "M 4 6 H 20 M 10 10 H 20 M 4 14 H 20 M 10 18 H 20";
    out property <string> wrap: "M 4 6 H 20 M 4 12 H 16.5 A 3 3 0 0 1 16.5 18 H 12 M 14 15.5 L 11.5 18 L 14 20.5 M 4 18 H 8";
    out property <string> border: "M 4.5 4.5 H 19.5 V 19.5 H 4.5 Z M 12 4.5 V 19.5 M 4.5 12 H 19.5";
    out property <string> fill: "M 12 4 C 12 4 6.5 10.5 6.5 14.2 A 5.5 5.5 0 0 0 17.5 14.2 C 17.5 10.5 12 4 12 4 Z";
    out property <string> text-colour: "M 6.5 16.5 L 12 4 L 17.5 16.5 M 8.6 12 H 15.4";
    out property <string> sort: "M 7 4.5 V 19.5 M 4 16.5 L 7 19.5 L 10 16.5 M 13 7 H 20 M 13 12 H 18 M 13 17 H 16";
    out property <string> freeze: "M 5.5 4.5 H 18.5 A 1 1 0 0 1 19.5 5.5 V 18.5 A 1 1 0 0 1 18.5 19.5 H 5.5 A 1 1 0 0 1 4.5 18.5 V 5.5 A 1 1 0 0 1 5.5 4.5 Z M 4.5 9.5 H 19.5 M 4.5 8 H 19.5";
    out property <string> undo: "M 9 6 L 4.5 10.5 L 9 15 M 4.5 10.5 H 14.5 A 5 5 0 0 1 14.5 20.5 H 11";
    out property <string> redo: "M 15 6 L 19.5 10.5 L 15 15 M 19.5 10.5 H 9.5 A 5 5 0 0 0 9.5 20.5 H 13";
    out property <string> function: "M 11 4.5 H 10 A 2.5 2.5 0 0 0 7.5 7 V 19.5 M 5 11 H 10.5 M 13.5 11 L 19.5 19.5 M 19.5 11 L 13.5 19.5";
    // The compass of Growth: a needle in a circle.
    out property <string> compass: "M 3.5 12 A 8.5 8.5 0 1 0 20.5 12 A 8.5 8.5 0 1 0 3.5 12 Z M 15.5 8.5 L 13.2 13.2 L 8.5 15.5 L 10.8 10.8 Z";
    // A review: an arrow coming round.
    out property <string> review: "M 19 12 A 7 7 0 1 1 16.5 6.6 M 17 3 V 7 H 13";
    // Growth: a sprout, two leaves on a stem.
    out property <string> sprout: "M 12 20 V 11 M 12 12 C 12 7.5 8.5 5 4.5 5 C 4.5 9.5 7.5 12 12 12 Z M 12 14 C 12 10 15 7.5 19.5 7.5 C 19.5 11.5 16.5 14 12 14 Z";
    // A streak kept: a flame, drawn filled.
    out property <string> flame: "M 12 21 C 8 21 5.5 18.4 5.5 15 C 5.5 11 9 9.5 9.5 5.5 C 12.5 7.5 13 10 12.8 11.5 C 14 11 14.8 9.8 15 8.5 C 17.2 10.3 18.5 12.6 18.5 15 C 18.5 18.4 16 21 12 21 Z";
    // The habits' own marks.
    out property <string> run: "M 12.6 4.8 A 1.6 1.6 0 1 0 15.8 4.8 A 1.6 1.6 0 1 0 12.6 4.8 Z M 6 12 L 9.5 8.5 L 13.5 9 L 11.5 13.5 L 15 16 L 14 20.5 M 11.5 13.5 L 8.5 17 L 5 17.5 M 13.5 9 L 16 12 L 19 12";
    out property <string> drop: "M 12 3.5 C 12 3.5 5.5 10.5 5.5 14.5 A 6.5 6.5 0 0 0 18.5 14.5 C 18.5 10.5 12 3.5 12 3.5 Z";
    out property <string> chat: "M 4 5.5 H 20 V 15.5 H 11 L 6.5 19.5 V 15.5 H 4 Z M 8 10.5 H 16";
    out property <string> phone: "M 9.5 3.5 H 14.5 A 2.5 2.5 0 0 1 17 6 V 18 A 2.5 2.5 0 0 1 14.5 20.5 H 9.5 A 2.5 2.5 0 0 1 7 18 V 6 A 2.5 2.5 0 0 1 9.5 3.5 Z M 5 5 L 19 19";
    out property <string> moon: "M 19 14.5 A 7.5 7.5 0 1 1 9.5 5 A 6 6 0 0 0 19 14.5 Z";
    out property <string> heart: "M 12 20 C 5 15 3.5 11.5 3.5 9 A 4.5 4.5 0 0 1 12 7 A 4.5 4.5 0 0 1 20.5 9 C 20.5 11.5 19 15 12 20 Z";
    out property <string> leaf: "M 5 19 C 5 10 10 5 19.5 4.5 C 19 14 14 19 5 19 Z M 5 19 L 13 11";
    out property <string> music: "M 6.5 18 A 2.5 2.5 0 1 0 11.5 18 A 2.5 2.5 0 1 0 6.5 18 Z M 14 16 A 2.5 2.5 0 1 0 19 16 A 2.5 2.5 0 1 0 14 16 Z M 11.5 18 V 5.5 L 19 4 V 16 M 11.5 9 L 19 7.5";
    out property <string> coin: "M 3.5 12 A 8.5 8.5 0 1 0 20.5 12 A 8.5 8.5 0 1 0 3.5 12 Z M 14.5 9 C 13.5 8 10 7.8 10 10 C 10 12.5 14.5 11.5 14.5 14 C 14.5 16.2 11 16 9.5 15 M 12 6.5 V 8 M 12 16 V 17.5";
    out property <string> cap: "M 2.5 9.5 L 12 5 L 21.5 9.5 L 12 14 Z M 6.5 11.5 V 16 C 9 18.5 15 18.5 17.5 16 V 11.5";
}

// The icon of a habit, by the word it is stored under.
export global HabitIcons {
    /// The words a habit's icon can be, in the order they are offered.
    out property <[string]> words: [
        "book", "run", "drop", "chat", "heart", "leaf", "moon", "phone",
        "pencil", "music", "coin", "cap", "sun", "sparkle",
    ];
    public pure function path(word: string) -> string {
        return word == "book" ? Icons.book
            : word == "run" ? Icons.run
            : word == "drop" ? Icons.drop
            : word == "chat" ? Icons.chat
            : word == "heart" ? Icons.heart
            : word == "leaf" ? Icons.leaf
            : word == "moon" ? Icons.moon
            : word == "phone" ? Icons.phone
            : word == "pencil" ? Icons.pencil
            : word == "music" ? Icons.music
            : word == "coin" ? Icons.coin
            : word == "cap" ? Icons.cap
            : word == "sun" ? Icons.sun
            : Icons.sparkle;
    }
}

// One icon.
//
// The stroke width is expressed in grid units and scaled with the icon, so a 14-pixel
// icon and a 20-pixel one look like the same pen rather than two different ones.
export component Icon inherits Rectangle {
    in property <string> data;
    in property <length> size: 16px;
    in property <brush> tint: Tokens.text-secondary;
    in property <float> alpha: 1.0;
    in property <float> weight: 1.6;

    width: root.size;
    height: root.size;
    opacity: root.alpha;

    in property <bool> filled;

    Path {
        width: 100%;
        height: 100%;
        viewbox-x: 0;
        viewbox-y: 0;
        viewbox-width: 24;
        viewbox-height: 24;
        commands: root.data;
        stroke: root.tint;
        stroke-width: root.weight / 24 * root.size;
        // Round ends and joins, as every drawn icon set has them. Square ends made
        // each stroke stop like a cut, and the icons read as rough.
        stroke-line-cap: round;
        stroke-line-join: round;
        fill: root.filled ? root.tint : transparent;
    }
}

// A square button whose whole content is one icon.
//
// Having one of these rather than a dozen near-copies is what stops the hover states
// drifting apart from each other over time.
export component IconButton inherits Rectangle {
    in property <string> icon;
    in property <string> label;
    in property <string> shortcut;
    in property <bool> danger;
    in property <bool> active;
    in property <bool> enabled: true;
    in property <bool> filled;
    // An explicit colour, for the few markers whose meaning is the colour: a mailbox
    // that has stopped working is red before it is anything else.
    in property <brush> tint;
    in property <bool> tinted;
    in property <length> icon-size: 16px;
    in property <length> button-size: 28px;
    /// Filled by a click (a star): the icon gives a little bounce.
    in property <bool> bounce;

    callback clicked();

    property <float> bond;
    animate bond { duration: 120ms; easing: ease-out; }
    changed filled => {
        if (root.bounce && root.filled) {
            root.bond = 1;
            retombe.running = true;
        }
    }
    retombe := Timer {
        interval: 120ms;
        running: false;
        triggered => {
            self.running = false;
            root.bond = 0;
        }
    }

    width: root.button-size;
    height: root.button-size;
    border-radius: root.button-size >= 28px ? Tokens.radius-medium : Tokens.radius-small;
    // Pressed reads as pressed: the active surface while the pointer is down, so a
    // click is felt before its result shows.
    background: root.active || (touch.pressed && root.enabled)
        ? Tokens.surface-active
        : (touch.has-hover && root.enabled ? Tokens.surface-hover : transparent);
    animate background { duration: Tokens.instant; }

    accessible-role: button;
    accessible-label: root.label;
    accessible-description: root.shortcut;
    accessible-enabled: root.enabled;
    accessible-action-default => { root.clicked(); }

    Icon {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        data: root.icon;
        size: root.icon-size * (1 + 0.35 * root.bond);
        filled: root.filled;
        tint: root.tinted
            ? root.tint
            : (root.danger && touch.has-hover
                ? Tokens.error
                : (root.active || touch.has-hover ? Tokens.text : Tokens.text-muted));
        alpha: root.enabled ? 1.0 : 0.4;
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }

    // L'infobulle porte le raccourci : la barre d'outils enseigne le clavier au lieu
    // de lui faire concurrence.
    //
    // C'est l'élément natif de Slint et non un rectangle posé sous le bouton. Le
    // rectangle était un enfant du bouton, avec deux conséquences que trois rapports
    // successifs ont décrites sans les relier :
    //
    // - **il passait dessous.** Le corps du message est dessiné après la barre
    //   d'outils, donc par-dessus ; l'infobulle « Mark as done » et le texte du
    //   message se superposaient et aucun des deux ne se lisait ;
    // - **il sortait de l'écran.** Rien ne le bornait à la fenêtre, alors l'infobulle
    //   du bouton le plus à droite débordait en plein écran.
    //
    // Une infobulle native est composée dans une couche au-dessus de tout et repliée
    // à l'intérieur de la fenêtre par le moteur. Les deux défauts disparaissent parce
    // qu'ils venaient du même endroit : ce n'était pas une infobulle, c'était un
    // rectangle qui lui ressemblait.
    // Assemblé à part : l'infobulle est typée « styled-text » et `@markdown` prend une
    // interpolation, pas un ternaire imbriqué avec ses guillemets échappés.
    property <string> tooltip-text: root.shortcut == ""
        ? root.label
        : root.label + "  " + root.shortcut;

    if root.label != "": Tooltip {
        // Le libellé et le raccourci ne portent aucune syntaxe : ce sont des noms de
        // commandes et des combinaisons de touches, écrits par nous.
        text: @markdown("\{root.tooltip-text}");
    }
}
