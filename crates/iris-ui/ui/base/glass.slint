import { Tokens } from "@iris/theme/tokens.slint";

// Surfaces. Flat: a colour from the theme, a hairline where one surface meets
// another, and a shadow only under what floats over the rest.
//
// (The names are those of the glass these replace: translucent panels over a halo,
// with grain and a lit edge. The look changed; every screen still says `Glass`.)

/// A panel: white in light, graphite in dark. A floating one is the popover colour.
export component Glass inherits Rectangle {
    in property <bool> floating: false;
    in property <bool> elevated: false;
    in property <length> radius: Tokens.radius-medium;

    border-radius: root.radius;
    background: root.floating ? Tokens.panel : (root.elevated ? Tokens.surface-high : Tokens.surface);
    border-width: 1px;
    border-color: Tokens.border;

    @children
}

/// What floats over the rest (menus, the palette): the popover colour, a stronger
/// edge, and a shadow.
export component Floating inherits Rectangle {
    in property <length> radius: Tokens.radius-large;

    drop-shadow-blur: Tokens.shadow-window-blur;
    drop-shadow-color: Tokens.shadow-window;
    drop-shadow-offset-y: Tokens.shadow-window-y;
    border-radius: root.radius;
    background: Tokens.panel;
    border-width: 1px;
    border-color: Tokens.border-strong;

    @children
}

/// The window's ground.
export component Backdrop inherits Rectangle {
    background: Tokens.background;
    @children
}
