import { Tokens } from "tokens.slint";
import { ThreadRowData } from "types.slint";
import { ListView, LineEdit } from "std-widgets.slint";
import { Icon, Icons, IconButton } from "icons.slint";
import { MenuEntry, MenuSeparator, MenuSurface } from "menu.slint";

// Une ligne de la liste.
//
// Elle ne calcule rien : tous ses champs arrivent prêts à dessiner. Une ligne qui
// formaterait sa date ferait ce travail soixante fois par seconde pendant un
// défilement, pour un texte qui ne change pas.
component ThreadRow inherits Rectangle {
    in property <ThreadRowData> data;
    in property <bool> selected;

    callback clicked();
    callback mark-toggled();
    callback mark-extended();

    // Vrai entre un appui modifié et le relâchement qui le suit.
    property <bool> modified-click;
    callback context-menu(length, length);

    height: Tokens.row-height;
    background: root.selected
        ? Tokens.surface-active
        : (row-touch.has-hover ? Tokens.surface-hover : transparent);

    animate background { duration: Tokens.instant; }

    // Ce qu'un lecteur d'écran annonce. L'ordre suit celui de la lecture visuelle —
    // qui écrit, à quel sujet, quand — parce que c'est l'ordre dans lequel on décide
    // si un message mérite qu'on s'y arrête.
    accessible-role: list-item;
    accessible-label: root.data.from + ", " + root.data.subject + ", " + root.data.date;
    accessible-description: root.data.unread ? "Unread" : "Read";
    accessible-item-selected: root.selected;
    accessible-item-selectable: true;
    accessible-action-default => { root.clicked(); }

    // Le marqueur de sélection : un trait vertical, pas un fond coloré. Sur une
    // liste dense, un aplat de couleur écrase la lisibilité du texte.
    Rectangle {
        x: 0;
        width: root.selected ? 2px : 0px;
        height: 100%;
        background: Tokens.accent;
        animate width { duration: Tokens.instant; }
    }

    // Pastille d'identité du compte, à gauche. Indispensable en vue unifiée : sans
    // elle, cent boîtes se ressemblent toutes.
    Rectangle {
        x: Tokens.space-1;
        y: (parent.height - self.height) / 2;
        width: 3px;
        height: 24px;
        border-radius: 2px;
        background: root.data.account-tint;
        opacity: 0.8;
    }

    HorizontalLayout {
        padding-left: Tokens.row-padding-x;
        padding-right: Tokens.row-padding-x;
        spacing: Tokens.space-2;

        // La case à cocher. Elle n'apparaît qu'au survol ou quand elle est cochée :
        // une colonne de cases vides devant chaque ligne fait passer la liste pour un
        // formulaire, et le cas courant reste de lire un message, pas d'en cocher
        // quarante.
        if root.data.marked || row-touch.has-hover: Rectangle {
            width: 15px;
            height: 15px;
            y: (parent.height - self.height) / 2;
            border-radius: 4px;
            border-width: 1px;
            border-color: root.data.marked ? Tokens.accent : Tokens.border-strong;
            background: root.data.marked ? Tokens.accent : transparent;

            accessible-role: checkbox;
            accessible-label: "Select this conversation";
            accessible-checked: root.data.marked;
            accessible-action-default => { root.mark-toggled(); }

            if root.data.marked: Icon {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                data: Icons.check;
                size: 11px;
                weight: 3.0;
                tint: Tokens.accent-text;
            }

            TouchArea {
                clicked => { root.mark-toggled(); }
            }
        }

        VerticalLayout {
            padding-top: Tokens.space-2;
            padding-bottom: Tokens.space-2;
            spacing: 2px;

            // Ligne du haut : expéditeur, marqueurs, date.
            HorizontalLayout {
                spacing: Tokens.space-2;

                Text {
                    text: root.data.from;
                    font-family: Tokens.font-family;
                    font-size: Tokens.size-body;
                    font-weight: root.data.unread ? Tokens.weight-bold : Tokens.weight-body;
                    color: Tokens.text;
                    overflow: elide;
                }

                // Compteur de messages du fil. Absent quand il n'y en a qu'un :
                // afficher « 1 » partout n'apprend rien et encombre.
                if root.data.message-count > 1: Text {
                    text: root.data.message-count;
                    font-size: Tokens.size-small;
                    color: Tokens.text-muted;
                    vertical-alignment: center;
                }

                Rectangle {} // pousse la suite à droite

                // Drawn, not typed. These four were "◆▣◉⏱" — characters that exist
                // in Unicode and in almost no interface font, so what appeared next
                // to the date was whatever the fallback had, and where it had
                // nothing, an empty box. A starred thread showed a lozenge because
                // the lozenge is the one of the four that Inter happens to carry.
                if root.data.flagged: Icon {
                    y: (parent.height - self.height) / 2;
                    data: Icons.star;
                    size: 13px;
                    filled: true;
                    tint: Tokens.warning;
                }
                if root.data.has-attachment: Icon {
                    y: (parent.height - self.height) / 2;
                    data: Icons.paperclip;
                    size: 13px;
                    tint: Tokens.text-muted;
                }
                // Le traqueur se signale par la forme, pas par la couleur : le thème
                // par défaut n'en a pas.
                if root.data.has-tracker: Icon {
                    y: (parent.height - self.height) / 2;
                    data: Icons.eye;
                    size: 13px;
                    tint: Tokens.text-muted;
                }
                if root.data.snoozed: Icon {
                    y: (parent.height - self.height) / 2;
                    data: Icons.clock;
                    size: 13px;
                    tint: Tokens.text-muted;
                }

                Text {
                    text: root.data.date;
                    font-size: Tokens.size-small;
                    color: Tokens.text-muted;
                    vertical-alignment: center;
                }
            }

            Text {
                text: root.data.subject;
                font-family: Tokens.font-family;
                font-size: Tokens.size-body;
                font-weight: root.data.unread ? Tokens.weight-bold : Tokens.weight-body;
                color: root.data.unread ? Tokens.text : Tokens.text-secondary;
                overflow: elide;
            }

            Text {
                text: root.data.preview;
                font-size: Tokens.size-small;
                color: Tokens.text-muted;
                overflow: elide;
            }
        }
    }

    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: Tokens.border;
        opacity: 0.5;
    }

    row-touch := TouchArea {
        // Right-click is how everyone expects to reach the actions on a list row,
        // and it was reaching nothing.
        //
        // Ctrl and Shift are read here rather than in Rust: which row was clicked and
        // which keys were down are one event, and splitting them across the boundary
        // would mean guessing afterwards which click a modifier belonged to.
        pointer-event(event) => {
            if (event.button == PointerEventButton.right
                && event.kind == PointerEventKind.down) {
                root.clicked();
                root.context-menu(self.mouse-x + root.x, self.mouse-y + root.y);
            } else if (event.button == PointerEventButton.left
                && event.kind == PointerEventKind.down) {
                if (event.modifiers.shift) {
                    root.modified-click = true;
                    root.mark-extended();
                } else if (event.modifiers.control) {
                    root.modified-click = true;
                    root.mark-toggled();
                }
            }
        }
        clicked => {
            // Un clic simple ouvre. Un clic modifié a déjà été traité à l'appui :
            // ouvrir en plus ferait deux choses pour un seul geste, et la seconde
            // serait celle que l'utilisateur n'a pas demandée.
            if (root.modified-click) {
                root.modified-click = false;
            } else {
                root.clicked();
            }
        }
    }
}

// The menu a right-click opens.
//
// It carries the same actions as the reading toolbar and the same shortcuts, because
// three ways to do a thing that disagree about what it is called is worse than one.
export component ThreadContextMenu inherits Rectangle {
    in property <bool> unread;
    in property <bool> starred;
    in property <length> menu-x;
    in property <length> menu-y;

    callback open-thread();
    callback mark-done();
    callback archive();
    callback snooze();
    callback toggle-unread();
    callback toggle-star();
    callback delete-thread();
    callback dismissed();

    // The veil catches the click that closes the menu. Without it the menu stays up
    // until something else happens to take the focus.
    TouchArea {
        width: 100%;
        height: 100%;
        clicked => { root.dismissed(); }
    }

    MenuSurface {
        available-width: root.width;
        available-height: root.height;
        menu-x: root.menu-x;
        menu-y: root.menu-y;
        menu-width: 210px;
        menu-height: entries.preferred-height + 8px;

        entries := VerticalLayout {
            padding: 4px;

            MenuEntry {
                icon: Icons.envelope-open;
                label: "Open";
                activated => { root.open-thread(); root.dismissed(); }
            }
            MenuEntry {
                icon: Icons.check;
                label: "Mark as done";
                shortcut: "E";
                activated => { root.mark-done(); root.dismissed(); }
            }
            MenuEntry {
                icon: Icons.archive;
                label: "Archive";
                shortcut: "A";
                activated => { root.archive(); root.dismissed(); }
            }
            MenuEntry {
                icon: Icons.clock;
                label: "Snooze until tomorrow";
                shortcut: "S";
                activated => { root.snooze(); root.dismissed(); }
            }

            MenuSeparator {}

            MenuEntry {
                icon: root.unread ? Icons.envelope-open : Icons.envelope-closed;
                label: root.unread ? "Mark as read" : "Mark as unread";
                shortcut: "R";
                activated => { root.toggle-unread(); root.dismissed(); }
            }
            MenuEntry {
                icon: Icons.star;
                label: root.starred ? "Remove star" : "Star";
                shortcut: "F";
                activated => { root.toggle-star(); root.dismissed(); }
            }

            MenuSeparator {}

            MenuEntry {
                icon: Icons.trash;
                label: "Delete";
                shortcut: "Shift+3";
                danger: true;
                activated => { root.delete-thread(); root.dismissed(); }
            }
        }
    }
}

// La barre des actions groupées.
//
// Elle **remplace** les onglets tant qu'un lot est coché, au lieu de s'ajouter au
// dessus. Deux raisons : la place, et le fait qu'un lot coché est un mode — ce qui va
// se passer ensuite porte sur les lignes cochées et sur rien d'autre, et une barre
// d'onglets encore visible au-dessus laisserait croire qu'on peut changer de file
// sans conséquence pour la sélection.
export component BulkBar inherits Rectangle {
    in property <int> count;
    in property <string> count-label;

    callback mark-done();
    callback archive();
    callback delete-selected();
    callback mark-read();
    callback mark-unread();
    callback select-all();
    callback clear();

    height: 30px;
    border-radius: Tokens.radius-medium;
    background: Tokens.surface-low;
    border-width: 1px;
    border-color: Tokens.border-strong;

    HorizontalLayout {
        padding-left: Tokens.space-2;
        padding-right: 3px;
        spacing: Tokens.space-1;

        Text {
            text: root.count-label + " selected";
            font-size: Tokens.size-small;
            font-weight: Tokens.weight-bold;
            color: Tokens.text;
            vertical-alignment: center;
        }

        Rectangle { width: Tokens.space-1; }

        IconButton {
            icon: Icons.check;
            label: "Mark as done";
            shortcut: "E";
            button-size: 24px;
            icon-size: 14px;
            clicked => { root.mark-done(); }
        }
        IconButton {
            icon: Icons.archive;
            label: "Archive";
            shortcut: "A";
            button-size: 24px;
            icon-size: 14px;
            clicked => { root.archive(); }
        }
        IconButton {
            icon: Icons.envelope-open;
            label: "Mark as read";
            button-size: 24px;
            icon-size: 14px;
            clicked => { root.mark-read(); }
        }
        IconButton {
            icon: Icons.envelope-closed;
            label: "Mark as unread";
            button-size: 24px;
            icon-size: 14px;
            clicked => { root.mark-unread(); }
        }
        IconButton {
            icon: Icons.trash;
            label: "Delete";
            button-size: 24px;
            icon-size: 14px;
            danger: true;
            clicked => { root.delete-selected(); }
        }

        Rectangle {}

        IconButton {
            icon: Icons.list;
            label: "Select everything loaded";
            shortcut: "Ctrl+A";
            button-size: 24px;
            icon-size: 14px;
            clicked => { root.select-all(); }
        }
        IconButton {
            icon: Icons.window-close;
            label: "Clear the selection";
            shortcut: "Esc";
            button-size: 24px;
            icon-size: 14px;
            clicked => { root.clear(); }
        }
    }
}

// Les onglets d'état.
export component StateTabs inherits HorizontalLayout {
    in property <int> active;
    in property <[int]> counts;
    // The same counts twice: short enough for the pill, and exact for the hover.
    // "1.2k" is what a tab can hold; "1 250" is what someone checking actually wants,
    // and making them choose between the two is what a tooltip is for.
    in property <[string]> count-labels;
    in property <[string]> count-fulls;

    callback selected(int);

    padding: 3px;
    spacing: 2px;
    vertical-stretch: 0;
    height: 30px;

    for label[i] in ["To do", "Waiting", "Done"]: Rectangle {
        border-radius: Tokens.radius-small;

        accessible-role: tab;
        accessible-label: label;
        accessible-description: root.counts[i] + " conversations";
        accessible-item-selected: root.active == i;
        accessible-action-default => { root.selected(i); }

        background: root.active == i
            ? Tokens.accent
            : (tab-touch.has-hover ? Tokens.surface-hover : Tokens.surface);
        animate background { duration: Tokens.instant; }

        HorizontalLayout {
            padding-left: Tokens.space-3;
            padding-right: Tokens.space-3;
            spacing: Tokens.space-2;

            Text {
                text: label;
                font-size: Tokens.size-small;
                font-weight: root.active == i
                    ? Tokens.weight-bold
                    : Tokens.weight-body;
                color: root.active == i
                    ? Tokens.accent-text
                    : Tokens.text-secondary;
                vertical-alignment: center;
            }

            // Le compteur n'apparaît que s'il y a quelque chose à compter. Un « 0 »
            // permanent est un bruit visuel sans information.
            if root.counts[i] > 0: Text {
                text: root.count-labels[i];
                font-size: Tokens.size-small;
                color: root.active == i
                    ? Tokens.accent-text
                    : Tokens.text-muted;
                vertical-alignment: center;
            }
        }

        tab-touch := TouchArea {
            clicked => { root.selected(i); }
        }

        // Only where the shortening actually hid something. A tooltip that repeats
        // the label teaches the user that tooltips are not worth waiting for.
        if tab-touch.has-hover && root.count-labels[i] != root.count-fulls[i]: Rectangle {
            y: parent.height + 4px;
            width: exact.preferred-width + 12px;
            height: 20px;
            border-radius: Tokens.radius-small;
            background: Tokens.panel-high;
            border-width: 1px;
            border-color: Tokens.border-strong;
            drop-shadow-blur: 12px;
            drop-shadow-color: #00000066;
            drop-shadow-offset-y: 3px;

            exact := Text {
                text: root.count-fulls[i];
                font-size: Tokens.size-small;
                color: Tokens.text;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }

    // Rien après les trois files. Les indésirables avaient un quatrième onglet ici,
    // ce qui en faisait une quatrième étape du travail alors que c'est un endroit où
    // le courrier est rangé — comme la corbeille, qui n'a jamais eu d'onglet. Ils sont
    // dans l'arborescence maintenant, à leur place.
    Rectangle {}
}

// La barre de recherche.
//
// Elle est au-dessus des onglets et non dans une fenêtre à part : chercher, c'est
// filtrer la colonne du milieu, et le résultat doit apparaître là où le regard est
// déjà posé.
export component SearchBar inherits VerticalLayout {
    in property <string> summary;
    in property <string> explanation;
    in property <bool> active;
    in-out property <string> query;

    callback submitted(string);
    callback cleared();

    public function focus-field() {
        field.focus();
        field.select-all();
    }

    padding-left: Tokens.space-2;
    padding-right: Tokens.space-2;
    padding-top: Tokens.space-2;
    spacing: Tokens.space-1;

    // Take the height it needs and no more. Inside a vertical layout every child
    // stretches by default, so with an empty list the search field was inflating to
    // fill the column — a text input the height of the window.
    vertical-stretch: 0;

    HorizontalLayout {
        spacing: Tokens.space-1;
        vertical-stretch: 0;
        height: 30px;

        field := LineEdit {
            accessible-label: "Search";
            placeholder-text: "Search — from:marie is:unread…";
            font-size: Tokens.size-small;
            text <=> root.query;
            accepted(t) => { root.submitted(t); }
            // Vider le champ suffit à sortir : demander un second geste pour revenir
            // à la file serait une porte qui ne s'ouvre que dans un sens.
            edited(t) => {
                if (t == "" && root.active) { root.cleared(); }
            }
        }

        if root.active: Rectangle {
            width: 24px;
            border-radius: Tokens.radius-small;
            background: close-touch.has-hover ? Tokens.surface-hover : transparent;

            accessible-role: button;
            accessible-label: "Leave search";
            accessible-action-default => {
                root.query = "";
                root.cleared();
            }

            Icon {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                data: Icons.window-close;
                size: 12px;
                tint: close-touch.has-hover ? Tokens.text : Tokens.text-muted;
            }

            close-touch := TouchArea {
                clicked => {
                    root.query = "";
                    root.cleared();
                }
            }
        }
    }

    // Ce qui a été compris, rendu à l'utilisateur. Une syntaxe de recherche que
    // personne ne confirme est une syntaxe que personne n'apprend.
    if root.active: HorizontalLayout {
        spacing: Tokens.space-2;
        vertical-stretch: 0;

        Text {
            text: root.summary;
            font-size: Tokens.size-small;
            color: Tokens.text-secondary;
        }
        Text {
            text: root.explanation;
            font-size: Tokens.size-small;
            color: Tokens.text-muted;
            overflow: elide;
        }
    }
}

// La liste des conversations.
export component ThreadListView inherits VerticalLayout {
    in property <[ThreadRowData]> rows;
    in property <int> selected-id;
    in property <int> active-tab;
    in property <[int]> counts;
    in property <bool> loading;
    in property <string> empty-message: "Nothing to do.";
    in property <bool> searching;
    in property <[string]> count-labels;
    in property <[string]> count-fulls;
    // Le nom du dossier montré, quand ce n'en est pas une file. Il remplace les
    // onglets : « Trash » avec les trois files allumées au-dessus décrirait un écran
    // qui n'existe pas.
    in property <string> folder-name;
    in property <string> search-summary;
    in property <string> search-explanation;
    in property <int> marked-count;
    in property <string> marked-label;
    in-out property <string> search-query;

    callback row-clicked(int);
    callback tab-selected(int);
    callback scrolled-near-end();
    callback search-submitted(string);
    callback search-cleared();
    callback folder-left();
    callback row-context-menu(int, length, length);
    callback row-mark-toggled(int);
    callback row-mark-extended(int);
    callback bulk-done();
    callback bulk-archive();
    callback bulk-delete();
    callback bulk-read();
    callback bulk-unread();
    callback bulk-select-all();
    callback bulk-clear();

    public function focus-search() {
        bar.focus-field();
    }

    bar := SearchBar {
        active: root.searching;
        summary: root.search-summary;
        explanation: root.search-explanation;
        query <=> root.search-query;
        submitted(q) => { root.search-submitted(q); }
        cleared => { root.search-cleared(); }
    }

    // Pendant une recherche, les onglets disparaissent : les résultats ne sont pas
    // rangés par file, et laisser un onglet allumé au-dessus d'eux désignerait une
    // liste qui n'est pas celle qu'on regarde.
    // The tabs sit on a plate of their own rather than floating: three lozenges on
    // bare background read as debris, which is exactly how they looked.
    if root.marked-count > 0: Rectangle {
        vertical-stretch: 0;
        height: 38px;

        BulkBar {
            x: Tokens.space-2;
            y: 4px;
            width: parent.width - 2 * Tokens.space-2;
            count: root.marked-count;
            count-label: root.marked-label;
            mark-done => { root.bulk-done(); }
            archive => { root.bulk-archive(); }
            delete-selected => { root.bulk-delete(); }
            mark-read => { root.bulk-read(); }
            mark-unread => { root.bulk-unread(); }
            select-all => { root.bulk-select-all(); }
            clear => { root.bulk-clear(); }
        }
    }

    // Dans un dossier, son nom prend la place des onglets. Les trois files décrivent
    // un travail ; un dossier décrit un endroit, et laisser « À faire » allumé au
    // dessus du contenu de la corbeille désignerait une liste qui n'est pas celle
    // qu'on regarde.
    if !root.searching && root.marked-count == 0 && root.folder-name != "": Rectangle {
        vertical-stretch: 0;
        height: 38px;

        HorizontalLayout {
            x: Tokens.space-2;
            y: 4px;
            width: parent.width - 2 * Tokens.space-2;
            height: 30px;
            spacing: Tokens.space-2;

            Text {
                text: root.folder-name;
                font-family: Tokens.font-family;
                font-size: Tokens.size-body;
                font-weight: Tokens.weight-bold;
                color: Tokens.text;
                vertical-alignment: center;
            }

            Rectangle {}

            IconButton {
                icon: Icons.window-close;
                label: "Back to the queues";
                shortcut: "Esc";
                button-size: 24px;
                icon-size: 13px;
                clicked => { root.folder-left(); }
            }
        }
    }

    if !root.searching && root.marked-count == 0 && root.folder-name == "": Rectangle {
        vertical-stretch: 0;
        height: 38px;

        Rectangle {
            x: Tokens.space-2;
            y: 4px;
            width: parent.width - 2 * Tokens.space-2;
            height: 30px;
            border-radius: Tokens.radius-medium;
            background: Tokens.surface-low;
            border-width: 1px;
            border-color: Tokens.border;

            // The same short fall of light the glass panels get, so the strip belongs
            // to the same material as everything around it.
            Rectangle {
                y: 1px;
                height: 12px;
                width: 100%;
                border-top-left-radius: Tokens.radius-medium;
                border-top-right-radius: Tokens.radius-medium;
                background: @linear-gradient(180deg,
                    Tokens.edge-light.transparentize(0.82) 0%,
                    Tokens.edge-light.transparentize(1.0) 100%);
            }
        }

        StateTabs {
            x: Tokens.space-2;
            y: 4px;
            width: parent.width - 2 * Tokens.space-2;
            height: 30px;
            active: root.active-tab;
            counts: root.counts;
            count-labels: root.count-labels;
            count-fulls: root.count-fulls;
            selected(i) => { root.tab-selected(i); }
        }
    }

    Rectangle {
        height: 1px;
        background: Tokens.border;
    }

    if root.rows.length == 0 && !root.loading: Rectangle {
        vertical-stretch: 1;
        VerticalLayout {
            alignment: center;
            Text {
                text: root.searching
                    ? "No results."
                    : (root.folder-name != ""
                        ? root.folder-name + " is empty."
                        : root.empty-message);
                font-size: Tokens.size-body;
                color: Tokens.text-muted;
                horizontal-alignment: center;
            }
        }
    }

    if root.rows.length > 0: list := ListView {
        vertical-stretch: 1;
        for entry in root.rows: ThreadRow {
            data: entry;
            selected: entry.id == root.selected-id;
            clicked => { root.row-clicked(entry.id); }
            context-menu(x, y) => { root.row-context-menu(entry.id, x, y); }
            mark-toggled => { root.row-mark-toggled(entry.id); }
            mark-extended => { root.row-mark-extended(entry.id); }
        }

        // Le chargement de la suite est déclenché par la position du défilement, pas
        // par un bouton : la liste doit paraître infinie.
        changed viewport-y => {
            if (-self.viewport-y + self.visible-height > self.viewport-height - 400px) {
                root.scrolled-near-end();
            }
        }
    }
}
