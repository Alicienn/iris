import { Tokens } from "@iris/theme/tokens.slint";
import { Layout } from "@iris/theme/layout.slint";
import { Icon, Icons } from "@iris/base/icons.slint";
import { Chrome } from "@iris/shell/chrome.slint";

// The five places at the foot of a narrow window, as a phone has them: Home, Mail,
// Calendar, Tasks, Notes. The same places, the same order and the same badges as the
// switcher at the top of the side column, which a narrow window has no room for.

component Tab inherits Rectangle {
    in property <string> icon;
    in property <string> label;
    in property <int> place;
    /// A number on Mail, a dot on Tasks.
    in property <int> badge;
    in property <bool> dot;
    property <bool> on: Chrome.workspace == root.place;

    accessible-role: tab;
    accessible-label: root.label;
    accessible-item-selected: root.on;
    accessible-action-default => { Chrome.workspace-chosen(root.place); }

    VerticalLayout {
        alignment: center;
        spacing: 3px;
        HorizontalLayout {
            alignment: center;
            Icon {
                data: root.icon;
                size: 22px;
                tint: root.on ? Tokens.accent : Tokens.text-muted;
            }
        }
        Text {
            text: root.label;
            font-size: 11.5px;
            font-weight: root.on ? 600 : 400;
            color: root.on ? Tokens.accent : Tokens.text-muted;
            horizontal-alignment: center;
        }
    }
    if root.badge > 0: Rectangle {
        x: parent.width / 2 + 6px;
        y: 7px;
        width: max(17px, chiffre.preferred-width + 10px);
        height: 17px;
        border-radius: 9px;
        background: Tokens.accent;
        chiffre := Text {
            text: root.badge > 99 ? "99+" : root.badge;
            font-size: 10.5px;
            font-weight: 600;
            color: Tokens.accent-text;
        }
    }
    Rectangle {
        visible: root.dot && root.badge == 0;
        x: parent.width / 2 + 9px;
        y: 10px;
        width: 8px;
        height: 8px;
        border-radius: 4px;
        background: Tokens.accent;
    }
    TouchArea {
        clicked => { Chrome.workspace-chosen(root.place); }
    }
}

/// The places at the foot of the window, above the system's gesture bar.
export component TabBar inherits Rectangle {
    height: 66px + Layout.inset-bottom;
    background: Tokens.surface;

    Rectangle {
        y: 0px;
        height: 1px;
        background: Tokens.border;
    }
    HorizontalLayout {
        y: 1px;
        height: 65px;
        Tab { icon: Icons.home; label: "Home"; place: 3; }
        Tab { icon: Icons.envelope-closed; label: "Mail"; place: 0; badge: Chrome.mail-badge; }
        Tab { icon: Icons.calendar; label: "Calendar"; place: 1; }
        Tab { icon: Icons.task; label: "Tasks"; place: 2; dot: Chrome.tasks-badge > 0; }
        Tab { icon: Icons.notes; label: "Notes"; place: 4; }
    }
}
