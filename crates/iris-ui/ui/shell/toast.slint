import { Tokens } from "@iris/theme/tokens.slint";
import { Layout } from "@iris/theme/layout.slint";
import { Motion } from "@iris/theme/motion.slint";
import { Floating } from "@iris/base/glass.slint";

// The one notice of the application.
//
// Every confirmation, every "could not", every "Done" comes through here: a short
// line that rises over the window, leaves on its own, and — when what it says can be
// taken back — carries an Undo. The screens set `toast` (and, if it can be undone,
// `toast-undo`); none draws a message of its own.
//
// On a PC it is a card at the foot of the window; on a phone, the mockups' dark bar
// across the screen above the tabs.
//
// It stays instantiated, so that it can leave softly: a component removed by an `if`
// would vanish at once.
export component Toast inherits Rectangle {
    in property <string> message;
    /// The line can be taken back: an Undo is offered with it.
    in property <bool> undoable;
    /// What the window keeps at its foot (the tabs): the notice sits above it.
    in property <length> foot;

    callback undone();
    callback dismissed();

    // What is drawn is the last line shown, so that it can fade out with its words.
    property <string> texte;
    property <bool> avec-annulation;
    property <bool> montre: root.message != "";
    // The notice goes in with a spring, and out quicker and softly.
    property <float> vu: root.montre ? 1 : 0;
    animate vu { duration: root.montre ? Motion.state : Motion.close; }
    property <float> monte: root.montre ? 1 : 0;
    animate monte { duration: root.montre ? Motion.travel : Motion.close; easing: root.montre ? Motion.spring : ease-in; }

    // Four seconds, the time to read a line one expected; five when there is an Undo
    // to reach. The count restarts with each new line, or the second would inherit
    // what was left to the first.
    changed message => {
        if (root.message != "") {
            root.texte = root.message;
            root.avec-annulation = root.undoable;
            expiration.restart();
        }
    }

    expiration := Timer {
        interval: root.avec-annulation ? 5s : 4s;
        running: root.message != "";
        triggered => { root.dismissed(); }
    }

    bulle := Floating {
        visible: root.vu > 0.001;
        radius: Layout.compact ? 14px : Tokens.radius-medium;
        background: Layout.compact ? Tokens.text : Tokens.panel;
        border-width: Layout.compact ? 0px : 1px;
        x: Layout.compact ? 12px : (parent.width - self.width) / 2;
        // Above the status bar, never over it: hiding the state to announce a success
        // would trade one piece of information for another.
        y: parent.height - self.height - (Layout.compact ? root.foot + 12px : Tokens.space-6)
            + (1 - root.monte) * 14px;
        width: Layout.compact ? parent.width - 24px
            : min(rang.preferred-width + 2 * Tokens.space-3, parent.width - Tokens.space-6);
        height: Layout.compact ? 52px : 38px;
        opacity: min(1, max(0, root.vu));

        accessible-role: text;
        accessible-label: root.texte;

        // A click on the line drives it away: a confirmation already read has no
        // business in front of the content. Beneath the Undo, which is laid after it.
        TouchArea {
            clicked => { root.dismissed(); }
        }

        rang := HorizontalLayout {
            x: Layout.compact ? 18px : Tokens.space-3;
            width: parent.width - (Layout.compact ? 26px : 2 * Tokens.space-3);
            spacing: Tokens.space-3;

            // The dot says only one thing, and on purpose: a failure shows where it can
            // be corrected, in the panel it stops from closing, not in a bubble that
            // leaves.
            if !Layout.compact: VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 6px;
                    height: 6px;
                    border-radius: 3px;
                    background: Tokens.success;
                }
            }

            libelle := Text {
                text: root.texte;
                font-family: Tokens.font-family;
                font-size: Layout.compact ? 15px : Tokens.size-body;
                color: Layout.compact ? Tokens.background : Tokens.text;
                vertical-alignment: center;
                overflow: elide;
                horizontal-stretch: 1;
            }

            if root.avec-annulation: Rectangle {
                width: annuler.preferred-width + 2 * Tokens.space-3;
                accessible-role: button;
                accessible-label: "Undo";
                accessible-action-default => { root.undone(); }
                annuler := Text {
                    text: "Undo";
                    font-size: Layout.compact ? 15px : Tokens.size-body;
                    font-weight: Tokens.weight-bold;
                    color: Layout.compact
                        ? (Tokens.dark ? Tokens.accent.darker(0.3) : Tokens.accent.brighter(0.35))
                        : Tokens.accent;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.undone(); }
                }
            }
        }
    }
}

// A message on its way, and the one gesture that still takes it back.
//
// Send closes the window at once: the message is written, looking at it again is
// not what anyone wants. What they may want, in the next few seconds, is to stop it
// — so the notice says it is leaving, counts down, and offers Undo. Nothing here
// blocks the window: the rest of the mail stays in reach while it counts.
export component SendNotice inherits Rectangle {
    in property <string> message;
    in property <int> seconds;

    callback undone();

    bulle := Floating {
        radius: Tokens.radius-medium;
        x: (parent.width - self.width) / 2;
        y: parent.height - self.height - Tokens.space-6;
        width: min(rang.preferred-width + 2 * Tokens.space-3, parent.width - Tokens.space-6);
        height: 40px;

        accessible-role: text;
        accessible-label: root.message;

        rang := HorizontalLayout {
            x: Tokens.space-3;
            width: parent.width - 2 * Tokens.space-3;
            spacing: Tokens.space-3;

            Text {
                text: root.message;
                font-family: Tokens.font-family;
                font-size: Tokens.size-body;
                color: Tokens.text;
                vertical-alignment: center;
                overflow: elide;
                horizontal-stretch: 1;
            }

            Text {
                text: root.seconds + " s";
                font-size: Tokens.size-small;
                color: Tokens.text-muted;
                vertical-alignment: center;
            }

            Rectangle {
                y: (parent.height - self.height) / 2;
                width: annuler.preferred-width + 2 * Tokens.space-3;
                height: 26px;
                border-radius: Tokens.radius-small;
                background: touche.pressed ? Tokens.accent.darker(0.15) : Tokens.accent;

                accessible-role: button;
                accessible-label: "Undo send";
                accessible-action-default => { root.undone(); }

                annuler := Text {
                    text: "Undo";
                    font-size: Tokens.size-small;
                    font-weight: Tokens.weight-bold;
                    color: Tokens.accent-text;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                touche := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.undone(); }
                }
            }
        }
    }
}
