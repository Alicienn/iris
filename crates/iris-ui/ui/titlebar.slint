import { Tokens } from "tokens.slint";
import { Icon, Icons } from "icons.slint";

// A window control.
//
// Deliberately the same size and spacing as the system's, because muscle memory for
// the close button is measured in pixels and people do not enjoy relearning it. Only
// the colours change.
component WindowButton inherits Rectangle {
    in property <string> glyph;
    in property <string> label;
    // Close goes red on hover, like everywhere else on this platform. Breaking that
    // convention would be style at the expense of the one control nobody may misfire.
    in property <bool> closes;

    callback clicked();

    width: 46px;
    height: 100%;
    background: touch.has-hover
        ? (root.closes ? #e81123 : Tokens.surface-hover)
        : transparent;
    animate background { duration: Tokens.instant; }

    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { root.clicked(); }

    // Drawn, not typed. The previous version asked for glyphs from Segoe Fluent
    // Icons; where that font is absent the buttons came out as empty squares, which
    // is exactly what happened.
    Icon {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        data: root.glyph;
        size: 14px;
        tint: (root.closes && touch.has-hover) ? #ffffff : Tokens.text-secondary;
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

// The window's own title bar.
//
// Replacing the system frame is not decoration for its own sake: a dark application
// under a light system frame looks like two programs stacked on top of each other,
// and the seam falls exactly where the eye enters the window.
//
// What it must not do is behave differently from the frame it replaces. Double-click
// maximises, dragging moves, the three buttons sit where they always sit, and the
// close button turns red.
// A workspace switch in the title bar.
component WorkspaceTab inherits Rectangle {
    in property <string> icon;
    in property <string> text;
    in property <string> shortcut;
    in property <bool> selected;

    callback clicked();

    height: 24px;
    width: rang.preferred-width + 16px;
    border-radius: Tokens.radius-small;
    background: root.selected
        ? Tokens.surface-active
        : (touch.has-hover ? Tokens.surface-hover : transparent);
    animate background { duration: Tokens.instant; }

    accessible-role: tab;
    accessible-label: root.text;
    accessible-item-selected: root.selected;
    accessible-description: root.shortcut;
    accessible-action-default => { root.clicked(); }

    rang := HorizontalLayout {
        x: 8px;
        spacing: 6px;
        Icon {
            y: (parent.height - self.height) / 2;
            data: root.icon;
            size: 13px;
            tint: root.selected ? Tokens.text : Tokens.text-muted;
        }
        Text {
            text: root.text;
            font-size: Tokens.size-small;
            font-weight: root.selected ? Tokens.weight-bold : Tokens.weight-body;
            color: root.selected ? Tokens.text : Tokens.text-secondary;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }

    Tooltip {
        text: @markdown("\{root.text}  \{root.shortcut}");
    }
}

// Back or forward through the places visited: a small arrow, dimmed when there is
// nowhere to go.
component NavButton inherits Rectangle {
    in property <string> glyph;
    in property <string> label;
    in property <string> shortcut;
    in property <bool> enabled;
    callback clicked();

    width: 34px;
    height: 100%;
    background: root.enabled && touch.has-hover ? Tokens.surface-hover : transparent;
    animate background { duration: Tokens.instant; }

    accessible-role: button;
    accessible-label: root.label;
    accessible-description: root.shortcut;
    accessible-enabled: root.enabled;
    accessible-action-default => { if (root.enabled) { root.clicked(); } }

    Icon {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        data: root.glyph;
        size: 14px;
        tint: root.enabled ? Tokens.text-secondary : Tokens.text-muted.transparentize(0.5);
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }

    Tooltip {
        text: @markdown("\{root.label}  \{root.shortcut}");
    }
}

export component TitleBar inherits Rectangle {
    in property <string> title;
    in property <bool> maximised;
    /// Which workspace is showing: 0 mail, 1 calendar, 2 tasks, 3 Home.
    in-out property <int> workspace;
    in property <bool> can-go-back;
    in property <bool> can-go-forward;
    callback workspace-chosen(int);
    callback back();
    callback forward();

    callback minimise();
    callback toggle-maximise();
    callback close();
    // Dragging is handled in Rust: only the platform window knows where it is.
    callback drag(length, length);
    callback drag-started();

    height: 32px;
    background: Tokens.surface-low;

    // The hairline is the only thing separating the bar from the content beneath it.
    // Without it the window has no top edge at all on a dark desktop.
    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: Tokens.border;
    }

    HorizontalLayout {
        padding-left: Tokens.space-3;
        spacing: 0px;

        // The name leads Home. It looks as it always did; only the pointer and a
        // lighter colour under it say it can be clicked.
        Rectangle {
            width: nom.preferred-width;
            accessible-role: button;
            accessible-label: "Home";
            accessible-description: "Ctrl+0";
            accessible-action-default => { root.workspace-chosen(3); }

            nom := Text {
                text: root.title;
                font-family: Tokens.font-family;
                font-size: Tokens.size-small;
                color: accueil.has-hover || root.workspace == 3 ? Tokens.text-secondary : Tokens.text-muted;
                vertical-alignment: center;
                height: 100%;
            }
            accueil := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.workspace-chosen(3); }
            }
            Tooltip {
                text: @markdown("Home  Ctrl+0");
            }
        }

        Rectangle { width: Tokens.space-4; }

        // Mail and calendar, one click apart. In the title bar because they are two
        // places, not two panels: the whole window below changes.
        WorkspaceTab {
            y: (parent.height - self.height) / 2;
            icon: Icons.inbox;
            text: "Mail";
            shortcut: "Ctrl+1";
            selected: root.workspace == 0;
            clicked => { root.workspace-chosen(0); }
        }
        WorkspaceTab {
            y: (parent.height - self.height) / 2;
            icon: Icons.calendar;
            text: "Calendar";
            shortcut: "Ctrl+2";
            selected: root.workspace == 1;
            clicked => { root.workspace-chosen(1); }
        }
        WorkspaceTab {
            y: (parent.height - self.height) / 2;
            icon: Icons.task;
            text: "Tasks";
            shortcut: "Ctrl+3";
            selected: root.workspace == 2;
            clicked => { root.workspace-chosen(2); }
        }

        // The draggable region is everything the buttons do not claim.
        Rectangle {
            horizontal-stretch: 1;

            drag-area := TouchArea {
                moved => {
                    if (self.pressed) {
                        root.drag(
                            self.mouse-x - self.pressed-x,
                            self.mouse-y - self.pressed-y,
                        );
                    }
                }
                pointer-event(event) => {
                    if (event.button == PointerEventButton.left
                        && event.kind == PointerEventKind.down) {
                        root.drag-started();
                    }
                }
                double-clicked => { root.toggle-maximise(); }
            }
        }

        NavButton {
            glyph: Icons.arrow-left;
            label: "Back";
            shortcut: "Alt+←";
            enabled: root.can-go-back;
            clicked => { root.back(); }
        }
        NavButton {
            glyph: Icons.arrow-right;
            label: "Forward";
            shortcut: "Alt+→";
            enabled: root.can-go-forward;
            clicked => { root.forward(); }
        }
        Rectangle { width: Tokens.space-2; }

        WindowButton {
            glyph: Icons.window-minimise;
            label: "Minimise";
            clicked => { root.minimise(); }
        }
        WindowButton {
            // Two distinct icons, because "restore" and "maximise" are different
            // actions and a button that does not say which it will do is a guess.
            glyph: root.maximised ? Icons.window-restore : Icons.window-maximise;
            label: root.maximised ? "Restore" : "Maximise";
            clicked => { root.toggle-maximise(); }
        }
        WindowButton {
            glyph: Icons.window-close;
            label: "Close";
            closes: true;
            clicked => { root.close(); }
        }
    }
}
