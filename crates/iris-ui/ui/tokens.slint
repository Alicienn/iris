// Les design tokens, injectés depuis Rust.
//
// Rien dans l'interface n'écrit une couleur, un rayon ou une durée en dur : tout
// passe par ce global. C'est ce qui permet à un thème d'être un fichier, et au
// rechargement à chaud de changer l'apparence sans redémarrer.

export global Tokens {
    // --- Couleurs ---
    in-out property <color> background: #0a0b0d;
    in-out property <color> glow: #ffffff0d;
    in-out property <color> surface-high: #ffffff0e;
    in-out property <color> surface: #ffffff06;
    in-out property <color> surface-low: #ffffff03;
    in-out property <color> surface-hover: #ffffff10;
    in-out property <color> surface-active: #ffffff17;
    in-out property <color> border: #ffffff13;
    in-out property <color> border-strong: #ffffff26;
    in-out property <color> edge-light: #ffffff1f;
    in-out property <color> text: #f0f2f6;
    in-out property <color> text-secondary: #949bab;
    in-out property <color> text-muted: #5a6070;
    in-out property <color> accent: #f0f2f6;
    in-out property <color> accent-text: #0a0b0d;
    in-out property <color> error: #e5484d;
    in-out property <color> warning: #d9a441;
    in-out property <color> success: #5cb87a;

    // --- Formes ---
    in-out property <length> radius-small: 6px;
    in-out property <length> radius-medium: 9px;
    in-out property <length> radius-large: 14px;

    // --- Espacement ---
    // Toute marge de l'interface est un multiple de cette unité.
    in-out property <length> unit: 4px;

    // --- Typographie ---
    in-out property <string> font-family: "Inter";
    in-out property <string> font-mono: "JetBrains Mono";
    in-out property <length> size-small: 11px;
    in-out property <length> size-body: 13px;
    in-out property <length> size-title: 15px;
    in-out property <int> weight-body: 400;
    in-out property <int> weight-bold: 620;
    in-out property <float> line-height: 1.45;

    // --- Densité ---
    in-out property <length> row-height: 58px;
    in-out property <length> row-padding-x: 12px;

    // --- Verre ---
    // L'opacité et le grain sont réglables ; le flou, lui, est simulé (voir
    // glass.slint).
    in-out property <float> glass-opacity: 0.86;
    in-out property <float> grain: 0.035;

    // --- Mouvement ---
    in-out property <duration> instant: 90ms;
    in-out property <duration> quick: 140ms;
    in-out property <duration> moderate: 220ms;

    // Espacement calculé, pour éviter les multiplications éparpillées.
    out property <length> space-1: unit;
    out property <length> space-2: unit * 2;
    out property <length> space-3: unit * 3;
    out property <length> space-4: unit * 4;
    out property <length> space-6: unit * 6;
}
