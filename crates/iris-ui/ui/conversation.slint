import { Tokens } from "tokens.slint";
import { MessageData, MessageBlockData } from "types.slint";
import { Glass } from "glass.slint";
import { ScrollView, TextEdit, Button } from "std-widgets.slint";

// Un bloc du corps du message.
//
// Le corps arrive déjà découpé en blocs par le moteur de rendu : l'interface ne voit
// jamais de HTML, et ne peut donc rien en exécuter.
component MessageBlock inherits Rectangle {
    in property <MessageBlockData> block;

    height: layout.preferred-height;

    layout := VerticalLayout {
        if root.block.kind == "rule": Rectangle {
            height: 1px;
            background: Tokens.border;
        }

        if root.block.kind == "image": HorizontalLayout {
            spacing: Tokens.space-2;
            Text {
                text: "▣";
                color: Tokens.text-muted;
                font-size: Tokens.size-body;
            }
            Text {
                text: root.block.text;
                color: Tokens.text-muted;
                font-size: Tokens.size-small;
                font-italic: true;
                vertical-alignment: center;
            }
        }

        if root.block.kind == "heading": Text {
            text: root.block.text;
            font-size: Tokens.size-title + (3 - min(root.block.level, 3)) * 2px;
            font-weight: Tokens.weight-bold;
            color: Tokens.text;
            wrap: word-wrap;
        }

        if root.block.kind == "code": Rectangle {
            background: Tokens.surface;
            border-radius: Tokens.radius-small;
            height: code-text.preferred-height + Tokens.space-4;
            code-text := Text {
                x: Tokens.space-2;
                y: Tokens.space-2;
                width: parent.width - Tokens.space-4;
                text: root.block.text;
                font-family: Tokens.font-mono;
                font-size: Tokens.size-small;
                color: Tokens.text-secondary;
                wrap: word-wrap;
            }
        }

        // Une citation est repliée par défaut au-delà du premier niveau : dans un fil
        // de dix réponses, afficher les neuf précédentes noie la seule ligne utile.
        if root.block.kind == "quote": HorizontalLayout {
            spacing: Tokens.space-2;
            Rectangle {
                width: 2px;
                background: Tokens.border-strong;
            }
            Text {
                text: root.block.text;
                font-size: Tokens.size-body;
                color: Tokens.text-muted;
                wrap: word-wrap;
            }
        }

        if root.block.kind == "list": HorizontalLayout {
            padding-left: root.block.depth * Tokens.space-4;
            spacing: Tokens.space-2;
            Text {
                text: "•";
                color: Tokens.text-secondary;
            }
            Text {
                text: root.block.text;
                font-size: Tokens.size-body;
                color: Tokens.text;
                wrap: word-wrap;
            }
        }

        if root.block.kind == "table": Text {
            text: root.block.text;
            font-family: Tokens.font-mono;
            font-size: Tokens.size-small;
            color: Tokens.text-secondary;
            wrap: no-wrap;
        }

        if root.block.kind == "paragraph": Text {
            text: root.block.text;
            font-size: Tokens.size-body;
            font-weight: root.block.bold ? Tokens.weight-bold : Tokens.weight-body;
            font-italic: root.block.italic;
            color: Tokens.text;
            wrap: word-wrap;
        }
    }
}

// Le bandeau d'avertissement des contenus distants.
component RemoteContentBanner inherits Rectangle {
    in property <int> blocked-images;
    in property <bool> has-tracker;

    callback load-images();

    height: 32px;
    border-radius: Tokens.radius-small;
    background: Tokens.surface;
    border-width: 1px;
    border-color: Tokens.border;

    HorizontalLayout {
        padding-left: Tokens.space-3;
        padding-right: Tokens.space-2;
        spacing: Tokens.space-2;

        Text {
            text: root.has-tracker
                ? "This sender is trying to learn when you read this message."
                : root.blocked-images + " remote image(s) blocked.";
            font-size: Tokens.size-small;
            color: root.has-tracker ? Tokens.warning : Tokens.text-secondary;
            vertical-alignment: center;
            overflow: elide;
        }

        Rectangle {}

        Button {
            text: "Show";
            clicked => { root.load-images(); }
        }
    }
}

// One action in the toolbar.
//
// Glyph plus tooltip rather than glyph plus label: six labelled buttons would take
// the width the subject needs, and the keyboard shortcut in the tooltip is how
// someone graduates from clicking to typing.
component ToolButton inherits Rectangle {
    in property <string> glyph;
    in property <string> label;
    in property <string> shortcut;
    in property <bool> danger;
    in property <bool> active;

    callback clicked();

    width: 28px;
    height: 26px;
    border-radius: Tokens.radius-small;
    background: root.active
        ? Tokens.surface-active
        : (touch.has-hover ? Tokens.surface-hover : transparent);
    animate background { duration: Tokens.instant; }

    accessible-role: button;
    accessible-label: root.label;
    accessible-description: root.shortcut;
    accessible-action-default => { root.clicked(); }

    Text {
        text: root.glyph;
        font-size: Tokens.size-body;
        color: root.danger && touch.has-hover
            ? Tokens.error
            : (root.active ? Tokens.text : Tokens.text-secondary);
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }

    // The tooltip carries the shortcut, so the toolbar teaches the keyboard rather
    // than competing with it.
    if touch.has-hover: Rectangle {
        y: parent.height + 4px;
        width: tip.preferred-width + 12px;
        height: 20px;
        border-radius: Tokens.radius-small;
        background: Tokens.surface-high;
        border-width: 1px;
        border-color: Tokens.border;

        tip := Text {
            text: root.shortcut == "" ? root.label : root.label + "  " + root.shortcut;
            font-size: Tokens.size-small;
            color: Tokens.text-secondary;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}

// La colonne de lecture, avec la réponse intégrée au bas du fil.
export component ConversationView inherits VerticalLayout {
    in property <MessageData> message;
    in property <bool> empty: true;
    in-out property <string> reply-text;
    in property <bool> sending;
    in property <int> undo-seconds;

    in property <bool> unread;
    in property <bool> starred;

    callback send();
    callback cancel-send();
    callback load-images();
    callback reply-all();
    callback save-attachment(int);
    callback archive();
    callback delete-thread();
    callback toggle-unread();
    callback toggle-star();
    callback snooze();
    callback mark-done();

    if root.empty: Rectangle {
        VerticalLayout {
            alignment: center;
            Text {
                text: "No conversation selected.";
                color: Tokens.text-muted;
                font-size: Tokens.size-body;
                horizontal-alignment: center;
            }
        }
    }

    if !root.empty: VerticalLayout {
        padding: Tokens.space-4;
        spacing: Tokens.space-3;

        // En-tête.
        VerticalLayout {
            spacing: 2px;
            Text {
                text: root.message.subject;
                font-size: Tokens.size-title;
                font-weight: Tokens.weight-bold;
                color: Tokens.text;
                wrap: word-wrap;
            }
            HorizontalLayout {
                spacing: Tokens.space-2;
                Text {
                    text: root.message.from;
                    font-size: Tokens.size-small;
                    font-weight: Tokens.weight-bold;
                    color: Tokens.text-secondary;
                }
                Text {
                    text: root.message.from-address;
                    font-size: Tokens.size-small;
                    color: Tokens.text-muted;
                }
                Rectangle {}
                Text {
                    text: root.message.date;
                    font-size: Tokens.size-small;
                    color: Tokens.text-muted;
                }
            }
        }

        // The toolbar. Every one of these was previously reachable only from the
        // palette or a key nobody had been told about.
        HorizontalLayout {
            spacing: 2px;
            vertical-stretch: 0;

            ToolButton {
                glyph: "✓";
                label: "Mark as done";
                shortcut: "E";
                clicked => { root.mark-done(); }
            }
            ToolButton {
                glyph: "▤";
                label: "Archive";
                shortcut: "A";
                clicked => { root.archive(); }
            }
            ToolButton {
                glyph: "⏱";
                label: "Snooze until tomorrow";
                shortcut: "S";
                clicked => { root.snooze(); }
            }

            Rectangle { width: Tokens.space-2; }

            ToolButton {
                glyph: root.unread ? "●" : "○";
                label: root.unread ? "Mark as read" : "Mark as unread";
                shortcut: "R";
                clicked => { root.toggle-unread(); }
            }
            ToolButton {
                glyph: "◆";
                label: root.starred ? "Remove star" : "Star";
                shortcut: "F";
                active: root.starred;
                clicked => { root.toggle-star(); }
            }

            Rectangle {}

            ToolButton {
                glyph: "🗑";
                label: "Delete";
                shortcut: "Shift+3";
                danger: true;
                clicked => { root.delete-thread(); }
            }
        }

        if root.message.blocked-images > 0 || root.message.has-tracker: RemoteContentBanner {
            blocked-images: root.message.blocked-images;
            has-tracker: root.message.has-tracker;
            load-images => { root.load-images(); }
        }

        // Corps. Rendu par le moteur complet quand la mise en page l'exige,
        // dessine bloc par bloc sinon.
        // A scroll view only scrolls when its viewport is taller than the frame, and
        // the viewport does not grow on its own: it has to be told how tall the
        // content is. Without this binding the body was silently clipped at the
        // window height, with no way to reach the rest of a long message.
        ScrollView {
            vertical-stretch: 1;
            viewport-height: corps.preferred-height;

            corps := VerticalLayout {
                spacing: Tokens.space-2;

                if root.message.body-is-image: Image {
                    source: root.message.body-image;
                    // Rendered at the width of the panel: it takes its natural
                    // height rather than being stretched.
                    image-fit: contain;
                    width: 100%;
                    height: self.source.height * 1px;
                }

                if !root.message.body-is-image: VerticalLayout {
                    spacing: Tokens.space-2;
                    for block in root.message.blocks: MessageBlock {
                        block: block;
                    }
                }
            }
        }

        if root.message.attachments.length > 0: HorizontalLayout {
            spacing: Tokens.space-2;
            // Une pièce jointe affichée mais qu'on ne peut pas ouvrir est une
            // promesse à moitié tenue : la pastille est le bouton d'enregistrement.
            for name[i] in root.message.attachments: Rectangle {
                height: 24px;
                border-radius: Tokens.radius-small;
                background: piece.has-hover ? Tokens.surface-hover : Tokens.surface;
                border-width: 1px;
                border-color: Tokens.border;
                animate background { duration: Tokens.instant; }

                accessible-role: button;
                accessible-label: "Save " + name;
                accessible-action-default => { root.save-attachment(i); }

                HorizontalLayout {
                    padding-left: Tokens.space-2;
                    padding-right: Tokens.space-2;
                    spacing: Tokens.space-1;

                    Text {
                        text: piece.has-hover ? "↓" : "▣";
                        font-size: Tokens.size-small;
                        color: Tokens.text-muted;
                        vertical-alignment: center;
                    }
                    Text {
                        text: name;
                        font-size: Tokens.size-small;
                        color: Tokens.text-secondary;
                        vertical-alignment: center;
                    }
                }

                piece := TouchArea {
                    clicked => { root.save-attachment(i); }
                }
            }
            Rectangle {}
        }

        // La réponse est intégrée au bas du fil, jamais dans une fenêtre à part :
        // répondre est le geste qui fait avancer le workflow, il ne doit rien
        // recouvrir.
        Glass {
            elevated: true;
            radius: Tokens.radius-medium;
            height: 140px;

            VerticalLayout {
                padding: Tokens.space-2;
                spacing: Tokens.space-2;

                TextEdit {
                    accessible-label: "Your reply";
                    text <=> root.reply-text;
                    placeholder-text: "Reply…";
                    font-size: Tokens.size-body;
                }

                HorizontalLayout {
                    spacing: Tokens.space-2;

                    // Pendant le délai d'annulation, le bouton d'envoi devient un
                    // bouton d'annulation : c'est le même endroit à l'écran, donc le
                    // geste de rattrapage est immédiat.
                    if root.sending: Button {
                        text: "Undo send (" + root.undo-seconds + " s)";
                        clicked => { root.cancel-send(); }
                    }
                    if !root.sending: Button {
                        text: "Send";
                        primary: true;
                        enabled: root.reply-text != "";
                        clicked => { root.send(); }
                    }

                    Button {
                        text: "Reply all";
                        enabled: !root.sending;
                        clicked => { root.reply-all(); }
                    }

                    Rectangle {}
                }
            }
        }
    }
}
