import { Tokens } from "@iris/theme/tokens.slint";
import { Layout } from "@iris/theme/layout.slint";
import { Icon, Icons } from "@iris/base/icons.slint";
import { Dot } from "@iris/base/atoms.slint";
import { Check, CheckShape } from "@iris/controls/choice.slint";

// What the three side columns (accounts, calendars, task lists) share.
//
// They had each grown their own idea of a selected row: a bar against the rounded
// edge in the mail, a plain background in the tasks, nine-pixel titles here and
// ten-pixel ones there. Side by side, three columns that disagree read as three
// applications. Only the height is left to each: the mail lists a hundred mailboxes
// and keeps its rows tight.

export global Nav {
    /// A row of every side column, as Apple's source lists have them.
    // On a phone, the mockups' sheet rows: a finger's height, larger words.
    out property <length> row-height: Layout.compact ? 46px : 32px;
    out property <length> label-size: Layout.compact ? 15.5px : 14px;
    /// What leads a row (a view's, a folder's icon), the room between a row's parts,
    /// and its count.
    out property <length> icon-size: 17px;
    out property <length> row-gap: 9px;
    out property <length> count-size: 12.5px;
    /// A mailbox's, a to-plan task's dot; a calendar's square check.
    out property <length> dot-size: 9px;
    out property <length> check-size: 15px;

    /// A section's title row (`SectionRow`): the title a real label, 13 px and darker
    /// than the counts, its buttons a pointer's size.
    out property <length> title-size: 13px;
    out property <length> section-height: 36px;
    out property <length> section-button: 26px;
    out property <length> section-icon: 16px;
    out property <length> section-plus: 17px;
    /// The fold chevron before a section's title, and the room it is drawn in.
    out property <length> fold-size: 12px;
    out property <length> fold-room: 18px;

    /// On a phone, the mockups' sheet: the chosen row a grey plate, its words as they
    /// are (and bold), not the accent with white words.
    out property <bool> sheet: Layout.compact;

    /// The chosen row is the accent itself, its words white: a source list's selection.
    /// A finger leaves a hover behind it when it lifts: no hover under touch.
    public pure function background(selected: bool, hover: bool) -> brush {
        return selected ? (Nav.sheet ? Tokens.surface-active : Tokens.accent)
            : hover && !Layout.touch-input ? Tokens.surface-hover : transparent;
    }
    /// What is written on a row: white on the selection.
    public pure function ink(selected: bool, dim: bool) -> color {
        return selected && !Nav.sheet ? Tokens.accent-text : dim ? Tokens.text-muted : Tokens.text;
    }
    /// A row's icon: the accent, white on the selection.
    public pure function icon-ink(selected: bool, tint: color) -> color {
        return selected && !Nav.sheet ? Tokens.accent-text : tint;
    }
    /// A row's count: grey, white on the selection.
    public pure function count-ink(selected: bool) -> color {
        return selected && !Nav.sheet ? Tokens.accent-text : Tokens.text-muted;
    }
}

/// The title over a group of rows: Favourites, Calendars, My lists. Sentence case, a
/// real label (13 px, the secondary ink), not a whisper over the rows.
export component SectionTitle inherits Text {
    font-size: Nav.title-size;
    font-weight: 600;
    color: Tokens.text-secondary;
    vertical-alignment: center;
    overflow: elide;
}

/// A section's title that folds the section: a click on it (the chevron before the
/// words, the words, the room up to what acts on the section) folds the rows under it,
/// or brings them back. The column decides what stays shown folded (the chosen row). No
/// focus taken: the click reaches it at once, and the column hands the keyboard back.
export component SectionFold inherits Rectangle {
    in property <string> text;
    in property <bool> folded;
    callback toggled();

    accessible-role: button;
    accessible-label: (root.folded ? "Unfold " : "Fold ") + root.text;
    accessible-action-default => { root.toggled(); }

    HorizontalLayout {
        spacing: 2px;
        // Before the title, in a room of its own: the titles of a column line up
        // whether or not their section folds (`SectionRow.chevron-room`).
        // Centred by its box, not by `y`: the row's layout may have a top padding.
        Rectangle {
            width: Nav.fold-room;
            Icon {
                data: root.folded ? Icons.chevron-right : Icons.chevron-down;
                size: Nav.fold-size;
                weight: 2;
                tint: plier.has-hover && !Layout.touch-input ? Tokens.text-secondary : Tokens.text-muted;
            }
        }
        SectionTitle {
            text: root.text;
            color: plier.has-hover && !Layout.touch-input ? Tokens.text : Tokens.text-secondary;
        }
        Rectangle {
            horizontal-stretch: 1;
        }
    }

    plier := TouchArea {
        clicked => { root.toggled(); }
    }
}

/// A section's title row, the same in every side column: 36 px, 10 of them above, the
/// rest the height of its buttons (`Nav.section-button`, which the column gives the
/// buttons it puts here); what acts on the section (find, group, add) follows at the
/// right. `foldable`, a chevron leads the title and folds the section (`SectionFold`).
/// `chevron-room`, a title that does not fold keeps that room, so that it lines up with
/// the ones that do in the same column (the mail's Favourites over its Accounts);
/// otherwise it sits on the rows' 8 px inset.
export component SectionRow inherits HorizontalLayout {
    in property <string> text;
    in property <bool> foldable;
    in property <bool> folded;
    in property <bool> chevron-room;
    callback toggled();
    height: Nav.section-height;
    padding-top: Nav.section-height - Nav.section-button;
    padding-bottom: 0px;
    padding-left: root.foldable || root.chevron-room ? 2px : 8px;
    spacing: 2px;
    vertical-stretch: 0;
    if root.chevron-room && !root.foldable: Rectangle {
        width: Nav.fold-room;
    }
    if !root.foldable: SectionTitle {
        text: root.text;
        horizontal-stretch: 1;
    }
    if root.foldable: SectionFold {
        text: root.text;
        folded: root.folded;
        horizontal-stretch: 1;
        toggled => { root.toggled(); }
    }
    @children
}

/// A row of a side column: a view, a list, a calendar, a mailbox, a tag, a folder.
///
/// What leads the row is an icon, a dot of colour or a square check in its colour; a
/// group's title adds a chevron that folds what is under it. What follows the label is
/// a count, or whatever the column puts there (`@children`: a sync button on hover, a
/// warning mark). One touch area, on top, reads where it was hit: the chevron folds,
/// a right click asks for the menu, anything else is a click.
export component NavItem inherits Rectangle {
    in property <string> label;
    in property <string> count;
    in property <string> icon;
    in property <color> icon-tint: Tokens.accent;
    in property <color> dot;
    in property <bool> has-dot;
    /// A square check in the row's colour (`dot`), ticked when `checked`.
    in property <bool> has-check;
    in property <bool> checked;
    in property <bool> selected;
    /// A title that holds rows under it: bold, with a chevron.
    in property <bool> group;
    in property <bool> folded;
    /// Under a group's title: a step in.
    in property <bool> nested;
    /// Collapsed to its lead only (the accounts column, folded away).
    in property <bool> compact;
    in property <length> row-height: Nav.row-height;
    /// Dimmed: a hidden calendar, a disabled account.
    in property <bool> dim;

    callback clicked();
    callback fold-toggled();
    callback context-menu(length, length);

    out property <bool> hovered: touch.has-hover;
    property <length> pli: 22px;

    height: max(root.row-height, Layout.target);

    // The plate as a child, so that Slint keeps one copy of the row (7.0.0).
    Rectangle {
        border-radius: Tokens.radius-small;
        background: Nav.background(root.selected, touch.has-hover);
        animate background { duration: Tokens.instant; }
    }

    accessible-role: list-item;
    accessible-label: root.label;
    accessible-item-selected: root.selected;
    accessible-action-default => { root.clicked(); }

    HorizontalLayout {
        padding-left: root.compact ? 0px : root.nested ? 26px : root.group ? 4px : 8px;
        padding-right: 8px;
        spacing: Nav.row-gap;
        alignment: root.compact ? LayoutAlignment.center : LayoutAlignment.stretch;

        if root.group && !root.compact: Rectangle {
            y: (parent.height - self.height) / 2;
            width: 18px;
            height: 18px;
            border-radius: 4px;
            background: touch.has-hover && touch.mouse-x < root.pli ? Tokens.surface-active : transparent;
            accessible-role: button;
            accessible-label: (root.folded ? "Unfold " : "Fold ") + root.label;
            accessible-action-default => { root.fold-toggled(); }
            Icon {
                data: root.folded ? Icons.chevron-right : Icons.chevron-down;
                size: 13px;
                tint: Nav.count-ink(root.selected);
            }
        }
        if root.icon != "": Icon {
            y: (parent.height - self.height) / 2;
            data: root.icon;
            size: Nav.icon-size;
            tint: Nav.icon-ink(root.selected, root.icon-tint);
        }
        if root.has-dot && !root.has-check: Dot {
            y: (parent.height - self.height) / 2;
            tint: root.dot;
            size: Nav.dot-size;
        }
        if root.has-check: Check {
            y: (parent.height - self.height) / 2;
            shape: CheckShape.square;
            size: Nav.check-size;
            tint: root.dot;
            done: root.checked;
            label: root.label;
            // The row's touch area answers for it: one click, one place. A screen
            // reader's "press" on the check still ticks it.
            interactive: false;
            toggled => { root.clicked(); }
        }
        if !root.compact: Text {
            text: root.label;
            font-size: Nav.label-size;
            font-weight: root.group ? 600 : 400;
            color: Nav.ink(root.selected, root.dim);
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }
        @children
        if !root.compact && root.count != "": Text {
            text: root.count;
            font-size: Nav.count-size;
            color: Nav.count-ink(root.selected);
            vertical-alignment: center;
        }
    }

    // A long press is a right-click for a finger: half a second without moving.
    property <bool> tenu;
    property <bool> tenu-fini;
    touch := TouchArea {
        pointer-event(event) => {
            if (event.button == PointerEventButton.right && event.kind == PointerEventKind.down) {
                root.context-menu(self.absolute-position.x + self.mouse-x,
                    self.absolute-position.y + self.mouse-y);
            }
            if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                root.tenu = Layout.touch-input;
                root.tenu-fini = false;
            }
            if (event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel) {
                root.tenu = false;
            }
        }
        moved => {
            if (abs(self.mouse-x - self.pressed-x) > 8px || abs(self.mouse-y - self.pressed-y) > 8px) {
                root.tenu = false;
            }
        }
        clicked => {
            if (root.tenu-fini) {
                return;
            }
            if (root.group && !root.compact && self.mouse-x < root.pli) {
                root.fold-toggled();
            } else {
                root.clicked();
            }
        }
    }
    Timer {
        interval: 500ms;
        running: root.tenu;
        triggered => {
            root.tenu = false;
            root.tenu-fini = true;
            root.context-menu(touch.absolute-position.x + touch.pressed-x,
                touch.absolute-position.y + touch.pressed-y);
        }
    }
}
