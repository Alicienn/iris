import { Tokens } from "@iris/theme/tokens.slint";
import { Layout } from "@iris/theme/layout.slint";
import { Icon } from "@iris/base/icons.slint";

// A row a finger can push aside: right for one action, left for another, as phones
// have taught everyone. The ground is the action's colour from the first pixel, as
// the mockups have it; past 96 pixels its icon grows and letting go does it; short of
// that the row springs back. A drag that is more up than across is a scroll, and the
// row lets the list have it.
//
// Every action a swipe does is also in the row's menu (long press, right-click): a
// gesture is never the only way.

/// A row is being swiped: the list it is in stops scrolling until it is let go, or a
/// finger drifting down mid-swipe handed the gesture to the scroll and the row sprang
/// back.
export global Swiping {
    in-out property <bool> active;
}

export component SwipeRow inherits Rectangle {
    /// On by default where the main input is a finger.
    in property <bool> enabled: Layout.touch-input;
    in property <string> start-label;
    in property <string> start-icon;
    in property <color> start-color: Tokens.success;
    in property <string> end-label;
    in property <string> end-icon;
    in property <color> end-color: Tokens.warning;
    /// Dragged right past the threshold and let go.
    callback swiped-start();
    /// Dragged left past the threshold and let go.
    callback swiped-end();

    property <length> seuil: 96px;
    property <length> decalage: 0px;
    property <bool> glisse: geste.swiping;
    changed glisse => { Swiping.active = self.glisse; }
    /// Past the threshold: letting go does it.
    property <bool> arme: root.decalage >= root.seuil || -root.decalage >= root.seuil;

    clip: true;

    // What the row uncovers: the action's colour at once, white on it; the icon grows
    // once letting go would do it.
    if root.decalage > 0: Rectangle {
        background: root.start-color;
        HorizontalLayout {
            padding-left: 24px;
            spacing: 10px;
            alignment: start;
            Rectangle {
                width: 26px;
                Icon {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    data: root.start-icon;
                    size: root.arme ? 24px : 19px;
                    weight: 2.2;
                    tint: Tokens.accent-text;
                    animate size { duration: 160ms; easing: cubic-bezier(0.34, 1.56, 0.64, 1); }
                }
            }
            Text {
                text: root.start-label;
                font-size: 15px;
                font-weight: 600;
                color: Tokens.accent-text;
                vertical-alignment: center;
            }
        }
    }
    if root.decalage < 0: Rectangle {
        background: root.end-color;
        HorizontalLayout {
            padding-right: 24px;
            spacing: 10px;
            alignment: end;
            Text {
                text: root.end-label;
                font-size: 15px;
                font-weight: 600;
                color: Tokens.accent-text;
                vertical-alignment: center;
            }
            Rectangle {
                width: 26px;
                Icon {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    data: root.end-icon;
                    size: root.arme ? 24px : 19px;
                    weight: 2.2;
                    tint: Tokens.accent-text;
                    animate size { duration: 160ms; easing: cubic-bezier(0.34, 1.56, 0.64, 1); }
                }
            }
        }
    }

    // Slint's gesture handler takes the drag only once it is clearly sideways, and
    // lets a tap or a scroll through to the row and the list.
    geste := SwipeGestureHandler {
        handle-swipe-left: root.enabled;
        handle-swipe-right: root.enabled;
        moved => {
            root.decalage = self.current-position.x - self.pressed-position.x;
        }
        swiped => {
            if (root.decalage >= root.seuil) {
                root.swiped-start();
            } else if (-root.decalage >= root.seuil) {
                root.swiped-end();
            }
            root.decalage = 0px;
        }
        cancelled => {
            root.decalage = 0px;
        }

        contenu := Rectangle {
            x: root.decalage;
            width: parent.width;
            height: parent.height;
            animate x { duration: root.glisse ? 0ms : Tokens.quick; easing: ease-out; }
            @children
        }
    }
}
