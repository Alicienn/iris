import { Tokens } from "tokens.slint";
import { Glass } from "glass.slint";
import { Icon, Icons, IconButton } from "icons.slint";
import { TextField, TextArea } from "field.slint";
import { TaskPlaceData, TaskRowData, TaskDetailData, SubtaskData, MonthCellData } from "types.slint";
import { CalButton } from "calendar.slint";
import { PanelFrame, DateButton, DatePicker, Labelled } from "calendar-panels.slint";
import { MenuEntry, MenuSeparator, MenuSurface } from "menu.slint";
import { ComboBox, ScrollView } from "std-widgets.slint";
import { Nav, SectionTitle, SelectionMark } from "nav.slint";

// A priority, told by a small coloured tag beside the task rather than by its ring.
global Priority {
    public pure function tint(p: int) -> color {
        return p == 3 ? Tokens.error : p == 2 ? Tokens.warning : #5b8def;
    }
    public pure function name(p: int) -> string {
        return p == 3 ? "High" : p == 2 ? "Medium" : p == 1 ? "Low" : "";
    }
}

// The round box of a task: empty, or ticked. The same for every task: the priority
// has its own tag.
component TaskCheck inherits Rectangle {
    in property <bool> done;
    in property <string> label;
    in property <length> size: 20px;
    callback toggled();

    width: root.size;
    height: root.size;
    border-radius: root.size / 2;
    border-width: 1.5px;
    border-color: root.done ? Tokens.success : touch.has-hover ? Tokens.text-secondary : Tokens.text-muted;
    background: root.done ? Tokens.success
        : touch.has-hover ? Tokens.surface-hover : transparent;

    accessible-role: checkbox;
    accessible-label: root.label;
    accessible-checked: root.done;
    accessible-action-default => { root.toggled(); }

    if root.done || touch.has-hover: Icon {
        data: Icons.check;
        size: root.size * 0.6;
        weight: 3.0;
        tint: root.done ? white : Tokens.text-secondary;
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.toggled(); }
    }
}

// A priority as a tag: "High" in red, "Medium" in amber, "Low" in blue.
component PriorityTag inherits Rectangle {
    in property <int> priority;

    width: nom.preferred-width + 12px;
    height: 16px;
    border-radius: 4px;
    background: Priority.tint(root.priority).transparentize(0.82);

    nom := Text {
        text: Priority.name(root.priority);
        font-size: 9px;
        font-weight: Tokens.weight-bold;
        color: Priority.tint(root.priority);
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// A view or a list in the rail. While a task is carried, the ones that can take it
// light up under the pointer.
component PlaceRow inherits Rectangle {
    in property <TaskPlaceData> place;
    /// A task is being carried, and where the pointer is.
    in property <bool> carrying;
    in property <length> carry-x;
    in property <length> carry-y;
    /// Raised when the carried task is let go; the row under the point takes it.
    in property <int> drop;
    in property <length> drop-x;
    in property <length> drop-y;

    callback chosen(string);
    callback menu(TaskPlaceData, length, length);
    callback dropped(string);

    // A list takes a task; Today gives it today's date.
    property <bool> droppable: root.place.is-list || root.place.key == "today";
    pure function inside(x: length, y: length) -> bool {
        return x >= self.absolute-position.x && x < self.absolute-position.x + self.width
            && y >= self.absolute-position.y && y < self.absolute-position.y + self.height;
    }
    property <bool> targeted: root.carrying && root.droppable && root.inside(root.carry-x, root.carry-y);

    changed drop => {
        if (root.droppable && root.inside(root.drop-x, root.drop-y)) {
            root.dropped(root.place.key);
        }
    }

    height: Nav.row-height;
    border-radius: Tokens.radius-small;
    border-width: root.targeted ? 1.5px : 0px;
    border-color: Tokens.accent;
    background: root.targeted ? Tokens.accent.transparentize(0.8)
        : Nav.background(root.place.selected, touch.has-hover);
    animate background { duration: Tokens.instant; }

    SelectionMark {
        on: root.place.selected && !root.targeted;
        row-height: root.height;
    }

    accessible-role: button;
    accessible-label: root.place.name;
    accessible-action-default => { root.chosen(root.place.key); }

    touch := TouchArea {
        clicked => { root.chosen(root.place.key); }
        pointer-event(event) => {
            if (root.place.is-list && event.button == PointerEventButton.right
                && event.kind == PointerEventKind.up) {
                root.menu(root.place,
                    self.absolute-position.x + self.mouse-x,
                    self.absolute-position.y + self.mouse-y);
            }
        }
    }

    HorizontalLayout {
        padding-left: 10px;
        padding-right: Tokens.space-2;
        spacing: Tokens.space-2;

        if root.place.is-list: Rectangle {
            y: (parent.height - self.height) / 2;
            width: 10px;
            height: 10px;
            border-radius: 5px;
            background: root.place.color;
        }
        if !root.place.is-list: Icon {
            y: (parent.height - self.height) / 2;
            data: root.place.icon;
            size: 15px;
            tint: root.place.selected ? Tokens.text : Tokens.text-secondary;
        }
        Text {
            text: root.place.name;
            font-size: Nav.label-size;
            font-weight: root.place.selected ? Tokens.weight-bold : Tokens.weight-body;
            color: root.place.selected || root.targeted ? Tokens.text : Tokens.text-secondary;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }
        if root.place.count > 0: Rectangle {
            y: (parent.height - self.height) / 2;
            width: max(20px, compte.preferred-width + 10px);
            height: 18px;
            border-radius: 9px;
            background: Tokens.surface-high;
            compte := Text {
                text: root.place.count;
                font-size: 10px;
                color: Tokens.text-secondary;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }
}

// A line of the column: a task as a card, or a section title.
component TaskRow inherits Rectangle {
    in property <TaskRowData> item;
    callback selected(TaskRowData);
    callback toggled(int);
    callback clear-completed();
    /// Carrying: picked up past a few pixels of movement, moved, let go.
    callback carry-started(TaskRowData, length, length);
    callback carry-moved(length, length);
    callback carry-ended();

    property <bool> has-meta: root.item.meta != "" || root.item.list != ""
        || root.item.from-mail || root.item.progress != "" || root.item.priority > 0
        || root.item.has-notes;
    property <bool> pressed;
    property <bool> carrying;
    // A drag ends with a release, and a release makes a click: that one is not.
    property <bool> just-carried;
    property <length> press-x;
    property <length> press-y;

    height: root.item.kind == 0 ? (root.has-meta ? 62px : 50px) : 40px;
    border-radius: Tokens.radius-medium;
    border-width: root.item.kind == 0 ? 1px : 0px;
    border-color: root.item.selected ? Tokens.accent.transparentize(0.5) : Tokens.border;
    background: root.item.kind != 0 ? transparent
        : root.item.selected ? Tokens.surface-active
        : touch.has-hover ? Tokens.surface-high : Tokens.surface;
    // Picked up, the card fades where it was: it is in the hand.
    opacity: root.carrying ? 0.35 : 1.0;
    animate background, opacity { duration: Tokens.instant; }

    accessible-role: list-item;
    accessible-label: root.item.title;
    accessible-item-selectable: root.item.kind == 0;
    accessible-item-selected: root.item.selected;
    accessible-action-default => { root.selected(root.item); }

    touch := TouchArea {
        enabled: root.item.kind == 0;
        mouse-cursor: root.carrying ? MouseCursor.grabbing : MouseCursor.default;
        pointer-event(event) => {
            if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                root.pressed = true;
                root.carrying = false;
                root.just-carried = false;
                root.press-x = self.mouse-x;
                root.press-y = self.mouse-y;
            }
            if (event.button == PointerEventButton.left && event.kind == PointerEventKind.up) {
                if (root.carrying) {
                    root.carrying = false;
                    root.just-carried = true;
                    root.carry-ended();
                }
                root.pressed = false;
            }
        }
        moved => {
            if (root.pressed && !root.carrying
                && (abs(self.mouse-x - root.press-x) > 6px || abs(self.mouse-y - root.press-y) > 6px)) {
                root.carrying = true;
                root.carry-started(root.item,
                    self.absolute-position.x + self.mouse-x,
                    self.absolute-position.y + self.mouse-y);
            }
            if (root.carrying) {
                root.carry-moved(self.absolute-position.x + self.mouse-x,
                    self.absolute-position.y + self.mouse-y);
            }
        }
        clicked => {
            if (!root.just-carried) {
                root.selected(root.item);
            }
            root.just-carried = false;
        }
    }

    // A section title, with its count; the completed ones can be cleared from it.
    if root.item.kind != 0: HorizontalLayout {
        padding-left: 4px;
        padding-top: 14px;
        spacing: Tokens.space-2;
        Text {
            text: root.item.title;
            font-size: 11px;
            letter-spacing: 0.8px;
            font-weight: Tokens.weight-bold;
            color: root.item.overdue ? Tokens.error : Tokens.text-muted;
            vertical-alignment: center;
        }
        Text {
            text: root.item.meta;
            font-size: 11px;
            color: Tokens.text-muted;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
        if root.item.kind == 4: Rectangle {
            y: (parent.height - self.height) / 2;
            width: vider.preferred-width + 16px;
            height: 22px;
            border-radius: Tokens.radius-small;
            background: vider-touch.has-hover ? Tokens.error.transparentize(0.85) : transparent;

            accessible-role: button;
            accessible-label: "Delete completed tasks";
            accessible-action-default => { root.clear-completed(); }

            vider := Text {
                text: "Delete completed";
                font-size: 11px;
                color: Tokens.error;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            vider-touch := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.clear-completed(); }
            }
        }
    }

    if root.item.kind == 0: HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        spacing: 12px;

        TaskCheck {
            y: (parent.height - self.height) / 2;
            done: root.item.done;
            label: root.item.title;
            toggled => { root.toggled(root.item.id); }
        }

        VerticalLayout {
            alignment: center;
            spacing: 5px;
            horizontal-stretch: 1;

            // The title, struck through once done.
            Rectangle {
                height: titre.preferred-height;
                titre := Text {
                    width: parent.width;
                    text: root.item.title;
                    font-size: 14px;
                    color: root.item.done ? Tokens.text-muted : Tokens.text;
                    overflow: elide;
                }
                if root.item.done: Rectangle {
                    x: 0;
                    y: parent.height / 2;
                    width: min(titre.preferred-width, parent.width);
                    height: 1px;
                    background: Tokens.text-muted;
                }
            }

            if root.has-meta: HorizontalLayout {
                spacing: Tokens.space-2;
                height: 16px;
                if root.item.meta != "": Text {
                    text: root.item.meta;
                    font-size: 11px;
                    color: root.item.overdue ? Tokens.error : Tokens.text-muted;
                    vertical-alignment: center;
                }
                if root.item.priority > 0: PriorityTag {
                    priority: root.item.priority;
                }
                if root.item.progress != "": HorizontalLayout {
                    spacing: 3px;
                    horizontal-stretch: 0;
                    Icon {
                        y: (parent.height - self.height) / 2;
                        width: 11px;
                        data: Icons.task;
                        size: 11px;
                        tint: Tokens.text-muted;
                    }
                    Text {
                        text: root.item.progress;
                        font-size: 11px;
                        color: Tokens.text-muted;
                        vertical-alignment: center;
                    }
                }
                if root.item.from-mail: Icon {
                    y: (parent.height - self.height) / 2;
                    width: 11px;
                    data: Icons.envelope-closed;
                    size: 11px;
                    tint: Tokens.text-muted;
                }
                if root.item.has-notes: Icon {
                    y: (parent.height - self.height) / 2;
                    width: 11px;
                    data: Icons.notes;
                    size: 11px;
                    tint: Tokens.text-muted;
                }
                if root.item.list != "": HorizontalLayout {
                    spacing: 4px;
                    horizontal-stretch: 0;
                    Rectangle {
                        y: (parent.height - self.height) / 2;
                        width: 7px;
                        height: 7px;
                        border-radius: 3.5px;
                        background: root.item.color;
                    }
                    Text {
                        text: root.item.list;
                        font-size: 11px;
                        color: Tokens.text-muted;
                        vertical-alignment: center;
                    }
                }
                Rectangle { horizontal-stretch: 1; }
            }
        }
    }
}

// A subtask of the selected task.
component SubtaskRow inherits Rectangle {
    in property <SubtaskData> step;
    callback toggled(int);
    callback removed(int);

    height: 32px;
    border-radius: Tokens.radius-small;
    background: touch.has-hover ? Tokens.surface-hover : transparent;

    touch := TouchArea {}

    HorizontalLayout {
        padding-left: 4px;
        spacing: Tokens.space-2;
        TaskCheck {
            y: (parent.height - self.height) / 2;
            size: 17px;
            done: root.step.done;
            label: root.step.title;
            toggled => { root.toggled(root.step.id); }
        }
        Text {
            text: root.step.title;
            font-size: Tokens.size-body;
            color: root.step.done ? Tokens.text-muted : Tokens.text;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }
        if touch.has-hover: IconButton {
            y: (parent.height - self.height) / 2;
            icon: Icons.window-close;
            label: "Remove subtask " + root.step.title;
            button-size: 22px;
            icon-size: 10px;
            clicked => { root.removed(root.step.id); }
        }
    }
}

// The selected task, to change.
component TaskDetail inherits Rectangle {
    in property <TaskDetailData> detail;
    in-out property <string> title;
    in-out property <string> notes;
    in-out property <string> time;
    in property <[string]> lists;
    in property <[string]> reminders;
    in property <bool> picker-open;
    in property <string> picker-title;
    in property <[MonthCellData]> picker-cells;

    callback toggled(int);
    callback title-edited(string);
    callback notes-edited(string);
    callback time-edited(string);
    callback picker-toggled();
    callback picker-navigate(int);
    callback picker-chosen(string);
    callback due-cleared();
    callback reminder-chosen(int);
    callback priority-chosen(int);
    callback list-chosen(int);
    callback step-added(string);
    callback step-toggled(int);
    callback step-removed(int);
    callback open-mail();
    callback delete();
    callback closed();

    property <string> new-step;
    // Two columns of exactly half: a combo box asks for the width of its longest
    // entry, and would push the panel wider than the window gives it.
    property <length> demi: (root.width - 2 * Tokens.space-4 - Tokens.space-2) / 2;

    VerticalLayout {
        padding: Tokens.space-4;
        spacing: Tokens.space-3;

        HorizontalLayout {
            spacing: Tokens.space-2;
            vertical-stretch: 0;
            TaskCheck {
                y: (parent.height - self.height) / 2;
                done: root.detail.done;
                label: "Done";
                toggled => { root.toggled(root.detail.id); }
            }
            TextField {
                accessible-label: "Task title";
                font-size: Tokens.size-title;
                text <=> root.title;
                edited(t) => { root.title-edited(t); }
            }
            IconButton {
                y: (parent.height - self.height) / 2;
                icon: Icons.window-close;
                label: "Close";
                shortcut: "Esc";
                button-size: 24px;
                icon-size: 12px;
                clicked => { root.closed(); }
            }
        }

        Labelled {
            label: "Due";
            HorizontalLayout {
                spacing: Tokens.space-2;
                DateButton {
                    accessible-label: "Due date";
                    text: root.detail.has-due ? root.detail.due-label : "No date";
                    open: root.picker-open;
                    clicked => { root.picker-toggled(); }
                }
                if root.detail.has-due: TextField {
                    width: 70px;
                    accessible-label: "Due time";
                    placeholder-text: "Time";
                    text <=> root.time;
                    edited(t) => { root.time-edited(t); }
                }
                if root.detail.has-due: IconButton {
                    y: (parent.height - self.height) / 2;
                    icon: Icons.window-close;
                    label: "Remove the date";
                    button-size: 26px;
                    icon-size: 11px;
                    clicked => { root.due-cleared(); }
                }
            }
        }

        if root.picker-open: DatePicker {
            title: root.picker-title;
            cells: root.picker-cells;
            navigate(n) => { root.picker-navigate(n); }
            chosen(d) => { root.picker-chosen(d); }
        }

        HorizontalLayout {
            spacing: Tokens.space-2;
            vertical-stretch: 0;
            Labelled {
                width: root.demi;
                label: "Reminder";
                ComboBox {
                    enabled: root.detail.has-due;
                    model: root.reminders;
                    current-index: root.detail.reminder-index;
                    selected => { root.reminder-chosen(self.current-index); }
                }
            }
            Labelled {
                width: root.demi;
                label: "List";
                ComboBox {
                    model: root.lists;
                    current-index: root.detail.list-index;
                    selected => { root.list-chosen(self.current-index); }
                }
            }
        }

        Labelled {
            label: "Priority";
            HorizontalLayout {
                spacing: 4px;
                for nom[i] in ["None", "Low", "Medium", "High"]: CalButton {
                    text: nom;
                    selected: root.detail.priority == i;
                    clicked => { root.priority-chosen(i); }
                }
                Rectangle {}
            }
        }

        if root.detail.source != "": HorizontalLayout {
            spacing: Tokens.space-2;
            vertical-stretch: 0;
            Icon {
                y: (parent.height - self.height) / 2;
                data: root.detail.from-event ? Icons.calendar : Icons.envelope-closed;
                size: 13px;
                tint: Tokens.text-muted;
            }
            Text {
                text: root.detail.source;
                font-size: Tokens.size-small;
                color: Tokens.text-secondary;
                vertical-alignment: center;
                overflow: elide;
                horizontal-stretch: 1;
            }
            if root.detail.from-mail: CalButton {
                text: "Open message";
                clicked => { root.open-mail(); }
            }
        }

        Labelled {
            label: "Subtasks";
            VerticalLayout {
                spacing: 1px;
                for step in root.detail.subtasks: SubtaskRow {
                    step: step;
                    toggled(id) => { root.step-toggled(id); }
                    removed(id) => { root.step-removed(id); }
                }
                TextField {
                    accessible-label: "Add a subtask";
                    placeholder-text: "Add a subtask";
                    text <=> root.new-step;
                    accepted(t) => {
                        if (t != "") {
                            root.step-added(t);
                            root.new-step = "";
                        }
                    }
                }
            }
        }

        Labelled {
            label: "Notes";
            vertical-stretch: 1;
            TextArea {
                accessible-label: "Notes";
                vertical-stretch: 1;
                min-height: 60px;
                placeholder-text: "Anything worth keeping with it";
                text <=> root.notes;
                edited(t) => { root.notes-edited(t); }
            }
        }

        HorizontalLayout {
            height: 28px;
            vertical-stretch: 0;
            CalButton {
                text: "Delete task";
                icon: Icons.trash;
                clicked => { root.delete(); }
            }
            Rectangle {}
        }
    }
}

// The tasks workspace: where things are to do, what there is to do, and the one
// being looked at.
export component TasksView inherits Rectangle {
    in property <string> title;
    /// Under the title: today's date, on Today.
    in property <string> subtitle;
    in property <[TaskPlaceData]> places;
    in property <[TaskRowData]> rows;
    in-out property <string> add-text;
    in property <string> add-hint;
    /// Raised to put the cursor in the quick-add line.
    in property <int> focus-add-request;

    in property <bool> has-detail;
    in property <TaskDetailData> detail;
    in-out property <string> detail-title;
    in-out property <string> detail-notes;
    in-out property <string> detail-time;
    in property <[string]> lists;
    in property <[string]> reminders;
    in property <bool> picker-open;
    in property <string> picker-title;
    in property <[MonthCellData]> picker-cells;

    callback place-chosen(string);
    callback place-menu(TaskPlaceData, length, length);
    callback list-new();
    callback add(string);
    callback row-selected(TaskRowData);
    callback toggled(int);
    callback clear-completed();
    /// A task let go on a list, or on Today.
    callback task-dropped(int, string);

    callback title-edited(string);
    callback notes-edited(string);
    callback time-edited(string);
    callback picker-toggled();
    callback picker-navigate(int);
    callback picker-chosen(string);
    callback due-cleared();
    callback reminder-chosen(int);
    callback priority-chosen(int);
    callback list-chosen(int);
    callback step-added(string);
    callback step-toggled(int);
    callback step-removed(int);
    callback open-mail();
    callback delete();
    callback detail-closed();

    // The task in the hand, and where the pointer is, in window coordinates.
    property <int> carried: -1;
    property <string> carried-title;
    property <length> carry-x;
    property <length> carry-y;
    // Where it was let go, for the list under that point.
    property <int> drop;
    property <int> dropped-id;
    property <length> drop-x;
    property <length> drop-y;

    background: Tokens.background;

    changed focus-add-request => { ajout.focus(); }

    HorizontalLayout {
        // --- Left: the views and the lists ---
        // Docked to the window's edge, as the mail's columns are: square, and
        // separated by the hairline beside it rather than by a rounded border of its
        // own, which drew a curve and a corner at each end.
        Glass {
            width: 240px;
            radius: 0px;
            border-width: 0px;
            VerticalLayout {
                padding: Tokens.space-3;
                spacing: 2px;

                for place in root.places: VerticalLayout {
                    // A title above the first list.
                    if place.is-list && place.key == root.places[4].key: SectionTitle {
                        height: 34px;
                        text: "LISTS";
                        vertical-alignment: bottom;
                    }
                    PlaceRow {
                        place: place;
                        carrying: root.carried >= 0;
                        carry-x: root.carry-x;
                        carry-y: root.carry-y;
                        drop: root.drop;
                        drop-x: root.drop-x;
                        drop-y: root.drop-y;
                        chosen(k) => { root.place-chosen(k); }
                        menu(p, x, y) => { root.place-menu(p, x, y); }
                        dropped(k) => { root.task-dropped(root.dropped-id, k); }
                    }
                }

                Rectangle { height: Tokens.space-2; }
                CalButton {
                    text: "New list";
                    icon: Icons.plus;
                    clicked => { root.list-new(); }
                }
                Rectangle {}
            }
        }

        Rectangle { width: 1px; background: Tokens.border; }

        // --- Middle: what there is to do, and the line to add more at the bottom ---
        VerticalLayout {
            padding-top: 20px;
            padding-bottom: Tokens.space-4;
            padding-left: Tokens.space-6;
            padding-right: Tokens.space-6;
            spacing: Tokens.space-3;
            horizontal-stretch: 1;

            VerticalLayout {
                vertical-stretch: 0;
                spacing: 2px;
                Text {
                    text: root.title;
                    font-family: Tokens.font-family;
                    font-size: 26px;
                    font-weight: Tokens.weight-bold;
                    color: Tokens.text;
                }
                if root.subtitle != "": Text {
                    text: root.subtitle;
                    font-size: Tokens.size-title;
                    color: Tokens.text-muted;
                }
            }

            ScrollView {
                vertical-stretch: 1;
                // The mouse carries tasks; the wheel scrolls.
                mouse-drag-pan-enabled: false;
                VerticalLayout {
                    alignment: start;
                    spacing: 6px;
                    for ligne in root.rows: TaskRow {
                        item: ligne;
                        selected(r) => { root.row-selected(r); }
                        toggled(id) => { root.toggled(id); }
                        clear-completed => { root.clear-completed(); }
                        carry-started(r, x, y) => {
                            root.carried = r.id;
                            root.carried-title = r.title;
                            root.carry-x = x;
                            root.carry-y = y;
                        }
                        carry-moved(x, y) => {
                            root.carry-x = x;
                            root.carry-y = y;
                        }
                        carry-ended => {
                            root.dropped-id = root.carried;
                            root.drop-x = root.carry-x;
                            root.drop-y = root.carry-y;
                            root.drop += 1;
                            root.carried = -1;
                        }
                    }
                    if root.rows.length == 0: Text {
                        height: 120px;
                        text: "Nothing here. Add a task below.";
                        font-size: Tokens.size-body;
                        color: Tokens.text-muted;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }

            // The line to add a task, at the bottom where the eye ends.
            Rectangle {
                height: 48px;
                vertical-stretch: 0;
                border-radius: Tokens.radius-medium;
                border-width: 1px;
                border-color: ajout.has-focus ? Tokens.accent.transparentize(0.4) : Tokens.border;
                background: Tokens.surface;

                HorizontalLayout {
                    padding-left: 14px;
                    padding-right: 6px;
                    spacing: 10px;
                    Icon {
                        y: (parent.height - self.height) / 2;
                        data: Icons.plus;
                        size: 16px;
                        tint: Tokens.text-muted;
                    }
                    ajout := TextField {
                        y: (parent.height - self.height) / 2;
                        height: 36px;
                        accessible-label: "Add a task";
                        placeholder-text: root.add-hint;
                        text <=> root.add-text;
                        accepted(t) => {
                            if (t != "") {
                                root.add(t);
                            }
                        }
                    }
                }
            }
        }

        // --- Right: the selected task ---
        if root.has-detail: Rectangle { width: 1px; background: Tokens.border; }
        if root.has-detail: Glass {
            width: 360px;
            radius: 0px;
            border-width: 0px;
            TaskDetail {
                detail: root.detail;
                title <=> root.detail-title;
                notes <=> root.detail-notes;
                time <=> root.detail-time;
                lists: root.lists;
                reminders: root.reminders;
                picker-open: root.picker-open;
                picker-title: root.picker-title;
                picker-cells: root.picker-cells;
                toggled(id) => { root.toggled(id); }
                title-edited(t) => { root.title-edited(t); }
                notes-edited(t) => { root.notes-edited(t); }
                time-edited(t) => { root.time-edited(t); }
                picker-toggled => { root.picker-toggled(); }
                picker-navigate(n) => { root.picker-navigate(n); }
                picker-chosen(d) => { root.picker-chosen(d); }
                due-cleared => { root.due-cleared(); }
                reminder-chosen(i) => { root.reminder-chosen(i); }
                priority-chosen(p) => { root.priority-chosen(p); }
                list-chosen(i) => { root.list-chosen(i); }
                step-added(t) => { root.step-added(t); }
                step-toggled(id) => { root.step-toggled(id); }
                step-removed(id) => { root.step-removed(id); }
                open-mail => { root.open-mail(); }
                delete => { root.delete(); }
                closed => { root.detail-closed(); }
            }
        }
    }

    // The task in the hand: a lifted card that follows the pointer, a little off it
    // so the lists stay readable underneath.
    if root.carried >= 0: Rectangle {
        x: root.carry-x - root.absolute-position.x + 10px;
        y: root.carry-y - root.absolute-position.y - 22px;
        width: min(320px, carte.preferred-width + 60px);
        height: 44px;
        border-radius: Tokens.radius-medium;
        border-width: 1px;
        border-color: Tokens.accent.transparentize(0.4);
        background: Tokens.background.mix(Tokens.surface-high, 0.35);
        drop-shadow-blur: 18px;
        drop-shadow-offset-y: 8px;
        drop-shadow-color: #00000090;

        HorizontalLayout {
            padding-left: 12px;
            padding-right: 12px;
            spacing: 10px;
            Rectangle {
                y: (parent.height - self.height) / 2;
                width: 18px;
                height: 18px;
                border-radius: 9px;
                border-width: 1.5px;
                border-color: Tokens.text-muted;
            }
            carte := Text {
                text: root.carried-title;
                font-size: 14px;
                color: Tokens.text;
                vertical-alignment: center;
                overflow: elide;
            }
        }
    }
}

// Right click on a list.
export component TaskListMenu inherits Rectangle {
    in property <TaskPlaceData> place;
    in property <bool> can-delete;
    in property <length> menu-x;
    in property <length> menu-y;
    callback rename();
    callback remove();
    callback dismissed();

    TouchArea {
        width: 100%;
        height: 100%;
        clicked => { root.dismissed(); }
    }

    MenuSurface {
        available-width: root.width;
        available-height: root.height;
        menu-x: root.menu-x;
        menu-y: root.menu-y;
        menu-width: 200px;
        menu-height: entries.preferred-height + 8px;

        entries := VerticalLayout {
            padding: 4px;
            HorizontalLayout {
                padding-left: Tokens.space-2;
                padding-right: Tokens.space-2;
                height: 22px;
                Text {
                    text: root.place.name;
                    font-size: 9px;
                    letter-spacing: 0.5px;
                    color: Tokens.text-muted;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }
            MenuSeparator {}
            MenuEntry {
                icon: Icons.pencil;
                label: "Rename…";
                activated => { root.rename(); }
            }
            if root.can-delete: MenuSeparator {}
            if root.can-delete: MenuEntry {
                icon: Icons.trash;
                label: "Delete list…";
                danger: true;
                activated => { root.remove(); }
            }
        }
    }
}

// A name for a list, new or renamed.
export component TaskListNamePanel inherits Rectangle {
    in property <bool> is-new;
    in-out property <string> name;
    in property <string> error;
    callback confirmed();
    callback dismissed();

    PanelFrame {
        width: 100%;
        height: 100%;
        title: root.is-new ? "New list" : "Rename list";
        card-height: 200px;
        dismissed => { root.dismissed(); }

        TextField {
            accessible-label: "List name";
            placeholder-text: "Groceries, Work, Holidays…";
            text <=> root.name;
            // Opened to type: the name is selected, the first key replaces it.
            init => {
                self.focus();
                self.select-all();
            }
            accepted => { root.confirmed(); }
        }

        if root.error != "": Text {
            text: root.error;
            font-size: Tokens.size-small;
            color: Tokens.error;
            wrap: word-wrap;
        }

        Rectangle {}

        HorizontalLayout {
            height: 28px;
            spacing: Tokens.space-2;
            vertical-stretch: 0;
            Rectangle {}
            CalButton {
                text: "Cancel";
                clicked => { root.dismissed(); }
            }
            CalButton {
                text: root.is-new ? "Create" : "Rename";
                primary: true;
                clicked => { root.confirmed(); }
            }
        }
    }
}

// Deleting a list asks first: its tasks go with it.
export component TaskListDeletePanel inherits Rectangle {
    in property <string> name;
    in property <int> count;
    callback confirmed();
    callback dismissed();

    PanelFrame {
        width: 100%;
        height: 100%;
        title: "Delete this list?";
        card-height: 200px;
        dismissed => { root.dismissed(); }

        Text {
            text: root.count == 0
                ? "“" + root.name + "” is empty. It will be removed."
                : "“" + root.name + "” and its " + root.count + " task(s) to do are deleted. "
                    + "This cannot be undone.";
            font-size: Tokens.size-body;
            color: Tokens.text-secondary;
            wrap: word-wrap;
        }

        Rectangle {}

        HorizontalLayout {
            height: 28px;
            spacing: Tokens.space-2;
            vertical-stretch: 0;
            Rectangle {}
            CalButton {
                text: "Cancel";
                clicked => { root.dismissed(); }
            }
            CalButton {
                text: "Delete";
                primary: true;
                danger: true;
                clicked => { root.confirmed(); }
            }
        }
    }
}
