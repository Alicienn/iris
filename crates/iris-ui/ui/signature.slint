import { Tokens } from "tokens.slint";
import { TextArea } from "field.slint";
import { Floating } from "glass.slint";
import { Icon, Icons, IconButton } from "icons.slint";


// La signature d'un compte.
//
// Par compte, et donc atteinte depuis le menu du compte plutôt que depuis les réglages
// généraux : c'est la raison d'avoir plusieurs boîtes qu'on ne signe pas une facture
// comme on écrit à sa sœur.
export component SignaturePanel inherits Rectangle {
    in property <string> account;
    in-out property <string> signature;

    callback saved();
    callback dismissed();

    background: Tokens.scrim;

    TouchArea {
        clicked => { root.dismissed(); }
    }

    Floating {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: min(520px, parent.width - 80px);
        height: min(420px, parent.height - 80px);

        // Le panneau avale les clics : sans cela, taper dedans fermerait la fenêtre en
        // touchant le voile derrière.
        TouchArea {}

        VerticalLayout {
            padding: Tokens.space-4;
            spacing: Tokens.space-3;

            HorizontalLayout {
                vertical-stretch: 0;
                height: 28px;

                Text {
                    text: "Signature";
                    font-family: Tokens.font-family;
                    font-size: Tokens.size-title;
                    font-weight: Tokens.weight-bold;
                    color: Tokens.text;
                    vertical-alignment: center;
                }
                Rectangle {}
                IconButton {
                    y: (parent.height - self.height) / 2;
                    icon: Icons.window-close;
                    label: "Close";
                    button-size: 24px;
                    icon-size: 13px;
                    clicked => { root.dismissed(); }
                }
            }

            Text {
                text: "Added to messages sent from " + root.account + ".";
                font-size: Tokens.size-small;
                color: Tokens.text-muted;
                wrap: word-wrap;
            }

            Rectangle { height: 1px; background: Tokens.border; }

            TextArea {
                vertical-stretch: 1;
                accessible-label: "Signature";
                placeholder-text: "Marie Durand\nScierie mobile, 01 23 45 67 89";
                font-size: Tokens.size-body;
                wrap: word-wrap;
                text <=> root.signature;
            }

            // Ce que l'application ajoute d'elle-même, dit une fois plutôt que
            // découvert dans un message reçu en retour.
            Text {
                text: "Iris puts the standard \"-- \" separator above it, so replies "
                    + "quote your message and not your signature.";
                font-size: Tokens.size-small;
                color: Tokens.text-muted;
                wrap: word-wrap;
            }

            HorizontalLayout {
                vertical-stretch: 0;
                height: 28px;
                spacing: Tokens.space-2;

                Rectangle {}

                Rectangle {
                    width: 76px;
                    border-radius: Tokens.radius-small;
                    background: enregistrer.has-hover
                        ? Tokens.accent
                        : Tokens.accent.transparentize(0.12);
                    animate background { duration: Tokens.instant; }

                    accessible-role: button;
                    accessible-label: "Save the signature";
                    accessible-action-default => { root.saved(); }

                    Text {
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        text: "Save";
                        font-size: Tokens.size-small;
                        font-weight: Tokens.weight-bold;
                        color: Tokens.accent-text;
                    }

                    enregistrer := TouchArea {
                        clicked => { root.saved(); }
                    }
                }
            }
        }
    }
}
