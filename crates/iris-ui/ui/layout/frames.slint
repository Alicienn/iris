import { Tokens } from "@iris/theme/tokens.slint";
import { Layout } from "@iris/theme/layout.slint";
import { Icon, Icons, IconButton } from "@iris/base/icons.slint";

/// What a window over the others is, which says how it shows in a narrow window.
export enum ModalKind {
    /// Something to fill in or read: a page of its own.
    form,
    /// A short question (delete, empty): a sheet from the bottom.
    question,
}
import { Hairline, VHairline } from "@iris/base/atoms.slint";
import { Button, ButtonKind, ButtonSize } from "@iris/controls/button.slint";

// The frames screens are laid out in. A column docked to the window is square with a
// hairline beside it; what floats is rounded, opaque and shadowed. Nothing straight
// is drawn across a rounded corner.

/// The column on the left of a workspace: its main action, its sections, its foot.
export component Rail inherits Rectangle {
    in property <length> rail-width: 240px;

    width: root.rail-width;
    background: Tokens.surface-low;

    VerticalLayout {
        padding: 12px;
        padding-top: 14px;
        padding-bottom: 10px;
        spacing: 2px;
        @children
    }
    VHairline {
        x: parent.width - 1px;
    }
}

/// The top of a screen: its name, large and thin, a quieter line beside it, and on
/// the right what acts on the whole screen (a progress, a view switch).
export component PageHeader inherits HorizontalLayout {
    in property <string> title;
    in property <string> subtitle;

    spacing: 14px;
    height: 44px;

    Text {
        text: root.title;
        font-family: Tokens.font-display;
        font-size: 34px;
        font-weight: 300;
        letter-spacing: -0.6px;
        color: Tokens.text;
        vertical-alignment: bottom;
    }
    if root.subtitle != "": Text {
        text: root.subtitle;
        font-size: 14px;
        color: Tokens.text-secondary;
        vertical-alignment: bottom;
        y: -3px;
    }
    Rectangle { horizontal-stretch: 1; }
    @children
}

/// A group on a plate of its own: a border, a faint ground, rounded.
export component Plate inherits Rectangle {
    in property <length> inset: 6px;

    border-radius: Tokens.radius-large;
    border-width: 1px;
    border-color: Tokens.border;
    background: Tokens.surface-low;
    clip: true;

    VerticalLayout {
        padding: root.inset;
        spacing: 0px;
        @children
    }
}

/// The panel on the right that shows the thing chosen: docked, square, a hairline on
/// its left.
export component DetailPanel inherits Rectangle {
    in property <length> panel-width: 372px;

    // A card that floats beside what it is about, off the window's edges: rounded
    // all round, with a shadow, rather than a strip docked to the side.
    width: root.panel-width + 12px;

    // It arrives: a few pixels from the side and a fade, once, when it opens.
    property <float> entree: 0;
    init => { root.entree = 1; }
    animate entree { duration: Tokens.moderate; easing: ease-out; }

    carte := Rectangle {
        x: (1 - root.entree) * 14px;
        y: 12px;
        opacity: 0.3 + 0.7 * root.entree;
        width: parent.width - 12px;
        height: parent.height - 24px;
        border-radius: Tokens.radius-large;
        border-width: 1px;
        border-color: Tokens.border;
        background: Tokens.panel;
        drop-shadow-blur: Tokens.shadow-float-blur;
        drop-shadow-offset-y: Tokens.shadow-float-y;
        drop-shadow-color: Tokens.shadow-float;

        VerticalLayout {
            padding-left: 20px;
            padding-right: 20px;
            padding-top: 14px;
            padding-bottom: 14px;
            spacing: 14px;
            @children
        }
    }
}

/// A row of actions over what they act on.
export component Toolbar inherits Rectangle {
    height: 48px;

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 2px;
        alignment: stretch;
        @children
    }
    Hairline { y: parent.height - 1px; }
}

/// Nothing to show: a sentence, and the way to change that.
export component EmptyState inherits VerticalLayout {
    in property <string> text;
    in property <string> action;
    callback act();

    alignment: center;
    spacing: 12px;
    padding: 24px;

    Text {
        text: root.text;
        font-size: 13px;
        color: Tokens.text-muted;
        horizontal-alignment: center;
        wrap: word-wrap;
    }
    if root.action != "": HorizontalLayout {
        alignment: center;
        Button {
            text: root.action;
            size: ButtonSize.sm;
            clicked => { root.act(); }
        }
    }
}

/// A window over the others: a veil, a card in the middle, its title, its close
/// button, and Escape. One place for all of that, so every window behaves alike.
///
/// Escape reaches the card even from a field: a field does not want the key and hands
/// it up. The scope is never focused itself, so it takes no click away from anything.
export component Modal inherits Rectangle {
    in property <string> title;
    /// The whole title on as many lines as it takes.
    in property <bool> wrap-title;
    in property <length> card-width: 460px;
    in property <length> card-height: 420px;
    /// Grow with the content rather than take `card-height`.
    in property <bool> fit;
    /// What the close button says to a screen reader: "Close settings".
    in property <string> close-label: "Close";
    /// A form fills a narrow window as a page; a question rises from its bottom as a
    /// sheet. From 600 pixels wide, both are the centred card.
    in property <ModalKind> kind: ModalKind.form;
    callback dismissed();
    /// Escape, from anywhere in the card. Closes by default.
    callback escaped();
    escaped => { root.dismissed(); }

    property <bool> page: Layout.compact && root.kind == ModalKind.form;
    property <bool> sheet: Layout.compact && root.kind == ModalKind.question;
    /// How far a sheet is pulled down by its handle.
    property <length> tire: 0px;

    background: root.page ? transparent : Tokens.scrim;

    // It comes in: the dimming fades up, the card rises a few pixels. Once, on
    // opening.
    property <float> entree: 0;
    init => { root.entree = 1; }
    animate entree { duration: Tokens.moderate; easing: ease-out; }
    opacity: root.entree;

    FocusScope {
        enabled: false;
        key-pressed(event) => {
            if (event.text == Key.Escape || event.text == Key.Back) {
                root.escaped();
                return accept;
            }
            return reject;
        }

    TouchArea {
        clicked => { root.dismissed(); }
    }

    carte := Rectangle {
        x: root.page || root.sheet ? 0px : (parent.width - self.width) / 2;
        y: root.page ? (1 - root.entree) * 12px
            : root.sheet ? parent.height - self.height + root.tire + (1 - root.entree) * 24px
            : (parent.height - self.height) / 2 + (1 - root.entree) * 12px;
        width: root.page || root.sheet ? parent.width : min(root.card-width, parent.width - 60px);
        height: root.page ? parent.height
            : root.sheet ? min(contenu.preferred-height + Layout.inset-bottom, parent.height - 48px - Layout.inset-top)
            : min(root.fit ? contenu.preferred-height : root.card-height, parent.height - 60px);
        border-top-left-radius: root.page ? 0px : root.sheet ? 22px : Tokens.radius-large;
        border-top-right-radius: root.page ? 0px : root.sheet ? 22px : Tokens.radius-large;
        border-bottom-left-radius: root.page || root.sheet ? 0px : Tokens.radius-large;
        border-bottom-right-radius: root.page || root.sheet ? 0px : Tokens.radius-large;
        background: Tokens.panel;
        border-width: root.page || root.sheet ? 0px : 1px;
        border-color: Tokens.border-strong;
        drop-shadow-blur: root.page ? 0px : Tokens.shadow-window-blur;
        drop-shadow-color: Tokens.shadow-window;
        drop-shadow-offset-y: Tokens.shadow-window-y;
        clip: true;

        // Clicks inside the card stay inside it.
        TouchArea {}

        // A sheet's handle: pulled down far enough, it closes the sheet.
        Rectangle {
            visible: root.sheet;
            x: (parent.width - self.width) / 2;
            y: 8px;
            width: 40px;
            height: 5px;
            border-radius: 3px;
            background: Tokens.border-strong;
        }
        if root.sheet: TouchArea {
            y: 0px;
            height: 28px;
            moved => {
                root.tire = max(0px, self.mouse-y - self.pressed-y);
            }
            pointer-event(e) => {
                if (e.kind == PointerEventKind.up) {
                    if (root.tire > 80px) {
                        root.dismissed();
                    }
                    root.tire = 0px;
                }
            }
        }

        contenu := VerticalLayout {
            // A form that grows with its content keeps its own height on a page, from
            // the top: spread over the whole screen, its fields drifted apart.
            height: root.page && root.fit ? min(self.preferred-height, parent.height) : parent.height;
            padding: 20px;
            padding-top: root.page ? 6px + Layout.inset-top : root.sheet ? 26px : 18px;
            padding-bottom: root.page || root.sheet ? 20px + Layout.inset-bottom : 20px;
            spacing: 14px;

            // A page, as a phone has it: back at the top left, the title large under it.
            if root.page: VerticalLayout {
                vertical-stretch: 0;
                spacing: 4px;
                HorizontalLayout {
                    alignment: start;
                    IconButton {
                        icon: Icons.arrow-left;
                        label: root.close-label;
                        button-size: 44px;
                        icon-size: 22px;
                        clicked => { root.dismissed(); }
                    }
                }
                Text {
                    text: root.title;
                    font-family: Tokens.font-display;
                    font-size: 28px;
                    font-weight: 600;
                    color: Tokens.text;
                    wrap: word-wrap;
                }
            }

            if !root.page: HorizontalLayout {
                min-height: 28px;
                vertical-stretch: 0;
                spacing: 8px;
                // A sheet's title as the mockups' ("Snooze until"): larger, and no
                // cross: the handle, the dimming and Back close it.
                Text {
                    text: root.title;
                    font-family: Tokens.font-display;
                    font-size: root.sheet ? 19px : 16px;
                    font-weight: root.sheet ? 600 : 700;
                    color: Tokens.text;
                    vertical-alignment: root.wrap-title ? top : center;
                    wrap: root.wrap-title ? word-wrap : no-wrap;
                    overflow: root.wrap-title ? clip : elide;
                    horizontal-stretch: 1;
                }
                if !root.sheet: IconButton {
                    y: root.wrap-title ? 2px : (parent.height - self.height) / 2;
                    icon: Icons.window-close;
                    label: root.close-label;
                    shortcut: "Esc";
                    button-size: 26px;
                    icon-size: 13px;
                    clicked => { root.dismissed(); }
                }
            }

            @children
        }
    }
    }
}

/// The buttons at the foot of a window, on the right; what they do on the left.
export component ModalFooter inherits HorizontalLayout {
    in property <string> note;

    height: 32px;
    vertical-stretch: 0;
    spacing: 8px;

    Text {
        text: root.note;
        font-size: 12px;
        color: Tokens.text-muted;
        vertical-alignment: center;
        overflow: elide;
        horizontal-stretch: 1;
    }
    @children
}

/// A card beside the thing it is about, pointing at it: an event in the week.
///
/// It opens on the left of its anchor, or on the right when there is no room, and stays
/// inside the window. A click outside closes it, and so does Escape.
export component Popover inherits Rectangle {
    /// The anchor, in window coordinates: its left and right edges, and its top.
    in property <length> anchor-left;
    in property <length> anchor-right;
    in property <length> anchor-top;
    in property <length> card-width: 320px;
    /// In a narrow window it stays beside its anchor instead of rising as a sheet.
    in property <bool> anchored-in-compact;
    callback dismissed();

    /// In a narrow window: a sheet from the bottom, half the window at first, the
    /// whole of it when pulled up by its handle.
    property <bool> sheet: Layout.compact && !root.anchored-in-compact;
    property <bool> haute: false;
    property <length> tire: 0px;
    property <bool> a-gauche: root.anchor-left - root.card-width - 14px >= 8px;
    property <length> hauteur: contenu.preferred-height;

    // A fade, and a few pixels toward its anchor, once.
    property <float> entree: 0;
    init => { root.entree = 1; }
    animate entree { duration: Tokens.quick; easing: ease-out; }

    background: root.sheet ? Tokens.scrim : transparent;

    FocusScope {
        enabled: false;
        key-pressed(event) => {
            if (event.text == Key.Escape || event.text == Key.Back) {
                root.dismissed();
                return accept;
            }
            return reject;
        }

    TouchArea {
        clicked => { root.dismissed(); }
    }

    carte := Rectangle {
        x: root.sheet ? 0px
            : (root.a-gauche
                ? root.anchor-left - root.card-width - 12px
                : min(root.anchor-right + 12px, root.width - root.card-width - 8px))
                + (1 - root.entree) * (root.a-gauche ? -8px : 8px);
        y: root.sheet ? root.height - self.height + max(0px, root.tire)
            : max(8px, min(root.anchor-top - 24px, root.height - root.hauteur - 8px));
        width: root.sheet ? root.width : root.card-width;
        height: root.sheet
            ? (root.haute ? root.height - 48px - Layout.inset-top : root.height / 2)
            : root.hauteur;
        opacity: root.entree;
        border-top-left-radius: root.sheet ? 22px : Tokens.radius-large;
        border-top-right-radius: root.sheet ? 22px : Tokens.radius-large;
        border-bottom-left-radius: root.sheet ? 0px : Tokens.radius-large;
        border-bottom-right-radius: root.sheet ? 0px : Tokens.radius-large;
        background: Tokens.panel;
        border-width: root.sheet ? 0px : 1px;
        border-color: Tokens.border-strong;
        drop-shadow-blur: Tokens.shadow-float-blur;
        drop-shadow-color: Tokens.shadow-float;
        drop-shadow-offset-y: Tokens.shadow-float-y;
        clip: root.sheet;

        TouchArea {}

        Rectangle {
            visible: root.sheet;
            x: (parent.width - self.width) / 2;
            y: 8px;
            width: 40px;
            height: 5px;
            border-radius: 3px;
            background: Tokens.border-strong;
        }
        // Up by the handle: the whole window; down: closed past 80 pixels.
        if root.sheet: TouchArea {
            y: 0px;
            height: 28px;
            moved => {
                root.tire = self.mouse-y - self.pressed-y;
            }
            pointer-event(e) => {
                if (e.kind == PointerEventKind.up) {
                    if (root.tire > 80px) {
                        root.dismissed();
                    } else if (root.tire < -40px) {
                        root.haute = true;
                    }
                    root.tire = 0px;
                }
            }
        }

        contenu := VerticalLayout {
            padding: 16px;
            padding-top: root.sheet ? 26px : 16px;
            padding-bottom: root.sheet ? 16px + Layout.inset-bottom : 16px;
            spacing: 12px;
            @children
        }
    }
    }
}
