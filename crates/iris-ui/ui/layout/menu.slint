import { Tokens } from "@iris/theme/tokens.slint";
import { Layout } from "@iris/theme/layout.slint";
import { Icon, Icons } from "@iris/base/icons.slint";

// One line of a context menu.
//
// Shared by the message list and the accounts column rather than copied into each.
// Two menus that drift apart in padding, hover colour and icon size read as two
// applications, and the drift is invisible until they are seen side by side.
export component MenuEntry inherits Rectangle {
    in property <string> icon;
    in property <string> label;
    in property <string> shortcut;
    /// A destructive action: red, always, so it is seen before it is pointed at.
    in property <bool> danger;
    /// It opens a menu of its own, on the right.
    in property <bool> chevron;
    /// Its submenu shows: drawn as pointed at.
    in property <bool> open;
    /// Shown but not for now (Copy with nothing selected): dimmed, and a click on it
    /// does nothing.
    in property <bool> enabled: true;
    out property <bool> hovered: touch.has-hover;

    callback activated();

    /// On a phone menus are sheets, and their entries the mockups' options: 56 pixels,
    /// a larger label, the icon muted.
    property <bool> grand: Layout.compact;

    height: root.grand ? 56px : max(30px, Layout.target);

    // The plate as a child: an animated `background` on the root made Slint copy the
    // whole entry into each of its 127 places (the generated code outgrew the CI's
    // memory, 7.0.0).
    Rectangle {
        border-radius: Tokens.radius-small;
        // A finger leaves no hover behind it: in a sheet, only the press shows.
        background: !root.enabled ? transparent
            : root.grand ? (touch.pressed ? Tokens.surface-active : transparent)
            : root.danger && touch.has-hover ? Tokens.error.transparentize(0.88)
            : touch.has-hover || root.open ? Tokens.surface-active : transparent;
        animate background { duration: Tokens.instant; }
    }

    accessible-role: button;
    accessible-label: root.label;
    accessible-description: root.shortcut;
    accessible-action-default => {
        if (root.enabled) {
            root.activated();
        }
    }

    HorizontalLayout {
        padding-left: root.grand ? 18px : 9px;
        padding-right: root.grand ? 18px : 9px;
        spacing: root.grand ? 16px : 10px;

        Icon {
            y: (parent.height - self.height) / 2;
            data: root.icon;
            size: root.grand ? 20px : 15px;
            tint: !root.enabled ? Tokens.text-faint
                : root.danger ? Tokens.error
                : root.grand ? Tokens.text-muted : Tokens.text-secondary;
        }
        Text {
            text: root.label;
            font-size: root.grand ? 16px : 13.5px;
            color: !root.enabled ? Tokens.text-faint
                : root.danger ? Tokens.error : Tokens.text;
            vertical-alignment: center;
            overflow: elide;
        }
        Rectangle {}
        // A key means nothing on a phone.
        if root.shortcut != "" && !root.grand: Text {
            text: root.shortcut;
            font-size: 11.5px;
            color: Tokens.text-faint;
            vertical-alignment: center;
        }
        if root.chevron: Icon {
            y: (parent.height - self.height) / 2;
            data: Icons.chevron-right;
            size: 11px;
            weight: 2;
            tint: Tokens.text-muted;
        }
    }

    // Still there when disabled: the click is swallowed rather than closing the menu.
    touch := TouchArea {
        clicked => {
            if (root.enabled) {
                root.activated();
            }
        }
    }
}

// What the entries below it are about: "Snooze until".
export component MenuHeader inherits Rectangle {
    in property <string> text;
    // A sheet's title on a phone.
    property <bool> grand: Layout.compact;
    height: root.grand ? 44px : 24px;
    Text {
        x: root.grand ? 16px : 9px;
        height: parent.height;
        text: root.text;
        font-family: root.grand ? Tokens.font-display : Tokens.font-family;
        font-size: root.grand ? 19px : 11.5px;
        font-weight: 600;
        color: root.grand ? Tokens.text : Tokens.text-muted;
        vertical-alignment: center;
    }
}

// A thin rule between groups of entries.
export component MenuSeparator inherits Rectangle {
    height: 9px;
    // Edge to edge in a sheet, as the mockups' rule above "Pick a date and time".
    Rectangle {
        x: Layout.compact ? -4px : 5px;
        width: Layout.compact ? parent.width + 8px : parent.width - 10px;
        height: 1px;
        background: Tokens.border;
    }
}

// The plate a menu is drawn on.
//
// Opaque, and that is the whole point of it existing. Every floating menu in the
// application was painted on a nine-percent white wash, which over a message list
// means the list showed through the labels and neither could be read.
//
// On a phone it is a sheet, as the Android mockups draw it (`..\Iris-designndroid`,
// "Snooze until"): the whole width, rounded at the top only, over a dimmed window, a
// handle at the top that closes it when pulled down, its entries 56 pixels tall.
export component MenuSurface inherits Rectangle {
    in property <length> menu-x;
    in property <length> menu-y;
    in property <length> menu-width: 200px;
    in property <length> menu-height;
    // The room the menu has. Passed in rather than read off the parent: the root of a
    // component cannot see what it was placed inside.
    in property <length> available-width;
    in property <length> available-height;
    /// In a narrow window it stays at its point instead of rising from the bottom as a
    /// sheet.
    in property <bool> anchored-in-compact;
    /// A sheet tapped outside or pulled down. A menu also closes from the veil its
    /// owner lays under it, which a sheet's own dimming covers.
    callback dismissed();

    property <bool> sheet: Layout.compact && !root.anchored-in-compact;
    /// The handle's strip at the top of a sheet, and the room left above the gesture
    /// bar at its foot.
    property <length> poignee: root.sheet ? 20px : 0px;
    property <length> pied: root.sheet ? 8px + Layout.inset-bottom : 0px;
    /// How far a sheet is pulled down.
    property <length> tire;

    // Kept inside the window: a menu opened near an edge must not fall off it.
    // It drops open: a fade and four pixels, once; a sheet rises.
    property <float> entree: 0;
    init => { root.entree = 1; }
    animate entree { duration: Tokens.quick; easing: ease-out; }
    opacity: root.sheet ? 1 : root.entree;

    x: root.sheet ? 0px : max(8px, min(root.menu-x, root.available-width - root.menu-width - 8px));
    // A sheet rises from below the screen, and goes back down there when it closes.
    y: root.sheet
        ? root.available-height - self.height + root.tire + (1 - root.entree) * self.height
        : max(8px, min(root.menu-y, root.available-height - root.menu-height - 8px))
            - (1 - root.entree) * 4px;
    width: root.sheet ? root.available-width : root.menu-width;
    height: root.menu-height + root.poignee + root.pied;
    // A sheet draws its plate itself, over its dimming.
    border-radius: Tokens.radius-large;
    background: root.sheet ? transparent : Tokens.panel;
    border-width: root.sheet ? 0px : 1px;
    border-color: Tokens.border-strong;
    drop-shadow-blur: root.sheet ? 0px : Tokens.shadow-float-blur;
    drop-shadow-color: Tokens.shadow-float;
    drop-shadow-offset-y: Tokens.shadow-float-y;

    /// Closes it: a sheet slides down and its dimming fades first, then it is gone.
    public function close() {
        if (!root.sheet) {
            root.dismissed();
            return;
        }
        root.sortie = true;
        root.entree = 0;
    }
    property <bool> sortie;
    Timer {
        interval: Tokens.quick;
        running: root.sortie;
        triggered => {
            root.sortie = false;
            root.dismissed();
        }
    }

    Rectangle {
        visible: root.sheet;
        x: -root.x;
        y: -root.y;
        width: root.available-width;
        height: root.available-height;
        background: Tokens.scrim;
        opacity: root.entree;
        // A tap on the dimming closes the sheet as it slides down; a menu's taps go
        // through to the owner's veil, which closes it as it always has.
        TouchArea {
            clicked => { root.close(); }
        }
    }
    if root.sheet: Rectangle {
        border-top-left-radius: 22px;
        border-top-right-radius: 22px;
        background: Tokens.panel;
        drop-shadow-blur: Tokens.shadow-window-blur;
        drop-shadow-color: Tokens.shadow-window;
        // The bottom edge reaches past the screen, so a sheet pulled up never shows
        // a gap under it.
        height: parent.height + 40px;
    }

    // Swallows clicks, so choosing an item does not also hit the veil behind it.
    TouchArea {}

    Rectangle {
        visible: root.sheet;
        x: (parent.width - self.width) / 2;
        y: 8px;
        width: 40px;
        height: 5px;
        border-radius: 3px;
        background: Tokens.border-strong;
    }
    if root.sheet: TouchArea {
        y: 0px;
        height: 28px;
        moved => {
            root.tire = max(0px, self.mouse-y - self.pressed-y);
        }
        pointer-event(e) => {
            if (e.kind == PointerEventKind.up) {
                if (root.tire > 60px) {
                    root.close();
                }
                root.tire = 0px;
            }
        }
    }

    Rectangle {
        y: root.poignee;
        height: root.menu-height;
        @children
    }
}
