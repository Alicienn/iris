import { Tokens } from "@iris/theme/tokens.slint";
import { Icon, Icons } from "@iris/base/icons.slint";

// One line of a context menu.
//
// Shared by the message list and the accounts column rather than copied into each.
// Two menus that drift apart in padding, hover colour and icon size read as two
// applications, and the drift is invisible until they are seen side by side.
export component MenuEntry inherits Rectangle {
    in property <string> icon;
    in property <string> label;
    in property <string> shortcut;
    /// A destructive action: red, always, so it is seen before it is pointed at.
    in property <bool> danger;
    /// It opens a menu of its own, on the right.
    in property <bool> chevron;
    /// Its submenu shows: drawn as pointed at.
    in property <bool> open;
    out property <bool> hovered: touch.has-hover;

    callback activated();

    height: 30px;
    border-radius: Tokens.radius-small;
    background: root.danger && touch.has-hover ? Tokens.error.transparentize(0.88)
        : touch.has-hover || root.open ? Tokens.surface-active : transparent;
    animate background { duration: Tokens.instant; }

    accessible-role: button;
    accessible-label: root.label;
    accessible-description: root.shortcut;
    accessible-action-default => { root.activated(); }

    HorizontalLayout {
        padding-left: 9px;
        padding-right: 9px;
        spacing: 10px;

        Icon {
            y: (parent.height - self.height) / 2;
            data: root.icon;
            size: 15px;
            tint: root.danger ? Tokens.error : Tokens.text-secondary;
        }
        Text {
            text: root.label;
            font-size: 13.5px;
            color: root.danger ? Tokens.error : Tokens.text;
            vertical-alignment: center;
            overflow: elide;
        }
        Rectangle {}
        if root.shortcut != "": Text {
            text: root.shortcut;
            font-size: 11.5px;
            color: Tokens.text-faint;
            vertical-alignment: center;
        }
        if root.chevron: Icon {
            y: (parent.height - self.height) / 2;
            data: Icons.chevron-right;
            size: 11px;
            weight: 2;
            tint: Tokens.text-muted;
        }
    }

    touch := TouchArea {
        clicked => { root.activated(); }
    }
}

// What the entries below it are about: "Snooze until".
export component MenuHeader inherits Rectangle {
    in property <string> text;
    height: 24px;
    Text {
        x: 9px;
        height: parent.height;
        text: root.text;
        font-size: 11.5px;
        font-weight: 600;
        color: Tokens.text-muted;
        vertical-alignment: center;
    }
}

// A thin rule between groups of entries.
export component MenuSeparator inherits Rectangle {
    height: 9px;
    Rectangle {
        x: 5px;
        width: parent.width - 10px;
        height: 1px;
        background: Tokens.border;
    }
}

// The plate a menu is drawn on.
//
// Opaque, and that is the whole point of it existing. Every floating menu in the
// application was painted on a nine-percent white wash, which over a message list
// means the list showed through the labels and neither could be read.
export component MenuSurface inherits Rectangle {
    in property <length> menu-x;
    in property <length> menu-y;
    in property <length> menu-width: 200px;
    in property <length> menu-height;
    // The room the menu has. Passed in rather than read off the parent: the root of a
    // component cannot see what it was placed inside.
    in property <length> available-width;
    in property <length> available-height;

    // Kept inside the window: a menu opened near an edge must not fall off it.
    // It drops open: a fade and four pixels, once.
    property <float> entree: 0;
    init => { root.entree = 1; }
    animate entree { duration: Tokens.quick; easing: ease-out; }
    opacity: root.entree;

    x: max(8px, min(root.menu-x, root.available-width - root.menu-width - 8px));
    y: max(8px, min(root.menu-y, root.available-height - root.menu-height - 8px))
        - (1 - root.entree) * 4px;
    width: root.menu-width;
    height: root.menu-height;
    border-radius: Tokens.radius-large;
    background: Tokens.panel;
    border-width: 1px;
    border-color: Tokens.border-strong;
    drop-shadow-blur: Tokens.shadow-float-blur;
    drop-shadow-color: Tokens.shadow-float;
    drop-shadow-offset-y: Tokens.shadow-float-y;

    // Swallows clicks, so choosing an item does not also hit the veil behind it.
    TouchArea {}

    @children
}
