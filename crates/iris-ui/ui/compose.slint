import { Tokens } from "tokens.slint";
import { TextField, TextArea } from "field.slint";
import { Floating } from "glass.slint";
import { Icon, Icons, IconButton } from "icons.slint";
import { ComboBox, ListView } from "std-widgets.slint";

// One labelled field of the header block.
component Field inherits VerticalLayout {
    in property <string> label;
    in property <string> placeholder;
    in-out property <string> value;
    /// Les correspondants qui ressemblent à ce qu'on tape. Vide : rien ne s'affiche.
    in property <[string]> suggestions;
    /// Take the keyboard as soon as the field appears.
    in property <bool> autofocus;

    callback accepted();
    callback edited(string);
    callback picked(string);

    spacing: 2px;

    HorizontalLayout {
        spacing: Tokens.space-2;
        height: 30px;

        Text {
            width: 34px;
            text: root.label;
            font-size: Tokens.size-small;
            color: Tokens.text-muted;
            vertical-alignment: center;
        }

        champ := TextField {
            // Ouvrir pour écrire, c'est vouloir écrire : sans cela, la première touche
            // partait vers la liste derrière la fenêtre.
            init => { if (root.autofocus) { self.focus(); } }
            accessible-label: root.label;
            placeholder-text: root.placeholder;
            font-size: Tokens.size-body;
            text <=> root.value;
            accepted => { root.accepted(); }
            edited(t) => { root.edited(t); }
        }
    }

    // Les correspondants proposés, en pastilles sous le champ.
    //
    // Sous le champ et non par-dessus : une liste flottante demanderait une couche
    // au-dessus de tout, et ce fichier a déjà payé trois fois le prix de l'ordre
    // d'empilement. Ici rien ne recouvre rien — la fenêtre grandit de vingt-quatre
    // pixels le temps qu'on choisisse, et c'est tout.
    if champ.has-focus && root.suggestions.length > 0: HorizontalLayout {
        padding-left: 34px + Tokens.space-2;
        spacing: Tokens.space-1;
        height: 24px;

        for proposition in root.suggestions: Rectangle {
            width: etiquette.preferred-width + 2 * Tokens.space-2;
            border-radius: Tokens.radius-small;
            background: pastille.has-hover ? Tokens.accent : Tokens.surface;
            border-width: 1px;
            border-color: Tokens.border;
            animate background { duration: Tokens.instant; }

            accessible-role: button;
            accessible-label: proposition;
            accessible-action-default => { root.picked(proposition); }

            etiquette := Text {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                text: proposition;
                font-size: Tokens.size-small;
                color: pastille.has-hover ? Tokens.accent-text : Tokens.text-secondary;
                overflow: elide;
            }

            pastille := TouchArea {
                clicked => { root.picked(proposition); }
            }
        }

        Rectangle {}
    }
}

// The formatting strip.
//
// Only what people actually reach for. A word processor's worth of controls in a
// mail window is a row of buttons nobody presses, taking the space the message needs.
component FormatBar inherits HorizontalLayout {
    callback apply(string);

    spacing: 1px;
    height: 26px;

    IconButton {
        icon: Icons.bold;
        label: "Bold";
        shortcut: "Ctrl+B";
        button-size: 26px;
        icon-size: 15px;
        clicked => { root.apply("bold"); }
    }
    IconButton {
        icon: Icons.italic;
        label: "Italic";
        shortcut: "Ctrl+I";
        button-size: 26px;
        icon-size: 15px;
        clicked => { root.apply("italic"); }
    }
    IconButton {
        icon: Icons.underline;
        label: "Underline";
        shortcut: "Ctrl+U";
        button-size: 26px;
        icon-size: 15px;
        clicked => { root.apply("underline"); }
    }

    Rectangle { width: Tokens.space-2; }

    IconButton {
        icon: Icons.link;
        label: "Insert link";
        shortcut: "Ctrl+K";
        button-size: 26px;
        icon-size: 15px;
        clicked => { root.apply("link"); }
    }
    IconButton {
        icon: Icons.list;
        label: "Bulleted list";
        button-size: 26px;
        icon-size: 15px;
        clicked => { root.apply("list"); }
    }
    IconButton {
        icon: Icons.quote;
        label: "Quote";
        button-size: 26px;
        icon-size: 15px;
        clicked => { root.apply("quote"); }
    }
    IconButton {
        icon: Icons.code;
        label: "Code";
        button-size: 26px;
        icon-size: 15px;
        clicked => { root.apply("code"); }
    }

    Rectangle {}
}

// Writing a message.
//
// A modal by default, because writing deserves the whole window, with one gesture to
// tuck it into the corner when a message needs checking mid-sentence. The two states
// are the same element at different sizes rather than two windows: the transition is
// then a single animation of x, y, width and height, and the draft cannot be lost in
// the handover because there is no handover.
export component ComposePanel inherits Rectangle {
    in property <[string]> senders;
    in property <int> sender-index;
    in property <string> error;
    in property <[string]> attachments;
    in-out property <bool> minimised;
    in-out property <bool> show-cc;
    in-out property <string> to;
    in-out property <string> cc;
    in-out property <string> bcc;
    in-out property <string> subject;
    in-out property <string> body;

    callback send();
    callback dismissed();
    callback sender-chosen(int);
    callback attach();
    callback attach-image();
    callback remove-attachment(int);
    callback format(string);
    /// Les correspondants proposés pour le champ en cours de saisie.
    in property <[string]> suggestions;
    callback recipient-typed(string, string);
    callback recipient-picked(string, string);

    // The veil fades out as the window shrinks: a minimised draft must not keep the
    // rest of the application behind glass.
    background: root.minimised ? transparent : Tokens.scrim;
    animate background { duration: Tokens.moderate; easing: ease-in-out; }

    if !root.minimised: TouchArea {
        clicked => { root.minimised = true; }
    }

    frame := Floating {
        // The morph. One element, four animated properties — nothing is created or
        // destroyed between the two states, so the text being typed survives.
        x: root.minimised
            ? parent.width - self.width - Tokens.space-3
            : (parent.width - self.width) / 2;
        y: root.minimised
            ? parent.height - self.height - Tokens.space-3
            : (parent.height - self.height) / 2;
        width: root.minimised ? 300px : min(720px, parent.width - 80px);
        height: root.minimised ? 40px : min(600px, parent.height - 80px);

        animate x, y, width, height {
            duration: Tokens.moderate;
            easing: cubic-bezier(0.2, 0, 0, 1);
        }

        TouchArea {}

        VerticalLayout {
            padding: root.minimised ? Tokens.space-2 : Tokens.space-4;
            spacing: root.minimised ? 0px : Tokens.space-2;
            animate padding, spacing { duration: Tokens.moderate; }

            // --- Title row, present in both states ---
            HorizontalLayout {
                spacing: Tokens.space-2;
                height: root.minimised ? 24px : 28px;

                Text {
                    text: root.minimised
                        ? (root.subject == "" ? "New message" : root.subject)
                        : "New message";
                    font-family: Tokens.font-family;
                    font-size: root.minimised ? Tokens.size-body : Tokens.size-title;
                    font-weight: Tokens.weight-bold;
                    color: Tokens.text;
                    vertical-alignment: center;
                    overflow: elide;
                }

                Rectangle {}

                IconButton {
                    icon: root.minimised ? Icons.window-maximise : Icons.minus;
                    label: root.minimised ? "Expand" : "Minimise";
                    button-size: 24px;
                    icon-size: 14px;
                    clicked => { root.minimised = !root.minimised; }
                }
                IconButton {
                    icon: Icons.window-close;
                    label: "Discard";
                    button-size: 24px;
                    icon-size: 14px;
                    clicked => { root.dismissed(); }
                }
            }

            // Everything below is hidden while tucked away. `if` rather than opacity,
            // so a minimised draft costs nothing to keep on screen.
            if !root.minimised: Rectangle { height: 1px; background: Tokens.border; }

            // --- Who it comes from ---
            //
            // A picker rather than a fixed address: with a hundred mailboxes, sending
            // from the wrong one is the mistake that costs, and it is invisible until
            // the reply arrives somewhere unexpected.
            if !root.minimised: HorizontalLayout {
                spacing: Tokens.space-2;
                height: 30px;

                Text {
                    width: 34px;
                    text: "From";
                    font-size: Tokens.size-small;
                    color: Tokens.text-muted;
                    vertical-alignment: center;
                }
                ComboBox {
                    accessible-label: "From";
                    model: root.senders;
                    current-index: root.sender-index;
                    selected(value) => { root.sender-chosen(self.current-index); }
                }
            }

            if !root.minimised: HorizontalLayout {
                spacing: Tokens.space-2;

                Field {
                    label: "To";
                    autofocus: root.to == "";
                    placeholder: "Separate addresses with commas";
                    value <=> root.to;
                    suggestions: root.suggestions;
                    edited(t) => { root.recipient-typed("to", t); }
                    picked(c) => { root.recipient-picked("to", c); }
                }

                // Cc and Bcc stay folded until asked for. Most messages have neither,
                // and two empty fields at the top of every draft is two lines of
                // furniture between the writer and the writing.
                if !root.show-cc: Rectangle {
                    width: 54px;
                    height: 30px;
                    border-radius: Tokens.radius-small;
                    background: cc-touch.has-hover ? Tokens.surface-hover : transparent;

                    accessible-role: button;
                    accessible-label: "Add Cc and Bcc";
                    accessible-action-default => { root.show-cc = true; }

                    Text {
                        text: "Cc Bcc";
                        font-size: Tokens.size-small;
                        color: Tokens.text-muted;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    cc-touch := TouchArea {
                        clicked => { root.show-cc = true; }
                    }
                }
            }

            if !root.minimised && root.show-cc: Field {
                label: "Cc";
                placeholder: "Also send to";
                value <=> root.cc;
                suggestions: root.suggestions;
                edited(t) => { root.recipient-typed("cc", t); }
                picked(c) => { root.recipient-picked("cc", c); }
            }
            if !root.minimised && root.show-cc: Field {
                label: "Bcc";
                placeholder: "Send without showing the address";
                value <=> root.bcc;
                suggestions: root.suggestions;
                edited(t) => { root.recipient-typed("bcc", t); }
                picked(c) => { root.recipient-picked("bcc", c); }
            }

            if !root.minimised: Field {
                label: "Subject";
                placeholder: "Subject";
                value <=> root.subject;
            }

            if !root.minimised: Rectangle { height: 1px; background: Tokens.border; }

            if !root.minimised: FormatBar {
                apply(what) => { root.format(what); }
            }

            if !root.minimised: TextArea {
                // A reply or a mailto: link arrives with its recipient: the writing is
                // what is left to do.
                init => { if (root.to != "") { self.focus(); } }
                accessible-label: "Message";
                placeholder-text: "Write your message…";
                font-size: Tokens.size-body;
                text <=> root.body;
                vertical-stretch: 1;
            }

            // --- What is going with it ---
            if !root.minimised && root.attachments.length > 0: HorizontalLayout {
                spacing: Tokens.space-1;
                height: 24px;

                for name[i] in root.attachments: Rectangle {
                    width: label.preferred-width + 34px;
                    border-radius: Tokens.radius-small;
                    background: Tokens.surface;
                    border-width: 1px;
                    border-color: Tokens.border;

                    accessible-role: button;
                    accessible-label: "Remove " + name;
                    accessible-action-default => { root.remove-attachment(i); }

                    HorizontalLayout {
                        padding-left: Tokens.space-1;
                        padding-right: Tokens.space-1;
                        spacing: 2px;

                        Icon {
                            y: (parent.height - self.height) / 2;
                            data: Icons.paperclip;
                            size: 12px;
                            tint: Tokens.text-muted;
                        }
                        label := Text {
                            text: name;
                            font-size: Tokens.size-small;
                            color: Tokens.text-secondary;
                            vertical-alignment: center;
                        }
                        Icon {
                            y: (parent.height - self.height) / 2;
                            data: Icons.window-close;
                            size: 10px;
                            tint: retirer.has-hover ? Tokens.error : Tokens.text-muted;
                        }
                    }

                    retirer := TouchArea {
                        clicked => { root.remove-attachment(i); }
                    }
                }
                Rectangle {}
            }

            if !root.minimised && root.error != "": Text {
                text: root.error;
                font-size: Tokens.size-small;
                color: Tokens.error;
                wrap: word-wrap;
            }

            // --- The bottom row ---
            if !root.minimised: HorizontalLayout {
                spacing: Tokens.space-2;
                height: 28px;

                IconButton {
                    icon: Icons.paperclip;
                    label: "Attach a file";
                    button-size: 28px;
                    clicked => { root.attach(); }
                }
                IconButton {
                    icon: Icons.image;
                    label: "Insert an image";
                    button-size: 28px;
                    clicked => { root.attach-image(); }
                }

                Rectangle {}

                // Send closes the window. For a few seconds after, a notice at the
                // bottom of the application can still take the message back — and
                // brings this window back with it, as it was.
                Rectangle {
                    width: 120px;
                    border-radius: Tokens.radius-small;
                    background: Tokens.accent;

                    accessible-role: button;
                    accessible-label: "Send";
                    accessible-enabled: root.to != "";
                    accessible-action-default => { root.send(); }

                    HorizontalLayout {
                        alignment: center;
                        spacing: Tokens.space-1;

                        Icon {
                            y: (parent.height - self.height) / 2;
                            data: Icons.send;
                            size: 14px;
                            tint: Tokens.accent-text;
                        }
                        Text {
                            text: "Send";
                            font-size: Tokens.size-small;
                            font-weight: Tokens.weight-bold;
                            color: Tokens.accent-text;
                            vertical-alignment: center;
                        }
                    }

                    TouchArea {
                        clicked => { root.send(); }
                    }
                }
            }
        }
    }
}
