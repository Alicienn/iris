// The structures exchanged between Rust and the interface.
//
// Every field is **precomputed on the Rust side**: the date is already formatted, the
// display name already resolved, the preview already truncated. The interface does no
// work while scrolling — that is invariant 1, expressed in the shape of the data.

export struct ThreadRowData {
    id: int,
    from: string,
    subject: string,
    preview: string,
    // Déjà formatée : « 14:32 », « hier », « 12 mars ».
    date: string,
    unread: bool,
    flagged: bool,
    has-attachment: bool,
    has-tracker: bool,
    snoozed: bool,
    /// Coché pour une action groupée. Distinct de « sélectionné », qui désigne la
    /// ligne dont le volet de lecture montre le contenu : on doit pouvoir lire un
    /// message sans le retirer du lot qu'on prépare.
    marked: bool,
    message-count: int,
    // Couleur d'identité du compte, pour distinguer cent boîtes d'un coup d'œil.
    account-tint: color,
}

export struct AccountRowData {
    id: int,
    label: string,
    count: int,
    // The count as it is shown, and the count in full for the hover. Both are
    // formatted in Rust: a list row must not do arithmetic while it scrolls.
    count-label: string,
    count-full: string,
    pinned: bool,
    // Le compte est suspendu et attend une intervention.
    needs-attention: bool,
    tint: color,
}

export struct MessageBlockData {
    // "paragraph", "heading", "list", "quote", "code", "rule", "image", "table"
    kind: string,
    text: string,
    level: int,
    depth: int,
    bold: bool,
    italic: bool,
    link: string,
    // L'image, quand le message la transportait lui-même. Vide sinon : une image
    // distante n'est pas allée la chercher, et une image bloquée ne le sera pas.
    picture: image,
    has-picture: bool,
}

// Une pièce jointe, telle que le bandeau la montre.
export struct AttachmentData {
    name: string,
    // La taille, déjà mise en forme : « 1,2 Mo ».
    size: string,
    // Le type, réduit à un mot : « PDF », « Image », « Feuille de calcul ».
    kind: string,
    // Le dessin qui va avec le type.
    icon: string,
}

export struct MessageData {
    // Corps rendu par le moteur HTML complet, quand la mise en page l'exige. Les
    // blocs restent renseignes : ils servent de repli et d'ancrage a
    // l'accessibilite, qu'une image ne peut pas porter.
    body-image: image,
    body-is-image: bool,
    from: string,
    from-address: string,
    to: string,
    date: string,
    subject: string,
    blocks: [MessageBlockData],
    blocked-images: int,
    has-tracker: bool,
    attachments: [AttachmentData],
    // L'identifiant du message, pour le déplier ou le replier.
    id: int,
    // Le corps est-il rendu ?
    //
    // Un fil de douze messages ne rasterise pas douze corps pour en montrer un. Les
    // messages repliés n'ont que leur en-tête et leur aperçu, et le corps n'est
    // calculé qu'au dépliage.
    expanded: bool,
    // Une ligne de texte, quand il est replié.
    preview: string,
}

export struct CommandData {
    id: string,
    label: string,
    shortcut: string,
    group: string,
}

// A rule, as the modules screen shows it.
export struct RuleRowData {
    id: string,
    name: string,
    enabled: bool,
    // "when X, then Y" in plain words, so a rule can be checked without opening it.
    summary: string,
    // How many messages it has acted on since it was created.
    applied: int,
}

// An installed plugin.
export struct PluginRowData {
    id: string,
    name: string,
    version: string,
    description: string,
    // What it was allowed to do, in plain words.
    permissions: string,
    // Set when the host took it out of circulation, with the reason.
    disabled-reason: string,
}

// A theme, as the picker shows it.
//
// The colours travel with the name because a theme picker that only lists names makes
// people try each one to find out what it looks like — and every trial repaints the
// whole window.
export struct ThemeSwatchData {
    name: string,
    label: string,
    background: color,
    surface: color,
    accent: color,
    text: color,
}

export struct FolderNodeData {
    // Le chemin complet, qui est l'identité du dossier.
    path: string,
    // Le dernier segment, qui est ce qu'on affiche.
    name: string,
    depth: int,
    // Combien de conversations, déjà mis en forme.
    count-label: string,
    count: int,
    // Sur combien de boîtes il existe. Un dossier qui n'est pas partout se signale.
    accounts: int,
    // Un dossier de rôle : imposé par le serveur, jamais supprimable, toujours là même
    // vide. Ceux-là ne se comparent pas aux autres — « Spam » n'est pas absent des
    // boîtes qui n'en ont pas, il n'a simplement rien reçu.
    permanent: bool,
    // Le rôle du dossier : « inbox », « sent », « trash »… L'interface en déduit
    // l'icône. Le rôle traverse la frontière, pas le dessin : le jeu d'icônes
    // appartient à l'interface, et des chemins SVG dans du code Rust sont des chemins
    // SVG que plus personne ne tient à jour.
    role: string,
}
