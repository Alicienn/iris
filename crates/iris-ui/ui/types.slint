// The structures exchanged between Rust and the interface.
//
// Every field is **precomputed on the Rust side**: the date is already formatted, the
// display name already resolved, the preview already truncated. The interface does no
// work while scrolling — that is invariant 1, expressed in the shape of the data.

export struct ThreadRowData {
    id: int,
    from: string,
    subject: string,
    preview: string,
    // Déjà formatée : « 14:32 », « hier », « 12 mars ».
    date: string,
    unread: bool,
    flagged: bool,
    has-attachment: bool,
    has-tracker: bool,
    snoozed: bool,
    /// Coché pour une action groupée. Distinct de « sélectionné », qui désigne la
    /// ligne dont le volet de lecture montre le contenu : on doit pouvoir lire un
    /// message sans le retirer du lot qu'on prépare.
    marked: bool,
    message-count: int,
    // Couleur d'identité du compte, pour distinguer cent boîtes d'un coup d'œil.
    account-tint: color,
    // The sender's initials and a colour of their own, for the round mark on the
    // left: a list read by faces before names.
    initials: string,
    sender-tint: color,
    // "Today", "Yesterday", "This week", "Earlier" on the first row of each, drawn
    // above it; empty on the others.
    day: string,
    // How many of those titles stand above this row's content, its own included: with
    // the index, where the row is in the list.
    titles: int,
}

// A line of the Home screen: a task or an event, or a small title over the ones that
// follow (`header`), or the line that marks the present hour in today's events (`now`).
export struct HomeItemData {
    id: int,
    key: string,
    title: string,
    // Under the title: "30 min, Studio Nord".
    hint: string,
    // On the right, or for today's events the hour on the left.
    meta: string,
    color: color,
    overdue: bool,
    done: bool,
    past: bool,
    header: bool,
    now: bool,
    priority: int,
}

export struct AccountRowData {
    id: int,
    label: string,
    count: int,
    // The count as it is shown, and the count in full for the hover. Both are
    // formatted in Rust: a list row must not do arithmetic while it scrolls.
    count-label: string,
    count-full: string,
    pinned: bool,
    // Its last sync failed, or it is paused after several: something to look at.
    needs-attention: bool,
    // What went wrong, in a few words, for the red mark's tooltip. Empty when the
    // account is merely paused.
    problem: string,
    tint: color,
    // A group title in the list rather than an account: a tag, when accounts are
    // grouped by tag. `label` is its name and `tint` its colour.
    header: bool,
    // For a group title: the tag (0 for the accounts without one), whether its
    // accounts are folded away, and how many there are.
    tag-id: int,
    folded: bool,
    members: int,
}

// A tag put on one's own mailboxes.
export struct AccountTagData {
    id: int,
    name: string,
    color: color,
    // How many mailboxes carry it.
    count: int,
    // In an account's menu: whether that account carries it.
    checked: bool,
}

export struct MessageBlockData {
    // "paragraph", "heading", "list", "quote", "code", "rule", "image", "table"
    kind: string,
    text: string,
    level: int,
    depth: int,
    bold: bool,
    italic: bool,
    link: string,
    // L'image, quand le message la transportait lui-même. Vide sinon : une image
    // distante n'est pas allée la chercher, et une image bloquée ne le sera pas.
    picture: image,
    has-picture: bool,
}

// Une pièce jointe, telle que le bandeau la montre.
export struct AttachmentData {
    name: string,
    // La taille, déjà mise en forme : « 1,2 Mo ».
    size: string,
    // Le type, réduit à un mot : « PDF », « Image », « Feuille de calcul ».
    kind: string,
    // Le dessin qui va avec le type.
    icon: string,
}

// One slice of a message body painted by the full HTML engine.
//
// Every tile has its place from the start — `aspect` gives its height for any width —
// but its pixels only while it is near the screen. A long newsletter scrolls at its
// full height and costs a screen or two of pixels.
export struct BodyTileData {
    image: image,
    ready: bool,
    // Height divided by width.
    aspect: float,
}

export struct MessageData {
    // Corps rendu par le moteur HTML complet, quand la mise en page l'exige : une
    // colonne de tuiles, peintes seulement près de l'écran.
    body-tiles: [BodyTileData],
    body-is-image: bool,
    from: string,
    from-address: string,
    // The sender's face: initials, on their own colour.
    initials: string,
    tint: color,
    to: string,
    date: string,
    subject: string,
    blocks: [MessageBlockData],
    blocked-images: int,
    has-tracker: bool,
    attachments: [AttachmentData],
    // L'identifiant du message, pour le déplier ou le replier.
    id: int,
    // Le corps est-il rendu ?
    //
    // Un fil de douze messages ne rasterise pas douze corps pour en montrer un. Les
    // messages repliés n'ont que leur en-tête et leur aperçu, et le corps n'est
    // calculé qu'au dépliage.
    expanded: bool,
    // Une ligne de texte, quand il est replié.
    preview: string,
    // Le corps n'est pas encore là.
    //
    // Distinct d'un corps vide : l'un attend le serveur, l'autre n'a rien à montrer,
    // et les deux donnaient le même écran blanc.
    body-loading: bool,
    // The invitation it carries (an .ics), set against the calendar: 0 none, 1 not in
    // it yet, 2 in it as sent, 3 in it but changed since, 4 cancelled and still in it,
    // 5 cancelled and not in it.
    invite-state: int,
    invite-title: string,
    invite-when: string,
    // The event in the calendar (`id:start`), and its day, to open it there.
    invite-key: string,
    invite-day: string,
    // It can be answered (it has an organiser, not oneself), and what was answered:
    // "ACCEPTED", "TENTATIVE", "DECLINED", or empty.
    invite-can-reply: bool,
    invite-reply: string,
}

export struct CommandData {
    id: string,
    label: string,
    shortcut: string,
    group: string,
}

// A rule, as the modules screen shows it.
export struct RuleRowData {
    id: string,
    name: string,
    enabled: bool,
    // "when X, then Y" in plain words, so a rule can be checked without opening it.
    summary: string,
    // How many messages it has acted on since it was created.
    applied: int,
}

// An installed plugin.
export struct PluginRowData {
    id: string,
    name: string,
    version: string,
    description: string,
    // What it was allowed to do, in plain words.
    permissions: string,
    // Set when the host took it out of circulation, with the reason.
    disabled-reason: string,
}

export struct FolderNodeData {
    // Le chemin complet, qui est l'identité du dossier.
    path: string,
    // Le dernier segment, qui est ce qu'on affiche.
    name: string,
    depth: int,
    // Combien de conversations, déjà mis en forme.
    count-label: string,
    count: int,
    // Sur combien de boîtes il existe. Un dossier qui n'est pas partout se signale.
    accounts: int,
    // Un dossier de rôle : imposé par le serveur, jamais supprimable, toujours là même
    // vide. Ceux-là ne se comparent pas aux autres — « Spam » n'est pas absent des
    // boîtes qui n'en ont pas, il n'a simplement rien reçu.
    permanent: bool,
    // Le rôle du dossier : « inbox », « sent », « trash »… L'interface en déduit
    // l'icône. Le rôle traverse la frontière, pas le dessin : le jeu d'icônes
    // appartient à l'interface, et des chemins SVG dans du code Rust sont des chemins
    // SVG que plus personne ne tient à jour.
    role: string,
}

// One line of the changelog, flattened so a single list can draw it.
//
// kind 0: a version — `text` is the number, `detail` the date, `tag` a short mark
//         such as "Installed";
// kind 1: a category — New, Improved, Fixed, Removed;
// kind 2: one change.
export struct ChangelogRowData {
    kind: int,
    text: string,
    detail: string,
    tag: string,
}

// --- The calendar ---

// A calendar in the list on the left.
export struct CalendarData {
    id: int,
    name: string,
    color: color,
    visible: bool,
    // Subscribed by link: read-only, refreshed from its address.
    subscribed: bool,
    // "Updated 5 min ago", or what went wrong. Empty for a local calendar.
    status: string,
    failed: bool,
    // False for the last calendar of one's own: events need somewhere to go.
    deletable: bool,
}

// An event as a line in a month cell or an all-day strip.
export struct CalendarChipData {
    // The occurrence: "event id:start ms".
    key: string,
    title: string,
    // "09:30", empty for an all-day event.
    time: string,
    color: color,
    all-day: bool,
}

// A day of the month grid (and of the small month on the left).
export struct MonthCellData {
    day: string,
    // YYYY-MM-DD, what a click reports.
    date: string,
    in-month: bool,
    today: bool,
    selected: bool,
    // In the week (or the day) the calendar shows: the small month tints it.
    in-week: bool,
    events: [CalendarChipData],
    // Events that did not fit, shown as "+N more".
    more: int,
}

// A column of the week or day view.
export struct WeekDayData {
    // "Mon", "28".
    name: string,
    day: string,
    date: string,
    today: bool,
    all-day: [CalendarChipData],
}

// An event placed in the week or day grid. Positions are fractions, so the grid can
// be any size without Rust knowing it.
export struct TimedEventData {
    key: string,
    title: string,
    time: string,
    color: color,
    // Column, and the share of it: lane of lanes.
    day: int,
    lane: int,
    lanes: int,
    // Top and height as fractions of the day.
    top: float,
    height: float,
    // Over already: drawn fainter.
    past: bool,
    // In a calendar of one's own and not repeating: it can be dragged to another time
    // and stretched by its lower edge.
    movable: bool,
}

// A message waiting to be sent later.
export struct ScheduledMailData {
    id: int,
    to: string,
    subject: string,
    // "Tomorrow, 08:00".
    when: string,
}

// A task waiting for a time, in the calendar's side column, to be dragged onto the week.
export struct PlanTaskData {
    id: int,
    title: string,
    // "30 min, late", "1 h".
    meta: string,
    color: color,
    // How long it takes, or half an hour when not said: the block it books.
    minutes: int,
}

// What the event panel shows.
export struct EventDetailData {
    key: string,
    title: string,
    when: string,
    calendar: string,
    color: color,
    location: string,
    description: string,
    reminder: string,
    repeats: string,
    // In a local calendar: it can be edited and deleted.
    editable: bool,
    // It wears a colour of its own (`color`), not its calendar's.
    own-color: bool,
}

// --- Tasks ---

// A place in the tasks rail: a smart view ("today", "upcoming", "anytime", "mail")
// or a list ("list:<id>").
export struct TaskPlaceData {
    key: string,
    name: string,
    icon: string,
    color: color,
    count: int,
    selected: bool,
    // A list, which can be renamed and deleted; a smart view cannot.
    is-list: bool,
    list-id: int,
}

// A line of the tasks column.
export struct TaskRowData {
    // 0 a task, 1 a section title, 4 the title of the completed tasks (which can be
    // cleared from it).
    kind: int,
    // The task.
    id: int,
    key: string,
    title: string,
    // When: "Today 09:30", "Tomorrow", "10:00 – 11:00"; for a section, its count.
    meta: string,
    overdue: bool,
    done: bool,
    // 0 none … 3 high.
    priority: int,
    // Its list, shown outside that list.
    list: string,
    color: color,
    from-mail: bool,
    has-notes: bool,
    // Steps done out of steps: "1 of 3". Empty without steps.
    progress: string,
    selected: bool,
    // How long it takes: "45 min". Empty when not said.
    estimate: string,
    // The goal it moves forward, and its colour. Empty for none.
    goal: string,
    goal-color: color,
    // How many times it was put off.
    postponed: int,
    // It comes back once done: "Every week". Empty when it does not.
    repeats: string,
}

// What the line to add a task understood, shown before Enter: a date (kind 0), a
// list (1, with its colour), a priority (2, 1 low … 3 high in `level`).
export struct TaskTokenData {
    kind: int,
    text: string,
    color: color,
    level: int,
}

// Around the tasks of a view: how far it has got, and on Today the day itself.
export struct TaskOverviewData {
    // "2 of 5 done", and that as a fraction. Empty when there is nothing to count.
    progress: string,
    fraction: float,
    // Today: the date as a block, and what the calendars hold that day.
    show-day: bool,
    weekday: string,
    day: string,
    month: string,
    // An hour (`meta`), a title, a detail (`hint`), its calendar's colour; `past` and,
    // for the next one, `now`.
    agenda: [HomeItemData],
    // Done this week, Monday to Sunday, and each day as a share of the busiest.
    week-done: int,
    week-bars: [float],
    week-today: int,
}

// A step of a task.
export struct SubtaskData {
    id: int,
    title: string,
    done: bool,
}

// What the detail panel shows of the selected task. The title, the notes and the
// time are fields of their own, bound both ways.
export struct TaskDetailData {
    id: int,
    done: bool,
    has-due: bool,
    due-label: string,
    overdue: bool,
    list-index: int,
    reminder-index: int,
    priority: int,
    // Where it came from: "Marie: Devis refonte". Empty for a task written here.
    source: string,
    // It came from a conversation, which it can open; or from a calendar event.
    from-mail: bool,
    from-event: bool,
    subtasks: [SubtaskData],
    // How many of them are done.
    steps-done: int,
    // The goal it moves forward: 0 for none, else its place in the goals + 1.
    goal-index: int,
    // How long it takes, in minutes; 0 when not said.
    estimate: int,
    // How many times it was put off.
    postponed: int,
    // It has a slot booked in the calendar: "14:00–14:45", else empty.
    slot: string,
    // How it comes back once done: its place in the repeats offered, 0 for none.
    repeat-index: int,
}

// A goal: something to reach by a day, and where it stands.
export struct GoalData {
    id: int,
    title: string,
    // What it is for, in the user's words.
    why: string,
    color: color,
    // Made of milestones rather than counted.
    milestones: bool,
    done: int,
    target: int,
    // "of 10 applications", "of 5 milestones".
    of-label: string,
    // "by Saturday 17 October"; short: "Sat 17 Oct".
    due-label: string,
    due-short: string,
    // 0 on track, 1 behind, 2 reached.
    status: int,
    badge: string,
    // "6 to go in 18 days: about 2 a week."
    pace: string,
    // Done and where a steady pace would be, as fractions of the target.
    fraction: float,
    expected: float,
    // The ring of the side column, as path commands on a 16-unit grid.
    ring: string,
    open-steps: int,
    selected: bool,
}

// A line of a goal's log, or one of its milestones.
export struct GoalLogData {
    id: int,
    // "4", its rank in the log.
    number: string,
    title: string,
    // "Yesterday"; for a milestone "Done Tue 22 Sep" or "Next".
    when: string,
    // A milestone: ticked.
    done: bool,
}
