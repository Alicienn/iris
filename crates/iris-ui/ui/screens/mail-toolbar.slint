import { Tokens } from "@iris/theme/tokens.slint";
import { Layout } from "@iris/theme/layout.slint";
import { Icon, Icons, IconButton } from "@iris/base/icons.slint";
import { TextField } from "@iris/controls/field.slint";
import { QueueTabs, QueueSegments } from "@iris/controls/choice.slint";
import { WindowToolbar } from "@iris/shell/chrome.slint";
import { SyncButton } from "@iris/controls/sync.slint";

// The search field as Apple puts it in a toolbar: a grey capsule, the magnifier in it.
export component SearchCapsule inherits Rectangle {
    in property <bool> active;
    in-out property <string> query;
    in property <string> placeholder: "Search";
    callback submitted(string);
    callback cleared();
    /// On a phone: the field emptied, the search still open.
    callback emptied();

    public function focus-field() {
        champ.focus();
        champ.select-all();
    }

    // On a phone the mockups' field: a finger's height, rounded, the accent round it
    // while typing, the words large.
    property <bool> tel: Layout.compact;
    height: root.tel ? 44px : 28px;
    border-radius: root.tel ? 12px : 7px;
    background: root.tel ? Tokens.surface : Tokens.well;
    border-width: root.tel ? 1.5px : champ.has-focus ? 2px : 0px;
    border-color: root.tel && !champ.has-focus ? Tokens.border-strong
        : root.tel ? Tokens.accent : Tokens.accent.transparentize(0.5);

    HorizontalLayout {
        padding-left: root.tel ? 6px : 0px;
        padding-right: 2px;
        champ := TextField {
            bare: true;
            icon: root.tel ? "" : Icons.search;
            font-size: root.tel ? 16px : 12.5px;
            accessible-label: "Search";
            placeholder-text: root.placeholder;
            shortcut: "/";
            text <=> root.query;
            accepted(t) => { root.submitted(t); }
            // Emptying the field is enough to leave the search. On a phone the results
            // come as the words are typed, as the mockups have them, and the field
            // stays open while the words are rubbed out and others typed.
            edited(t) => {
                if (t == "" && root.tel) {
                    root.emptied();
                } else if (t == "" && root.active) {
                    root.cleared();
                } else if (root.tel) {
                    root.submitted(t);
                }
            }
        }
        // On a phone the cross only rubs the words out (the arrow leaves); on a PC it
        // leaves the search.
        if (root.active && !root.tel) || (root.tel && root.query != ""): Rectangle {
            width: root.tel ? 40px : 24px;
            accessible-role: button;
            accessible-label: root.tel ? "Clear the search" : "Leave search";
            accessible-action-default => {
                root.query = "";
                root.tel ? root.emptied() : root.cleared();
            }
            Icon {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                data: Icons.window-close;
                size: root.tel ? 16px : 11px;
                tint: fermer.has-hover ? Tokens.text : Tokens.text-muted;
            }
            fermer := TouchArea {
                clicked => {
                    root.query = "";
                    if (root.tel) {
                        root.emptied();
                        champ.focus();
                    } else {
                        root.cleared();
                    }
                }
            }
        }
    }
}

// The mail's toolbar, across the list and the reader: where one is and how much is to
// do, the three queues, then writing, what acts on the open conversation, and search.
export component MailToolbar inherits WindowToolbar {
    in property <string> title;
    in property <string> subtitle;
    /// The three queues show (not in a folder, not while searching).
    in property <bool> queues;
    in property <[string]> count-labels;
    in property <[int]> counts;
    in property <int> active-tab;
    /// On a phone: the conversation is open as a page over the list.
    in property <bool> page;
    /// A conversation is open: what acts on it shows.
    in property <bool> has-thread;
    in property <bool> starred;
    in property <bool> focused;
    in property <bool> searching;
    in-out property <string> search-query;

    callback tab-selected(int);
    /// The title opens the accounts and folders (no room for their column).
    in property <bool> title-opens;
    callback title-clicked();
    /// Back to the list, from the page of a conversation.
    callback back();
    callback compose();
    callback mark-done();
    callback waiting();
    callback to-task();
    callback archive();
    callback delete-thread();
    callback toggle-star();
    callback toggle-focus();
    callback snooze-menu(length, length);
    callback more-menu(length, length);
    callback search-submitted(string);
    callback search-cleared();

    public function focus-search() {
        root.cherche = true;
        // Hidden a moment ago on a phone's list: the field takes the cursor once shown.
        root.focus-pending = true;
    }

    /// Back on a phone: the search's page closes before Back goes anywhere else.
    public function leave-search() -> bool {
        if (!root.en-recherche) {
            return false;
        }
        root.cherche = false;
        root.search-query = "";
        root.search-cleared();
        return true;
    }
    property <bool> focus-pending;
    Timer {
        interval: 1ms;
        running: root.focus-pending;
        triggered => {
            root.focus-pending = false;
            recherche.focus-field();
        }
    }

    // On a phone, the magnifier turns the whole bar into the search field.
    property <bool> cherche;
    property <bool> en-recherche: Layout.compact && !root.page && (root.cherche || root.searching);
    /// The list on a phone: the bar keeps its icons, the rest is below it.
    property <bool> liste-telephone: Layout.compact && !root.page;
    /// A phone's list has no bar at all (the mockups): its magnifier is beside the
    /// large title, and the bar comes back only to search.
    out property <bool> hidden: root.liste-telephone && !root.en-recherche;
    height: root.hidden ? 0px : 52px;
    visible: !root.hidden;
    /// A conversation's actions on a phone: the size of a thumb.
    property <length> bouton: Layout.compact ? 44px : 28px;
    property <length> icone: Layout.compact ? 20px : 17px;

    // On a phone, the search's own page: back leaves it, as the mockups' S2.
    if root.en-recherche: IconButton {
        y: (parent.height - self.height) / 2;
        icon: Icons.arrow-left;
        label: "Leave search";
        button-size: 44px;
        icon-size: 22px;
        clicked => {
            root.cherche = false;
            root.search-query = "";
            root.search-cleared();
        }
    }
    // On a phone, the page of a conversation goes back to the list.
    if root.page: IconButton {
        y: (parent.height - self.height) / 2;
        icon: Icons.arrow-left;
        label: "Back";
        button-size: 44px;
        icon-size: 22px;
        clicked => { root.back(); }
    }

    // On a phone's list the title is the large header under the bar (PhoneMailHeader).
    if !root.en-recherche && !root.liste-telephone: HorizontalLayout {
        spacing: 8px;
        min-width: 0px;
        horizontal-stretch: 1;
        titre := Text {
            visible: !root.page;
            text: root.title;
            font-family: Tokens.font-display;
            font-size: 15px;
            font-weight: 600;
            color: Tokens.text;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 0;
            // Its whole name, up to a point: squeezed by the buttons, it read "All …".
            min-width: min(self.preferred-width, Layout.compact ? 90px : 160px);
            max-width: 220px;
            // Where the accounts column has no room, the title opens it.
            if root.title-opens: TouchArea {
                clicked => { root.title-clicked(); }
            }
        }
        if root.title-opens && !root.page: Icon {
            y: (parent.height - self.height) / 2;
            data: Icons.chevron-down;
            size: 14px;
            tint: Tokens.text-muted;
        }
        Text {
            visible: !Layout.compact;
            text: root.subtitle;
            font-size: 12px;
            color: Tokens.text-muted;
            vertical-alignment: center;
            horizontal-stretch: 0;
        }
        Rectangle { horizontal-stretch: 1; }
    }

    // The three queues, in the middle, as Apple's segmented control.
    if root.queues && !root.page && !root.en-recherche && !Layout.compact: QueueTabs {
        y: (parent.height - self.height) / 2;
        names: ["To do", "Waiting", "Done"];
        counts: root.count-labels;
        descriptions: [
            (root.counts.length > 0 ? root.counts[0] : 0) + " conversations",
            (root.counts.length > 1 ? root.counts[1] : 0) + " conversations",
            (root.counts.length > 2 ? root.counts[2] : 0) + " conversations",
        ];
        selected: root.active-tab;
        chosen(i) => { root.tab-selected(i); }
    }
    if !root.en-recherche: Rectangle { horizontal-stretch: 1; }

    // The actions side by side, no gap between them, as a Mac toolbar groups them.
    if !root.en-recherche: HorizontalLayout {
    spacing: 0px;
    horizontal-stretch: 0;
    if !root.page && !root.liste-telephone: IconButton {
        y: (parent.height - self.height) / 2;
        icon: Icons.pencil;
        label: "Write a new message";
        shortcut: "C";
        button-size: 28px;
        icon-size: 17px;
        clicked => { root.compose(); }
    }
    if root.has-thread: IconButton {
        y: (parent.height - self.height) / 2;
        icon: Icons.check;
        label: "Mark as done";
        shortcut: "E";
        button-size: root.bouton;
        icon-size: root.icone;
        clicked => { root.mark-done(); }
    }
    // Snooze asks until when; "S" goes straight to tomorrow morning.
    if root.has-thread: IconButton {
        y: (parent.height - self.height) / 2;
        icon: Icons.clock;
        label: "Snooze…";
        shortcut: "S";
        button-size: root.bouton;
        icon-size: root.icone;
        clicked => {
            root.snooze-menu(self.absolute-position.x, self.absolute-position.y + self.height + 6px);
        }
    }
    if root.has-thread: IconButton {
        y: (parent.height - self.height) / 2;
        icon: Icons.hourglass;
        label: "Move to Waiting";
        shortcut: "W";
        button-size: root.bouton;
        icon-size: root.icone;
        clicked => { root.waiting(); }
    }
    // On a phone in the ⋯ sheet: the bar keeps the mockup's four.
    if root.has-thread && !Layout.compact: IconButton {
        y: (parent.height - self.height) / 2;
        icon: Icons.task;
        label: "Make it a task";
        shortcut: "T";
        button-size: root.bouton;
        icon-size: root.icone;
        clicked => { root.to-task(); }
    }
    if root.has-thread: IconButton {
        y: (parent.height - self.height) / 2;
        icon: Icons.archive;
        label: "Archive";
        shortcut: "A";
        button-size: root.bouton;
        icon-size: root.icone;
        clicked => { root.archive(); }
    }
    if root.has-thread && !Layout.compact: IconButton {
        y: (parent.height - self.height) / 2;
        icon: Icons.trash;
        label: "Delete";
        shortcut: "Del";
        button-size: root.bouton;
        icon-size: root.icone;
        danger: true;
        clicked => { root.delete-thread(); }
    }
    if root.has-thread && !Layout.compact: IconButton {
        y: (parent.height - self.height) / 2;
        icon: Icons.star;
        label: root.starred ? "Remove star" : "Star";
        shortcut: "F";
        button-size: root.bouton;
        icon-size: root.icone;
        filled: root.starred;
        bounce: true;
        tinted: true;
        tint: root.starred ? Tokens.orange : Tokens.text-muted;
        clicked => { root.toggle-star(); }
    }
    // The conversation alone on screen: the accounts and the list step aside.
    if root.has-thread && !Layout.compact: IconButton {
        y: (parent.height - self.height) / 2;
        icon: root.focused ? Icons.collapse : Icons.expand;
        label: root.focused ? "Leave full screen" : "Read full screen";
        button-size: root.bouton;
        icon-size: 16px;
        active: root.focused;
        clicked => { root.toggle-focus(); }
    }
    // The rest, less often: forward, read or unread, the source.
    if root.has-thread: IconButton {
        y: (parent.height - self.height) / 2;
        icon: Icons.more;
        label: "More actions";
        button-size: root.bouton;
        icon-size: root.icone;
        clicked => {
            root.more-menu(self.absolute-position.x + self.width, self.absolute-position.y + self.height + 6px);
        }
    }
    }
    Rectangle { width: 4px; }
    // On a phone, the field spans the bar once the magnifier is pressed.
    recherche := SearchCapsule {
        y: (parent.height - self.height) / 2;
        visible: !Layout.compact || root.en-recherche;
        min-width: root.en-recherche ? 120px : Layout.compact ? 0px : 210px;
        max-width: root.en-recherche ? 100000px : Layout.compact ? 0px : 210px;
        horizontal-stretch: root.en-recherche ? 1 : 0;
        active: root.searching || root.en-recherche;
        query <=> root.search-query;
        submitted(q) => { root.search-submitted(q); }
        cleared => {
            root.cherche = false;
            root.search-cleared();
        }
        // On a phone the words rubbed out: no results, and the field stays to type
        // others. The arrow or Back leaves it.
        emptied => { root.search-cleared(); }
    }
}

// The head of the mail on a phone, as the Android mockup draws it (M1): where one is,
// large, which opens the mailboxes; how much is to do and when the mail last came; the
// queues across the width under it.
export component PhoneMailHeader inherits VerticalLayout {
    in property <string> title;
    /// "18 to do · synced 2 min ago".
    in property <string> subtitle;
    in property <bool> queues;
    in property <[string]> count-labels;
    in property <[int]> counts;
    in property <int> active-tab;
    callback title-clicked();
    callback tab-selected(int);
    /// The magnifier beside the title: the bar turns into the search field.
    callback search();
    /// Sync all, beside the magnifier, with how far it has got.
    in property <bool> syncing;
    in property <int> sync-done;
    in property <int> sync-total;
    callback sync();

    padding-left: 18px;
    padding-top: 6px;
    padding-right: 18px;
    padding-bottom: 10px;
    spacing: 2px;
    // Its own height and no more: stretched with the list, it took half the screen
    // and pushed the conversations under the tabs (6.5.0).
    vertical-stretch: 0;
    max-height: self.preferred-height;

    HorizontalLayout {
    spacing: 4px;
    Rectangle {
        height: titre.preferred-height;
        horizontal-stretch: 1;
        min-width: 0px;
        accessible-role: button;
        accessible-label: "Mailboxes: " + root.title;
        accessible-action-default => { root.title-clicked(); }
    titre := HorizontalLayout {
        x: 0px;
        width: min(self.preferred-width, parent.width);
        spacing: 6px;
        Text {
            text: root.title;
            font-family: Tokens.font-display;
            font-size: 32px;
            font-weight: 600;
            color: Tokens.text;
            overflow: elide;
            vertical-alignment: center;
        }
        Icon {
            y: (parent.height - self.height) / 2;
            data: Icons.chevron-down;
            size: 18px;
            tint: Tokens.text;
        }
    }
        // From the left, over the title and its chevron: with a width and no x it
        // was centred, over the chevron only, and a touch on "Inbox" did nothing.
        TouchArea {
            x: 0px;
            width: titre.width;
            clicked => { root.title-clicked(); }
        }
    }
    SyncButton {
        y: (parent.height - self.height) / 2;
        syncing: root.syncing;
        done: root.sync-done;
        total: root.sync-total;
        clicked => { root.sync(); }
    }
    IconButton {
        y: (parent.height - self.height) / 2;
        icon: Icons.search;
        label: "Search";
        button-size: 44px;
        icon-size: 21px;
        clicked => { root.search(); }
    }
    }
    if root.subtitle != "": Text {
        text: root.subtitle;
        font-size: 14px;
        color: Tokens.text-muted;
    }
    if root.queues: Rectangle { height: 10px; }
    if root.queues: QueueSegments {
        names: ["To do", "Waiting", "Done"];
        counts: root.count-labels;
        descriptions: [
            (root.counts.length > 0 ? root.counts[0] : 0) + " conversations",
            (root.counts.length > 1 ? root.counts[1] : 0) + " conversations",
            (root.counts.length > 2 ? root.counts[2] : 0) + " conversations",
        ];
        selected: root.active-tab;
        chosen(i) => { root.tab-selected(i); }
    }
}
