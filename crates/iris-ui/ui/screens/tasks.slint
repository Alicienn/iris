import { Layout, WidthClass } from "@iris/theme/layout.slint";
import { Tokens } from "@iris/theme/tokens.slint";
import { Motion } from "@iris/theme/motion.slint";
import { Icon, Icons, IconButton } from "@iris/base/icons.slint";
import { Dot, Hairline, VHairline } from "@iris/base/atoms.slint";
import { TextField, TextArea } from "@iris/controls/field.slint";
import { Button, ButtonKind, ButtonSize, Link, BlockButton } from "@iris/controls/button.slint";
import {
    Check, Segmented, Pill, PillKind, PriorityTag, Priority, QueueSegments
} from "@iris/controls/choice.slint";
import { Nav, NavItem, SectionRow, SectionTitle } from "@iris/lists/nav.slint";
import { PropertyRow } from "@iris/lists/rows.slint";
import { SwipeRow } from "@iris/lists/swipe.slint";
import { Rail, PageHeader, Plate, DetailPanel, Modal, ModalKind, ModalFooter } from "@iris/layout/frames.slint";
import { MenuEntry, MenuHeader, MenuSeparator, MenuSurface } from "@iris/layout/menu.slint";
import { DateButton, DatePicker } from "@iris/screens/calendar-panels.slint";
import { GoalRow, GoalPage, GoalsOverview, GoalNudges, GoalRing } from "@iris/screens/goals.slint";
import {
    BarButton, PhoneBar, BigTitle, GroupTitle, GroupCard, GroupRow, RowTile, RowLabel, RowValue,
    RowChevron, AccentLink, Token, SheetOption, SheetTitle, DoneBar
} from "@iris/screens/tasks-phone.slint";
import {
    TaskPlaceData, TaskRowData, TaskDetailData, SubtaskData, MonthCellData, TaskTokenData,
    TaskOverviewData, GoalData, GoalLogData
} from "@iris/types.slint";
import { ComboBox } from "@iris/controls/pickers.slint";
import { ScrollView } from "@iris/controls/scroll.slint";
import { SidebarFrame, WindowToolbar, Chrome } from "@iris/shell/chrome.slint";

// The tasks workspace: where things are to do (the rail), what there is to do (a plate
// of rows, under the day when it is Today), the line to add more, and the task chosen.

// A view or a list in the rail. While a task is carried, the ones that can take it
// light up under the pointer.
component PlaceRow inherits Rectangle {
    in property <TaskPlaceData> place;
    /// A task is being carried, and where the pointer is.
    in property <bool> carrying;
    in property <length> carry-x;
    in property <length> carry-y;
    /// Raised when the carried task is let go; the row under the point takes it.
    in property <int> drop;
    in property <length> drop-x;
    in property <length> drop-y;

    callback chosen(string);
    callback menu(TaskPlaceData, length, length);
    callback dropped(string);

    // A list takes a task; Today gives it today's date.
    property <bool> droppable: root.place.is-list || root.place.key == "today";
    pure function inside(x: length, y: length) -> bool {
        return x >= self.absolute-position.x && x < self.absolute-position.x + self.width
            && y >= self.absolute-position.y && y < self.absolute-position.y + self.height;
    }
    property <bool> targeted: root.carrying && root.droppable && root.inside(root.carry-x, root.carry-y);

    changed drop => {
        if (root.droppable && root.inside(root.drop-x, root.drop-y)) {
            root.dropped(root.place.key);
        }
    }

    height: Nav.row-height;
    border-radius: Tokens.radius-small;
    border-width: root.targeted ? 1.5px : 0px;
    border-color: Tokens.accent;
    background: root.targeted ? Tokens.accent.transparentize(0.8)
        : Nav.background(root.place.selected, touch.has-hover);
    animate background { duration: Tokens.instant; }

    accessible-role: button;
    accessible-label: root.place.name;
    accessible-action-default => { root.chosen(root.place.key); }

    touch := TouchArea {
        clicked => { root.chosen(root.place.key); }
        pointer-event(event) => {
            if (root.place.is-list && event.button == PointerEventButton.right
                && event.kind == PointerEventKind.up) {
                root.menu(root.place,
                    self.absolute-position.x + self.mouse-x,
                    self.absolute-position.y + self.mouse-y);
            }
        }
    }

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 8px;

        // A list: its round icon in its colour, as Reminders' lists have.
        if root.place.is-list: Rectangle {
            y: (parent.height - self.height) / 2;
            width: 22px;
            height: 22px;
            border-radius: 11px;
            background: root.place.color;
            border-width: root.place.selected ? 1.5px : 0px;
            border-color: Tokens.accent-text;
            Icon {
                data: Icons.list;
                size: 12px;
                tint: Tokens.accent-text;
            }
        }
        if !root.place.is-list: Icon {
            y: (parent.height - self.height) / 2;
            data: root.place.icon;
            size: 16px;
            tint: Nav.icon-ink(root.place.selected, Tokens.accent);
        }
        Text {
            text: root.place.name;
            font-size: Nav.label-size;
            color: Nav.ink(root.place.selected, false);
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }
        if root.place.count > 0: Text {
            text: root.place.count;
            font-size: 12px;
            color: Nav.count-ink(root.place.selected);
            vertical-alignment: center;
        }
    }
}

// A smart view as Reminders shows it: a tile, its round icon in its colour, how many
// there are in large, its name under. Today takes a task let go on it.
component PlaceTile inherits Rectangle {
    in property <TaskPlaceData> place;
    in property <color> tint;
    in property <bool> carrying;
    in property <length> carry-x;
    in property <length> carry-y;
    in property <int> drop;
    in property <length> drop-x;
    in property <length> drop-y;
    callback chosen(string);
    callback dropped(string);

    property <bool> droppable: root.place.key == "today";
    pure function inside(x: length, y: length) -> bool {
        return x >= root.absolute-position.x && x < root.absolute-position.x + root.width
            && y >= root.absolute-position.y && y < root.absolute-position.y + root.height;
    }
    property <bool> targeted: root.carrying && root.droppable && root.inside(root.carry-x, root.carry-y);
    changed drop => {
        if (root.droppable && root.inside(root.drop-x, root.drop-y)) {
            root.dropped(root.place.key);
        }
    }
    // On a phone the overview is a page of its own, left for the view: no tile stays lit.
    property <bool> on: root.place.selected && !Layout.compact;

    // Equal halves of the row whatever their words: the stretch shares only what is
    // left above each one's preferred width.
    horizontal-stretch: 1;
    preferred-width: 0px;
    min-width: 0px;
    // On a phone the mockups' cards (T1): 12 by 14 inside, rounder, a square of colour
    // for the icon, the count at its right and the name under them.
    height: Layout.compact ? 82px : 64px;
    border-radius: Layout.compact ? 18px : 10px;
    border-width: root.targeted ? 2px : 0px;
    border-color: Tokens.accent;
    background: root.on ? Tokens.accent
        : Layout.compact ? (touch.pressed ? Tokens.surface.mix(Tokens.text, 0.94) : Tokens.surface)
        : touch.has-hover ? Tokens.surface-high.mix(Tokens.text, 0.96) : Tokens.surface-high;
    drop-shadow-blur: Tokens.shadow-card-blur;
    drop-shadow-offset-y: Tokens.shadow-card-y;
    drop-shadow-color: Tokens.shadow-card;
    animate background { duration: Tokens.instant; }

    accessible-role: button;
    accessible-label: root.place.name;
    accessible-item-selected: root.on;
    accessible-action-default => { root.chosen(root.place.key); }

    touch := TouchArea {
        clicked => { root.chosen(root.place.key); }
    }
    VerticalLayout {
        padding-left: Layout.compact ? 14px : 10px;
        padding-right: Layout.compact ? 14px : 10px;
        padding-top: Layout.compact ? 12px : 8px;
        padding-bottom: Layout.compact ? 12px : 8px;
        spacing: Layout.compact ? 8px : 4px;
        HorizontalLayout {
            Rectangle {
                width: Layout.compact ? 30px : 26px;
                height: self.width;
                border-radius: Layout.compact ? 8px : 13px;
                background: root.on ? Tokens.accent-text : root.tint;
                Icon {
                    data: root.place.icon;
                    size: Layout.compact ? 18px : 14px;
                    weight: Layout.compact ? 2 : 1.6;
                    tint: root.on ? Tokens.accent : Tokens.accent-text;
                }
            }
            Rectangle { horizontal-stretch: 1; }
            Text {
                text: root.place.count;
                font-family: Tokens.font-display;
                font-size: Layout.compact ? 24px : 20px;
                font-weight: Layout.compact ? 600 : 700;
                color: root.on ? Tokens.accent-text : Tokens.text;
                vertical-alignment: Layout.compact ? center : top;
            }
        }
        if Layout.compact: Rectangle { vertical-stretch: 1; }
        Text {
            text: root.place.name;
            font-size: Layout.compact ? 15px : 12.5px;
            font-weight: 600;
            color: root.on ? Tokens.accent-text : Layout.compact ? Tokens.text-secondary : Tokens.text-muted;
            overflow: elide;
        }
    }
}

// A line of the plate: a task, or the title of a section.
component TaskRow inherits Rectangle {
    in property <TaskRowData> item;
    callback selected(TaskRowData);
    callback toggled(int);
    callback clear-completed();
    /// Carrying: picked up past a few pixels of movement, moved, let go.
    callback carry-started(TaskRowData, length, length);
    callback carry-moved(length, length);
    callback carry-ended();
    /// Later: the task, and where the menu goes (under the button).
    callback later(TaskRowData, length, length);
    /// Another task carried over this one, and where the pointer is (window
    /// coordinates); then let go, and where.
    in property <int> carried-id: -1;
    in property <length> carry-x;
    in property <length> carry-y;
    in property <int> drop;
    in property <int> dropped-id: -1;
    in property <length> drop-x;
    in property <length> drop-y;
    /// A task let go on this one: (that task, this one, above it rather than below).
    callback reordered(int, int, bool);

    property <bool> tache: root.item.kind == 0;
    pure function dessus-de(px: length, py: length) -> bool {
        return px >= root.absolute-position.x && px < root.absolute-position.x + root.width
            && py >= root.absolute-position.y && py < root.absolute-position.y + root.height;
    }
    /// A task is carried over this one: a line of the accent where it would go.
    property <bool> vise: root.tache && root.carried-id >= 0 && root.carried-id != root.item.id
        && root.dessus-de(root.carry-x, root.carry-y);
    property <bool> vise-haut: root.carry-y < root.absolute-position.y + root.height / 2;
    changed drop => {
        if (root.tache && root.dropped-id >= 0 && root.dropped-id != root.item.id
            && root.dessus-de(root.drop-x, root.drop-y)) {
            root.reordered(root.dropped-id, root.item.id,
                root.drop-y < root.absolute-position.y + root.height / 2);
        }
    }

    // Where the carried task would go: a line of the accent above or below.
    Rectangle {
        visible: root.vise;
        x: 4px;
        width: parent.width - 8px;
        y: root.vise-haut ? -4px : parent.height + 2px;
        height: 2px;
        border-radius: 1px;
        background: Tokens.accent;
    }
    property <bool> has-line: root.item.list != "" || root.item.from-mail
        || root.item.progress != "" || root.item.has-notes || root.item.goal != ""
        || root.item.estimate != "" || root.item.postponed >= 2 || root.item.repeats != "";
    property <bool> pressed;
    property <bool> carrying;
    // A drag ends with a release, and a release makes a click: that one is not.
    property <bool> just-carried;
    property <length> press-x;
    property <length> press-y;

    // Each task a small card of its own, rounded, on the window's ground; the
    // sections' titles stay plain text between them.
    // Just added: it slides in from the left and fades up, ringed in the accent for
    // a moment. Once: the next drawing has it in place.
    property <float> arrivee: root.item.fresh ? 0 : 1;
    animate arrivee { duration: Motion.travel; easing: Motion.soft; }
    property <float> halo: root.item.fresh ? 1 : 0;
    animate halo { duration: Motion.draw; easing: ease-in; }
    init => {
        if (root.item.fresh) {
            root.arrivee = 1;
            eteindre.running = true;
        }
    }
    eteindre := Timer {
        interval: 350ms;
        running: false;
        triggered => {
            self.running = false;
            root.halo = 0;
        }
    }

    // A row as Reminders draws it: no card, a circle, the words, a hairline under them;
    // the chosen one on a soft plate of the accent.
    height: root.tache ? (root.has-line ? 54px : 42px) : 40px;
    border-radius: root.tache ? Tokens.radius-medium : 0px;
    border-width: root.halo > 0.02 ? 1.5px : 0px;
    border-color: Tokens.accent.transparentize(1 - 0.8 * root.halo);
    background: !root.tache ? transparent
        : root.item.selected ? Tokens.accent-soft
        : root.halo > 0.02 ? Tokens.accent.transparentize(1 - 0.12 * root.halo)
        : touch.has-hover ? Tokens.surface-hover : transparent;

    // The hairline, from where the words start to the end.
    Rectangle {
        visible: root.tache && !root.item.selected;
        x: 48px;
        y: parent.height - 1px;
        width: parent.width - 48px;
        height: 1px;
        background: Tokens.border;
    }
    // Picked up, the row fades where it was: it is in the hand.
    opacity: (root.carrying ? 0.35 : 1.0) * (0.2 + 0.8 * root.arrivee);
    animate background, border-color { duration: Tokens.quick; }

    accessible-role: list-item;
    accessible-label: root.item.title;
    accessible-item-selectable: root.tache;
    accessible-item-selected: root.item.selected;
    accessible-action-default => { root.selected(root.item); }

    touch := TouchArea {
        enabled: root.tache;
        mouse-cursor: root.carrying ? MouseCursor.grabbing : MouseCursor.default;
        pointer-event(event) => {
            if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                root.pressed = true;
                root.carrying = false;
                root.just-carried = false;
                root.press-x = self.mouse-x;
                root.press-y = self.mouse-y;
            }
            if (event.button == PointerEventButton.left && event.kind == PointerEventKind.up) {
                if (root.carrying) {
                    root.carrying = false;
                    root.just-carried = true;
                    root.carry-ended();
                }
                root.pressed = false;
            }
        }
        moved => {
            // Under a finger a drag scrolls the list: carrying is the mouse's.
            if (root.pressed && !root.carrying && !Layout.touch-input
                && (abs(self.mouse-x - root.press-x) > 6px || abs(self.mouse-y - root.press-y) > 6px)) {
                root.carrying = true;
                root.carry-started(root.item,
                    self.absolute-position.x + self.mouse-x,
                    self.absolute-position.y + self.mouse-y);
            }
            if (root.carrying) {
                root.carry-moved(self.absolute-position.x + self.mouse-x,
                    self.absolute-position.y + self.mouse-y);
            }
        }
        clicked => {
            if (!root.just-carried) {
                root.selected(root.item);
            }
            root.just-carried = false;
        }
    }

    // A section's title, with its count; the completed ones can be cleared from it.
    if !root.tache: HorizontalLayout {
        padding-left: 12px;
        padding-right: 2px;
        padding-top: 14px;
        spacing: 7px;
        Text {
            text: root.item.title;
            font-size: 13px;
            font-weight: 600;
            color: root.item.overdue ? Tokens.red : Tokens.text-muted;
            vertical-alignment: center;
        }
        Text {
            text: root.item.meta;
            font-size: 12px;
            color: Tokens.text-muted;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
        if root.item.kind == 4: Link {
            cross-axis-self-alignment: center;
            text: "Clear";
            label: "Delete completed tasks";
            clicked => { root.clear-completed(); }
        }
    }

    if root.tache: HorizontalLayout {
        x: (1 - root.arrivee) * -16px;
        padding-left: 12px;
        padding-right: 10px;
        spacing: 12px;

        tick := Check {
            y: (parent.height - self.height) / 2;
            animated: true;
            done: root.item.done;
            late: root.item.overdue;
            label: root.item.title;
            toggled => { root.toggled(root.item.id); }
        }

        VerticalLayout {
            alignment: center;
            spacing: 3px;
            horizontal-stretch: 1;
            min-width: 0;

            // The title, struck through once done.
            Rectangle {
                height: titre.preferred-height;
                titre := Text {
                    width: parent.width;
                    text: root.item.title;
                    font-size: Tokens.size-body;
                    color: tick.shown-done ? Tokens.text-muted : Tokens.text;
                    animate color { duration: Motion.state; }
                    overflow: elide;
                }
                // Struck through from the left as the tick is drawn.
                Rectangle {
                    x: 0;
                    y: parent.height / 2;
                    width: tick.shown-done ? min(titre.preferred-width, parent.width) : 0px;
                    animate width { duration: Motion.state; easing: Motion.soft; }
                    height: 1px;
                    background: Tokens.text-muted;
                }
            }

            // Where it belongs and what it carries.
            if root.has-line && !root.item.done: HorizontalLayout {
                height: 15px;
                spacing: 10px;
                alignment: start;
                if root.item.list != "": HorizontalLayout {
                    spacing: 5px;
                    Dot {
                        y: (parent.height - self.height) / 2;
                        tint: root.item.color;
                        size: 7px;
                    }
                    Text {
                        text: root.item.list;
                        font-size: 12px;
                        color: Tokens.text-muted;
                        vertical-alignment: center;
                    }
                }
                // The goal it moves forward, in the goal's colour.
                if root.item.goal != "": HorizontalLayout {
                    spacing: 4px;
                    Rectangle {
                        y: (parent.height - self.height) / 2;
                        width: 9px;
                        height: 9px;
                        border-radius: 4.5px;
                        border-width: 2px;
                        border-color: root.item.goal-color;
                    }
                    Text {
                        text: root.item.goal;
                        font-size: 12px;
                        color: root.item.goal-color;
                        vertical-alignment: center;
                        overflow: elide;
                        max-width: 180px;
                    }
                }
                if root.item.estimate != "": HorizontalLayout {
                    spacing: 4px;
                    Icon {
                        y: (parent.height - self.height) / 2;
                        width: 12px;
                        data: Icons.hourglass;
                        size: 12px;
                        tint: Tokens.text-muted;
                    }
                    Text {
                        text: root.item.estimate;
                        font-size: 12px;
                        color: Tokens.text-muted;
                        vertical-alignment: center;
                    }
                }
                if root.item.repeats != "": HorizontalLayout {
                    spacing: 4px;
                    Icon {
                        y: (parent.height - self.height) / 2;
                        width: 12px;
                        data: Icons.repeat;
                        size: 12px;
                        tint: Tokens.text-muted;
                    }
                    Text {
                        text: root.item.repeats;
                        font-size: 12px;
                        color: Tokens.text-muted;
                        vertical-alignment: center;
                    }
                }
                // Put off again and again: said, quietly, in amber.
                if root.item.postponed >= 2: HorizontalLayout {
                    spacing: 3px;
                    Icon {
                        y: (parent.height - self.height) / 2;
                        width: 12px;
                        data: Icons.refresh;
                        size: 12px;
                        tint: Tokens.warning;
                    }
                    Text {
                        text: root.item.postponed + "×";
                        font-size: 12px;
                        color: Tokens.warning;
                        vertical-alignment: center;
                    }
                }
                if root.item.progress != "": HorizontalLayout {
                    spacing: 4px;
                    Icon {
                        y: (parent.height - self.height) / 2;
                        width: 12px;
                        data: Icons.task;
                        size: 12px;
                        tint: Tokens.text-muted;
                    }
                    Text {
                        text: root.item.progress;
                        font-size: 12px;
                        color: Tokens.text-muted;
                        vertical-alignment: center;
                    }
                }
                if root.item.from-mail: Icon {
                    y: (parent.height - self.height) / 2;
                    width: 12px;
                    data: Icons.envelope-closed;
                    size: 12px;
                    tint: Tokens.text-muted;
                }
                if root.item.has-notes: Icon {
                    y: (parent.height - self.height) / 2;
                    width: 12px;
                    data: Icons.notes;
                    size: 12px;
                    tint: Tokens.text-muted;
                }
            }
        }

        if root.item.priority > 0 && !root.item.done: PriorityTag {
            y: (parent.height - self.height) / 2;
            priority: root.item.priority;
        }
        if root.item.meta != "": Text {
            text: root.item.meta;
            font-size: 12px;
            color: root.item.overdue ? Tokens.error
                : root.item.done ? Tokens.text-muted : Tokens.text-secondary;
            vertical-alignment: center;
            horizontal-alignment: right;
        }
        // Later, on the chosen row: the one gesture a list of things to do needs most
        // after "done". (Only there: a button that came and went with the hover would
        // lose the hover to itself.)
        if !root.item.done && root.item.selected: IconButton {
            y: (parent.height - self.height) / 2;
            icon: Icons.arrow-right;
            label: "Later";
            shortcut: "L";
            button-size: 26px;
            icon-size: 14px;
            clicked => {
                root.later(root.item, self.absolute-position.x,
                    self.absolute-position.y + self.height + 4px);
            }
        }
    }
}

// A detail of a task's second line on a phone: an icon and a few words.
component PhoneMeta inherits HorizontalLayout {
    in property <string> icon;
    in property <string> text;
    in property <color> ink: Tokens.text-muted;
    spacing: 5px;
    Icon {
        y: (parent.height - self.height) / 2;
        width: 14px;
        data: root.icon;
        size: 14px;
        tint: root.ink;
    }
    if root.text != "": Text {
        text: root.text;
        font-size: 13px;
        color: root.ink;
        vertical-alignment: center;
        overflow: elide;
    }
}

// A line of the list on a phone, as the mockups' `.trow` and `.gh` (T2, T7): the whole
// width, a 26-pixel circle, the title at 16, what it carries under it, its time and
// priority at the right; a group's title above, with its count. A finger pushing a
// task right ticks it, left puts it off (Later).
component PhoneTaskRow inherits Rectangle {
    in property <TaskRowData> item;
    callback selected(TaskRowData);
    callback toggled(int);
    callback clear-completed();
    callback later(TaskRowData, length, length);

    property <bool> tache: root.item.kind == 0;
    property <bool> has-line: !root.item.done && (root.item.list != "" || root.item.from-mail
        || root.item.progress != "" || root.item.goal != "" || root.item.estimate != ""
        || root.item.postponed >= 2 || root.item.repeats != "");
    property <bool> tagged: root.item.priority > 0 && !root.item.done;
    // 13 above and below the words; the priority's tag stacks over the time.
    height: !root.tache ? 45px
        : root.has-line || (root.tagged && root.item.meta != "") ? 68px : 48px;

    // Just added: a soft plate of the accent for a moment (T4).
    property <float> halo: root.item.fresh ? 1 : 0;
    animate halo { duration: Motion.draw; easing: ease-in; }
    init => {
        if (root.item.fresh) {
            eteindre.running = true;
        }
    }
    eteindre := Timer {
        interval: 1200ms;
        running: false;
        triggered => {
            self.running = false;
            root.halo = 0;
        }
    }

    // A group's title: "Overdue 1", "Today 4", "Done 1  Clear".
    if !root.tache: HorizontalLayout {
        padding-left: 18px;
        padding-right: 18px;
        padding-top: 18px;
        padding-bottom: 8px;
        spacing: 8px;
        Text {
            text: root.item.title;
            font-size: 14px;
            font-weight: 600;
            color: root.item.overdue ? Tokens.red : Tokens.text-secondary;
            vertical-alignment: center;
        }
        Text {
            text: root.item.meta;
            font-size: 14px;
            color: Tokens.text-muted;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
        if root.item.kind == 4: AccentLink {
            text: "Clear";
            label: "Delete completed tasks";
            clicked => { root.clear-completed(); }
        }
    }

    if root.tache: SwipeRow {
        width: 100%;
        height: 100%;
        start-label: root.item.done ? "Not done" : "Done";
        start-icon: Icons.check;
        start-color: Tokens.success;
        end-label: "Later";
        end-icon: Icons.arrow-right;
        end-color: Tokens.warning;
        swiped-start => { root.toggled(root.item.id); }
        swiped-end => {
            if (!root.item.done) {
                root.later(root.item, root.absolute-position.x, root.absolute-position.y);
            }
        }

        Rectangle {
            background: touch.pressed ? Tokens.surface.mix(Tokens.text, 0.94)
                : Tokens.surface.mix(Tokens.accent, 1 - 0.08 * root.halo);
            accessible-role: list-item;
            accessible-label: root.item.title;
            accessible-action-default => { root.selected(root.item); }
            touch := TouchArea {
                clicked => { root.selected(root.item); }
            }
            Rectangle {
                y: parent.height - 1px;
                height: 1px;
                background: Tokens.border;
            }
            HorizontalLayout {
                padding-left: 18px;
                padding-right: 18px;
                padding-top: 13px;
                padding-bottom: 13px;
                spacing: 14px;

                VerticalLayout {
                    alignment: start;
                    padding-top: 1px;
                    tick := Check {
                        animated: true;
                        size: 26px;
                        done: root.item.done;
                        late: root.item.overdue;
                        label: root.item.title;
                        toggled => { root.toggled(root.item.id); }
                    }
                }

                VerticalLayout {
                    alignment: start;
                    spacing: 3px;
                    horizontal-stretch: 1;
                    min-width: 0;
                    Rectangle {
                        height: 22px;
                        titre := Text {
                            width: parent.width;
                            text: root.item.title;
                            font-size: 16px;
                            color: tick.shown-done ? Tokens.text-muted : Tokens.text;
                            animate color { duration: Motion.state; }
                            vertical-alignment: center;
                            overflow: elide;
                        }
                        Rectangle {
                            x: 0;
                            y: parent.height / 2;
                            width: tick.shown-done ? min(titre.preferred-width, parent.width) : 0px;
                            animate width { duration: Motion.state; easing: Motion.soft; }
                            height: 1px;
                            background: Tokens.text-muted;
                        }
                    }
                    if root.has-line: HorizontalLayout {
                        height: 17px;
                        spacing: 12px;
                        alignment: start;
                        if root.item.list != "": HorizontalLayout {
                            spacing: 5px;
                            Rectangle {
                                y: (parent.height - self.height) / 2;
                                width: 8px;
                                height: 8px;
                                border-radius: 4px;
                                background: root.item.color;
                            }
                            Text {
                                text: root.item.list;
                                font-size: 13px;
                                color: Tokens.text-muted;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                        }
                        if root.item.goal != "": PhoneMeta {
                            icon: Icons.flag;
                            text: root.item.goal;
                            ink: root.item.goal-color;
                        }
                        if root.item.progress != "": PhoneMeta {
                            icon: Icons.check-circle;
                            text: root.item.progress;
                        }
                        if root.item.estimate != "": PhoneMeta {
                            icon: Icons.hourglass;
                            text: root.item.estimate;
                        }
                        if root.item.repeats != "": PhoneMeta {
                            icon: Icons.repeat;
                            text: root.item.repeats;
                        }
                        if root.item.postponed >= 2: PhoneMeta {
                            icon: Icons.refresh;
                            text: root.item.postponed + "×";
                            ink: Tokens.orange;
                        }
                        if root.item.from-mail: PhoneMeta {
                            icon: Icons.envelope-closed;
                        }
                    }
                }

                // Its priority over its time, both at the right.
                if root.tagged || root.item.meta != "": VerticalLayout {
                    alignment: start;
                    spacing: 4px;
                    padding-top: 2px;
                    if root.tagged: HorizontalLayout {
                        alignment: end;
                        PriorityTag { priority: root.item.priority; }
                    }
                    if root.item.meta != "": Text {
                        text: root.item.meta;
                        font-size: 14px;
                        color: root.item.overdue ? Tokens.red
                            : root.item.done ? Tokens.text-muted : Tokens.text-secondary;
                        horizontal-alignment: right;
                    }
                }
            }
        }
    }
}

// A step of the chosen task.
component SubtaskRow inherits Rectangle {
    in property <SubtaskData> step;
    callback toggled(int);
    callback removed(int);

    height: 32px;
    border-radius: Tokens.radius-small;
    background: touch.has-hover ? Tokens.surface-hover : transparent;

    touch := TouchArea {}

    HorizontalLayout {
        padding-left: 2px;
        spacing: 10px;
        Check {
            y: (parent.height - self.height) / 2;
            animated: true;
            size: 16px;
            done: root.step.done;
            label: root.step.title;
            toggled => { root.toggled(root.step.id); }
        }
        Rectangle {
            horizontal-stretch: 1;
            nom := Text {
                width: parent.width;
                height: parent.height;
                text: root.step.title;
                font-size: 13px;
                color: root.step.done ? Tokens.text-muted : Tokens.text;
                vertical-alignment: center;
                overflow: elide;
            }
            Rectangle {
                visible: root.step.done;
                x: 0;
                y: parent.height / 2;
                width: min(nom.preferred-width, parent.width);
                height: 1px;
                background: Tokens.text-muted;
            }
        }
        if touch.has-hover || Layout.touch-input: IconButton {
            y: (parent.height - self.height) / 2;
            icon: Icons.window-close;
            label: "Remove subtask " + root.step.title;
            button-size: 22px;
            icon-size: 10px;
            clicked => { root.removed(root.step.id); }
        }
    }
}

// The chosen task, to change.
component TaskDetail inherits DetailPanel {
    in property <TaskDetailData> detail;
    in-out property <string> title;
    in-out property <string> notes;
    in-out property <string> time;
    in property <[string]> lists;
    in property <[string]> reminders;
    /// "Does not repeat", "Every day"…
    in property <[string]> repeats;
    in property <bool> picker-open;
    in property <string> picker-title;
    in property <[MonthCellData]> picker-cells;

    callback toggled(int);
    /// Later, and where its menu goes.
    callback later(length, length);
    /// A free slot of its day, and where the list of them goes.
    callback slot-requested(length, length);
    /// The booked slot taken off the calendar.
    callback unbook();
    /// How long it takes, in minutes (0: not said), or as typed ("1h20").
    callback estimate-chosen(int);
    callback estimate-typed(string);
    callback title-edited(string);
    callback notes-edited(string);
    callback time-edited(string);
    callback picker-toggled();
    callback picker-navigate(int);
    callback picker-chosen(string);
    callback due-cleared();
    callback reminder-chosen(int);
    callback repeat-chosen(int);
    callback priority-chosen(int);
    callback list-chosen(int);
    callback step-added(string);
    callback step-toggled(int);
    callback step-removed(int);
    callback open-mail();
    callback copy-link();
    callback delete();
    callback closed();

    property <string> new-step;
    property <string> other-estimate;
    /// The options one sets now and then (slot, reminder, repeat, list) shown.
    property <bool> more;

    public function focus-step() {
        etape.focus();
    }
    /// Raised by Later's "Split into steps": the cursor goes to "Add a subtask".
    in property <int> step-focus-request;
    changed step-focus-request => { etape.focus(); }

    // Its list above it, Later, and the way out.
    HorizontalLayout {
        height: 28px;
        vertical-stretch: 0;
        spacing: 4px;
        Icon {
            y: (parent.height - self.height) / 2;
            width: 14px;
            data: Icons.list;
            size: 12px;
            tint: Tokens.text-muted;
        }
        Text {
            text: root.lists.length > root.detail.list-index ? root.lists[root.detail.list-index] : "";
            font-size: 12px;
            color: Tokens.text-muted;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }
        if !root.detail.done: Button {
            y: (parent.height - self.height) / 2;
            text: "Later";
            label: "Move it later";
            icon: Icons.arrow-right;
            kind: ButtonKind.ghost;
            size: ButtonSize.sm;
            clicked => {
                root.later(self.absolute-position.x, self.absolute-position.y + self.height + 4px);
            }
        }
        IconButton {
            y: (parent.height - self.height) / 2;
            icon: Icons.window-close;
            label: "Close";
            shortcut: "Esc";
            button-size: 28px;
            icon-size: 13px;
            clicked => { root.closed(); }
        }
    }

    HorizontalLayout {
        spacing: 10px;
        vertical-stretch: 0;
        Check {
            y: (parent.height - self.height) / 2;
            animated: true;
            size: 22px;
            done: root.detail.done;
            late: root.detail.overdue;
            label: "Done";
            toggled => { root.toggled(root.detail.id); }
        }
        TextField {
            accessible-label: "Task title";
            font-size: 18px;
            text <=> root.title;
            edited(t) => { root.title-edited(t); }
        }
    }

    // Put off three times and more: a question rather than a fourth time.
    if root.detail.postponed >= 3 && !root.detail.done: Rectangle {
        vertical-stretch: 0;
        height: coince.preferred-height;
        border-radius: Tokens.radius-large;
        background: Tokens.warning.transparentize(0.91);
        coince := VerticalLayout {
            padding: 12px;
            spacing: 8px;
            Text {
                text: "Moved " + root.detail.postponed + " times. Make it smaller, give it a slot, or let it go.";
                font-size: 12.5px;
                color: Tokens.text-secondary;
                wrap: word-wrap;
            }
            HorizontalLayout {
                spacing: 6px;
                alignment: start;
                Button {
                    text: "Split into steps";
                    size: ButtonSize.sm;
                    clicked => { root.focus-step(); }
                }
                Button {
                    text: "Give it a slot";
                    size: ButtonSize.sm;
                    clicked => {
                        root.slot-requested(self.absolute-position.x,
                            self.absolute-position.y + self.height + 4px);
                    }
                }
                Button {
                    text: "Let it go";
                    label: "Let it go (delete)";
                    kind: ButtonKind.ghost;
                    size: ButtonSize.sm;
                    clicked => { root.delete(); }
                }
            }
        }
    }

    VerticalLayout {
        vertical-stretch: 0;
        Hairline {}
        PropertyRow {
            name: "Due";
            icon: Icons.calendar;
            HorizontalLayout {
                spacing: 6px;
                DateButton {
                    y: (parent.height - self.height) / 2;
                    accessible-label: "Due date";
                    text: root.detail.has-due ? root.detail.due-label : "No date";
                    open: root.picker-open;
                    clicked => { root.picker-toggled(); }
                }
                if root.detail.has-due: TextField {
                    y: (parent.height - self.height) / 2;
                    width: 64px;
                    height: 28px;
                    accessible-label: "Due time";
                    placeholder-text: "Time";
                    text <=> root.time;
                    edited(t) => { root.time-edited(t); }
                }
                if root.detail.has-due: IconButton {
                    y: (parent.height - self.height) / 2;
                    icon: Icons.window-close;
                    label: "Remove the date";
                    button-size: 24px;
                    icon-size: 10px;
                    clicked => { root.due-cleared(); }
                }
            }
        }
        if root.picker-open: DatePicker {
            title: root.picker-title;
            cells: root.picker-cells;
            navigate(n) => { root.picker-navigate(n); }
            chosen(d) => { root.picker-chosen(d); }
        }
        // How long it takes: the usual lengths, or any other written out.
        PropertyRow {
            name: "Takes";
            icon: Icons.hourglass;
            HorizontalLayout {
                spacing: 2px;
                for m[i] in [15, 30, 60, 120]: Rectangle {
                    property <bool> on: root.detail.estimate == m;
                    y: (parent.height - self.height) / 2;
                    width: mot.preferred-width + 16px;
                    height: 24px;
                    border-radius: Tokens.radius-small;
                    background: self.on ? Tokens.surface-active : duree.has-hover ? Tokens.surface-hover : transparent;

                    accessible-role: checkbox;
                    accessible-label: ["15 min", "30 min", "1 h", "2 h"][i];
                    accessible-checked: self.on;
                    accessible-action-default => { root.estimate-chosen(self.on ? 0 : m); }

                    mot := Text {
                        text: ["15 min", "30 min", "1 h", "2 h"][i];
                        font-size: 12.5px;
                        font-weight: parent.on ? 600 : 400;
                        color: parent.on ? Tokens.text : Tokens.text-muted;
                    }
                    duree := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.estimate-chosen(parent.on ? 0 : m); }
                    }
                }
                TextField {
                    y: (parent.height - self.height) / 2;
                    min-width: 56px;
                    preferred-width: 84px;
                    horizontal-stretch: 1;
                    height: 26px;
                    font-size: 12.5px;
                    accessible-label: "Other length";
                    placeholder-text: root.detail.estimate > 0
                        && root.detail.estimate != 15 && root.detail.estimate != 30
                        && root.detail.estimate != 60 && root.detail.estimate != 120
                        ? (root.detail.estimate < 60 ? root.detail.estimate + " min"
                            : floor(root.detail.estimate / 60) + " h " + mod(root.detail.estimate, 60))
                        : "Other: 45m";
                    text <=> root.other-estimate;
                    accepted(t) => {
                        root.estimate-typed(t);
                        root.other-estimate = "";
                    }
                }
            }
        }
        PropertyRow {
            name: "Priority";
            icon: Icons.exclamation;
            Segmented {
                y: (parent.height - self.height) / 2;
                options: ["None", "Low", "Medium", "High"];
                tints: [Tokens.text, Priority.tint(1), Priority.tint(2), Priority.tint(3)];
                selected: root.detail.priority;
                chosen(i) => { root.priority-chosen(i); }
            }
        }
        // A slot for it in the calendar, found among the day's events.
        if root.more || root.detail.slot != "": PropertyRow {
            name: "Slot";
            icon: Icons.clock;
            HorizontalLayout {
                spacing: 6px;
                if root.detail.slot != "": Text {
                    text: root.detail.slot;
                    font-size: 13px;
                    color: Tokens.text;
                    vertical-alignment: center;
                }
                Button {
                    y: (parent.height - self.height) / 2;
                    text: root.detail.slot != "" ? "Change" : "Find a slot";
                    label: root.detail.slot != "" ? "Change the slot" : "Find a slot";
                    kind: ButtonKind.ghost;
                    size: ButtonSize.sm;
                    clicked => {
                        root.slot-requested(self.absolute-position.x,
                            self.absolute-position.y + self.height + 4px);
                    }
                }
                if root.detail.slot != "": Button {
                    y: (parent.height - self.height) / 2;
                    text: "Remove";
                    label: "Remove the slot";
                    kind: ButtonKind.ghost;
                    size: ButtonSize.sm;
                    clicked => { root.unbook(); }
                }
                Rectangle {}
            }
        }
        if root.more || root.detail.reminder-index > 0: PropertyRow {
            name: "Reminder";
            icon: Icons.bell;
            ComboBox {
                y: (parent.height - self.height) / 2;
                height: 30px;
                enabled: root.detail.has-due;
                // Named, or a screen reader says "combo box" and nothing of what for.
                accessible-label: "Reminder";
                model: root.reminders;
                current-index: root.detail.reminder-index;
                selected => { root.reminder-chosen(self.current-index); }
            }
        }
        // Done, it comes back on the next day of its rule: a due day is needed to
        // step from.
        if root.more || root.detail.repeat-index > 0: PropertyRow {
            name: "Repeats";
            icon: Icons.repeat;
            ComboBox {
                y: (parent.height - self.height) / 2;
                height: 30px;
                enabled: root.detail.has-due;
                accessible-label: "Repeats";
                accessible-description: root.detail.has-due ? "" : "Give the task a due day first";
                model: root.repeats;
                current-index: root.detail.repeat-index;
                selected => { root.repeat-chosen(self.current-index); }
            }
        }
        if root.more: PropertyRow {
            name: "List";
            icon: Icons.list;
            ComboBox {
                y: (parent.height - self.height) / 2;
                height: 30px;
                accessible-label: "List";
                model: root.lists;
                current-index: root.detail.list-index;
                selected => { root.list-chosen(self.current-index); }
            }
        }
        // The rest, on demand: what is set shows anyway.
        HorizontalLayout {
            height: 32px;
            alignment: start;
            Link {
                y: (parent.height - self.height) / 2;
                text: root.more ? "Fewer options" : "More options";
                label: root.more ? "Show fewer options" : "Show more options: slot, reminder, repeat, list";
                chevron: true;
                clicked => { root.more = !root.more; }
            }
        }
    }

    // Where it came from: a conversation, or an event.
    if root.detail.source != "": Rectangle {
        height: 56px;
        vertical-stretch: 0;
        border-radius: Tokens.radius-medium;
        border-width: 1px;
        border-color: Tokens.border;
        background: Tokens.surface-low;
        HorizontalLayout {
            padding-left: 12px;
            padding-right: 8px;
            spacing: 12px;
            Rectangle {
                y: (parent.height - self.height) / 2;
                width: 32px;
                height: 32px;
                border-radius: 16px;
                background: Tokens.text.transparentize(0.93);
                Icon {
                    data: root.detail.from-event ? Icons.calendar : Icons.envelope-closed;
                    size: 14px;
                    tint: Tokens.text-secondary;
                }
            }
            VerticalLayout {
                alignment: center;
                spacing: 1px;
                horizontal-stretch: 1;
                Text {
                    text: root.detail.from-event ? "From an event" : "From a message";
                    font-size: 12px;
                    color: Tokens.text-muted;
                }
                Text {
                    text: root.detail.source;
                    font-size: 13px;
                    font-weight: 600;
                    color: Tokens.text;
                    overflow: elide;
                }
            }
            if root.detail.from-mail: Link {
                y: (parent.height - self.height) / 2;
                text: "Open";
                label: "Open message";
                chevron: true;
                clicked => { root.open-mail(); }
            }
        }
    }

    VerticalLayout {
        vertical-stretch: 0;
        spacing: 0px;
        HorizontalLayout {
            height: 26px;
            spacing: 8px;
            Text {
                text: "Subtasks";
                font-size: 12px;
                font-weight: 600;
                color: Tokens.text-secondary;
                vertical-alignment: center;
            }
            Text {
                text: root.detail.subtasks.length > 0
                    ? root.detail.steps-done + " of " + root.detail.subtasks.length : "";
                font-size: 12px;
                color: Tokens.text-muted;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
            Rectangle {
                visible: root.detail.subtasks.length > 0;
                y: (parent.height - self.height) / 2;
                width: 64px;
                height: 4px;
                border-radius: 2px;
                background: Tokens.text.transparentize(0.92);
                Rectangle {
                    x: 0;
                    width: parent.width * root.detail.steps-done / root.detail.subtasks.length;
                    border-radius: 2px;
                    background: Tokens.success;
                }
            }
        }
        for step in root.detail.subtasks: SubtaskRow {
            step: step;
            toggled(id) => { root.step-toggled(id); }
            removed(id) => { root.step-removed(id); }
        }
        HorizontalLayout {
            padding-top: 4px;
            etape := TextField {
                icon: Icons.plus;
                accessible-label: "Add a subtask";
                placeholder-text: "Add a subtask";
                text <=> root.new-step;
                accepted(t) => {
                    if (t != "") {
                        root.step-added(t);
                        root.new-step = "";
                    }
                }
            }
        }
    }

    TextArea {
        accessible-label: "Notes";
        vertical-stretch: 1;
        min-height: 60px;
        placeholder-text: "Notes";
        text <=> root.notes;
        edited(t) => { root.notes-edited(t); }
    }

    HorizontalLayout {
        height: 28px;
        vertical-stretch: 0;
        Button {
            text: "Copy link";
            label: "Copy a link to this task, for a note";
            icon: Icons.link;
            kind: ButtonKind.ghost;
            size: ButtonSize.sm;
            clicked => { root.copy-link(); }
        }
        Rectangle { horizontal-stretch: 1; }
        Button {
            text: "Delete";
            label: "Delete task";
            icon: Icons.trash;
            kind: ButtonKind.ghost;
            size: ButtonSize.sm;
            clicked => { root.delete(); }
        }
    }
}

// The chosen task on a phone: the floating panel becomes a page (the mockups' T5). Its
// list and Later in the bar; the title; when, how long, a slot and how urgent on one
// card; the rest behind "More options"; where it came from; its steps; its notes. Copy
// link and Delete are in the bar's ⋯.
component TaskPage inherits Rectangle {
    in property <TaskDetailData> detail;
    in-out property <string> title;
    in-out property <string> notes;
    in-out property <string> time;
    in property <[string]> lists;
    in property <[string]> reminders;
    in property <[string]> repeats;
    in property <bool> picker-open;
    in property <string> picker-title;
    in property <[MonthCellData]> picker-cells;
    in property <int> step-focus-request;

    callback toggled(int);
    callback later(length, length);
    callback slot-requested(length, length);
    callback unbook();
    callback estimate-chosen(int);
    callback estimate-typed(string);
    callback title-edited(string);
    callback notes-edited(string);
    callback time-edited(string);
    callback picker-toggled();
    callback picker-navigate(int);
    callback picker-chosen(string);
    callback due-cleared();
    callback reminder-chosen(int);
    callback repeat-chosen(int);
    callback priority-chosen(int);
    callback list-chosen(int);
    callback step-added(string);
    callback step-toggled(int);
    callback step-removed(int);
    callback open-mail();
    callback delete();
    callback closed();
    /// The bar's ⋯: Copy link, Delete.
    callback menu();

    property <string> new-step;
    property <string> other-estimate;
    property <bool> more;
    /// The lengths offered, shown under Takes once it is touched.
    property <bool> takes-open;
    property <string> takes-label: root.detail.estimate <= 0 ? "Not said"
        : root.detail.estimate < 60 ? root.detail.estimate + " min"
        : mod(root.detail.estimate, 60) == 0 ? floor(root.detail.estimate / 60) + " h"
        : floor(root.detail.estimate / 60) + " h " + mod(root.detail.estimate, 60);

    changed step-focus-request => { etape.focus(); }

    background: Tokens.background;

    VerticalLayout {
        // Back, its list, Later, ⋯.
        PhoneBar {
            BarButton {
                y: (parent.height - self.height) / 2;
                icon: Icons.arrow-left;
                label: "Close";
                clicked => { root.closed(); }
            }
            Text {
                text: root.lists.length > root.detail.list-index ? root.lists[root.detail.list-index] : "";
                font-size: 15px;
                color: Tokens.text-muted;
                vertical-alignment: center;
                horizontal-stretch: 1;
                overflow: elide;
            }
            if !root.detail.done: Rectangle {
                y: (parent.height - self.height) / 2;
                width: plus-tard.preferred-width + 20px;
                height: 44px;
                border-radius: 22px;
                background: tard.pressed ? Tokens.accent-soft : transparent;
                accessible-role: button;
                accessible-label: "Move it later";
                accessible-action-default => {
                    root.later(self.absolute-position.x, self.absolute-position.y + self.height);
                }
                plus-tard := HorizontalLayout {
                    x: 10px;
                    width: self.preferred-width;
                    spacing: 8px;
                    Icon {
                        y: (parent.height - self.height) / 2;
                        data: Icons.arrow-right;
                        size: 18px;
                        tint: Tokens.accent;
                    }
                    Text {
                        text: "Later";
                        font-size: 14px;
                        font-weight: 600;
                        color: Tokens.accent;
                        vertical-alignment: center;
                    }
                }
                tard := TouchArea {
                    clicked => {
                        root.later(parent.absolute-position.x, parent.absolute-position.y + parent.height);
                    }
                }
            }
            BarButton {
                y: (parent.height - self.height) / 2;
                icon: Icons.more;
                label: "More";
                clicked => { root.menu(); }
            }
        }

        page := ScrollView {
            vertical-stretch: 1;
            content-width: self.visible-width;
            VerticalLayout {
                width: page.visible-width;
                alignment: start;
                padding-bottom: 24px;

                // The circle, and the title to type over.
                HorizontalLayout {
                    padding-left: 18px;
                    padding-right: 18px;
                    padding-top: 4px;
                    padding-bottom: 14px;
                    spacing: 14px;
                    Check {
                        cross-axis-self-alignment: center;
                        animated: true;
                        size: 26px;
                        done: root.detail.done;
                        late: root.detail.overdue;
                        label: "Done";
                        toggled => { root.toggled(root.detail.id); }
                    }
                    TextField {
                        height: 40px;
                        bare: true;
                        accessible-label: "Task title";
                        font-size: 22px;
                        text <=> root.title;
                        edited(t) => { root.title-edited(t); }
                    }
                }

                // Put off three times and more: a question rather than a fourth time.
                if root.detail.postponed >= 3 && !root.detail.done: HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 16px;
                    padding-bottom: 12px;
                    Rectangle {
                        height: coince.preferred-height;
                        border-radius: 14px;
                        background: Tokens.orange.transparentize(0.89);
                        coince := VerticalLayout {
                            padding-left: 14px;
                            padding-right: 14px;
                            padding-top: 12px;
                            padding-bottom: 12px;
                            spacing: 10px;
                            Text {
                                text: "Put off " + root.detail.postponed + " times.";
                                font-size: 14px;
                                font-weight: 700;
                                color: Tokens.orange;
                            }
                            Text {
                                text: "Split it, give it a slot, or let it go?";
                                font-size: 14px;
                                color: Tokens.text-secondary;
                                wrap: word-wrap;
                            }
                            HorizontalLayout {
                                spacing: 8px;
                                alignment: start;
                                Button {
                                    text: "Split into steps";
                                    size: ButtonSize.sm;
                                    clicked => { etape.focus(); }
                                }
                                Button {
                                    text: "Find a slot";
                                    size: ButtonSize.sm;
                                    clicked => {
                                        root.slot-requested(self.absolute-position.x,
                                            self.absolute-position.y + self.height + 4px);
                                    }
                                }
                                Button {
                                    text: "Let go";
                                    label: "Let it go (delete)";
                                    kind: ButtonKind.ghost;
                                    size: ButtonSize.sm;
                                    clicked => { root.delete(); }
                                }
                            }
                        }
                    }
                }

                // Due, Takes, Slot, Priority: what a task needs first.
                HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 16px;
                    GroupCard {
                        GroupRow {
                            first: true;
                            flat: true;
                            enabled: false;
                            label: "Due";
                            Icon {
                                y: (parent.height - self.height) / 2;
                                data: Icons.calendar;
                                size: 18px;
                                tint: Tokens.text-muted;
                            }
                            RowLabel { text: "Due"; }
                            Token {
                                y: (parent.height - self.height) / 2;
                                text: root.detail.has-due ? root.detail.due-label : "Add a date";
                                accessible-label: "Due date";
                                clicked => { root.picker-toggled(); }
                            }
                            if root.detail.has-due: TextField {
                                y: (parent.height - self.height) / 2;
                                width: 64px;
                                height: 30px;
                                accessible-label: "Due time";
                                placeholder-text: "Time";
                                text <=> root.time;
                                edited(t) => { root.time-edited(t); }
                            }
                            if root.detail.has-due: IconButton {
                                y: (parent.height - self.height) / 2;
                                icon: Icons.window-close;
                                label: "Remove the date";
                                button-size: 30px;
                                icon-size: 12px;
                                clicked => { root.due-cleared(); }
                            }
                        }
                        if root.picker-open: HorizontalLayout {
                            padding-left: 16px;
                            padding-right: 16px;
                            padding-bottom: 8px;
                            DatePicker {
                                title: root.picker-title;
                                cells: root.picker-cells;
                                navigate(n) => { root.picker-navigate(n); }
                                chosen(d) => { root.picker-chosen(d); }
                            }
                        }
                        GroupRow {
                            flat: true;
                            label: "Takes " + root.takes-label;
                            clicked => { root.takes-open = !root.takes-open; }
                            Icon {
                                y: (parent.height - self.height) / 2;
                                data: Icons.hourglass;
                                size: 18px;
                                tint: Tokens.text-muted;
                            }
                            RowLabel { text: "Takes"; }
                            RowValue { text: root.takes-label; }
                        }
                        // The usual lengths, or any other written out.
                        if root.takes-open: HorizontalLayout {
                            padding-left: 16px;
                            padding-right: 16px;
                            padding-bottom: 12px;
                            spacing: 6px;
                            for m[i] in [15, 30, 60, 120]: Pill {
                                y: (parent.height - self.height) / 2;
                                text: ["15 min", "30 min", "1 h", "2 h"][i];
                                on: root.detail.estimate == m;
                                toggled => { root.estimate-chosen(root.detail.estimate == m ? 0 : m); }
                            }
                            TextField {
                                y: (parent.height - self.height) / 2;
                                height: 34px;
                                min-width: 56px;
                                horizontal-stretch: 1;
                                accessible-label: "Other length";
                                placeholder-text: "45m";
                                text <=> root.other-estimate;
                                accepted(t) => {
                                    root.estimate-typed(t);
                                    root.other-estimate = "";
                                }
                            }
                        }
                        // A slot for it in the calendar, found among the day's events.
                        GroupRow {
                            flat: true;
                            label: root.detail.slot != "" ? "Change the slot" : "Find a slot";
                            clicked => {
                                root.slot-requested(self.absolute-position.x,
                                    self.absolute-position.y + self.height);
                            }
                            Icon {
                                y: (parent.height - self.height) / 2;
                                data: Icons.clock;
                                size: 18px;
                                tint: Tokens.text-muted;
                            }
                            RowLabel { text: "Slot"; }
                            if root.detail.slot != "": RowValue {
                                text: root.detail.slot;
                                color: Tokens.text;
                            }
                            if root.detail.slot != "": AccentLink {
                                text: "Remove";
                                label: "Remove the slot";
                                font-size: 15px;
                                clicked => { root.unbook(); }
                            }
                            if root.detail.slot == "": Text {
                                text: "Find a slot";
                                font-size: 15px;
                                font-weight: 600;
                                color: Tokens.accent;
                                vertical-alignment: center;
                            }
                        }
                        GroupRow {
                            flat: true;
                            enabled: false;
                            label: "Priority";
                            Text {
                                width: 18px;
                                text: "!";
                                font-size: 15px;
                                font-weight: 700;
                                color: Tokens.text-muted;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                            RowLabel { text: "Priority"; }
                        }
                        HorizontalLayout {
                            padding-left: 16px;
                            padding-right: 16px;
                            padding-bottom: 12px;
                            QueueSegments {
                                names: ["None", "Low", "Medium", "High"];
                                selected: root.detail.priority;
                                chosen(i) => { root.priority-chosen(i); }
                            }
                        }
                    }
                }

                // The rest, on demand: what is set shows anyway.
                HorizontalLayout {
                    padding-left: 32px;
                    padding-top: 8px;
                    alignment: start;
                    AccentLink {
                        height: 32px;
                        text: root.more ? "Fewer options" : "More options";
                        label: root.more ? "Show fewer options" : "Show more options: reminder, repeat, list";
                        font-size: 14.5px;
                        clicked => { root.more = !root.more; }
                    }
                }
                if root.more || root.detail.reminder-index > 0 || root.detail.repeat-index > 0: HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 16px;
                    padding-top: 8px;
                    GroupCard {
                        GroupRow {
                            first: true;
                            flat: true;
                            enabled: false;
                            label: "Reminder";
                            RowLabel { text: "Reminder"; }
                            ComboBox {
                                y: (parent.height - self.height) / 2;
                                width: 170px;
                                enabled: root.detail.has-due;
                                accessible-label: "Reminder";
                                model: root.reminders;
                                current-index: root.detail.reminder-index;
                                selected => { root.reminder-chosen(self.current-index); }
                            }
                        }
                        GroupRow {
                            flat: true;
                            enabled: false;
                            label: "Repeats";
                            RowLabel { text: "Repeats"; }
                            ComboBox {
                                y: (parent.height - self.height) / 2;
                                width: 170px;
                                enabled: root.detail.has-due;
                                accessible-label: "Repeats";
                                accessible-description: root.detail.has-due ? "" : "Give the task a due day first";
                                model: root.repeats;
                                current-index: root.detail.repeat-index;
                                selected => { root.repeat-chosen(self.current-index); }
                            }
                        }
                        if root.more: GroupRow {
                            flat: true;
                            enabled: false;
                            label: "List";
                            RowLabel { text: "List"; }
                            ComboBox {
                                y: (parent.height - self.height) / 2;
                                width: 170px;
                                accessible-label: "List";
                                model: root.lists;
                                current-index: root.detail.list-index;
                                selected => { root.list-chosen(self.current-index); }
                            }
                        }
                    }
                }

                // Where it came from: a conversation, which opens from here, or an event.
                if root.detail.source != "": HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 16px;
                    padding-top: 12px;
                    GroupCard {
                        GroupRow {
                            first: true;
                            flat: true;
                            enabled: root.detail.from-mail;
                            label: "Open message";
                            clicked => { root.open-mail(); }
                            RowTile {
                                y: (parent.height - self.height) / 2;
                                quiet: true;
                                icon: root.detail.from-event ? Icons.calendar : Icons.envelope-closed;
                            }
                            VerticalLayout {
                                alignment: center;
                                horizontal-stretch: 1;
                                Text {
                                    text: root.detail.from-event ? "From an event" : "From a message";
                                    font-size: 13px;
                                    color: Tokens.text-muted;
                                    overflow: elide;
                                }
                                Text {
                                    text: root.detail.source;
                                    font-size: 15.5px;
                                    color: Tokens.text;
                                    overflow: elide;
                                }
                            }
                            if root.detail.from-mail: Text {
                                text: "Open";
                                font-size: 14px;
                                color: Tokens.text-muted;
                                vertical-alignment: center;
                            }
                        }
                    }
                }

                // Its steps, and how far they have got.
                GroupTitle {
                    text: "Subtasks";
                    count: root.detail.subtasks.length > 0
                        ? root.detail.steps-done + " of " + root.detail.subtasks.length : "";
                    if root.detail.subtasks.length > 0: DoneBar {
                        y: (parent.height - self.height) / 2;
                        width: 70px;
                        height: 4px;
                        fraction: root.detail.steps-done / root.detail.subtasks.length;
                    }
                }
                HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 16px;
                    GroupCard {
                        for step[i] in root.detail.subtasks: GroupRow {
                            first: i == 0;
                            flat: true;
                            enabled: false;
                            label: step.title;
                            Check {
                                y: (parent.height - self.height) / 2;
                                animated: true;
                                size: 22px;
                                done: step.done;
                                label: step.title;
                                toggled => { root.step-toggled(step.id); }
                            }
                            Rectangle {
                                horizontal-stretch: 1;
                                nom := Text {
                                    width: parent.width;
                                    height: parent.height;
                                    text: step.title;
                                    font-size: 15.5px;
                                    color: step.done ? Tokens.text-muted : Tokens.text;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                                Rectangle {
                                    visible: step.done;
                                    x: 0;
                                    y: parent.height / 2;
                                    width: min(nom.preferred-width, parent.width);
                                    height: 1px;
                                    background: Tokens.text-muted;
                                }
                            }
                            IconButton {
                                y: (parent.height - self.height) / 2;
                                icon: Icons.window-close;
                                label: "Remove subtask " + step.title;
                                button-size: 30px;
                                icon-size: 11px;
                                clicked => { root.step-removed(step.id); }
                            }
                        }
                        GroupRow {
                            first: root.detail.subtasks.length == 0;
                            flat: true;
                            enabled: false;
                            label: "Add a subtask";
                            Icon {
                                y: (parent.height - self.height) / 2;
                                data: Icons.plus;
                                size: 18px;
                                tint: Tokens.text-muted;
                            }
                            etape := TextField {
                                y: (parent.height - self.height) / 2;
                                height: 36px;
                                bare: true;
                                font-size: 15.5px;
                                accessible-label: "Add a subtask";
                                placeholder-text: "Add a subtask";
                                text <=> root.new-step;
                                accepted(t) => {
                                    if (t != "") {
                                        root.step-added(t);
                                        root.new-step = "";
                                    }
                                }
                            }
                        }
                    }
                }

                // Its notes, on a card of their own.
                HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 16px;
                    padding-top: 14px;
                    Rectangle {
                        height: 96px;
                        border-radius: 14px;
                        background: Tokens.surface;
                        TextArea {
                            x: 10px;
                            y: 6px;
                            width: parent.width - 20px;
                            height: parent.height - 12px;
                            bare: true;
                            font-size: 15px;
                            accessible-label: "Notes";
                            placeholder-text: "Notes";
                            text <=> root.notes;
                            edited(t) => { root.notes-edited(t); }
                        }
                    }
                }
            }
        }
    }
}

// The line to add a task, and what it understood before Enter.
component AddBar inherits Rectangle {
    in-out property <string> text;
    in property <string> hint;
    in property <[TaskTokenData]> tokens;
    /// The task just added whose length is asked, over the bar: what Enter then
    /// sends is an answer (a length, nothing to skip, or the next task).
    in property <string> asking;
    callback edited(string);
    callback add(string);
    callback answered(string);
    /// Raised to put the cursor in the line.
    in property <int> focus-request;

    public function focus-field() { champ.focus(); }
    changed focus-request => { champ.focus(); }

    // On a phone the mockups' dock (T2, T3): a pill to touch at the foot of the page;
    // touched, the line opens over the keyboard, what Iris understood in tokens above
    // what is typed, Add at its end.
    property <bool> phone: Layout.compact;
    property <bool> open: champ.has-focus || root.text != "";
    property <bool> jetons-au-dessus: root.phone && root.open && root.tokens.length > 0;

    // As Reminders' "New reminder": no box, the accent's plus where a circle would be,
    // a hairline over it; a soft plate while it is typed in.
    height: root.phone ? 64px + (root.jetons-au-dessus ? 40px : 0px)
        : Layout.touch-input ? 52px : 46px;
    border-radius: root.phone ? 0px : Layout.touch-input ? Tokens.radius-large : Tokens.radius-medium;
    // A tablet's a card of its own from the start, a shade lighter than the list, so
    // that the line to add a task is seen before it is touched; a phone's the page's
    // ground, the panel's once open.
    background: root.phone ? (root.open ? Tokens.panel : Tokens.surface)
        : champ.has-focus ? Tokens.surface-active
        : Layout.touch-input ? Tokens.surface-hover : transparent;
    drop-shadow-blur: root.phone && root.open ? Tokens.shadow-float-blur : 0px;
    drop-shadow-color: Tokens.shadow-float;

    // The dock's hairline over the list.
    if root.phone: Rectangle {
        y: 0px;
        height: 1px;
        background: Tokens.border;
    }

    VerticalLayout {
        padding-left: root.phone ? 14px : 0px;
        padding-right: root.phone ? 14px : 0px;
        padding-top: root.phone ? 10px : 0px;
        padding-bottom: root.phone ? 10px : 0px;
        spacing: 10px;
        if root.jetons-au-dessus: HorizontalLayout {
            height: 30px;
            spacing: 8px;
            alignment: start;
            for jeton in root.tokens: Token {
                text: jeton.text;
                icon: jeton.kind == 0 ? Icons.calendar : "";
                has-dot: jeton.kind == 1;
                dot: jeton.color;
                level: jeton.kind == 2 ? jeton.level : 0;
            }
        }
        Rectangle {
            border-radius: root.phone ? 22px : 0px;
            background: root.phone && !root.open ? Tokens.well : transparent;
            HorizontalLayout {
                padding-left: root.phone ? (root.open ? 0px : 16px) : 14px;
                padding-right: root.phone ? 0px : 8px;
                spacing: root.phone ? 10px : 12px;
                if !(root.phone && root.open): Icon {
                    y: (parent.height - self.height) / 2;
                    width: root.phone ? 18px : 20px;
                    data: Icons.plus;
                    size: 18px;
                    weight: 2.0;
                    tint: root.phone ? Tokens.text-muted : Tokens.accent;
                }
                champ := TextField {
                    y: (parent.height - self.height) / 2;
                    height: 36px;
                    bare: true;
                    font-size: root.phone ? (root.open ? 16px : 15px) : 14px;
                    accessible-label: "Add a task";
                    placeholder-text: root.hint;
                    text <=> root.text;
                    edited(t) => { root.edited(t); }
                    accepted(t) => {
                        if (root.asking != "") {
                            root.answered(t);
                        } else if (t != "") {
                            root.add(t);
                        }
                    }
                }
                if !root.phone && root.tokens.length > 0: HorizontalLayout {
                    spacing: 12px;
                    for jeton in root.tokens: Pill {
                        y: (parent.height - self.height) / 2;
                        kind: PillKind.token;
                        text: jeton.text;
                        icon: jeton.kind == 0 ? Icons.calendar : "";
                        has-dot: jeton.kind == 1;
                        dot: jeton.color;
                        tinted: jeton.kind == 2;
                        tint: Priority.tint(jeton.level);
                    }
                }
                if root.text != "": Button {
                    y: (parent.height - self.height) / 2;
                    text: "Add";
                    shortcut: "Enter";
                    label: "Add the task";
                    kind: ButtonKind.primary;
                    size: ButtonSize.sm;
                    clicked => {
                        if (root.asking != "") {
                            root.answered(root.text);
                        } else {
                            root.add(root.text);
                        }
                    }
                }
            }
        }
    }
}

// How long the task just added takes, asked in a small bubble over the add bar. It
// takes nothing from the keyboard: the cursor stays in the bar, Enter skips, a
// length typed or clicked is kept, and the next task written is simply added.
component EstimateBubble inherits Rectangle {
    in property <string> task;
    callback chosen(int);
    /// Nothing to say: the length is skipped (the phone's "Skip").
    callback skipped();

    property <float> entree: 0;
    init => { root.entree = 1; }
    animate entree { duration: Tokens.moderate; easing: ease-out; }

    /// On a phone, as wide as the screen leaves it.
    in property <length> phone-width;

    // On a phone the mockups' T4: the width of the screen, pills for the finger, Skip.
    width: Layout.compact ? root.phone-width : min(420px, contenu.preferred-width + 28px);
    height: Layout.compact ? telephone.preferred-height + 20px : contenu.preferred-height + 20px;
    border-radius: Layout.compact ? 16px : Tokens.radius-large;
    border-width: Layout.compact ? 0px : 1px;
    border-color: Tokens.border;
    background: Tokens.panel;
    drop-shadow-blur: Tokens.shadow-float-blur;
    drop-shadow-offset-y: Tokens.shadow-float-y;
    drop-shadow-color: Tokens.shadow-float;
    opacity: root.entree;

    accessible-role: groupbox;
    accessible-label: "How long will " + root.task + " take? Type a length, or press Enter to skip";

    contenu := VerticalLayout {
        visible: !Layout.compact;
        x: 14px;
        y: 10px;
        width: parent.width - 28px;
        spacing: 8px;
        HorizontalLayout {
            spacing: 6px;
            Icon {
                y: (parent.height - self.height) / 2;
                width: 14px;
                data: Icons.hourglass;
                size: 13px;
                tint: Tokens.accent;
            }
            Text {
                text: "How long will “" + root.task + "” take?";
                font-size: 12.5px;
                font-weight: 600;
                color: Tokens.text;
                vertical-alignment: center;
                overflow: elide;
            }
        }
        HorizontalLayout {
            spacing: 6px;
            for m[i] in [15, 30, 60, 120]: Pill {
                text: ["15 min", "30 min", "1 h", "2 h"][i];
                toggled => { root.chosen(m); }
            }
            Text {
                text: "or type it · Enter to skip";
                font-size: 12px;
                color: Tokens.text-muted;
                vertical-alignment: center;
                overflow: elide;
                horizontal-stretch: 1;
            }
        }
    }

    // A phone's: the question in grey, then the lengths and Skip as pills.
    telephone := VerticalLayout {
        visible: Layout.compact;
        x: 12px;
        y: 10px;
        width: parent.width - 24px;
        spacing: 8px;
        Text {
            text: "How long does “" + root.task + "” take?";
            font-size: 13.5px;
            color: Tokens.text-muted;
            overflow: elide;
        }
        HorizontalLayout {
            spacing: 6px;
            alignment: start;
            for m[i] in [15, 30, 60, 120]: Pill {
                text: ["15 min", "30 min", "1 h", "2 h"][i];
                toggled => { root.chosen(m); }
            }
            Pill {
                text: "Skip";
                tinted: true;
                tint: Tokens.text-muted;
                toggled => { root.skipped(); }
            }
        }
    }
}

// The overview on a phone (the mockups' T1): the desktop's left column as a page of
// its own. Search and ⋯ in the bar, the title, the four views as tiles with their
// counts, Habits and This week, the goals with their rings, the lists.
component TasksOverviewPage inherits Rectangle {
    in property <[TaskPlaceData]> places;
    in property <TaskOverviewData> overview;
    in property <[GoalData]> goals;
    /// "2 of 4": the habits done of those due today.
    in property <string> habits-count;
    callback place-chosen(string);
    callback new-goal();
    callback list-new();
    callback menu();

    background: Tokens.background;

    VerticalLayout {
        PhoneBar {
            Rectangle { horizontal-stretch: 1; }
            BarButton {
                y: (parent.height - self.height) / 2;
                icon: Icons.search;
                label: "Search";
                clicked => { Chrome.palette(); }
            }
            BarButton {
                y: (parent.height - self.height) / 2;
                icon: Icons.more;
                label: "More";
                clicked => { root.menu(); }
            }
        }
        BigTitle { text: "Tasks"; }

        vue := ScrollView {
            vertical-stretch: 1;
            content-width: self.visible-width;
            VerticalLayout {
                width: vue.visible-width;
                alignment: start;
                padding-bottom: 20px;

                // Today, Upcoming, All tasks, From mail: two by two.
                if root.places.length >= 4: VerticalLayout {
                    padding-left: 16px;
                    padding-right: 16px;
                    padding-top: 4px;
                    spacing: 10px;
                    HorizontalLayout {
                        spacing: 10px;
                        for k in [0, 1]: PlaceTile {
                            place: root.places[k];
                            tint: k == 0 ? Tokens.blue : Tokens.red;
                            chosen(c) => { root.place-chosen(c); }
                        }
                    }
                    HorizontalLayout {
                        spacing: 10px;
                        for k in [2, 3]: PlaceTile {
                            place: root.places[k];
                            tint: k == 2 ? Tokens.grey : Tokens.orange;
                            chosen(c) => { root.place-chosen(c); }
                        }
                    }
                }

                // The habits, and the week in review.
                HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 16px;
                    padding-top: 14px;
                    GroupCard {
                        GroupRow {
                            first: true;
                            label: "Habits";
                            clicked => { root.place-chosen("habits"); }
                            RowTile {
                                y: (parent.height - self.height) / 2;
                                icon: Icons.sprout;
                                tint: Tokens.green;
                            }
                            RowLabel { text: "Habits"; }
                            if root.habits-count != "": RowValue { text: root.habits-count + " today"; }
                            RowChevron { y: (parent.height - self.height) / 2; }
                        }
                        if root.places.length >= 5 && !root.places[4].is-list: GroupRow {
                            label: root.places[4].name;
                            clicked => { root.place-chosen(root.places[4].key); }
                            RowTile {
                                y: (parent.height - self.height) / 2;
                                icon: Icons.review;
                                tint: Tokens.purple;
                            }
                            RowLabel { text: root.places[4].name; }
                            RowValue { text: root.overview.week-done + " done"; }
                            RowChevron { y: (parent.height - self.height) / 2; }
                        }
                    }
                }

                // The goals, each with its ring; one behind counts in red.
                GroupTitle {
                    text: "Goals";
                    add-label: "New goal";
                    add => { root.new-goal(); }
                }
                HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 16px;
                    GroupCard {
                        for g[i] in root.goals: GroupRow {
                            first: i == 0;
                            label: g.title;
                            clicked => { root.place-chosen("goal:" + g.id); }
                            GoalRing {
                                y: (parent.height - self.height) / 2;
                                ring: g.ring;
                                tint: g.color;
                                size: 30px;
                                track: Tokens.border-strong;
                            }
                            RowLabel { text: g.title; }
                            RowValue {
                                text: g.done + "/" + g.target;
                                color: g.status == 1 ? Tokens.error : Tokens.text-muted;
                            }
                        }
                        if root.goals.length == 0: GroupRow {
                            first: true;
                            flat: true;
                            label: "New goal";
                            clicked => { root.new-goal(); }
                            RowLabel {
                                text: "No goal yet. A goal is something to reach by a day.";
                                color: Tokens.text-muted;
                            }
                        }
                    }
                }

                // The lists, each with its colour and how many are open.
                GroupTitle {
                    text: "Lists";
                    add-label: "New list";
                    add => { root.list-new(); }
                }
                HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 16px;
                    GroupCard {
                        for place[i] in root.places: VerticalLayout {
                            if place.is-list: GroupRow {
                                first: i == 0 || !root.places[i - 1].is-list;
                                label: place.name;
                                clicked => { root.place-chosen(place.key); }
                                Rectangle {
                                    y: (parent.height - self.height) / 2;
                                    width: 30px;
                                    height: 12px;
                                    Rectangle {
                                        x: 9px;
                                        width: 12px;
                                        height: 12px;
                                        border-radius: 6px;
                                        background: place.color;
                                    }
                                }
                                RowLabel { text: place.name; }
                                if place.count > 0: RowValue { text: place.count; }
                            }
                        }
                    }
                }
            }
        }
    }
}

export component TasksView inherits Rectangle {
    in property <string> title;
    /// Beside the title: today's date, on Today.
    in property <string> subtitle;
    in property <TaskOverviewData> overview;
    in property <[TaskPlaceData]> places;
    in property <[TaskRowData]> rows;
    in-out property <string> add-text;
    in property <string> add-hint;
    in property <[TaskTokenData]> add-tokens;
    /// Raised to put the cursor in the quick-add line.
    in property <int> focus-add-request;
    /// The task just added, whose length is asked; empty when nothing is.
    in property <string> asking;
    /// What Enter sent while a length was asked: a length, nothing, or a new task.
    callback add-answered(string);
    /// A length clicked in the bubble, in minutes.
    callback asked-estimate(int);

    in property <bool> has-detail;
    in property <TaskDetailData> detail;
    in-out property <string> detail-title;
    in-out property <string> detail-notes;
    in-out property <string> detail-time;
    in property <[string]> lists;
    in property <[string]> reminders;
    in property <[string]> repeats;
    in property <bool> picker-open;
    in property <string> picker-title;
    in property <[MonthCellData]> picker-cells;

    /// What the middle shows: 0 a list of tasks, 1 a goal, 2 all the goals.
    in property <int> page;
    in property <[GoalData]> goals;
    /// On Today: the goals that need something this week.
    in property <[GoalData]> nudges;
    in property <GoalData> goal;
    in property <[GoalLogData]> goal-log;
    in property <string> goal-chart;
    in property <float> goal-now-x;
    in property <float> goal-now-y;
    in property <string> goal-start-label;
    in-out property <string> goal-note;
    in property <[string]> goal-names;

    /// Only the column: the habits are shown, drawn by the window beside it.
    in property <bool> column-only;
    /// Below 840 pixels, the column shown as a page of its own.
    in-out property <bool> column-open;
    /// The habits are the place chosen in the column, and how many of today's are
    /// done ("2 of 4").
    in property <bool> habits-shown;
    in property <string> habits-count;
    callback new-goal();
    callback goal-logged(string);
    callback goal-entry-removed(int);
    callback milestone-toggled(int);
    callback milestone-added(string);
    callback make-time();
    callback goal-delete();
    callback goal-edit();
    callback goal-renamed(string);
    callback goal-rename-closed();
    callback task-goal-chosen(int);
    /// Later for a task, and where its menu goes.
    callback task-later(int, length, length);
    callback slot-requested(length, length);
    callback unbook();
    callback estimate-chosen(int);
    callback estimate-typed(string);

    callback place-chosen(string);
    callback place-menu(TaskPlaceData, length, length);
    callback list-new();
    callback add-edited(string);
    callback add(string);
    callback row-selected(TaskRowData);
    callback toggled(int);
    callback clear-completed();
    callback open-calendar();
    /// Today: lay the tasks with no hour into the free time, or take that back.
    callback plan-day();
    callback unplan-day();
    /// A task let go on a list, or on Today.
    callback task-dropped(int, string);
    /// A task let go on another in the column: (it, that one, above rather than below).
    callback task-reordered(int, int, bool);
    /// A phone's ⋯: "overview", "page", "task", "goal".
    callback menu-requested(string);
    /// Raised to put the cursor in the open task's "Add a subtask".
    in property <int> focus-step;

    callback title-edited(string);
    callback notes-edited(string);
    callback time-edited(string);
    callback picker-toggled();
    callback picker-navigate(int);
    callback picker-chosen(string);
    callback due-cleared();
    callback reminder-chosen(int);
    callback repeat-chosen(int);
    callback priority-chosen(int);
    callback list-chosen(int);
    callback step-added(string);
    callback step-toggled(int);
    callback step-removed(int);
    callback open-mail();
    callback copy-link();
    callback delete();
    callback detail-closed();

    /// A phone's "Log one" sheet is open over the goal; it goes with the goal's page.
    property <bool> goal-logging;
    changed page => { root.goal-logging = false; }

    // The task in the hand, and where the pointer is, in window coordinates.
    property <int> carried: -1;
    property <string> carried-title;
    property <length> carry-x;
    property <length> carry-y;
    // Where it was let go, for the list under that point.
    property <int> drop;
    property <int> dropped-id;
    property <length> drop-x;
    property <length> drop-y;

    // A list is a white page, as in Reminders; a goal's cards stand on the grey ground.
    background: root.page == 0 ? Tokens.surface : Tokens.background;


    HorizontalLayout {
        // --- Left: the window's sidebar: the smart views as tiles, the habits, the
        // goals, then the lists and the week. Below 840 pixels, a page of its own,
        // opened from the list's "Lists" button. ---
        // On a phone the column is a page of its own instead (the mockups' T1).
        if Layout.compact && root.column-open: TasksOverviewPage {
            horizontal-stretch: 1;
            places: root.places;
            overview: root.overview;
            goals: root.goals;
            habits-count: root.habits-count;
            place-chosen(k) => { root.place-chosen(k); }
            new-goal => { root.new-goal(); }
            list-new => { root.list-new(); }
            menu => { root.menu-requested("overview"); }
        }
        if !Layout.compact: SidebarFrame {
            visible: Layout.width-class == WidthClass.expanded || root.column-open;
            sidebar-width: root.column-open ? Layout.window-width - (Layout.medium ? 80px : 0px)
                : Layout.width-class == WidthClass.expanded ? 232px : 0px;
            // Today, Upcoming, All tasks, From mail: four tiles, two by two, as
            // Reminders has them.
            if root.places.length >= 4: VerticalLayout {
                spacing: 8px;
                padding-bottom: 6px;
                HorizontalLayout {
                    spacing: 8px;
                    for k in [0, 1]: PlaceTile {
                        place: root.places[k];
                        tint: k == 0 ? Tokens.blue : Tokens.red;
                        carrying: root.carried >= 0;
                        carry-x: root.carry-x;
                        carry-y: root.carry-y;
                        drop: root.drop;
                        drop-x: root.drop-x;
                        drop-y: root.drop-y;
                        chosen(c) => { root.place-chosen(c); }
                        dropped(c) => { root.task-dropped(root.dropped-id, c); }
                    }
                }
                HorizontalLayout {
                    spacing: 8px;
                    for k in [2, 3]: PlaceTile {
                        place: root.places[k];
                        tint: k == 2 ? Tokens.grey : Tokens.orange;
                        carrying: root.carried >= 0;
                        carry-x: root.carry-x;
                        carry-y: root.carry-y;
                        drop: root.drop;
                        drop-x: root.drop-x;
                        drop-y: root.drop-y;
                        chosen(c) => { root.place-chosen(c); }
                        dropped(c) => { root.task-dropped(root.dropped-id, c); }
                    }
                }
            }

            // The habits: a circle a day, beside the tasks.
            NavItem {
                label: "Habits";
                icon: Icons.sprout;
                icon-tint: Tokens.green;
                count: root.habits-count;
                selected: root.habits-shown;
                clicked => { root.place-chosen("habits"); }
            }

            // The goals, their title leading to all of them.
            HorizontalLayout {
                height: 31px;
                padding-left: 8px;
                padding-right: 0px;
                padding-top: 12px;
                padding-bottom: 4px;
                Rectangle {
                    horizontal-stretch: 1;
                    accessible-role: button;
                    accessible-label: "All goals";
                    accessible-action-default => { root.place-chosen("goals"); }
                    SectionTitle {
                        x: 0;
                        height: parent.height;
                        text: "Goals";
                        color: tous.has-hover || (root.page == 2 && !root.habits-shown)
                            ? Tokens.text : Tokens.text-muted;
                    }
                    tous := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.place-chosen("goals"); }
                    }
                }
                IconButton {
                    cross-axis-self-alignment: center;
                    icon: Icons.plus;
                    label: "New goal";
                    button-size: 20px;
                    icon-size: 14px;
                    clicked => { root.new-goal(); }
                }
            }
            for g in root.goals: GoalRow {
                goal: g;
                chosen(id) => { root.place-chosen("goal:" + id); }
            }
            if root.goals.length == 0: HorizontalLayout {
                height: 28px;
                padding-left: 8px;
                Text {
                    text: "No goal yet.";
                    font-size: 12.5px;
                    color: Tokens.text-muted;
                    vertical-alignment: center;
                }
            }

            for place[i] in root.places: VerticalLayout {
                // A title above the first list, with the way to make another.
                if place.is-list && (i == 0 || !root.places[i - 1].is-list): SectionRow {
                    text: "My Lists";
                    IconButton {
                        y: (parent.height - self.height) / 2;
                        icon: Icons.plus;
                        label: "New list";
                        button-size: 20px;
                        icon-size: 14px;
                        clicked => { root.list-new(); }
                    }
                }
                // The four first are the tiles above.
                if i >= 4: PlaceRow {
                    place: place;
                    carrying: root.carried >= 0;
                    carry-x: root.carry-x;
                    carry-y: root.carry-y;
                    drop: root.drop;
                    drop-x: root.drop-x;
                    drop-y: root.drop-y;
                    chosen(k) => { root.place-chosen(k); }
                    menu(p, x, y) => { root.place-menu(p, x, y); }
                    dropped(k) => { root.task-dropped(root.dropped-id, k); }
                }
            }

            Rectangle { vertical-stretch: 1; }
        }

        // --- Middle: the day, what there is to do, and the line to add more; or a
        // goal; or all of them ---
        // The toolbar runs over the page and the task's panel alike: the window's
        // buttons stay in its corner. While the habits show, the window draws them
        // beside the column instead.
        if !root.column-only && !root.column-open: VerticalLayout {
            horizontal-stretch: 1;

            // The window's toolbar: a new task. Over a goal's grey page, the page's
            // own grey and no line.
            // On a phone the mockups' bar instead (T2, T7, G4): back to the overview,
            // then what the page has: Plan my day on Today, the goal's pencil, ⋯. A task
            // open draws its own.
            if Layout.compact && !root.has-detail: PhoneBar {
                BarButton {
                    y: (parent.height - self.height) / 2;
                    icon: Icons.arrow-left;
                    label: "Lists";
                    clicked => { root.column-open = true; }
                }
                Rectangle { horizontal-stretch: 1; }
                // Today's tasks with no hour, laid into the free time.
                if root.page == 0 && root.overview.show-day: BarButton {
                    y: (parent.height - self.height) / 2;
                    icon: Icons.sparkle;
                    label: "Plan my day";
                    enabled: root.overview.to-plan > 0;
                    clicked => { root.plan-day(); }
                }
                if root.page == 1: BarButton {
                    y: (parent.height - self.height) / 2;
                    icon: Icons.pencil;
                    label: "Edit goal";
                    clicked => { root.goal-edit(); }
                }
                if root.page == 2: BarButton {
                    y: (parent.height - self.height) / 2;
                    icon: Icons.plus;
                    label: "New goal";
                    clicked => { root.new-goal(); }
                }
                // A list's ⋯ renames or deletes it; a view's and a goal's have theirs.
                if root.page != 2: BarButton {
                    y: (parent.height - self.height) / 2;
                    icon: Icons.more;
                    label: "More";
                    clicked => {
                        if (root.page == 1) {
                            root.menu-requested("goal");
                        } else if (root.overview.list-place >= 0
                            && root.overview.list-place < root.places.length) {
                            root.place-menu(root.places[root.overview.list-place],
                                self.absolute-position.x, self.absolute-position.y + self.height);
                        } else {
                            root.menu-requested("page");
                        }
                    }
                }
            }
            if !Layout.compact: WindowToolbar {
                hairline: root.page == 0;
                background: root.page == 0 ? Tokens.surface : Tokens.background;
                // No column beside the list: its views and lists open as a page.
                if Layout.width-class != WidthClass.expanded: IconButton {
                    y: (parent.height - self.height) / 2;
                    icon: Icons.list;
                    label: "Lists";
                    button-size: Layout.touch-input ? 44px : 30px;
                    icon-size: Layout.touch-input ? 22px : 18px;
                    clicked => { root.column-open = true; }
                }
                Rectangle { horizontal-stretch: 1; }
                IconButton {
                    y: (parent.height - self.height) / 2;
                    icon: Icons.plus;
                    label: "New task";
                    shortcut: "N";
                    button-size: 30px;
                    icon-size: 18px;
                    tint: Tokens.accent;
                    tinted: true;
                    clicked => { ajout.focus-field(); }
                }
            }

        HorizontalLayout {
            vertical-stretch: 1;
        // On a phone, a task open is a page of its own: the list steps aside.
        VerticalLayout {
            horizontal-stretch: 1;
            visible: !(Layout.compact && root.has-detail);
            max-width: Layout.compact && root.has-detail ? 0px : 100000px;

        if root.page == 1: GoalPage {
            vertical-stretch: 1;
            narrow: root.has-detail || !(Layout.width-class == WidthClass.expanded);
            goal: root.goal;
            log: root.goal-log;
            chart: root.goal-chart;
            now-x: root.goal-now-x;
            now-y: root.goal-now-y;
            start-label: root.goal-start-label;
            note <=> root.goal-note;
            logged(t) => { root.goal-logged(t); }
            entry-removed(id) => { root.goal-entry-removed(id); }
            milestone-toggled(id) => { root.milestone-toggled(id); }
            milestone-added(t) => { root.milestone-added(t); }
            make-time => { root.make-time(); }
            delete-goal => { root.goal-delete(); }
            edit-goal => { root.goal-edit(); }
            renamed(t) => { root.goal-renamed(t); }
            rename-closed => { root.goal-rename-closed(); }
            log-requested => { root.goal-logging = true; }

            // The steps: the tasks toward it.
            etapes := ScrollView {
                vertical-stretch: 1;
                min-height: 60px;
                mouse-drag-pan-enabled: false;
                content-width: self.visible-width;
                VerticalLayout {
                    width: etapes.visible-width;
                    alignment: start;
                    spacing: Layout.compact ? 0px : 6px;
                    for ligne[i] in root.rows: VerticalLayout {
                        if !Layout.compact: TaskRow {
                            item: ligne;
                            selected(r) => { root.row-selected(r); }
                            toggled(id) => { root.toggled(id); }
                            clear-completed => { root.clear-completed(); }
                            later(r, x, y) => { root.task-later(r.id, x, y); }
                        }
                        // A step on a phone: the list's own row, on its card.
                        if Layout.compact: PhoneTaskRow {
                            item: ligne;
                            selected(r) => { root.row-selected(r); }
                            toggled(id) => { root.toggled(id); }
                            clear-completed => { root.clear-completed(); }
                            later(r, x, y) => { root.task-later(r.id, x, y); }
                        }
                    }
                    if root.rows.length == 0: Text {
                        height: 44px;
                        text: "No open steps. Add one below.";
                        font-size: 12.5px;
                        color: Tokens.text-muted;
                        vertical-alignment: center;
                    }
                }
            }
        }

        if root.page == 2: GoalsOverview {
            vertical-stretch: 1;
            goals: root.goals;
            chosen(id) => { root.place-chosen("goal:" + id); }
            new-goal => { root.new-goal(); }
        }

        // A column of a readable width, centred: a task stretched across a wide
        // window is a line the eye has to travel.
        // Two margins that take what the column leaves: `alignment: center` gave the
        // column its preferred width (a few hundred pixels), not the room up to its
        // limit, and the end of each line fell outside the list.
        if root.page == 0: HorizontalLayout {
            vertical-stretch: 1;
        Rectangle { horizontal-stretch: 1; }
        colonne-page := VerticalLayout {
            horizontal-stretch: 1000;
            max-width: 840px;

            // The name of the view in large, in its list's colour, and how many are open
            // beside it, as Reminders writes them; the day and how much is done under.
            property <color> encre: root.overview.tint.alpha == 0 ? Tokens.accent : root.overview.tint;
            // On a phone the mockups' head (T2, T7): the title large in the text's
            // colour, the day under it, how much is done at its right over a bar.
            if Layout.compact: HorizontalLayout {
                padding-right: 18px;
                spacing: 10px;
                BigTitle {
                    horizontal-stretch: 1;
                    text: root.title;
                    sub: root.subtitle;
                }
                if root.overview.progress != "": VerticalLayout {
                    width: 110px;
                    alignment: end;
                    padding-bottom: 16px;
                    spacing: 5px;
                    Text {
                        text: root.overview.progress;
                        font-size: 13px;
                        color: Tokens.text-secondary;
                        horizontal-alignment: right;
                    }
                    DoneBar { fraction: root.overview.fraction; }
                }
            }
            if !Layout.compact: HorizontalLayout {
                height: 52px;
                padding-left: 40px;
                padding-right: 32px;
                padding-top: 8px;
                spacing: 12px;
                Text {
                    text: root.title;
                    font-family: Tokens.font-display;
                    font-size: 30px;
                    font-weight: 700;
                    color: colonne-page.encre;
                    vertical-alignment: bottom;
                    horizontal-stretch: 1;
                    overflow: elide;
                }
                if root.overview.open > 0: Text {
                    text: root.overview.open;
                    font-family: Tokens.font-display;
                    font-size: 28px;
                    font-weight: 600;
                    color: colonne-page.encre;
                    vertical-alignment: bottom;
                }
            }
            if !Layout.compact: HorizontalLayout {
                height: 30px;
                padding-left: 40px;
                padding-right: 32px;
                spacing: 12px;
                Text {
                    text: root.subtitle;
                    font-size: 13px;
                    color: Tokens.text-muted;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                // Today's tasks with no hour, laid into the calendar's free time.
                if root.overview.can-unplan: Button {
                    y: (parent.height - self.height) / 2;
                    text: "Undo plan";
                    size: ButtonSize.sm;
                    clicked => { root.unplan-day(); }
                }
                if root.overview.to-plan > 0: Button {
                    y: (parent.height - self.height) / 2;
                    text: "Plan my day";
                    size: ButtonSize.sm;
                    clicked => { root.plan-day(); }
                }
                if root.overview.progress != "": HorizontalLayout {
                    horizontal-stretch: 0;
                    spacing: 10px;
                    Text {
                        text: root.overview.progress;
                        font-size: 12.5px;
                        color: Tokens.text-muted;
                        vertical-alignment: center;
                    }
                    Rectangle {
                        width: Layout.compact ? 60px : 120px;
                        Rectangle {
                            y: (parent.height - self.height) / 2;
                            height: 5px;
                            border-radius: 2.5px;
                            background: Tokens.surface-active;
                            Rectangle {
                                x: 0;
                                width: parent.width * root.overview.fraction;
                                // It fills, rather than jumping, as tasks are done.
                                animate width { duration: 450ms; easing: ease-out; }
                                border-radius: 2.5px;
                                background: Tokens.success;
                            }
                        }
                    }
                }
            }

            if root.nudges.length > 0 && !Layout.compact: HorizontalLayout {
                padding-left: 32px;
                padding-right: 32px;
                padding-top: 10px;
                padding-bottom: 10px;
                GoalNudges {
                    goals: root.nudges;
                    chosen(id) => { root.place-chosen("goal:" + id); }
                }
            }
            if root.nudges.length > 0 && !Layout.compact: Hairline {}

            // On a phone (T2): the goal that needs attention, a card of its own; then
            // what the calendar holds next today, and how many more.
            if Layout.compact: VerticalLayout {
                for g in root.nudges: HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 16px;
                    padding-top: 4px;
                    Rectangle {
                        height: 44px;
                        border-radius: 14px;
                        border-width: 1px;
                        border-color: Tokens.border;
                        background: pousse.pressed ? Tokens.surface-active : transparent;
                        accessible-role: button;
                        accessible-label: g.title;
                        accessible-description: g.pace;
                        accessible-action-default => { root.place-chosen("goal:" + g.id); }
                        pousse := TouchArea {
                            clicked => { root.place-chosen("goal:" + g.id); }
                        }
                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            spacing: 10px;
                            GoalRing {
                                y: (parent.height - self.height) / 2;
                                ring: g.ring;
                                tint: g.color;
                                size: 20px;
                                stroke: 2.8px;
                                track: Tokens.border-strong;
                            }
                            Text {
                                text: g.title;
                                font-size: 14px;
                                font-weight: 700;
                                color: Tokens.text;
                                vertical-alignment: center;
                                overflow: elide;
                                max-width: self.preferred-width;
                            }
                            Text {
                                text: "· " + (g.status == 1 ? g.badge + ", " : "") + g.pace;
                                font-size: 14px;
                                color: Tokens.text;
                                vertical-alignment: center;
                                overflow: elide;
                                horizontal-stretch: 1;
                            }
                        }
                    }
                }
                // The next event today (the first not past), and the rest counted.
                for a[i] in root.overview.agenda: VerticalLayout {
                    if !a.past && (i == 0 || root.overview.agenda[i - 1].past): Rectangle {
                        height: 46px;
                        background: vers-agenda.pressed ? Tokens.surface-active : transparent;
                        accessible-role: button;
                        accessible-label: a.meta + " " + a.title;
                        accessible-action-default => { root.open-calendar(); }
                        vers-agenda := TouchArea {
                            clicked => { root.open-calendar(); }
                        }
                        Rectangle {
                            y: parent.height - 1px;
                            height: 1px;
                            background: Tokens.border;
                        }
                        HorizontalLayout {
                            padding-left: 18px;
                            padding-right: 18px;
                            spacing: 10px;
                            Rectangle {
                                y: (parent.height - self.height) / 2;
                                width: 8px;
                                height: 8px;
                                border-radius: 4px;
                                background: a.color;
                            }
                            Text {
                                text: a.meta;
                                font-size: 14px;
                                color: Tokens.text-secondary;
                                vertical-alignment: center;
                            }
                            Text {
                                text: a.title;
                                font-size: 14px;
                                color: Tokens.text-secondary;
                                vertical-alignment: center;
                                overflow: elide;
                                horizontal-stretch: 1;
                            }
                            if root.overview.agenda.length - i - 1 > 0: Text {
                                text: "+" + (root.overview.agenda.length - i - 1)
                                    + (root.overview.agenda.length - i - 1 == 1 ? " event" : " events");
                                font-size: 14px;
                                color: Tokens.text-muted;
                                vertical-alignment: center;
                            }
                            Icon {
                                y: (parent.height - self.height) / 2;
                                data: Icons.chevron-right;
                                size: 14px;
                                tint: Tokens.text-muted;
                            }
                        }
                    }
                }
            }

            liste-taches := ScrollView {
                vertical-stretch: 1;
                // The mouse carries tasks; the wheel scrolls.
                mouse-drag-pan-enabled: false;
                // As wide as what shows: left to the rows' own width, the list ran
                // past the column and its right-hand end (Clear, the dates) was cut.
                content-width: self.visible-width;
                VerticalLayout {
                    width: liste-taches.visible-width;
                    alignment: start;
                    // The rows' own 12 px inset brings their circles to the title's 40.
                    // On a phone the rows run edge to edge, their own 18 inside.
                    padding-left: Layout.compact ? 0px : 28px;
                    padding-right: Layout.compact ? 0px : 32px;
                    padding-top: Layout.compact ? 0px : 6px;
                    padding-bottom: 12px;
                    spacing: 0px;
                        if Layout.compact: VerticalLayout {
                            for ligne in root.rows: PhoneTaskRow {
                                item: ligne;
                                selected(r) => { root.row-selected(r); }
                                toggled(id) => { root.toggled(id); }
                                clear-completed => { root.clear-completed(); }
                                later(r, x, y) => { root.task-later(r.id, x, y); }
                            }
                        }
                        if !Layout.compact: VerticalLayout {
                        for ligne[i] in root.rows: TaskRow {
                            item: ligne;
                            selected(r) => { root.row-selected(r); }
                            toggled(id) => { root.toggled(id); }
                            clear-completed => { root.clear-completed(); }
                            later(r, x, y) => { root.task-later(r.id, x, y); }
                            carried-id: root.carried;
                            carry-x: root.carry-x;
                            carry-y: root.carry-y;
                            drop: root.drop;
                            dropped-id: root.dropped-id;
                            drop-x: root.drop-x;
                            drop-y: root.drop-y;
                            reordered(porte, cible, dessus) => { root.task-reordered(porte, cible, dessus); }
                            carry-started(r, x, y) => {
                                root.carried = r.id;
                                root.carried-title = r.title;
                                root.carry-x = x;
                                root.carry-y = y;
                            }
                            carry-moved(x, y) => {
                                root.carry-x = x;
                                root.carry-y = y;
                            }
                            carry-ended => {
                                root.dropped-id = root.carried;
                                root.drop-x = root.carry-x;
                                root.drop-y = root.carry-y;
                                root.drop += 1;
                                root.carried = -1;
                            }
                        }
                        }
                        if root.rows.length == 0: Text {
                            height: 120px;
                            text: "Nothing here. Add a task below.";
                            font-size: 13px;
                            color: Tokens.text-muted;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                }
            }
        }
        Rectangle { horizontal-stretch: 1; }
        }

            // The line to add a task, or a step toward the goal shown.
            HorizontalLayout {
                vertical-stretch: 0;
                visible: root.page != 2;
                max-height: root.page == 2 ? 0px : 200px;
                // On a phone the dock runs edge to edge at the page's foot.
                padding-left: Layout.compact ? 0px : root.page == 1 ? 36px : 32px;
                padding-right: Layout.compact ? 0px : root.page == 1 ? 36px : 32px;
                padding-top: Layout.compact ? 0px : root.page == 1 ? 8px : 20px;
                padding-bottom: Layout.compact ? 0px : 18px;
                Rectangle { horizontal-stretch: 1; }
                ajout := AddBar {
                    horizontal-stretch: 1000;
                    focus-request: root.focus-add-request;
                    max-width: root.page == 0 ? 776px : 100000px;
                    text <=> root.add-text;
                    hint: root.add-hint;
                    tokens: root.add-tokens;
                    asking: root.asking;
                    edited(t) => { root.add-edited(t); }
                    add(t) => { root.add(t); }
                    answered(t) => { root.add-answered(t); }
                }
                Rectangle { horizontal-stretch: 1; }
            }
        }

        // --- Right: the chosen task ---
        if root.has-detail && !Layout.compact: TaskDetail {
            panel-width: 372px;
            step-focus-request: root.focus-step;
            detail: root.detail;
            title <=> root.detail-title;
            notes <=> root.detail-notes;
            time <=> root.detail-time;
            lists: root.lists;
            reminders: root.reminders;
            repeats: root.repeats;
            later(x, y) => { root.task-later(root.detail.id, x, y); }
            slot-requested(x, y) => { root.slot-requested(x, y); }
            unbook => { root.unbook(); }
            estimate-chosen(m) => { root.estimate-chosen(m); }
            estimate-typed(t) => { root.estimate-typed(t); }
            picker-open: root.picker-open;
            picker-title: root.picker-title;
            picker-cells: root.picker-cells;
            toggled(id) => { root.toggled(id); }
            title-edited(t) => { root.title-edited(t); }
            notes-edited(t) => { root.notes-edited(t); }
            time-edited(t) => { root.time-edited(t); }
            picker-toggled => { root.picker-toggled(); }
            picker-navigate(n) => { root.picker-navigate(n); }
            picker-chosen(d) => { root.picker-chosen(d); }
            due-cleared => { root.due-cleared(); }
            reminder-chosen(i) => { root.reminder-chosen(i); }
            repeat-chosen(i) => { root.repeat-chosen(i); }
            priority-chosen(p) => { root.priority-chosen(p); }
            list-chosen(i) => { root.list-chosen(i); }
            step-added(t) => { root.step-added(t); }
            step-toggled(id) => { root.step-toggled(id); }
            step-removed(id) => { root.step-removed(id); }
            open-mail => { root.open-mail(); }
            copy-link => { root.copy-link(); }
            delete => { root.delete(); }
            closed => { root.detail-closed(); }
        }
        // On a phone, the task as a page of its own (T5).
        if root.has-detail && Layout.compact: TaskPage {
            horizontal-stretch: 1;
            detail: root.detail;
            title <=> root.detail-title;
            notes <=> root.detail-notes;
            time <=> root.detail-time;
            lists: root.lists;
            reminders: root.reminders;
            repeats: root.repeats;
            picker-open: root.picker-open;
            picker-title: root.picker-title;
            picker-cells: root.picker-cells;
            step-focus-request: root.focus-step;
            later(x, y) => { root.task-later(root.detail.id, x, y); }
            slot-requested(x, y) => { root.slot-requested(x, y); }
            unbook => { root.unbook(); }
            estimate-chosen(m) => { root.estimate-chosen(m); }
            estimate-typed(t) => { root.estimate-typed(t); }
            toggled(id) => { root.toggled(id); }
            title-edited(t) => { root.title-edited(t); }
            notes-edited(t) => { root.notes-edited(t); }
            time-edited(t) => { root.time-edited(t); }
            picker-toggled => { root.picker-toggled(); }
            picker-navigate(n) => { root.picker-navigate(n); }
            picker-chosen(d) => { root.picker-chosen(d); }
            due-cleared => { root.due-cleared(); }
            reminder-chosen(i) => { root.reminder-chosen(i); }
            repeat-chosen(i) => { root.repeat-chosen(i); }
            priority-chosen(p) => { root.priority-chosen(p); }
            list-chosen(i) => { root.list-chosen(i); }
            step-added(t) => { root.step-added(t); }
            step-toggled(id) => { root.step-toggled(id); }
            step-removed(id) => { root.step-removed(id); }
            open-mail => { root.open-mail(); }
            delete => { root.delete(); }
            closed => { root.detail-closed(); }
            menu => { root.menu-requested("task"); }
        }
        }
        }
    }

    // Its length, asked over the add bar, centred on the middle column; on a phone,
    // the width of the screen just over the dock.
    if root.asking != "" && root.page != 2 && !root.column-only: EstimateBubble {
        property <length> colonne: Layout.compact ? 0px : 232px;
        property <length> milieu: root.width - self.colonne - (root.has-detail ? 384px : 0px);
        x: Layout.compact ? 14px : self.colonne + (self.milieu - self.width) / 2;
        y: Layout.compact ? root.height - 64px - (root.add-tokens.length > 0 ? 40px : 0px) - 10px - self.height
            : root.height - 18px - 50px - 8px - self.height;
        phone-width: root.width - 28px;
        visible: !(Layout.compact && (root.has-detail || root.column-open));
        task: root.asking;
        chosen(m) => { root.asked-estimate(m); }
        skipped => { root.add-answered(""); }
    }

    // Log one on a phone (the mockups' G5): a sheet over the goal, just above the
    // keyboard, a word on what was done and Log. Iris never counts on its own.
    if root.goal-logging && Layout.compact && root.page == 1: Rectangle {
        width: 100%;
        height: 100%;
        background: Tokens.scrim;
        FocusScope {
            width: 100%;
            height: 100%;
            enabled: false;
            key-pressed(event) => {
                if (event.text == Key.Escape || event.text == Key.Back) {
                    root.goal-logging = false;
                    return accept;
                }
                return reject;
            }
            TouchArea {
                clicked => { root.goal-logging = false; }
            }
            Rectangle {
                x: 0px;
                y: parent.height - self.height;
                width: parent.width;
                height: feuille.preferred-height;
                border-top-left-radius: 22px;
                border-top-right-radius: 22px;
                background: Tokens.panel;
                drop-shadow-blur: Tokens.shadow-window-blur;
                drop-shadow-color: Tokens.shadow-window;
                TouchArea {}
                Rectangle {
                    x: (parent.width - self.width) / 2;
                    y: 8px;
                    width: 40px;
                    height: 5px;
                    border-radius: 3px;
                    background: Tokens.border-strong;
                }
                feuille := VerticalLayout {
                    padding-top: 17px;
                    SheetTitle {
                        text: "Log one";
                        end: (root.goal.done + 1) + " of " + root.goal.target;
                    }
                    HorizontalLayout {
                        padding-left: 20px;
                        padding-right: 20px;
                        padding-bottom: 6px;
                        Rectangle {
                            height: 48px;
                            border-radius: 12px;
                            background: Tokens.group;
                            TextField {
                                x: 8px;
                                width: parent.width - 16px;
                                height: parent.height;
                                bare: true;
                                font-size: 16px;
                                accessible-label: "What did you do?";
                                placeholder-text: "What did you do? (optional)";
                                text <=> root.goal-note;
                                init => { self.focus(); }
                                accepted(t) => {
                                    root.goal-logging = false;
                                    root.goal-logged(t);
                                }
                            }
                        }
                    }
                    HorizontalLayout {
                        padding-left: 20px;
                        padding-right: 20px;
                        padding-top: 6px;
                        padding-bottom: 14px;
                        spacing: 8px;
                        Rectangle { horizontal-stretch: 1; }
                        Button {
                            cross-axis-self-alignment: center;
                            text: "Log";
                            label: "Log one";
                            kind: ButtonKind.primary;
                            size: ButtonSize.sm;
                            clicked => {
                                root.goal-logging = false;
                                root.goal-logged(root.goal-note);
                            }
                        }
                    }
                }
            }
        }
    }

    // The task in the hand: a lifted card that follows the pointer, a little off it
    // so the lists stay readable underneath.
    if root.carried >= 0: Rectangle {
        x: root.carry-x - root.absolute-position.x + 10px;
        y: root.carry-y - root.absolute-position.y - 22px;
        width: min(320px, carte.preferred-width + 60px);
        height: 44px;
        border-radius: Tokens.radius-medium;
        border-width: 1px;
        border-color: Tokens.border-strong;
        background: Tokens.panel;
        // In the hand: the highest of all, the shadow of a window.
        drop-shadow-blur: Tokens.shadow-window-blur;
        drop-shadow-offset-y: Tokens.shadow-window-y;
        drop-shadow-color: Tokens.shadow-window;

        HorizontalLayout {
            padding-left: 12px;
            padding-right: 12px;
            spacing: 10px;
            Check {
                y: (parent.height - self.height) / 2;
                size: 18px;
                interactive: false;
            }
            carte := Text {
                text: root.carried-title;
                font-size: 14px;
                color: Tokens.text;
                vertical-alignment: center;
                overflow: elide;
            }
        }
    }
}

// Later: to when a task is put off. Each use is counted; a task put off again and
// again gets asked about in its details.
export component LaterMenu inherits Rectangle {
    in property <string> task;
    in property <length> menu-x;
    in property <length> menu-y;
    /// Where Tonight, Tomorrow, This weekend and Next week land: shown on a phone.
    in property <[string]> days;
    /// How often it was put off: from three, a phone's sheet asks first.
    in property <int> postponed;
    callback chosen(string);
    callback pick-date();
    /// "split", "slot" or "letgo": the answers to the question.
    callback action(string);
    callback dismissed();

    TouchArea {
        width: 100%;
        height: 100%;
        clicked => { root.dismissed(); }
    }

    MenuSurface {
        dismissed => { root.dismissed(); }
        available-width: root.width;
        available-height: root.height;
        menu-x: root.menu-x;
        menu-y: root.menu-y;
        menu-width: 240px;
        menu-height: Layout.compact ? feuille.preferred-height : entrees.preferred-height + 8px;

        // The PC's menu.
        entrees := VerticalLayout {
            visible: !Layout.compact;
            padding: 4px;
            MenuHeader { text: "Move “" + root.task + "” to"; }
            MenuEntry {
                icon: Icons.clock;
                label: "Tonight, 23:59";
                activated => { root.chosen("tonight"); root.dismissed(); }
            }
            MenuEntry {
                icon: Icons.sun;
                label: "Tomorrow";
                activated => { root.chosen("tomorrow"); root.dismissed(); }
            }
            MenuEntry {
                icon: Icons.calendar;
                label: "This weekend";
                activated => { root.chosen("weekend"); root.dismissed(); }
            }
            MenuEntry {
                icon: Icons.arrow-right;
                label: "Next week";
                activated => { root.chosen("nextweek"); root.dismissed(); }
            }
            MenuEntry {
                icon: Icons.calendar;
                label: "Pick a date…";
                activated => { root.pick-date(); root.dismissed(); }
            }
            MenuSeparator {}
            MenuEntry {
                icon: Icons.hourglass;
                label: "Someday (no date)";
                activated => { root.chosen("someday"); root.dismissed(); }
            }
        }

        // A phone's sheet (the mockups' T6): put off three times, the question comes
        // first; then each choice with the day it lands on.
        feuille := VerticalLayout {
            visible: Layout.compact;
            padding-bottom: 4px;
            SheetTitle { text: "Later"; }
            if root.postponed >= 3: HorizontalLayout {
                padding-left: 20px;
                padding-right: 20px;
                padding-bottom: 10px;
                Rectangle {
                    height: question.preferred-height;
                    border-radius: 14px;
                    background: Tokens.orange.transparentize(0.89);
                    question := VerticalLayout {
                        padding-left: 14px;
                        padding-right: 14px;
                        padding-top: 12px;
                        padding-bottom: 12px;
                        spacing: 2px;
                        Text {
                            text: "Put off " + root.postponed + " times.";
                            font-size: 14px;
                            font-weight: 700;
                            color: Tokens.orange;
                        }
                        Text {
                            text: "Split it, give it a slot, or let it go?";
                            font-size: 14px;
                            color: Tokens.text-secondary;
                            wrap: word-wrap;
                        }
                        HorizontalLayout {
                            padding-top: 8px;
                            spacing: 8px;
                            alignment: start;
                            Button {
                                text: "Split into steps";
                                size: ButtonSize.sm;
                                clicked => { root.action("split"); }
                            }
                            Button {
                                text: "Find a slot";
                                size: ButtonSize.sm;
                                clicked => { root.action("slot"); }
                            }
                            Button {
                                text: "Let go";
                                label: "Let it go (delete)";
                                kind: ButtonKind.ghost;
                                size: ButtonSize.sm;
                                clicked => { root.action("letgo"); }
                            }
                        }
                    }
                }
            }
            SheetOption {
                icon: Icons.moon;
                label: "Tonight";
                value: root.days.length > 0 ? root.days[0] : "";
                activated => { root.chosen("tonight"); root.dismissed(); }
            }
            SheetOption {
                icon: Icons.sun;
                label: "Tomorrow";
                value: root.days.length > 1 ? root.days[1] : "";
                activated => { root.chosen("tomorrow"); root.dismissed(); }
            }
            SheetOption {
                icon: Icons.calendar;
                label: "This weekend";
                value: root.days.length > 2 ? root.days[2] : "";
                activated => { root.chosen("weekend"); root.dismissed(); }
            }
            SheetOption {
                icon: Icons.arrow-right;
                label: "Next week";
                value: root.days.length > 3 ? root.days[3] : "";
                activated => { root.chosen("nextweek"); root.dismissed(); }
            }
            SheetOption {
                icon: Icons.pencil;
                label: "Pick a date…";
                activated => { root.pick-date(); root.dismissed(); }
            }
            SheetOption {
                icon: Icons.cards;
                label: "Someday";
                activated => { root.chosen("someday"); root.dismissed(); }
            }
        }
    }
}

// A slot for a task: the day's events, the free stretches its length fits in, or a
// time written out.
export component SlotPicker inherits Rectangle {
    in property <string> day;
    /// "45 min needed · between your events".
    in property <string> need;
    in property <[string]> busy;
    in property <[string]> slots;
    in property <length> menu-x;
    in property <length> menu-y;
    /// For a phone's sheet: the length ("30 min"), what is taken as hours and titles,
    /// the free stretches by their start, and two other days.
    in property <string> length;
    in property <[string]> busy-times;
    in property <[string]> busy-titles;
    in property <[string]> starts;
    in property <[string]> other-days;
    callback chosen(int);
    callback typed(string);
    /// The first (0) or the second (1) of `other-days`.
    callback day-chosen(int);
    callback dismissed();

    property <string> autre;
    /// On a phone a stretch is picked first, then blocked.
    property <int> choisi: 0;
    changed starts => { root.choisi = 0; }

    TouchArea {
        width: 100%;
        height: 100%;
        clicked => { root.dismissed(); }
    }

    MenuSurface {
        dismissed => { root.dismissed(); }
        available-width: root.width;
        available-height: root.height;
        menu-x: root.menu-x;
        menu-y: root.menu-y;
        menu-width: 330px;
        menu-height: Layout.compact ? feuille.preferred-height : carte.preferred-height;

        // A phone's sheet (the mockups' T8): the hours already taken, the free ones as
        // pills, another day, and Block.
        feuille := VerticalLayout {
            visible: Layout.compact;
            padding-bottom: 6px;
            SheetTitle {
                text: "Find a slot";
                end: root.length + " · " + root.day;
            }
            HorizontalLayout {
                padding-left: 22px;
                padding-right: 22px;
                Text {
                    text: "Between your events and timed tasks";
                    font-size: 13.5px;
                    color: Tokens.text-muted;
                }
            }
            VerticalLayout {
                padding-left: 22px;
                padding-right: 22px;
                padding-top: 6px;
                for heure[i] in root.busy-times: HorizontalLayout {
                    height: 28px;
                    spacing: 10px;
                    Text {
                        width: 100px;
                        text: heure;
                        font-size: 13.5px;
                        color: Tokens.text-muted;
                        vertical-alignment: center;
                    }
                    Text {
                        text: root.busy-titles.length > i ? root.busy-titles[i] : "";
                        font-size: 13.5px;
                        color: Tokens.text-muted;
                        vertical-alignment: center;
                        overflow: elide;
                        horizontal-stretch: 1;
                    }
                }
            }
            // The free stretches by their start, five to a row.
            VerticalLayout {
                padding-left: 22px;
                padding-right: 22px;
                padding-top: 12px;
                padding-bottom: 6px;
                spacing: 8px;
                for rang in ceil(root.starts.length / 5): HorizontalLayout {
                    alignment: start;
                    height: 34px;
                    // Each pill with the gap after it; those of other rows take no room.
                    for s[i] in root.starts: Rectangle {
                        property <bool> ici: floor(i / 5) == rang;
                        visible: self.ici;
                        width: self.ici ? puce.width + 8px : 0px;
                        puce := Pill {
                            x: 0px;
                            text: s;
                            on: i == root.choisi;
                            toggled => { root.choisi = i; }
                        }
                    }
                }
                if root.starts.length == 0: Text {
                    text: "No free stretch left that day.";
                    font-size: 13.5px;
                    color: Tokens.text-muted;
                }
            }
            if root.other-days.length >= 2: HorizontalLayout {
                padding-left: 22px;
                padding-right: 22px;
                padding-top: 10px;
                padding-bottom: 6px;
                spacing: 0px;
                alignment: start;
                Text {
                    text: "Another day: ";
                    font-size: 14px;
                    color: Tokens.text-muted;
                    vertical-alignment: center;
                }
                AccentLink {
                    text: root.other-days[0];
                    label: "Find a slot on " + root.other-days[0];
                    clicked => { root.day-chosen(0); }
                }
                Text {
                    text: " · ";
                    font-size: 14px;
                    color: Tokens.text-muted;
                    vertical-alignment: center;
                }
                AccentLink {
                    text: root.other-days[1];
                    label: "Find a slot on " + root.other-days[1];
                    clicked => { root.day-chosen(1); }
                }
            }
            if root.starts.length > 0: HorizontalLayout {
                padding-left: 22px;
                padding-right: 22px;
                padding-top: 12px;
                padding-bottom: 10px;
                BlockButton {
                    text: "Block " + (root.slots.length > root.choisi ? root.slots[root.choisi] : "");
                    clicked => { root.chosen(root.choisi); }
                }
            }
        }

        carte := VerticalLayout {
            visible: !Layout.compact;
            padding: 16px;
            spacing: 8px;
            Text {
                text: "A slot on " + root.day;
                font-size: 14px;
                font-weight: 600;
                color: Tokens.text;
            }
            Text {
                text: root.need;
                font-size: 12.5px;
                color: Tokens.text-muted;
            }
            for b in root.busy: Text {
                text: b;
                font-size: 12px;
                color: Tokens.text-muted;
                overflow: elide;
            }
            // The free stretches, three to a row.
            for rang in ceil(root.slots.length / 3): HorizontalLayout {
                alignment: start;
                height: 26px;
                // Each chip with the gap after it; those of other rows take no room.
                for s[i] in root.slots: Rectangle {
                    property <bool> ici: floor(i / 3) == rang;
                    visible: self.ici;
                    width: self.ici ? 98px : 0px;
                    Rectangle {
                        x: 0;
                        width: 92px;
                        border-radius: Tokens.radius-medium;
                        border-width: 1px;
                        border-color: creneau.has-hover ? Tokens.border-strong : Tokens.border;
                        background: creneau.has-hover ? Tokens.surface-hover : Tokens.surface;

                        accessible-role: button;
                        accessible-label: s;
                        accessible-action-default => { root.chosen(i); }

                        Text {
                            text: s;
                            font-size: 12.5px;
                            color: Tokens.text;
                        }
                        creneau := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.chosen(i); }
                        }
                    }
                }
            }
            if root.slots.length == 0: Text {
                text: "No free stretch left that day.";
                font-size: 12.5px;
                color: Tokens.text-muted;
            }
            TextField {
                accessible-label: "Other time";
                placeholder-text: "Other time, e.g. 16:30";
                font-size: 12.5px;
                text <=> root.autre;
                accepted(t) => { root.typed(t); }
            }
        }
    }
}

// Right click on a list.
export component TaskListMenu inherits Rectangle {
    in property <TaskPlaceData> place;
    in property <bool> can-delete;
    in property <length> menu-x;
    in property <length> menu-y;
    callback rename();
    callback remove();
    callback dismissed();

    TouchArea {
        width: 100%;
        height: 100%;
        clicked => { root.dismissed(); }
    }

    MenuSurface {
        dismissed => { root.dismissed(); }
        available-width: root.width;
        available-height: root.height;
        menu-x: root.menu-x;
        menu-y: root.menu-y;
        menu-width: 200px;
        menu-height: entries.preferred-height + 8px;

        entries := VerticalLayout {
            padding: 4px;
            HorizontalLayout {
                padding-left: 8px;
                padding-right: 8px;
                height: 24px;
                Text {
                    text: root.place.name;
                    font-size: 12px;
                    font-weight: 600;
                    color: Tokens.text-muted;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }
            MenuSeparator {}
            MenuEntry {
                icon: Icons.pencil;
                label: "Rename…";
                activated => { root.rename(); }
            }
            if root.can-delete: MenuSeparator {}
            if root.can-delete: MenuEntry {
                icon: Icons.trash;
                label: "Delete list…";
                danger: true;
                activated => { root.remove(); }
            }
        }
    }
}

// A name for a list, new or renamed.
export component TaskListNamePanel inherits Rectangle {
    in property <bool> is-new;
    in-out property <string> name;
    in property <string> error;
    callback confirmed();
    callback dismissed();

    Modal {
        width: 100%;
        height: 100%;
        title: root.is-new ? "New list" : "Rename list";
        close-label: "Cancel";
        fit: true;
        dismissed => { root.dismissed(); }

        TextField {
            accessible-label: "List name";
            placeholder-text: "Groceries, Work, Holidays…";
            text <=> root.name;
            // Opened to type: the name is selected, the first key replaces it.
            init => {
                self.focus();
                self.select-all();
            }
            accepted => { root.confirmed(); }
        }

        if root.error != "": Text {
            text: root.error;
            font-size: 12px;
            color: Tokens.error;
            wrap: word-wrap;
        }

        ModalFooter {
            Button {
                text: root.is-new ? "Create" : "Rename";
                kind: ButtonKind.primary;
                clicked => { root.confirmed(); }
            }
        }
    }
}

// A phone's ⋯ in Tasks, as a sheet: what the page has besides its own buttons. The
// overview and a view make things (a list, a goal, a habit) and, on Today, take the
// plan back; a task copies its link or goes; a goal or a habit goes.
export component TasksMenu inherits Rectangle {
    /// "overview", "page", "task", "goal", "habit".
    in property <string> kind;
    in property <bool> can-unplan;
    /// "new-list", "new-goal", "new-habit", "unplan", "copy-link", "delete-task",
    /// "delete-goal", "delete-habit".
    callback chosen(string);
    callback dismissed();

    property <bool> creer: root.kind == "overview" || root.kind == "page";

    TouchArea {
        width: 100%;
        height: 100%;
        clicked => { root.dismissed(); }
    }

    MenuSurface {
        dismissed => { root.dismissed(); }
        available-width: root.width;
        available-height: root.height;
        menu-x: root.width - 248px;
        menu-y: 56px;
        menu-width: 240px;
        menu-height: entrees.preferred-height;

        entrees := VerticalLayout {
            padding-bottom: 4px;
            if root.kind == "page" && root.can-unplan: SheetOption {
                icon: Icons.undo;
                label: "Undo plan";
                activated => { root.chosen("unplan"); }
            }
            if root.creer: SheetOption {
                icon: Icons.list;
                label: "New list";
                activated => { root.chosen("new-list"); }
            }
            if root.creer: SheetOption {
                icon: Icons.flag;
                label: "New goal";
                activated => { root.chosen("new-goal"); }
            }
            if root.creer: SheetOption {
                icon: Icons.sprout;
                label: "New habit";
                activated => { root.chosen("new-habit"); }
            }
            if root.kind == "task": SheetOption {
                icon: Icons.link;
                label: "Copy link";
                value: "for a note";
                activated => { root.chosen("copy-link"); }
            }
            if root.kind == "task": SheetOption {
                icon: Icons.trash;
                label: "Delete task";
                danger: true;
                activated => { root.chosen("delete-task"); }
            }
            if root.kind == "goal": SheetOption {
                icon: Icons.trash;
                label: "Delete goal";
                danger: true;
                activated => { root.chosen("delete-goal"); }
            }
            if root.kind == "habit": SheetOption {
                icon: Icons.trash;
                label: "Delete habit";
                danger: true;
                activated => { root.chosen("delete-habit"); }
            }
        }
    }
}

// Deleting a list asks first: its tasks go with it.
export component TaskListDeletePanel inherits Rectangle {
    in property <string> name;
    in property <int> count;
    callback confirmed();
    callback dismissed();

    Modal {
        kind: ModalKind.question;
        width: 100%;
        height: 100%;
        title: "Delete this list?";
        close-label: "Cancel";
        fit: true;
        dismissed => { root.dismissed(); }

        Text {
            text: root.count == 0
                ? "“" + root.name + "” is empty. It will be removed."
                : "“" + root.name + "” and its " + root.count + " task(s) to do are deleted. "
                    + "This cannot be undone.";
            font-size: 13px;
            color: Tokens.text-secondary;
            wrap: word-wrap;
        }

        ModalFooter {
            Button {
                text: "Delete";
                kind: ButtonKind.danger;
                clicked => { root.confirmed(); }
            }
        }
    }
}
