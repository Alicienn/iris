import { Tokens } from "@iris/theme/tokens.slint";
import { Layout } from "@iris/theme/layout.slint";
import { Icon, Icons, IconButton } from "@iris/base/icons.slint";
import { TextField } from "@iris/controls/field.slint";
import { FormatBar } from "@iris/controls/formatbar.slint";
import { ScrollView } from "@iris/controls/scroll.slint";
import { MenuEntry, MenuHeader, MenuSeparator, MenuSurface } from "@iris/layout/menu.slint";
import { SheetCellData, SheetHeaderData, ChartCardData } from "@iris/types.slint";
import { Chart } from "@iris/controls/chart.slint";
import { Segmented } from "@iris/controls/choice.slint";
import { Button, Link, ButtonKind, ButtonSize } from "@iris/controls/button.slint";

// A spreadsheet open in Notes: its formats above, the formula bar, the grid with its
// headers, the sheets' tabs and the selection's sum below.
//
// The grid only draws what shows: the columns, rows and cells in view (and a margin)
// come from Rust each time the view moves past them. Positions are in the grid's
// content, from its top left cell.

export global SheetGrid {
    // The grid.
    in property <[SheetCellData]> cells;
    /// The cells of the frozen rows, drawn over the others while they scroll.
    in property <[SheetCellData]> pinned;
    in property <[SheetHeaderData]> columns;
    in property <[SheetHeaderData]> rows;
    in property <int> frozen-rows;
    in property <length> frozen-height;
    in property <length> content-width;
    in property <length> content-height;
    /// Asked by Rust: the view moved to `scroll-x`/`scroll-y` (content offsets, ≤ 0).
    in property <length> scroll-x;
    in property <length> scroll-y;
    in property <int> scroll-serial;
    // The selection and the active cell, in content coordinates.
    in property <length> sel-x;
    in property <length> sel-y;
    in property <length> sel-width;
    in property <length> sel-height;
    in property <length> cur-x;
    in property <length> cur-y;
    in property <length> cur-width;
    in property <length> cur-height;
    // Typing in a cell.
    in property <bool> editing;
    in property <string> edit-text;
    in property <int> edit-serial;
    in property <int> edit-cursor;
    // Above and below the grid.
    in property <string> address;
    in property <string> input;
    in property <int> input-serial;
    in property <string> status;
    in property <[string]> sheets;
    in property <int> sheet;
    /// Raised to give the keyboard to the grid.
    in-out property <int> focus-serial;
    // The active cell's format, for the toolbar.
    in property <bool> bold;
    in property <bool> italic;
    in property <bool> underline;
    in property <bool> strike;
    in property <bool> wrap;
    in property <bool> border;
    /// 0 auto, 1 left, 2 centre, 3 right.
    in property <int> align;
    /// What the number format button says.
    in property <string> number;
    in property <bool> frozen;
    /// The colours a cell's text and fill can take: the cells' own, the same in every
    /// theme, given by Rust from the list the file's colours come from.
    in property <[color]> text-colours;
    in property <[color]> fill-colours;
    // A menu over the window: "", "color", "fill", "number", "more", "sheet", "chart"
    // (a chart's tab), "chart-group" and "chart-value" (a column to add to it).
    in-out property <string> menu;
    in-out property <length> menu-x;
    in-out property <length> menu-y;

    // The workbook's charts, by name, after its sheets; the one chosen (−1: the grid
    // shows). A chart chosen shows the canvas of all of them, each on its card, the
    // settings column editing the chosen one.
    in property <[string]> charts;
    in property <int> chart: -1;
    /// The cards, in the charts' order, and the box around them all (canvas pixels).
    in property <[ChartCardData]> chart-cards;
    in property <float> chart-bounds-x;
    in property <float> chart-bounds-y;
    in property <float> chart-bounds-width;
    in property <float> chart-bounds-height;
    /// Raised by Rust: the canvas frames all the cards (a chart added), or the chosen
    /// one (its tab clicked).
    in property <int> chart-fit-serial;
    in property <int> chart-focus-serial;
    /// The settings column folded away; remembered in the settings.
    in-out property <bool> chart-panel-folded;
    callback chart-panel-toggled(bool);
    /// A card dropped elsewhere on the canvas: its chart, its new top left corner.
    callback chart-moved(int, float, float);
    in property <int> chart-kind;
    /// The columns it reads: of categories, then of numbers ("B · Status").
    in property <[string]> chart-groups;
    in property <[string]> chart-values;
    /// The kind takes several columns of categories (a flow), several series.
    in property <bool> chart-many-groups;
    in property <bool> chart-many-values;
    /// The table's columns, offered to add.
    in property <[string]> chart-columns;
    /// Where its table starts ("Headers in row 1").
    in property <string> chart-source;
    callback chart-chosen(int);

    /// The view: its offset in the content and its size.
    callback viewport(length, length, length, length);
    /// A press in the grid (content coordinates), Shift held or not.
    callback pressed(length, length, bool);
    callback dragged(length, length);
    callback double-clicked(length, length);
    /// A header pressed: 0 a column, 1 a row; its index; Shift held.
    callback header-pressed(int, int, bool);
    /// A column (0) or row (1) given a new size.
    callback header-resized(int, int, length);
    /// A key while the grid has the keyboard: its text, Shift, Ctrl (not AltGr).
    callback key(string, bool, bool) -> bool;
    /// Typing done: the text, and where to go — 0 stay, 1 down, 2 right, 3 up, 4 left, −1 cancelled.
    callback edit-done(string, int);
    callback edit-changed(string);
    /// The formula bar's text accepted.
    callback input-done(string);
    callback action(string);
    callback sheet-chosen(int);
}

// A cell: its colour, its text where its format puts it, a line under or through it.
component SheetCell inherits Rectangle {
    in property <SheetCellData> item;
    x: root.item.x;
    y: root.item.y;
    width: root.item.width;
    height: root.item.height;
    background: root.item.has-fill ? root.item.fill : transparent;
    border-width: root.item.border ? 1px : 0px;
    border-color: Tokens.text-muted;

    t := Text {
        x: 5px;
        width: parent.width - 10px;
        height: parent.height;
        text: root.item.text;
        color: root.item.color;
        font-size: 13px;
        font-weight: root.item.bold ? 700 : 400;
        font-italic: root.item.italic;
        horizontal-alignment: root.item.align == 2 ? TextHorizontalAlignment.right
            : root.item.align == 1 ? TextHorizontalAlignment.center : TextHorizontalAlignment.left;
        vertical-alignment: TextVerticalAlignment.center;
        wrap: root.item.wrap ? TextWrap.word-wrap : TextWrap.no-wrap;
        overflow: TextOverflow.elide;
    }
    property <length> largeur: min(t.preferred-width, t.width);
    property <length> debut: root.item.align == 2 ? t.x + t.width - root.largeur
        : root.item.align == 1 ? t.x + (t.width - root.largeur) / 2 : t.x;
    Rectangle {
        visible: root.item.underline && !root.item.wrap;
        x: root.debut;
        y: parent.height / 2 + 8px;
        width: root.largeur;
        height: 1px;
        background: root.item.color;
    }
    Rectangle {
        visible: root.item.strike && !root.item.wrap;
        x: root.debut;
        y: parent.height / 2;
        width: root.largeur;
        height: 1px;
        background: root.item.color;
    }
}

// A button of the toolbar that says a word rather than shows an icon.
component WordButton inherits Rectangle {
    in property <string> text;
    in property <string> label;
    in property <bool> active;
    callback clicked();
    width: max(30px, mot.preferred-width + 16px);
    height: 28px;
    border-radius: Tokens.radius-small;
    background: zone.pressed ? Tokens.surface-hover.darker(0.05)
        : zone.has-hover || root.active ? Tokens.surface-hover : transparent;
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { root.clicked(); }
    mot := Text {
        text: root.text;
        font-size: 12.5px;
        color: Tokens.text-secondary;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    zone := TouchArea {
        clicked => { root.clicked(); }
    }
}

// A column a chart reads, in its settings: its name, and a cross to take it away.
component ChartColumn inherits Rectangle {
    in property <string> text;
    in property <string> remove-label;
    callback removed();
    height: 30px;
    border-radius: Tokens.radius-small;
    background: Tokens.surface-low;
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 3px;
        spacing: 4px;
        Text {
            text: root.text;
            font-size: 12.5px;
            color: Tokens.text;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }
        IconButton {
            y: (parent.height - self.height) / 2;
            icon: Icons.window-close;
            label: root.remove-label;
            button-size: 22px;
            icon-size: 10px;
            clicked => { root.removed(); }
        }
    }
}

// What a chart shows: its kind, the columns it groups by, the numbers it adds up, and
// the way into a note.
component ChartSettings inherits VerticalLayout {
    callback menu(string, length, length);
    spacing: 8px;
    alignment: start;

    Text {
        text: SheetGrid.chart >= 0 && SheetGrid.chart < SheetGrid.charts.length ? SheetGrid.charts[SheetGrid.chart] : "";
        font-family: Tokens.font-display;
        font-size: 16px;
        font-weight: 600;
        color: Tokens.text;
        overflow: elide;
    }
    Rectangle { height: 2px; }
    Text {
        text: "Kind";
        font-size: 13px;
        font-weight: 600;
        color: Tokens.text;
    }
    // Five words in a column 264 pixels wide: the segments' room narrowed so "Line"
    // stays on the plate, even with the text made larger.
    Segmented {
        options: ["Flow", "Bars", "Columns", "Donut", "Line"];
        selected: SheetGrid.chart-kind;
        segment-padding: 12px;
        chosen(i) => { SheetGrid.action("chart-kind:" + i); }
    }

    Rectangle { height: 6px; }
    Text {
        text: SheetGrid.chart-many-groups ? "Steps, in order" : "Categories";
        font-size: 13px;
        font-weight: 600;
        color: Tokens.text;
    }
    for g[i] in SheetGrid.chart-groups: ChartColumn {
        text: g;
        remove-label: "Take this column away";
        removed => { SheetGrid.action("chart-group-remove:" + i); }
    }
    HorizontalLayout {
        alignment: start;
        Link {
            text: SheetGrid.chart-many-groups || SheetGrid.chart-groups.length == 0 ? "Add a column" : "Another column";
            label: "Pick a column of categories";
            clicked => { root.menu("chart-group", self.absolute-position.x, self.absolute-position.y + self.height + 2px); }
        }
    }

    Rectangle { height: 6px; }
    Text {
        text: "Values";
        font-size: 13px;
        font-weight: 600;
        color: Tokens.text;
    }
    if SheetGrid.chart-values.length == 0: Text {
        text: "Each row counts as one.";
        font-size: 12.5px;
        color: Tokens.text-muted;
        wrap: word-wrap;
    }
    for v[i] in SheetGrid.chart-values: ChartColumn {
        text: v;
        remove-label: "Count the rows instead";
        removed => { SheetGrid.action("chart-value-remove:" + i); }
    }
    HorizontalLayout {
        alignment: start;
        Link {
            text: SheetGrid.chart-many-values || SheetGrid.chart-values.length == 0 ? "Add a column of numbers" : "Another column";
            label: "Pick a column of numbers to add up";
            clicked => { root.menu("chart-value", self.absolute-position.x, self.absolute-position.y + self.height + 2px); }
        }
    }
    Text {
        text: SheetGrid.chart-source;
        font-size: 12px;
        color: Tokens.text-muted;
        wrap: word-wrap;
    }

    Rectangle { height: 10px; }
    Button {
        text: "Copy for a note";
        icon: Icons.copy;
        kind: ButtonKind.primary;
        label: "Copy what shows this chart in a note";
        clicked => { SheetGrid.action("chart-copy"); }
    }
    Text {
        text: "Paste it in any note: the chart shows there, and follows the sheet.";
        font-size: 12px;
        color: Tokens.text-muted;
        wrap: word-wrap;
    }
    Rectangle { height: 4px; }
    HorizontalLayout {
        alignment: start;
        spacing: 6px;
        Button {
            text: "Rename…";
            size: ButtonSize.sm;
            clicked => { SheetGrid.action("chart-rename"); }
        }
        Button {
            text: "Delete";
            size: ButtonSize.sm;
            kind: ButtonKind.ghost;
            clicked => { SheetGrid.action("chart-delete"); }
        }
    }
}

component Separator inherits Rectangle {
    width: 9px;
    Rectangle {
        x: 4px;
        y: 7px;
        width: 1px;
        height: parent.height - 14px;
        background: Tokens.border;
    }
}

// A chart's card on the canvas: its name, its drawing, a frame in the accent when it is
// the chosen one. Carried, it moves; dropped, Rust keeps its place. Its measures are in
// the canvas's pixels at 100 % and scaled by the zoom: 24 around, a title 28 high, 12
// under it (Rust lays the cards out with the same, `CARTE_*` in notes/sheet.rs).
component ChartCard inherits Rectangle {
    in property <ChartCardData> card;
    in property <float> zoom: 1;
    /// Where it stands at its place, in the canvas (before it is carried).
    in property <length> place-x;
    in property <length> place-y;
    /// The canvas's size: the part of the drawing that shows.
    in property <length> room-width;
    in property <length> room-height;
    callback menu(length, length);
    /// The wheel over it: the event and where, in the canvas.
    callback scrolled(PointerScrollEvent, length, length);

    property <length> u: root.zoom * 1px;
    property <bool> chosen: root.card.index == SheetGrid.chart;
    property <length> drag-x;
    property <length> drag-y;
    property <bool> carried;

    x: root.place-x + root.drag-x;
    y: root.place-y + root.drag-y;
    width: root.card.width * root.u;
    height: root.card.height * root.u;
    border-radius: max(2px, 12 * root.u);
    background: Tokens.surface;
    border-width: root.chosen ? 2px : 1px;
    border-color: root.chosen ? Tokens.accent : Tokens.border;
    accessible-role: button;
    accessible-label: root.card.name;
    accessible-item-selected: root.chosen;
    accessible-action-default => { SheetGrid.action("chart-select:" + root.card.index); }

    Text {
        x: 24 * root.u;
        y: 24 * root.u;
        width: parent.width - 48 * root.u;
        height: 28 * root.u;
        text: root.card.name;
        font-family: Tokens.font-display;
        font-size: 18 * root.u;
        font-weight: 600;
        color: Tokens.text;
        vertical-alignment: center;
        overflow: elide;
    }
    if root.card.data.message != "": Text {
        x: 24 * root.u;
        y: 64 * root.u;
        width: parent.width - 48 * root.u;
        text: root.card.data.message;
        font-size: 13 * root.u;
        color: Tokens.text-muted;
        wrap: word-wrap;
    }
    Chart {
        x: 24 * root.u;
        y: 64 * root.u;
        width: parent.width - 48 * root.u;
        data: root.card.data;
        min-font-size: 0px;
        // Only what shows in the canvas is drawn.
        view-x: -(root.x + self.x);
        view-y: -(root.y + self.y);
        view-width: root.room-width;
        view-height: root.room-height;
    }

    zone := TouchArea {
        mouse-cursor: root.carried ? MouseCursor.grabbing : MouseCursor.default;
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down) {
                root.drag-x = 0px;
                root.drag-y = 0px;
                root.carried = false;
                if (!root.chosen) {
                    SheetGrid.action("chart-select:" + root.card.index);
                }
                if (event.button == PointerEventButton.right) {
                    root.menu(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                } else {
                    SheetGrid.focus-serial += 1;
                }
            }
            if (event.kind == PointerEventKind.up && event.button == PointerEventButton.left) {
                let nx = root.card.x + root.drag-x / root.u;
                let ny = root.card.y + root.drag-y / root.u;
                let posee = root.carried;
                root.drag-x = 0px;
                root.drag-y = 0px;
                root.carried = false;
                if (posee) {
                    SheetGrid.chart-moved(root.card.index, nx, ny);
                }
            }
        }
        moved => {
            if (self.pressed) {
                // The card follows the pointer: it moves by what the pointer went
                // from where it was pressed in it.
                root.drag-x += self.mouse-x - self.pressed-x;
                root.drag-y += self.mouse-y - self.pressed-y;
                if (abs(root.drag-x) > 4px || abs(root.drag-y) > 4px) {
                    root.carried = true;
                }
            }
        }
        double-clicked => { SheetGrid.action("chart-rename"); }
        scroll-event(event) => {
            root.scrolled(event, root.x + self.mouse-x, root.y + self.mouse-y);
            accept
        }
    }
}

// The charts' canvas: every chart of the workbook on its card, as far as one likes in
// every direction. Dragging the background moves the view, the wheel scrolls it,
// Ctrl and the wheel (a touchpad's pinch) zoom around the pointer; the buttons at the
// bottom right zoom, frame everything, and add a chart. Nothing is an image: zooming
// scales the drawings themselves, so they stay sharp.
component ChartCanvas inherits Rectangle {
    callback menu(string, length, length);
    background: Tokens.surface-low;
    clip: true;

    /// 1 is 100 %: from 10 % to 800 %.
    in-out property <float> zoom: 1;
    /// Where the canvas's origin is, in this view.
    in-out property <length> pan-x;
    in-out property <length> pan-y;
    // The view moved by hand: a new size no longer frames the cards again.
    property <bool> vu;
    property <length> depart-x;
    property <length> depart-y;
    // Kept clear around what is framed; the buttons' strip at the foot besides.
    property <length> marge: Layout.compact ? 16px : 48px;
    property <length> pied: 44px;

    function cadrer() {
        let bw = SheetGrid.chart-bounds-width;
        let bh = SheetGrid.chart-bounds-height;
        if (bw <= 0 || bh <= 0 || root.width <= 0px || root.height <= 0px) {
            return;
        }
        let z = clamp(min((root.width - 2 * root.marge) / 1px / bw,
            (root.height - 2 * root.marge - root.pied) / 1px / bh), 0.1, 1.5);
        root.zoom = z;
        root.pan-x = (root.width - bw * z * 1px) / 2 - SheetGrid.chart-bounds-x * z * 1px;
        root.pan-y = (root.height - root.pied - bh * z * 1px) / 2 - SheetGrid.chart-bounds-y * z * 1px;
    }

    // Card `k` brought to the middle, made smaller if it does not fit.
    function viser(k: int) {
        if (k < 0 || k >= SheetGrid.chart-cards.length || root.width <= 0px) {
            return;
        }
        let c = SheetGrid.chart-cards[k];
        if (c.width <= 0 || c.height <= 0) {
            return;
        }
        let z = clamp(min(root.zoom, min((root.width - 2 * root.marge) / 1px / c.width,
            (root.height - 2 * root.marge - root.pied) / 1px / c.height)), 0.1, 8);
        root.zoom = z;
        root.pan-x = (root.width - c.width * z * 1px) / 2 - c.x * z * 1px;
        root.pan-y = (root.height - root.pied - c.height * z * 1px) / 2 - c.y * z * 1px;
        root.vu = true;
    }

    // Zoomed to `z`, the point (px, py) of the view staying where it is.
    function zoomer(z: float, px: length, py: length) {
        let n = clamp(z, 0.1, 8);
        root.pan-x = px - (px - root.pan-x) * (n / root.zoom);
        root.pan-y = py - (py - root.pan-y) * (n / root.zoom);
        root.zoom = n;
        root.vu = true;
    }

    function molette(event: PointerScrollEvent, px: length, py: length) {
        if (event.modifiers.control) {
            root.zoomer(root.zoom * pow(1.0025, event.delta-y / 1px), px, py);
        } else if (event.modifiers.shift && event.delta-x == 0px) {
            root.pan-x += event.delta-y;
            root.vu = true;
        } else {
            root.pan-x += event.delta-x;
            root.pan-y += event.delta-y;
            root.vu = true;
        }
    }

    init => { root.cadrer(); }
    changed width => {
        if (!root.vu) {
            root.cadrer();
        }
    }
    changed height => {
        if (!root.vu) {
            root.cadrer();
        }
    }
    property <int> cadrage: SheetGrid.chart-fit-serial;
    changed cadrage => {
        root.vu = false;
        root.cadrer();
    }
    property <int> visee: SheetGrid.chart-focus-serial;
    changed visee => { root.viser(SheetGrid.chart); }

    // The background: carried, the view follows. The cards lie on it and hand it the
    // wheel turned over them, with where the pointer is.
    fond := TouchArea {
        mouse-cursor: self.pressed ? MouseCursor.grabbing : MouseCursor.default;
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                root.depart-x = root.pan-x;
                root.depart-y = root.pan-y;
                SheetGrid.focus-serial += 1;
            }
        }
        moved => {
            if (self.pressed) {
                root.pan-x = root.depart-x + self.mouse-x - self.pressed-x;
                root.pan-y = root.depart-y + self.mouse-y - self.pressed-y;
                root.vu = true;
            }
        }
        scroll-event(event) => {
            root.molette(event, self.mouse-x, self.mouse-y);
            accept
        }

        for c in SheetGrid.chart-cards: ChartCard {
            card: c;
            zoom: root.zoom;
            place-x: root.pan-x + c.x * root.zoom * 1px;
            place-y: root.pan-y + c.y * root.zoom * 1px;
            room-width: root.width;
            room-height: root.height;
            menu(x, y) => { root.menu("chart", x, y); }
            scrolled(event, x, y) => { root.molette(event, x, y); }
        }
    }

    // The settings column folded or not: its button stays at the top right.
    Rectangle {
        x: parent.width - self.width - 12px;
        y: 12px;
        width: 36px;
        height: 36px;
        border-radius: Tokens.radius-medium;
        background: Tokens.surface;
        border-width: 1px;
        border-color: Tokens.border;
        drop-shadow-blur: Tokens.shadow-card-blur;
        drop-shadow-offset-y: Tokens.shadow-card-y;
        drop-shadow-color: Tokens.shadow-card;
        IconButton {
            x: 4px;
            y: 4px;
            icon: Icons.sidebar;
            label: SheetGrid.chart-panel-folded ? "Show the chart's settings" : "Hide the chart's settings";
            active: !SheetGrid.chart-panel-folded;
            clicked => {
                SheetGrid.chart-panel-folded = !SheetGrid.chart-panel-folded;
                SheetGrid.chart-panel-toggled(SheetGrid.chart-panel-folded);
                SheetGrid.focus-serial += 1;
            }
        }
    }

    // The view's buttons, at the bottom right: −, the zoom (100 % when clicked), +,
    // everything framed, a chart added.
    Rectangle {
        x: parent.width - self.width - 12px;
        y: parent.height - self.height - 12px;
        width: boutons.preferred-width;
        height: 36px;
        border-radius: Tokens.radius-medium;
        background: Tokens.surface;
        border-width: 1px;
        border-color: Tokens.border;
        drop-shadow-blur: Tokens.shadow-card-blur;
        drop-shadow-offset-y: Tokens.shadow-card-y;
        drop-shadow-color: Tokens.shadow-card;
        boutons := HorizontalLayout {
            x: 0px;
            width: self.preferred-width;
            height: parent.height;
            padding-left: 4px;
            padding-right: 4px;
            spacing: 1px;
            IconButton {
                y: (parent.height - self.height) / 2;
                icon: Icons.minus;
                label: "Zoom out";
                enabled: root.zoom > 0.1;
                clicked => {
                    root.zoomer(root.zoom / 1.25, root.width / 2, (root.height - root.pied) / 2);
                    SheetGrid.focus-serial += 1;
                }
            }
            WordButton {
                y: (parent.height - self.height) / 2;
                width: 52px;
                text: "\{round(root.zoom * 100)} %";
                label: "Zoom to 100 %";
                clicked => {
                    root.zoomer(1, root.width / 2, (root.height - root.pied) / 2);
                    SheetGrid.focus-serial += 1;
                }
            }
            IconButton {
                y: (parent.height - self.height) / 2;
                icon: Icons.plus;
                label: "Zoom in";
                enabled: root.zoom < 8;
                clicked => {
                    root.zoomer(root.zoom * 1.25, root.width / 2, (root.height - root.pied) / 2);
                    SheetGrid.focus-serial += 1;
                }
            }
            Separator { }
            IconButton {
                y: (parent.height - self.height) / 2;
                icon: Icons.expand;
                label: "Fit every chart in view";
                clicked => {
                    root.vu = false;
                    root.cadrer();
                    SheetGrid.focus-serial += 1;
                }
            }
            IconButton {
                y: (parent.height - self.height) / 2;
                icon: Icons.chart;
                label: "Add a chart";
                clicked => {
                    SheetGrid.action("chart-add");
                    SheetGrid.focus-serial += 1;
                }
            }
        }
    }
}

// The charts shown instead of the grid: the canvas, and the chosen chart's settings in
// a column docked on the right (at the foot on a phone), which folds away.
component ChartPane inherits Rectangle {
    callback menu(string, length, length);
    background: Tokens.surface;

    property <bool> colonne: !SheetGrid.chart-panel-folded;
    property <length> large: root.colonne && !Layout.compact ? 300px : 0px;
    property <length> bas: root.colonne && Layout.compact ? min(340px, root.height * 0.45) : 0px;

    ChartCanvas {
        x: 0px;
        y: 0px;
        width: root.width - (root.large > 0px ? root.large + 1px : 0px);
        height: root.height - (root.bas > 0px ? root.bas + 1px : 0px);
        menu(k, x, y) => { root.menu(k, x, y); }
    }
    // The hairline beside the column (above it on a phone).
    Rectangle {
        visible: root.colonne;
        x: Layout.compact ? 0px : root.width - root.large - 1px;
        y: Layout.compact ? root.height - root.bas - 1px : 0px;
        width: Layout.compact ? root.width : 1px;
        height: Layout.compact ? 1px : root.height;
        background: Tokens.border;
    }
    if root.colonne: Rectangle {
        x: Layout.compact ? 0px : root.width - root.large;
        y: Layout.compact ? root.height - root.bas : 0px;
        width: Layout.compact ? root.width : root.large;
        height: Layout.compact ? root.bas : root.height;
        background: Tokens.surface;
        defile := ScrollView {
            content-width: self.visible-width;
            content-height: page.preferred-height;
            page := VerticalLayout {
                width: defile.visible-width;
                padding: Layout.compact ? 16px : 18px;
                ChartSettings {
                    menu(k, x, y) => { root.menu(k, x, y); }
                }
            }
        }
    }
}

export component SheetView inherits Rectangle {
    background: Tokens.surface;
    // A phone's row numbers take 34 pixels (the mockups' N5); its headers stand on the
    // grouped grey.
    property <length> entete-w: Layout.compact ? 34px : 46px;
    property <length> entete-h: 24px;
    property <brush> entete-fond: Layout.compact ? Tokens.group : Tokens.surface-low;
    property <int> demande: SheetGrid.focus-serial;
    changed demande => { touches.focus(); }

    function menu(kind: string, x: length, y: length) {
        SheetGrid.menu-x = x;
        SheetGrid.menu-y = y;
        SheetGrid.menu = kind;
    }

    // The keyboard of the grid: Rust decides what each key does, and a character
    // typed starts writing in the cell.
    touches := FocusScope {
        width: 0px;
        height: 0px;
        init => { self.focus(); }
        key-pressed(event) => {
            // A menu open owns the keyboard: Escape closes it, nothing else passes.
            if (SheetGrid.menu != "") {
                if (event.text == Key.Escape) {
                    SheetGrid.menu = "";
                }
                return accept;
            }
            if (event.text == Key.Shift || event.text == Key.Control || event.text == Key.Alt
                || event.text == Key.AltGr || event.text == Key.Meta) {
                return reject;
            }
            let ctrl = event.modifiers.control && !event.modifiers.alt;
            if (SheetGrid.key(event.text, event.modifiers.shift, ctrl)) {
                return accept;
            }
            reject
        }
    }

    VerticalLayout {
        // The formats of the selection. A phone has its keys over the keyboard
        // instead, at the foot, and the rest in the top bar's menu.
        if !Layout.compact && SheetGrid.chart < 0: HorizontalLayout {
            height: 40px;
            padding-left: 10px;
            padding-right: 10px;
            spacing: 1px;
            alignment: start;
            IconButton {
                y: (parent.height - self.height) / 2;
                icon: Icons.undo;
                label: "Undo";
                shortcut: "Ctrl+Z";
                clicked => { SheetGrid.action("undo"); touches.focus(); }
            }
            IconButton {
                y: (parent.height - self.height) / 2;
                icon: Icons.redo;
                label: "Redo";
                shortcut: "Ctrl+Y";
                clicked => { SheetGrid.action("redo"); touches.focus(); }
            }
            Separator { }
            nombre := WordButton {
                y: (parent.height - self.height) / 2;
                text: SheetGrid.number + "  ▾";
                label: "Number format";
                clicked => { root.menu("number", self.absolute-position.x, self.absolute-position.y + self.height + 2px); }
            }
            WordButton {
                y: (parent.height - self.height) / 2;
                text: ".0−";
                label: "Fewer decimals";
                clicked => { SheetGrid.action("decimals-"); touches.focus(); }
            }
            WordButton {
                y: (parent.height - self.height) / 2;
                text: ".00+";
                label: "More decimals";
                clicked => { SheetGrid.action("decimals+"); touches.focus(); }
            }
            Separator { }
            IconButton {
                y: (parent.height - self.height) / 2;
                icon: Icons.bold;
                label: "Bold";
                shortcut: "Ctrl+B";
                active: SheetGrid.bold;
                clicked => { SheetGrid.action("bold"); touches.focus(); }
            }
            IconButton {
                y: (parent.height - self.height) / 2;
                icon: Icons.italic;
                label: "Italic";
                shortcut: "Ctrl+I";
                active: SheetGrid.italic;
                clicked => { SheetGrid.action("italic"); touches.focus(); }
            }
            IconButton {
                y: (parent.height - self.height) / 2;
                icon: Icons.underline;
                label: "Underline";
                shortcut: "Ctrl+U";
                active: SheetGrid.underline;
                clicked => { SheetGrid.action("underline"); touches.focus(); }
            }
            IconButton {
                y: (parent.height - self.height) / 2;
                icon: Icons.strikethrough;
                label: "Strikethrough";
                shortcut: "Ctrl+5";
                active: SheetGrid.strike;
                clicked => { SheetGrid.action("strike"); touches.focus(); }
            }
            IconButton {
                y: (parent.height - self.height) / 2;
                icon: Icons.text-colour;
                label: "Text colour";
                clicked => { root.menu("color", self.absolute-position.x, self.absolute-position.y + self.height + 2px); }
            }
            IconButton {
                y: (parent.height - self.height) / 2;
                icon: Icons.fill;
                label: "Fill colour";
                clicked => { root.menu("fill", self.absolute-position.x, self.absolute-position.y + self.height + 2px); }
            }
            IconButton {
                y: (parent.height - self.height) / 2;
                icon: Icons.border;
                label: "Borders";
                active: SheetGrid.border;
                clicked => { SheetGrid.action("border"); touches.focus(); }
            }
            Separator { }
            IconButton {
                y: (parent.height - self.height) / 2;
                icon: Icons.align-left;
                label: "Align left";
                active: SheetGrid.align == 1;
                clicked => { SheetGrid.action("align-left"); touches.focus(); }
            }
            IconButton {
                y: (parent.height - self.height) / 2;
                icon: Icons.align-center;
                label: "Centre";
                active: SheetGrid.align == 2;
                clicked => { SheetGrid.action("align-center"); touches.focus(); }
            }
            IconButton {
                y: (parent.height - self.height) / 2;
                icon: Icons.align-right;
                label: "Align right";
                active: SheetGrid.align == 3;
                clicked => { SheetGrid.action("align-right"); touches.focus(); }
            }
            IconButton {
                y: (parent.height - self.height) / 2;
                icon: Icons.wrap;
                label: "Wrap text";
                active: SheetGrid.wrap;
                clicked => { SheetGrid.action("wrap"); touches.focus(); }
            }
            Separator { }
            IconButton {
                y: (parent.height - self.height) / 2;
                icon: Icons.sort;
                label: "Sort A to Z by this column";
                clicked => { SheetGrid.action("sort-asc"); touches.focus(); }
            }
            IconButton {
                y: (parent.height - self.height) / 2;
                icon: Icons.freeze;
                label: SheetGrid.frozen ? "Unfreeze the top rows" : "Freeze the rows above the cursor";
                active: SheetGrid.frozen;
                clicked => { SheetGrid.action("freeze"); touches.focus(); }
            }
            IconButton {
                y: (parent.height - self.height) / 2;
                icon: Icons.chart;
                label: "Chart from the selection";
                clicked => { SheetGrid.action("chart-new"); touches.focus(); }
            }
            IconButton {
                y: (parent.height - self.height) / 2;
                icon: Icons.more;
                label: "Rows, columns, export";
                clicked => { root.menu("more", self.absolute-position.x, self.absolute-position.y + self.height + 2px); }
            }
        }
        if !Layout.compact && SheetGrid.chart < 0: Rectangle {
            height: 1px;
            background: Tokens.border;
        }

        // The formula bar: the address, and what the active cell holds. On a phone it
        // heads the page: the address small and grey, the field taller on its well. A
        // chart shown takes the bar's room and the grid's.
        HorizontalLayout {
            visible: SheetGrid.chart < 0;
            height: SheetGrid.chart >= 0 ? 0px : Layout.compact ? 52px : 36px;
            padding-left: Layout.compact ? 14px : 10px;
            padding-right: Layout.compact ? 14px : 10px;
            padding-top: Layout.compact ? 6px : 4px;
            padding-bottom: Layout.compact ? 8px : 4px;
            spacing: Layout.compact ? 10px : 8px;
            Rectangle {
                width: Layout.compact ? 30px : 84px;
                border-radius: Tokens.radius-small;
                background: Layout.compact ? transparent : Tokens.surface-low;
                Text {
                    text: SheetGrid.address;
                    font-size: Layout.compact ? 13px : 12.5px;
                    font-weight: Layout.compact ? 700 : 600;
                    color: Layout.compact ? Tokens.text-muted : Tokens.text-secondary;
                    horizontal-alignment: Layout.compact ? TextHorizontalAlignment.left : TextHorizontalAlignment.center;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }
            if !Layout.compact: Icon {
                cross-axis-self-alignment: center;
                data: Icons.function;
                size: 16px;
                tint: Tokens.text-muted;
            }
            barre := TextField {
                horizontal-stretch: 1;
                font-size: Layout.compact ? 15px : Tokens.size-body;
                border-radius: Layout.compact ? 10px : Tokens.radius-small;
                placeholder-text: "A value, or = and a formula";
                property <int> demande: SheetGrid.input-serial;
                changed demande => { self.text = SheetGrid.input; }
                text: SheetGrid.input;
                accepted(t) => {
                    SheetGrid.input-done(t);
                    touches.focus();
                }
            }
        }
        Rectangle {
            visible: SheetGrid.chart < 0;
            height: SheetGrid.chart >= 0 ? 0px : 1px;
            background: Tokens.border;
        }

        if SheetGrid.chart >= 0: ChartPane {
            vertical-stretch: 1;
            menu(k, x, y) => { root.menu(k, x, y); }
        }

        // The grid.
        grille := Rectangle {
            visible: SheetGrid.chart < 0;
            vertical-stretch: SheetGrid.chart < 0 ? 1 : 0;
            max-height: SheetGrid.chart < 0 ? 100000px : 0px;
            clip: true;

            // The corner: everything selected.
            Rectangle {
                x: 0px;
                y: 0px;
                width: root.entete-w;
                height: root.entete-h;
                background: root.entete-fond;
                Rectangle {
                    x: parent.width - 1px;
                    width: 1px;
                    background: Tokens.border;
                }
                Rectangle {
                    y: parent.height - 1px;
                    height: 1px;
                    background: Tokens.border;
                }
                TouchArea {
                    clicked => {
                        SheetGrid.action("select-all");
                        touches.focus();
                    }
                }
            }

            // The columns' letters.
            Rectangle {
                x: root.entete-w;
                y: 0px;
                width: parent.width - root.entete-w;
                height: root.entete-h;
                clip: true;
                background: root.entete-fond;
                for c in SheetGrid.columns: Rectangle {
                    x: c.pos + f.content-x;
                    width: c.size;
                    height: parent.height;
                    background: c.selected ? Tokens.accent.transparentize(0.86) : transparent;
                    Text {
                        text: c.label;
                        font-size: 11.5px;
                        font-weight: c.selected ? 600 : 400;
                        color: c.selected ? Tokens.accent : Tokens.text-muted;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    Rectangle {
                        x: parent.width - 1px;
                        width: 1px;
                        background: Tokens.border;
                    }
                    TouchArea {
                        width: parent.width - 5px;
                        x: 0px;
                        pointer-event(event) => {
                            if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                                SheetGrid.header-pressed(0, c.index, event.modifiers.shift);
                                touches.focus();
                            }
                        }
                    }
                    // Its right edge, carried: its width.
                    TouchArea {
                        x: parent.width - 5px;
                        width: 8px;
                        mouse-cursor: MouseCursor.col-resize;
                        pointer-event(event) => {
                            if (event.button == PointerEventButton.left && event.kind == PointerEventKind.up) {
                                SheetGrid.header-resized(0, c.index, max(24px, c.size + self.mouse-x - self.pressed-x));
                                touches.focus();
                            }
                        }
                    }
                }
                Rectangle {
                    y: parent.height - 1px;
                    height: 1px;
                    background: Tokens.border;
                }
            }

            // The rows' numbers; the frozen ones stay.
            Rectangle {
                x: 0px;
                y: root.entete-h;
                width: root.entete-w;
                height: parent.height - root.entete-h;
                clip: true;
                background: root.entete-fond;
                for r in SheetGrid.rows: Rectangle {
                    y: r.index < SheetGrid.frozen-rows ? r.pos : r.pos + f.content-y;
                    visible: r.index < SheetGrid.frozen-rows || r.pos + f.content-y >= SheetGrid.frozen-height - r.size;
                    height: r.size;
                    width: parent.width;
                    background: r.selected ? Tokens.accent.transparentize(0.86) : root.entete-fond;
                    Text {
                        text: r.label;
                        font-size: 11.5px;
                        font-weight: r.selected ? 600 : 400;
                        color: r.selected ? Tokens.accent : Tokens.text-muted;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    Rectangle {
                        y: parent.height - 1px;
                        height: 1px;
                        background: Tokens.border;
                    }
                    TouchArea {
                        height: parent.height - 4px;
                        y: 0px;
                        pointer-event(event) => {
                            if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                                SheetGrid.header-pressed(1, r.index, event.modifiers.shift);
                                touches.focus();
                            }
                        }
                    }
                    TouchArea {
                        y: parent.height - 4px;
                        height: 7px;
                        mouse-cursor: MouseCursor.row-resize;
                        pointer-event(event) => {
                            if (event.button == PointerEventButton.left && event.kind == PointerEventKind.up) {
                                SheetGrid.header-resized(1, r.index, max(16px, r.size + self.mouse-y - self.pressed-y));
                                touches.focus();
                            }
                        }
                    }
                }
                Rectangle {
                    x: parent.width - 1px;
                    width: 1px;
                    background: Tokens.border;
                }
            }

            corps := Rectangle {
                x: root.entete-w;
                y: root.entete-h;
                width: parent.width - root.entete-w;
                height: parent.height - root.entete-h;
                clip: true;

                f := Flickable {
                    width: parent.width;
                    height: parent.height;
                    mouse-drag-pan-enabled: false;
                    content-width: max(self.width, SheetGrid.content-width);
                    content-height: max(self.height, SheetGrid.content-height);
                    property <int> demande: SheetGrid.scroll-serial;
                    changed demande => {
                        self.content-x = SheetGrid.scroll-x;
                        self.content-y = SheetGrid.scroll-y;
                    }
                    changed content-x => { SheetGrid.viewport(-self.content-x, -self.content-y, self.width, self.height); }
                    changed content-y => { SheetGrid.viewport(-self.content-x, -self.content-y, self.width, self.height); }
                    changed width => { SheetGrid.viewport(-self.content-x, -self.content-y, self.width, self.height); }
                    changed height => { SheetGrid.viewport(-self.content-x, -self.content-y, self.width, self.height); }
                    init => { SheetGrid.viewport(-self.content-x, -self.content-y, self.width, self.height); }

                    // The lines between cells, across what shows.
                    for c in SheetGrid.columns: Rectangle {
                        x: c.pos + c.size - 1px;
                        y: -f.content-y;
                        width: 1px;
                        height: f.height;
                        background: Tokens.border.transparentize(0.4);
                    }
                    for r in SheetGrid.rows: Rectangle {
                        x: -f.content-x;
                        y: r.pos + r.size - 1px;
                        width: f.width;
                        height: 1px;
                        background: Tokens.border.transparentize(0.4);
                    }
                    for c in SheetGrid.cells: SheetCell {
                        item: c;
                    }
                    // The selection, and the cell typed in.
                    Rectangle {
                        x: SheetGrid.sel-x;
                        y: SheetGrid.sel-y;
                        width: SheetGrid.sel-width;
                        height: SheetGrid.sel-height;
                        background: Tokens.accent.transparentize(0.9);
                        border-width: 1px;
                        border-color: Tokens.accent.transparentize(0.4);
                    }
                    Rectangle {
                        x: SheetGrid.cur-x - 1px;
                        y: SheetGrid.cur-y - 1px;
                        width: SheetGrid.cur-width + 1px;
                        height: SheetGrid.cur-height + 1px;
                        border-width: 2px;
                        border-color: Tokens.accent;
                    }
                    souris := TouchArea {
                        x: 0px;
                        y: 0px;
                        width: f.content-width;
                        height: f.content-height;
                        pointer-event(event) => {
                            if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                                SheetGrid.pressed(self.mouse-x, self.mouse-y, event.modifiers.shift);
                                touches.focus();
                            }
                        }
                        moved => {
                            if (self.pressed) {
                                SheetGrid.dragged(self.mouse-x, self.mouse-y);
                            }
                        }
                        double-clicked => { SheetGrid.double-clicked(self.mouse-x, self.mouse-y); }
                    }
                }

                // The frozen rows, over the others.
                if SheetGrid.frozen-height > 0: Rectangle {
                    x: 0px;
                    y: 0px;
                    width: parent.width;
                    height: SheetGrid.frozen-height;
                    clip: true;
                    background: Tokens.surface;
                    for c in SheetGrid.columns: Rectangle {
                        x: c.pos + c.size - 1px + f.content-x;
                        width: 1px;
                        background: Tokens.border.transparentize(0.4);
                    }
                    for c in SheetGrid.pinned: SheetCell {
                        item: c;
                        x: c.x + f.content-x;
                    }
                    Rectangle {
                        x: SheetGrid.cur-x - 1px + f.content-x;
                        y: SheetGrid.cur-y - 1px;
                        width: SheetGrid.cur-width + 1px;
                        height: SheetGrid.cur-height + 1px;
                        visible: SheetGrid.cur-y < SheetGrid.frozen-height;
                        border-width: 2px;
                        border-color: Tokens.accent;
                    }
                    Rectangle {
                        y: parent.height - 2px;
                        height: 2px;
                        background: Tokens.border;
                    }
                    TouchArea {
                        pointer-event(event) => {
                            if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                                SheetGrid.pressed(self.mouse-x - f.content-x, self.mouse-y, event.modifiers.shift);
                                touches.focus();
                            }
                        }
                        moved => {
                            if (self.pressed) {
                                SheetGrid.dragged(self.mouse-x - f.content-x, self.mouse-y);
                            }
                        }
                        double-clicked => { SheetGrid.double-clicked(self.mouse-x - f.content-x, self.mouse-y); }
                    }
                }

                // Typing in a cell: the field over it, as wide as its text.
                property <bool> fige: SheetGrid.cur-y < SheetGrid.frozen-height;
                editeur := Rectangle {
                    x: SheetGrid.cur-x + f.content-x - 1px;
                    y: SheetGrid.cur-y + (corps.fige ? 0px : f.content-y) - 1px;
                    width: max(SheetGrid.cur-width + 2px, min(saisie.preferred-width + 14px, corps.width - self.x));
                    height: SheetGrid.cur-height + 2px;
                    visible: SheetGrid.editing;
                    background: Tokens.surface;
                    border-width: 2px;
                    border-color: Tokens.accent;
                    drop-shadow-blur: 6px;
                    drop-shadow-color: #0000002a;
                    saisie := TextInput {
                        x: 6px;
                        width: parent.width - 12px;
                        height: parent.height;
                        vertical-alignment: center;
                        single-line: true;
                        font-size: 13px;
                        color: Tokens.text;
                        selection-background-color: Tokens.accent.transparentize(0.7);
                        enabled: SheetGrid.editing;
                        property <int> demande: SheetGrid.edit-serial;
                        changed demande => {
                            self.text = SheetGrid.edit-text;
                            self.focus();
                            self.set-selection-offsets(SheetGrid.edit-cursor, SheetGrid.edit-cursor);
                        }
                        edited => { SheetGrid.edit-changed(self.text); }
                        key-pressed(event) => {
                            if (event.text == Key.Return) {
                                SheetGrid.edit-done(self.text, event.modifiers.shift ? 3 : 1);
                                touches.focus();
                                return accept;
                            }
                            if (event.text == Key.Tab || event.text == Key.Backtab) {
                                SheetGrid.edit-done(self.text, event.modifiers.shift || event.text == Key.Backtab ? 4 : 2);
                                touches.focus();
                                return accept;
                            }
                            if (event.text == Key.Escape) {
                                SheetGrid.edit-done(self.text, -1);
                                touches.focus();
                                return accept;
                            }
                            reject
                        }
                    }
                }
            }
        }

        Rectangle {
            height: 1px;
            background: Tokens.border;
        }
        // The sheets, and what the selection adds up to. On a phone the sheets are
        // pills (the mockups' `.chip`), the one shown in the accent's tint.
        HorizontalLayout {
            height: Layout.compact ? 46px : 32px;
            padding-left: Layout.compact ? 10px : 8px;
            padding-right: Layout.compact ? 10px : 12px;
            spacing: Layout.compact ? 6px : 2px;
            for s[i] in SheetGrid.sheets: Rectangle {
                property <bool> actif: i == SheetGrid.sheet && SheetGrid.chart < 0;
                y: Layout.compact ? 8px : 3px;
                height: Layout.compact ? 30px : parent.height - 6px;
                width: onglet.preferred-width + (Layout.compact ? 28px : 24px);
                border-radius: Layout.compact ? 15px : Tokens.radius-small;
                background: Layout.compact
                    ? (self.actif ? Tokens.accent-soft : Tokens.surface)
                    : (self.actif ? Tokens.surface-hover : zone.has-hover ? Tokens.surface-hover.transparentize(0.5) : transparent);
                border-width: Layout.compact && !self.actif ? 1px : 0px;
                border-color: Tokens.border-strong;
                onglet := Text {
                    text: s;
                    font-size: Layout.compact ? 13.5px : 12.5px;
                    font-weight: parent.actif ? 600 : 400;
                    color: Layout.compact
                        ? (parent.actif ? Tokens.accent : Tokens.text-secondary)
                        : (parent.actif ? Tokens.text : Tokens.text-secondary);
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                zone := TouchArea {
                    pointer-event(event) => {
                        if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                            SheetGrid.sheet-chosen(i);
                            touches.focus();
                        }
                        if (event.kind == PointerEventKind.down && event.button == PointerEventButton.right) {
                            SheetGrid.sheet-chosen(i);
                            root.menu("sheet", self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                        }
                    }
                    double-clicked => { root.menu("sheet", self.absolute-position.x, self.absolute-position.y - 80px); }
                }
            }
            // The charts, after the sheets: a click shows one instead of the grid.
            for c[i] in SheetGrid.charts: Rectangle {
                property <bool> actif: i == SheetGrid.chart;
                y: Layout.compact ? 8px : 3px;
                height: Layout.compact ? 30px : parent.height - 6px;
                width: nom-graphique.preferred-width + (Layout.compact ? 48px : 42px);
                border-radius: Layout.compact ? 15px : Tokens.radius-small;
                background: Layout.compact
                    ? (self.actif ? Tokens.accent-soft : Tokens.surface)
                    : (self.actif ? Tokens.surface-hover : zone-graphique.has-hover ? Tokens.surface-hover.transparentize(0.5) : transparent);
                border-width: Layout.compact && !self.actif ? 1px : 0px;
                border-color: Tokens.border-strong;
                accessible-role: tab;
                accessible-label: c;
                accessible-item-selected: self.actif;
                accessible-action-default => { SheetGrid.chart-chosen(i); }
                Icon {
                    x: Layout.compact ? 12px : 9px;
                    y: (parent.height - self.height) / 2;
                    data: Icons.chart;
                    size: 13px;
                    tint: parent.actif ? (Layout.compact ? Tokens.accent : Tokens.text) : Tokens.text-secondary;
                }
                nom-graphique := Text {
                    x: Layout.compact ? 30px : 26px;
                    height: parent.height;
                    text: c;
                    font-size: Layout.compact ? 13.5px : 12.5px;
                    font-weight: parent.actif ? 600 : 400;
                    color: Layout.compact
                        ? (parent.actif ? Tokens.accent : Tokens.text-secondary)
                        : (parent.actif ? Tokens.text : Tokens.text-secondary);
                    vertical-alignment: center;
                }
                zone-graphique := TouchArea {
                    pointer-event(event) => {
                        if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                            SheetGrid.chart-chosen(i);
                        }
                        if (event.kind == PointerEventKind.down && event.button == PointerEventButton.right) {
                            SheetGrid.chart-chosen(i);
                            root.menu("chart", self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                        }
                    }
                }
            }
            if !Layout.compact: IconButton {
                y: (parent.height - self.height) / 2;
                icon: Icons.plus;
                label: "New sheet";
                button-size: 24px;
                icon-size: 13px;
                clicked => { SheetGrid.action("sheet-add"); touches.focus(); }
            }
            if Layout.compact: Rectangle {
                y: 8px;
                height: 30px;
                width: 40px;
                border-radius: 15px;
                background: ajout.pressed ? Tokens.surface-active : Tokens.surface;
                border-width: 1px;
                border-color: Tokens.border-strong;
                accessible-role: button;
                accessible-label: "New sheet";
                accessible-action-default => { SheetGrid.action("sheet-add"); }
                Icon {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    data: Icons.plus;
                    size: 16px;
                    tint: Tokens.text-secondary;
                }
                ajout := TouchArea {
                    clicked => { SheetGrid.action("sheet-add"); touches.focus(); }
                }
            }
            Rectangle { horizontal-stretch: 1; }
            Text {
                text: SheetGrid.status;
                font-size: Layout.compact ? 13.5px : 12px;
                color: Tokens.text-muted;
                vertical-alignment: center;
                overflow: elide;
                horizontal-stretch: Layout.compact ? 1 : 0;
                horizontal-alignment: right;
            }
        }

        // A phone's keys over the keyboard (the mockups' N5): =, Σ, bold, number,
        // percent, the formula bar, and ✓ to finish the cell.
        if Layout.compact && SheetGrid.chart < 0: FormatBar {
            sheet: true;
            vertical-stretch: 0;
            act(k) => {
                if (k == "=" || k == "sum") {
                    // Writing in the cell: added where it ends. Else a cell begun.
                    if (SheetGrid.editing) {
                        saisie.text = saisie.text + (k == "sum" ? "SUM(" : "=");
                        SheetGrid.edit-changed(saisie.text);
                    } else if (k == "sum") {
                        SheetGrid.action("sum");
                    } else {
                        SheetGrid.key("=", false, false);
                    }
                } else if (k == "address") {
                    barre.focus();
                } else if (k == "done") {
                    if (SheetGrid.editing) {
                        SheetGrid.edit-done(saisie.text, 0);
                    }
                    touches.focus();
                } else {
                    SheetGrid.action(k);
                    touches.focus();
                }
            }
        }
    }
}

// The colours a cell's text and fill can take: none, then the palette.
component Swatch inherits Rectangle {
    in property <color> colour;
    in property <bool> none;
    in property <string> label;
    callback clicked();
    width: 24px;
    height: 24px;
    border-radius: 6px;
    background: root.none ? Tokens.surface : root.colour;
    border-width: zone.has-hover ? 2px : 1px;
    border-color: zone.has-hover ? Tokens.accent : Tokens.border;
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { root.clicked(); }
    if root.none: Path {
        width: 100%;
        height: 100%;
        viewbox-width: 24;
        viewbox-height: 24;
        commands: "M 5 19 L 19 5";
        stroke: Tokens.red;
        stroke-width: 1.6px;
    }
    zone := TouchArea {
        clicked => { root.clicked(); }
    }
}

export component SheetMenu inherits Rectangle {
    callback chosen(string);
    callback dismissed();

    TouchArea {
        width: 100%;
        height: 100%;
        clicked => { root.dismissed(); }
    }
    MenuSurface {
        dismissed => { root.dismissed(); }
        available-width: root.width;
        available-height: root.height;
        menu-x: SheetGrid.menu-x;
        menu-y: SheetGrid.menu-y;
        menu-width: SheetGrid.menu == "color" || SheetGrid.menu == "fill" ? 232px : 250px;
        menu-height: entries.preferred-height + 8px;
        entries := VerticalLayout {
            padding: 4px;
            if SheetGrid.menu == "color" || SheetGrid.menu == "fill": VerticalLayout {
                padding: 8px;
                spacing: 8px;
                Text {
                    text: SheetGrid.menu == "color" ? "Text colour" : "Fill colour";
                    font-size: 12px;
                    font-weight: 600;
                    color: Tokens.text-secondary;
                }
                HorizontalLayout {
                    spacing: 4px;
                    alignment: start;
                    Swatch {
                        none: true;
                        label: "None";
                        clicked => { root.chosen(SheetGrid.menu + ":none"); }
                    }
                    for c[i] in SheetGrid.menu == "color" ? SheetGrid.text-colours : SheetGrid.fill-colours: Swatch {
                        colour: c;
                        label: ["Red", "Orange", "Yellow", "Green", "Blue", "Purple", "Grey"][i];
                        clicked => { root.chosen(SheetGrid.menu + ":" + i); }
                    }
                }
            }
            if SheetGrid.menu == "number": VerticalLayout {
                MenuEntry {
                    label: "General";
                    activated => { root.chosen("number:general"); }
                }
                MenuEntry {
                    label: "Number   1 234,56";
                    activated => { root.chosen("number:number"); }
                }
                MenuEntry {
                    label: "Percent   12 %";
                    activated => { root.chosen("number:percent"); }
                }
                MenuEntry {
                    label: "Currency   12,50 €";
                    activated => { root.chosen("number:currency"); }
                }
                MenuEntry {
                    label: "Date";
                    activated => { root.chosen("number:date"); }
                }
                MenuEntry {
                    label: "Time";
                    activated => { root.chosen("number:time"); }
                }
                MenuEntry {
                    label: "Date and time";
                    activated => { root.chosen("number:datetime"); }
                }
                MenuEntry {
                    label: "Text, as typed";
                    activated => { root.chosen("number:text"); }
                }
            }
            if SheetGrid.menu == "more": VerticalLayout {
                MenuEntry {
                    icon: Icons.plus;
                    label: "Insert a row above";
                    activated => { root.chosen("row-above"); }
                }
                MenuEntry {
                    icon: Icons.plus;
                    label: "Insert a row below";
                    activated => { root.chosen("row-below"); }
                }
                MenuEntry {
                    icon: Icons.minus;
                    label: "Delete the rows";
                    activated => { root.chosen("row-delete"); }
                }
                MenuSeparator { }
                MenuEntry {
                    icon: Icons.plus;
                    label: "Insert a column left";
                    activated => { root.chosen("col-left"); }
                }
                MenuEntry {
                    icon: Icons.plus;
                    label: "Insert a column right";
                    activated => { root.chosen("col-right"); }
                }
                MenuEntry {
                    icon: Icons.minus;
                    label: "Delete the columns";
                    activated => { root.chosen("col-delete"); }
                }
                MenuSeparator { }
                MenuEntry {
                    icon: Icons.sort;
                    label: "Sort Z to A by this column";
                    activated => { root.chosen("sort-desc"); }
                }
                MenuEntry {
                    icon: Icons.chevron-down;
                    label: "Fill down";
                    shortcut: "Ctrl+D";
                    activated => { root.chosen("fill-down"); }
                }
                MenuEntry {
                    icon: Icons.chevron-right;
                    label: "Fill right";
                    shortcut: "Ctrl+R";
                    activated => { root.chosen("fill-right"); }
                }
                MenuSeparator { }
                MenuEntry {
                    icon: Icons.download;
                    label: "Export as Excel…";
                    activated => { root.chosen("export-xlsx"); }
                }
                MenuEntry {
                    icon: Icons.download;
                    label: "Export as CSV…";
                    activated => { root.chosen("export-csv"); }
                }
            }
            if SheetGrid.menu == "chart": VerticalLayout {
                MenuEntry {
                    icon: Icons.pencil;
                    label: "Rename the chart…";
                    activated => { root.chosen("chart-rename"); }
                }
                MenuEntry {
                    icon: Icons.copy;
                    label: "Copy for a note";
                    activated => { root.chosen("chart-copy"); }
                }
                MenuEntry {
                    icon: Icons.layers;
                    label: "Duplicate the chart";
                    activated => { root.chosen("chart-duplicate"); }
                }
                MenuEntry {
                    icon: Icons.trash;
                    label: "Delete the chart";
                    danger: true;
                    activated => { root.chosen("chart-delete"); }
                }
            }
            if SheetGrid.menu == "chart-group" || SheetGrid.menu == "chart-value": VerticalLayout {
                if SheetGrid.menu == "chart-value": MenuEntry {
                    label: "Count the rows";
                    activated => { root.chosen("chart-value-clear"); }
                }
                if SheetGrid.menu == "chart-value": MenuSeparator { }
                for c[i] in SheetGrid.chart-columns: MenuEntry {
                    label: c;
                    activated => { root.chosen(SheetGrid.menu + "-add:" + i); }
                }
            }
            if SheetGrid.menu == "sheet": VerticalLayout {
                MenuEntry {
                    icon: Icons.pencil;
                    label: "Rename the sheet…";
                    activated => { root.chosen("sheet-rename"); }
                }
                MenuEntry {
                    icon: Icons.layers;
                    label: "Duplicate the sheet";
                    activated => { root.chosen("sheet-duplicate"); }
                }
                MenuEntry {
                    icon: Icons.trash;
                    label: "Delete the sheet";
                    danger: true;
                    activated => { root.chosen("sheet-delete"); }
                }
            }
        }
    }
}
