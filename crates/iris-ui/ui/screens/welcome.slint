import { Tokens } from "@iris/theme/tokens.slint";
import { Layout } from "@iris/theme/layout.slint";
import { Icon, Icons } from "@iris/base/icons.slint";
import { BlockButton, ButtonKind } from "@iris/controls/button.slint";

// The first page of a copy of Iris with no mailbox yet, as the Android mockup draws it
// (`..\Iris-design\android\onboarding.html`, O1): the mark, what Iris is in a line,
// three points, then the way in at the foot, within the thumb's reach.

component Point inherits HorizontalLayout {
    in property <string> icon;
    in property <color> tint;
    in property <string> text;
    spacing: 14px;
    Rectangle {
        y: (parent.height - self.height) / 2;
        width: 30px;
        height: 30px;
        border-radius: 8px;
        background: root.tint;
        Icon {
            data: root.icon;
            size: 18px;
            weight: 2;
            tint: white;
        }
    }
    Text {
        text: root.text;
        font-size: 15.5px;
        color: Tokens.text-secondary;
        wrap: word-wrap;
        vertical-alignment: center;
        horizontal-stretch: 1;
    }
}

export component WelcomePage inherits Rectangle {
    callback add-account();
    callback from-device();
    callback restore();
    callback dismissed();

    background: Tokens.background;
    // Over what is behind: no click goes through the page.
    TouchArea {}

    VerticalLayout {
        x: max(0px, (parent.width - self.width) / 2);
        width: min(460px, parent.width);
        padding-top: Layout.inset-top;
        padding-bottom: Layout.inset-bottom + 18px;

        // What Iris is, in the middle of the page.
        VerticalLayout {
            vertical-stretch: 1;
            alignment: center;
            padding-left: 28px;
            padding-right: 28px;
            spacing: 0px;

            HorizontalLayout {
                alignment: start;
                Rectangle {
                    width: 84px;
                    height: 84px;
                    border-radius: 24px;
                    background: @linear-gradient(135deg, #5e9bff 0%, #007aff 55%, #6c5ce7 100%);
                    drop-shadow-blur: Tokens.shadow-float-blur;
                    drop-shadow-offset-y: Tokens.shadow-float-y;
                    drop-shadow-color: Tokens.shadow-float;
                    // The iris: a ring and its pupil.
                    Rectangle {
                        width: 32px;
                        height: 32px;
                        border-radius: 16px;
                        border-width: 2.4px;
                        border-color: white;
                    }
                    Rectangle {
                        width: 12px;
                        height: 12px;
                        border-radius: 6px;
                        background: white;
                    }
                }
            }
            Rectangle { height: 28px; }
            Text {
                text: "Iris";
                font-family: Tokens.font-display;
                font-size: 34px;
                font-weight: 600;
                color: Tokens.text;
            }
            Rectangle { height: 8px; }
            Text {
                text: "A fast, quiet mail client. Built for getting through your mail, not for filing it.";
                font-size: 18px;
                color: Tokens.text-secondary;
                wrap: word-wrap;
            }
            Rectangle { height: 30px; }
            VerticalLayout {
                spacing: 16px;
                Point {
                    icon: Icons.inbox;
                    tint: Tokens.blue;
                    text: "Every conversation is to do, waiting or done";
                }
                Point {
                    icon: Icons.calendar;
                    tint: Tokens.red;
                    text: "Your calendar and tasks beside your mail";
                }
                Point {
                    icon: Icons.eye;
                    tint: Tokens.green;
                    text: "Trackers blocked, nothing sent anywhere else";
                }
            }
        }

        // The way in, at the foot.
        VerticalLayout {
            padding-left: 24px;
            padding-right: 24px;
            padding-top: 16px;
            spacing: 6px;
            BlockButton {
                text: "Add your first account";
                clicked => { root.add-account(); }
            }
            Rectangle { height: 4px; }
            BlockButton {
                text: "Set up from another device";
                kind: ButtonKind.ghost;
                clicked => { root.from-device(); }
            }
            BlockButton {
                text: "Restore a backup";
                kind: ButtonKind.ghost;
                clicked => { root.restore(); }
            }
        }
    }
}
