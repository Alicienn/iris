import { Tokens } from "@iris/theme/tokens.slint";
import { TextField } from "@iris/controls/field.slint";
import { Icon, Icons } from "@iris/base/icons.slint";
import { Button, ButtonKind } from "@iris/controls/button.slint";
import { Modal, ModalFooter } from "@iris/layout/frames.slint";

// What an account in trouble looks like when you click on it.
//
// The exclamation mark in the sidebar used to be the whole story: it said something
// was wrong and offered nothing to do about it, which is the worst of both — the user
// knows they have a problem and has no way to touch it.
//
// So this says three things. What went wrong, in the server's own words. What that
// means, in ours. And the one action that can fix it, right there, rather than
// somewhere in settings.
export component AccountProblemPanel inherits Rectangle {
    in property <string> account;
    in property <string> message;
    in property <string> advice;
    in property <bool> needs-password;
    in property <bool> busy;
    in property <string> result;
    in-out property <string> password;

    callback retry();
    callback save-password();
    callback disable-account();
    callback dismissed();

    Modal {
        width: 100%;
        height: 100%;
        title: root.account;
        card-width: 480px;
        fit: true;
        dismissed => { root.dismissed(); }

        HorizontalLayout {
            spacing: 8px;
            Icon {
                y: (parent.height - self.height) / 2;
                data: Icons.warning;
                size: 16px;
                tint: Tokens.error;
            }
            Text {
                text: "This mailbox is not syncing.";
                font-size: 13px;
                color: Tokens.error;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
        }

        // Our reading of it first, because that is what tells the user whether
        // this is theirs to fix or the server's to recover from.
        Text {
            text: root.advice;
            font-size: Tokens.size-body;
            color: Tokens.text-secondary;
            wrap: word-wrap;
        }

        // Then the server's own words, which are ugly but are the only thing that
        // helps when our reading of them is wrong.
        if root.message != "": Rectangle {
            height: detail.preferred-height + 16px;
            border-radius: Tokens.radius-small;
            background: Tokens.surface-low;
            border-width: 1px;
            border-color: Tokens.border;

            detail := Text {
                x: 8px;
                y: 8px;
                width: parent.width - 16px;
                text: root.message;
                font-family: Tokens.font-mono;
                font-size: 11px;
                color: Tokens.text-muted;
                wrap: word-wrap;
            }
        }

        if root.needs-password: VerticalLayout {
            spacing: 4px;
            Text {
                text: "New password";
                font-size: 12px;
                color: Tokens.text-muted;
            }
            TextField {
                accessible-label: "New password";
                input-type: InputType.password;
                font-size: Tokens.size-body;
                text <=> root.password;
                accepted => { root.save-password(); }
            }
        }

        if root.result != "": Text {
            text: root.result;
            font-size: 12px;
            color: Tokens.text-secondary;
            wrap: word-wrap;
        }

        // Turning the account off is a legitimate answer to "this is broken and I do
        // not want to deal with it now", and hiding it would leave the marker blinking
        // for ever.
        ModalFooter {
            Button {
                text: "Disable";
                label: "Disable this account";
                kind: ButtonKind.ghost;
                clicked => { root.disable-account(); }
            }
            Rectangle { horizontal-stretch: 1; }
            Button {
                text: root.busy ? "Trying…" : (root.needs-password ? "Save and retry" : "Try again");
                label: root.needs-password ? "Save and retry" : "Try again";
                kind: ButtonKind.primary;
                enabled: !root.busy;
                clicked => { root.needs-password ? root.save-password() : root.retry(); }
            }
        }
    }
}
