import { Tokens } from "@iris/theme/tokens.slint";
import { TextArea } from "@iris/controls/field.slint";
import { Icon, Icons, IconButton } from "@iris/base/icons.slint";
import { MessageData, MessageBlockData, BodyTileData, AttachmentData } from "@iris/types.slint";
import { LoadingLine } from "@iris/base/spinner.slint";
import { ScrollView } from "std-widgets.slint";
import { Button, ButtonKind, ButtonSize } from "@iris/controls/button.slint";
import { Toolbar } from "@iris/layout/frames.slint";
import { MenuEntry, MenuHeader, MenuSeparator, MenuSurface } from "@iris/layout/menu.slint";
import { Avatar } from "@iris/base/atoms.slint";

// Un bloc du corps du message.
//
// Le corps arrive déjà découpé en blocs par le moteur de rendu : l'interface ne voit
// jamais de HTML, et ne peut donc rien en exécuter.
// Words of a message: read as text, and selected with the mouse like any text, then
// copied. Never written into: the keys it has no use for go on to the shortcuts.
component SelectableText inherits TextInput {
    read-only: true;
    single-line: false;
    wrap: word-wrap;
    selection-background-color: Tokens.accent.transparentize(0.7);
    selection-foreground-color: Tokens.text;
    text-cursor-width: 0px;
}

component MessageBlock inherits Rectangle {
    in property <MessageBlockData> block;

    height: layout.preferred-height;

    layout := VerticalLayout {
        if root.block.kind == "rule": Rectangle {
            height: 1px;
            background: Tokens.border;
        }

        // Dessinée, pas tapée. C'était « ▣ », un caractère qui existe en Unicode et
        // dans presque aucune police d'interface : ce qui s'affichait devant chaque
        // image bloquée était le carré vide de la police de repli. La même faute que
        // les quatre marqueurs de la liste, au même endroit du raisonnement, corrigée
        // là-bas et pas ici.
        // L'image, quand le message la porte. Sinon, ce qu'on peut en dire.
        //
        // Elle n'était jamais dessinée : la source était lue seulement pour savoir si
        // elle était bloquée, et le reste jeté. Un logo de signature déjà présent dans
        // le message s'affichait donc comme une icône avec le mot « image » à côté —
        // et dans un fil de dix messages signés de trois pastilles, cela faisait trente
        // lignes qui ne montraient rien.
        //
        // À sa taille naturelle, bornée à la largeur de la colonne. Étirer une pastille
        // de cent pixels sur huit cents la rendrait floue et occuperait l'écran pour
        // une décoration ; c'est précisément l'accumulation dont il s'agit.
        // La largeur vient de la mise en page, jamais du parent : la lire ici ferait
        // dépendre la largeur du bloc de la largeur du bloc, et le compilateur Slint
        // refuse la boucle — à juste titre, puisqu'elle n'a pas de solution.
        //
        // La hauteur est celle de l'image, et `contain` réduit si la colonne est plus
        // étroite. Le décodeur borne déjà la largeur à celle de la colonne de lecture,
        // donc le cas courant est un dessin à l'échelle un.
        if root.block.kind == "image" && root.block.has-picture: Image {
            source: root.block.picture;
            image-fit: contain;
            horizontal-alignment: left;
            height: root.block.picture.height * 1px;
        }

        if root.block.kind == "image" && !root.block.has-picture: HorizontalLayout {
            spacing: Tokens.space-2;
            Icon {
                y: (parent.height - self.height) / 2;
                data: Icons.image;
                size: 14px;
                tint: Tokens.text-muted;
            }
            Text {
                text: root.block.text;
                color: Tokens.text-muted;
                font-size: Tokens.size-small;
                font-italic: true;
                vertical-alignment: center;
                overflow: elide;
            }
        }

        if root.block.kind == "heading": SelectableText {
            text: root.block.text;
            font-size: Tokens.size-title + (3 - min(root.block.level, 3)) * 2px;
            font-weight: Tokens.weight-bold;
            color: Tokens.text;
        }

        if root.block.kind == "code": Rectangle {
            background: Tokens.surface;
            border-radius: Tokens.radius-small;
            height: code-text.preferred-height + Tokens.space-4;
            code-text := SelectableText {
                x: Tokens.space-2;
                y: Tokens.space-2;
                width: parent.width - Tokens.space-4;
                text: root.block.text;
                font-family: Tokens.font-mono;
                font-size: Tokens.size-small;
                color: Tokens.text-secondary;
            }
        }

        // Une citation est repliée par défaut au-delà du premier niveau : dans un fil
        // de dix réponses, afficher les neuf précédentes noie la seule ligne utile.
        if root.block.kind == "quote": HorizontalLayout {
            spacing: Tokens.space-2;
            Rectangle {
                width: 2px;
                background: Tokens.border-strong;
            }
            SelectableText {
                text: root.block.text;
                font-size: Tokens.size-body;
                color: Tokens.text-muted;
            }
        }

        if root.block.kind == "list": HorizontalLayout {
            padding-left: root.block.depth * Tokens.space-4;
            spacing: Tokens.space-2;
            Text {
                text: "•";
                color: Tokens.text-secondary;
            }
            SelectableText {
                text: root.block.text;
                font-size: Tokens.size-body;
                color: Tokens.text;
            }
        }

        // Wrapped, like the rest. Unwrapped, a newsletter laid out in one table made a
        // single line tens of thousands of pixels long; the card around it grew as wide,
        // and the renderer stopped the application drawing its rounded corner.
        if root.block.kind == "table": SelectableText {
            text: root.block.text;
            font-family: Tokens.font-mono;
            font-size: Tokens.size-small;
            color: Tokens.text-secondary;
        }

        if root.block.kind == "paragraph": SelectableText {
            text: root.block.text;
            font-size: Tokens.size-body;
            font-weight: root.block.bold ? Tokens.weight-bold : Tokens.weight-body;
            font-italic: root.block.italic;
            color: Tokens.text;
        }
    }
}

// Le bandeau d'avertissement des contenus distants.
component RemoteContentBanner inherits Rectangle {
    in property <int> blocked-images;
    in property <bool> has-tracker;

    callback load-images();

    height: 32px;
    border-radius: Tokens.radius-small;
    background: Tokens.surface;
    border-width: 1px;
    border-color: Tokens.border;

    HorizontalLayout {
        padding-left: Tokens.space-3;
        padding-right: Tokens.space-2;
        spacing: Tokens.space-2;

        Text {
            // « 1 remote image(s) blocked » est une phrase qu'un programme écrit et
            // qu'aucune personne ne prononce — et elle apparaît à l'endroit précis où
            // l'on demande à quelqu'un de décider s'il fait confiance à un inconnu.
            // Avoir l'air d'un formulaire à ce moment-là n'est pas gratuit.
            text: root.has-tracker
                ? "This sender is trying to learn when you read this message."
                : (root.blocked-images == 1
                    ? "1 remote image blocked."
                    : root.blocked-images + " remote images blocked.");
            font-size: Tokens.size-small;
            color: root.has-tracker ? Tokens.warning : Tokens.text-secondary;
            vertical-alignment: center;
            overflow: elide;
        }

        Rectangle {}

        // The theme's accent, not the platform's button. A stock Button here brought
        // the operating system's own blue into a window that has exactly one colour,
        // and it is the only control in the reading pane that did.
        Rectangle {
            width: 62px;
            height: 22px;
            y: (parent.height - self.height) / 2;
            border-radius: Tokens.radius-small;
            background: montrer.has-hover
                ? Tokens.accent
                : Tokens.accent.transparentize(0.12);
            animate background { duration: Tokens.instant; }

            accessible-role: button;
            accessible-label: "Show the remote images in this message";
            accessible-action-default => { root.load-images(); }

            Text {
                text: "Show";
                font-size: Tokens.size-small;
                font-weight: Tokens.weight-bold;
                color: Tokens.accent-text;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            montrer := TouchArea {
                clicked => { root.load-images(); }
            }
        }
    }
}

// One tile of a body painted by the full engine.
//
// It asks for its pixels when it comes within a screen of the visible part, and gives
// them back when it goes further. The margin is what makes scrolling look instant: the
// next tile is painted before it shows.
component BodyTile inherits Rectangle {
    in property <BodyTileData> tile;
    in property <length> top;
    in property <length> visible-height;
    in property <bool> suspended;

    callback wanted();
    callback released();
    callback resized(length);
    /// Pressed (0) or dragged to (1), as fractions of the tile across and down; a
    /// drag past the tile gives fractions beyond 0 and 1.
    callback select(float, float, int);

    // Only once laid out. Before the first layout every tile is zero pixels wide,
    // hence zero high, and they all sit at the top: every one of them looked near,
    // and opening a newsletter painted all of it.
    property <bool> near: !root.suspended
        && root.width > 0 && root.visible-height > 0
        && root.top < root.visible-height * 2
        && root.top + root.height > -root.visible-height;

    height: root.width * root.tile.aspect;
    background: white;

    // The first look is taken one turn of the event loop after creation, once the
    // column has been laid out. Taken in `init`, it saw every tile at the top of a
    // column not yet measured, and asked for all of them.
    property <bool> armed;
    Timer {
        interval: 0ms;
        running: !root.armed;
        triggered => {
            root.armed = true;
            root.resized(root.width);
            if (root.near) {
                root.wanted();
            }
        }
    }
    changed width => {
        if (root.armed) {
            root.resized(root.width);
        }
    }
    changed near => {
        if (!root.armed) {
            return;
        }
        if (root.near) {
            root.wanted();
        } else {
            root.released();
        }
    }

    if root.tile.ready: Image {
        width: 100%;
        height: 100%;
        source: root.tile.image;
        image-fit: fill;
    }

    // Text selected as on a page: pressed, then dragged, even past the tile.
    TouchArea {
        mouse-cursor: text;
        pointer-event(event) => {
            if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down
                && root.width > 0 && root.height > 0) {
                root.select(self.mouse-x / root.width, self.mouse-y / root.height, 0);
            }
        }
        moved => {
            if (self.pressed && root.width > 0 && root.height > 0) {
                root.select(self.mouse-x / root.width, self.mouse-y / root.height, 1);
            }
        }
    }
}

// The attachments of a message, as file cards: a badge for the kind, the name, the
// size.
//
// Une par carte, avec son type et sa taille : « devis.pdf » seul ne dit pas s'il faut
// l'ouvrir maintenant ou attendre d'être au bureau, et « PDF · 2,4 Mo » le dit.
//
// As many to a row as the card has room for. Au-delà d'une rangée, les suivantes sont
// comptées plutôt que dessinées, et le décompte les montre toutes, rangée par rangée.
component Attachments inherits VerticalLayout {
    in property <[AttachmentData]> files;
    in-out property <bool> expanded;
    callback open(int);
    callback save(int);

    /// How many cards a row holds, the count included.
    property <int> par-rang: max(2, floor((root.width - root.padding-left) / 208px));
    /// How many show while folded: a row, less the place of the count when some
    /// are left over.
    property <int> montrees: root.files.length > root.par-rang ? root.par-rang - 1 : root.files.length;

    spacing: 8px;

    for rang[r] in root.expanded ? ceil(root.files.length / root.par-rang) : 1: HorizontalLayout {
    height: 52px;

    // Each card with the gap after it; those of other rows take no room at all.
    for piece[i] in root.files: Rectangle {
        property <bool> ici: root.expanded ? floor(i / root.par-rang) == r : i < root.montrees;
        width: self.ici ? 208px : 0px;
        visible: self.ici;

    fichier := Rectangle {
        property <bool> pdf: piece.kind == "PDF";
        property <bool> picture: piece.icon == "image";
        property <color> teinte: self.pdf ? Tokens.error : self.picture ? Tokens.success : Tokens.text-muted;
        x: 0px;
        width: 200px;
        border-radius: Tokens.radius-large;
        background: piece-touch.has-hover ? Tokens.surface-hover : transparent;
        border-width: 1px;
        border-color: Tokens.border-strong;
        animate background { duration: Tokens.instant; }

        // Le clic **ouvre**, et la flèche enregistre : neuf fois sur dix on veut
        // seulement regarder le fichier, pas le garder.
        accessible-role: button;
        accessible-label: "Open " + piece.name;
        accessible-description: piece.kind + ", " + piece.size;
        accessible-action-default => { root.open(i); }

        piece-touch := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.open(i); }
        }

        HorizontalLayout {
            padding-left: 8px;
            padding-right: 8px;
            spacing: 10px;

            // The kind, as a small coloured page.
            Rectangle {
                y: (parent.height - self.height) / 2;
                width: 30px;
                height: 36px;
                border-radius: 4px;
                background: fichier.teinte.transparentize(0.88);
                if fichier.pdf || fichier.picture: Text {
                    text: fichier.pdf ? "PDF" : "IMG";
                    font-size: 9px;
                    font-weight: 700;
                    color: fichier.teinte;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                if !fichier.pdf && !fichier.picture: Icon {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    data: piece.icon == "archive" ? Icons.archive
                        : piece.icon == "table" ? Icons.list
                        : piece.icon == "envelope-closed" ? Icons.envelope-closed
                        : Icons.paperclip;
                    size: 15px;
                    tint: Tokens.text-secondary;
                }
            }

            VerticalLayout {
                alignment: center;
                spacing: 1px;
                horizontal-stretch: 1;
                Text {
                    text: piece.name;
                    font-size: 12.5px;
                    font-weight: 500;
                    color: Tokens.text;
                    overflow: elide;
                }
                Text {
                    text: piece.size;
                    font-size: 11.5px;
                    color: Tokens.text-muted;
                    overflow: elide;
                }
            }

            // Enregistrer, pour qui veut garder le fichier. Toujours présent, rarement
            // visible : un `if` le retirerait de l'arbre d'accessibilité, donc du
            // clavier et des lecteurs d'écran.
            Rectangle {
                width: 24px;
                height: 24px;
                y: (parent.height - self.height) / 2;
                border-radius: Tokens.radius-small;
                opacity: piece-touch.has-hover || garder.has-hover ? 1.0 : 0.0;
                animate opacity { duration: Tokens.instant; }
                background: garder.has-hover ? Tokens.surface-active : transparent;

                accessible-role: button;
                accessible-label: "Save " + piece.name;
                accessible-action-default => { root.save(i); }

                Icon {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    data: Icons.download;
                    size: 14px;
                    tint: Tokens.text;
                }

                garder := TouchArea {
                    clicked => { root.save(i); }
                }
            }
        }
    } // fichier
    }

    if r == 0 && root.files.length > root.montrees && !root.expanded: Rectangle {
        width: 60px;
        border-radius: Tokens.radius-large;
        background: reste.has-hover ? Tokens.surface-hover : transparent;
        border-width: 1px;
        border-color: Tokens.border-strong;

        accessible-role: button;
        accessible-label: "Show all " + root.files.length + " attachments";
        accessible-action-default => { root.expanded = true; }

        Text {
            text: "+" + (root.files.length - root.montrees);
            font-size: 12.5px;
            color: Tokens.text-secondary;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        reste := TouchArea {
            clicked => { root.expanded = true; }
        }
    }

    Rectangle {}
    } // rang
}

// What the reading toolbar's menus hold: until when to snooze, and the rarer actions.
// An invitation over the message that carries it: what, when, and where it stands in
// the calendar, with the one thing to do about it.
// A button of the reply box that says, when pointed at, to whom it sends: the To, Cc
// and Bcc lines apart.
component RecipientsButton inherits Rectangle {
    in property <string> text;
    in property <string> icon;
    in property <ButtonKind> kind;
    in property <bool> enabled;
    in property <string> to;
    in property <string> cc;
    in property <string> bcc;
    callback clicked();

    width: bouton.preferred-width;
    bouton := Button {
        width: parent.width;
        height: parent.height;
        text: root.text;
        icon: root.icon;
        kind: root.kind;
        size: ButtonSize.sm;
        enabled: root.enabled;
        label: root.to == "" ? root.text : root.text + " to " + root.to
            + (root.cc == "" ? "" : ", copy to " + root.cc)
            + (root.bcc == "" ? "" : ", blind copy to " + root.bcc);
        clicked => { root.clicked(); }
    }
    if root.to != "" && root.cc == "" && root.bcc == "": Tooltip {
        text: @markdown("To: \{root.to}");
    }
    if root.to != "" && root.cc != "" && root.bcc == "": Tooltip {
        text: @markdown("To: \{root.to}\n\nCc: \{root.cc}");
    }
    if root.to != "" && root.cc == "" && root.bcc != "": Tooltip {
        text: @markdown("To: \{root.to}\n\nBcc: \{root.bcc}");
    }
    if root.to != "" && root.cc != "" && root.bcc != "": Tooltip {
        text: @markdown("To: \{root.to}\n\nCc: \{root.cc}\n\nBcc: \{root.bcc}");
    }
}

component InviteBanner inherits Rectangle {
    /// 1 not in the calendar, 2 in it, 3 changed since, 4 cancelled but still in it,
    /// 5 cancelled and not in it.
    in property <int> state;
    in property <string> title;
    in property <string> when;
    /// It can be answered, and what was answered ("ACCEPTED", "TENTATIVE", "DECLINED").
    in property <bool> can-reply;
    in property <string> reply;
    callback accept();
    callback open();
    /// An answer sent to the organiser: 0 Accept, 1 Maybe, 2 Decline.
    callback answer(int);

    property <bool> annule: root.state >= 4;
    /// Answered with its buttons rather than added with one.
    property <bool> repondre: root.can-reply && root.state <= 3;

    height: rang.preferred-height;
    border-radius: Tokens.radius-large;
    border-width: 1px;
    border-color: root.annule ? Tokens.error.transparentize(0.6) : Tokens.accent.transparentize(0.6);
    background: root.annule ? Tokens.error.transparentize(0.94) : Tokens.accent-soft;

    accessible-role: groupbox;
    accessible-label: "Invitation: " + root.title + ", " + root.when;

    rang := HorizontalLayout {
        padding: 12px;
        padding-left: 14px;
        spacing: 12px;

        Rectangle {
            y: (parent.height - self.height) / 2;
            width: 34px;
            height: 34px;
            border-radius: Tokens.radius-medium;
            background: Tokens.surface;
            Icon {
                data: Icons.calendar;
                size: 18px;
                tint: root.annule ? Tokens.error : Tokens.accent;
            }
        }
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            horizontal-stretch: 1;
            Text {
                text: root.title;
                font-size: 13.5px;
                font-weight: 600;
                color: Tokens.text;
                overflow: elide;
            }
            Text {
                text: root.when + "  ·  " + (
                    root.reply == "ACCEPTED" && !root.annule ? "You accepted"
                    : root.reply == "TENTATIVE" && !root.annule ? "You said maybe"
                    : root.reply == "DECLINED" && !root.annule ? "You declined"
                    : root.state == 1 ? "Invitation"
                    : root.state == 2 ? "In your calendar"
                    : root.state == 3 ? "Changed since you added it"
                    : root.state == 4 ? "Cancelled by the organiser"
                    : "Cancelled");
                font-size: 12.5px;
                color: root.annule ? Tokens.error : Tokens.text-secondary;
                overflow: elide;
            }
        }
        // Answered: sent to the organiser, and the calendar follows. The answer given
        // is the filled button; another click changes it.
        // In a row of their own: a width forced on each button read its own preferred
        // width back and came out at nothing, the three words drawn over each other.
        if root.repondre: HorizontalLayout {
            spacing: 6px;
            horizontal-stretch: 0;
            for mot[i] in ["Accept", "Maybe", "Decline"]: Button {
                property <string> statut: i == 0 ? "ACCEPTED" : i == 1 ? "TENTATIVE" : "DECLINED";
                text: mot;
                label: mot + " the invitation";
                kind: root.reply == self.statut ? ButtonKind.primary : ButtonKind.secondary;
                size: ButtonSize.sm;
                clicked => { root.answer(i); }
            }
        }
        if root.state == 1 && !root.repondre: Button {
            y: (parent.height - self.height) / 2;
            text: "Add to calendar";
            icon: Icons.plus;
            kind: ButtonKind.primary;
            size: ButtonSize.sm;
            clicked => { root.accept(); }
        }
        if root.state == 3 && root.reply == "": Button {
            y: (parent.height - self.height) / 2;
            text: "Update";
            kind: ButtonKind.primary;
            size: ButtonSize.sm;
            clicked => { root.accept(); }
        }
        if root.state == 4: Button {
            y: (parent.height - self.height) / 2;
            text: "Remove from calendar";
            size: ButtonSize.sm;
            clicked => { root.accept(); }
        }
        if root.state == 2 || root.state == 3: Button {
            y: (parent.height - self.height) / 2;
            text: "Open";
            size: ButtonSize.sm;
            clicked => { root.open(); }
        }
    }
}

export component ReaderMenu inherits Rectangle {
    /// "snooze" or "more".
    in property <string> kind;
    in property <bool> unread;
    in property <length> menu-x;
    in property <length> menu-y;

    callback snooze(string);
    callback forward-thread();
    callback toggle-unread();
    callback view-source();
    callback dismissed();

    TouchArea {
        width: 100%;
        height: 100%;
        clicked => { root.dismissed(); }
    }

    if root.kind == "snooze": MenuSurface {
        available-width: root.width;
        available-height: root.height;
        menu-x: root.menu-x;
        menu-y: root.menu-y;
        menu-width: 230px;
        menu-height: reports.preferred-height + 8px;

        reports := VerticalLayout {
            padding: 4px;
            MenuHeader { text: "Snooze until"; }
            MenuEntry {
                icon: Icons.clock;
                label: "Later today";
                activated => { root.snooze("evening"); root.dismissed(); }
            }
            MenuEntry {
                icon: Icons.sun;
                label: "Tomorrow morning";
                shortcut: "S";
                activated => { root.snooze("tomorrow"); root.dismissed(); }
            }
            MenuEntry {
                icon: Icons.calendar;
                label: "This weekend";
                activated => { root.snooze("weekend"); root.dismissed(); }
            }
            MenuEntry {
                icon: Icons.arrow-right;
                label: "Next week";
                activated => { root.snooze("monday"); root.dismissed(); }
            }
        }
    }

    if root.kind == "more": MenuSurface {
        available-width: root.width;
        available-height: root.height;
        // Opened from the last button of the bar: it hangs to the left of it.
        menu-x: root.menu-x - 220px;
        menu-y: root.menu-y;
        menu-width: 220px;
        menu-height: autres.preferred-height + 8px;

        autres := VerticalLayout {
            padding: 4px;
            // Forward opens the ordinary editor, subject and quote filled in, the
            // recipient left empty: the one thing a forward cannot guess.
            MenuEntry {
                icon: Icons.forward;
                label: "Forward";
                activated => { root.forward-thread(); root.dismissed(); }
            }
            MenuEntry {
                icon: root.unread ? Icons.envelope-open : Icons.envelope-closed;
                label: root.unread ? "Mark as read" : "Mark as unread";
                shortcut: "R";
                activated => { root.toggle-unread(); root.dismissed(); }
            }
            MenuSeparator {}
            MenuEntry {
                icon: Icons.code;
                label: "View source";
                activated => { root.view-source(); root.dismissed(); }
            }
        }
    }
}

// La colonne de lecture, avec la réponse intégrée au bas du fil.
export component ConversationView inherits VerticalLayout {
    /// Le message le plus récent : c'est lui que l'en-tête et la barre d'actions
    /// décrivent, parce que c'est de lui qu'on décide.
    in property <MessageData> message;
    /// Le fil entier, du plus ancien au plus récent.
    in property <[MessageData]> messages;
    in property <bool> empty: true;
    in-out property <string> reply-text;
    /// Whom Send and Reply all write to, each line apart (addresses joined by commas).
    in property <string> reply-to;
    in property <string> reply-cc;
    in property <string> reply-bcc;
    in property <string> reply-all-to;
    in property <string> reply-all-cc;
    in property <string> reply-all-bcc;
    /// Another conversation is shown: its reply's recipients are asked for.
    callback reply-recipients-wanted();

    in property <bool> starred;
    /// The mailbox the conversation came to.
    in property <string> account-email;
    /// The folder it is in: "Inbox", "Spam", "Trash", a folder's name; "+1" when some
    /// of its messages are elsewhere.
    in property <string> folder-label;
    /// Every folder it is in, when there are several ("Inbox, Sent, Clients").
    in property <string> folder-all;
    /// Its latest message is in the bin or the spam: said in red.
    in property <bool> folder-alarming;
    in property <color> account-tint;
    /// Read full screen, the accounts and the list set aside.
    in property <bool> focused;
    /// How wide the thread runs at most; centred beyond.
    in property <length> column: 900px;

    callback send();
    callback load-images();
    callback reply-all();
    callback save-attachment(int);
    callback open-attachment(int);
    /// The invitation a message carries: into the calendar (message id), or opened
    /// there (event key, day).
    callback invite-accept(int);
    callback invite-open(string, string);
    /// An invitation answered (message id; 0 Accept, 1 Maybe, 2 Decline).
    callback invite-answer(int, int);
    callback archive();
    callback delete-thread();
    callback toggle-star();
    /// The snooze menu, and where its top left goes (in the window).
    callback snooze-menu(length, length);
    /// The menu of the rarer actions, and where its top right goes.
    callback more-menu(length, length);
    callback waiting();
    callback toggle-focus();
    callback mark-done();
    /// The conversation becomes a task.
    callback to-task();
    callback toggle-message(int);

    /// A tile of a body painted by the full engine has come near the screen, or gone
    /// away from it: (message id, tile index).
    callback body-tile-wanted(int, int);
    callback body-tile-released(int, int);
    /// The width message bodies are shown at, reported by the first tile when it first
    /// shows and whenever it changes: bodies painted by the full engine are painted at
    /// exactly that width, never scaled afterwards.
    callback body-width-changed(length);
    /// Words chosen with the mouse in a body painted by the full engine: (message id,
    /// tile, where across and down the tile as fractions, 0 pressed / 1 dragged).
    callback body-select(int, int, float, float, int);
    /// A key the message's text had no use for, to hand to the shortcuts.
    callback keys-left(string);
    /// No tile asks for pixels while this is set: the window is hidden, and what was
    /// painted has been given back.
    in property <bool> bodies-suspended;

    // The entrance of a newly opened thread: 0 on the change, 1 one frame later, and
    // the animations on `fil` travel between the two.
    property <float> entree: 1;
    property <int> courant: root.message.id;
    changed courant => {
        root.entree = 0;
        arrivee.running = true;
        root.reply-recipients-wanted();
    }
    arrivee := Timer {
        interval: 16ms;
        running: false;
        triggered => {
            self.running = false;
            root.entree = 1;
        }
    }

    /// Toutes les pièces jointes sont-elles montrées ?
    ///
    /// Quatre par défaut. Douze pastilles sur trois rangs mangeraient la moitié du
    /// volet pour un message qu'on est venu lire ; « +8 » tient sur la même ligne et
    /// dit exactement ce qui manque.
    in-out property <bool> attachments-expanded;

    if root.empty: Rectangle {
        VerticalLayout {
            alignment: center;
            Text {
                text: "No conversation selected.";
                color: Tokens.text-muted;
                font-size: Tokens.size-body;
                horizontal-alignment: center;
            }
        }
    }

    // The toolbar, across the top of the reader: what moves the conversation on, in
    // words with their keys, then what marks it, as icons. Every one of these was
    // once reachable only from the palette or a key nobody had been told about.
    // What moves the conversation on, in words with their keys; then what marks it,
    // as icons. Every one of these was once reachable only from the palette or a key
    // nobody had been told about.
    if !root.empty: Toolbar {
        vertical-stretch: 0;
        Button {
            y: (parent.height - self.height) / 2;
            text: "Done";
            label: "Mark as done";
            icon: Icons.check;
            shortcut: "E";
            kind: ButtonKind.primary;
            size: ButtonSize.sm;
            clicked => { root.mark-done(); }
        }
        Rectangle { width: 4px; }
        // Snooze asks until when: later today, tomorrow morning, the weekend, next
        // week. "S" goes straight to tomorrow morning.
        snooze-button := Button {
            y: (parent.height - self.height) / 2;
            text: "Snooze";
            label: "Snooze…";
            icon: Icons.clock;
            shortcut: "S";
            kind: ButtonKind.ghost;
            size: ButtonSize.sm;
            clicked => {
                root.snooze-menu(self.absolute-position.x,
                    self.absolute-position.y + self.height + 6px);
            }
        }
        Button {
            y: (parent.height - self.height) / 2;
            text: "Waiting";
            label: "Move to Waiting";
            icon: Icons.hourglass;
            shortcut: "W";
            kind: ButtonKind.ghost;
            size: ButtonSize.sm;
            clicked => { root.waiting(); }
        }
        Button {
            y: (parent.height - self.height) / 2;
            text: "To task";
            label: "Make it a task";
            icon: Icons.task;
            shortcut: "T";
            kind: ButtonKind.ghost;
            size: ButtonSize.sm;
            clicked => { root.to-task(); }
        }

        Rectangle { horizontal-stretch: 1; }

        IconButton {
            y: (parent.height - self.height) / 2;
            icon: Icons.star;
            label: root.starred ? "Remove star" : "Star";
            shortcut: "F";
            button-size: 30px;
            filled: root.starred;
            tinted: root.starred;
            tint: Tokens.warning;
            clicked => { root.toggle-star(); }
        }
        IconButton {
            y: (parent.height - self.height) / 2;
            icon: Icons.archive;
            label: "Archive";
            shortcut: "A";
            button-size: 30px;
            clicked => { root.archive(); }
        }
        IconButton {
            y: (parent.height - self.height) / 2;
            icon: Icons.trash;
            label: "Delete";
            shortcut: "Del";
            button-size: 30px;
            danger: true;
            clicked => { root.delete-thread(); }
        }
        // The conversation alone on screen: the accounts and the list step aside.
        IconButton {
            y: (parent.height - self.height) / 2;
            icon: root.focused ? Icons.collapse : Icons.expand;
            label: root.focused ? "Leave full screen" : "Read full screen";
            button-size: 30px;
            active: root.focused;
            clicked => { root.toggle-focus(); }
        }
        // The rest, less often: forward, read or unread, the source.
        IconButton {
            y: (parent.height - self.height) / 2;
            icon: Icons.more;
            label: "More actions";
            button-size: 30px;
            clicked => {
                root.more-menu(self.absolute-position.x + self.width,
                    self.absolute-position.y + self.height + 6px);
            }
        }
    }

    if !root.empty: VerticalLayout {
        padding-top: 0px;
        padding-bottom: 18px;
        spacing: 14px;

        // Le fil, du plus ancien au plus récent, sous son sujet.
        //
        // C'était **un seul message** : le dernier. Un échange de douze en montrait un
        // et cachait onze, alors que la liste affichait « 12 » à côté du sujet — le
        // compte promettait une conversation et la colonne livrait un message.
        //
        // Les précédents sont repliés : en-tête et une ligne d'aperçu. Ce n'est pas
        // seulement une question de place, c'est ce qui rend la chose tenable — un
        // corps rendu coûte une rasterisation, et en faire douze pour en lire un
        // paierait onze fois pour rien. Le corps arrive au dépliage.
        //
        // The column is generous: the thread runs up to 900 px wide and is centred
        // beyond that, each message on a card of its own.
        defil := ScrollView {
            vertical-stretch: 1;
            viewport-height: fil.preferred-height + 26px + 20px;

            fil := VerticalLayout {
                x: max(40px, (defil.visible-width - root.column) / 2);
                y: 26px + (1 - root.entree) * 10px;
                width: min(root.column, defil.visible-width - 80px);
                // Its own height: given the viewport's, the layout spread the extra
                // room between the subject and the first card.
                height: self.preferred-height;
                spacing: 10px;
                // A new thread arrives rather than appears: ten pixels and a fade,
                // over a fifth of a second. Enough to say "this changed", too short
                // to wait for.
                opacity: 0.4 + 0.6 * root.entree;
                animate y, opacity { duration: 200ms; easing: ease-out; }

                // The subject, large; under it the mailbox it came to, and how many.
                VerticalLayout {
                    spacing: 6px;
                    padding-bottom: 10px;
                    Text {
                        text: root.message.subject;
                        font-family: Tokens.font-display;
                        font-size: 22px;
                        font-weight: 600;
                        color: Tokens.text;
                        wrap: word-wrap;
                    }
                    HorizontalLayout {
                        spacing: 12px;
                        HorizontalLayout {
                            spacing: 6px;
                            horizontal-stretch: 0;
                            if root.account-email != "": Rectangle {
                                y: (parent.height - self.height) / 2;
                                width: 7px;
                                height: 7px;
                                border-radius: 3.5px;
                                background: root.account-tint;
                            }
                            Text {
                                text: root.account-email;
                                font-size: 12.5px;
                                color: Tokens.text-secondary;
                                vertical-alignment: center;
                                overflow: elide;
                                max-width: self.preferred-width;
                            }
                        }
                        // Where it is: a small folder mark and its name, quiet; red
                        // only for the places mail goes to be gone.
                        // Over "Inbox +2", every folder the conversation is in.
                        if root.folder-label != "": Rectangle {
                            horizontal-stretch: 0;
                            width: dossier.preferred-width;
                            dossier := HorizontalLayout {
                                spacing: 4px;
                                Icon {
                                    y: (parent.height - self.height) / 2;
                                    data: Icons.folder;
                                    size: 13px;
                                    tint: root.folder-alarming ? Tokens.error : Tokens.text-muted;
                                }
                                Text {
                                    text: root.folder-label;
                                    // "Inbox" alone says nothing to a screen reader.
                                    accessible-label: "In " + (root.folder-all != "" ? root.folder-all : root.folder-label);
                                    font-size: 12.5px;
                                    color: root.folder-alarming ? Tokens.error : Tokens.text-secondary;
                                    vertical-alignment: center;
                                }
                            }
                            if root.folder-all != "": TouchArea {}
                            if root.folder-all != "": Tooltip {
                                text: @markdown("In \{root.folder-all}");
                            }
                        }
                        if root.messages.length > 1: Text {
                            text: root.messages.length + " messages";
                            font-size: 12.5px;
                            color: Tokens.text-muted;
                            vertical-alignment: center;
                            horizontal-stretch: 0;
                        }
                        Rectangle { horizontal-stretch: 1; }
                    }
                }

                // Each message on a card of its own, framed: the folded ones a single
                // line, the open one with its header and body, so the change of author
                // reads at a glance.
                for message[i] in root.messages: Rectangle {
                    height: carte.preferred-height;
                    border-radius: Tokens.radius-large;
                    border-width: 1px;
                    border-color: message.expanded ? Tokens.border-strong : Tokens.border;
                    background: Tokens.surface;

                carte := VerticalLayout {
                    // Nothing inside widens the card past the column: a line too long
                    // to wrap is cut, never a card thousands of pixels wide.
                    min-width: 0px;
                    padding-left: 16px;
                    padding-right: 16px;
                    padding-top: 4px;
                    padding-bottom: message.expanded ? 20px : 4px;
                    spacing: 10px;

                    // L'en-tête, et la poignée qui déplie et replie — sauf quand il n'y
                    // a qu'un message.
                    //
                    // Dans ce cas il ne servait à rien deux fois. Il répétait mot pour
                    // mot ce que le titre venait de dire trois lignes plus haut, nom de
                    // l'expéditeur et heure comprises ; et son chevron proposait de
                    // replier le seul message du fil, c'est-à-dire de masquer la totalité
                    // de ce qu'on venait d'ouvrir. Un fil d'un message est le cas le plus
                    // fréquent de tous.
                    // The sender's face and name, their address when open, the date.
                    // A click folds or unfolds it, when there is more than one.
                    Rectangle {
                        height: 48px;

                        HorizontalLayout {
                            spacing: 10px;

                            Avatar {
                                y: (parent.height - self.height) / 2;
                                initials: message.initials;
                                tint: message.tint;
                                size: 30px;
                            }

                            Text {
                                text: message.from;
                                font-size: Tokens.size-body;
                                font-weight: Tokens.weight-bold;
                                color: Tokens.text;
                                vertical-alignment: center;
                                overflow: elide;
                                horizontal-stretch: 0;
                                max-width: self.preferred-width;
                            }

                            // Open: the address, and to whom. Folded, the preview
                            // takes the room left: it is what finds a message in a
                            // thread without opening four.
                            if message.expanded: Text {
                                text: message.from-address + (message.to != "" ? " · to " + message.to : "");
                                font-size: 12px;
                                color: Tokens.text-muted;
                                vertical-alignment: center;
                                overflow: elide;
                                horizontal-stretch: 1;
                            }
                            if !message.expanded: Text {
                                text: message.preview;
                                font-size: 12.5px;
                                color: Tokens.text-muted;
                                vertical-alignment: center;
                                overflow: elide;
                                horizontal-stretch: 1;
                            }

                            Text {
                                text: message.date;
                                font-size: 12px;
                                color: Tokens.text-muted;
                                vertical-alignment: center;
                            }
                        }

                        if root.messages.length > 1: Rectangle {
                            accessible-role: button;
                            accessible-label: (message.expanded ? "Collapse " : "Expand ")
                                + message.from + ", " + message.date;
                            accessible-expanded: message.expanded;
                            accessible-action-default => { root.toggle-message(message.id); }

                            TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.toggle-message(message.id); }
                            }
                        }
                    }

                    // The invitation this message carries, set against the
                    // calendar: on this message only, the one that brought it.
                    if message.expanded && message.invite-state > 0: InviteBanner {
                        state: message.invite-state;
                        title: message.invite-title;
                        when: message.invite-when;
                        can-reply: message.invite-can-reply;
                        reply: message.invite-reply;
                        accept => { root.invite-accept(message.id); }
                        open => { root.invite-open(message.invite-key, message.invite-day); }
                        answer(a) => { root.invite-answer(message.id, a); }
                    }

                    if message.expanded && (message.blocked-images > 0
                        || message.has-tracker): RemoteContentBanner {
                        blocked-images: message.blocked-images;
                        has-tracker: message.has-tracker;
                        load-images => { root.load-images(); }
                    }

                    // Le corps arrive encore. Sans cette ligne, l'écran était
                    // vide et muet, et rien ne distinguait « ça charge » de « ce
                    // message ne contient rien ».
                    if message.expanded && message.body-loading: LoadingLine {
                        label: "Loading the message…";
                    }

                    // The body as a column of tiles. Each has its full height from
                    // the start, so the scroll bar is right; its pixels exist only
                    // while it is within a screen of the visible part.
                    if message.expanded && !message.body-loading && message.body-is-image: VerticalLayout {
                        for tuile[t] in message.body-tiles: BodyTile {
                            tile: tuile;
                            // Where the tile is, relative to the visible part.
                            top: self.absolute-position.y - defil.absolute-position.y;
                            visible-height: defil.height;
                            suspended: root.bodies-suspended;
                            wanted => { root.body-tile-wanted(message.id, t); }
                            released => { root.body-tile-released(message.id, t); }
                            select(fx, fy, phase) => { root.body-select(message.id, t, fx, fy, phase); }
                            resized(w) => {
                                if (t == 0) {
                                    root.body-width-changed(w);
                                }
                            }
                        }
                    }

                    // Text bodies sit under the name, clear of the face.
                    // The words can be selected; what the keyboard does meanwhile that
                    // text has no use for (e, j, r…) goes on to the shortcuts.
                    if message.expanded && !message.body-loading && !message.body-is-image: FocusScope {
                    key-pressed(event) => {
                        root.keys-left(event.text);
                        accept
                    }
                    VerticalLayout {
                        padding-left: 40px;
                        spacing: 10px;
                        for block in message.blocks: MessageBlock {
                            block: block;
                        }

                        // Le corps est arrivé et ne donne rien à lire : une page
                        // faite d'images bloquées, ou un HTML vidé par
                        // l'assainissement. Le dire, plutôt que de laisser croire
                        // que ça charge encore.
                        if message.blocks.length == 0: Text {
                            text: "This message has nothing to display.";
                            font-family: Tokens.font-family;
                            font-size: Tokens.size-body;
                            color: Tokens.text-muted;
                        }
                    }
                    }

                    // The attachments of the message being read, as file cards
                    // under its body: what it is, how big.
                    if message.expanded && message.id == root.message.id
                        && root.message.attachments.length > 0: Attachments {
                        padding-left: message.body-is-image ? 0px : 40px;
                        padding-top: 6px;
                        files: root.message.attachments;
                        expanded <=> root.attachments-expanded;
                        open(i) => { root.open-attachment(i); }
                        save(i) => { root.save-attachment(i); }
                    }
                } // carte
                }
            }
        }

        // La réponse est intégrée au bas du fil, jamais dans une fenêtre à part :
        // répondre est le geste qui fait avancer le workflow, il ne doit rien
        // recouvrir.
        // One line until it is written in; it grows with what is written, up to a
        // few lines. It lines up with the thread above it.
        Rectangle {
            vertical-stretch: 0;
            height: root.reply-text == "" ? 84px : 160px;

            Rectangle {
                x: max(40px, (root.width - root.column) / 2);
                width: min(root.column, root.width - 80px);
                border-radius: Tokens.radius-large;
                border-width: 1px;
                border-color: champ.has-focus ? Tokens.accent : Tokens.border-strong;
                background: Tokens.surface;

                VerticalLayout {
                    padding: 4px;
                    padding-bottom: 6px;
                    spacing: 0px;

                    champ := TextArea {
                        bare: true;
                        accessible-label: "Your reply";
                        text <=> root.reply-text;
                        placeholder-text: "Reply to " + root.message.from + "…";
                        font-size: Tokens.size-body;
                        min-height: 36px;
                    }

                    HorizontalLayout {
                        spacing: 6px;
                        alignment: end;
                        height: 28px;
                        // Each says, pointed at, to whom it sends.
                        RecipientsButton {
                            text: "Reply all";
                            icon: Icons.reply-all;
                            kind: ButtonKind.ghost;
                            enabled: root.reply-text != "";
                            to: root.reply-all-to;
                            cc: root.reply-all-cc;
                            bcc: root.reply-all-bcc;
                            clicked => { root.reply-all(); }
                        }
                        // Sent, the reply leaves the field; the notice at the bottom
                        // of the window can take it back for a few seconds.
                        RecipientsButton {
                            text: "Send";
                            icon: Icons.send;
                            kind: ButtonKind.secondary;
                            enabled: root.reply-text != "";
                            to: root.reply-to;
                            cc: root.reply-cc;
                            bcc: root.reply-bcc;
                            clicked => { root.send(); }
                        }
                    }
                }
            }
        }
    }
}
