import { Layout } from "@iris/theme/layout.slint";
import { Tokens } from "@iris/theme/tokens.slint";
import { Icon, Icons, IconButton } from "@iris/base/icons.slint";
import { MessageData, MessageBlockData, BodyTileData, AttachmentData } from "@iris/types.slint";
import { LoadingLine } from "@iris/base/spinner.slint";
import { ScrollView } from "@iris/controls/scroll.slint";
import { Button, ButtonKind, ButtonSize, Link } from "@iris/controls/button.slint";
import { Toolbar } from "@iris/layout/frames.slint";
import { MenuEntry, MenuHeader, MenuSeparator, MenuSurface } from "@iris/layout/menu.slint";
import { Avatar } from "@iris/base/atoms.slint";

// What is selected in the messages shown as text, for the menu of a right-click.
//
// Each block of a message is a text of its own, and a text forgets its selection the
// moment it loses the keyboard — which closing the menu does. So the block holding a
// selection keeps where it runs, and copies it when asked, after it has let go.
export global MessageText {
    /// Words are selected in a block of a text message.
    in-out property <bool> has-selection;
    /// Raised by each block that takes the selection: the block holding the latest
    /// number holds it.
    in-out property <int> holder;
    /// Raised to have the holder put its selection on the clipboard.
    in-out property <int> copy-serial;
    /// The message every block of which "Select all" selected, -1 for none.
    in-out property <int> all-selected: -1;
}

// Un bloc du corps du message.
//
// Le corps arrive déjà découpé en blocs par le moteur de rendu : l'interface ne voit
// jamais de HTML, et ne peut donc rien en exécuter.
// Words of a message: read as text, and selected with the mouse like any text, then
// copied. Never written into: the keys it has no use for go on to the shortcuts.
component SelectableText inherits TextInput {
    /// The message the words belong to, for "Select all".
    in property <int> message: -1;

    read-only: true;
    single-line: false;
    wrap: word-wrap;
    selection-background-color: Tokens.accent.transparentize(0.7);
    selection-foreground-color: Tokens.text;
    text-cursor-width: 0px;

    // Words highlighted here, while this block has the keyboard.
    property <bool> live: root.has-focus
        && root.anchor-position-byte-offset != root.cursor-position-byte-offset;
    // This block's number when it last took the selection, and where it ran.
    property <int> ticket;
    property <int> kept-anchor;
    property <int> kept-cursor;

    changed live => {
        if (root.live) {
            MessageText.holder += 1;
            root.ticket = MessageText.holder;
            MessageText.has-selection = true;
            root.keep();
        } else if (root.ticket == MessageText.holder) {
            MessageText.has-selection = false;
        }
    }
    changed anchor-position-byte-offset => { root.keep(); }
    changed cursor-position-byte-offset => { root.keep(); }

    function keep() {
        if (root.live) {
            root.kept-anchor = root.anchor-position-byte-offset;
            root.kept-cursor = root.cursor-position-byte-offset;
        }
        // Words chosen by hand end a "Select all".
        if (root.has-focus) {
            MessageText.all-selected = -1;
        }
    }

    // Copied once the menu has closed and taken the keyboard, from what was kept.
    property <int> copy-serial: MessageText.copy-serial;
    changed copy-serial => {
        if (root.ticket > 0 && root.ticket == MessageText.holder
            && root.kept-anchor != root.kept-cursor) {
            root.set-selection-offsets(root.kept-anchor, root.kept-cursor);
            root.copy();
            if (!root.has-focus) {
                root.clear-selection();
            }
        }
    }

    // "Select all" highlights every block of the message; anything else chosen clears
    // them. The block with the keyboard keeps what is being chosen in it.
    property <bool> whole: root.message >= 0 && MessageText.all-selected == root.message;
    changed whole => {
        if (root.whole) {
            root.select-all();
        } else if (!root.has-focus) {
            root.clear-selection();
        }
    }
}

// Words with a link in them: drawn with their marks, the links in the accent, and a
// click on one handed up. Only those blocks: the others stay text that can be selected.
//
// Given its width by the frame around it and its height from that width: wrapped text
// asked for its height before it had a width came out a line tall, the other lines
// drawn over the blocks below (see "Wrapped text and its height").
component LinkedText inherits Rectangle {
    in property <styled-text> text;
    in property <length> font-size: Tokens.size-body;
    in property <string> font-family;
    in property <color> text-color: Tokens.text;
    /// The one link of the block and its words, empty when it has several.
    in property <string> target;
    in property <string> target-text;
    callback link(string);
    /// The pointer came over the words (true) or left them, with the block's link.
    callback hovered(bool, string, string);

    height: mots.preferred-height;

    // The words take every press, the right button's too, before anything around
    // them sees it: this area only tells which block is under the pointer, and the
    // window's own events (main.rs) open the menu of its link on a right-click.
    TouchArea {
        width: 100%;
        height: 100%;
        changed has-hover => { root.hovered(self.has-hover, root.target, root.target-text); }
        // Said again at every move: the window forgets it at each one (main.rs).
        changed mouse-x => { if (self.has-hover) { root.hovered(true, root.target, root.target-text); } }
        changed mouse-y => { if (self.has-hover) { root.hovered(true, root.target, root.target-text); } }

        mots := StyledText {
            x: 0px;
            y: 0px;
            width: parent.width;
            height: self.preferred-height;
            vertical-alignment: top;
            text: root.text;
            default-color: root.text-color;
            default-font-size: root.font-size;
            default-font-family: root.font-family;
            link-color: Tokens.accent;
            link-clicked(l) => { root.link(l); }
        }
    }
}

component MessageBlock inherits Rectangle {
    in property <MessageBlockData> block;
    /// The message the block belongs to.
    in property <int> message: -1;
    /// A link of the block clicked: its target, as the message wrote it.
    callback link(string);
    /// The pointer over words with a link, or leaving them: (over, link, its words).
    callback link-hovered(bool, string, string);

    height: layout.preferred-height;

    layout := VerticalLayout {
        if root.block.kind == "rule": Rectangle {
            height: 1px;
            background: Tokens.border;
        }

        // Dessinée, pas tapée. C'était « ▣ », un caractère qui existe en Unicode et
        // dans presque aucune police d'interface : ce qui s'affichait devant chaque
        // image bloquée était le carré vide de la police de repli. La même faute que
        // les quatre marqueurs de la liste, au même endroit du raisonnement, corrigée
        // là-bas et pas ici.
        // L'image, quand le message la porte. Sinon, ce qu'on peut en dire.
        //
        // Elle n'était jamais dessinée : la source était lue seulement pour savoir si
        // elle était bloquée, et le reste jeté. Un logo de signature déjà présent dans
        // le message s'affichait donc comme une icône avec le mot « image » à côté —
        // et dans un fil de dix messages signés de trois pastilles, cela faisait trente
        // lignes qui ne montraient rien.
        //
        // À sa taille naturelle, bornée à la largeur de la colonne. Étirer une pastille
        // de cent pixels sur huit cents la rendrait floue et occuperait l'écran pour
        // une décoration ; c'est précisément l'accumulation dont il s'agit.
        // La largeur vient de la mise en page, jamais du parent : la lire ici ferait
        // dépendre la largeur du bloc de la largeur du bloc, et le compilateur Slint
        // refuse la boucle — à juste titre, puisqu'elle n'a pas de solution.
        //
        // La hauteur est celle de l'image, et `contain` réduit si la colonne est plus
        // étroite. Le décodeur borne déjà la largeur à celle de la colonne de lecture,
        // donc le cas courant est un dessin à l'échelle un.
        if root.block.kind == "image" && root.block.has-picture: Image {
            source: root.block.picture;
            image-fit: contain;
            horizontal-alignment: left;
            height: root.block.picture.height * 1px;
        }

        if root.block.kind == "image" && !root.block.has-picture: HorizontalLayout {
            spacing: Tokens.space-2;
            Icon {
                y: (parent.height - self.height) / 2;
                data: Icons.image;
                size: 14px;
                tint: Tokens.text-muted;
            }
            Text {
                text: root.block.text;
                color: Tokens.text-muted;
                font-size: Tokens.size-small;
                font-italic: true;
                vertical-alignment: center;
                overflow: elide;
            }
        }

        if root.block.kind == "heading" && !root.block.has-link: SelectableText {
            message: root.message;
            text: root.block.text;
            font-size: Tokens.size-title + (3 - min(root.block.level, 3)) * 2px;
            font-weight: Tokens.weight-bold;
            color: Tokens.text;
        }

        if root.block.kind == "heading" && root.block.has-link: LinkedText {
            text: root.block.rich;
            font-size: Tokens.size-title + (3 - min(root.block.level, 3)) * 2px;
            link(l) => { root.link(l); }
            target: root.block.link;
            target-text: root.block.link-text;
            hovered(on, l, t) => { root.link-hovered(on, l, t); }
        }

        if root.block.kind == "code": Rectangle {
            background: Tokens.surface;
            border-radius: Tokens.radius-small;
            height: code-text.preferred-height + Tokens.space-4;
            code-text := SelectableText {
                message: root.message;
                x: Tokens.space-2;
                y: Tokens.space-2;
                width: parent.width - Tokens.space-4;
                text: root.block.text;
                font-family: Tokens.font-mono;
                font-size: Tokens.size-small;
                color: Tokens.text-secondary;
            }
        }

        // Une citation est repliée par défaut au-delà du premier niveau : dans un fil
        // de dix réponses, afficher les neuf précédentes noie la seule ligne utile.
        // A bar per level of quoting, rounded, in the accent kept faint: what was
        // quoted reads as set aside, the deeper the further in.
        // The words in a column of their own, set in from the bars, never in a row
        // beside them: a row measured their height before their width, as if on one
        // line, and on a phone the wrapped lines ran over the next block.
        if root.block.kind == "quote": citation := Rectangle {
            property <int> niveaux: max(1, root.block.depth);
            height: cite.preferred-height;
            for niveau in citation.niveaux: Rectangle {
                x: niveau * (3px + Tokens.space-2);
                y: 0px;
                width: 3px;
                height: citation.height;
                border-radius: 1.5px;
                background: Tokens.accent.transparentize(0.6);
            }
            cite := VerticalLayout {
                padding-left: citation.niveaux * 3px + (citation.niveaux - 1) * Tokens.space-2
                    + Tokens.space-3;
                if !root.block.has-link: SelectableText {
                    message: root.message;
                    text: root.block.text;
                    font-size: Tokens.size-body;
                    color: Tokens.text-muted;
                }
                if root.block.has-link: LinkedText {
                    text: root.block.rich;
                    text-color: Tokens.text-muted;
                    link(l) => { root.link(l); }
                    target: root.block.link;
                    target-text: root.block.link-text;
                    hovered(on, l, t) => { root.link-hovered(on, l, t); }
                }
            }
        }

        // The same for a list's item: the bullet drawn beside, the words in a column.
        if root.block.kind == "list": entree := Rectangle {
            property <length> retrait: root.block.depth * Tokens.space-4;
            height: puce.preferred-height;
            Text {
                x: entree.retrait;
                y: 0px;
                text: "•";
                color: Tokens.text-secondary;
            }
            puce := VerticalLayout {
                padding-left: entree.retrait + Tokens.space-4;
                if !root.block.has-link: SelectableText {
                    message: root.message;
                    text: root.block.text;
                    font-size: Tokens.size-body;
                    color: Tokens.text;
                }
                if root.block.has-link: LinkedText {
                    text: root.block.rich;
                    link(l) => { root.link(l); }
                    target: root.block.link;
                    target-text: root.block.link-text;
                    hovered(on, l, t) => { root.link-hovered(on, l, t); }
                }
            }
        }

        // Wrapped, like the rest. Unwrapped, a newsletter laid out in one table made a
        // single line tens of thousands of pixels long; the card around it grew as wide,
        // and the renderer stopped the application drawing its rounded corner.
        if root.block.kind == "table" && !root.block.has-link: SelectableText {
            message: root.message;
            text: root.block.text;
            font-family: Tokens.font-mono;
            font-size: Tokens.size-small;
            color: Tokens.text-secondary;
        }

        if root.block.kind == "table" && root.block.has-link: LinkedText {
            text: root.block.rich;
            font-family: Tokens.font-mono;
            font-size: Tokens.size-small;
            text-color: Tokens.text-secondary;
            link(l) => { root.link(l); }
            target: root.block.link;
            target-text: root.block.link-text;
            hovered(on, l, t) => { root.link-hovered(on, l, t); }
        }

        if root.block.kind == "paragraph" && !root.block.has-link: SelectableText {
            message: root.message;
            text: root.block.text;
            font-size: Tokens.size-body;
            font-weight: root.block.bold ? Tokens.weight-bold : Tokens.weight-body;
            font-italic: root.block.italic;
            color: Tokens.text;
        }

        // Bold and italic are in the words' own marks.
        if root.block.kind == "paragraph" && root.block.has-link: LinkedText {
            text: root.block.rich;
            link(l) => { root.link(l); }
            target: root.block.link;
            target-text: root.block.link-text;
            hovered(on, l, t) => { root.link-hovered(on, l, t); }
        }
    }
}

// Le bandeau d'avertissement des contenus distants.
component RemoteContentBanner inherits Rectangle {
    in property <int> blocked-images;
    in property <bool> has-tracker;

    callback load-images();

    height: 32px;
    border-radius: Tokens.radius-small;
    background: Tokens.surface;
    border-width: 1px;
    border-color: Tokens.border;

    HorizontalLayout {
        padding-left: Tokens.space-3;
        padding-right: Tokens.space-2;
        spacing: Tokens.space-2;

        Text {
            // « 1 remote image(s) blocked » est une phrase qu'un programme écrit et
            // qu'aucune personne ne prononce — et elle apparaît à l'endroit précis où
            // l'on demande à quelqu'un de décider s'il fait confiance à un inconnu.
            // Avoir l'air d'un formulaire à ce moment-là n'est pas gratuit.
            text: root.has-tracker
                ? "This sender is trying to learn when you read this message."
                : (root.blocked-images == 1
                    ? "1 remote image blocked."
                    : root.blocked-images + " remote images blocked.");
            font-size: Tokens.size-small;
            color: root.has-tracker ? Tokens.warning : Tokens.text-secondary;
            vertical-alignment: center;
            overflow: elide;
        }

        Rectangle {}

        // The theme's accent, not the platform's button. A stock Button here brought
        // the operating system's own blue into a window that has exactly one colour,
        // and it is the only control in the reading pane that did.
        Rectangle {
            width: 62px;
            height: 22px;
            y: (parent.height - self.height) / 2;
            border-radius: Tokens.radius-small;
            background: montrer.has-hover
                ? Tokens.accent
                : Tokens.accent.transparentize(0.12);
            animate background { duration: Tokens.instant; }

            accessible-role: button;
            accessible-label: "Show the remote images in this message";
            accessible-action-default => { root.load-images(); }

            Text {
                text: "Show";
                font-size: Tokens.size-small;
                font-weight: Tokens.weight-bold;
                color: Tokens.accent-text;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            montrer := TouchArea {
                clicked => { root.load-images(); }
            }
        }
    }
}

// Leaving the mailing list a message came from, beside its sender: asked once, on the
// spot, then said done. A slip of the mouse does not unsubscribe anyone.
component UnsubscribeLink inherits HorizontalLayout {
    // 1 can leave, 2 has left.
    in property <int> state;
    callback confirmed();

    in-out property <bool> asking;

    spacing: 2px;
    horizontal-stretch: 0;

    if root.state == 2: Text {
        text: "Unsubscribed";
        font-size: 12px;
        color: Tokens.text-muted;
        vertical-alignment: center;
    }
    if root.state == 1 && !root.asking: Link {
        text: "Unsubscribe";
        label: "Unsubscribe from this mailing list";
        clicked => { root.asking = true; }
    }
    if root.state == 1 && root.asking: Text {
        text: "Stop this mail?";
        font-size: 12px;
        color: Tokens.text-secondary;
        vertical-alignment: center;
    }
    if root.state == 1 && root.asking: Link {
        text: "Unsubscribe";
        label: "Confirm: unsubscribe from this mailing list";
        clicked => {
            root.asking = false;
            root.confirmed();
        }
    }
    if root.state == 1 && root.asking: Link {
        text: "Cancel";
        clicked => { root.asking = false; }
    }
}

// One tile of a body painted by the full engine.
//
// It asks for its pixels when it comes within a screen of the visible part, and gives
// them back when it goes further. The margin is what makes scrolling look instant: the
// next tile is painted before it shows.
component BodyTile inherits Rectangle {
    in property <BodyTileData> tile;
    in property <length> top;
    in property <length> visible-height;
    in property <bool> suspended;

    callback wanted();
    callback released();
    callback resized(length);
    /// Pressed (0) or dragged to (1), as fractions of the tile across and down; a
    /// drag past the tile gives fractions beyond 0 and 1.
    callback select(float, float, int);
    /// A click that dragged nothing, at fractions of the tile: a link there opens.
    callback link(float, float);
    /// Whether a link is under the pointer, at fractions of the tile.
    callback link-at(float, float) -> bool;
    /// A right-click, at fractions of the tile and at a point of the window.
    callback menu(float, float, length, length);

    accessible-role: image;
    accessible-label: "Message body";

    // A pointing hand over a link, the text cursor elsewhere.
    property <bool> over-link;

    // Only once laid out. Before the first layout every tile is zero pixels wide,
    // hence zero high, and they all sit at the top: every one of them looked near,
    // and opening a newsletter painted all of it.
    property <bool> near: !root.suspended
        && root.width > 0 && root.visible-height > 0
        && root.top < root.visible-height * 2
        && root.top + root.height > -root.visible-height;

    height: root.width * root.tile.aspect;
    background: white;

    // The first look is taken one turn of the event loop after creation, once the
    // column has been laid out. Taken in `init`, it saw every tile at the top of a
    // column not yet measured, and asked for all of them.
    property <bool> armed;
    Timer {
        interval: 0ms;
        running: !root.armed;
        triggered => {
            root.armed = true;
            root.resized(root.width);
            if (root.near) {
                root.wanted();
            }
        }
    }
    changed width => {
        if (root.armed) {
            root.resized(root.width);
        }
    }
    changed near => {
        if (!root.armed) {
            return;
        }
        if (root.near) {
            root.wanted();
        } else {
            root.released();
        }
    }

    if root.tile.ready: Image {
        width: 100%;
        height: 100%;
        source: root.tile.image;
        image-fit: fill;
    }

    // Text selected as on a page: pressed, then dragged, even past the tile. A click
    // that selected nothing follows the link under it (Rust tells which: a drag that
    // ends inside the tile is a click too, and leaves words selected).
    TouchArea {
        mouse-cursor: root.over-link ? MouseCursor.pointer : MouseCursor.text;
        pointer-event(event) => {
            if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down
                && root.width > 0 && root.height > 0) {
                root.select(self.mouse-x / root.width, self.mouse-y / root.height, 0);
            }
            if (event.button == PointerEventButton.right && event.kind == PointerEventKind.down
                && root.width > 0 && root.height > 0) {
                root.menu(self.mouse-x / root.width, self.mouse-y / root.height,
                    self.absolute-position.x + self.mouse-x,
                    self.absolute-position.y + self.mouse-y);
            }
            if (event.kind == PointerEventKind.move && !self.pressed
                && root.width > 0 && root.height > 0) {
                root.over-link = root.link-at(self.mouse-x / root.width, self.mouse-y / root.height);
            }
        }
        moved => {
            if (self.pressed && root.width > 0 && root.height > 0) {
                root.select(self.mouse-x / root.width, self.mouse-y / root.height, 1);
            }
        }
        clicked => {
            if (root.width > 0 && root.height > 0) {
                root.link(self.mouse-x / root.width, self.mouse-y / root.height);
            }
        }
        changed has-hover => {
            if (!self.has-hover) {
                root.over-link = false;
            }
        }
    }
}

// The attachments of a message, as file cards: a badge for the kind, the name, the
// size.
//
// Une par carte, avec son type et sa taille : « devis.pdf » seul ne dit pas s'il faut
// l'ouvrir maintenant ou attendre d'être au bureau, et « PDF · 2,4 Mo » le dit.
//
// As many to a row as the card has room for. Au-delà d'une rangée, les suivantes sont
// comptées plutôt que dessinées, et le décompte les montre toutes, rangée par rangée.
component Attachments inherits VerticalLayout {
    in property <[AttachmentData]> files;
    in-out property <bool> expanded;
    callback open(int);
    callback save(int);

    /// How many cards a row holds, the count included.
    property <int> par-rang: max(2, floor((root.width - root.padding-left) / 208px));
    /// How many show while folded: a row, less the place of the count when some
    /// are left over.
    property <int> montrees: root.files.length > root.par-rang ? root.par-rang - 1 : root.files.length;

    spacing: 8px;

    for rang[r] in root.expanded ? ceil(root.files.length / root.par-rang) : 1: HorizontalLayout {
    height: 52px;

    // Each card with the gap after it; those of other rows take no room at all.
    for piece[i] in root.files: Rectangle {
        property <bool> ici: root.expanded ? floor(i / root.par-rang) == r : i < root.montrees;
        width: self.ici ? 208px : 0px;
        visible: self.ici;

    fichier := Rectangle {
        property <bool> pdf: piece.kind == "PDF";
        property <bool> picture: piece.icon == "image";
        property <color> teinte: self.pdf ? Tokens.error : self.picture ? Tokens.success : Tokens.text-muted;
        x: 0px;
        width: 200px;
        border-radius: Tokens.radius-large;
        background: piece-touch.has-hover ? Tokens.surface-hover : transparent;
        border-width: 1px;
        border-color: Tokens.border-strong;
        animate background { duration: Tokens.instant; }

        // Le clic **ouvre**, et la flèche enregistre : neuf fois sur dix on veut
        // seulement regarder le fichier, pas le garder.
        accessible-role: button;
        accessible-label: "Open " + piece.name;
        accessible-description: piece.kind + ", " + piece.size;
        accessible-action-default => { root.open(i); }

        piece-touch := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.open(i); }
        }

        HorizontalLayout {
            padding-left: 8px;
            padding-right: 8px;
            spacing: 10px;

            // The kind, as a small coloured page.
            Rectangle {
                y: (parent.height - self.height) / 2;
                width: 30px;
                height: 36px;
                border-radius: 4px;
                background: fichier.teinte.transparentize(0.88);
                if fichier.pdf || fichier.picture: Text {
                    text: fichier.pdf ? "PDF" : "IMG";
                    font-size: 9px;
                    font-weight: 700;
                    color: fichier.teinte;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                Icon {
                    visible: !fichier.pdf && !fichier.picture;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    data: piece.icon == "archive" ? Icons.archive
                        : piece.icon == "table" ? Icons.list
                        : piece.icon == "envelope-closed" ? Icons.envelope-closed
                        : Icons.paperclip;
                    size: 15px;
                    tint: Tokens.text-secondary;
                }
            }

            VerticalLayout {
                alignment: center;
                spacing: 1px;
                horizontal-stretch: 1;
                Text {
                    text: piece.name;
                    font-size: 12.5px;
                    font-weight: 500;
                    color: Tokens.text;
                    overflow: elide;
                }
                Text {
                    text: piece.size;
                    font-size: 11.5px;
                    color: Tokens.text-muted;
                    overflow: elide;
                }
            }

            // Enregistrer, pour qui veut garder le fichier. Toujours présent, rarement
            // visible : un `if` le retirerait de l'arbre d'accessibilité, donc du
            // clavier et des lecteurs d'écran.
            Rectangle {
                width: 24px;
                height: 24px;
                y: (parent.height - self.height) / 2;
                border-radius: Tokens.radius-small;
                opacity: piece-touch.has-hover || garder.has-hover || Layout.touch-input ? 1.0 : 0.0;
                animate opacity { duration: Tokens.instant; }
                background: garder.has-hover ? Tokens.surface-active : transparent;

                accessible-role: button;
                accessible-label: "Save " + piece.name;
                accessible-action-default => { root.save(i); }

                Icon {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    data: Icons.download;
                    size: 14px;
                    tint: Tokens.text;
                }

                garder := TouchArea {
                    clicked => { root.save(i); }
                }
            }
        }
    } // fichier
    }

    if r == 0 && root.files.length > root.montrees && !root.expanded: Rectangle {
        width: 60px;
        border-radius: Tokens.radius-large;
        background: reste.has-hover ? Tokens.surface-hover : transparent;
        border-width: 1px;
        border-color: Tokens.border-strong;

        accessible-role: button;
        accessible-label: "Show all " + root.files.length + " attachments";
        accessible-action-default => { root.expanded = true; }

        Text {
            text: "+" + (root.files.length - root.montrees);
            font-size: 12.5px;
            color: Tokens.text-secondary;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        reste := TouchArea {
            clicked => { root.expanded = true; }
        }
    }

    Rectangle {}
    } // rang
}

// What the reading toolbar's menus hold: until when to snooze, and the rarer actions.
// An invitation over the message that carries it: what, when, and where it stands in
// the calendar, with the one thing to do about it.
component InviteBanner inherits Rectangle {
    /// 1 not in the calendar, 2 in it, 3 changed since, 4 cancelled but still in it,
    /// 5 cancelled and not in it.
    in property <int> state;
    in property <string> title;
    in property <string> when;
    /// It can be answered, and what was answered ("ACCEPTED", "TENTATIVE", "DECLINED").
    in property <bool> can-reply;
    in property <string> reply;
    callback accept();
    callback open();
    /// An answer sent to the organiser: 0 Accept, 1 Maybe, 2 Decline.
    callback answer(int);

    property <bool> annule: root.state >= 4;
    /// Answered with its buttons rather than added with one.
    property <bool> repondre: root.can-reply && root.state <= 3;

    height: rang.preferred-height;
    // An inset grey plate, as Mail shows an invitation; red only once it is cancelled.
    border-radius: 10px;
    border-width: root.annule ? 1px : 0px;
    border-color: Tokens.error.transparentize(0.6);
    background: root.annule ? Tokens.error.transparentize(0.94) : Tokens.group;

    accessible-role: groupbox;
    accessible-label: "Invitation: " + root.title + ", " + root.when;

    rang := HorizontalLayout {
        padding: 12px;
        padding-left: 14px;
        spacing: 12px;

        Rectangle {
            y: (parent.height - self.height) / 2;
            width: 34px;
            height: 34px;
            border-radius: Tokens.radius-medium;
            background: Tokens.surface;
            Icon {
                data: Icons.calendar;
                size: 18px;
                tint: root.annule ? Tokens.error : Tokens.accent;
            }
        }
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            horizontal-stretch: 1;
            Text {
                text: root.title;
                font-size: 13.5px;
                font-weight: 600;
                color: Tokens.text;
                overflow: elide;
            }
            Text {
                text: root.when + "  ·  " + (
                    root.reply == "ACCEPTED" && !root.annule ? "You accepted"
                    : root.reply == "TENTATIVE" && !root.annule ? "You said maybe"
                    : root.reply == "DECLINED" && !root.annule ? "You declined"
                    : root.state == 1 ? "Invitation"
                    : root.state == 2 ? "In your calendar"
                    : root.state == 3 ? "Changed since you added it"
                    : root.state == 4 ? "Cancelled by the organiser"
                    : "Cancelled");
                font-size: 12.5px;
                color: root.annule ? Tokens.error : Tokens.text-secondary;
                overflow: elide;
            }
        }
        // Answered: sent to the organiser, and the calendar follows. The answer given
        // is the filled button; another click changes it.
        // In a row of their own: a width forced on each button read its own preferred
        // width back and came out at nothing, the three words drawn over each other.
        if root.repondre: HorizontalLayout {
            spacing: 6px;
            horizontal-stretch: 0;
            for mot[i] in ["Accept", "Maybe", "Decline"]: Button {
                property <string> statut: i == 0 ? "ACCEPTED" : i == 1 ? "TENTATIVE" : "DECLINED";
                text: mot;
                label: mot + " the invitation";
                kind: root.reply == self.statut ? ButtonKind.primary : ButtonKind.secondary;
                size: ButtonSize.sm;
                clicked => { root.answer(i); }
            }
        }
        if root.state == 1 && !root.repondre: Button {
            y: (parent.height - self.height) / 2;
            text: "Add to calendar";
            icon: Icons.plus;
            kind: ButtonKind.primary;
            size: ButtonSize.sm;
            clicked => { root.accept(); }
        }
        if root.state == 3 && root.reply == "": Button {
            y: (parent.height - self.height) / 2;
            text: "Update";
            kind: ButtonKind.primary;
            size: ButtonSize.sm;
            clicked => { root.accept(); }
        }
        if root.state == 4: Button {
            y: (parent.height - self.height) / 2;
            text: "Remove from calendar";
            size: ButtonSize.sm;
            clicked => { root.accept(); }
        }
        if root.state == 2 || root.state == 3: Button {
            y: (parent.height - self.height) / 2;
            text: "Open";
            size: ButtonSize.sm;
            clicked => { root.open(); }
        }
    }
}

export component ReaderMenu inherits Rectangle {
    /// "snooze" or "more".
    in property <string> kind;
    in property <bool> unread;
    in property <length> menu-x;
    in property <length> menu-y;

    callback snooze(string);
    callback forward-thread();
    /// Answer in the composer: the sender, or everyone (true).
    callback reply(bool);
    callback toggle-unread();
    callback view-source();
    callback dismissed();
    // On a phone the ⋯ sheet also holds what the bar above the conversation does.
    in property <bool> starred;
    callback done();
    callback snooze-open();
    callback waiting();
    callback to-task();
    callback archive();
    callback toggle-star();
    callback delete-thread();

    TouchArea {
        width: 100%;
        height: 100%;
        clicked => { root.dismissed(); }
    }

    if root.kind == "snooze": MenuSurface {
        dismissed => { root.dismissed(); }
        available-width: root.width;
        available-height: root.height;
        menu-x: root.menu-x;
        menu-y: root.menu-y;
        menu-width: 230px;
        menu-height: reports.preferred-height + 8px;

        reports := VerticalLayout {
            padding: 4px;
            MenuHeader { text: "Snooze until"; }
            MenuEntry {
                icon: Icons.clock;
                label: "Later today";
                activated => { root.snooze("evening"); root.dismissed(); }
            }
            MenuEntry {
                icon: Icons.sun;
                label: "Tomorrow morning";
                shortcut: "S";
                activated => { root.snooze("tomorrow"); root.dismissed(); }
            }
            MenuEntry {
                icon: Icons.calendar;
                label: "This weekend";
                activated => { root.snooze("weekend"); root.dismissed(); }
            }
            MenuEntry {
                icon: Icons.arrow-right;
                label: "Next week";
                activated => { root.snooze("monday"); root.dismissed(); }
            }
        }
    }

    // The ways to answer, from the chevron beside Reply under the thread: it rises
    // above the button, its left edge on the button's.
    if root.kind == "reply": MenuSurface {
        dismissed => { root.dismissed(); }
        available-width: root.width;
        available-height: root.height;
        menu-x: root.menu-x;
        menu-y: root.menu-y - self.menu-height;
        menu-width: 220px;
        menu-height: reponses.preferred-height + 8px;

        reponses := VerticalLayout {
            padding: 4px;
            MenuEntry {
                icon: Icons.reply;
                label: "Reply";
                shortcut: "Ctrl+R";
                activated => { root.reply(false); root.dismissed(); }
            }
            MenuEntry {
                icon: Icons.reply-all;
                label: "Reply all";
                shortcut: "Ctrl+Shift+R";
                activated => { root.reply(true); root.dismissed(); }
            }
            MenuEntry {
                icon: Icons.forward;
                label: "Forward";
                activated => { root.forward-thread(); root.dismissed(); }
            }
        }
    }

    if root.kind == "more": MenuSurface {
        dismissed => { root.dismissed(); }
        available-width: root.width;
        available-height: root.height;
        // Opened from the last button of the bar: it hangs to the left of it; on a
        // phone it is a sheet with the bar's actions too.
        menu-x: root.menu-x - 220px;
        menu-y: root.menu-y;
        menu-width: 220px;
        menu-height: autres.preferred-height + 8px;

        autres := VerticalLayout {
            padding: 4px;
            if Layout.compact: MenuEntry {
                icon: Icons.check;
                label: "Mark as done";
                activated => { root.done(); root.dismissed(); }
            }
            if Layout.compact: MenuEntry {
                icon: Icons.clock;
                label: "Snooze…";
                chevron: true;
                activated => { root.snooze-open(); }
            }
            if Layout.compact: MenuEntry {
                icon: Icons.hourglass;
                label: "Move to Waiting";
                activated => { root.waiting(); root.dismissed(); }
            }
            if Layout.compact: MenuEntry {
                icon: Icons.task;
                label: "Make it a task";
                activated => { root.to-task(); root.dismissed(); }
            }
            if Layout.compact: MenuEntry {
                icon: Icons.archive;
                label: "Archive";
                activated => { root.archive(); root.dismissed(); }
            }
            if Layout.compact: MenuSeparator {}
            if Layout.compact: MenuEntry {
                icon: Icons.reply-all;
                label: "Reply all";
                activated => { root.reply(true); root.dismissed(); }
            }
            // Forward opens the ordinary editor, subject and quote filled in, the
            // recipient left empty: the one thing a forward cannot guess.
            MenuEntry {
                icon: Icons.forward;
                label: "Forward";
                activated => { root.forward-thread(); root.dismissed(); }
            }
            MenuEntry {
                icon: root.unread ? Icons.envelope-open : Icons.envelope-closed;
                label: root.unread ? "Mark as read" : "Mark as unread";
                shortcut: "R";
                activated => { root.toggle-unread(); root.dismissed(); }
            }
            if Layout.compact: MenuEntry {
                icon: Icons.star;
                label: root.starred ? "Remove star" : "Star";
                activated => { root.toggle-star(); root.dismissed(); }
            }
            MenuSeparator {}
            MenuEntry {
                icon: Icons.code;
                label: "View source";
                activated => { root.view-source(); root.dismissed(); }
            }
            if Layout.compact: MenuEntry {
                icon: Icons.trash;
                label: "Delete";
                danger: true;
                activated => { root.delete-thread(); root.dismissed(); }
            }
        }
    }
}

// What a right-click in a message offers: the link under the pointer, the words
// selected, all the words. Rust fills it and acts on the choice (`chosen`: "open",
// "copy-link", "copy-text", "copy-selection", "select-all").
export component LinkMenu inherits Rectangle {
    /// "web", "mail", or empty when no link is under the pointer.
    in property <string> kind;
    /// The words of the link, empty for a picture.
    in property <string> link-text;
    in property <bool> has-selection;
    /// Opened over the body of a message: Copy and Select all are offered.
    in property <bool> body;
    in property <length> menu-x;
    in property <length> menu-y;

    callback chosen(string);
    callback dismissed();

    // A click outside closes it, a right-click too.
    TouchArea {
        width: 100%;
        height: 100%;
        clicked => { root.dismissed(); }
        pointer-event(event) => {
            if (event.button == PointerEventButton.right && event.kind == PointerEventKind.down) {
                root.dismissed();
            }
        }
    }

    MenuSurface {
        dismissed => { root.dismissed(); }
        available-width: root.width;
        available-height: root.height;
        menu-x: root.menu-x;
        menu-y: root.menu-y;
        menu-width: 230px;
        menu-height: entrees.preferred-height + 8px;

        entrees := VerticalLayout {
            padding: 4px;

            if root.kind == "web": MenuEntry {
                icon: Icons.open-external;
                label: "Open link";
                activated => { root.chosen("open"); root.dismissed(); }
            }
            if root.kind == "web": MenuEntry {
                icon: Icons.link;
                label: "Copy link address";
                activated => { root.chosen("copy-link"); root.dismissed(); }
            }
            if root.kind == "mail": MenuEntry {
                icon: Icons.pencil;
                label: "Write to this address";
                activated => { root.chosen("open"); root.dismissed(); }
            }
            if root.kind == "mail": MenuEntry {
                icon: Icons.envelope-closed;
                label: "Copy email address";
                activated => { root.chosen("copy-link"); root.dismissed(); }
            }
            if root.kind != "" && root.link-text != "": MenuEntry {
                icon: Icons.copy;
                label: "Copy link text";
                activated => { root.chosen("copy-text"); root.dismissed(); }
            }
            if root.kind != "" && (root.has-selection || root.body): MenuSeparator {}
            // Over a body, Copy is always there, dimmed while nothing is selected.
            if root.has-selection || root.body: MenuEntry {
                icon: Icons.copy;
                label: "Copy";
                shortcut: "Ctrl+C";
                enabled: root.has-selection;
                activated => { root.chosen("copy-selection"); root.dismissed(); }
            }
            if root.body: MenuEntry {
                icon: Icons.align-left;
                label: "Select all";
                activated => { root.chosen("select-all"); root.dismissed(); }
            }
        }
    }
}

// La colonne de lecture, avec la réponse intégrée au bas du fil.
export component ConversationView inherits VerticalLayout {
    /// Le message le plus récent : c'est lui que l'en-tête et la barre d'actions
    /// décrivent, parce que c'est de lui qu'on décide.
    in property <MessageData> message;
    /// Le fil entier, du plus ancien au plus récent.
    in property <[MessageData]> messages;
    in property <bool> empty: true;

    in property <bool> starred;
    /// The mailbox the conversation came to.
    in property <string> account-email;
    /// The folder it is in: "Inbox", "Spam", "Trash", a folder's name; "+1" when some
    /// of its messages are elsewhere.
    in property <string> folder-label;
    /// Every folder it is in, when there are several ("Inbox, Sent, Clients").
    in property <string> folder-all;
    /// Its latest message is in the bin or the spam: said in red.
    in property <bool> folder-alarming;
    in property <color> account-tint;
    /// Read full screen, the accounts and the list set aside.
    in property <bool> focused;
    /// How wide the thread runs at most; centred beyond.
    in property <length> column: 900px;

    /// Answer the conversation in the composer: the sender, or everyone (true).
    callback reply(bool);
    /// The other ways to answer (Reply all, Forward), and where the menu's bottom left
    /// goes (in the window).
    callback reply-menu(length, length);
    callback load-images();
    callback save-attachment(int);
    callback open-attachment(int);
    /// The invitation a message carries: into the calendar (message id), or opened
    /// there (event key, day).
    callback invite-accept(int);
    callback invite-open(string, string);
    /// An invitation answered (message id; 0 Accept, 1 Maybe, 2 Decline).
    callback invite-answer(int, int);
    /// Leave the mailing list a message came from (message id), once confirmed.
    callback unsubscribe(int);
    callback archive();
    callback delete-thread();
    callback toggle-star();
    /// The snooze menu, and where its top left goes (in the window).
    callback snooze-menu(length, length);
    /// The menu of the rarer actions, and where its top right goes.
    callback more-menu(length, length);
    callback waiting();
    callback toggle-focus();
    callback mark-done();
    /// The conversation becomes a task.
    callback to-task();
    callback toggle-message(int);

    /// A tile of a body painted by the full engine has come near the screen, or gone
    /// away from it: (message id, tile index).
    callback body-tile-wanted(int, int);
    callback body-tile-released(int, int);
    /// The width message bodies are shown at, reported by the first tile when it first
    /// shows and whenever it changes: bodies painted by the full engine are painted at
    /// exactly that width, never scaled afterwards.
    callback body-width-changed(length);
    /// Words chosen with the mouse in a body painted by the full engine: (message id,
    /// tile, where across and down the tile as fractions, 0 pressed / 1 dragged).
    callback body-select(int, int, float, float, int);
    /// A click that selected nothing in a body painted by the full engine, and whether a
    /// link is under the pointer there: (message id, tile, fractions across and down).
    callback body-link(int, int, float, float);
    callback body-link-at(int, int, float, float) -> bool;
    /// A link clicked in a text body: its target, as the message wrote it.
    callback message-link(string);
    /// The pointer over words of a text body with one link, or leaving them.
    callback message-link-hovered(bool, string, string);
    /// A right-click in a body painted by the full engine: (message id, tile,
    /// fractions across and down, the point in the window).
    callback body-menu(int, int, float, float, length, length);
    /// A key the message's text had no use for, to hand to the shortcuts.
    callback keys-left(string);
    /// A right-click in a body shown as text, away from a link: (message id, the point
    /// in the window). What is selected is in `MessageText`.
    callback text-menu(int, length, length);
    /// No tile asks for pixels while this is set: the window is hidden, and what was
    /// painted has been given back.
    in property <bool> bodies-suspended;

    // The entrance of a newly opened thread: 0 on the change, 1 one frame later, and
    // the animations on `fil` travel between the two.
    property <float> entree: 1;
    property <int> courant: root.message.id;
    changed courant => {
        root.entree = 0;
        arrivee.running = true;
        // What was selected went with the thread.
        MessageText.has-selection = false;
        MessageText.all-selected = -1;
    }
    arrivee := Timer {
        interval: 16ms;
        running: false;
        triggered => {
            self.running = false;
            root.entree = 1;
        }
    }

    /// Toutes les pièces jointes sont-elles montrées ?
    ///
    /// Quatre par défaut. Douze pastilles sur trois rangs mangeraient la moitié du
    /// volet pour un message qu'on est venu lire ; « +8 » tient sur la même ligne et
    /// dit exactement ce qui manque.
    in-out property <bool> attachments-expanded;

    if root.empty: Rectangle {
        VerticalLayout {
            alignment: center;
            Text {
                text: "No conversation selected.";
                color: Tokens.text-muted;
                font-size: Tokens.size-body;
                horizontal-alignment: center;
            }
        }
    }


    if !root.empty: VerticalLayout {
        padding-top: 0px;
        padding-bottom: 18px;
        spacing: 14px;

        // Le fil, du plus ancien au plus récent, sous son sujet.
        //
        // C'était **un seul message** : le dernier. Un échange de douze en montrait un
        // et cachait onze, alors que la liste affichait « 12 » à côté du sujet — le
        // compte promettait une conversation et la colonne livrait un message.
        //
        // Les précédents sont repliés : en-tête et une ligne d'aperçu. Ce n'est pas
        // seulement une question de place, c'est ce qui rend la chose tenable — un
        // corps rendu coûte une rasterisation, et en faire douze pour en lire un
        // paierait onze fois pour rien. Le corps arrive au dépliage.
        //
        // The column is generous: the thread runs up to 900 px wide and is centred
        // beyond that, each message on a card of its own.
        defil := ScrollView {
            vertical-stretch: 1;
            content-height: fil.preferred-height + 26px + 20px;

            fil := VerticalLayout {
                x: max(32px, (defil.visible-width - root.column) / 2);
                y: 26px + (1 - root.entree) * 10px;
                width: min(root.column, defil.visible-width - 64px);
                // Its own height: given the viewport's, the layout spread the extra
                // room between the subject and the first card.
                height: self.preferred-height;
                spacing: 10px;
                // A new thread arrives rather than appears: ten pixels and a fade,
                // over a fifth of a second. Enough to say "this changed", too short
                // to wait for.
                opacity: 0.4 + 0.6 * root.entree;
                animate y, opacity { duration: 200ms; easing: ease-out; }

                // The subject, large; under it the mailbox it came to, and how many.
                VerticalLayout {
                    spacing: 6px;
                    padding-bottom: 10px;
                    Text {
                        text: root.message.subject;
                        font-family: Tokens.font-display;
                        font-size: 20px;
                        font-weight: 700;
                        color: Tokens.text;
                        wrap: word-wrap;
                    }
                    HorizontalLayout {
                        spacing: 12px;
                        HorizontalLayout {
                            spacing: 6px;
                            horizontal-stretch: 0;
                            if root.account-email != "": Rectangle {
                                y: (parent.height - self.height) / 2;
                                width: 7px;
                                height: 7px;
                                border-radius: 3.5px;
                                background: root.account-tint;
                            }
                            Text {
                                text: root.account-email;
                                font-size: 12.5px;
                                color: Tokens.text-muted;
                                vertical-alignment: center;
                                overflow: elide;
                                max-width: self.preferred-width;
                            }
                        }
                        // Where it is: a small folder mark and its name, quiet; red
                        // only for the places mail goes to be gone.
                        // Over "Inbox +2", every folder the conversation is in.
                        // A small grey plate with its name, as the mockups draw it.
                        if root.folder-label != "": Rectangle {
                            horizontal-stretch: 0;
                            y: (parent.height - self.height) / 2;
                            width: dossier.preferred-width + 16px;
                            height: dossier.preferred-height + 2px;
                            border-radius: 6px;
                            background: root.folder-alarming ? Tokens.error.transparentize(0.88)
                                : Tokens.surface-active;
                            dossier := HorizontalLayout {
                                x: 8px;
                                width: self.preferred-width;
                                Text {
                                    text: root.folder-label;
                                    // "Inbox" alone says nothing to a screen reader.
                                    accessible-label: "In " + (root.folder-all != "" ? root.folder-all : root.folder-label);
                                    font-size: 12.5px;
                                    color: root.folder-alarming ? Tokens.error : Tokens.text-secondary;
                                    vertical-alignment: center;
                                }
                            }
                            if root.folder-all != "": TouchArea {}
                            if root.folder-all != "": Tooltip {
                                text: @markdown("In \{root.folder-all}");
                            }
                        }
                        if root.messages.length > 1: Text {
                            text: root.messages.length + " messages";
                            font-size: 12.5px;
                            color: Tokens.text-muted;
                            vertical-alignment: center;
                            horizontal-stretch: 0;
                        }
                        Rectangle { horizontal-stretch: 1; }
                    }
                }

                // Each message on a card of its own, framed: the folded ones a single
                // line, the open one with its header and body, so the change of author
                // reads at a glance.
                // As Apple Mail: no frame, a hairline between one message and the next.
                for message[i] in root.messages: Rectangle {
                    height: carte.preferred-height;
                    if i > 0: Rectangle {
                        y: 0;
                        height: 1px;
                        background: Tokens.border;
                    }

                carte := VerticalLayout {
                    // Nothing inside widens the card past the column: a line too long
                    // to wrap is cut, never a card thousands of pixels wide.
                    min-width: 0px;
                    padding-left: 0px;
                    padding-right: 0px;
                    padding-top: 6px;
                    padding-bottom: message.expanded ? 16px : 6px;
                    spacing: 10px;

                    // L'en-tête, et la poignée qui déplie et replie — sauf quand il n'y
                    // a qu'un message.
                    //
                    // Dans ce cas il ne servait à rien deux fois. Il répétait mot pour
                    // mot ce que le titre venait de dire trois lignes plus haut, nom de
                    // l'expéditeur et heure comprises ; et son chevron proposait de
                    // replier le seul message du fil, c'est-à-dire de masquer la totalité
                    // de ce qu'on venait d'ouvrir. Un fil d'un message est le cas le plus
                    // fréquent de tous.
                    // The sender's face and name, their address when open, the date.
                    // A click folds or unfolds it, when there is more than one.
                    Rectangle {
                        height: 56px;

                        HorizontalLayout {
                            spacing: 10px;

                            Avatar {
                                y: (parent.height - self.height) / 2;
                                initials: message.initials;
                                tint: message.tint;
                                size: 38px;
                            }

                            // Open, as Mail heads a message: the name and the address
                            // it came from, then to whom on a line of its own.
                            if message.expanded: VerticalLayout {
                                alignment: center;
                                spacing: 2px;
                                horizontal-stretch: 1;
                                HorizontalLayout {
                                    spacing: 6px;
                                    Text {
                                        text: message.from;
                                        font-size: 14px;
                                        font-weight: 600;
                                        color: Tokens.text;
                                        overflow: elide;
                                        horizontal-stretch: 0;
                                        max-width: self.preferred-width;
                                    }
                                    Text {
                                        text: message.from-address != message.from ? message.from-address : "";
                                        font-size: 12px;
                                        color: Tokens.text-muted;
                                        overflow: elide;
                                        horizontal-stretch: 1;
                                        y: 1px;
                                    }
                                    if message.unsubscribe > 0: UnsubscribeLink {
                                        state: message.unsubscribe;
                                        confirmed => { root.unsubscribe(message.id); }
                                    }
                                }
                                if message.to != "": Text {
                                    text: "To: " + message.to;
                                    font-size: 12px;
                                    color: Tokens.text-muted;
                                    overflow: elide;
                                }
                            }

                            // Folded, the name, then the preview in the room left: it
                            // is what finds a message in a thread without opening four.
                            if !message.expanded: Text {
                                text: message.from;
                                font-size: Tokens.size-body;
                                font-weight: Tokens.weight-bold;
                                color: Tokens.text;
                                vertical-alignment: center;
                                overflow: elide;
                                horizontal-stretch: 0;
                                max-width: self.preferred-width;
                            }
                            if !message.expanded: Text {
                                text: message.preview;
                                font-size: 12.5px;
                                color: Tokens.text-muted;
                                vertical-alignment: center;
                                overflow: elide;
                                horizontal-stretch: 1;
                            }

                            Text {
                                text: message.date;
                                font-size: 12px;
                                color: Tokens.text-muted;
                                vertical-alignment: center;
                            }
                        }

                        if root.messages.length > 1: Rectangle {
                            accessible-role: button;
                            accessible-label: (message.expanded ? "Collapse " : "Expand ")
                                + message.from + ", " + message.date;
                            accessible-expanded: message.expanded;
                            accessible-action-default => { root.toggle-message(message.id); }

                            TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.toggle-message(message.id); }
                            }
                        }

                        // Open, a hairline under the header, between it and the body,
                        // across the whole pane: from the list's edge to the window's,
                        // as Mail draws it, not just the reading column's width.
                        Rectangle {
                            visible: message.expanded;
                            x: -fil.x;
                            y: parent.height + 4px;
                            width: defil.visible-width;
                            height: 1px;
                            background: Tokens.border;
                        }
                    }

                    // The invitation this message carries, set against the
                    // calendar: on this message only, the one that brought it.
                    if message.expanded && message.invite-state > 0: InviteBanner {
                        state: message.invite-state;
                        title: message.invite-title;
                        when: message.invite-when;
                        can-reply: message.invite-can-reply;
                        reply: message.invite-reply;
                        accept => { root.invite-accept(message.id); }
                        open => { root.invite-open(message.invite-key, message.invite-day); }
                        answer(a) => { root.invite-answer(message.id, a); }
                    }

                    if message.expanded && (message.blocked-images > 0
                        || message.has-tracker): RemoteContentBanner {
                        blocked-images: message.blocked-images;
                        has-tracker: message.has-tracker;
                        load-images => { root.load-images(); }
                    }

                    // Le corps arrive encore. Sans cette ligne, l'écran était
                    // vide et muet, et rien ne distinguait « ça charge » de « ce
                    // message ne contient rien ».
                    if message.expanded && message.body-loading: LoadingLine {
                        label: "Loading the message…";
                    }

                    // The body as a column of tiles. Each has its full height from
                    // the start, so the scroll bar is right; its pixels exist only
                    // while it is within a screen of the visible part.
                    if message.expanded && !message.body-loading && message.body-is-image: VerticalLayout {
                        for tuile[t] in message.body-tiles: BodyTile {
                            tile: tuile;
                            // Where the tile is, relative to the visible part.
                            top: self.absolute-position.y - defil.absolute-position.y;
                            visible-height: defil.height;
                            suspended: root.bodies-suspended;
                            wanted => { root.body-tile-wanted(message.id, t); }
                            released => { root.body-tile-released(message.id, t); }
                            select(fx, fy, phase) => { root.body-select(message.id, t, fx, fy, phase); }
                            link(fx, fy) => { root.body-link(message.id, t, fx, fy); }
                            link-at(fx, fy) => { return root.body-link-at(message.id, t, fx, fy); }
                            menu(fx, fy, x, y) => { root.body-menu(message.id, t, fx, fy, x, y); }
                            resized(w) => {
                                if (t == 0) {
                                    root.body-width-changed(w);
                                }
                            }
                        }
                    }

                    // Text bodies sit under the name, clear of the face.
                    // The words can be selected; what the keyboard does meanwhile that
                    // text has no use for (e, j, r…) goes on to the shortcuts.
                    if message.expanded && !message.body-loading && !message.body-is-image: corps := FocusScope {
                    key-pressed(event) => {
                        // A modifier alone waits for its key, here: Ctrl, then C, copies
                        // the words selected. Handed on, it took the keyboard and the
                        // selection with it before the C came.
                        if (event.text == Key.Control || event.text == Key.Shift
                            || event.text == Key.Alt || event.text == Key.Meta) {
                            return reject;
                        }
                        root.keys-left(event.text);
                        accept
                    }
                    // Beneath the words: what they leave. A right-click opens the
                    // menu of the body without taking the keyboard from the words,
                    // which would forget their selection; a click between them hands
                    // the keyboard here, as it did before.
                    TouchArea {
                        pointer-event(event) => {
                            if (event.kind == PointerEventKind.down) {
                                if (event.button == PointerEventButton.right) {
                                    root.text-menu(message.id,
                                        self.absolute-position.x + self.mouse-x,
                                        self.absolute-position.y + self.mouse-y);
                                } else if (event.button == PointerEventButton.left) {
                                    MessageText.all-selected = -1;
                                    corps.focus();
                                }
                            }
                        }
                    }
                    VerticalLayout {
                        padding-left: 0px;
                        spacing: 10px;
                        for block in message.blocks: MessageBlock {
                            block: block;
                            message: message.id;
                            link(l) => { root.message-link(l); }
                            link-hovered(on, l, t) => { root.message-link-hovered(on, l, t); }
                        }

                        // Le corps est arrivé et ne donne rien à lire : une page
                        // faite d'images bloquées, ou un HTML vidé par
                        // l'assainissement. Le dire, plutôt que de laisser croire
                        // que ça charge encore.
                        if message.blocks.length == 0: Text {
                            text: "This message has nothing to display.";
                            font-family: Tokens.font-family;
                            font-size: Tokens.size-body;
                            color: Tokens.text-muted;
                        }
                    }
                    }

                    // The attachments of the message being read, as file cards
                    // under its body: what it is, how big.
                    if message.expanded && message.id == root.message.id
                        && root.message.attachments.length > 0: Attachments {
                        padding-left: 0px;
                        padding-top: 6px;
                        files: root.message.attachments;
                        expanded <=> root.attachments-expanded;
                        open(i) => { root.open-attachment(i); }
                        save(i) => { root.save-attachment(i); }
                    }
                } // carte
                }
            }
        }

        // Answering, under the thread and lined up with it: Reply opens the composer
        // filled in (the sender, the subject, the conversation under the body), where
        // there is room to write and to see whom it goes to. The chevron offers the
        // other ways: Reply all, Forward.
        Rectangle {
            vertical-stretch: 0;
            height: 52px;

            HorizontalLayout {
                x: max(32px, (root.width - root.column) / 2);
                width: min(root.column, root.width - 64px);
                padding-top: 8px;
                padding-bottom: 16px;
                spacing: 2px;
                alignment: start;

                repondre := Button {
                    text: "Reply";
                    icon: Icons.reply;
                    shortcut: "Ctrl+R";
                    clicked => { root.reply(false); }
                }
                autres-reponses := IconButton {
                    icon: Icons.chevron-down;
                    label: "More ways to reply";
                    button-size: 28px;
                    icon-size: 14px;
                    clicked => {
                        root.reply-menu(repondre.absolute-position.x,
                            repondre.absolute-position.y - 6px);
                    }
                }
            }
        }
    }
}
