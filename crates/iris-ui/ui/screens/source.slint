import { Tokens } from "@iris/theme/tokens.slint";
import { TextArea } from "@iris/controls/field.slint";
import { Modal } from "@iris/layout/frames.slint";
import { EmptyState } from "@iris/layout/frames.slint";

// Le message tel qu'il est arrivé.
//
// En-têtes compris, sans rien interpréter. Ça compte moins souvent que le reste, et
// quand ça compte rien d'autre ne fait l'affaire : un message qui arrive de travers, un
// expéditeur qui n'est pas celui qu'il prétend, une règle qui se déclenche quand elle ne
// devrait pas. Thunderbird a Ctrl+U, les autres l'enterrent dans un menu.
export component SourcePanel inherits Rectangle {
    in property <string> subject;
    in property <string> source;
    /// Le message n'a pas encore été téléchargé, ou plus rien n'en reste.
    in property <bool> unavailable;

    callback dismissed();

    Modal {
        width: 100%;
        height: 100%;
        title: root.subject == "" ? "Source" : "Source of " + root.subject;
        card-width: 860px;
        card-height: 700px;
        dismissed => { root.dismissed(); }

        if root.unavailable: EmptyState {
            vertical-stretch: 1;
            text: "This message has not been downloaded yet.";
        }

        // Un champ de saisie plutôt qu'un texte : c'est ce qui permet de
        // sélectionner et de copier une ligne d'en-tête, qui est tout ce qu'on vient
        // faire ici. En lecture seule, parce qu'un message reçu ne se modifie pas.
        if !root.unavailable: TextArea {
            vertical-stretch: 1;
            accessible-label: "Message source";
            read-only: true;
            font-size: Tokens.size-small;
            wrap: no-wrap;
            text: root.source;
        }
    }
}
