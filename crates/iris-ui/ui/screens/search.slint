import { Tokens } from "@iris/theme/tokens.slint";
import { Layout } from "@iris/theme/layout.slint";
import { Icon, Icons, IconButton } from "@iris/base/icons.slint";
import { TextField } from "@iris/controls/field.slint";
import { Check } from "@iris/controls/choice.slint";
import { ScrollView } from "@iris/controls/scroll.slint";
import { EverywhereHitData } from "@iris/types.slint";

// The search everywhere, as a page of its own on a phone (the Android mockups' S1 and
// S2): back and the field at the top, the accent round it while typing; before a key,
// what can be made; then what was found, grouped by place, the word found set apart in
// each title. A task is ticked from here; anything else opens where it lives.

// One row: an icon (or a task's circle), the title with its word set apart, a line
// under it.
component HitRow inherits Rectangle {
    in property <EverywhereHitData> hit;
    in property <bool> last;
    callback opened();
    callback toggled();

    height: max(52px, rang.preferred-height + 16px);
    background: touch.pressed ? Tokens.surface-active : transparent;

    accessible-role: button;
    accessible-label: root.hit.before + root.hit.word + root.hit.after;
    accessible-description: root.hit.detail;
    accessible-action-default => { root.opened(); }

    touch := TouchArea {
        clicked => { root.opened(); }
    }
    rang := HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        spacing: 14px;
        if root.hit.kind == "task": Check {
            y: (parent.height - self.height) / 2;
            done: root.hit.done;
            label: "Done: " + root.hit.before + root.hit.word + root.hit.after;
            toggled => { root.toggled(); }
        }
        if root.hit.kind != "task": Icon {
            y: (parent.height - self.height) / 2;
            width: 20px;
            data: root.hit.kind == "mail" ? Icons.envelope-closed
                : root.hit.kind == "event" ? Icons.calendar : Icons.notes;
            size: 18px;
            tint: Tokens.text-muted;
        }
        VerticalLayout {
            alignment: center;
            spacing: 1px;
            horizontal-stretch: 1;
            HorizontalLayout {
                spacing: 0px;
                if root.hit.before != "": Text {
                    text: root.hit.before;
                    font-size: 15px;
                    color: root.hit.done ? Tokens.text-muted : Tokens.text;
                    horizontal-stretch: 0;
                    overflow: elide;
                }
                // The word found, on the accent's light plate, as the mockups mark it.
                if root.hit.word != "": Rectangle {
                    horizontal-stretch: 0;
                    width: mot.preferred-width + 4px;
                    border-radius: 3px;
                    background: Tokens.accent-soft;
                    mot := Text {
                        text: root.hit.word;
                        font-size: 15px;
                        color: Tokens.text;
                    }
                }
                if root.hit.after != "": Text {
                    text: root.hit.after;
                    font-size: 15px;
                    color: root.hit.done ? Tokens.text-muted : Tokens.text;
                    overflow: elide;
                    horizontal-stretch: 1;
                    min-width: 0px;
                }
                Rectangle { horizontal-stretch: 1; }
            }
            if root.hit.detail != "": Text {
                text: root.hit.detail;
                font-size: 13px;
                color: Tokens.text-muted;
                overflow: elide;
            }
        }
    }
    Rectangle {
        visible: !root.last;
        x: 48px;
        y: parent.height - 1px;
        width: parent.width - 48px;
        height: 1px;
        background: Tokens.border;
    }
}

// What can be made before anything is typed.
component ActionRow inherits Rectangle {
    in property <string> icon;
    in property <string> label;
    in property <bool> last;
    callback clicked();
    height: 52px;
    background: touch.pressed ? Tokens.surface-active : transparent;
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { root.clicked(); }
    touch := TouchArea {
        clicked => { root.clicked(); }
    }
    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        spacing: 14px;
        Icon {
            y: (parent.height - self.height) / 2;
            width: 20px;
            data: root.icon;
            size: 18px;
            tint: Tokens.text-muted;
        }
        Text {
            text: root.label;
            font-size: 15px;
            color: Tokens.text;
            vertical-alignment: center;
        }
    }
    Rectangle {
        visible: !root.last;
        x: 48px;
        y: parent.height - 1px;
        width: parent.width - 48px;
        height: 1px;
        background: Tokens.border;
    }
}

component GroupTitle inherits Text {
    height: 34px;
    font-size: 13px;
    font-weight: 600;
    color: Tokens.text-muted;
    vertical-alignment: bottom;
}

export component EverywherePage inherits Rectangle {
    in property <[EverywhereHitData]> hits;
    in-out property <string> text;

    callback query(string);
    callback opened(EverywhereHitData);
    callback task-toggled(string);
    /// "message", "task", "event", "note", "sync".
    callback action(string);
    callback dismissed();

    background: Tokens.background;
    // Over what is behind: nothing goes through the page.
    TouchArea {}

    // Escape, and Android's Back sent as Escape, close the page from its field.
    FocusScope {
        enabled: false;
        key-pressed(event) => {
            if (event.text == Key.Escape || event.text == Key.Back) {
                root.dismissed();
                return accept;
            }
            return reject;
        }

    VerticalLayout {
        padding-top: Layout.inset-top;
        padding-bottom: Layout.inset-bottom;

        HorizontalLayout {
            height: 60px;
            padding-left: 4px;
            padding-right: 12px;
            spacing: 4px;
            IconButton {
                y: (parent.height - self.height) / 2;
                icon: Icons.arrow-left;
                label: "Close the search";
                button-size: 44px;
                icon-size: 22px;
                clicked => { root.dismissed(); }
            }
            Rectangle {
                y: (parent.height - self.height) / 2;
                height: 44px;
                border-radius: 12px;
                background: Tokens.surface;
                border-width: 1.5px;
                border-color: champ.has-focus ? Tokens.accent : Tokens.border-strong;
                HorizontalLayout {
                    padding-left: 6px;
                    padding-right: 2px;
                    champ := TextField {
                        bare: true;
                        font-size: 16px;
                        accessible-label: "Search everything";
                        placeholder-text: "Search or do anything";
                        text <=> root.text;
                        edited(t) => { root.query(t); }
                        accepted(t) => { root.query(t); }
                        // Opened to be typed in.
                        init => { self.focus(); }
                    }
                    if root.text != "": Rectangle {
                        width: 40px;
                        accessible-role: button;
                        accessible-label: "Clear";
                        accessible-action-default => {
                            root.text = "";
                            root.query("");
                        }
                        Icon {
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            data: Icons.window-close;
                            size: 16px;
                            tint: Tokens.text-muted;
                        }
                        TouchArea {
                            clicked => {
                                root.text = "";
                                root.query("");
                                champ.focus();
                            }
                        }
                    }
                }
            }
        }

        page := ScrollView {
            vertical-stretch: 1;
            content-width: self.visible-width;
            VerticalLayout {
                width: page.visible-width;
                padding-left: 16px;
                padding-right: 16px;
                padding-bottom: 24px;
                alignment: start;

                // Nothing typed: what can be made.
                if root.text == "": GroupTitle { text: "Actions"; }
                if root.text == "": Rectangle {
                    border-radius: 14px;
                    background: Tokens.surface;
                    clip: true;
                    VerticalLayout {
                        ActionRow { icon: Icons.pencil; label: "New message"; clicked => { root.action("message"); } }
                        ActionRow { icon: Icons.plus; label: "New task"; clicked => { root.action("task"); } }
                        ActionRow { icon: Icons.calendar; label: "New event"; clicked => { root.action("event"); } }
                        ActionRow { icon: Icons.notes; label: "New note"; clicked => { root.action("note"); } }
                        ActionRow { icon: Icons.refresh; label: "Sync all accounts"; last: true; clicked => { root.action("sync"); } }
                    }
                }

                // Typed: what was found, a group per place.
                for hit[i] in root.hits: VerticalLayout {
                    if hit.first: GroupTitle { text: hit.place; }
                    Rectangle {
                        background: Tokens.surface;
                        border-top-left-radius: hit.first ? 14px : 0px;
                        border-top-right-radius: hit.first ? 14px : 0px;
                        property <bool> dernier: i == root.hits.length - 1 || root.hits[i + 1].first;
                        border-bottom-left-radius: self.dernier ? 14px : 0px;
                        border-bottom-right-radius: self.dernier ? 14px : 0px;
                        clip: true;
                        height: ligne.height;
                        ligne := HitRow {
                            hit: hit;
                            last: parent.dernier;
                            opened => { root.opened(hit); }
                            toggled => { root.task-toggled(hit.id); }
                        }
                    }
                }
                if root.text != "" && root.hits.length == 0: Text {
                    height: 120px;
                    text: "Nothing found for “" + root.text + "”.";
                    font-size: 14px;
                    color: Tokens.text-muted;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }
    }
    }
}
