import { Tokens } from "@iris/theme/tokens.slint";
import { TextField } from "@iris/controls/field.slint";
import { ListView, CheckBox } from "std-widgets.slint";

// Un réglage déclaré par un module.
export struct PluginSettingData {
    key: string,
    label: string,
    hint: string,
    // "text", "number" ou "toggle".
    kind: string,
    value: string,
}

// Les réglages d'un module.
//
// Dessinés à partir de ce que son manifeste déclare : l'application ne sait rien de
// ce qu'un module a besoin de demander, et ne doit rien en savoir.
/// Les réglages d'un module, sans fenêtre autour.
///
/// Séparé du panneau parce qu'ils s'affichent désormais **dans** l'écran des modules,
/// à la place de la liste. Ils étaient une seconde fenêtre modale par-dessus la
/// première, et comme le dernier frère déclaré passe devant, c'est l'écran des modules
/// qui passait devant : cliquer « Settings » ouvrait quelque chose derrière ce qu'on
/// regardait, et rien ne semblait se produire.
///
/// Empiler deux fenêtres modales pour deux niveaux d'une même chose était de toute
/// façon la mauvaise forme. Une modale est une question ; « quel module » et « quels
/// réglages » sont une seule question posée en deux temps.
export component PluginSettingsBody inherits VerticalLayout {
    in property <[PluginSettingData]> settings;
    in property <string> error;

    callback changed(string, string);

    spacing: Tokens.space-3;

    if root.settings.length == 0: VerticalLayout {
                vertical-stretch: 1;
                alignment: center;
                Text {
                    text: "This module has nothing to configure.";
                    font-size: Tokens.size-body;
                    color: Tokens.text-muted;
                    horizontal-alignment: center;
                }
            }

            if root.settings.length > 0: ListView {
                vertical-stretch: 1;
                for reglage in root.settings: VerticalLayout {
                    padding-bottom: Tokens.space-3;
                    spacing: 2px;

                    if reglage.kind == "toggle": CheckBox {
                        text: reglage.label;
                        checked: reglage.value == "true";
                        toggled => {
                            root.changed(reglage.key, self.checked ? "true" : "false");
                        }
                    }

                    if reglage.kind != "toggle": Text {
                        text: reglage.label;
                        font-size: Tokens.size-small;
                        color: Tokens.text-secondary;
                    }

                    if reglage.kind != "toggle": TextField {
                        accessible-label: reglage.label;
                        input-type: reglage.kind == "number"
                            ? InputType.number
                            : InputType.text;
                        font-size: Tokens.size-body;
                        text: reglage.value;
                        edited(t) => { root.changed(reglage.key, t); }
                    }

                    if reglage.hint != "": Text {
                        text: reglage.hint;
                        font-size: Tokens.size-small;
                        color: Tokens.text-muted;
                        wrap: word-wrap;
                    }
                }
            }

            if root.error != "": Text {
                text: root.error;
                font-size: Tokens.size-small;
                color: Tokens.error;
                wrap: word-wrap;
            }

            // Dit une fois, ici, plutôt que découvert autrement : un champ de réglage
            // est un fichier en clair à côté d'un .wasm.
            Text {
                text: "Saved as you type. Not a place for passwords: the file sits "
                    + "beside the module, unencrypted.";
                font-size: Tokens.size-small;
                color: Tokens.text-muted;
                wrap: word-wrap;
            }
}
