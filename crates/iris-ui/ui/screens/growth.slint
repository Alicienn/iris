import { Tokens } from "@iris/theme/tokens.slint";
import { Icons, IconButton } from "@iris/base/icons.slint";
import { GoalData } from "@iris/types.slint";
import { SectionTitle } from "@iris/lists/nav.slint";
import { SidebarFrame } from "@iris/shell/chrome.slint";
import { GoalRow } from "@iris/screens/goals.slint";

// Growth: who one wants to become, beside what there is to do. Its column holds the
// goals; a goal's page, or all of them, is the tasks' own, drawn beside this column by
// the window.

/// Growth's side column.
export component GrowthSidebar inherits SidebarFrame {
    in property <[GoalData]> goals;
    /// All the goals are shown.
    in property <bool> goals-shown;
    callback place-chosen(string);
    callback new-goal();

    // The goals, their title leading to all of them, as the tasks had them.
    HorizontalLayout {
        height: 31px;
        padding-left: 8px;
        padding-right: 0px;
        padding-top: 12px;
        padding-bottom: 4px;
        Rectangle {
            horizontal-stretch: 1;
            accessible-role: button;
            accessible-label: "All goals";
            accessible-action-default => { root.place-chosen("goals"); }
            SectionTitle {
                x: 0;
                height: parent.height;
                text: "Goals";
                color: tous.has-hover || root.goals-shown ? Tokens.text : Tokens.text-muted;
            }
            tous := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.place-chosen("goals"); }
            }
        }
        IconButton {
            y: (parent.height - self.height) / 2;
            icon: Icons.plus;
            label: "New goal";
            button-size: 20px;
            icon-size: 14px;
            clicked => { root.new-goal(); }
        }
    }
    for g in root.goals: GoalRow {
        goal: g;
        chosen(id) => { root.place-chosen("goal:" + id); }
    }
    if root.goals.length == 0: HorizontalLayout {
        height: 28px;
        padding-left: 8px;
        Text {
            text: "No goal yet.";
            font-size: 12.5px;
            color: Tokens.text-muted;
            vertical-alignment: center;
        }
    }

    Rectangle { vertical-stretch: 1; }
}

export component GrowthView inherits Rectangle {
    in property <[GoalData]> goals;
    in property <bool> goals-shown;

    callback place-chosen(string);
    callback new-goal();

    background: Tokens.surface;

    HorizontalLayout {
        GrowthSidebar {
            goals: root.goals;
            goals-shown: root.goals-shown;
            place-chosen(k) => { root.place-chosen(k); }
            new-goal => { root.new-goal(); }
        }
    }
}
