import { Tokens } from "@iris/theme/tokens.slint";
import { TextField } from "@iris/controls/field.slint";
import { Button, ButtonKind } from "@iris/controls/button.slint";
import { Hairline } from "@iris/base/atoms.slint";
import { Modal, ModalFooter } from "@iris/layout/frames.slint";
import { CheckBox } from "std-widgets.slint";

// Un champ avec son intitulé.
component Field inherits VerticalLayout {
    in property <string> label;
    in property <string> placeholder;
    in property <bool> password;
    in-out property <string> value;

    callback accepted();

    spacing: 4px;

    Text {
        text: root.label;
        font-size: 12px;
        color: Tokens.text-muted;
    }

    TextField {
        accessible-label: root.label;
        placeholder-text: root.placeholder;
        font-size: Tokens.size-body;
        input-type: root.password ? InputType.password : InputType.text;
        text <=> root.value;
        accepted => { root.accepted(); }
    }
}

// L'ajout d'un compte.
//
// Deux temps. D'abord l'adresse et le mot de passe, parce que c'est tout ce qu'il
// faut dans la grande majorité des cas : la découverte trouve les serveurs seule.
// Ensuite, seulement si elle échoue, les champs de serveur — parce qu'aucune chaîne
// de découverte ne couvre tout, et qu'un utilisateur bloqué doit garder une porte.
export component AccountSetupPanel inherits Rectangle {
    // The same screen serves adding and editing. They ask for the same nine things,
    // and two panels that ask for the same nine things drift apart until one of them
    // is missing the field the other gained.
    in property <bool> editing;
    in property <bool> busy;
    in property <bool> manual;
    in property <string> error;
    in property <string> hint;
    in-out property <string> email;
    in-out property <string> password;
    in-out property <string> imap-host;
    in-out property <string> imap-port;
    in-out property <string> smtp-host;
    in-out property <string> smtp-port;
    in-out property <bool> imap-tls: true;
    in-out property <bool> smtp-tls: true;

    callback discover();
    callback save-manual();
    callback switch-to-manual();
    callback dismissed();

    Modal {
        width: 100%;
        height: 100%;
        title: root.editing ? "Edit account" : "Add an account";
        card-width: 480px;
        fit: true;
        dismissed => { root.dismissed(); }

        Field {
            label: "Email address";
            placeholder: "you@example.com";
            value <=> root.email;
            accepted => { root.discover(); }
        }

        Field {
            label: "Password";
            password: true;
            value <=> root.password;
            accepted => { root.manual ? root.save-manual() : root.discover(); }
        }

        // Ce que la découverte a trouvé, ou ce qui lui a manqué. Un écran qui échoue
        // sans dire pourquoi laisse l'utilisateur essayer au hasard.
        if root.error != "": Text {
            text: root.error;
            font-size: 12px;
            color: Tokens.error;
            wrap: word-wrap;
        }
        if root.error == "" && root.hint != "": Text {
            text: root.hint;
            font-size: 12px;
            color: Tokens.text-muted;
            wrap: word-wrap;
        }

        if root.manual: Hairline {}

        if root.manual: HorizontalLayout {
            spacing: 8px;
            Field {
                label: "IMAP server";
                placeholder: "imap.example.com";
                value <=> root.imap-host;
            }
            VerticalLayout {
                width: 80px;
                Field {
                    label: "Port";
                    value <=> root.imap-port;
                }
            }
        }

        if root.manual: CheckBox {
            text: "IMAP over TLS";
            checked <=> root.imap-tls;
        }

        if root.manual: HorizontalLayout {
            spacing: 8px;
            Field {
                label: "SMTP server";
                placeholder: "smtp.example.com";
                value <=> root.smtp-host;
            }
            VerticalLayout {
                width: 80px;
                Field {
                    label: "Port";
                    value <=> root.smtp-port;
                }
            }
        }

        if root.manual: CheckBox {
            text: "SMTP over TLS";
            checked <=> root.smtp-tls;
        }

        ModalFooter {
            // La porte de secours reste visible avant même l'échec : quelqu'un qui sait
            // déjà que son serveur est exotique n'a pas à attendre que la découverte se
            // trompe pour le dire.
            if !root.manual: Button {
                text: "Configure manually";
                kind: ButtonKind.ghost;
                clicked => { root.switch-to-manual(); }
            }
            Rectangle { horizontal-stretch: 1; }
            Button {
                text: "Cancel";
                clicked => { root.dismissed(); }
            }
            Button {
                text: root.busy ? "Looking up…" : ((root.manual || root.editing) ? "Save" : "Add");
                label: (root.manual || root.editing) ? "Save" : "Add";
                kind: ButtonKind.primary;
                enabled: !root.busy;
                clicked => { root.manual ? root.save-manual() : root.discover(); }
            }
        }
    }
}
