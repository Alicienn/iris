import { Tokens } from "@iris/theme/tokens.slint";
import { TextField } from "@iris/controls/field.slint";
import { Button, ButtonKind, BlockButton } from "@iris/controls/button.slint";
import { Layout } from "@iris/theme/layout.slint";
import { Hairline } from "@iris/base/atoms.slint";
import { Icon, Icons } from "@iris/base/icons.slint";
import { Modal, ModalFooter } from "@iris/layout/frames.slint";
import { CheckBox, ComboBox } from "@iris/controls/pickers.slint";
import { GoogleMark } from "@iris/controls/video.slint";

// Un champ avec son intitulé.
component Field inherits VerticalLayout {
    in property <string> label;
    in property <string> placeholder;
    in property <bool> password;
    in-out property <string> value;

    callback accepted();

    public function release() {
        champ.release();
    }

    spacing: 4px;

    Text {
        text: root.label;
        font-size: Layout.compact ? 13px : 12px;
        font-weight: Layout.compact ? 600 : 400;
        color: Tokens.text-muted;
    }

    champ := TextField {
        min-height: Layout.compact ? 52px : 0px;
        accessible-label: root.label;
        placeholder-text: root.placeholder;
        font-size: Tokens.size-body;
        input-type: root.password ? InputType.password : InputType.text;
        revealable: root.password;
        text <=> root.value;
        accepted => { root.accepted(); }
    }
}

// "Continue with Google": the browser signs in, no password typed here. Greyed until
// a Google client is set in Settings, and says so when pointed at.
component GoogleButton inherits Rectangle {
    in property <bool> ready;
    callback clicked();

    height: 38px;
    border-radius: Tokens.radius-medium;
    border-width: 1px;
    border-color: root.ready && touche.has-hover ? Tokens.border-strong.mix(Tokens.text, 0.7) : Tokens.border-strong;
    background: root.ready && touche.has-hover ? Tokens.surface-hover : Tokens.surface;
    opacity: root.ready ? 1.0 : 0.55;

    accessible-role: button;
    accessible-label: "Continue with Google";
    accessible-enabled: root.ready;
    accessible-description: root.ready ? "Sign in through the browser"
        : "Set your Google client in Settings, Sign in with Google or Microsoft, first";
    accessible-action-default => { if (root.ready) { root.clicked(); } }

    touche := TouchArea {
        mouse-cursor: root.ready ? MouseCursor.pointer : MouseCursor.not-allowed;
        clicked => { if (root.ready) { root.clicked(); } }
    }
    HorizontalLayout {
        alignment: center;
        spacing: 10px;
        GoogleMark { y: (parent.height - self.height) / 2; }
        Text {
            text: "Continue with Google";
            font-size: 13px;
            font-weight: 600;
            color: Tokens.text;
            vertical-alignment: center;
        }
    }
    if !root.ready: Tooltip {
        text: @markdown("Set your Google client in Settings › Sign in with Google or Microsoft first.");
    }
}

// L'ajout d'un compte.
//
// Deux temps. D'abord l'adresse et le mot de passe, parce que c'est tout ce qu'il
// faut dans la grande majorité des cas : la découverte trouve les serveurs seule.
// Ensuite, seulement si elle échoue, les champs de serveur — parce qu'aucune chaîne
// de découverte ne couvre tout, et qu'un utilisateur bloqué doit garder une porte.
export component AccountSetupPanel inherits Rectangle {
    // The same screen serves adding and editing. They ask for the same nine things,
    // and two panels that ask for the same nine things drift apart until one of them
    // is missing the field the other gained.
    in property <bool> editing;
    in property <bool> busy;
    in property <bool> manual;
    in property <string> error;
    in property <string> hint;
    in-out property <string> email;
    in-out property <string> password;
    /// The login when it is not the address (`jdoe`, `DOMAIN\jdoe`); empty: the
    /// address.
    in-out property <string> username;
    in-out property <string> imap-host;
    in-out property <string> imap-port;
    in-out property <string> smtp-host;
    in-out property <string> smtp-port;
    in-out property <bool> imap-tls: true;
    in-out property <bool> smtp-tls: true;

    callback discover();
    callback save-manual();
    callback switch-to-manual();
    /// Fill the fields in from a configuration profile (.mobileconfig).
    callback import-profile();
    callback dismissed();
    /// A profile holding several accounts: which fills the fields.
    in property <[string]> profile-choices;
    in property <int> profile-choice;
    callback profile-chosen(int);
    /// A Google client is set in Settings: the Google button can sign in.
    in property <bool> google-ready;
    /// Continue with Google: the address typed, signed in through the browser.
    callback google();

    Modal {
        width: 100%;
        height: 100%;
        title: root.editing ? "Edit account" : "Add an account";
        card-width: 480px;
        fit: true;
        dismissed => { root.dismissed(); }

        // The profile imported holds several accounts: the one shown, chosen here.
        if root.profile-choices.length > 1: VerticalLayout {
            spacing: 4px;
            Text {
                text: "Account in the profile";
                font-size: 12px;
                color: Tokens.text-muted;
            }
            ComboBox {
                height: 32px;
                accessible-label: "Account in the profile";
                model: root.profile-choices;
                current-index: root.profile-choice;
                selected => { root.profile-chosen(self.current-index); }
            }
        }

        // On a phone, under the page's title, as the mockup has it (O2).
        if Layout.compact && !root.editing && !root.manual: Text {
            text: "Iris finds the servers on its own.";
            font-size: Tokens.size-body;
            color: Tokens.text-muted;
        }

        adresse := Field {
            label: Layout.compact ? "Address" : "Email address";
            placeholder: "you@example.com";
            value <=> root.email;
            accepted => { root.discover(); }
        }

        // A Google account: its address above, then the browser; no password here.
        if !Layout.compact && !root.editing && !root.manual: GoogleButton {
            ready: root.google-ready && !root.busy;
            clicked => { root.google(); }
        }
        if !Layout.compact && !root.editing && !root.manual: Text {
            text: "Or with a password:";
            font-size: 12px;
            color: Tokens.text-muted;
        }

        mot-de-passe := Field {
            label: "Password";
            placeholder: Layout.compact ? "Password or app password" : "";
            password: true;
            value <=> root.password;
            accepted => {
                self.release();
                root.manual ? root.save-manual() : root.discover();
            }
        }

        // On a phone: Continue under the fields, then the other ways in.
        if Layout.compact: BlockButton {
            text: root.busy ? "Looking up…" : ((root.manual || root.editing) ? "Save" : "Continue");
            enabled: !root.busy;
            clicked => {
                // The keyboard goes down: what comes next (the servers found, an
                // error) shows in full.
                adresse.release();
                mot-de-passe.release();
                root.manual ? root.save-manual() : root.discover();
            }
        }
        if Layout.compact && !root.editing && !root.manual: HorizontalLayout {
            spacing: 12px;
            Rectangle {
                y: (parent.height - self.height) / 2;
                height: 1px;
                horizontal-stretch: 1;
                background: Tokens.border-strong;
            }
            Text {
                text: "or";
                font-size: 13px;
                color: Tokens.text-faint;
            }
            Rectangle {
                y: (parent.height - self.height) / 2;
                height: 1px;
                horizontal-stretch: 1;
                background: Tokens.border-strong;
            }
        }
        if Layout.compact && !root.editing && !root.manual: BlockButton {
            text: "Continue with Google";
            kind: ButtonKind.secondary;
            enabled: root.google-ready && !root.busy;
            clicked => { root.google(); }
            GoogleMark { y: (parent.height - self.height) / 2; }
        }

        // Ce que la découverte a trouvé, ou ce qui lui a manqué. Un écran qui échoue
        // sans dire pourquoi laisse l'utilisateur essayer au hasard.
        if root.error != "": Text {
            text: root.error;
            font-size: 12px;
            color: Tokens.error;
            wrap: word-wrap;
        }
        if root.error == "" && root.hint != "": Text {
            text: root.hint;
            font-size: 12px;
            color: Tokens.text-muted;
            wrap: word-wrap;
        }

        if root.manual: Hairline {}

        // Some hosts and most companies sign in with a name of their own, not the
        // address: without this field such a mailbox could never connect.
        if root.manual: Field {
            label: "User name, if not the address";
            placeholder: "Leave empty to sign in with the address";
            value <=> root.username;
            accepted => { root.save-manual(); }
        }

        if root.manual: HorizontalLayout {
            spacing: 8px;
            Field {
                label: "IMAP server";
                placeholder: "imap.example.com";
                value <=> root.imap-host;
            }
            VerticalLayout {
                width: 80px;
                Field {
                    label: "Port";
                    value <=> root.imap-port;
                }
            }
        }

        if root.manual: CheckBox {
            text: "IMAP over TLS";
            checked <=> root.imap-tls;
        }

        if root.manual: HorizontalLayout {
            spacing: 8px;
            Field {
                label: "SMTP server";
                placeholder: "smtp.example.com";
                value <=> root.smtp-host;
            }
            VerticalLayout {
                width: 80px;
                Field {
                    label: "Port";
                    value <=> root.smtp-port;
                }
            }
        }

        if root.manual: CheckBox {
            text: "SMTP over TLS";
            checked <=> root.smtp-tls;
        }

        // On a phone: the two other doors as links, Continue being above.
        if Layout.compact && !root.editing && !root.manual: HorizontalLayout {
            padding-top: 6px;
            Button {
                text: "Import a profile";
                label: "Import a configuration profile (.mobileconfig)";
                kind: ButtonKind.ghost;
                enabled: !root.busy;
                clicked => { root.import-profile(); }
            }
            Rectangle { horizontal-stretch: 1; }
            Button {
                text: "Configure manually";
                kind: ButtonKind.ghost;
                clicked => { root.switch-to-manual(); }
            }
        }

        if !Layout.compact: ModalFooter {
            // La porte de secours reste visible avant même l'échec : quelqu'un qui sait
            // déjà que son serveur est exotique n'a pas à attendre que la découverte se
            // trompe pour le dire.
            if !root.manual: Button {
                text: "Configure manually";
                kind: ButtonKind.ghost;
                clicked => { root.switch-to-manual(); }
            }
            // The profile a host or an IT department sends for iPhones and Macs: the
            // servers in one file, without typing them.
            if !root.editing: Button {
                text: "Import a profile";
                label: "Import a configuration profile (.mobileconfig)";
                kind: ButtonKind.ghost;
                enabled: !root.busy;
                clicked => { root.import-profile(); }
            }
            Rectangle { horizontal-stretch: 1; }
            Button {
                text: "Cancel";
                clicked => { root.dismissed(); }
            }
            Button {
                text: root.busy ? "Looking up…" : ((root.manual || root.editing) ? "Save" : "Add");
                label: (root.manual || root.editing) ? "Save" : "Add";
                kind: ButtonKind.primary;
                enabled: !root.busy;
                clicked => { root.manual ? root.save-manual() : root.discover(); }
            }
        }
    }
}

// A row of what was found: a green tile with its tick, what it is, how it is reached.
// It fills once, in its turn: the green rises in the tile like a liquid, two curved
// layers sloshing up at slightly different speeds, then the tick springs in.
component FoundRow inherits Rectangle {
    in property <string> label;
    in property <string> detail;
    in property <bool> first;
    /// When this row's turn comes, after the page opened.
    in property <duration> delay;

    property <float> plein: 0;
    property <float> coche: 0;
    init => {
        root.plein = 1;
        root.coche = 1;
    }
    animate plein { duration: 620ms; delay: root.delay; easing: cubic-bezier(0.45, 0, 0.25, 1); }
    animate coche { duration: 420ms; delay: root.delay + 500ms; easing: cubic-bezier(0.34, 1.56, 0.64, 1); }

    height: 60px;
    Rectangle {
        visible: !root.first;
        x: 16px;
        height: 1px;
        y: 0px;
        background: Tokens.border;
    }
    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        spacing: 14px;
        Rectangle {
            y: (parent.height - self.height) / 2;
            width: 30px;
            height: 30px;
            border-radius: 8px;
            background: Tokens.surface-active;
            clip: true;
            // The back wave, paler, a little ahead; the front one, full green.
            Rectangle {
                x: -25px + 10px * root.plein;
                y: 26px - 41px * root.plein;
                width: 60px;
                height: 60px;
                border-radius: 30px;
                background: Tokens.green.transparentize(0.5);
            }
            Rectangle {
                x: -5px - 10px * root.plein;
                y: 32px - 47px * root.plein;
                width: 60px;
                height: 60px;
                border-radius: 30px;
                background: Tokens.green;
            }
            Icon {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                data: Icons.check;
                size: 18px * root.coche;
                weight: 2.4;
                tint: Tokens.accent-text;
            }
        }
        VerticalLayout {
            alignment: center;
            spacing: 1px;
            Text {
                text: root.label;
                font-size: 15.5px;
                color: Tokens.text;
                opacity: 0.4 + 0.6 * root.plein;
            }
            Text {
                text: root.detail;
                font-size: 13px;
                color: Tokens.text-muted;
                overflow: elide;
                opacity: root.plein;
            }
        }
    }
}

// On a phone, once an account is added (the Android mockups' O3): where Iris found its
// servers, as the PC says it, then the mail arriving, newest first. Nothing to wait
// for: Continue goes to the mail while it fills.
export component AccountFoundPage inherits Rectangle {
    in property <string> address;
    /// "Found in your provider's own settings."
    in property <string> source;
    in property <string> incoming;
    in property <string> outgoing;
    /// Where the password went: "password kept in Android's keystore".
    in property <string> keeper;
    in property <bool> syncing;
    /// "Found in 0.8 s".
    in property <string> took;
    /// The messages arrived so far, and for how long they have been coming.
    in property <int> count;
    in property <string> elapsed;
    callback continued();
    callback another();

    // A bar sliding while the mail comes: work under way, the one loop allowed.
    property <float> va: 0;
    Timer {
        interval: 40ms;
        running: root.syncing;
        triggered => {
            root.va = root.va >= 1 ? 0 : root.va + 0.02;
        }
    }
    // Once it is all here, the bar fills to its end and turns green.
    property <float> fini: root.syncing ? 0 : 1;
    animate fini { duration: 700ms; easing: cubic-bezier(0.45, 0, 0.25, 1); }

    background: Tokens.background;
    TouchArea {}

    VerticalLayout {
        padding-top: Layout.inset-top + 24px;
        padding-bottom: Layout.inset-bottom + 18px;
        padding-left: 20px;
        padding-right: 20px;
        spacing: 0px;

        Text {
            text: root.address;
            font-family: Tokens.font-display;
            font-size: 28px;
            font-weight: 600;
            color: Tokens.text;
            wrap: word-wrap;
        }
        Rectangle { height: 4px; }
        Text {
            text: root.source;
            font-size: 15px;
            color: Tokens.text-muted;
            wrap: word-wrap;
        }
        if root.took != "": Text {
            text: root.took;
            font-size: 13px;
            color: Tokens.text-faint;
        }
        Rectangle { height: 20px; }
        Rectangle {
            height: 180px;
            border-radius: 14px;
            background: Tokens.surface;
            clip: true;
            VerticalLayout {
                FoundRow { first: true; label: "Incoming"; detail: root.incoming; delay: 150ms; }
                FoundRow { label: "Outgoing"; detail: root.outgoing; delay: 450ms; }
                FoundRow { label: "Signed in"; detail: root.keeper; delay: 750ms; }
            }
        }
        Rectangle { height: 26px; }
        Text {
            text: root.syncing ? "Bringing your mail, newest first" : "Your mail is here";
            font-size: 15px;
            font-weight: 600;
            color: Tokens.text;
        }
        Rectangle { height: 10px; }
        Rectangle {
            height: 6px;
            border-radius: 3px;
            background: Tokens.surface-active;
            clip: true;
            // While it comes: a soft band running along, fading at its ends.
            Rectangle {
                visible: root.syncing;
                x: (parent.width + self.width) * root.va - self.width;
                width: parent.width * 0.38;
                border-radius: 3px;
                background: @linear-gradient(90deg, Tokens.accent.transparentize(1) 0%, Tokens.accent 45%, Tokens.accent 60%, Tokens.accent.transparentize(1) 100%);
            }
            // Then it fills from the left, and the accent turns green as it ends.
            Rectangle {
                x: 0px;
                width: parent.width * root.fini;
                border-radius: 3px;
                background: Tokens.accent.mix(Tokens.green, 1 - root.fini);
            }
        }
        Rectangle { height: 6px; }
        HorizontalLayout {
            Text {
                text: root.count == 0 ? (root.syncing ? "Waiting for the first messages" : "No message yet")
                    : root.count == 1 ? "1 message" : "\{root.count} messages";
                font-size: 13.5px;
                color: Tokens.text-muted;
                overflow: elide;
                horizontal-stretch: 1;
            }
            Text {
                text: root.elapsed;
                font-size: 13.5px;
                color: Tokens.text-faint;
            }
        }
        Rectangle { vertical-stretch: 1; }
        BlockButton {
            text: "Continue";
            clicked => { root.continued(); }
        }
        Rectangle { height: 10px; }
        BlockButton {
            text: "Add another account";
            kind: ButtonKind.ghost;
            clicked => { root.another(); }
        }
    }
}
