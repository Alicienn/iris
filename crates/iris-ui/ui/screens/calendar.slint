import { Layout, WidthClass } from "@iris/theme/layout.slint";
import { Tokens } from "@iris/theme/tokens.slint";
import { Icon, Icons, IconButton } from "@iris/base/icons.slint";
import {
    CalendarData, CalendarChipData, MonthCellData, WeekDayData, TimedEventData, PlanTaskData,
    AgendaRowData, CalendarPhoneData
} from "@iris/types.slint";
import { ScrollView } from "@iris/controls/scroll.slint";
import { Nav, SectionTitle, SectionRow } from "@iris/lists/nav.slint";
import { Button, ButtonKind, ButtonSize, Fab } from "@iris/controls/button.slint";
import { Check, CheckShape, Segmented, QueueSegments } from "@iris/controls/choice.slint";
import { TextField } from "@iris/controls/field.slint";
import { Hairline } from "@iris/base/atoms.slint";
import { SidebarFrame, WindowToolbar } from "@iris/shell/chrome.slint";
import {
    CalPill, RoundFab, PhoneCalendarBar, WeekStrip, PhoneAgenda, ToPlanBand, PhoneMonth,
    PeriodSlide
} from "@iris/screens/calendar-phone.slint";

// The panels' buttons, in the words they were written with: the shared `Button`,
// small, its kind read from `primary` and `danger`.
export component CalButton inherits Button {
    in property <bool> primary;
    /// With `primary`: a button that destroys something, in red.
    in property <bool> danger;

    size: ButtonSize.sm;
    kind: root.primary && root.danger ? ButtonKind.danger
        : root.primary ? ButtonKind.primary : ButtonKind.secondary;
}

// One event as a line. All day, a band of its calendar's colour; in a month cell, a
// dot, the hour and the title.
component Chip inherits Rectangle {
    in property <CalendarChipData> chip;
    callback opened(string);
    /// Where it is in the window, for the card that opens beside it.
    callback anchored(length, length, length);
    /// Right-click: its key, and where the pointer is in the window.
    callback menu(string, length, length);

    height: 20px;
    border-radius: 4px;
    background: root.chip.all-day
        ? root.chip.color.transparentize(touch.has-hover ? 0.7 : 0.8)
        : (touch.has-hover ? Tokens.surface-hover : transparent);
    clip: true;

    accessible-role: button;
    accessible-label: root.chip.time == "" ? root.chip.title : root.chip.time + " " + root.chip.title;
    accessible-action-default => { root.opened(root.chip.key); }

    HorizontalLayout {
        padding-left: root.chip.all-day ? 7px : 2px;
        padding-right: 4px;
        spacing: 5px;
        if !root.chip.all-day: Rectangle {
            y: (parent.height - self.height) / 2;
            width: 6px;
            height: 6px;
            border-radius: 3px;
            background: root.chip.color;
        }
        if root.chip.time != "": Text {
            text: root.chip.time;
            font-size: 12px;
            color: Tokens.text-muted;
            vertical-alignment: center;
        }
        Text {
            text: root.chip.title;
            font-size: 12px;
            font-weight: root.chip.all-day ? 500 : 400;
            color: root.chip.all-day ? Tokens.text : Tokens.text-secondary;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.anchored(root.absolute-position.x, root.absolute-position.x + root.width,
                root.absolute-position.y);
            root.opened(root.chip.key);
        }
        pointer-event(ev) => {
            if (ev.button == PointerEventButton.right && ev.kind == PointerEventKind.down) {
                root.menu(root.chip.key,
                    self.absolute-position.x + self.mouse-x,
                    self.absolute-position.y + self.mouse-y);
            }
        }
    }
}

// The small month on the left: a way to jump, not a way to read. The week shown is
// tinted, today is the accent, a day with something in it is bold.
export component MiniMonth inherits VerticalLayout {
    in property <string> title;
    in property <[MonthCellData]> cells;

    callback day-chosen(string);
    callback navigate(int);

    spacing: 1px;

    HorizontalLayout {
        height: 28px;
        padding-left: 6px;
        Text {
            text: root.title;
            font-size: 12.5px;
            font-weight: 600;
            color: Tokens.text;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
        IconButton {
            y: (parent.height - self.height) / 2;
            icon: Icons.chevron-left;
            label: "Previous month";
            button-size: 26px;
            icon-size: 14px;
            clicked => { root.navigate(-1); }
        }
        IconButton {
            y: (parent.height - self.height) / 2;
            icon: Icons.chevron-right;
            label: "Next month";
            button-size: 26px;
            icon-size: 14px;
            clicked => { root.navigate(1); }
        }
    }

    HorizontalLayout {
        height: 22px;
        for initiale in ["M", "T", "W", "T", "F", "S", "S"]: Text {
            text: initiale;
            font-size: 10px;
            color: Tokens.text-faint;
            horizontal-alignment: center;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
    }

    // Rows of 24, no gap between days: the week's band runs on unbroken.
    for semaine in 6: HorizontalLayout {
        height: 24px;
        spacing: 0px;
        for colonne in 7: Rectangle {
            property <MonthCellData> cell: root.cells[semaine * 7 + colonne];
            horizontal-stretch: 1;
            // The week shown is a band across; today a red disc in it.
            background: self.cell.in-week ? Tokens.select-quiet : transparent;
            border-radius: 0px;

            Rectangle {
                width: min(parent.width, 22px);
                height: 22px;
                border-radius: 11px;
                background: cell.today ? Tokens.red
                    : cell.selected ? Tokens.surface-active
                    : toucher.has-hover ? Tokens.surface-hover : transparent;
            }

            accessible-role: button;
            accessible-label: self.cell.date;
            accessible-action-default => { root.day-chosen(self.cell.date); }

            Text {
                text: cell.day;
                font-size: 11px;
                font-weight: cell.today || cell.events.length > 0 ? 600 : 400;
                color: cell.today ? Tokens.accent-text
                    : !cell.in-month ? Tokens.text-faint
                    : cell.events.length > 0 ? Tokens.text
                    : Tokens.text-secondary;
            }
            toucher := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.day-chosen(cell.date); }
            }
        }
    }
}

// A calendar in the list: its colour as a box ticked when it shows, its name, and for
// a subscription how fresh it is.
component CalendarRow inherits Rectangle {
    in property <CalendarData> cal;
    callback toggled(int);
    callback refresh(int);
    callback remove(CalendarData);
    /// A right click, where it happened in the window.
    callback menu(CalendarData, length, length);

    height: Nav.row-height;
    border-radius: Tokens.radius-small;
    background: Nav.background(false, touch.has-hover);

    accessible-role: checkbox;
    accessible-label: root.cal.name;
    accessible-checked: root.cal.visible;
    accessible-description: root.cal.status;
    accessible-action-default => { root.toggled(root.cal.id); }

    touch := TouchArea {
        clicked => { root.toggled(root.cal.id); }
        pointer-event(event) => {
            if (event.button == PointerEventButton.right && event.kind == PointerEventKind.up) {
                root.menu(root.cal,
                    self.absolute-position.x + self.mouse-x,
                    self.absolute-position.y + self.mouse-y);
            }
        }
    }

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 6px;
        spacing: 8px;

        // Its colour as a dot, as Calendar lists them: filled when it shows, a ring
        // when hidden. The row answers the click.
        Rectangle {
            y: (parent.height - self.height) / 2;
            width: 9px;
            height: 9px;
            border-radius: 4.5px;
            background: root.cal.visible ? root.cal.color : transparent;
            border-width: root.cal.visible ? 0px : 1.5px;
            border-color: root.cal.color;
        }

        Text {
            text: root.cal.name;
            font-size: Nav.label-size;
            color: root.cal.visible ? Tokens.text : Tokens.text-muted;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }

        if root.cal.status != "" && !((root.cal.subscribed || root.cal.remote) && (touch.has-hover || Layout.touch-input)): Text {
            text: root.cal.status;
            font-size: 11.5px;
            color: root.cal.failed ? Tokens.error : Tokens.text-muted;
            vertical-alignment: center;
            overflow: elide;
            max-width: 110px;
        }

        if (root.cal.subscribed || root.cal.remote) && (touch.has-hover || Layout.touch-input): IconButton {
            y: (parent.height - self.height) / 2;
            icon: Icons.refresh;
            label: (root.cal.remote ? "Sync " : "Refresh ") + root.cal.name;
            button-size: 24px;
            icon-size: 13px;
            clicked => { root.refresh(root.cal.id); }
        }
        if root.cal.subscribed && (touch.has-hover || Layout.touch-input): IconButton {
            y: (parent.height - self.height) / 2;
            icon: Icons.trash;
            label: "Unsubscribe from " + root.cal.name;
            button-size: 24px;
            icon-size: 13px;
            danger: true;
            clicked => { root.remove(root.cal); }
        }
    }
}

// The month: six weeks of seven days, each cell its number and its first events.
component MonthGrid inherits VerticalLayout {
    in property <[MonthCellData]> cells;
    callback day-opened(string);
    callback day-double-clicked(string);
    callback event-opened(string);
    callback event-anchored(length, length, length);
    callback event-menu(string, length, length);

    padding-left: 12px;
    padding-right: 12px;
    padding-bottom: 12px;

    HorizontalLayout {
        height: 32px;
        for nom in ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"]: HorizontalLayout {
            horizontal-stretch: 1;
            preferred-width: 0;
            // Over the day numbers, which sit a few pixels in.
            padding-left: 8px;
            Text {
                text: nom;
                font-size: 12px;
                color: Tokens.text-muted;
                vertical-alignment: center;
            }
        }
    }

    // Every row and every column the same size, whatever is in them: a grid whose
    // lines move with its content is not a grid. A zero preferred size lets the
    // stretch alone decide.
    for semaine in 6: HorizontalLayout {
        vertical-stretch: 1;
        preferred-height: 0;
        min-height: 0;
        for colonne in 7: Rectangle {
            property <MonthCellData> cell: root.cells[semaine * 7 + colonne];
            horizontal-stretch: 1;
            preferred-width: 0;
            min-width: 0;
            clip: true;
            background: case.has-hover || self.cell.selected ? Tokens.surface-hover : transparent;

            // A line over each row, and between the days.
            Rectangle { y: 0; height: 1px; background: Tokens.border; }
            if colonne > 0: Rectangle { x: 0; width: 1px; background: Tokens.border; }

            // Clicks on the cell itself, beneath its events.
            case := TouchArea {
                clicked => { root.day-opened(cell.date); }
                double-clicked => { root.day-double-clicked(cell.date); }
            }

            VerticalLayout {
                padding: 5px;
                spacing: 2px;
                alignment: start;

                HorizontalLayout {
                    height: 22px;
                    Rectangle {
                        // "1 Oct" on the first of a month is wider than a number.
                        width: max(22px, numero.preferred-width + 10px);
                        height: 22px;
                        border-radius: 11px;
                        background: cell.today ? Tokens.red : transparent;
                        numero := Text {
                            text: cell.day;
                            font-size: 12px;
                            font-weight: cell.today ? 600 : 400;
                            color: cell.today ? Tokens.accent-text
                                : cell.in-month ? Tokens.text-secondary : Tokens.text-faint;
                        }
                    }
                    Rectangle {}
                }

                for chip in cell.events: Chip {
                    chip: chip;
                    opacity: cell.in-month ? 1.0 : 0.55;
                    anchored(l, r, t) => { root.event-anchored(l, r, t); }
                    opened(k) => { root.event-opened(k); }
                    menu(k, x, y) => { root.event-menu(k, x, y); }
                }
                if cell.more > 0: Text {
                    text: "+" + cell.more + " more";
                    font-size: 11px;
                    color: Tokens.text-muted;
                    height: 16px;
                }
            }
        }
    }
}

// The week or the day: a column per day, an hour grid, events placed by time. A click
// on a free slot opens a line there to type the event's title in.
component WeekGrid inherits VerticalLayout {
    in property <[WeekDayData]> days;
    in property <[TimedEventData]> events;
    /// Where "now" is, as a fraction of the day, and in which column. -1: not shown.
    in property <float> now-fraction: -1;
    in property <int> now-day: -1;

    callback event-opened(string);
    callback event-anchored(length, length, length);
    /// Right-click on an event: its key, and the pointer in the window.
    callback event-menu(string, length, length);
    callback slot-double-clicked(string, int);
    callback day-opened(string);
    /// A title typed in a free slot: (day, minute of the day, title).
    callback quick-event(string, int, string);
    /// The typed line was saved or dropped.
    callback draft-closed();
    /// An event dragged elsewhere: (key, days later, minutes later), by quarter hours.
    callback event-moved(string, int, int);
    /// An event stretched by its lower edge: (key, minutes added to its end).
    callback event-resized(string, int);
    /// A slot opened to type in, on a phone: the calendar's bar steps aside for it.
    callback draft-opened();
    /// A task from "To plan" touched on a phone, waiting for a time (-1: none): the
    /// next touch on the grid books it there, as (day, minute of the day).
    in property <int> picked-task: -1;
    callback slot-picked(string, int);
    /// The three days' header or the grid swiped on a phone: a period later (1) or
    /// earlier (-1).
    callback swiped(int);
    /// The first day shown, as a number that grows with time: when it changes, the
    /// days slide in from the side they lie on.
    in property <int> period;
    /// The colour of the calendar an event typed on a slot goes into.
    in property <color> quick-color;

    // A phone's hour is the mockups' sixty pixels, its margin fifty-eight.
    property <length> hour: Layout.compact ? 60px : 52px;

    // The event held by the pointer: which (its key), how (1 moved, 2 stretched, 0 not
    // yet: a press becomes a drag past four pixels, so a click still opens it), and how
    // far the pointer went since the press, in window coordinates. Those stay put while
    // the event moves under the pointer; its own would not.
    property <string> drag-key;
    property <int> drag-mode;
    property <bool> drag-stretch;
    property <length> press-x;
    property <length> press-y;
    property <length> drag-dx;
    property <length> drag-dy;
    /// A drag just ended: the click its release makes is not an opening.
    property <bool> dragged;

    /// A distance down the grid, in minutes, to the quarter hour.
    pure function quarters(dy: length) -> int {
        return round(dy / (root.hour / 4)) * 15;
    }

    // The held event, and where it would land: days and minutes later when moved,
    // minutes added to its end when stretched. Never out of the week or the day, never
    // shorter than a quarter hour.
    property <TimedEventData> held;
    property <int> held-begins: round(root.held.top * 1440);
    property <int> held-span: round(root.held.height * 1440);
    property <int> shift-days: root.drag-mode == 1
        ? clamp(round(root.drag-dx / grille.colonne), -root.held.day, root.days.length - 1 - root.held.day)
        : 0;
    property <int> shift-minutes: root.drag-mode == 1
        ? clamp(root.quarters(root.drag-dy), -root.held-begins, 1440 - root.held-begins - root.held-span)
        : 0;
    property <int> stretch: root.drag-mode == 2
        ? clamp(root.quarters(root.drag-dy), 15 - root.held-span, 1440 - root.held-begins - root.held-span)
        : 0;
    property <int> landing-start: root.held-begins + root.shift-minutes;
    property <int> landing-end: root.landing-start + root.held-span + root.stretch;

    /// Stretched by a quarter hour more or less: the week is laid out again with it so,
    /// and the events it reaches make room, while it keeps its share of the column.
    callback event-stretching(string, int);
    /// The stretch last reported, so each quarter hour is said once.
    property <int> stretch-sent;

    // A task carried from the side column, in window coordinates, and how long the
    // block it books. `drop` goes up by one when it is let go.
    in property <bool> carrying;
    in property <length> carry-x;
    in property <length> carry-y;
    in property <int> carry-minutes: 30;
    in property <int> drop;
    /// A task let go on the grid: (day, minute of the day).
    callback task-dropped(string, int);

    /// Where the carried task would land: its column (-1: not over the grid) and its
    /// minute, by quarter hours, its top at the pointer's quarter.
    property <bool> over-grid: root.carry-x >= defil.absolute-position.x + root.gutter
        && root.carry-x < defil.absolute-position.x + defil.width
        && root.carry-y >= defil.absolute-position.y
        && root.carry-y < defil.absolute-position.y + defil.height;
    // The grid's top left on screen, its scroll counted (`absolute-position` inside the
    // scrolled grid does not count it).
    property <length> grid-x: defil.absolute-position.x + defil.content-x;
    property <length> grid-y: defil.absolute-position.y + defil.content-y;
    property <int> carry-day: root.over-grid
        ? floor((root.carry-x - root.grid-x - root.gutter) / grille.colonne)
        : -1;
    property <int> carry-minute: clamp(
        floor((root.carry-y - root.grid-y) / (root.hour / 4)) * 15,
        0, 1440 - root.carry-minutes);

    changed drop => {
        if (root.carry-day >= 0 && root.carry-day < root.days.length) {
            root.task-dropped(root.days[root.carry-day].date, root.carry-minute);
        }
    }
    property <length> gutter: Layout.compact ? 58px : 56px;
    // Now, as the clock says it: "16:20".
    property <int> minutes: floor(root.now-fraction * 1440);
    property <string> now-label: root.hm(self.minutes);

    /// The slot being typed into: its column (-1: none) and its minute.
    property <int> draft-day: -1;
    property <int> draft-minute;
    /// On a phone the title is typed in a field over the keyboard, and shown in the slot.
    property <string> draft-title;
    property <length> glisse;

    pure function hm(m: int) -> string {
        return (floor(m / 60) < 10 ? "0" : "") + floor(m / 60) + ":"
            + (mod(m, 60) < 10 ? "0" : "") + mod(m, 60);
    }
    function close-draft() {
        if (root.draft-day >= 0) {
            root.draft-day = -1;
            root.draft-title = "";
            root.draft-closed();
        }
    }
    /// The phone's field over the keyboard: Add, or Enter, makes the event.
    function save-draft() {
        if (root.draft-day < 0 || root.draft-day >= root.days.length) {
            return;
        }
        let jour = root.days[root.draft-day].date;
        let minute = root.draft-minute;
        let titre = root.draft-title;
        root.close-draft();
        if (titre != "") {
            root.quick-event(jour, minute, titre);
        }
    }

    // A phone's three days: the name over the number, centred in the column, today in
    // red. Swiped, three days further. A single day has the week's strip above instead.
    if Layout.compact && root.days.length > 1: SwipeGestureHandler {
        height: 54px;
        handle-swipe-left: true;
        handle-swipe-right: true;
        moved => {
            root.glisse = self.current-position.x - self.pressed-position.x;
        }
        swiped => {
            if (root.glisse < -40px) {
                root.swiped(1);
            } else if (root.glisse > 40px) {
                root.swiped(-1);
            }
            root.glisse = 0px;
        }
        cancelled => {
            root.glisse = 0px;
        }
        PeriodSlide {
            period: root.period;
            drag: root.glisse;
        HorizontalLayout {
            padding-top: 4px;
            padding-bottom: 8px;
            Rectangle { width: root.gutter; }
            for d in root.days: Rectangle {
                horizontal-stretch: 1;
                accessible-role: button;
                accessible-label: d.name + " " + d.day;
                accessible-action-default => { root.day-opened(d.date); }
                TouchArea {
                    clicked => { root.day-opened(d.date); }
                }
                VerticalLayout {
                    alignment: start;
                    Text {
                        text: d.name;
                        font-size: 12.5px;
                        font-weight: d.today ? 600 : 400;
                        color: d.today ? Tokens.red : Tokens.text-muted;
                        horizontal-alignment: center;
                    }
                    Text {
                        text: d.day;
                        font-size: 20px;
                        font-weight: d.today ? 600 : 400;
                        color: d.today ? Tokens.red : Tokens.text;
                        horizontal-alignment: center;
                    }
                }
            }
        }
        } // PeriodSlide
    }
    if Layout.compact && root.days.length > 1: Hairline {}

    // Day headers: the name, then the number; today in the accent, the weekend quieter.
    if !Layout.compact: HorizontalLayout {
        height: 40px;
        Rectangle { width: root.gutter; }
        for d in root.days: jour := Rectangle {
            property <bool> repos: d.name == "Sat" || d.name == "Sun";
            horizontal-stretch: 1;
            TouchArea {
                mouse-cursor: pointer;
                clicked => { root.day-opened(d.date); }
            }
            HorizontalLayout {
                padding-left: 10px;
                alignment: start;
                spacing: 6px;
                Text {
                    text: d.name;
                    font-size: 12.5px;
                    font-weight: d.today ? 600 : 400;
                    color: d.today ? Tokens.red : Tokens.text-muted;
                    vertical-alignment: center;
                }
                // Today's number on a red disc, as Calendar has it: never narrower than
                // it is tall, so "1" is a disc and not a squeezed bar.
                Rectangle {
                    y: (parent.height - self.height) / 2;
                    width: d.today ? max(28px, numero.preferred-width + 14px) : numero.preferred-width;
                    height: 28px;
                    border-radius: 14px;
                    background: d.today ? Tokens.red : transparent;
                    numero := Text {
                        width: parent.width;
                        height: parent.height;
                        text: d.day;
                        font-size: 18px;
                        font-weight: d.today ? 600 : 500;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        color: d.today ? Tokens.accent-text : Tokens.text;
                    }
                }
            }
        }
    }
    if !Layout.compact: Hairline {}

    // All-day events, each day its own short column. A phone's single day shows the
    // row only when there is something in it.
    property <bool> journee: !Layout.compact || root.days.length > 1
        || (root.days.length == 1 && root.days[0].all-day.length > 0);
    if root.journee: HorizontalLayout {
        min-height: Layout.compact ? 30px : 28px;
        Rectangle {
            width: root.gutter;
            Text {
                x: 0px;
                width: parent.width - (Layout.compact ? 8px : 0px);
                text: "all day";
                font-size: Layout.compact ? 12px : 11px;
                color: Tokens.text-muted;
                vertical-alignment: center;
                horizontal-alignment: Layout.compact ? TextHorizontalAlignment.right : TextHorizontalAlignment.center;
            }
        }
        for d in root.days: VerticalLayout {
            horizontal-stretch: 1;
            padding: 3px;
            spacing: 2px;
            for chip in d.all-day: Chip {
                chip: chip;
                anchored(l, r, t) => { root.event-anchored(l, r, t); }
                opened(k) => { root.event-opened(k); }
                menu(k, x, y) => { root.event-menu(k, x, y); }
            }
        }
    }
    if root.journee: Hairline {}

    // On a phone the hours themselves are swiped sideways, as the month is: the next
    // days follow the finger and slide in. Up and down stays the scroll.
    SwipeGestureHandler {
        vertical-stretch: 1;
        handle-swipe-left: Layout.compact && root.drag-mode == 0 && root.draft-day < 0;
        handle-swipe-right: Layout.compact && root.drag-mode == 0 && root.draft-day < 0;
        moved => {
            root.glisse = self.current-position.x - self.pressed-position.x;
        }
        swiped => {
            if (root.glisse < -40px) {
                root.swiped(1);
            } else if (root.glisse > 40px) {
                root.swiped(-1);
            }
            root.glisse = 0px;
        }
        cancelled => {
            root.glisse = 0px;
        }
    PeriodSlide {
        width: parent.width;
        height: parent.height;
        period: root.period;
        drag: root.glisse;

    defil := ScrollView {
        width: parent.width;
        height: parent.height;
        content-height: root.hour * 24;
        // The mouse carries events; the wheel scrolls.
        mouse-drag-pan-enabled: false;
        // Opens on the working day rather than on midnight; a phone at eight, its
        // first hour under the bar.
        init => { self.content-y = Layout.compact ? -root.hour * 8 + 14px : -root.hour * 7.5; }

        grille := Rectangle {
            width: defil.visible-width;
            height: root.hour * 24;

            property <length> colonne: (self.width - root.gutter) / max(1, root.days.length);

            // The columns: the weekend faintly shaded, a line between the days, and
            // the click that opens a slot to type in (a double click opens the whole
            // editor instead).
            for d[i] in root.days: Rectangle {
                x: root.gutter + i * grille.colonne;
                width: grille.colonne;
                height: grille.height;
                // The weekend on the window's grey, as Calendar shades it.
                background: d.name == "Sat" || d.name == "Sun"
                    ? Tokens.group : transparent;
                Rectangle { x: 0; width: 1px; background: Tokens.border; }
                TouchArea {
                    clicked => {
                        // A task waiting for a time: booked here, its top at the
                        // quarter hour touched.
                        if (root.picked-task >= 0) {
                            root.slot-picked(d.date, floor(self.mouse-y / (root.hour / 4)) * 15);
                            return;
                        }
                        if (root.draft-day >= 0) {
                            root.close-draft();
                        } else {
                            root.draft-minute = floor(self.mouse-y / (root.hour / 2)) * 30;
                            root.draft-day = i;
                            root.draft-opened();
                        }
                    }
                    double-clicked => {
                        root.close-draft();
                        root.slot-double-clicked(d.date, floor(self.mouse-y / root.hour) * 60);
                    }
                }
            }

            // Hours: a line across the days, and its label in the margin.
            for h in 24: Rectangle {
                y: h * root.hour;
                height: 1px;
                Rectangle {
                    x: root.gutter;
                    width: parent.width - root.gutter;
                    height: 1px;
                    background: Tokens.border;
                }
                Text {
                    x: 0;
                    y: Layout.compact ? -9px : -7px;
                    width: root.gutter - (Layout.compact ? 18px : 8px);
                    height: Layout.compact ? 18px : 14px;
                    text: h == 0 ? "" : root.hm(h * 60);
                    font-size: Layout.compact ? 12px : 11px;
                    color: Layout.compact ? Tokens.text-muted : Tokens.text-faint;
                    horizontal-alignment: right;
                    // The hour of now takes the place of the one it is near.
                    opacity: root.now-day >= 0 && root.now-fraction >= 0
                        && abs(root.minutes - h * 60) < 15 ? 0 : 1;
                }
            }

            // Events: tinted with their calendar's colour, a line of it around; side
            // by side when they overlap. One of one's own can be dragged to another
            // time or day, or stretched by its lower edge: it stays where it is,
            // faded, while a copy drawn over everything follows the pointer by
            // quarter hours; it lands when let go.
            for e in root.events: evenement := Rectangle {
                // Moved, it fades where it was under the copy that follows the
                // pointer; stretched, it is drawn itself, at its new length.
                property <bool> held: root.drag-mode == 1 && root.drag-key == e.key;
                // Just dropped: it lands from a few pixels above, with a bounce.
                property <float> chute: e.landed ? 1 : 0;
                animate chute { duration: 420ms; easing: ease-out-bounce; }
                init => { if (e.landed) { self.chute = 0; } }

                x: root.gutter + e.day * grille.colonne + e.lane * grille.colonne / max(1, e.lanes) + 3px;
                y: e.top * grille.height + 1px - 10px * self.chute;
                width: grille.colonne / max(1, e.lanes) - 7px;
                height: max(22px, e.height * grille.height - 2px);
                // As Calendar draws them: a pale block of the calendar's colour, a bar
                // of it down the left, the words in a deeper shade of it. A phone's
                // blocks are rounder, their words the text's own (the mockups' `.ev`).
                border-radius: Layout.compact ? 8px : Tokens.radius-small;
                background: e.color.transparentize(bloc.has-hover ? 0.75 : 0.83);
                opacity: self.held ? 0.35 : e.past ? 0.55 : 1.0;
                clip: true;
                // The bar of its colour, inset from the top and bottom with round
                // ends: drawn full height, it squared the block's left corners (the
                // software renderer's clip ignores the radius).
                Rectangle {
                    x: 2px;
                    y: 3px;
                    width: 3px;
                    height: max(0px, parent.height - 6px);
                    border-radius: 1.5px;
                    background: e.color;
                }

                accessible-role: button;
                accessible-label: e.time + " " + e.title;
                // What a mouse can do with it, said; the menu (Edit) does it without one.
                accessible-description: e.movable
                    ? "Drag to move it, its lower edge to change its length; right-click for more"
                    : "Right-click for more";
                accessible-action-default => { root.event-opened(e.key); }

                VerticalLayout {
                    padding-left: 9px;
                    padding-top: Layout.compact ? 5px : 4px;
                    padding-right: 5px;
                    spacing: 1px;
                    alignment: start;
                    // The calendar's colour, taken towards the text's: darker on
                    // white, lighter on graphite.
                    Text {
                        text: e.title;
                        font-size: Layout.compact ? 13.5px : 12px;
                        font-weight: 600;
                        color: Layout.compact ? Tokens.text : e.color.mix(Tokens.text, 0.55);
                        overflow: elide;
                    }
                    if evenement.height > 34px: Text {
                        text: e.time;
                        font-size: Layout.compact ? 12.5px : 11px;
                        color: Layout.compact ? Tokens.text-secondary
                            : e.color.mix(Tokens.text, 0.55).transparentize(0.2);
                        overflow: elide;
                    }
                }
                bloc := TouchArea {
                    // The lower edge stretches; the rest moves.
                    mouse-cursor: e.movable && self.mouse-y > evenement.height - 6px
                        ? MouseCursor.ns-resize
                        : (evenement.held ? MouseCursor.grabbing : MouseCursor.pointer);
                    pointer-event(ev) => {
                        // Right-click: its menu, at the pointer (placed from the
                        // grid's own position and scroll, as the card is).
                        if (ev.button == PointerEventButton.right
                            && ev.kind == PointerEventKind.down) {
                            root.close-draft();
                            root.event-menu(e.key,
                                defil.absolute-position.x + defil.content-x + evenement.x + self.mouse-x,
                                defil.absolute-position.y + defil.content-y + evenement.y + self.mouse-y);
                            return;
                        }
                        if (ev.button != PointerEventButton.left) {
                            return;
                        }
                        if (ev.kind == PointerEventKind.down) {
                            root.dragged = false;
                            if (e.movable) {
                                root.held = e;
                                root.drag-key = e.key;
                                root.drag-mode = 0;
                                root.drag-stretch = self.mouse-y > evenement.height - 6px;
                                root.press-x = self.absolute-position.x + self.mouse-x;
                                root.press-y = self.absolute-position.y + self.mouse-y;
                                root.drag-dx = 0;
                                root.drag-dy = 0;
                            }
                        } else if (ev.kind == PointerEventKind.up && root.drag-key == e.key) {
                            if (root.drag-mode == 1
                                && (root.shift-days != 0 || root.shift-minutes != 0)) {
                                root.event-moved(e.key, root.shift-days, root.shift-minutes);
                            } else if (root.drag-mode == 2 && root.stretch != 0) {
                                root.event-resized(e.key, root.stretch);
                            }
                            root.dragged = root.drag-mode != 0;
                            root.drag-mode = 0;
                            root.drag-key = "";
                        }
                    }
                    moved => {
                        if (self.pressed && root.drag-key == e.key) {
                            root.drag-dx = self.absolute-position.x + self.mouse-x - root.press-x;
                            root.drag-dy = self.absolute-position.y + self.mouse-y - root.press-y;
                            if (root.drag-mode == 0
                                && (abs(root.drag-dx) > 4px || abs(root.drag-dy) > 4px)) {
                                root.close-draft();
                                root.drag-mode = root.drag-stretch ? 2 : 1;
                                root.stretch-sent = 0;
                            }
                            if (root.drag-mode == 2 && root.stretch != root.stretch-sent) {
                                root.stretch-sent = root.stretch;
                                root.event-stretching(e.key, root.stretch);
                            }
                        }
                    }
                    clicked => {
                        if (root.dragged) {
                            root.dragged = false;
                            return;
                        }
                        root.close-draft();
                        // Where it is on screen, from the grid's own place and scroll.
                        // `absolute-position` inside the scrolled grid was off, and the
                        // card opened hundreds of pixels away from the event, further
                        // the more the day was scrolled.
                        let gauche = defil.absolute-position.x + defil.content-x + evenement.x;
                        root.event-anchored(gauche, gauche + evenement.width,
                            defil.absolute-position.y + defil.content-y + evenement.y);
                        root.event-opened(e.key);
                    }
                }
            }

            // The moved event where it would land, over the others, with its new time.
            if root.drag-mode == 1: Rectangle {
                x: root.gutter + (root.held.day + root.shift-days) * grille.colonne + 2px;
                y: root.landing-start / 1440 * grille.height + 1px;
                width: grille.colonne - 4px;
                height: max(22px, (root.landing-end - root.landing-start) / 1440 * grille.height - 3px);
                border-radius: Tokens.radius-small;
                border-width: 1.5px;
                border-color: root.held.color;
                background: Tokens.surface;
                drop-shadow-blur: Tokens.shadow-float-blur;
                drop-shadow-offset-y: Tokens.shadow-float-y;
                drop-shadow-color: Tokens.shadow-float;
                Rectangle {
                    border-radius: Tokens.radius-small;
                    background: root.held.color.transparentize(0.72);
                }
                VerticalLayout {
                    padding-left: 7px;
                    padding-top: 4px;
                    padding-right: 5px;
                    spacing: 1px;
                    alignment: start;
                    Text {
                        text: root.held.title;
                        font-size: 12px;
                        font-weight: 600;
                        color: Tokens.text;
                        overflow: elide;
                    }
                    Text {
                        text: root.hm(root.landing-start) + " – " + root.hm(min(1439, root.landing-end));
                        font-size: 11px;
                        font-weight: 600;
                        color: Tokens.text-secondary;
                        overflow: elide;
                    }
                }
            }

            // Where a carried task would be booked: its length, dashed in the accent.
            if root.carrying && root.carry-day >= 0 && root.carry-day < root.days.length: Rectangle {
                x: root.gutter + root.carry-day * grille.colonne + 2px;
                y: root.carry-minute / 1440 * grille.height + 1px;
                width: grille.colonne - 4px;
                height: max(20px, root.carry-minutes / 1440 * grille.height - 3px);
                border-radius: Tokens.radius-small;
                border-width: 1.5px;
                border-color: Tokens.accent;
                background: Tokens.accent-soft;
                Text {
                    x: 7px;
                    y: 4px;
                    text: root.hm(root.carry-minute) + " – "
                        + root.hm(min(1439, root.carry-minute + root.carry-minutes));
                    font-size: 11px;
                    font-weight: 600;
                    color: Tokens.accent;
                }
            }

            // The slot being typed into: an hour, outlined in the accent. Enter saves,
            // Escape drops it.
            if root.draft-day >= 0 && root.draft-day < root.days.length: brouillon := Rectangle {
                x: root.gutter + root.draft-day * grille.colonne + 2px;
                y: root.draft-minute / 1440 * grille.height + 1px;
                width: grille.colonne - 4px;
                height: root.hour - 3px;
                border-radius: Layout.compact ? 8px : Tokens.radius-small;
                border-width: Layout.compact ? 2px : 1.5px;
                border-color: Tokens.accent;
                background: Tokens.accent-soft;

                // Swallows the click, so typing does not reach the column behind.
                TouchArea {}

                // A phone types the title in the field over the keyboard: the slot
                // shows it as it comes (`.ev.draft`).
                if Layout.compact: VerticalLayout {
                    padding-left: 9px;
                    padding-right: 9px;
                    padding-top: 5px;
                    spacing: 1px;
                    alignment: start;
                    Text {
                        text: root.draft-title == "" ? "New event" : root.draft-title;
                        font-size: 13.5px;
                        font-weight: 600;
                        color: Tokens.accent;
                        overflow: elide;
                    }
                    Text {
                        text: root.hm(root.draft-minute) + " – "
                            + root.hm(min(1439, root.draft-minute + 60));
                        font-size: 12.5px;
                        color: Tokens.accent;
                        overflow: elide;
                    }
                }

                if !Layout.compact: FocusScope {
                    enabled: false;
                    key-pressed(event) => {
                        if (event.text == Key.Escape) {
                            root.close-draft();
                            return accept;
                        }
                        return reject;
                    }

                    VerticalLayout {
                        padding-left: 2px;
                        padding-right: 4px;
                        padding-top: 1px;
                        spacing: 0px;
                        alignment: start;
                        TextField {
                            bare: true;
                            height: 24px;
                            accessible-label: "New event title";
                            placeholder-text: "New event";
                            font-size: 12px;
                            // Opened to be typed in: the first key is the title's.
                            init => { self.focus(); }
                            accepted(t) => {
                                let jour = root.days[root.draft-day].date;
                                let minute = root.draft-minute;
                                root.close-draft();
                                if (t != "") {
                                    root.quick-event(jour, minute, t);
                                }
                            }
                        }
                        Text {
                            text: "  " + root.hm(root.draft-minute) + " – "
                                + root.hm(min(1439, root.draft-minute + 60)) + " · Enter to save";
                            font-size: 11px;
                            color: Tokens.text-secondary;
                            overflow: elide;
                        }
                    }
                }
            }

            // Now: its hour in the margin, and a line across today's column.
            // The time of now in a red capsule in the margin, as Calendar has it; on a
            // phone, in red letters on the page (`.now span`).
            if Layout.compact && root.now-day >= 0 && root.now-fraction >= 0: Rectangle {
                x: 0px;
                y: root.now-fraction * grille.height - 9px;
                width: root.gutter - 10px;
                height: 18px;
                background: Tokens.surface;
                Text {
                    width: parent.width - 8px;
                    x: 0px;
                    text: root.now-label;
                    font-size: 12px;
                    font-weight: 700;
                    color: Tokens.red;
                    horizontal-alignment: right;
                    vertical-alignment: center;
                }
            }
            if !Layout.compact && root.now-day >= 0 && root.now-fraction >= 0: Rectangle {
                x: 4px;
                y: root.now-fraction * grille.height - 9px;
                width: root.gutter - 8px;
                height: 18px;
                border-radius: 9px;
                background: Tokens.red;
                Text {
                    text: root.now-label;
                    font-size: 10.5px;
                    font-weight: 600;
                    color: Tokens.accent-text;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
            if root.now-day >= 0 && root.now-fraction >= 0: Rectangle {
                x: root.gutter + root.now-day * grille.colonne - 4px;
                y: root.now-fraction * grille.height - 4px;
                width: grille.colonne + 4px;
                height: 8px;
                // One pulse when the calendar opens: a ring that widens and fades
                // from the point, then nothing.
                property <float> pouls: 0;
                animate pouls { duration: 800ms; easing: ease-out; }
                init => { self.pouls = 1; }
                Rectangle {
                    width: 8px + 18px * parent.pouls;
                    height: self.width;
                    x: 4px - self.width / 2;
                    y: 4px - self.height / 2;
                    border-radius: self.width / 2;
                    background: Tokens.error.transparentize(0.55 + 0.45 * parent.pouls);
                }
                Rectangle {
                    x: 0;
                    width: 8px;
                    height: 8px;
                    border-radius: 4px;
                    background: Tokens.error;
                }
                Rectangle {
                    x: 4px;
                    y: 3px;
                    height: 2px;
                    background: Tokens.error;
                }
            }
        }
    }
    } // PeriodSlide
    } // SwipeGestureHandler

    // A phone's slot opened: the title is typed here, over the keyboard, Enter or Add
    // makes the event; its time opens the whole editor (the desktop's double click).
    if Layout.compact && root.draft-day >= 0 && root.draft-day < root.days.length: Rectangle {
        height: 58px;
        background: Tokens.panel;
        drop-shadow-blur: Tokens.shadow-float-blur;
        drop-shadow-color: Tokens.shadow-float;
        Rectangle {
            y: 0;
            height: 1px;
            background: Tokens.border;
        }
        FocusScope {
            width: parent.width;
            height: parent.height;
            enabled: false;
            key-pressed(event) => {
                if (event.text == Key.Escape || event.text == Key.Back) {
                    root.close-draft();
                    return accept;
                }
                return reject;
            }
            HorizontalLayout {
                padding-left: 14px;
                padding-right: 14px;
                spacing: 10px;
                Rectangle {
                    y: (parent.height - self.height) / 2;
                    width: 8px;
                    height: 8px;
                    border-radius: 4px;
                    background: root.quick-color;
                }
                TextField {
                    y: (parent.height - self.height) / 2;
                    height: 40px;
                    horizontal-stretch: 1;
                    bare: true;
                    font-size: 16px;
                    accessible-label: "New event title";
                    placeholder-text: "New event";
                    text <=> root.draft-title;
                    // Opened to be typed in: the first key is the title's.
                    init => { self.focus(); }
                    accepted => { root.save-draft(); }
                }
                Rectangle {
                    y: (parent.height - self.height) / 2;
                    width: duree.preferred-width + 22px;
                    height: 30px;
                    border-radius: 8px;
                    background: editeur.pressed ? Tokens.border-strong : Tokens.surface-active;
                    accessible-role: button;
                    accessible-label: "Open in the editor";
                    accessible-description: duree.text;
                    accessible-action-default => {
                        let jour = root.days[root.draft-day].date;
                        let minute = root.draft-minute;
                        root.close-draft();
                        root.slot-double-clicked(jour, minute);
                    }
                    duree := Text {
                        text: root.hm(root.draft-minute) + " · 1 h";
                        font-size: 13.5px;
                        color: Tokens.text-secondary;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    editeur := TouchArea {
                        clicked => {
                            let jour = root.days[root.draft-day].date;
                            let minute = root.draft-minute;
                            root.close-draft();
                            root.slot-double-clicked(jour, minute);
                        }
                    }
                }
                CalPill {
                    y: (parent.height - self.height) / 2;
                    text: "Add";
                    clicked => { root.save-draft(); }
                }
            }
        }
    }
}

// The calendar workspace.
export component CalendarView inherits Rectangle {
    in property <string> title;
    /// 0 month, 1 week, 2 day.
    in property <int> mode;
    in property <[CalendarData]> calendars;
    in property <string> mini-title;
    in property <[MonthCellData]> mini-cells;
    in property <[MonthCellData]> month-cells;
    in property <[WeekDayData]> week-days;
    in property <[TimedEventData]> week-events;
    in property <[AgendaRowData]> agenda;
    in property <float> now-fraction: -1;
    in property <int> now-day: -1;
    /// Today's tasks without a time, to drag onto the week.
    in property <[PlanTaskData]> to-plan;
    /// What a phone shows besides the period: its title, the week's strip, the
    /// month's chosen day.
    in property <CalendarPhoneData> phone;

    /// On a phone: search, and the calendars' sheet behind "⋯".
    callback search-requested();
    callback calendars-requested();
    /// The week's strip swiped: a week later (1) or earlier (-1).
    callback week-navigate(int);
    /// "Plan my day": each task without an hour gets the first free time.
    callback plan-day();
    /// The Join button of the agenda's next event.
    callback join(string);

    /// A slot open to type in on a phone: the bar keeps only search, the strip and
    /// New event step aside for the field over the keyboard.
    property <bool> drafting;
    changed mode => { root.drafting = false; }
    /// The task of "To plan" touched on a phone, waiting for a time.
    property <int> picked: -1;
    property <string> picked-title;

    /// An event dragged to another time: (key, days later, minutes later).
    callback event-moved(string, int, int);
    /// An event stretched: (key, minutes added to its end).
    callback event-resized(string, int);
    /// An event being stretched, before it is let go: (key, minutes added so far).
    callback event-stretching(string, int);
    /// A task let go on the week: (task, day, minute of the day).
    callback task-planned(int, string, int);

    // The task being carried from "To plan": which (-1: none), and where the pointer
    // is, in window coordinates.
    property <int> carried: -1;
    property <string> carried-title;
    property <int> carried-minutes: 30;
    property <length> carry-x;
    property <length> carry-y;
    property <int> drop;
    /// The task last let go, for the grid's answer to name.
    property <int> dropped: -1;

    callback navigate(int);
    callback today();
    callback mode-chosen(int);
    callback day-chosen(string);
    callback day-opened(string);
    callback mini-navigate(int);
    callback event-opened(string);
    callback new-event(string, int);
    callback quick-event(string, int, string);
    callback draft-closed();
    callback calendar-toggled(int);
    callback calendar-refresh(int);
    callback calendar-remove(CalendarData);
    callback calendar-menu(CalendarData, length, length);

    // A phone opens on the agenda: seven columns do not fit it.
    init => {
        if (Layout.compact && root.mode == 1) {
            root.mode-chosen(4);
        }
    }
    callback calendar-new();
    callback subscribe-requested();
    /// Calendars kept with a server (iCloud, Fastmail, Nextcloud…), both ways.
    callback connect-requested();
    /// An event was clicked here: where it is in the window, just before `event-opened`.
    callback event-anchored(length, length, length);
    /// Right-click on an event: its key, and the pointer in the window.
    callback event-menu(string, length, length);

    background: Tokens.surface;

    HorizontalLayout {
        // --- Left: the window's sidebar: the small month, the calendars, what is
        // left today ---
        // The small month and the calendars beside the grid only where there is room.
        SidebarFrame {
            visible: Layout.width-class == WidthClass.expanded;
            sidebar-width: Layout.width-class == WidthClass.expanded ? 232px : 0px;
            MiniMonth {
                title: root.mini-title;
                cells: root.mini-cells;
                day-chosen(d) => { root.day-chosen(d); }
                navigate(n) => { root.mini-navigate(n); }
            }
            // The section's title, and what adds to it: a calendar of one's own, or
            // one subscribed to by its link.
            SectionRow {
                text: "Calendars";
                IconButton {
                    y: (parent.height - self.height) / 2;
                    icon: Icons.calendar;
                    label: "Connect calendars from a server…";
                    button-size: 20px;
                    icon-size: 13px;
                    clicked => { root.connect-requested(); }
                }
                IconButton {
                    y: (parent.height - self.height) / 2;
                    icon: Icons.link;
                    label: "Subscribe to a calendar…";
                    button-size: 20px;
                    icon-size: 13px;
                    clicked => { root.subscribe-requested(); }
                }
                IconButton {
                    y: (parent.height - self.height) / 2;
                    icon: Icons.plus;
                    label: "New calendar";
                    button-size: 20px;
                    icon-size: 14px;
                    clicked => { root.calendar-new(); }
                }
            }
            for cal in root.calendars: CalendarRow {
                cal: cal;
                toggled(id) => { root.calendar-toggled(id); }
                refresh(id) => { root.calendar-refresh(id); }
                remove(c) => { root.calendar-remove(c); }
                menu(c, x, y) => { root.calendar-menu(c, x, y); }
            }

            // Today's tasks that have no time yet, right under the calendars: dragged
            // onto the week, each books its length there.
            if root.to-plan.length > 0: SectionRow { text: "To plan"; }
            for t in root.to-plan: Rectangle {
                height: Nav.row-height;
                border-radius: Tokens.radius-small;
                background: prise.has-hover || root.carried == t.id ? Tokens.surface-hover : transparent;
                opacity: root.carried == t.id ? 0.5 : 1;

                accessible-role: list-item;
                accessible-label: t.title;
                accessible-description: t.meta + ", drag onto the week to give it a time";
                // Without a mouse: the first free time today.
                accessible-action-default => { root.task-planned(t.id, "", -1); }

                // Pressed and pulled past four pixels, the task is carried; let go over
                // the week, it is booked there.
                property <length> press-x;
                property <length> press-y;

                HorizontalLayout {
                    padding-left: 8px;
                    // Room for the clock button, when it shows.
                    padding-right: prise.has-hover ? 30px : 8px;
                    spacing: 8px;
                    Rectangle {
                        y: (parent.height - self.height) / 2;
                        width: 9px;
                        height: 9px;
                        border-radius: 4.5px;
                        background: Tokens.orange;
                    }
                    Text {
                        text: t.title;
                        font-size: Nav.label-size;
                        color: Tokens.text;
                        vertical-alignment: center;
                        overflow: elide;
                        horizontal-stretch: 1;
                    }
                    Text {
                        text: t.meta;
                        font-size: 12px;
                        color: Tokens.text-muted;
                        vertical-alignment: center;
                    }
                }
                prise := TouchArea {
                    mouse-cursor: root.carried == t.id ? MouseCursor.grabbing : MouseCursor.grab;
                    pointer-event(ev) => {
                        if (ev.button != PointerEventButton.left) {
                            return;
                        }
                        if (ev.kind == PointerEventKind.down) {
                            parent.press-x = self.absolute-position.x + self.mouse-x;
                            parent.press-y = self.absolute-position.y + self.mouse-y;
                        } else if (ev.kind == PointerEventKind.up && root.carried == t.id) {
                            root.dropped = t.id;
                            root.drop += 1;
                            root.carried = -1;
                        }
                    }
                    moved => {
                        if (!self.pressed) {
                            return;
                        }
                        root.carry-x = self.absolute-position.x + self.mouse-x;
                        root.carry-y = self.absolute-position.y + self.mouse-y;
                        if (root.carried != t.id
                            && (abs(root.carry-x - parent.press-x) > 4px
                                || abs(root.carry-y - parent.press-y) > 4px)) {
                            root.carried = t.id;
                            root.carried-title = t.title;
                            root.carried-minutes = t.minutes;
                        }
                    }
                }
                // The same without dragging: the first free time today, one click.
                // Over the row's touch area, so the click is its own; shown when the
                // row is pointed at.
                if prise.has-hover || Layout.touch-input: IconButton {
                    x: parent.width - self.width - 2px;
                    y: (parent.height - self.height) / 2;
                    icon: Icons.clock;
                    label: "Book the first free time";
                    button-size: 26px;
                    icon-size: 14px;
                    clicked => { root.task-planned(t.id, "", -1); }
                }
            }
            Rectangle { vertical-stretch: 1; }
        }

        // --- Right: the period, under the window's toolbar ---
        VerticalLayout {
            // A phone, as the mockups have it: the month as the title (touched, the
            // whole month), today's number to come back, search, the calendars behind
            // "⋯"; the views under it the whole width; the week's strip as the small
            // month, for the agenda and the day. Days go by touching the strip or
            // swiping it, three days by swiping their header, months by swiping the
            // grid.
            if Layout.compact: PhoneCalendarBar {
                vertical-stretch: 0;
                title: root.phone.title;
                chevron: root.mode != 0;
                today: root.phone.today;
                tools: !root.drafting;
                title-tapped => { root.mode-chosen(0); }
                today-tapped => { root.today(); }
                search => { root.search-requested(); }
                more => { root.calendars-requested(); }
            }
            if Layout.compact: HorizontalLayout {
                vertical-stretch: 0;
                padding-left: 16px;
                padding-right: 16px;
                padding-bottom: 8px;
                QueueSegments {
                    names: ["Agenda", "Day", "3 days", "Month"];
                    selected: root.mode == 4 ? 0 : root.mode == 2 ? 1 : root.mode == 0 ? 3 : 2;
                    chosen(i) => { root.mode-chosen(i == 0 ? 4 : i == 1 ? 2 : i == 2 ? 3 : 0); }
                }
            }
            if Layout.compact && !root.drafting && (root.mode == 4 || root.mode == 2): WeekStrip {
                vertical-stretch: 0;
                days: root.phone.strip;
                week-number: root.phone.week-number;
                chosen(d) => { root.day-chosen(d); }
                swiped(n) => { root.week-navigate(n); }
            }
            if Layout.compact && !root.drafting && root.mode == 2 && root.to-plan.length > 0: ToPlanBand {
                vertical-stretch: 0;
                tasks: root.to-plan;
                picked <=> root.picked;
                picked-title <=> root.picked-title;
                plan-all => { root.plan-day(); }
            }
            // The day's grid has a line between the strip and the hours.
            if Layout.compact && !root.drafting && root.mode == 2 && root.to-plan.length == 0: Hairline {}
            if !Layout.compact: WindowToolbar {
                Text {
                    text: root.title;
                    font-family: Tokens.font-display;
                    font-size: 15px;
                    font-weight: 600;
                    color: Tokens.text;
                    vertical-alignment: center;
                    overflow: elide;
                    horizontal-stretch: 1;
                    min-width: 0px;
                }
                // Smallest to largest, as Calendar has it; `mode` counts the other way
                // (0 is the month). A phone has no room for seven columns: the agenda,
                // a day, three days, the month.
                if !Layout.compact: Segmented {
                    y: (parent.height - self.height) / 2;
                    options: ["Day", "Week", "Month"];
                    selected: root.mode >= 3 ? (root.mode == 3 ? 1 : 0) : 2 - root.mode;
                    chosen(i) => { root.mode-chosen(2 - i); }
                }
                Rectangle { horizontal-stretch: 1; }
                IconButton {
                    y: (parent.height - self.height) / 2;
                    icon: Icons.chevron-left;
                    label: "Previous";
                    shortcut: "←";
                    button-size: 28px;
                    clicked => { root.navigate(-1); }
                }
                Button {
                    y: (parent.height - self.height) / 2;
                    text: "Today";
                    shortcut: "T";
                    size: ButtonSize.sm;
                    clicked => { root.today(); }
                }
                IconButton {
                    y: (parent.height - self.height) / 2;
                    icon: Icons.chevron-right;
                    label: "Next";
                    shortcut: "→";
                    button-size: 28px;
                    clicked => { root.navigate(1); }
                }
                Rectangle { width: 6px; }
                Button {
                    y: (parent.height - self.height) / 2;
                    text: "New event";
                    icon: Icons.plus;
                    shortcut: "N";
                    kind: ButtonKind.primary;
                    size: ButtonSize.sm;
                    clicked => { root.new-event("", -1); }
                }
            }

            if root.mode == 0 && !Layout.compact: MonthGrid {
                vertical-stretch: 1;
                cells: root.month-cells;
                day-opened(d) => { root.day-chosen(d); }
                day-double-clicked(d) => { root.new-event(d, 9 * 60); }
                event-anchored(l, r, t) => { root.event-anchored(l, r, t); }
                event-opened(k) => { root.event-opened(k); }
                event-menu(k, x, y) => { root.event-menu(k, x, y); }
            }
            if root.mode == 0 && Layout.compact: PhoneMonth {
                vertical-stretch: 1;
                cells: root.month-cells;
                heading: root.phone.day-heading;
                heading-today: root.phone.day-today;
                rows: root.phone.day-list;
                month-number: root.phone.month-number;
                day-chosen(d) => { root.day-chosen(d); }
                navigate(n) => { root.navigate(n); }
                event-opened(k) => { root.event-opened(k); }
                join(u) => { root.join(u); }
            }

            if root.mode == 4: PhoneAgenda {
                vertical-stretch: 1;
                rows: root.agenda;
                event-opened(k) => { root.event-opened(k); }
                join(u) => { root.join(u); }
            }

            if root.mode != 0 && root.mode != 4: WeekGrid {
                vertical-stretch: 1;
                draft-opened => { root.drafting = true; }
                picked-task: root.picked;
                slot-picked(d, m) => {
                    let tache = root.picked;
                    root.picked = -1;
                    root.task-planned(tache, d, m);
                }
                swiped(n) => { root.navigate(n); }
                period: root.phone.day-number;
                quick-color: root.phone.quick-color;
                event-menu(k, x, y) => { root.event-menu(k, x, y); }
                days: root.week-days;
                events: root.week-events;
                now-fraction: root.now-fraction;
                now-day: root.now-day;
                event-anchored(l, r, t) => { root.event-anchored(l, r, t); }
                event-opened(k) => { root.event-opened(k); }
                slot-double-clicked(d, m) => { root.new-event(d, m); }
                day-opened(d) => { root.day-opened(d); }
                quick-event(d, m, t) => { root.quick-event(d, m, t); }
                draft-closed => {
                    root.drafting = false;
                    root.draft-closed();
                }
                event-moved(k, d, m) => { root.event-moved(k, d, m); }
                event-resized(k, m) => { root.event-resized(k, m); }
                event-stretching(k, m) => { root.event-stretching(k, m); }
                carrying: root.carried >= 0;
                carry-x: root.carry-x;
                carry-y: root.carry-y;
                carry-minutes: root.carried-minutes;
                drop: root.drop;
                task-dropped(d, m) => { root.task-planned(root.dropped, d, m); }
            }
        }
    }

    // New event under the thumb on a phone, where the bar has no room for it: with its
    // words over the agenda, round over a day's grid, none over the month, whose
    // chosen day's list goes to the bottom.
    if Layout.compact && !root.drafting && root.mode == 4: Fab {
        x: parent.width - self.width - 16px;
        y: parent.height - self.height - 16px;
        text: "New event";
        icon: Icons.plus;
        clicked => { root.new-event("", -1); }
    }
    if Layout.compact && !root.drafting && root.mode != 4 && root.mode != 0: RoundFab {
        x: parent.width - self.width - 16px;
        y: parent.height - self.height - 16px;
        label: "New event";
        clicked => { root.new-event("", -1); }
    }

    // The task under the pointer while it is carried.
    if root.carried >= 0: Rectangle {
        x: root.carry-x - root.absolute-position.x + 10px;
        y: root.carry-y - root.absolute-position.y + 8px;
        width: min(220px, fantome.preferred-width + 24px);
        height: 28px;
        border-radius: Tokens.radius-medium;
        background: Tokens.surface;
        border-width: 1px;
        border-color: Tokens.accent;
        drop-shadow-blur: Tokens.shadow-float-blur;
        drop-shadow-offset-y: Tokens.shadow-float-y;
        drop-shadow-color: Tokens.shadow-float;
        fantome := Text {
            x: 12px;
            width: parent.width - 24px;
            text: root.carried-title;
            font-size: 12.5px;
            color: Tokens.text;
            vertical-alignment: center;
            overflow: elide;
        }
    }
}
