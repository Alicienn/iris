import { Tokens } from "@iris/theme/tokens.slint";
import { Icon, Icons, IconButton } from "@iris/base/icons.slint";
import {
    CalendarData, CalendarChipData, MonthCellData, WeekDayData, TimedEventData, PlanTaskData
} from "@iris/types.slint";
import { ScrollView } from "std-widgets.slint";
import { Nav, SectionTitle } from "@iris/lists/nav.slint";
import { Button, ButtonKind, ButtonSize } from "@iris/controls/button.slint";
import { Check, CheckShape, Segmented } from "@iris/controls/choice.slint";
import { TextField } from "@iris/controls/field.slint";
import { Rail } from "@iris/layout/frames.slint";
import { Hairline } from "@iris/base/atoms.slint";

// The panels' buttons, in the words they were written with: the shared `Button`,
// small, its kind read from `primary` and `danger`.
export component CalButton inherits Button {
    in property <bool> primary;
    /// With `primary`: a button that destroys something, in red.
    in property <bool> danger;

    size: ButtonSize.sm;
    kind: root.primary && root.danger ? ButtonKind.danger
        : root.primary ? ButtonKind.primary : ButtonKind.secondary;
}

// One event as a line. All day, a band of its calendar's colour; in a month cell, a
// dot, the hour and the title.
component Chip inherits Rectangle {
    in property <CalendarChipData> chip;
    callback opened(string);
    /// Where it is in the window, for the card that opens beside it.
    callback anchored(length, length, length);
    /// Right-click: its key, and where the pointer is in the window.
    callback menu(string, length, length);

    height: 20px;
    border-radius: 4px;
    background: root.chip.all-day
        ? root.chip.color.transparentize(touch.has-hover ? 0.7 : 0.8)
        : (touch.has-hover ? Tokens.surface-hover : transparent);
    clip: true;

    accessible-role: button;
    accessible-label: root.chip.time == "" ? root.chip.title : root.chip.time + " " + root.chip.title;
    accessible-action-default => { root.opened(root.chip.key); }

    HorizontalLayout {
        padding-left: root.chip.all-day ? 7px : 2px;
        padding-right: 4px;
        spacing: 5px;
        if !root.chip.all-day: Rectangle {
            y: (parent.height - self.height) / 2;
            width: 6px;
            height: 6px;
            border-radius: 3px;
            background: root.chip.color;
        }
        if root.chip.time != "": Text {
            text: root.chip.time;
            font-size: 12px;
            color: Tokens.text-muted;
            vertical-alignment: center;
        }
        Text {
            text: root.chip.title;
            font-size: 12px;
            font-weight: root.chip.all-day ? 500 : 400;
            color: root.chip.all-day ? Tokens.text : Tokens.text-secondary;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.anchored(root.absolute-position.x, root.absolute-position.x + root.width,
                root.absolute-position.y);
            root.opened(root.chip.key);
        }
        pointer-event(ev) => {
            if (ev.button == PointerEventButton.right && ev.kind == PointerEventKind.down) {
                root.menu(root.chip.key,
                    self.absolute-position.x + self.mouse-x,
                    self.absolute-position.y + self.mouse-y);
            }
        }
    }
}

// The small month on the left: a way to jump, not a way to read. The week shown is
// tinted, today is the accent, a day with something in it is bold.
export component MiniMonth inherits VerticalLayout {
    in property <string> title;
    in property <[MonthCellData]> cells;

    callback day-chosen(string);
    callback navigate(int);

    spacing: 1px;

    HorizontalLayout {
        height: 28px;
        padding-left: 6px;
        Text {
            text: root.title;
            font-size: 13px;
            font-weight: 600;
            color: Tokens.text;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
        IconButton {
            y: (parent.height - self.height) / 2;
            icon: Icons.chevron-left;
            label: "Previous month";
            button-size: 26px;
            icon-size: 14px;
            clicked => { root.navigate(-1); }
        }
        IconButton {
            y: (parent.height - self.height) / 2;
            icon: Icons.chevron-right;
            label: "Next month";
            button-size: 26px;
            icon-size: 14px;
            clicked => { root.navigate(1); }
        }
    }

    HorizontalLayout {
        height: 22px;
        for initiale in ["M", "T", "W", "T", "F", "S", "S"]: Text {
            text: initiale;
            font-size: 10.5px;
            color: Tokens.text-muted;
            horizontal-alignment: center;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
    }

    for semaine in 6: HorizontalLayout {
        height: 28px;
        spacing: 1px;
        for colonne in 7: Rectangle {
            property <MonthCellData> cell: root.cells[semaine * 7 + colonne];
            horizontal-stretch: 1;
            border-radius: Tokens.radius-small;
            background: self.cell.today ? Tokens.accent
                : toucher.has-hover || self.cell.in-week ? Tokens.surface-hover
                : self.cell.selected ? Tokens.surface-active
                : transparent;

            accessible-role: button;
            accessible-label: self.cell.date;
            accessible-action-default => { root.day-chosen(self.cell.date); }

            Text {
                text: cell.day;
                font-size: 12px;
                font-weight: cell.today || cell.events.length > 0 ? 600 : 400;
                color: cell.today ? Tokens.accent-text
                    : !cell.in-month ? Tokens.text-faint
                    : cell.events.length > 0 ? Tokens.text
                    : Tokens.text-secondary;
            }
            toucher := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.day-chosen(cell.date); }
            }
        }
    }
}

// A calendar in the list: its colour as a box ticked when it shows, its name, and for
// a subscription how fresh it is.
component CalendarRow inherits Rectangle {
    in property <CalendarData> cal;
    callback toggled(int);
    callback refresh(int);
    callback remove(CalendarData);
    /// A right click, where it happened in the window.
    callback menu(CalendarData, length, length);

    height: Nav.row-height;
    border-radius: Tokens.radius-medium;
    background: Nav.background(false, touch.has-hover);

    accessible-role: checkbox;
    accessible-label: root.cal.name;
    accessible-checked: root.cal.visible;
    accessible-description: root.cal.status;
    accessible-action-default => { root.toggled(root.cal.id); }

    touch := TouchArea {
        clicked => { root.toggled(root.cal.id); }
        pointer-event(event) => {
            if (event.button == PointerEventButton.right && event.kind == PointerEventKind.up) {
                root.menu(root.cal,
                    self.absolute-position.x + self.mouse-x,
                    self.absolute-position.y + self.mouse-y);
            }
        }
    }

    HorizontalLayout {
        padding-left: 9px;
        padding-right: 6px;
        spacing: 9px;

        // The row answers the click; the check is its picture.
        Check {
            y: (parent.height - self.height) / 2;
            shape: CheckShape.square;
            size: 14px;
            tint: root.cal.color;
            done: root.cal.visible;
            interactive: false;
        }

        Text {
            text: root.cal.name;
            font-size: Nav.label-size;
            color: root.cal.visible ? Tokens.text : Tokens.text-muted;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }

        if root.cal.status != "" && !(root.cal.subscribed && touch.has-hover): Text {
            text: root.cal.status;
            font-size: 11.5px;
            color: root.cal.failed ? Tokens.error : Tokens.text-muted;
            vertical-alignment: center;
            overflow: elide;
            max-width: 110px;
        }

        if root.cal.subscribed && touch.has-hover: IconButton {
            y: (parent.height - self.height) / 2;
            icon: Icons.refresh;
            label: "Refresh " + root.cal.name;
            button-size: 24px;
            icon-size: 13px;
            clicked => { root.refresh(root.cal.id); }
        }
        if root.cal.subscribed && touch.has-hover: IconButton {
            y: (parent.height - self.height) / 2;
            icon: Icons.trash;
            label: "Unsubscribe from " + root.cal.name;
            button-size: 24px;
            icon-size: 13px;
            danger: true;
            clicked => { root.remove(root.cal); }
        }
    }
}

// The month: six weeks of seven days, each cell its number and its first events.
component MonthGrid inherits VerticalLayout {
    in property <[MonthCellData]> cells;
    callback day-opened(string);
    callback day-double-clicked(string);
    callback event-opened(string);
    callback event-anchored(length, length, length);
    callback event-menu(string, length, length);

    padding-left: 12px;
    padding-right: 12px;
    padding-bottom: 12px;

    HorizontalLayout {
        height: 32px;
        for nom in ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"]: HorizontalLayout {
            horizontal-stretch: 1;
            preferred-width: 0;
            // Over the day numbers, which sit a few pixels in.
            padding-left: 8px;
            Text {
                text: nom;
                font-size: 12px;
                color: Tokens.text-muted;
                vertical-alignment: center;
            }
        }
    }

    // Every row and every column the same size, whatever is in them: a grid whose
    // lines move with its content is not a grid. A zero preferred size lets the
    // stretch alone decide.
    for semaine in 6: HorizontalLayout {
        vertical-stretch: 1;
        preferred-height: 0;
        min-height: 0;
        for colonne in 7: Rectangle {
            property <MonthCellData> cell: root.cells[semaine * 7 + colonne];
            horizontal-stretch: 1;
            preferred-width: 0;
            min-width: 0;
            clip: true;
            background: case.has-hover || self.cell.selected ? Tokens.surface-hover : transparent;

            // A line over each row, and between the days.
            Rectangle { y: 0; height: 1px; background: Tokens.border; }
            if colonne > 0: Rectangle { x: 0; width: 1px; background: Tokens.border; }

            // Clicks on the cell itself, beneath its events.
            case := TouchArea {
                clicked => { root.day-opened(cell.date); }
                double-clicked => { root.day-double-clicked(cell.date); }
            }

            VerticalLayout {
                padding: 5px;
                spacing: 2px;
                alignment: start;

                HorizontalLayout {
                    height: 22px;
                    Rectangle {
                        // "1 Oct" on the first of a month is wider than a number.
                        width: max(22px, numero.preferred-width + 10px);
                        height: 22px;
                        border-radius: Tokens.radius-small;
                        background: cell.today ? Tokens.accent : transparent;
                        numero := Text {
                            text: cell.day;
                            font-size: 12px;
                            font-weight: cell.today ? 600 : 400;
                            color: cell.today ? Tokens.accent-text
                                : cell.in-month ? Tokens.text-secondary : Tokens.text-faint;
                        }
                    }
                    Rectangle {}
                }

                for chip in cell.events: Chip {
                    chip: chip;
                    opacity: cell.in-month ? 1.0 : 0.55;
                    anchored(l, r, t) => { root.event-anchored(l, r, t); }
                    opened(k) => { root.event-opened(k); }
                    menu(k, x, y) => { root.event-menu(k, x, y); }
                }
                if cell.more > 0: Text {
                    text: "+" + cell.more + " more";
                    font-size: 11px;
                    color: Tokens.text-muted;
                    height: 16px;
                }
            }
        }
    }
}

// The week or the day: a column per day, an hour grid, events placed by time. A click
// on a free slot opens a line there to type the event's title in.
component WeekGrid inherits VerticalLayout {
    in property <[WeekDayData]> days;
    in property <[TimedEventData]> events;
    /// Where "now" is, as a fraction of the day, and in which column. -1: not shown.
    in property <float> now-fraction: -1;
    in property <int> now-day: -1;

    callback event-opened(string);
    callback event-anchored(length, length, length);
    /// Right-click on an event: its key, and the pointer in the window.
    callback event-menu(string, length, length);
    callback slot-double-clicked(string, int);
    callback day-opened(string);
    /// A title typed in a free slot: (day, minute of the day, title).
    callback quick-event(string, int, string);
    /// The typed line was saved or dropped.
    callback draft-closed();
    /// An event dragged elsewhere: (key, days later, minutes later), by quarter hours.
    callback event-moved(string, int, int);
    /// An event stretched by its lower edge: (key, minutes added to its end).
    callback event-resized(string, int);

    property <length> hour: 48px;

    // The event held by the pointer: which (its key), how (1 moved, 2 stretched, 0 not
    // yet: a press becomes a drag past four pixels, so a click still opens it), and how
    // far the pointer went since the press, in window coordinates. Those stay put while
    // the event moves under the pointer; its own would not.
    property <string> drag-key;
    property <int> drag-mode;
    property <bool> drag-stretch;
    property <length> press-x;
    property <length> press-y;
    property <length> drag-dx;
    property <length> drag-dy;
    /// A drag just ended: the click its release makes is not an opening.
    property <bool> dragged;

    /// A distance down the grid, in minutes, to the quarter hour.
    pure function quarters(dy: length) -> int {
        return round(dy / (root.hour / 4)) * 15;
    }

    // The held event, and where it would land: days and minutes later when moved,
    // minutes added to its end when stretched. Never out of the week or the day, never
    // shorter than a quarter hour.
    property <TimedEventData> held;
    property <int> held-begins: round(root.held.top * 1440);
    property <int> held-span: round(root.held.height * 1440);
    property <int> shift-days: root.drag-mode == 1
        ? clamp(round(root.drag-dx / grille.colonne), -root.held.day, root.days.length - 1 - root.held.day)
        : 0;
    property <int> shift-minutes: root.drag-mode == 1
        ? clamp(root.quarters(root.drag-dy), -root.held-begins, 1440 - root.held-begins - root.held-span)
        : 0;
    property <int> stretch: root.drag-mode == 2
        ? clamp(root.quarters(root.drag-dy), 15 - root.held-span, 1440 - root.held-begins - root.held-span)
        : 0;
    property <int> landing-start: root.held-begins + root.shift-minutes;
    property <int> landing-end: root.landing-start + root.held-span + root.stretch;

    /// Stretched by a quarter hour more or less: the week is laid out again with it so,
    /// and the events it reaches make room, while it keeps its share of the column.
    callback event-stretching(string, int);
    /// The stretch last reported, so each quarter hour is said once.
    property <int> stretch-sent;

    // A task carried from the side column, in window coordinates, and how long the
    // block it books. `drop` goes up by one when it is let go.
    in property <bool> carrying;
    in property <length> carry-x;
    in property <length> carry-y;
    in property <int> carry-minutes: 30;
    in property <int> drop;
    /// A task let go on the grid: (day, minute of the day).
    callback task-dropped(string, int);

    /// Where the carried task would land: its column (-1: not over the grid) and its
    /// minute, by quarter hours, its top at the pointer's quarter.
    property <bool> over-grid: root.carry-x >= defil.absolute-position.x + root.gutter
        && root.carry-x < defil.absolute-position.x + defil.width
        && root.carry-y >= defil.absolute-position.y
        && root.carry-y < defil.absolute-position.y + defil.height;
    // The grid's top left on screen, its scroll counted (`absolute-position` inside the
    // scrolled grid does not count it).
    property <length> grid-x: defil.absolute-position.x + defil.viewport-x;
    property <length> grid-y: defil.absolute-position.y + defil.viewport-y;
    property <int> carry-day: root.over-grid
        ? floor((root.carry-x - root.grid-x - root.gutter) / grille.colonne)
        : -1;
    property <int> carry-minute: clamp(
        floor((root.carry-y - root.grid-y) / (root.hour / 4)) * 15,
        0, 1440 - root.carry-minutes);

    changed drop => {
        if (root.carry-day >= 0 && root.carry-day < root.days.length) {
            root.task-dropped(root.days[root.carry-day].date, root.carry-minute);
        }
    }
    property <length> gutter: 58px;
    // Now, as the clock says it: "16:20".
    property <int> minutes: floor(root.now-fraction * 1440);
    property <string> now-label: root.hm(self.minutes);

    /// The slot being typed into: its column (-1: none) and its minute.
    property <int> draft-day: -1;
    property <int> draft-minute;

    pure function hm(m: int) -> string {
        return (floor(m / 60) < 10 ? "0" : "") + floor(m / 60) + ":"
            + (mod(m, 60) < 10 ? "0" : "") + mod(m, 60);
    }
    function close-draft() {
        if (root.draft-day >= 0) {
            root.draft-day = -1;
            root.draft-closed();
        }
    }

    // Day headers: the name, then the number; today in the accent, the weekend quieter.
    HorizontalLayout {
        height: 40px;
        Rectangle { width: root.gutter; }
        for d in root.days: jour := Rectangle {
            property <bool> repos: d.name == "Sat" || d.name == "Sun";
            horizontal-stretch: 1;
            TouchArea {
                mouse-cursor: pointer;
                clicked => { root.day-opened(d.date); }
            }
            HorizontalLayout {
                padding-left: 10px;
                alignment: start;
                spacing: 6px;
                Text {
                    text: d.name;
                    font-size: 12.5px;
                    font-weight: d.today ? 600 : 400;
                    color: d.today ? Tokens.accent : Tokens.text-muted;
                    vertical-alignment: center;
                }
                // Today's number on a round of the accent: never narrower than it is
                // tall, so "1" is a disc and not a squeezed bar.
                Rectangle {
                    y: (parent.height - self.height) / 2;
                    width: d.today ? max(26px, numero.preferred-width + 14px) : numero.preferred-width;
                    height: 26px;
                    border-radius: 13px;
                    background: d.today ? Tokens.accent : transparent;
                    numero := Text {
                        width: parent.width;
                        height: parent.height;
                        text: d.day;
                        font-size: 16px;
                        font-weight: d.today ? 600 : 500;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        color: d.today ? Tokens.accent-text : jour.repos ? Tokens.text-muted : Tokens.text;
                    }
                }
            }
        }
    }
    Hairline {}

    // All-day events, each day its own short column.
    HorizontalLayout {
        min-height: 28px;
        Text {
            width: root.gutter;
            text: "all day";
            font-size: 11px;
            color: Tokens.text-muted;
            vertical-alignment: center;
            horizontal-alignment: center;
        }
        for d in root.days: VerticalLayout {
            horizontal-stretch: 1;
            padding: 3px;
            spacing: 2px;
            for chip in d.all-day: Chip {
                chip: chip;
                anchored(l, r, t) => { root.event-anchored(l, r, t); }
                opened(k) => { root.event-opened(k); }
                menu(k, x, y) => { root.event-menu(k, x, y); }
            }
        }
    }
    Hairline {}

    defil := ScrollView {
        vertical-stretch: 1;
        viewport-height: root.hour * 24;
        // The mouse carries events; the wheel scrolls.
        mouse-drag-pan-enabled: false;
        // Opens on the working day rather than on midnight.
        init => { self.viewport-y = -root.hour * 7.5; }

        grille := Rectangle {
            width: defil.visible-width;
            height: root.hour * 24;

            property <length> colonne: (self.width - root.gutter) / max(1, root.days.length);

            // The columns: the weekend faintly shaded, a line between the days, and
            // the click that opens a slot to type in (a double click opens the whole
            // editor instead).
            for d[i] in root.days: Rectangle {
                x: root.gutter + i * grille.colonne;
                width: grille.colonne;
                height: grille.height;
                background: d.name == "Sat" || d.name == "Sun"
                    ? Tokens.text.transparentize(0.985) : transparent;
                Rectangle { x: 0; width: 1px; background: Tokens.border; }
                TouchArea {
                    clicked => {
                        if (root.draft-day >= 0) {
                            root.close-draft();
                        } else {
                            root.draft-minute = floor(self.mouse-y / (root.hour / 2)) * 30;
                            root.draft-day = i;
                        }
                    }
                    double-clicked => {
                        root.close-draft();
                        root.slot-double-clicked(d.date, floor(self.mouse-y / root.hour) * 60);
                    }
                }
            }

            // Hours: a line across the days, and its label in the margin.
            for h in 24: Rectangle {
                y: h * root.hour;
                height: 1px;
                Rectangle {
                    x: root.gutter;
                    width: parent.width - root.gutter;
                    height: 1px;
                    background: Tokens.border;
                }
                Text {
                    x: 0;
                    y: -7px;
                    width: root.gutter - 8px;
                    height: 14px;
                    text: h == 0 ? "" : root.hm(h * 60);
                    font-size: 11px;
                    color: Tokens.text-muted;
                    horizontal-alignment: right;
                    // The hour of now takes the place of the one it is near.
                    opacity: root.now-day >= 0 && root.now-fraction >= 0
                        && abs(root.minutes - h * 60) < 15 ? 0 : 1;
                }
            }

            // Events: tinted with their calendar's colour, a line of it around; side
            // by side when they overlap. One of one's own can be dragged to another
            // time or day, or stretched by its lower edge: it stays where it is,
            // faded, while a copy drawn over everything follows the pointer by
            // quarter hours; it lands when let go.
            for e in root.events: evenement := Rectangle {
                // Moved, it fades where it was under the copy that follows the
                // pointer; stretched, it is drawn itself, at its new length.
                property <bool> held: root.drag-mode == 1 && root.drag-key == e.key;

                x: root.gutter + e.day * grille.colonne + e.lane * grille.colonne / max(1, e.lanes) + 2px;
                y: e.top * grille.height + 1px;
                width: grille.colonne / max(1, e.lanes) - 4px;
                height: max(22px, e.height * grille.height - 3px);
                border-radius: Tokens.radius-small;
                border-width: 1px;
                border-color: e.color.transparentize(0.55);
                background: e.color.transparentize(bloc.has-hover ? 0.76 : 0.84);
                opacity: self.held ? 0.35 : e.past ? 0.55 : 1.0;
                clip: true;

                accessible-role: button;
                accessible-label: e.time + " " + e.title;
                // What a mouse can do with it, said; the menu (Edit) does it without one.
                accessible-description: e.movable
                    ? "Drag to move it, its lower edge to change its length; right-click for more"
                    : "Right-click for more";
                accessible-action-default => { root.event-opened(e.key); }

                VerticalLayout {
                    padding-left: 7px;
                    padding-top: 4px;
                    padding-right: 5px;
                    spacing: 1px;
                    alignment: start;
                    Text {
                        text: e.title;
                        font-size: 12px;
                        font-weight: 600;
                        color: Tokens.text;
                        overflow: elide;
                    }
                    if evenement.height > 34px: Text {
                        text: e.time;
                        font-size: 11px;
                        color: Tokens.text-secondary;
                        overflow: elide;
                    }
                }
                bloc := TouchArea {
                    // The lower edge stretches; the rest moves.
                    mouse-cursor: e.movable && self.mouse-y > evenement.height - 6px
                        ? MouseCursor.ns-resize
                        : (evenement.held ? MouseCursor.grabbing : MouseCursor.pointer);
                    pointer-event(ev) => {
                        // Right-click: its menu, at the pointer (placed from the
                        // grid's own position and scroll, as the card is).
                        if (ev.button == PointerEventButton.right
                            && ev.kind == PointerEventKind.down) {
                            root.close-draft();
                            root.event-menu(e.key,
                                defil.absolute-position.x + defil.viewport-x + evenement.x + self.mouse-x,
                                defil.absolute-position.y + defil.viewport-y + evenement.y + self.mouse-y);
                            return;
                        }
                        if (ev.button != PointerEventButton.left) {
                            return;
                        }
                        if (ev.kind == PointerEventKind.down) {
                            root.dragged = false;
                            if (e.movable) {
                                root.held = e;
                                root.drag-key = e.key;
                                root.drag-mode = 0;
                                root.drag-stretch = self.mouse-y > evenement.height - 6px;
                                root.press-x = self.absolute-position.x + self.mouse-x;
                                root.press-y = self.absolute-position.y + self.mouse-y;
                                root.drag-dx = 0;
                                root.drag-dy = 0;
                            }
                        } else if (ev.kind == PointerEventKind.up && root.drag-key == e.key) {
                            if (root.drag-mode == 1
                                && (root.shift-days != 0 || root.shift-minutes != 0)) {
                                root.event-moved(e.key, root.shift-days, root.shift-minutes);
                            } else if (root.drag-mode == 2 && root.stretch != 0) {
                                root.event-resized(e.key, root.stretch);
                            }
                            root.dragged = root.drag-mode != 0;
                            root.drag-mode = 0;
                            root.drag-key = "";
                        }
                    }
                    moved => {
                        if (self.pressed && root.drag-key == e.key) {
                            root.drag-dx = self.absolute-position.x + self.mouse-x - root.press-x;
                            root.drag-dy = self.absolute-position.y + self.mouse-y - root.press-y;
                            if (root.drag-mode == 0
                                && (abs(root.drag-dx) > 4px || abs(root.drag-dy) > 4px)) {
                                root.close-draft();
                                root.drag-mode = root.drag-stretch ? 2 : 1;
                                root.stretch-sent = 0;
                            }
                            if (root.drag-mode == 2 && root.stretch != root.stretch-sent) {
                                root.stretch-sent = root.stretch;
                                root.event-stretching(e.key, root.stretch);
                            }
                        }
                    }
                    clicked => {
                        if (root.dragged) {
                            root.dragged = false;
                            return;
                        }
                        root.close-draft();
                        // Where it is on screen, from the grid's own place and scroll.
                        // `absolute-position` inside the scrolled grid was off, and the
                        // card opened hundreds of pixels away from the event, further
                        // the more the day was scrolled.
                        let gauche = defil.absolute-position.x + defil.viewport-x + evenement.x;
                        root.event-anchored(gauche, gauche + evenement.width,
                            defil.absolute-position.y + defil.viewport-y + evenement.y);
                        root.event-opened(e.key);
                    }
                }
            }

            // The moved event where it would land, over the others, with its new time.
            if root.drag-mode == 1: Rectangle {
                x: root.gutter + (root.held.day + root.shift-days) * grille.colonne + 2px;
                y: root.landing-start / 1440 * grille.height + 1px;
                width: grille.colonne - 4px;
                height: max(22px, (root.landing-end - root.landing-start) / 1440 * grille.height - 3px);
                border-radius: Tokens.radius-small;
                border-width: 1.5px;
                border-color: root.held.color;
                background: Tokens.surface;
                drop-shadow-blur: 10px;
                drop-shadow-offset-y: 3px;
                drop-shadow-color: Tokens.text.transparentize(0.85);
                Rectangle {
                    border-radius: Tokens.radius-small;
                    background: root.held.color.transparentize(0.72);
                }
                VerticalLayout {
                    padding-left: 7px;
                    padding-top: 4px;
                    padding-right: 5px;
                    spacing: 1px;
                    alignment: start;
                    Text {
                        text: root.held.title;
                        font-size: 12px;
                        font-weight: 600;
                        color: Tokens.text;
                        overflow: elide;
                    }
                    Text {
                        text: root.hm(root.landing-start) + " – " + root.hm(min(1439, root.landing-end));
                        font-size: 11px;
                        font-weight: 600;
                        color: Tokens.text-secondary;
                        overflow: elide;
                    }
                }
            }

            // Where a carried task would be booked: its length, dashed in the accent.
            if root.carrying && root.carry-day >= 0 && root.carry-day < root.days.length: Rectangle {
                x: root.gutter + root.carry-day * grille.colonne + 2px;
                y: root.carry-minute / 1440 * grille.height + 1px;
                width: grille.colonne - 4px;
                height: max(20px, root.carry-minutes / 1440 * grille.height - 3px);
                border-radius: Tokens.radius-small;
                border-width: 1.5px;
                border-color: Tokens.accent;
                background: Tokens.accent-soft;
                Text {
                    x: 7px;
                    y: 4px;
                    text: root.hm(root.carry-minute) + " – "
                        + root.hm(min(1439, root.carry-minute + root.carry-minutes));
                    font-size: 11px;
                    font-weight: 600;
                    color: Tokens.accent;
                }
            }

            // The slot being typed into: an hour, outlined in the accent. Enter saves,
            // Escape drops it.
            if root.draft-day >= 0 && root.draft-day < root.days.length: brouillon := Rectangle {
                x: root.gutter + root.draft-day * grille.colonne + 2px;
                y: root.draft-minute / 1440 * grille.height + 1px;
                width: grille.colonne - 4px;
                height: root.hour - 3px;
                border-radius: Tokens.radius-small;
                border-width: 1.5px;
                border-color: Tokens.accent;
                background: Tokens.accent-soft;

                // Swallows the click, so typing does not reach the column behind.
                TouchArea {}

                FocusScope {
                    enabled: false;
                    key-pressed(event) => {
                        if (event.text == Key.Escape) {
                            root.close-draft();
                            return accept;
                        }
                        return reject;
                    }

                    VerticalLayout {
                        padding-left: 2px;
                        padding-right: 4px;
                        padding-top: 1px;
                        spacing: 0px;
                        alignment: start;
                        TextField {
                            bare: true;
                            height: 24px;
                            accessible-label: "New event title";
                            placeholder-text: "New event";
                            font-size: 12px;
                            // Opened to be typed in: the first key is the title's.
                            init => { self.focus(); }
                            accepted(t) => {
                                let jour = root.days[root.draft-day].date;
                                let minute = root.draft-minute;
                                root.close-draft();
                                if (t != "") {
                                    root.quick-event(jour, minute, t);
                                }
                            }
                        }
                        Text {
                            text: "  " + root.hm(root.draft-minute) + " – "
                                + root.hm(min(1439, root.draft-minute + 60)) + " · Enter to save";
                            font-size: 11px;
                            color: Tokens.text-secondary;
                            overflow: elide;
                        }
                    }
                }
            }

            // Now: its hour in the margin, and a line across today's column.
            if root.now-day >= 0 && root.now-fraction >= 0: Text {
                x: 0;
                y: root.now-fraction * grille.height - 7px;
                width: root.gutter - 8px;
                text: root.now-label;
                font-size: 11px;
                font-weight: 600;
                color: Tokens.error;
                horizontal-alignment: right;
            }
            if root.now-day >= 0 && root.now-fraction >= 0: Rectangle {
                x: root.gutter + root.now-day * grille.colonne - 4px;
                y: root.now-fraction * grille.height - 4px;
                width: grille.colonne + 4px;
                height: 8px;
                Rectangle {
                    x: 0;
                    width: 8px;
                    height: 8px;
                    border-radius: 4px;
                    background: Tokens.error;
                }
                Rectangle {
                    x: 4px;
                    y: 3px;
                    height: 2px;
                    background: Tokens.error;
                }
            }
        }
    }
}

// The calendar workspace.
export component CalendarView inherits Rectangle {
    in property <string> title;
    /// 0 month, 1 week, 2 day.
    in property <int> mode;
    in property <[CalendarData]> calendars;
    in property <string> mini-title;
    in property <[MonthCellData]> mini-cells;
    in property <[MonthCellData]> month-cells;
    in property <[WeekDayData]> week-days;
    in property <[TimedEventData]> week-events;
    in property <float> now-fraction: -1;
    in property <int> now-day: -1;
    /// Today's tasks without a time, to drag onto the week.
    in property <[PlanTaskData]> to-plan;

    /// An event dragged to another time: (key, days later, minutes later).
    callback event-moved(string, int, int);
    /// An event stretched: (key, minutes added to its end).
    callback event-resized(string, int);
    /// An event being stretched, before it is let go: (key, minutes added so far).
    callback event-stretching(string, int);
    /// A task let go on the week: (task, day, minute of the day).
    callback task-planned(int, string, int);

    // The task being carried from "To plan": which (-1: none), and where the pointer
    // is, in window coordinates.
    property <int> carried: -1;
    property <string> carried-title;
    property <int> carried-minutes: 30;
    property <length> carry-x;
    property <length> carry-y;
    property <int> drop;
    /// The task last let go, for the grid's answer to name.
    property <int> dropped: -1;

    callback navigate(int);
    callback today();
    callback mode-chosen(int);
    callback day-chosen(string);
    callback day-opened(string);
    callback mini-navigate(int);
    callback event-opened(string);
    callback new-event(string, int);
    callback quick-event(string, int, string);
    callback draft-closed();
    callback calendar-toggled(int);
    callback calendar-refresh(int);
    callback calendar-remove(CalendarData);
    callback calendar-menu(CalendarData, length, length);
    callback calendar-new();
    callback subscribe-requested();
    /// An event was clicked here: where it is in the window, just before `event-opened`.
    callback event-anchored(length, length, length);
    /// Right-click on an event: its key, and the pointer in the window.
    callback event-menu(string, length, length);

    background: Tokens.surface;

    HorizontalLayout {
        // --- Left: create, jump, choose what shows, what is left today ---
        Rail {
            rail-width: 252px;

            // Outlined: the accent is kept for what is chosen (today, the week).
            Button {
                // The rail's width, less its padding.
                width: 228px;
                height: 34px;
                text: "New event";
                icon: Icons.plus;
                shortcut: "N";
                kind: ButtonKind.secondary;
                clicked => { root.new-event("", -1); }
            }
            Rectangle { height: 14px; }

            MiniMonth {
                title: root.mini-title;
                cells: root.mini-cells;
                day-chosen(d) => { root.day-chosen(d); }
                navigate(n) => { root.mini-navigate(n); }
            }
            Rectangle { height: 12px; }

            // The section's title, with the + that adds to it.
            HorizontalLayout {
                height: 26px;
                padding-left: 9px;
                padding-right: 2px;
                SectionTitle {
                    text: "Calendars";
                    horizontal-stretch: 1;
                }
                IconButton {
                    y: (parent.height - self.height) / 2;
                    icon: Icons.plus;
                    label: "New calendar";
                    button-size: 26px;
                    icon-size: 15px;
                    clicked => { root.calendar-new(); }
                }
            }
            for cal in root.calendars: CalendarRow {
                cal: cal;
                toggled(id) => { root.calendar-toggled(id); }
                refresh(id) => { root.calendar-refresh(id); }
                remove(c) => { root.calendar-remove(c); }
                menu(c, x, y) => { root.calendar-menu(c, x, y); }
            }
            Rectangle { height: 4px; }
            HorizontalLayout {
                alignment: start;
                Button {
                    text: "Subscribe to a calendar";
                    label: "Subscribe to a calendar…";
                    icon: Icons.plus;
                    kind: ButtonKind.ghost;
                    size: ButtonSize.sm;
                    clicked => { root.subscribe-requested(); }
                }
            }

            Rectangle { vertical-stretch: 1; }

            // Today's tasks that have no time yet: dragged onto the week, each books
            // its length there.
            if root.to-plan.length > 0: Hairline {}
            if root.to-plan.length > 0: Rectangle { height: 8px; }
            if root.to-plan.length > 0: HorizontalLayout {
                height: 24px;
                padding-left: 2px;
                SectionTitle { text: "To plan"; }
                Text {
                    text: root.mode == 0 ? "" : "drag onto the week";
                    font-size: 11.5px;
                    color: Tokens.text-muted;
                    horizontal-alignment: right;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
            }
            for t in root.to-plan: Rectangle {
                height: 34px;
                border-radius: Tokens.radius-medium;
                background: prise.has-hover || root.carried == t.id ? Tokens.surface-hover : transparent;
                opacity: root.carried == t.id ? 0.5 : 1;

                accessible-role: list-item;
                accessible-label: t.title;
                accessible-description: t.meta + ", drag onto the week to give it a time";
                // Without a mouse: the first free time today.
                accessible-action-default => { root.task-planned(t.id, "", -1); }

                // Pressed and pulled past four pixels, the task is carried; let go over
                // the week, it is booked there.
                property <length> press-x;
                property <length> press-y;

                HorizontalLayout {
                    padding-left: 4px;
                    // Room for the clock button at the end.
                    padding-right: 32px;
                    spacing: 9px;
                    Rectangle {
                        y: (parent.height - self.height) / 2;
                        width: 12px;
                        height: 12px;
                        border-radius: 6px;
                        border-width: 1.5px;
                        border-color: t.color;
                    }
                    Text {
                        text: t.title;
                        font-size: 12.5px;
                        color: Tokens.text;
                        vertical-alignment: center;
                        overflow: elide;
                        horizontal-stretch: 1;
                    }
                    Text {
                        text: t.meta;
                        font-size: 11.5px;
                        color: Tokens.text-muted;
                        vertical-alignment: center;
                    }
                }
                prise := TouchArea {
                    mouse-cursor: root.carried == t.id ? MouseCursor.grabbing : MouseCursor.grab;
                    pointer-event(ev) => {
                        if (ev.button != PointerEventButton.left) {
                            return;
                        }
                        if (ev.kind == PointerEventKind.down) {
                            parent.press-x = self.absolute-position.x + self.mouse-x;
                            parent.press-y = self.absolute-position.y + self.mouse-y;
                        } else if (ev.kind == PointerEventKind.up && root.carried == t.id) {
                            root.dropped = t.id;
                            root.drop += 1;
                            root.carried = -1;
                        }
                    }
                    moved => {
                        if (!self.pressed) {
                            return;
                        }
                        root.carry-x = self.absolute-position.x + self.mouse-x;
                        root.carry-y = self.absolute-position.y + self.mouse-y;
                        if (root.carried != t.id
                            && (abs(root.carry-x - parent.press-x) > 4px
                                || abs(root.carry-y - parent.press-y) > 4px)) {
                            root.carried = t.id;
                            root.carried-title = t.title;
                            root.carried-minutes = t.minutes;
                        }
                    }
                }
                // The same without dragging: the first free time today, one click.
                // Over the row's touch area, so the click is its own.
                IconButton {
                    x: parent.width - self.width - 2px;
                    y: (parent.height - self.height) / 2;
                    icon: Icons.clock;
                    label: "Book the first free time";
                    button-size: 26px;
                    icon-size: 14px;
                    clicked => { root.task-planned(t.id, "", -1); }
                }
            }
        }

        // --- Right: the period ---
        VerticalLayout {
            HorizontalLayout {
                height: 56px;
                padding-left: 16px;
                padding-right: 16px;
                spacing: 8px;

                Text {
                    text: root.title;
                    font-family: Tokens.font-display;
                    font-size: 18px;
                    font-weight: 600;
                    color: Tokens.text;
                    vertical-alignment: center;
                    overflow: elide;
                    horizontal-stretch: 1;
                }
                Button {
                    y: (parent.height - self.height) / 2;
                    text: "Today";
                    shortcut: "T";
                    size: ButtonSize.sm;
                    clicked => { root.today(); }
                }
                IconButton {
                    y: (parent.height - self.height) / 2;
                    icon: Icons.chevron-left;
                    label: "Previous";
                    shortcut: "←";
                    button-size: 30px;
                    clicked => { root.navigate(-1); }
                }
                IconButton {
                    y: (parent.height - self.height) / 2;
                    icon: Icons.chevron-right;
                    label: "Next";
                    shortcut: "→";
                    button-size: 30px;
                    clicked => { root.navigate(1); }
                }
                Rectangle { width: 4px; }
                // Smallest to largest, as the web edition has it; `mode` counts the
                // other way (0 is the month).
                Segmented {
                    y: (parent.height - self.height) / 2;
                    options: ["Day", "Week", "Month"];
                    selected: 2 - root.mode;
                    chosen(i) => { root.mode-chosen(2 - i); }
                }
            }
            Hairline {}

            if root.mode == 0: MonthGrid {
                vertical-stretch: 1;
                cells: root.month-cells;
                day-opened(d) => { root.day-chosen(d); }
                day-double-clicked(d) => { root.new-event(d, 9 * 60); }
                event-anchored(l, r, t) => { root.event-anchored(l, r, t); }
                event-opened(k) => { root.event-opened(k); }
                event-menu(k, x, y) => { root.event-menu(k, x, y); }
            }

            if root.mode != 0: WeekGrid {
                vertical-stretch: 1;
                event-menu(k, x, y) => { root.event-menu(k, x, y); }
                days: root.week-days;
                events: root.week-events;
                now-fraction: root.now-fraction;
                now-day: root.now-day;
                event-anchored(l, r, t) => { root.event-anchored(l, r, t); }
                event-opened(k) => { root.event-opened(k); }
                slot-double-clicked(d, m) => { root.new-event(d, m); }
                day-opened(d) => { root.day-opened(d); }
                quick-event(d, m, t) => { root.quick-event(d, m, t); }
                draft-closed => { root.draft-closed(); }
                event-moved(k, d, m) => { root.event-moved(k, d, m); }
                event-resized(k, m) => { root.event-resized(k, m); }
                event-stretching(k, m) => { root.event-stretching(k, m); }
                carrying: root.carried >= 0;
                carry-x: root.carry-x;
                carry-y: root.carry-y;
                carry-minutes: root.carried-minutes;
                drop: root.drop;
                task-dropped(d, m) => { root.task-planned(root.dropped, d, m); }
            }
        }
    }

    // The task under the pointer while it is carried.
    if root.carried >= 0: Rectangle {
        x: root.carry-x - root.absolute-position.x + 10px;
        y: root.carry-y - root.absolute-position.y + 8px;
        width: min(220px, fantome.preferred-width + 24px);
        height: 28px;
        border-radius: Tokens.radius-medium;
        background: Tokens.surface;
        border-width: 1px;
        border-color: Tokens.accent;
        drop-shadow-blur: 12px;
        drop-shadow-offset-y: 4px;
        drop-shadow-color: Tokens.text.transparentize(0.82);
        fantome := Text {
            x: 12px;
            width: parent.width - 24px;
            text: root.carried-title;
            font-size: 12.5px;
            color: Tokens.text;
            vertical-alignment: center;
            overflow: elide;
        }
    }
}
