import { Tokens } from "@iris/theme/tokens.slint";
import { Glass } from "@iris/base/glass.slint";
import { Icon, Icons, IconButton } from "@iris/base/icons.slint";
import {
    CalendarData, CalendarChipData, MonthCellData, WeekDayData, TimedEventData
} from "@iris/types.slint";
import { ScrollView } from "std-widgets.slint";
import { Nav, SectionTitle } from "@iris/lists/nav.slint";
import { Button, ButtonKind, ButtonSize } from "@iris/controls/button.slint";
import { Check, CheckShape, Segmented } from "@iris/controls/choice.slint";
import { Rail } from "@iris/layout/frames.slint";

// A button with words on it, for the calendar's toolbar and panels.
export component CalButton inherits Rectangle {
    in property <string> text;
    in property <string> icon;
    in property <bool> primary;
    in property <bool> selected;
    in property <bool> enabled: true;
    /// With `primary`: a button that destroys something, in red.
    in property <bool> danger;

    callback clicked();

    height: 28px;
    width: rang.preferred-width + 20px;
    border-radius: Tokens.radius-small;
    border-width: root.primary ? 0px : 1px;
    border-color: Tokens.border;
    background: root.primary && root.danger
        ? (touch.pressed ? Tokens.error.darker(0.2) : Tokens.error)
        : root.primary
        ? (touch.pressed ? Tokens.accent.darker(0.15) : Tokens.accent)
        : root.selected
            ? Tokens.surface-active
            : (touch.pressed ? Tokens.surface-active : touch.has-hover ? Tokens.surface-hover : transparent);
    opacity: root.enabled ? 1.0 : 0.5;
    animate background { duration: Tokens.instant; }

    accessible-role: button;
    accessible-label: root.text;
    accessible-enabled: root.enabled;
    accessible-action-default => { root.clicked(); }

    rang := HorizontalLayout {
        x: 10px;
        spacing: 6px;
        if root.icon != "": Icon {
            y: (parent.height - self.height) / 2;
            data: root.icon;
            size: 13px;
            tint: root.primary && root.danger ? white
                : root.primary ? Tokens.accent-text : Tokens.text-secondary;
        }
        Text {
            text: root.text;
            font-size: Tokens.size-small;
            font-weight: root.primary || root.selected ? Tokens.weight-bold : Tokens.weight-body;
            color: root.primary && root.danger ? white
                : root.primary ? Tokens.accent-text : Tokens.text-secondary;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

// One event as a line: a bar of its calendar's colour, the time, the title.
component Chip inherits Rectangle {
    in property <CalendarChipData> chip;
    callback opened(string);
    /// Where it is in the window, for the card that opens beside it.
    callback anchored(length, length, length);

    height: 18px;
    border-radius: 3px;
    background: root.chip.all-day
        ? root.chip.color.transparentize(touch.has-hover ? 0.55 : 0.7)
        : (touch.has-hover ? Tokens.surface-hover : transparent);
    clip: true;

    accessible-role: button;
    accessible-label: root.chip.time == "" ? root.chip.title : root.chip.time + " " + root.chip.title;
    accessible-action-default => { root.opened(root.chip.key); }

    HorizontalLayout {
        padding-left: 4px;
        padding-right: 4px;
        spacing: 4px;
        if !root.chip.all-day: Rectangle {
            y: (parent.height - self.height) / 2;
            width: 6px;
            height: 6px;
            border-radius: 3px;
            background: root.chip.color;
        }
        if root.chip.time != "": Text {
            text: root.chip.time;
            font-size: 10px;
            color: Tokens.text-muted;
            vertical-alignment: center;
        }
        Text {
            text: root.chip.title;
            font-size: 11px;
            color: Tokens.text;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.anchored(root.absolute-position.x, root.absolute-position.x + root.width,
                root.absolute-position.y);
            root.opened(root.chip.key);
        }
    }
}

// The small month on the left: a way to jump, not a way to read.
export component MiniMonth inherits VerticalLayout {
    in property <string> title;
    in property <[MonthCellData]> cells;

    callback day-chosen(string);
    callback navigate(int);

    spacing: 2px;

    HorizontalLayout {
        height: 26px;
        padding-left: 4px;
        Text {
            text: root.title;
            font-size: 13px;
            font-weight: 600;
            color: Tokens.text;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
        IconButton {
            icon: Icons.chevron-left;
            label: "Previous month";
            button-size: 22px;
            icon-size: 12px;
            clicked => { root.navigate(-1); }
        }
        IconButton {
            icon: Icons.chevron-right;
            label: "Next month";
            button-size: 22px;
            icon-size: 12px;
            clicked => { root.navigate(1); }
        }
    }

    HorizontalLayout {
        height: 18px;
        for initiale in ["M", "T", "W", "T", "F", "S", "S"]: Text {
            text: initiale;
            font-size: 10px;
            color: Tokens.text-muted;
            horizontal-alignment: center;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
    }

    for semaine in 6: HorizontalLayout {
        height: 24px;
        for colonne in 7: Rectangle {
            property <MonthCellData> cell: root.cells[semaine * 7 + colonne];
            horizontal-stretch: 1;

            accessible-role: button;
            accessible-label: self.cell.date;
            accessible-action-default => { root.day-chosen(self.cell.date); }

            // Today in a red disc, as a paper calendar circles it.
            Rectangle {
                width: 22px;
                height: 22px;
                border-radius: 11px;
                background: cell.today
                    ? Tokens.error
                    : cell.selected
                        ? Tokens.surface-active
                        : (toucher.has-hover ? Tokens.surface-hover : transparent);
            }
            Text {
                text: cell.day;
                font-size: 11px;
                font-weight: cell.today ? 600 : 400;
                color: cell.today
                    ? white
                    : (cell.in-month ? Tokens.text-secondary : Tokens.text-muted.transparentize(0.4));
            }
            // A dot under a day that has something in it.
            if cell.events.length > 0 && !cell.today: Rectangle {
                y: parent.height - 4px;
                width: 3px;
                height: 3px;
                border-radius: 1.5px;
                background: Tokens.text-muted;
            }
            toucher := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.day-chosen(cell.date); }
            }
        }
    }
}

// A calendar in the list: its colour, its name, whether it shows, and for a
// subscription how fresh it is.
component CalendarRow inherits Rectangle {
    in property <CalendarData> cal;
    callback toggled(int);
    callback refresh(int);
    callback remove(CalendarData);
    /// A right click, where it happened in the window.
    callback menu(CalendarData, length, length);

    height: root.cal.status != "" ? 42px : Nav.row-height;
    border-radius: Tokens.radius-small;
    background: Nav.background(false, touch.has-hover);

    accessible-role: checkbox;
    accessible-label: root.cal.name;
    accessible-checked: root.cal.visible;
    accessible-action-default => { root.toggled(root.cal.id); }

    touch := TouchArea {
        clicked => { root.toggled(root.cal.id); }
        pointer-event(event) => {
            if (event.button == PointerEventButton.right && event.kind == PointerEventKind.up) {
                root.menu(root.cal,
                    self.absolute-position.x + self.mouse-x,
                    self.absolute-position.y + self.mouse-y);
            }
        }
    }

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 2px;
        spacing: 10px;

        // The row answers the click; the check is its picture.
        Check {
            y: (parent.height - self.height) / 2;
            shape: CheckShape.square;
            size: 14px;
            tint: root.cal.color;
            done: root.cal.visible;
            interactive: false;
        }

        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            Text {
                text: root.cal.name;
                font-size: Nav.label-size;
                color: root.cal.visible ? Tokens.text : Tokens.text-muted;
                overflow: elide;
            }
            if root.cal.status != "": Text {
                text: root.cal.status;
                font-size: 11px;
                color: root.cal.failed ? Tokens.error : Tokens.text-muted;
                overflow: elide;
            }
        }

        if root.cal.subscribed && touch.has-hover: IconButton {
            y: (parent.height - self.height) / 2;
            icon: Icons.refresh;
            label: "Refresh " + root.cal.name;
            button-size: 22px;
            icon-size: 12px;
            clicked => { root.refresh(root.cal.id); }
        }
        if root.cal.subscribed && touch.has-hover: IconButton {
            y: (parent.height - self.height) / 2;
            icon: Icons.trash;
            label: "Unsubscribe from " + root.cal.name;
            button-size: 22px;
            icon-size: 12px;
            danger: true;
            clicked => { root.remove(root.cal); }
        }
    }
}

// The month: six weeks of seven days.
component MonthGrid inherits VerticalLayout {
    in property <[MonthCellData]> cells;
    callback day-opened(string);
    callback day-double-clicked(string);
    callback event-opened(string);
    callback event-anchored(length, length, length);

    HorizontalLayout {
        height: 28px;
        for nom[i] in ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"]: Text {
            text: nom;
            font-size: 12px;
            color: i >= 5 ? Tokens.text-muted.transparentize(0.3) : Tokens.text-muted;
            horizontal-alignment: center;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
    }
    Rectangle { height: 1px; background: Tokens.border; }

    // Every row and every column the same size, whatever is in them: a grid whose
    // lines move with its content is not a grid. A zero preferred size lets the
    // stretch alone decide.
    for semaine in 6: HorizontalLayout {
        vertical-stretch: 1;
        preferred-height: 0;
        min-height: 0;
        for colonne in 7: Rectangle {
            property <MonthCellData> cell: root.cells[semaine * 7 + colonne];
            horizontal-stretch: 1;
            preferred-width: 0;
            min-width: 0;
            clip: true;
            // The days of the months before and after sit in the shade, so the month
            // reads as one block.
            background: self.cell.selected ? Tokens.surface-hover
                : self.cell.in-month ? transparent
                // The theme's text colour, faintly: a shade in a dark theme and in a
                // light one alike.
                : Tokens.text.transparentize(0.955);

            // Grid lines: right and bottom of every cell.
            Rectangle { x: parent.width - 1px; width: 1px; background: Tokens.border.transparentize(0.4); }
            Rectangle { y: parent.height - 1px; height: 1px; background: Tokens.border.transparentize(0.4); }

            // Clicks on the cell itself, beneath its events.
            TouchArea {
                clicked => { root.day-opened(cell.date); }
                double-clicked => { root.day-double-clicked(cell.date); }
            }

            VerticalLayout {
                padding: 4px;
                spacing: 1px;
                alignment: start;

                HorizontalLayout {
                    height: 20px;
                    Rectangle {
                        // "1 Oct" on the first of a month is wider than a number.
                        width: max(20px, numero.preferred-width + 10px);
                        height: 20px;
                        border-radius: 10px;
                        background: cell.today ? Tokens.error : transparent;
                        numero := Text {
                            text: cell.day;
                            font-size: 12px;
                            font-weight: cell.today ? 600 : 400;
                            color: cell.today
                                ? white
                                : (cell.in-month ? Tokens.text-secondary : Tokens.text-muted.transparentize(0.4));
                        }
                    }
                    Rectangle {}
                }

                for chip in cell.events: Chip {
                    chip: chip;
                    opacity: cell.in-month ? 1.0 : 0.55;
                    anchored(l, r, t) => { root.event-anchored(l, r, t); }
                    opened(k) => { root.event-opened(k); }
                }
                if cell.more > 0: Text {
                    text: "+" + cell.more + " more";
                    font-size: 10px;
                    color: Tokens.text-muted;
                    height: 16px;
                }
            }
        }
    }
}

// The week or the day: a column per day, an hour grid, events placed by time.
component WeekGrid inherits VerticalLayout {
    in property <[WeekDayData]> days;
    in property <[TimedEventData]> events;
    /// Where "now" is, as a fraction of the day, and in which column. -1: not shown.
    in property <float> now-fraction: -1;
    in property <int> now-day: -1;

    callback event-opened(string);
    callback event-anchored(length, length, length);
    callback slot-double-clicked(string, int);
    callback day-opened(string);

    property <length> hour: 44px;
    property <length> gutter: 52px;
    // Now, as the clock says it: "16:20".
    property <int> minutes: floor(root.now-fraction * 1440);
    property <string> now-label: (floor(self.minutes / 60) < 10 ? "0" : "")
        + floor(self.minutes / 60) + ":" + (mod(self.minutes, 60) < 10 ? "0" : "")
        + mod(self.minutes, 60);

    // Day headers: the name small, the number large; today in a red disc, the
    // weekend quieter.
    HorizontalLayout {
        height: 52px;
        Rectangle { width: root.gutter; }
        for d in root.days: jour := Rectangle {
            property <bool> repos: d.name == "Sat" || d.name == "Sun";
            horizontal-stretch: 1;
            TouchArea {
                mouse-cursor: pointer;
                clicked => { root.day-opened(d.date); }
            }
            HorizontalLayout {
                alignment: center;
                spacing: 8px;
                Text {
                    text: d.name;
                    font-size: 12px;
                    font-weight: d.today ? 600 : 400;
                    color: d.today ? Tokens.error : jour.repos ? Tokens.text-muted : Tokens.text-secondary;
                    vertical-alignment: center;
                }
                Rectangle {
                    y: (parent.height - self.height) / 2;
                    width: max(32px, numero.preferred-width + 12px);
                    height: 32px;
                    border-radius: 16px;
                    background: d.today ? Tokens.error : transparent;
                    numero := Text {
                        text: d.day;
                        font-family: Tokens.font-display;
                        font-size: 20px;
                        font-weight: d.today ? 600 : 400;
                        color: d.today ? white : jour.repos ? Tokens.text-muted : Tokens.text;
                    }
                }
            }
        }
    }
    Rectangle { height: 1px; background: Tokens.border; }

    // All-day events, each day its own short column.
    HorizontalLayout {
        min-height: 26px;
        Text {
            width: root.gutter;
            text: "all day";
            font-size: 10px;
            color: Tokens.text-muted;
            vertical-alignment: center;
            horizontal-alignment: center;
        }
        for d in root.days: VerticalLayout {
            horizontal-stretch: 1;
            padding: 2px;
            spacing: 2px;
            for chip in d.all-day: Chip {
                chip: chip;
                anchored(l, r, t) => { root.event-anchored(l, r, t); }
                opened(k) => { root.event-opened(k); }
            }
        }
    }
    Rectangle { height: 1px; background: Tokens.border; }

    defil := ScrollView {
        vertical-stretch: 1;
        viewport-height: root.hour * 24;
        // Opens on the working day rather than on midnight.
        init => { self.viewport-y = -root.hour * 7.5; }

        grille := Rectangle {
            width: defil.visible-width;
            height: root.hour * 24;

            property <length> colonne: (self.width - root.gutter) / max(1, root.days.length);

            // Hours: a label and a line every hour.
            for h in 24: Rectangle {
                y: h * root.hour;
                height: root.hour;
                Text {
                    x: 0;
                    y: -7px;
                    width: root.gutter - 10px;
                    text: h == 0 ? "" : (h < 10 ? "0" : "") + h + ":00";
                    font-size: 11px;
                    color: Tokens.text-muted;
                    horizontal-alignment: right;
                    // The hour of now takes the place of the one it is near.
                    opacity: root.now-day >= 0 && root.now-fraction >= 0
                        && abs(root.minutes - h * 60) < 15 ? 0 : 1;
                }
                Rectangle {
                    x: root.gutter;
                    y: 0;
                    width: parent.width - root.gutter;
                    height: 1px;
                    background: Tokens.border.transparentize(0.4);
                }
            }

            // Day separators, and the double-click that creates an event at that hour.
            for d[i] in root.days: Rectangle {
                x: root.gutter + i * grille.colonne;
                width: grille.colonne;
                height: grille.height;
                Rectangle { x: 0; width: 1px; background: Tokens.border.transparentize(0.4); }
                TouchArea {
                    double-clicked => {
                        root.slot-double-clicked(d.date, floor(self.mouse-y / root.hour) * 60);
                    }
                }
            }

            for e in root.events: evenement := Rectangle {
                x: root.gutter + e.day * grille.colonne + e.lane * grille.colonne / max(1, e.lanes) + 3px;
                y: e.top * grille.height + 1px;
                width: grille.colonne / max(1, e.lanes) - 6px;
                height: max(20px, e.height * grille.height - 2px);
                border-radius: 5px;
                background: e.color.transparentize(bloc.has-hover ? 0.72 : 0.82);
                clip: true;

                accessible-role: button;
                accessible-label: e.time + " " + e.title;
                accessible-action-default => { root.event-opened(e.key); }

                Rectangle {
                    x: 0;
                    width: 3px;
                    border-radius: 1.5px;
                    background: e.color;
                }
                VerticalLayout {
                    padding-left: 9px;
                    padding-top: 4px;
                    padding-right: 4px;
                    spacing: 1px;
                    alignment: start;
                    Text {
                        text: e.title;
                        font-size: 12px;
                        font-weight: 600;
                        color: Tokens.text;
                        overflow: elide;
                    }
                    if evenement.height > 34px: Text {
                        text: e.time;
                        font-size: 11px;
                        color: Tokens.text-secondary;
                        overflow: elide;
                    }
                }
                bloc := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        root.event-anchored(evenement.absolute-position.x,
                            evenement.absolute-position.x + evenement.width,
                            evenement.absolute-position.y);
                        root.event-opened(e.key);
                    }
                }
            }

            // Now: its hour in the margin, and a line across today's column.
            if root.now-day >= 0 && root.now-fraction >= 0: Text {
                x: 0;
                y: root.now-fraction * grille.height - 7px;
                width: root.gutter - 10px;
                text: root.now-label;
                font-size: 11px;
                font-weight: 600;
                color: Tokens.error;
                horizontal-alignment: right;
            }
            if root.now-day >= 0 && root.now-fraction >= 0: Rectangle {
                x: root.gutter + root.now-day * grille.colonne - 4px;
                y: root.now-fraction * grille.height - 4px;
                width: grille.colonne + 4px;
                height: 8px;
                Rectangle {
                    x: 0;
                    width: 8px;
                    height: 8px;
                    border-radius: 4px;
                    background: Tokens.error;
                }
                Rectangle {
                    x: 4px;
                    y: 3px;
                    height: 2px;
                    background: Tokens.error;
                }
            }
        }
    }
}

// The calendar workspace.
export component CalendarView inherits Rectangle {
    in property <string> title;
    /// 0 month, 1 week, 2 day.
    in property <int> mode;
    in property <[CalendarData]> calendars;
    in property <string> mini-title;
    in property <[MonthCellData]> mini-cells;
    in property <[MonthCellData]> month-cells;
    in property <[WeekDayData]> week-days;
    in property <[TimedEventData]> week-events;
    in property <float> now-fraction: -1;
    in property <int> now-day: -1;

    callback navigate(int);
    callback today();
    callback mode-chosen(int);
    callback day-chosen(string);
    callback day-opened(string);
    callback mini-navigate(int);
    callback event-opened(string);
    callback new-event(string, int);
    callback calendar-toggled(int);
    callback calendar-refresh(int);
    callback calendar-remove(CalendarData);
    callback calendar-menu(CalendarData, length, length);
    callback calendar-new();
    callback subscribe-requested();
    /// An event was clicked here: where it is in the window, just before `event-opened`.
    callback event-anchored(length, length, length);

    background: Tokens.background;

    HorizontalLayout {
        // --- Left: create, jump, choose what shows ---
        Rail {
            rail-width: 244px;

            Button {
                // The rail's width, less its padding.
                width: 220px;
                text: "New event";
                icon: Icons.plus;
                shortcut: "N";
                kind: ButtonKind.primary;
                clicked => { root.new-event("", -1); }
            }
            Rectangle { height: 14px; }

            MiniMonth {
                title: root.mini-title;
                cells: root.mini-cells;
                day-chosen(d) => { root.day-chosen(d); }
                navigate(n) => { root.mini-navigate(n); }
            }
            Rectangle { height: 10px; }

            // The section's title, with the + that adds to it.
            HorizontalLayout {
                height: 32px;
                padding-left: 10px;
                SectionTitle {
                    text: "Calendars";
                    horizontal-stretch: 1;
                }
                IconButton {
                    y: (parent.height - self.height) / 2;
                    icon: Icons.plus;
                    label: "New calendar";
                    button-size: 24px;
                    icon-size: 12px;
                    clicked => { root.calendar-new(); }
                }
            }
            for cal in root.calendars: CalendarRow {
                cal: cal;
                toggled(id) => { root.calendar-toggled(id); }
                refresh(id) => { root.calendar-refresh(id); }
                remove(c) => { root.calendar-remove(c); }
                menu(c, x, y) => { root.calendar-menu(c, x, y); }
            }
            Rectangle { height: 6px; }
            HorizontalLayout {
                alignment: start;
                Button {
                    text: "Subscribe to a calendar";
                    label: "Subscribe to a calendar…";
                    icon: Icons.link;
                    kind: ButtonKind.ghost;
                    size: ButtonSize.sm;
                    clicked => { root.subscribe-requested(); }
                }
            }

            Rectangle { vertical-stretch: 1; }
        }

        // --- Right: the period ---
        VerticalLayout {
            padding-top: 22px;
            padding-left: 20px;
            padding-right: 20px;
            padding-bottom: 12px;
            spacing: 12px;

            HorizontalLayout {
                height: 40px;
                spacing: 6px;

                Text {
                    text: root.title;
                    font-family: Tokens.font-display;
                    font-size: 28px;
                    font-weight: 300;
                    letter-spacing: -0.4px;
                    color: Tokens.text;
                    vertical-alignment: center;
                    overflow: elide;
                    horizontal-stretch: 1;
                }
                Button {
                    y: (parent.height - self.height) / 2;
                    text: "Today";
                    shortcut: "T";
                    size: ButtonSize.sm;
                    clicked => { root.today(); }
                }
                IconButton {
                    y: (parent.height - self.height) / 2;
                    icon: Icons.chevron-left;
                    label: "Previous";
                    shortcut: "←";
                    button-size: 30px;
                    clicked => { root.navigate(-1); }
                }
                IconButton {
                    y: (parent.height - self.height) / 2;
                    icon: Icons.chevron-right;
                    label: "Next";
                    shortcut: "→";
                    button-size: 30px;
                    clicked => { root.navigate(1); }
                }
                Rectangle { width: 8px; }
                Segmented {
                    y: (parent.height - self.height) / 2;
                    options: ["Month", "Week", "Day"];
                    selected: root.mode;
                    chosen(i) => { root.mode-chosen(i); }
                }
            }

            if root.mode == 0: MonthGrid {
                vertical-stretch: 1;
                cells: root.month-cells;
                day-opened(d) => { root.day-chosen(d); }
                day-double-clicked(d) => { root.new-event(d, 9 * 60); }
                event-anchored(l, r, t) => { root.event-anchored(l, r, t); }
                event-opened(k) => { root.event-opened(k); }
            }

            if root.mode != 0: WeekGrid {
                vertical-stretch: 1;
                days: root.week-days;
                events: root.week-events;
                now-fraction: root.now-fraction;
                now-day: root.now-day;
                event-anchored(l, r, t) => { root.event-anchored(l, r, t); }
                event-opened(k) => { root.event-opened(k); }
                slot-double-clicked(d, m) => { root.new-event(d, m); }
                day-opened(d) => { root.day-opened(d); }
            }
        }
    }
}
