import { Tokens } from "@iris/theme/tokens.slint";
import { Icon, Icons } from "@iris/base/icons.slint";
import { Button, ButtonKind, ButtonSize } from "@iris/controls/button.slint";
import { Segmented, Toggle } from "@iris/controls/choice.slint";
import { TextField } from "@iris/controls/field.slint";
import { ComboBox, SpinBox } from "@iris/controls/pickers.slint";
import { ScrollView } from "@iris/controls/scroll.slint";
import { WindowToolbar } from "@iris/shell/chrome.slint";

// Les réglages, comme la Mac les range : une page, une colonne au milieu, des groupes
// sur fond gris arrondi, et dans chacun une ligne par réglage — sa vignette de couleur,
// ce qu'il fait (et pourquoi, en petit), son contrôle à droite.
//
// L'explication n'est pas décorative : un automatisme qu'on ne comprend pas, on le
// coupe par précaution, et l'application perd ce qui la rend utile.

/// The small coloured square that leads a row: an icon in white on its colour.
component IconTile inherits Rectangle {
    in property <string> icon;
    in property <color> tint;
    width: 22px;
    height: 22px;
    border-radius: 6px;
    background: root.tint;
    Icon {
        data: root.icon;
        size: 13px;
        weight: 2;
        tint: Tokens.accent-text;
    }
}

/// A row of a group: its tile, its words, its control at the right (`@children`), a
/// hairline above unless it opens the group.
component SettingRow inherits Rectangle {
    in property <string> icon;
    in property <color> tint;
    in property <string> label;
    in property <string> hint;
    /// The group's first row: no line above it.
    in property <bool> first;

    min-height: max(40px, rang.preferred-height);
    vertical-stretch: 0;

    if !root.first: Rectangle {
        x: 0;
        y: 0;
        height: 1px;
        background: Tokens.border;
    }
    rang := HorizontalLayout {
        padding-top: 9px;
        padding-bottom: 9px;
        spacing: 10px;
        IconTile {
            y: (parent.height - self.height) / 2;
            icon: root.icon;
            tint: root.tint;
        }
        VerticalLayout {
            alignment: center;
            spacing: 1px;
            horizontal-stretch: 1;
            Text {
                text: root.label;
                font-size: 13px;
                color: Tokens.text;
                wrap: word-wrap;
            }
            if root.hint != "": Text {
                text: root.hint;
                font-size: 11.5px;
                color: Tokens.text-muted;
                wrap: word-wrap;
            }
        }
        @children
    }
}

/// A row with a switch for its control.
component ToggleRow inherits SettingRow {
    in-out property <bool> value;
    callback toggled(bool);
    Toggle {
        y: (parent.height - self.height) / 2;
        label: root.label;
        on <=> root.value;
        toggled => { root.toggled(self.on); }
    }
}

/// A group of rows on its own rounded grey plate.
component Group inherits Rectangle {
    border-radius: 10px;
    background: Tokens.group;
    vertical-stretch: 0;
    VerticalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 0px;
        @children
    }
}

/// A group's title, above it; or, `note`, a line under one.
component GroupTitle inherits HorizontalLayout {
    in property <string> text;
    in property <bool> note;
    in property <color> ink: Tokens.text-muted;
    padding-left: 10px;
    padding-right: 10px;
    height: root.note ? self.preferred-height : 26px;
    Text {
        text: root.text;
        font-size: 12px;
        font-weight: root.note ? 400 : 600;
        color: root.ink;
        vertical-alignment: bottom;
        wrap: word-wrap;
    }
}

/// A colour to pick: a disc, ringed when it is the one.
component Swatch inherits Rectangle {
    in property <color> tint;
    in property <bool> on;
    in property <string> label;
    callback chosen();

    width: 20px;
    height: 20px;
    accessible-role: button;
    accessible-label: root.label;
    accessible-item-selected: root.on;
    accessible-action-default => { root.chosen(); }

    // The ring a little outside the disc, with the plate's colour between them.
    if root.on: Rectangle {
        width: 20px;
        height: 20px;
        border-radius: 10px;
        border-width: 1.5px;
        border-color: root.tint;
    }
    Rectangle {
        width: 14px;
        height: 14px;
        border-radius: 7px;
        background: root.tint;
    }
    TouchArea {
        mouse-cursor: pointer;
        clicked => { root.chosen(); }
    }
}

// Les réglages.
//
// Ce qui se règle : l'apparence, la densité, ce que l'application fait toute seule et
// ce qu'elle demande au système.
export component SettingsPanel inherits Rectangle {
    /// 0 as Windows is set, 1 light, 2 dark.
    in property <int> appearance;
    /// The accent colour's place among those offered; 0 is the theme's blue.
    in property <int> accent-index;
    /// The name Home greets.
    in-out property <string> first-name;
    in property <int> density;
    in-out property <bool> reply-marks-waiting;
    in-out property <bool> new-message-reopens;
    in-out property <bool> follow-up-enabled;
    in-out property <int> follow-up-days;
    in-out property <bool> notifications;
    in-out property <bool> start-at-login;
    in-out property <bool> handle-mailto;
    in-out property <bool> keep-running;
    /// Iris opens on the Home screen.
    in-out property <bool> home-at-startup;
    /// The window's buttons as the Mac's three lights, or as Windows' three.
    in-out property <bool> mac-buttons;
    /// How long a sent message can still be taken back, in seconds.
    in-out property <int> undo-send-seconds;
    /// Ce que le système ne permet pas ici, et pourquoi.
    in property <string> system-note;
    /// "Iris 0.2.0", and what the last update check found.
    in property <string> version;
    in property <string> update-status;
    in property <bool> update-checking;
    /// The newer version on offer, empty when there is none.
    in property <string> update-version;

    callback check-for-updates();
    callback install-update();
    callback appearance-chosen(int);
    callback accent-chosen(int);
    callback first-name-changed(string);
    callback density-chosen(int);
    callback automation-changed();
    callback system-changed();
    callback sending-changed();
    callback add-account();
    /// The OAuth clients for signing in with Google or Microsoft.
    in-out property <string> google-client-id;
    in-out property <string> google-client-secret;
    in-out property <string> microsoft-client-id;
    callback oauth-changed();
    callback open-modules();
    callback dismissed();

    /// The accents offered, as the Mac offers them, and their names.
    property <[color]> accents: [
        Tokens.blue, Tokens.purple, Tokens.pink, Tokens.red, Tokens.orange,
        Tokens.yellow, Tokens.green, Tokens.grey
    ];
    property <[string]> accent-names: [
        "Blue", "Purple", "Pink", "Red", "Orange", "Yellow", "Green", "Graphite"
    ];
    /// The undo delays offered, in seconds.
    property <[int]> delais: [0, 5, 10, 20, 30];

    // A white page, the groups grey on it (lighter than the page in dark).
    background: Tokens.surface;

    // Over what is behind: no click goes through the page.
    TouchArea {}

    VerticalLayout {
        WindowToolbar {
            Text {
                text: "Settings";
                font-family: Tokens.font-display;
                font-size: 15px;
                font-weight: 600;
                color: Tokens.text;
                vertical-alignment: center;
            }
            Rectangle { horizontal-stretch: 1; }
            Button {
                y: (parent.height - self.height) / 2;
                text: "Done";
                label: "Close settings";
                kind: ButtonKind.primary;
                size: ButtonSize.sm;
                clicked => { root.dismissed(); }
            }
        }

        // The groups scroll: there are more of them than a short window holds.
        page := ScrollView {
            vertical-stretch: 1;
            viewport-width: self.visible-width;
            viewport-height: colonne.preferred-height;

            colonne := VerticalLayout {
                x: max(16px, (page.visible-width - self.width) / 2);
                width: min(560px, page.visible-width - 32px);
                padding-top: 4px;
                padding-bottom: 32px;
                spacing: 6px;

                GroupTitle { text: "General"; }
                Group {
                    SettingRow {
                        first: true;
                        icon: Icons.sparkle;
                        tint: Tokens.purple;
                        label: "Your first name";
                        hint: "Home greets you by it.";
                        TextField {
                            y: (parent.height - self.height) / 2;
                            width: 180px;
                            height: 26px;
                            accessible-label: "Your first name";
                            placeholder-text: "First name";
                            text <=> root.first-name;
                            edited(t) => { root.first-name-changed(t); }
                        }
                    }
                    ToggleRow {
                        icon: Icons.home;
                        tint: Tokens.blue;
                        label: "Open Iris on Home";
                        hint: "Your day at a glance first. Off: Iris opens on your mail.";
                        value <=> root.home-at-startup;
                        toggled => { root.system-changed(); }
                    }
                }

                GroupTitle { text: "Appearance"; }
                Group {
                    SettingRow {
                        first: true;
                        icon: Icons.sun;
                        tint: Tokens.grey;
                        label: "Appearance";
                        // Light, dark, or as Windows is set; `appearance` counts the
                        // other way round (0 is the system's).
                        Segmented {
                            y: (parent.height - self.height) / 2;
                            options: ["Light", "Dark", "System"];
                            selected: root.appearance == 0 ? 2 : root.appearance - 1;
                            chosen(i) => { root.appearance-chosen(i == 2 ? 0 : i + 1); }
                        }
                    }
                    SettingRow {
                        icon: Icons.gear;
                        tint: Tokens.accent;
                        label: "Accent colour";
                        HorizontalLayout {
                            spacing: 4px;
                            y: (parent.height - self.height) / 2;
                            for c[i] in root.accents: Swatch {
                                tint: c;
                                on: i == root.accent-index;
                                label: root.accent-names[i] + " accent";
                                chosen => { root.accent-chosen(i); }
                            }
                        }
                    }
                    SettingRow {
                        icon: Icons.list;
                        tint: Tokens.teal;
                        label: "List density";
                        Segmented {
                            y: (parent.height - self.height) / 2;
                            options: ["Compact", "Normal", "Comfortable"];
                            selected: root.density;
                            chosen(i) => { root.density-chosen(i); }
                        }
                    }
                    SettingRow {
                        icon: Icons.blocks;
                        tint: Tokens.grey;
                        label: "Window buttons";
                        hint: "Mac traffic lights, or Windows buttons on the right";
                        Segmented {
                            y: (parent.height - self.height) / 2;
                            options: ["Mac", "Windows"];
                            selected: root.mac-buttons ? 0 : 1;
                            chosen(i) => {
                                root.mac-buttons = i == 0;
                                root.system-changed();
                            }
                        }
                    }
                }

                GroupTitle { text: "Mail"; }
                Group {
                    ToggleRow {
                        first: true;
                        icon: Icons.bell;
                        tint: Tokens.red;
                        label: "Notifications";
                        hint: "One per sync, not one per message.";
                        value <=> root.notifications;
                        toggled => { root.system-changed(); }
                    }
                    SettingRow {
                        icon: Icons.send;
                        tint: Tokens.green;
                        label: "Undo send";
                        hint: "Seconds a sent message can be taken back";
                        ComboBox {
                            y: (parent.height - self.height) / 2;
                            width: 92px;
                            height: 24px;
                            accessible-label: "Undo send";
                            model: ["Off", "5 s", "10 s", "20 s", "30 s"];
                            current-index: root.undo-send-seconds <= 0 ? 0
                                : root.undo-send-seconds <= 5 ? 1
                                : root.undo-send-seconds <= 10 ? 2
                                : root.undo-send-seconds <= 20 ? 3 : 4;
                            selected => {
                                root.undo-send-seconds = root.delais[self.current-index];
                                root.sending-changed();
                            }
                        }
                    }
                    SettingRow {
                        icon: Icons.envelope-closed;
                        tint: Tokens.orange;
                        label: "Accounts";
                        Button {
                            y: (parent.height - self.height) / 2;
                            text: "Add an account…";
                            size: ButtonSize.sm;
                            clicked => { root.add-account(); }
                        }
                    }
                    SettingRow {
                        icon: Icons.puzzle;
                        tint: Tokens.purple;
                        label: "Rules and plugins";
                        hint: "Sort mail as it arrives, and extend Iris.";
                        Button {
                            y: (parent.height - self.height) / 2;
                            text: "Open modules";
                            label: "Modules: rules and plugins";
                            size: ButtonSize.sm;
                            clicked => { root.open-modules(); }
                        }
                    }
                }

                GroupTitle { text: "Automations"; }
                Group {
                    ToggleRow {
                        first: true;
                        icon: Icons.hourglass;
                        tint: Tokens.orange;
                        label: "Replying marks the thread as waiting";
                        hint: "The thread leaves your queue and waits for the other side.";
                        value <=> root.reply-marks-waiting;
                        toggled => { root.automation-changed(); }
                    }
                    ToggleRow {
                        icon: Icons.refresh;
                        tint: Tokens.blue;
                        label: "A new message reopens the thread";
                        hint: "A finished thread that gets a follow-up comes back to your queue.";
                        value <=> root.new-message-reopens;
                        toggled => { root.automation-changed(); }
                    }
                    ToggleRow {
                        icon: Icons.clock;
                        tint: Tokens.teal;
                        label: "Follow up on unanswered threads";
                        hint: "A thread waiting too long comes back on its own.";
                        value <=> root.follow-up-enabled;
                        toggled => { root.automation-changed(); }
                    }
                    if root.follow-up-enabled: SettingRow {
                        icon: Icons.calendar;
                        tint: Tokens.teal;
                        label: "Bring it back after";
                        hint: "Days without an answer";
                        SpinBox {
                            y: (parent.height - self.height) / 2;
                            width: 80px;
                            height: 26px;
                            minimum: 1;
                            maximum: 365;
                            value <=> root.follow-up-days;
                            edited => { root.automation-changed(); }
                        }
                    }
                }

                GroupTitle { text: "System"; }
                Group {
                    // First, because it decides what the commonest gesture does:
                    // closing the window.
                    ToggleRow {
                        first: true;
                        icon: Icons.layers;
                        tint: Tokens.grey;
                        label: "Keep running when I close the window";
                        hint: "Iris stays in the notification area and keeps syncing.";
                        value <=> root.keep-running;
                        toggled => { root.system-changed(); }
                    }
                    ToggleRow {
                        icon: Icons.sun;
                        tint: Tokens.orange;
                        label: "Start with Windows";
                        hint: "Iris waits in the notification area rather than opening a window.";
                        value <=> root.start-at-login;
                        toggled => { root.system-changed(); }
                    }
                    ToggleRow {
                        icon: Icons.link;
                        tint: Tokens.blue;
                        label: "Offer Iris for mailto: links";
                        hint: "Windows still decides the default in its own settings.";
                        value <=> root.handle-mailto;
                        toggled => { root.system-changed(); }
                    }
                }
                if root.system-note != "": GroupTitle {
                    note: true;
                    text: root.system-note;
                    ink: Tokens.warning;
                }

                // Signing in with Google or Microsoft through the browser needs a
                // client of one's own, registered with them.
                GroupTitle { text: "Sign in with Google or Microsoft"; }
                Group {
                    SettingRow {
                        first: true;
                        icon: Icons.key;
                        tint: Tokens.blue;
                        label: "Google client";
                        hint: "A desktop OAuth client from Google Cloud Console: Gmail signs in through the browser.";
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        padding-bottom: 10px;
                        TextField {
                            accessible-label: "Google client ID";
                            placeholder-text: "Client ID (….apps.googleusercontent.com)";
                            font-size: 12.5px;
                            text <=> root.google-client-id;
                            edited(t) => { root.oauth-changed(); }
                        }
                        TextField {
                            accessible-label: "Google client secret";
                            placeholder-text: "Client secret";
                            font-size: 12.5px;
                            input-type: InputType.password;
                            text <=> root.google-client-secret;
                            edited(t) => { root.oauth-changed(); }
                        }
                    }
                    SettingRow {
                        icon: Icons.key;
                        tint: Tokens.teal;
                        label: "Microsoft client";
                        hint: "An application registered in Microsoft Entra, for Outlook.";
                        TextField {
                            y: (parent.height - self.height) / 2;
                            width: 200px;
                            height: 26px;
                            accessible-label: "Microsoft client ID";
                            placeholder-text: "Application (client) ID";
                            font-size: 12.5px;
                            text <=> root.microsoft-client-id;
                            edited(t) => { root.oauth-changed(); }
                        }
                    }
                }

                // Checked at every launch and every few hours after; this is for
                // whoever wants to know now.
                GroupTitle { text: "Updates"; }
                Group {
                    SettingRow {
                        first: true;
                        icon: Icons.download;
                        tint: Tokens.green;
                        label: root.version;
                        hint: root.update-status;
                        if root.update-version != "": Button {
                            y: (parent.height - self.height) / 2;
                            text: "Install " + root.update-version;
                            kind: ButtonKind.primary;
                            size: ButtonSize.sm;
                            clicked => { root.install-update(); }
                        }
                        Button {
                            y: (parent.height - self.height) / 2;
                            text: root.update-checking ? "Checking…" : "Check for updates";
                            size: ButtonSize.sm;
                            enabled: !root.update-checking;
                            clicked => { root.check-for-updates(); }
                        }
                    }
                }

                GroupTitle {
                    note: true;
                    text: "Settings are saved as you change them.";
                }
            }
        }
    }
}
