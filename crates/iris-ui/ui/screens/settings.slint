import { Tokens } from "@iris/theme/tokens.slint";
import { ThemeSwatchData } from "@iris/types.slint";
import { Button, ButtonKind, ButtonSize } from "@iris/controls/button.slint";
import { Segmented } from "@iris/controls/choice.slint";
import { SectionTitle } from "@iris/lists/nav.slint";
import { Modal } from "@iris/layout/frames.slint";
import { CheckBox, SpinBox, ScrollView } from "std-widgets.slint";

// The theme picker.
//
// Each entry shows the theme rather than naming it: three bands of its own colours,
// in the order the eye meets them on screen — ground, surface, accent. Naming alone
// makes people try each one to find out, and every trial repaints the window.
component ThemePicker inherits HorizontalLayout {
    in property <[ThemeSwatchData]> themes;
    in property <int> selected;

    callback chosen(int);

    spacing: 8px;

    for theme[i] in root.themes: Rectangle {
        width: 78px;
        height: 46px;
        border-radius: Tokens.radius-small;
        background: theme.background;
        border-width: root.selected == i ? 2px : 1px;
        border-color: root.selected == i ? Tokens.accent : Tokens.border;
        clip: true;

        accessible-role: tab;
        accessible-label: theme.label;
        accessible-item-selected: root.selected == i;
        accessible-action-default => { root.chosen(i); }

        VerticalLayout {
            padding: 4px;
            spacing: 3px;

            // A band of the surface colour, then one of the accent: the two things
            // that actually differ between themes at a glance.
            Rectangle {
                height: 8px;
                border-radius: 2px;
                background: theme.surface;
            }
            Rectangle {
                height: 5px;
                width: 26px;
                border-radius: 2px;
                background: theme.accent;
            }

            Rectangle {}

            Text {
                text: theme.label;
                font-size: 9px;
                color: theme.text;
                overflow: elide;
            }
        }

        TouchArea {
            mouse-cursor: pointer;
            clicked => { root.chosen(i); }
        }
    }

    Rectangle {}
}

// Un interrupteur avec son explication.
//
// L'explication n'est pas décorative : un automatisme qu'on ne comprend pas, on le
// coupe par précaution, et l'application perd ce qui la rend utile.
component SettingToggle inherits VerticalLayout {
    in property <string> label;
    in property <string> hint;
    in-out property <bool> value;

    callback toggled(bool);

    spacing: 2px;

    CheckBox {
        text: root.label;
        checked <=> root.value;
        toggled => { root.toggled(self.checked); }
    }

    Text {
        text: root.hint;
        font-size: 12px;
        color: Tokens.text-muted;
        wrap: word-wrap;
    }
}

// A section's title, with the space above it that separates it from the last.
component Section inherits VerticalLayout {
    in property <string> title;
    padding-top: 6px;
    SectionTitle {
        text: root.title;
        height: 22px;
    }
}

// Les réglages.
//
// Ce qui se règle : l'apparence, la densité, ce que l'application fait toute seule et
// ce qu'elle demande au système. Tout le reste appartient au thème, qui est un fichier.
export component SettingsPanel inherits Rectangle {
    in property <[ThemeSwatchData]> themes;
    in property <int> active-theme;
    in property <int> density;
    in-out property <bool> reply-marks-waiting;
    in-out property <bool> new-message-reopens;
    in-out property <bool> follow-up-enabled;
    in-out property <int> follow-up-days;
    in-out property <bool> notifications;
    in-out property <bool> start-at-login;
    in-out property <bool> handle-mailto;
    in-out property <bool> keep-running;
    /// Iris opens on the Home screen.
    in-out property <bool> home-at-startup;
    /// How long a sent message can still be taken back, in seconds.
    in-out property <int> undo-send-seconds;
    /// Ce que le système ne permet pas ici, et pourquoi.
    in property <string> system-note;
    /// "Iris 0.2.0", and what the last update check found.
    in property <string> version;
    in property <string> update-status;
    in property <bool> update-checking;
    /// The newer version on offer, empty when there is none.
    in property <string> update-version;

    callback check-for-updates();
    callback install-update();
    callback theme-chosen(int);
    callback density-chosen(int);
    callback automation-changed();
    callback system-changed();
    callback sending-changed();
    callback dismissed();

    Modal {
        width: 100%;
        height: 100%;
        title: "Settings";
        close-label: "Close settings";
        card-width: 540px;
        card-height: 720px;
        dismissed => { root.dismissed(); }

        // The sections scroll: there are more of them than a short window holds,
        // and a panel that cuts its last setting off hides the one you came for.
        ScrollView {
            vertical-stretch: 1;
            viewport-width: self.visible-width;
            viewport-height: sections.preferred-height;

            sections := VerticalLayout {
                spacing: 10px;
                padding-right: 8px;
                padding-bottom: 12px;

                Section { title: "Theme"; }
                ThemePicker {
                    themes: root.themes;
                    selected: root.active-theme;
                    chosen(i) => { root.theme-chosen(i); }
                }

                Section { title: "List density"; }
                HorizontalLayout {
                    Segmented {
                        options: ["Compact", "Normal", "Comfortable"];
                        selected: root.density;
                        chosen(i) => { root.density-chosen(i); }
                    }
                    Rectangle {}
                }

                Section { title: "Startup"; }
                SettingToggle {
                    label: "Open Iris on Home";
                    hint: "Your day at a glance first. Off: Iris opens on your mail, and Home stays one click away on the name at the top left.";
                    value <=> root.home-at-startup;
                    toggled => { root.system-changed(); }
                }

                Section { title: "Automations"; }
                SettingToggle {
                    label: "Replying marks the thread as waiting";
                    hint: "The thread leaves your queue and waits for the other side.";
                    value <=> root.reply-marks-waiting;
                    toggled => { root.automation-changed(); }
                }
                SettingToggle {
                    label: "A new message reopens the thread";
                    hint: "A finished thread that gets a follow-up comes back to your queue.";
                    value <=> root.new-message-reopens;
                    toggled => { root.automation-changed(); }
                }
                SettingToggle {
                    label: "Follow up on unanswered threads";
                    hint: "A thread waiting too long comes back on its own.";
                    value <=> root.follow-up-enabled;
                    toggled => { root.automation-changed(); }
                }

                // A row, not a block. Inside a vertical layout every child stretches
                // unless it is told not to, and a spin box given a hundred pixels of
                // height is a box with a number lost in the middle of it.
                if root.follow-up-enabled: HorizontalLayout {
                    spacing: 8px;
                    vertical-stretch: 0;
                    height: 30px;
                    Text {
                        text: "After";
                        font-size: 13px;
                        color: Tokens.text-secondary;
                        vertical-alignment: center;
                    }
                    SpinBox {
                        width: 92px;
                        height: 30px;
                        minimum: 1;
                        maximum: 365;
                        value <=> root.follow-up-days;
                        edited => { root.automation-changed(); }
                    }
                    Text {
                        text: "days";
                        font-size: 13px;
                        color: Tokens.text-secondary;
                        vertical-alignment: center;
                    }
                    Rectangle {}
                }

                Section { title: "Sending"; }
                // The window closes on Send; for this long a notice at the bottom of the
                // window can still take the message back.
                HorizontalLayout {
                    spacing: 8px;
                    vertical-stretch: 0;
                    height: 30px;
                    Text {
                        text: "Time to undo a send";
                        font-size: 13px;
                        color: Tokens.text;
                        vertical-alignment: center;
                    }
                    Rectangle {}
                    SpinBox {
                        width: 92px;
                        height: 30px;
                        minimum: 0;
                        maximum: 30;
                        value <=> root.undo-send-seconds;
                        edited => { root.sending-changed(); }
                    }
                    Text {
                        text: "seconds";
                        font-size: 13px;
                        color: Tokens.text-secondary;
                        vertical-alignment: center;
                    }
                }

                Section { title: "System"; }
                // Le premier des trois, parce que c'est celui qui décide de ce que fait le
                // geste le plus courant : fermer la fenêtre.
                SettingToggle {
                    label: "Keep running when I close the window";
                    hint: "Iris stays in the notification area and keeps syncing. Off: closing quits, and the tray icon goes away.";
                    value <=> root.keep-running;
                    toggled => { root.system-changed(); }
                }
                SettingToggle {
                    label: "Tell me when mail arrives";
                    hint: "One notification per sync, not one per message.";
                    value <=> root.notifications;
                    toggled => { root.system-changed(); }
                }
                SettingToggle {
                    label: "Start with Windows";
                    hint: "Iris waits in the notification area rather than opening a window.";
                    value <=> root.start-at-login;
                    toggled => { root.system-changed(); }
                }
                SettingToggle {
                    label: "Offer Iris for mailto: links";
                    hint: "Windows still decides the default in its own settings.";
                    value <=> root.handle-mailto;
                    toggled => { root.system-changed(); }
                }
                if root.system-note != "": Text {
                    text: root.system-note;
                    font-size: 12px;
                    color: Tokens.warning;
                    wrap: word-wrap;
                }

                Section { title: "Updates"; }
                // Checked at every launch and every few hours after; this is for whoever
                // wants to know now. Two lines of text: a fixed height of one button cut
                // the second off below the end of the scroll area, out of reach.
                HorizontalLayout {
                    spacing: 8px;
                    vertical-stretch: 0;
                    min-height: 28px;
                    VerticalLayout {
                        alignment: center;
                        horizontal-stretch: 1;
                        Text {
                            text: root.version;
                            font-size: 13px;
                            color: Tokens.text-secondary;
                        }
                        Text {
                            text: root.update-status;
                            font-size: 12px;
                            color: Tokens.text-muted;
                            overflow: elide;
                        }
                    }
                    if root.update-version != "": Button {
                        y: (parent.height - self.height) / 2;
                        text: "Install " + root.update-version;
                        kind: ButtonKind.primary;
                        size: ButtonSize.sm;
                        clicked => { root.install-update(); }
                    }
                    Button {
                        y: (parent.height - self.height) / 2;
                        text: root.update-checking ? "Checking…" : "Check for updates";
                        size: ButtonSize.sm;
                        enabled: !root.update-checking;
                        clicked => { root.check-for-updates(); }
                    }
                }

                Text {
                    text: "Settings are saved as you change them.";
                    font-size: 12px;
                    color: Tokens.text-muted;
                }
            }
        }
    }
}
