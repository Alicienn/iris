import { Tokens } from "@iris/theme/tokens.slint";
import { TextArea, TextField } from "@iris/controls/field.slint";
import { Button, ButtonKind } from "@iris/controls/button.slint";
import { Modal, ModalFooter } from "@iris/layout/frames.slint";
import { IconButton, Icons } from "@iris/base/icons.slint";
import { AliasData } from "@iris/types.slint";

// The addresses a mailbox sends as besides its own. The server must accept them from
// that account (an alias it knows): Iris only offers them as senders.
export component AliasPanel inherits Rectangle {
    in property <string> account;
    in property <[AliasData]> rows;
    in property <string> error;
    in-out property <string> new-address;
    in-out property <string> new-name;
    callback added();
    callback removed(int);
    callback dismissed();

    Modal {
        width: 100%;
        height: 100%;
        title: "Send as";
        card-width: 480px;
        fit: true;
        dismissed => { root.dismissed(); }

        Text {
            text: "Other addresses " + root.account + " can send as. They appear as senders when you write.";
            font-size: 12.5px;
            color: Tokens.text-muted;
            wrap: word-wrap;
        }
        for a in root.rows: HorizontalLayout {
            height: 38px;
            spacing: 8px;
            VerticalLayout {
                alignment: center;
                horizontal-stretch: 1;
                Text {
                    text: a.address;
                    font-size: 13px;
                    color: Tokens.text;
                    overflow: elide;
                }
                if a.name != "": Text {
                    text: a.name;
                    font-size: 12px;
                    color: Tokens.text-muted;
                }
            }
            IconButton {
                y: (parent.height - self.height) / 2;
                icon: Icons.trash;
                label: "Remove " + a.address;
                button-size: 28px;
                icon-size: 14px;
                clicked => { root.removed(a.id); }
            }
        }
        HorizontalLayout {
            spacing: 8px;
            height: 32px;
            TextField {
                accessible-label: "Address to send as";
                placeholder-text: "support@example.com";
                text <=> root.new-address;
                init => { self.focus(); }
                accepted => { root.added(); }
            }
            TextField {
                width: 140px;
                accessible-label: "Name shown";
                placeholder-text: "Name (optional)";
                text <=> root.new-name;
                accepted => { root.added(); }
            }
        }
        if root.error != "": Text {
            text: root.error;
            font-size: 12px;
            color: Tokens.error;
            wrap: word-wrap;
        }
        ModalFooter {
            Button {
                text: "Add";
                kind: ButtonKind.primary;
                clicked => { root.added(); }
            }
        }
    }
}

// La signature d'un compte.
//
// Par compte, et donc atteinte depuis le menu du compte plutôt que depuis les réglages
// généraux : c'est la raison d'avoir plusieurs boîtes qu'on ne signe pas une facture
// comme on écrit à sa sœur.
export component SignaturePanel inherits Rectangle {
    in property <string> account;
    in-out property <string> signature;

    callback saved();
    callback dismissed();

    Modal {
        width: 100%;
        height: 100%;
        title: "Signature";
        card-width: 520px;
        card-height: 420px;
        dismissed => { root.dismissed(); }

        Text {
            text: "Added to messages sent from " + root.account + ".";
            font-size: 12px;
            color: Tokens.text-muted;
            wrap: word-wrap;
        }

        TextArea {
            vertical-stretch: 1;
            accessible-label: "Signature";
            placeholder-text: "Marie Durand\nScierie mobile, 01 23 45 67 89";
            font-size: Tokens.size-body;
            wrap: word-wrap;
            text <=> root.signature;
        }

        // Ce que l'application ajoute d'elle-même, dit une fois plutôt que
        // découvert dans un message reçu en retour.
        ModalFooter {
            note: "Iris puts the standard \"-- \" separator above it.";
            Button {
                text: "Save";
                label: "Save the signature";
                kind: ButtonKind.primary;
                clicked => { root.saved(); }
            }
        }
    }
}
