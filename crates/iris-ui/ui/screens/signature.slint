import { Tokens } from "@iris/theme/tokens.slint";
import { TextArea } from "@iris/controls/field.slint";
import { Button, ButtonKind } from "@iris/controls/button.slint";
import { Modal, ModalFooter } from "@iris/layout/frames.slint";

// La signature d'un compte.
//
// Par compte, et donc atteinte depuis le menu du compte plutôt que depuis les réglages
// généraux : c'est la raison d'avoir plusieurs boîtes qu'on ne signe pas une facture
// comme on écrit à sa sœur.
export component SignaturePanel inherits Rectangle {
    in property <string> account;
    in-out property <string> signature;

    callback saved();
    callback dismissed();

    Modal {
        width: 100%;
        height: 100%;
        title: "Signature";
        card-width: 520px;
        card-height: 420px;
        dismissed => { root.dismissed(); }

        Text {
            text: "Added to messages sent from " + root.account + ".";
            font-size: 12px;
            color: Tokens.text-muted;
            wrap: word-wrap;
        }

        TextArea {
            vertical-stretch: 1;
            accessible-label: "Signature";
            placeholder-text: "Marie Durand\nScierie mobile, 01 23 45 67 89";
            font-size: Tokens.size-body;
            wrap: word-wrap;
            text <=> root.signature;
        }

        // Ce que l'application ajoute d'elle-même, dit une fois plutôt que
        // découvert dans un message reçu en retour.
        ModalFooter {
            note: "Iris puts the standard \"-- \" separator above it.";
            Button {
                text: "Save";
                label: "Save the signature";
                kind: ButtonKind.primary;
                clicked => { root.saved(); }
            }
        }
    }
}
