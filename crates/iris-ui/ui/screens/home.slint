import { Tokens } from "@iris/theme/tokens.slint";
import { Kbd, Dot } from "@iris/base/atoms.slint";
import { Check } from "@iris/controls/choice.slint";
import { HomeItemData } from "@iris/types.slint";
import { JoinButton } from "@iris/controls/video.slint";

// Home: the day in a sentence, the one thing next, three ways in. Nothing else.
//
// A start page earns its place by being read in two seconds; each thing added to it
// is read less. What is not here is one click away.

component WayIn inherits Rectangle {
    in property <string> text;
    in property <string> count;
    in property <string> label;
    callback clicked();

    width: rang.preferred-width;
    height: 24px;
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { root.clicked(); }

    rang := HorizontalLayout {
        spacing: 6px;
        Text {
            text: root.text;
            font-size: 13.5px;
            color: touch.has-hover ? Tokens.text : Tokens.text-secondary;
            vertical-alignment: center;
        }
        if root.count != "": Text {
            text: root.count;
            font-size: 12.5px;
            color: Tokens.text-muted;
            vertical-alignment: center;
        }
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component HomeView inherits Rectangle {
    in property <string> greeting;
    in property <string> date;
    in property <string> summary;
    /// The next thing of the day, first in the list: an event (no id) or a task.
    in property <[HomeItemData]> next;
    in property <string> mail-count;
    in property <string> tasks-count;
    in property <string> events-count;

    callback opened(string);
    callback task-opened(int);
    callback task-toggled(int);
    callback event-opened(string);
    /// An event's video call joined: its link.
    callback join(string);

    property <bool> has-next: root.next.length > 0;
    property <HomeItemData> first: root.has-next ? root.next[0] : { };

    background: Tokens.background;

    // A little above the middle, where the eye rests.
    bloc := Rectangle {
        width: min(560px, root.width - 64px);
        height: colonne.preferred-height;
        x: (root.width - self.width) / 2;
        y: max(24px, root.height * 0.42 - self.height / 2);

        colonne := VerticalLayout {
            width: bloc.width;
            spacing: 0px;

            Text {
                text: root.date;
                font-size: 13px;
                color: Tokens.text-muted;
            }
            Rectangle { height: 6px; }
            Text {
                text: root.greeting;
                font-family: Tokens.font-display;
                font-size: 30px;
                font-weight: 600;
                letter-spacing: -0.3px;
                color: Tokens.text;
                wrap: word-wrap;
            }
            Rectangle { height: 8px; }
            Text {
                text: root.summary;
                font-size: 15px;
                color: Tokens.text-secondary;
                wrap: word-wrap;
            }

            // The one thing next, between two hairlines.
            if root.has-next: VerticalLayout {
                padding-top: 34px;
                Rectangle { height: 1px; background: Tokens.border; }
                prochain := Rectangle {
                    height: 46px;
                    accessible-role: button;
                    accessible-label: "Next: " + root.first.title;
                    accessible-description: root.first.meta;
                    accessible-action-default => {
                        if (root.first.id > 0) { root.task-opened(root.first.id); } else { root.event-opened(root.first.key); }
                    }
                    ligne := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            if (root.first.id > 0) { root.task-opened(root.first.id); } else { root.event-opened(root.first.key); }
                        }
                    }
                    // Clear of the hairlines by a few pixels: what the hover repaints
                    // (the title's new colour) must not reach them, or a line is lost
                    // under the repainted ground at fractional scales.
                    HorizontalLayout {
                        padding-top: 4px;
                        padding-bottom: 4px;
                        spacing: 10px;
                        Text {
                            width: 44px;
                            text: "Next";
                            font-size: 12px;
                            font-weight: 600;
                            color: Tokens.text-muted;
                            vertical-alignment: center;
                        }
                        Rectangle {
                            width: 14px;
                            if root.first.id > 0: Check {
                                animated: true;
                                size: 14px;
                                label: root.first.title;
                                toggled => { root.task-toggled(root.first.id); }
                            }
                            if root.first.id <= 0: Dot {
                                tint: root.first.color;
                                size: 9px;
                            }
                        }
                        Text {
                            text: root.first.title;
                            font-size: 13.5px;
                            font-weight: 500;
                            color: ligne.has-hover ? Tokens.accent : Tokens.text;
                            vertical-alignment: center;
                            overflow: elide;
                            horizontal-stretch: 1;
                        }
                        Text {
                            text: root.first.meta;
                            font-size: 12.5px;
                            color: Tokens.text-muted;
                            vertical-alignment: center;
                        }
                        // Held on a video call: the service's button, one click in.
                        if root.first.video-url != "": JoinButton {
                            y: (parent.height - self.height) / 2;
                            compact: true;
                            kind: root.first.video-kind;
                            text: root.first.video-label;
                            clicked => { root.join(root.first.video-url); }
                        }
                    }
                }
                Rectangle { height: 1px; background: Tokens.border; }
            }

            HorizontalLayout {
                padding-top: 22px;
                spacing: 22px;
                alignment: start;
                WayIn {
                    text: "Mail";
                    count: root.mail-count;
                    label: "Open Mail";
                    clicked => { root.opened("mail"); }
                }
                WayIn {
                    text: "Tasks";
                    count: root.tasks-count;
                    label: "Open Tasks";
                    clicked => { root.opened("tasks"); }
                }
                WayIn {
                    text: "Calendar";
                    label: "Open Calendar";
                    clicked => { root.opened("calendar"); }
                }
            }
        }
    }

    // What reaches everything else, said once and quietly.
    HorizontalLayout {
        y: root.height - 44px;
        height: 22px;
        alignment: center;
        spacing: 6px;
        Text {
            text: "Press";
            font-size: 12px;
            color: Tokens.text-faint;
            vertical-alignment: center;
        }
        Kbd {
            y: (parent.height - self.height) / 2;
            keys: "Ctrl K";
        }
        Text {
            text: "to find or do anything";
            font-size: 12px;
            color: Tokens.text-faint;
            vertical-alignment: center;
        }
    }
}
