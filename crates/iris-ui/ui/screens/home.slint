import { Tokens } from "@iris/theme/tokens.slint";
import { TextStyle, Tone } from "@iris/theme/type.slint";
import { Icons, IconButton } from "@iris/base/icons.slint";
import { Label } from "@iris/base/atoms.slint";
import { Link } from "@iris/controls/button.slint";
import { TimeRow } from "@iris/lists/rows.slint";
import { HomeItemData } from "@iris/types.slint";

// The Home screen: the day, and nothing else.
//
// The date, a greeting, one sentence on what is waiting, the next three things of the
// day, and three ways out. Everything else was taken away: a start page earns its place
// by being read in two seconds, and each thing added to it is read less.
//
// One moment of motion: the words come up when Home opens. Nothing loops.

export component HomeView inherits Rectangle {
    in property <string> greeting;
    in property <string> date;
    in property <string> summary;
    /// The next things of the day: events and tasks, in the order of their hours.
    in property <[HomeItemData]> next;
    in property <string> mail-count;
    in property <string> tasks-count;
    in property <string> events-count;
    in property <bool> syncing;
    in property <string> sync-progress;
    /// What the syncs brought since Iris was opened.
    in property <string> sync-summary;

    callback opened(string);
    callback sync();
    callback task-opened(int);
    callback task-toggled(int);
    callback event-opened(string);

    // The words come up, once.
    property <float> ouverture;
    animate ouverture { duration: 520ms; easing: cubic-bezier(0.2, 0, 0, 1); }
    init => { root.ouverture = 1; }

    // Rows and links have an inset of their own for their hover; they are pulled
    // back by it so their words line up with the column.
    property <length> retrait-ligne: 8px;
    property <length> retrait-lien: 6px;

    background: Tokens.background;

    // Sync, reduced to its icon in the corner; the tooltip says what it brought.
    IconButton {
        x: parent.width - self.width - 20px;
        y: 16px;
        icon: Icons.refresh;
        label: root.syncing
            ? (root.sync-progress != "" ? "Syncing " + root.sync-progress : "Syncing…")
            : "Sync all accounts. " + root.sync-summary;
        active: root.syncing;
        button-size: 32px;
        icon-size: 15px;
        clicked => { root.sync(); }
    }

    // Centred in the window, a little above the middle where the eye rests.
    bloc := Rectangle {
        width: min(520px, root.width - 64px);
        height: colonne.preferred-height;
        x: (root.width - self.width) / 2;
        y: max(24px, (root.height - self.height) / 2 - 24px) + (1 - root.ouverture) * 12px;
        opacity: root.ouverture;

        colonne := VerticalLayout {
            width: bloc.width;
            spacing: 0px;

            Label {
                text: root.date;
                style: TextStyle.body;
                tone: Tone.muted;
            }
            Rectangle { height: 10px; }
            Label {
                text: root.greeting;
                style: TextStyle.display;
            }
            Rectangle { height: 14px; }
            Label {
                text: root.summary;
                font-size: 16px;
                tone: Tone.secondary;
                wrap: word-wrap;
            }

            if root.next.length > 0: VerticalLayout {
                padding-top: 44px;
                spacing: 0px;
                Label {
                    text: "Next";
                    style: TextStyle.caption;
                    tone: Tone.muted;
                    height: 24px;
                    vertical-alignment: top;
                }
                Rectangle {
                    height: lignes.preferred-height;
                    lignes := VerticalLayout {
                        x: -root.retrait-ligne;
                        width: parent.width + 2 * root.retrait-ligne;
                        for item in root.next: TimeRow {
                            time: item.meta;
                            title: item.title;
                            detail: item.hint;
                            task: item.id > 0;
                            tint: item.color;
                            done: item.done;
                            late: item.overdue;
                            past: item.past;
                            clicked => {
                                if (item.id > 0) {
                                    root.task-opened(item.id);
                                } else {
                                    root.event-opened(item.key);
                                }
                            }
                            toggled => { root.task-toggled(item.id); }
                        }
                    }
                }
            }

            Rectangle {
                height: 40px + 26px;
                HorizontalLayout {
                    x: -root.retrait-lien;
                    y: 40px;
                    height: 26px;
                    spacing: 4px;
                    alignment: start;
                    Link {
                        text: "Mail";
                        count: root.mail-count;
                        label: "Open Mail";
                        font-size: 13px;
                        clicked => { root.opened("mail"); }
                    }
                    Link {
                        text: "Tasks";
                        count: root.tasks-count;
                        label: "Open Tasks";
                        font-size: 13px;
                        clicked => { root.opened("tasks"); }
                    }
                    Link {
                        text: "Calendar";
                        count: root.events-count;
                        label: "Open Calendar";
                        font-size: 13px;
                        clicked => { root.opened("calendar"); }
                    }
                }
            }
        }
    }
}
