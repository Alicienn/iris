import { Tokens } from "@iris/theme/tokens.slint";
import { Layout } from "@iris/theme/layout.slint";
import { Icon, Icons, IconButton } from "@iris/base/icons.slint";
import { Avatar } from "@iris/base/atoms.slint";
import { Check } from "@iris/controls/choice.slint";
import { Button, ButtonKind, ButtonSize } from "@iris/controls/button.slint";
import { ScrollView } from "@iris/controls/scroll.slint";
import { HomeItemData, GoalData, AccountRowData, HabitData } from "@iris/types.slint";
import { Chrome, WindowToolbar } from "@iris/shell/chrome.slint";

// Home, the cockpit (7.6.0, the web edition's proposal B): every part of Iris in one
// glance. On a PC two bands of plates — the mail by mailbox, today's agenda, the
// tasks; then the habits' last eight days, the goals, the notes and the week — and on
// a phone the same plates one under the other. Each title's link opens the place it
// sums up, each line what it names.

/// A small rounded label: "20 min", "1 d", "12 days".
component Badge inherits Rectangle {
    in property <string> text;
    in property <color> tint: Tokens.accent;
    /// The quiet grey, for a count that asks for nothing.
    in property <bool> quiet;
    height: 22px;
    width: mot.preferred-width + 16px;
    border-radius: 11px;
    background: root.quiet ? Tokens.surface-active : root.tint.transparentize(0.88);
    mot := Text {
        text: root.text;
        font-size: 11.5px;
        font-weight: 600;
        color: root.quiet ? Tokens.text-secondary : root.tint;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

/// A plate: its title, a count beside it, a link, a pill or a figure at its right, what
/// it holds below.
component Panel inherits Rectangle {
    in property <string> title;
    in property <string> count;
    in property <string> link;
    /// What a screen reader says of the link: "Open Calendar".
    in property <string> link-label: root.link;
    in property <string> pill;
    in property <color> pill-tint: Tokens.text-secondary;
    /// The pill on the soft ground of its colour rather than the quiet grey.
    in property <bool> pill-tinted;
    /// A figure at the right end: "61".
    in property <string> trailing;
    callback link-clicked();

    border-radius: Tokens.radius-large;
    border-width: 1px;
    border-color: Tokens.border;
    background: Tokens.panel;
    clip: true;

    VerticalLayout {
        padding-bottom: 6px;
        spacing: 0px;
        HorizontalLayout {
            height: 40px;
            padding-left: 14px;
            padding-right: 14px;
            spacing: 8px;
            Text {
                text: root.title;
                font-size: 13px;
                font-weight: 600;
                color: Tokens.text;
                vertical-alignment: center;
            }
            if root.count != "": Text {
                text: root.count;
                font-size: 12px;
                color: Tokens.text-muted;
                vertical-alignment: center;
            }
            Rectangle { horizontal-stretch: 1; }
            if root.link != "": Rectangle {
                width: lien.preferred-width;
                accessible-role: button;
                accessible-label: root.link-label;
                accessible-action-default => { root.link-clicked(); }
                lien := Text {
                    text: root.link;
                    font-size: 12px;
                    font-weight: 500;
                    color: lien-touch.has-hover ? Tokens.accent.darker(0.15) : Tokens.accent;
                    vertical-alignment: center;
                }
                lien-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.link-clicked(); }
                }
            }
            if root.pill != "": Badge {
                y: (parent.height - self.height) / 2;
                text: root.pill;
                tint: root.pill-tint;
                quiet: !root.pill-tinted;
            }
            if root.trailing != "": Text {
                text: root.trailing;
                font-size: 12px;
                font-weight: 600;
                color: Tokens.text-muted;
                vertical-alignment: center;
            }
        }
        @children
    }
}

/// A line of a plate: the pointer's plate under it, a click opens what it names. What
/// it holds sits in a layout as tall as the row (the elements centre themselves by
/// `y` against it).
component Row inherits Rectangle {
    in property <length> row-height: 30px;
    in property <string> label;
    callback clicked();
    height: root.row-height;
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { root.clicked(); }

    Rectangle {
        x: 6px;
        width: parent.width - 12px;
        border-radius: Tokens.radius-small;
        background: touch.has-hover ? Tokens.surface-hover : transparent;
    }
    // Under what the row holds: a tick keeps its own click.
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    HorizontalLayout {
        y: 0px;
        height: parent.height;
        padding-left: 14px;
        padding-right: 14px;
        spacing: 9px;
        @children
    }
}

/// A hairline across a plate, inset from its sides.
component Rule inherits Rectangle {
    height: 13px;
    Rectangle {
        x: 14px;
        y: 6px;
        width: parent.width - 28px;
        height: 1px;
        background: Tokens.border;
    }
}

/// Where the day stands in the agenda: the hour, and a line in the accent.
component NowLine inherits Rectangle {
    in property <string> label;
    height: 14px;
    Text {
        x: 14px;
        width: 44px;
        height: parent.height;
        text: root.label;
        font-size: 11px;
        font-weight: 600;
        color: Tokens.accent;
        vertical-alignment: center;
    }
    Rectangle {
        x: 64px;
        y: (parent.height - self.height) / 2;
        width: parent.width - 78px;
        height: 2px;
        border-radius: 1px;
        background: Tokens.accent;
    }
}

/// A task's line: its tick, its title, the hour or how late it is.
component TaskRow inherits Row {
    in property <HomeItemData> task;
    callback toggled(int);
    label: root.task.title;
    Check {
        y: (parent.height - self.height) / 2;
        animated: true;
        size: 16px;
        late: root.task.overdue;
        label: root.task.title;
        toggled => { root.toggled(root.task.id); }
    }
    Text {
        text: root.task.title;
        font-size: 13px;
        color: Tokens.text;
        vertical-alignment: center;
        overflow: elide;
        horizontal-stretch: 1;
    }
    if root.task.overdue: Badge {
        y: (parent.height - self.height) / 2;
        text: root.task.hint;
        tint: Tokens.error;
    }
    if !root.task.overdue: Text {
        text: root.task.meta;
        font-size: 12px;
        color: Tokens.text-muted;
        vertical-alignment: center;
    }
}

/// "Nothing due today.": what a plate says when it holds nothing.
component Empty inherits HorizontalLayout {
    in property <string> text;
    padding-left: 14px;
    padding-right: 14px;
    height: 30px;
    Text {
        text: root.text;
        font-size: 12.5px;
        color: Tokens.text-muted;
        vertical-alignment: center;
    }
}

export component HomeView inherits Rectangle {
    in property <string> greeting;
    in property <string> date;
    /// The toolbar's: "Monday 2 November · 10:40".
    in property <string> date-line;
    in property <string> summary;
    in property <[HomeItemData]> next;
    in property <string> mail-count;
    in property <string> tasks-count;
    in property <string> events-count;
    in property <[HomeItemData]> later;
    in property <[HomeItemData]> tasks;
    in property <int> tasks-more;
    /// The conversations at the top of To do: who (`title`), about what (`hint`), when
    /// (`meta`), their initials (`key`) on their colour.
    in property <[HomeItemData]> threads;
    in property <int> waiting;
    in property <GoalData> goal;
    in property <bool> has-goal;
    in property <int> week-done;
    in property <[float]> week-bars;
    in property <int> week-today;
    in property <int> streak;
    in property <[HabitData]> habits;
    in property <string> habits-figure;
    in property <string> habits-foot;
    callback habit-toggled(int);
    callback habit-opened(int);
    in property <[AccountRowData]> accounts;
    in property <string> last-sync;
    in property <[HomeItemData]> notes;
    in property <int> cards-due;
    callback note-opened(string);

    /// The mailboxes with something to do (or a problem), most first, and the largest
    /// count, which fills a meter; "4 mailboxes".
    in property <[AccountRowData]> mail-boxes;
    in property <int> mail-max;
    in property <string> mail-label;
    /// Today's events in order: the hour (`meta`), how long or how soon (`hint`), over
    /// already (`past`), under way or soon (`now`, the soon in a pill).
    in property <[HomeItemData]> agenda;
    /// Where the line of the present hour goes among them; -1 for none.
    in property <int> agenda-now: -1;
    in property <string> now-label;
    /// The first event of the next day with one, under a hairline (none or one).
    in property <[HomeItemData]> agenda-after;
    in property <string> agenda-label;
    in property <[HomeItemData]> tasks-tomorrow;
    in property <string> tasks-label;
    in property <string> tasks-foot-left;
    in property <string> tasks-foot-right;
    /// The habits over the last eight days, today last; the days' initials.
    in property <[HabitData]> habit-grid;
    in property <[string]> habit-days;
    in property <string> habits-streak;
    in property <[GoalData]> goals;

    callback opened(string);
    callback account-opened(int);
    callback task-opened(int);
    callback task-toggled(int);
    callback event-opened(string);
    callback thread-opened(int);
    callback goal-opened(int);
    callback join(string);
    callback compose();

    property <[string]> initiales: ["M", "T", "W", "T", "F", "S", "S"];

    background: Tokens.background;

    VerticalLayout {
        WindowToolbar {
            hairline: false;
            background: Tokens.background;
            Text {
                text: "Home";
                font-family: Tokens.font-display;
                font-size: Layout.compact ? 24px : 20px;
                font-weight: 600;
                color: Tokens.text;
                vertical-alignment: center;
            }
            if !Layout.compact: Text {
                text: root.date-line;
                font-size: 12px;
                color: Tokens.text-muted;
                vertical-alignment: center;
            }
            Rectangle { horizontal-stretch: 1; }
            // The palette, as a field: one click searches mail, events, tasks and notes
            // or runs a command.
            if !Layout.compact: Rectangle {
                y: (parent.height - self.height) / 2;
                width: 330px;
                height: 32px;
                border-radius: Tokens.radius-medium;
                border-width: 1px;
                border-color: recherche.has-hover ? Tokens.border-strong : Tokens.border;
                background: Tokens.panel;
                accessible-role: button;
                accessible-label: "Search or run a command";
                accessible-action-default => { Chrome.palette(); }
                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 6px;
                    spacing: 8px;
                    Icon {
                        y: (parent.height - self.height) / 2;
                        data: Icons.search;
                        size: 14px;
                        tint: Tokens.text-muted;
                    }
                    Text {
                        text: "Search or run a command";
                        font-size: 13px;
                        color: Tokens.text-muted;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                        overflow: elide;
                    }
                    Rectangle {
                        y: (parent.height - self.height) / 2;
                        width: touche.preferred-width + 10px;
                        height: 20px;
                        border-radius: 4px;
                        border-width: 1px;
                        border-color: Tokens.border;
                        touche := Text {
                            text: "Ctrl K";
                            font-size: 10.5px;
                            font-weight: 600;
                            color: Tokens.text-muted;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
                recherche := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { Chrome.palette(); }
                }
            }
            if !Layout.compact: Button {
                y: (parent.height - self.height) / 2;
                text: "New";
                label: "New message";
                kind: ButtonKind.primary;
                clicked => { root.compose(); }
            }
            if Layout.compact: IconButton {
                y: (parent.height - self.height) / 2;
                icon: Icons.search;
                label: "Search";
                button-size: 44px;
                icon-size: 22px;
                clicked => { Chrome.palette(); }
            }
            if Layout.compact: IconButton {
                y: (parent.height - self.height) / 2;
                icon: Icons.settings;
                label: "Settings";
                button-size: 44px;
                icon-size: 22px;
                clicked => { Chrome.settings(); }
            }
        }

        page := ScrollView {
            vertical-stretch: 1;
            mouse-drag-pan-enabled: false;
            content-width: self.visible-width;

            // The plates' places. On a PC: a middle band as tall as the window allows,
            // a lower band of 214 pixels; on a phone, one under the other.
            property <length> marge: Layout.compact ? 18px : 20px;
            property <length> l: self.visible-width - 2 * self.marge;
            property <length> gap: 12px;
            property <length> bas: 214px;
            property <length> haut: max(self.visible-height - 22px, 600px) - self.bas - self.gap;
            property <length> colonne: (self.l - 360px - 2 * self.gap) / 2;
            property <length> mi: (self.l - 360px - 236px - 3 * self.gap) / 2;
            // A phone's plates, their heights, and where each one starts.
            property <length> h-mail: 330px;
            property <length> h-today: 380px;
            property <length> h-tasks: 400px;
            property <length> h-habits: 214px;
            property <length> h-goals: 170px;
            property <length> h-notes: 190px;
            property <length> h-week: 200px;
            property <length> y-today: self.h-mail + self.gap;
            property <length> y-tasks: self.y-today + self.h-today + self.gap;
            property <length> y-habits: self.y-tasks + self.h-tasks + self.gap;
            property <length> y-goals: self.y-habits + self.h-habits + self.gap;
            property <length> y-notes: self.y-goals + self.h-goals + self.gap;
            property <length> y-week: self.y-notes + self.h-notes + self.gap;

            VerticalLayout {
                x: page.marge;
                width: page.l;
                padding-top: 4px;
                padding-bottom: 18px;
                alignment: start;

                if Layout.compact: Text {
                    text: root.date-line;
                    font-size: 12px;
                    font-weight: 600;
                    color: Tokens.text-muted;
                }
                if Layout.compact: Rectangle { height: 10px; }

                plateau := Rectangle {
                    height: Layout.compact ? page.y-week + page.h-week : page.haut + page.gap + page.bas;

                    // The mail: each mailbox with something to do, a meter for how
                    // much, then the first conversations of To do.
                    Panel {
                        x: 0px;
                        y: 0px;
                        width: Layout.compact ? page.l : 360px;
                        height: Layout.compact ? page.h-mail : page.haut;
                        title: "Mail";
                        count: root.mail-label;
                        link: "Open";
                        link-label: "Open Mail";
                        link-clicked => { root.opened("mail"); }

                        for a in root.mail-boxes: Row {
                            row-height: 34px;
                            label: a.label + ", " + a.count + " to do";
                            clicked => { root.account-opened(a.id); }
                            Rectangle {
                                y: (parent.height - self.height) / 2;
                                width: 8px;
                                height: 8px;
                                border-radius: 4px;
                                background: a.tint;
                            }
                            Text {
                                text: a.label;
                                font-size: 13px;
                                color: Tokens.text;
                                vertical-alignment: center;
                                overflow: elide;
                                horizontal-stretch: 1;
                            }
                            // A mailbox that stopped syncing says so, and why when
                            // pointed at.
                            if a.needs-attention: Rectangle {
                                width: 14px;
                                Icon {
                                    data: Icons.exclamation;
                                    size: 14px;
                                    tint: Tokens.error;
                                }
                                Tooltip {
                                    text: @markdown("\{a.problem}");
                                }
                            }
                            Rectangle {
                                y: (parent.height - self.height) / 2;
                                width: 64px;
                                height: 4px;
                                border-radius: 2px;
                                background: Tokens.surface-active;
                                Rectangle {
                                    x: 0px;
                                    width: root.mail-max > 0 ? parent.width * a.count / root.mail-max : 0px;
                                    height: parent.height;
                                    border-radius: 2px;
                                    background: a.tint;
                                }
                            }
                            Text {
                                width: 22px;
                                text: a.count;
                                font-size: 12.5px;
                                font-weight: 600;
                                color: Tokens.text;
                                horizontal-alignment: right;
                                vertical-alignment: center;
                            }
                        }
                        if root.mail-boxes.length == 0: Empty { text: "Nothing to do in any mailbox."; }
                        if root.threads.length > 0: Rule {}
                        for m in root.threads: Row {
                            label: m.title + ", " + m.hint;
                            clicked => { root.thread-opened(m.id); }
                            Avatar {
                                y: (parent.height - self.height) / 2;
                                size: 22px;
                                initials: m.key;
                                tint: m.color;
                            }
                            Text {
                                width: 96px;
                                text: m.title;
                                font-size: 12.5px;
                                font-weight: 600;
                                color: Tokens.text;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                            Text {
                                text: m.hint;
                                font-size: 12px;
                                color: Tokens.text-secondary;
                                vertical-alignment: center;
                                overflow: elide;
                                horizontal-stretch: 1;
                            }
                            Text {
                                text: m.meta;
                                font-size: 12px;
                                color: Tokens.text-muted;
                                vertical-alignment: center;
                            }
                        }
                        Rectangle { vertical-stretch: 1; }
                        if root.waiting > 0: Empty {
                            text: root.waiting == 1 ? "1 waiting for an answer" : root.waiting + " waiting for an answer";
                        }
                    }

                    // Today: the events in order, the present hour as a line among
                    // them, what is over dimmed; the next day's first under a hairline.
                    Panel {
                        x: Layout.compact ? 0px : 360px + page.gap;
                        y: Layout.compact ? page.y-today : 0px;
                        width: Layout.compact ? page.l : page.colonne;
                        height: Layout.compact ? page.h-today : page.haut;
                        title: "Today";
                        count: root.agenda-label;
                        link: "Calendar";
                        link-label: "Open Calendar";
                        link-clicked => { root.opened("calendar"); }

                        for e[i] in root.agenda: VerticalLayout {
                            if i == root.agenda-now: NowLine { label: root.now-label; }
                            Row {
                                row-height: 34px;
                                label: e.meta + " " + e.title;
                                clicked => { root.event-opened(e.key); }
                                Text {
                                    width: 40px;
                                    text: e.meta;
                                    font-size: 12px;
                                    font-weight: 500;
                                    color: e.past ? Tokens.text-faint : Tokens.text-muted;
                                    vertical-alignment: center;
                                }
                                Rectangle {
                                    y: (parent.height - self.height) / 2;
                                    width: 3px;
                                    height: 22px;
                                    border-radius: 2px;
                                    background: e.past ? e.color.transparentize(0.5) : e.color;
                                }
                                Text {
                                    text: e.title;
                                    font-size: 13px;
                                    font-weight: e.now ? 600 : 400;
                                    color: e.past ? Tokens.text-muted : Tokens.text;
                                    vertical-alignment: center;
                                    overflow: elide;
                                    horizontal-stretch: 1;
                                }
                                // Held on a video call: one click joins it.
                                if e.video-url != "" && !e.past: IconButton {
                                    y: (parent.height - self.height) / 2;
                                    icon: Icons.video;
                                    label: e.video-label;
                                    button-size: 24px;
                                    icon-size: 15px;
                                    clicked => { root.join(e.video-url); }
                                }
                                if e.now: Badge {
                                    y: (parent.height - self.height) / 2;
                                    text: e.hint;
                                }
                                if !e.now: Text {
                                    text: e.hint;
                                    font-size: 12px;
                                    color: Tokens.text-muted;
                                    vertical-alignment: center;
                                }
                            }
                        }
                        if root.agenda.length > 0 && root.agenda-now == root.agenda.length: NowLine {
                            label: root.now-label;
                        }
                        if root.agenda.length == 0: Empty { text: "Nothing in the calendar today."; }
                        Rectangle { vertical-stretch: 1; }
                        for e in root.agenda-after: VerticalLayout {
                            Rule {}
                            Row {
                                row-height: 34px;
                                label: e.title;
                                clicked => { root.event-opened(e.key); }
                                Text {
                                    width: 40px;
                                    text: e.meta;
                                    font-size: 12px;
                                    color: Tokens.text-faint;
                                    vertical-alignment: center;
                                }
                                Rectangle {
                                    y: (parent.height - self.height) / 2;
                                    width: 3px;
                                    height: 22px;
                                    border-radius: 2px;
                                    background: e.color;
                                }
                                Text {
                                    text: e.title;
                                    font-size: 12px;
                                    color: Tokens.text-secondary;
                                    vertical-alignment: center;
                                    overflow: elide;
                                    horizontal-stretch: 1;
                                }
                            }
                        }
                    }

                    // The tasks: late first with how late, today's by the hour, then
                    // tomorrow's; what has no date and the week's load at the foot.
                    Panel {
                        x: Layout.compact ? 0px : 360px + page.colonne + 2 * page.gap;
                        y: Layout.compact ? page.y-tasks : 0px;
                        width: Layout.compact ? page.l : page.colonne;
                        height: Layout.compact ? page.h-tasks : page.haut;
                        title: "Tasks";
                        count: root.tasks-label;
                        link: "Tasks";
                        link-label: "Open Tasks";
                        link-clicked => { root.opened("tasks"); }

                        for t in root.tasks: TaskRow {
                            task: t;
                            clicked => { root.task-opened(t.id); }
                            toggled(id) => { root.task-toggled(id); }
                        }
                        if root.tasks.length == 0: Empty { text: "Nothing due today."; }
                        if root.tasks-tomorrow.length > 0: HorizontalLayout {
                            padding-left: 14px;
                            padding-top: 8px;
                            padding-bottom: 2px;
                            Text {
                                text: "Tomorrow";
                                font-size: 12px;
                                font-weight: 600;
                                color: Tokens.text-muted;
                            }
                        }
                        for t in root.tasks-tomorrow: TaskRow {
                            task: t;
                            clicked => { root.task-opened(t.id); }
                            toggled(id) => { root.task-toggled(id); }
                        }
                        Rectangle { vertical-stretch: 1; }
                        Rule {}
                        HorizontalLayout {
                            height: 26px;
                            padding-left: 14px;
                            padding-right: 14px;
                            Text {
                                text: root.tasks-foot-left;
                                font-size: 12px;
                                color: Tokens.text-muted;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                            }
                            Text {
                                text: root.tasks-foot-right;
                                font-size: 12px;
                                color: Tokens.text-muted;
                                vertical-alignment: center;
                            }
                        }
                    }

                    // The habits over the last eight days, today last: a square a day,
                    // today's an outline until it is kept (a click keeps it).
                    Panel {
                        x: 0px;
                        y: Layout.compact ? page.y-habits : page.haut + page.gap;
                        width: Layout.compact ? page.l : 360px;
                        height: page.bas;
                        title: "Habits";
                        count: "Last 8 days";
                        pill: root.habits-streak;
                        pill-tint: Tokens.green;
                        pill-tinted: true;
                        link-clicked => { root.opened("habits"); }

                        if root.habit-grid.length > 0: HorizontalLayout {
                            height: 22px;
                            padding-left: 14px;
                            padding-right: 14px;
                            spacing: 5px;
                            Rectangle { width: 128px; }
                            for d[i] in root.habit-days: Text {
                                width: 18px;
                                text: d;
                                font-size: 10.5px;
                                font-weight: i == root.habit-days.length - 1 ? 700 : 500;
                                color: i == root.habit-days.length - 1 ? Tokens.accent : Tokens.text-faint;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                        for h in root.habit-grid: HorizontalLayout {
                            height: 30px;
                            padding-left: 14px;
                            padding-right: 14px;
                            spacing: 5px;
                            Rectangle {
                                width: 128px;
                                accessible-role: button;
                                accessible-label: h.title;
                                accessible-action-default => { root.habit-opened(h.id); }
                                Text {
                                    width: parent.width - 6px;
                                    height: parent.height;
                                    text: h.title;
                                    font-size: 12.5px;
                                    color: nom.has-hover ? Tokens.accent : Tokens.text;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                                nom := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.habit-opened(h.id); }
                                }
                            }
                            for c[i] in h.cells: Rectangle {
                                property <bool> today: i == h.cells.length - 1;
                                y: (parent.height - self.height) / 2;
                                width: 18px;
                                height: 18px;
                                border-radius: 5px;
                                // 0 missed, 1 done, 2 partial, 3 rest, 4 today to do,
                                // 5 to come, 6 before the habit.
                                background: c.state == 1 ? Tokens.green
                                    : c.state == 2 ? Tokens.green.transparentize(0.6)
                                    : c.state == 0 ? Tokens.surface-active
                                    : c.state == 3 ? Tokens.surface-active.transparentize(0.5)
                                    : transparent;
                                border-width: c.state == 4 ? 1.5px : c.state == 5 ? 1px : 0px;
                                border-color: c.state == 4 ? Tokens.green : Tokens.border;
                                // Today's square ticks the habit; the others only say.
                                if i == h.cells.length - 1: Rectangle {
                                    accessible-role: checkbox;
                                    accessible-label: c.label;
                                    accessible-checked: c.state == 1;
                                    accessible-action-default => { root.habit-toggled(h.id); }
                                    TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { root.habit-toggled(h.id); }
                                    }
                                }
                            }
                        }
                        if root.habit-grid.length == 0: Empty { text: "No habit yet."; }
                    }

                    // The goals under way: where each one stands, a bar in its colour.
                    Panel {
                        x: Layout.compact ? 0px : 360px + page.gap;
                        y: Layout.compact ? page.y-goals : page.haut + page.gap;
                        width: Layout.compact ? page.l : page.mi;
                        height: Layout.compact ? page.h-goals : page.bas;
                        title: "Goals";
                        link: "All goals";
                        link-clicked => { root.opened("goals"); }

                        for g in root.goals: Rectangle {
                            height: 44px;
                            accessible-role: button;
                            accessible-label: g.title;
                            accessible-description: g.done + " of " + g.target;
                            accessible-action-default => { root.goal-opened(g.id); }
                            but := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.goal-opened(g.id); }
                            }
                            VerticalLayout {
                                padding-left: 14px;
                                padding-right: 14px;
                                padding-top: 7px;
                                padding-bottom: 9px;
                                spacing: 7px;
                                HorizontalLayout {
                                    Text {
                                        text: g.title;
                                        font-size: 13px;
                                        color: but.has-hover ? Tokens.accent : Tokens.text;
                                        overflow: elide;
                                        horizontal-stretch: 1;
                                    }
                                    Text {
                                        text: g.milestones || g.target != 100
                                            ? g.done + " of " + g.target + (g.due-short != "" ? " · " + g.due-short : "")
                                            : g.done + " %";
                                        font-size: 12px;
                                        color: Tokens.text-muted;
                                    }
                                }
                                Rectangle {
                                    height: 6px;
                                    border-radius: 3px;
                                    background: Tokens.surface-active;
                                    Rectangle {
                                        x: 0px;
                                        width: parent.width * clamp(g.fraction, 0, 1);
                                        height: parent.height;
                                        border-radius: 3px;
                                        background: g.color;
                                    }
                                }
                            }
                        }
                        if root.goals.length == 0: Empty { text: "No goal under way."; }
                    }

                    // The notes written last, and the flashcards due.
                    Panel {
                        x: Layout.compact ? 0px : 360px + page.mi + 2 * page.gap;
                        y: Layout.compact ? page.y-notes : page.haut + page.gap;
                        width: Layout.compact ? page.l : page.mi;
                        height: Layout.compact ? page.h-notes : page.bas;
                        title: "Notes";
                        pill: root.cards-due == 0 ? "" : root.cards-due == 1 ? "1 card due" : root.cards-due + " cards due";
                        link-clicked => { root.opened("notes"); }

                        for n in root.notes: Row {
                            label: n.title;
                            clicked => { root.note-opened(n.key); }
                            Icon {
                                y: (parent.height - self.height) / 2;
                                data: Icons.notes;
                                size: 14px;
                                tint: Tokens.text-muted;
                            }
                            Text {
                                text: n.title;
                                font-size: 13px;
                                color: Tokens.text;
                                vertical-alignment: center;
                                overflow: elide;
                                horizontal-stretch: 1;
                            }
                            Text {
                                text: n.meta;
                                font-size: 12px;
                                color: Tokens.text-muted;
                                vertical-alignment: center;
                            }
                        }
                        if root.notes.length == 0: Empty { text: "No note yet."; }
                    }

                    // The week: tasks done, a bar a day, today's in the accent.
                    Panel {
                        x: Layout.compact ? 0px : page.l - 236px;
                        y: Layout.compact ? page.y-week : page.haut + page.gap;
                        width: Layout.compact ? page.l : 236px;
                        height: Layout.compact ? page.h-week : page.bas;
                        title: "Done this week";
                        trailing: root.week-done;

                        HorizontalLayout {
                            vertical-stretch: 1;
                            padding-left: 14px;
                            padding-right: 14px;
                            padding-top: 6px;
                            padding-bottom: 6px;
                            spacing: 8px;
                            accessible-role: text;
                            accessible-label: root.week-done + " done this week";
                            for part[i] in root.week-bars: VerticalLayout {
                                spacing: 6px;
                                Rectangle {
                                    vertical-stretch: 1;
                                    Rectangle {
                                        x: (parent.width - self.width) / 2;
                                        y: parent.height - self.height;
                                        width: min(18px, parent.width);
                                        height: max(4px, parent.height * part);
                                        border-radius: 4px;
                                        background: i == root.week-today ? Tokens.accent : Tokens.accent.transparentize(0.65);
                                    }
                                }
                                Text {
                                    text: root.initiales[i];
                                    font-size: 10.5px;
                                    font-weight: i == root.week-today ? 700 : 500;
                                    color: i == root.week-today ? Tokens.accent : Tokens.text-muted;
                                    horizontal-alignment: center;
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
