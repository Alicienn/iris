import { Tokens } from "@iris/theme/tokens.slint";
import { TextField } from "@iris/controls/field.slint";
import { RuleRowData } from "@iris/types.slint";
import { Modal } from "@iris/layout/frames.slint";
import { ListView } from "std-widgets.slint";
import { CheckBox } from "@iris/controls/pickers.slint";
import { Button, ButtonKind, ButtonSize } from "@iris/controls/button.slint";
import { SectionTitle } from "@iris/lists/nav.slint";

// One rule in the list.
//
// The summary is the point of this row. A rule you cannot read at a glance is a rule
// you stop trusting, and a rule you stop trusting you disable — so the list shows what
// each one does in words rather than a name and an icon.
component RuleRow inherits Rectangle {
    in property <RuleRowData> rule;

    callback toggled(bool);
    callback simulate();
    callback removed();

    height: 62px;
    border-radius: Tokens.radius-small;
    background: touch.has-hover ? Tokens.surface-hover : transparent;
    animate background { duration: Tokens.instant; }

    accessible-role: list-item;
    accessible-label: root.rule.name;
    accessible-description: root.rule.summary;

    touch := TouchArea {}

    HorizontalLayout {
        padding: Tokens.space-2;
        spacing: Tokens.space-2;

        CheckBox {
            checked: root.rule.enabled;
            accessible-label: "Enable " + root.rule.name;
            toggled => { root.toggled(self.checked); }
        }

        VerticalLayout {
            spacing: 2px;

            Text {
                text: root.rule.name;
                font-size: Tokens.size-body;
                font-weight: Tokens.weight-bold;
                color: root.rule.enabled ? Tokens.text : Tokens.text-muted;
                overflow: elide;
            }
            Text {
                text: root.rule.summary;
                font-size: Tokens.size-small;
                color: Tokens.text-secondary;
                overflow: elide;
            }
            Text {
                text: root.rule.applied == 0
                    ? "Has not acted yet"
                    : root.rule.applied + " message(s) so far";
                font-size: Tokens.size-small;
                color: Tokens.text-muted;
            }
        }

        Button {
            y: (parent.height - self.height) / 2;
            text: "Try it";
            size: ButtonSize.sm;
            clicked => { root.simulate(); }
        }
        Button {
            y: (parent.height - self.height) / 2;
            text: "Delete";
            kind: ButtonKind.ghost;
            size: ButtonSize.sm;
            clicked => { root.removed(); }
        }
    }
}

// The rules window: what acts on your mail without you.
//
// VIP, Office hours and Filer are in Settings, beside the rest of the mail's
// automations; here are the rules people write themselves.
export component ModulesPanel inherits Rectangle {
    in property <[RuleRowData]> rules;
    // Result of the last dry run, if any.
    in property <string> simulation;
    in-out property <string> new-rule-name;
    in-out property <string> new-rule-sender;

    callback rule-toggled(string, bool);
    callback rule-simulated(string);
    callback rule-removed(string);
    callback rule-added();
    callback dismissed();

    Modal {
        width: 100%;
        height: 100%;
        title: "Rules";
        card-width: 680px;
        card-height: 640px;
        dismissed => { root.dismissed(); }

        VerticalLayout {
            spacing: Tokens.space-3;

            SectionTitle { text: "Rules"; }

            // Creating a rule is deliberately one line: sender and a name. Anything
            // richer belongs in an editor, and an editor nobody opens is worse than a
            // single field people actually use.
            HorizontalLayout {
                spacing: Tokens.space-2;

                TextField {
                    accessible-label: "Rule name";
                    placeholder-text: "Rule name";
                    font-size: Tokens.size-small;
                    text <=> root.new-rule-name;
                }
                TextField {
                    accessible-label: "From sender or domain";
                    placeholder-text: "from sender or domain";
                    font-size: Tokens.size-small;
                    text <=> root.new-rule-sender;
                    accepted => { root.rule-added(); }
                }
                Button {
                    y: (parent.height - self.height) / 2;
                    text: "Add rule";
                    size: ButtonSize.sm;
                    clicked => { root.rule-added(); }
                }
            }

            if root.simulation != "": Text {
                text: root.simulation;
                font-size: Tokens.size-small;
                color: Tokens.text-secondary;
                wrap: word-wrap;
            }

            if root.rules.length == 0: Text {
                text: "No rules yet. A rule acts on mail as it arrives.";
                font-size: Tokens.size-small;
                color: Tokens.text-muted;
            }

            if root.rules.length > 0: ListView {
                vertical-stretch: 1;
                for rule in root.rules: RuleRow {
                    rule: rule;
                    toggled(on) => { root.rule-toggled(rule.id, on); }
                    simulate => { root.rule-simulated(rule.id); }
                    removed => { root.rule-removed(rule.id); }
                }
            }

            if root.rules.length == 0: Rectangle { vertical-stretch: 1; }
        }
    }
}
