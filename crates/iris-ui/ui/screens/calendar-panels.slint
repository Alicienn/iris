import { Tokens } from "@iris/theme/tokens.slint";
import { Layout } from "@iris/theme/layout.slint";
import { Floating } from "@iris/base/glass.slint";
import { Icon, Icons, IconButton } from "@iris/base/icons.slint";
import { TextField, TextArea } from "@iris/controls/field.slint";
import { EventDetailData, CalendarData, MonthCellData, SubtaskData } from "@iris/types.slint";
import { CalButton, MiniMonth } from "@iris/screens/calendar.slint";
import { MenuEntry, MenuHeader, MenuSeparator, MenuSurface } from "@iris/layout/menu.slint";
import { CheckBox, ComboBox } from "@iris/controls/pickers.slint";
import { Modal, ModalKind, Popover } from "@iris/layout/frames.slint";
import { Button, ButtonKind, ButtonSize, Link, BlockButton } from "@iris/controls/button.slint";
import { Check, Toggle } from "@iris/controls/choice.slint";
import { JoinButton } from "@iris/controls/video.slint";
import { ScrollView } from "@iris/controls/scroll.slint";
import { CalPill } from "@iris/screens/calendar-phone.slint";

// The frame of the calendar's, the tasks' and the tags' windows: the shared modal.
export component PanelFrame inherits Modal {}

// A label above a field.
export component Labelled inherits VerticalLayout {
    in property <string> label;
    spacing: 3px;
    vertical-stretch: 0;
    Text {
        text: root.label;
        font-size: 10px;
        color: Tokens.text-muted;
    }
    @children
}

// A task of an event: ticked here, opened in Tasks.
component EventTaskRow inherits Rectangle {
    in property <SubtaskData> task;
    callback toggled(int);
    callback opened(int);

    height: 28px;
    border-radius: Tokens.radius-small;
    background: ligne.has-hover ? Tokens.surface-hover : transparent;

    ligne := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.opened(root.task.id); }
    }

    HorizontalLayout {
        padding-left: 4px;
        padding-right: 4px;
        spacing: Tokens.space-2;
        Check {
            y: (parent.height - self.height) / 2;
            animated: true;
            size: 16px;
            done: root.task.done;
            label: root.task.title;
            toggled => { root.toggled(root.task.id); }
        }
        Text {
            text: root.task.title;
            font-size: 13px;
            color: root.task.done ? Tokens.text-muted : Tokens.text;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }
        if ligne.has-hover: Text {
            text: "Open in Tasks";
            font-size: Tokens.size-small;
            color: Tokens.text-muted;
            vertical-alignment: center;
        }
    }
}

// A line of the event's card: an icon, the words, a quieter note after them.
component FactRow inherits HorizontalLayout {
    in property <string> icon;
    in property <string> text;
    in property <string> note;
    spacing: 10px;
    Icon {
        y: 2px;
        data: root.icon;
        size: 14px;
        tint: Tokens.text-muted;
    }
    Text {
        text: root.text;
        font-size: 13px;
        color: Tokens.text;
        wrap: word-wrap;
        horizontal-stretch: 1;
    }
    if root.note != "": Text {
        text: root.note;
        font-size: 12px;
        color: Tokens.text-muted;
    }
}

// What the card says of an event, beside it or in the middle of the window.
component EventBody inherits VerticalLayout {
    in property <EventDetailData> detail;
    in-out property <string> notes;
    in property <[SubtaskData]> tasks;
    in-out property <string> new-task;
    callback notes-edited(string);
    callback task-added(string);
    callback task-toggled(int);
    callback task-opened(int);
    callback edit();
    callback delete();
    callback dismissed();
    /// Its video call opened in the browser (or its app).
    callback join(string);
    /// A video call link given to it; empty takes it away.
    callback video-set(string);
    callback take-notes();

    /// The link being typed or changed.
    property <bool> video-editing;
    property <string> video-typed;

    spacing: 12px;

    // Its colour, its title whole (it is often all that says what it is), the way out.
    HorizontalLayout {
        spacing: 10px;
        Rectangle {
            width: 4px;
            border-radius: 2px;
            background: root.detail.color;
        }
        Text {
            text: root.detail.title == "" ? "(No title)" : root.detail.title;
            font-family: Tokens.font-display;
            font-size: 18px;
            font-weight: 600;
            color: Tokens.text;
            wrap: word-wrap;
            horizontal-stretch: 1;
        }
        IconButton {
            icon: Icons.window-close;
            label: "Close";
            shortcut: "Esc";
            button-size: 26px;
            icon-size: 12px;
            clicked => { root.dismissed(); }
        }
    }

    FactRow {
        icon: Icons.clock;
        text: root.detail.when;
        note: root.detail.repeats;
    }
    if root.detail.location != "": FactRow {
        icon: Icons.map-pin;
        text: root.detail.location;
    }

    // Its video call: the service's button, one click to join; and the link, given or
    // changed in place.
    if root.detail.video-url != "" && !root.video-editing: HorizontalLayout {
        spacing: 8px;
        alignment: start;
        JoinButton {
            kind: root.detail.video-kind;
            text: root.detail.video-label;
            clicked => { root.join(root.detail.video-url); }
        }
        Link {
            y: (parent.height - self.height) / 2;
            text: "Change";
            label: "Change the video call link";
            clicked => {
                root.video-typed = root.detail.video-set != "" ? root.detail.video-set : root.detail.video-url;
                root.video-editing = true;
            }
        }
    }
    if root.detail.video-url == "" || root.video-editing: TextField {
        icon: Icons.video;
        accessible-label: "Video call link";
        placeholder-text: "Video call link (Meet, Teams, Zoom…)";
        text <=> root.video-typed;
        accepted(t) => {
            root.video-set(t);
            root.video-editing = false;
        }
    }
    FactRow {
        icon: root.detail.reminder != "" ? Icons.bell : Icons.calendar;
        text: root.detail.reminder != "" ? root.detail.reminder : root.detail.calendar;
        note: root.detail.reminder != "" ? root.detail.calendar : "";
    }

    if root.detail.description != "": Rectangle {
        border-radius: Tokens.radius-medium;
        border-width: 1px;
        border-color: Tokens.border;
        background: Tokens.surface-low;
        height: description.preferred-height + 20px;
        description := Text {
            x: 12px;
            width: parent.width - 24px;
            text: root.detail.description;
            font-size: 12px;
            color: Tokens.text-secondary;
            wrap: word-wrap;
        }
    }

    TextArea {
        height: 64px;
        vertical-stretch: 0;
        accessible-label: "My notes";
        placeholder-text: "My notes, kept on this computer";
        text <=> root.notes;
        edited(t) => { root.notes-edited(t); }
    }

    // What there is to do for it. Each one is a task in Tasks, due when the event
    // starts, and stays there if the calendar goes.
    VerticalLayout {
        spacing: 1px;
        HorizontalLayout {
            height: 22px;
            spacing: 8px;
            Text {
                text: "Tasks";
                font-size: 12px;
                font-weight: 600;
                color: Tokens.text-secondary;
                vertical-alignment: center;
            }
            Text {
                text: root.tasks.length > 0 ? root.tasks.length : "";
                font-size: 12px;
                color: Tokens.text-muted;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
        }
        for t in root.tasks: EventTaskRow {
            task: t;
            toggled(id) => { root.task-toggled(id); }
            opened(id) => { root.task-opened(id); }
        }
        TextField {
            icon: Icons.plus;
            bare: true;
            accessible-label: "Add a task for this event";
            placeholder-text: "Add a task";
            text <=> root.new-task;
            accepted(t) => {
                if (t != "") {
                    root.task-added(t);
                }
            }
        }
    }

    HorizontalLayout {
        height: 30px;
        spacing: 8px;
        if !root.detail.editable: Text {
            text: "From a subscribed calendar: read only.";
            font-size: 12px;
            color: Tokens.text-muted;
            vertical-alignment: center;
        }
        if root.detail.editable: Button {
            text: "Delete";
            icon: Icons.trash;
            size: ButtonSize.sm;
            clicked => { root.delete(); }
        }
        Rectangle { horizontal-stretch: 1; }
        // A note for this event: a lecture's, a meeting's; opened again later.
        Button {
            text: "Notes";
            icon: Icons.notes;
            size: ButtonSize.sm;
            clicked => { root.take-notes(); }
        }
        if root.detail.editable: Button {
            text: "Edit";
            icon: Icons.pencil;
            kind: ButtonKind.primary;
            size: ButtonSize.sm;
            clicked => { root.edit(); }
        }
    }
}

// A line of a phone's sheet or page (`.li.flat`): 52 pixels at least, a rule above it
// from the left margin, except on the first.
component PhoneRow inherits Rectangle {
    in property <bool> first;
    in property <length> row-height: 52px;
    /// From the edge of what holds it: a group's sixteen pixels; four in the event's
    /// sheet, whose own margin gives the rest.
    in property <length> inset: 16px;
    /// It answers a touch: a value to pick, a date to open.
    in property <bool> tappable;
    callback clicked();

    height: max(root.row-height, rang.preferred-height + 16px);
    background: root.tappable && touche.pressed ? Tokens.surface-hover : transparent;

    Rectangle {
        visible: !root.first;
        x: root.inset;
        y: 0;
        width: parent.width - root.inset;
        height: 1px;
        background: Tokens.border;
    }
    touche := TouchArea {
        enabled: root.tappable;
        clicked => { root.clicked(); }
    }
    // The row's whole height, no vertical padding: a layout's top padding is written
    // over the `y` of each element in it, and what is passed in measures its centre
    // against this row's height (`parent` is the row), so the two must be the same:
    // inset by eight pixels, the calendar's dot sat eight pixels low.
    rang := HorizontalLayout {
        y: 0px;
        height: parent.height;
        padding-left: root.inset;
        padding-right: root.inset;
        spacing: 14px;
        @children
    }
}

// A section's title on a phone (`.grp-t`): "Tasks for it", "Your notes".
component PhoneGroupTitle inherits Text {
    height: 38px;
    font-size: 13px;
    font-weight: 600;
    color: Tokens.text-muted;
    vertical-alignment: bottom;
}

// A fact of the event on a phone: an icon, the words, a quieter line under them.
component PhoneFact inherits Rectangle {
    in property <bool> first;
    in property <length> inset: 16px;
    in property <string> icon;
    in property <string> text;
    in property <string> note;
    in property <color> dot;
    in property <bool> has-dot;

    height: ligne.height;

    ligne := PhoneRow {
        width: parent.width;
        first: root.first;
        inset: root.inset;
        Icon {
            y: (parent.height - self.height) / 2;
            data: root.icon;
            size: 18px;
            tint: Tokens.text-muted;
        }
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            Text {
                text: root.text;
                font-size: 15.5px;
                color: Tokens.text;
                wrap: word-wrap;
            }
            if root.note != "": Text {
                text: root.note;
                font-size: 13px;
                color: Tokens.text-muted;
                overflow: elide;
            }
        }
        if root.has-dot: Rectangle {
            y: (parent.height - self.height) / 2;
            width: 8px;
            height: 8px;
            border-radius: 4px;
            background: root.dot;
        }
    }
}

// An event on a phone, in its sheet (`calendar.html`, "Un événement"): its colour, its
// title and when, Edit and "⋯"; Join first when it is held on a video call; then its
// repetition, reminder, calendar and place; the tasks for it; your notes; the note of
// the lecture or meeting, and its link.
component PhoneEventBody inherits VerticalLayout {
    in property <EventDetailData> detail;
    in-out property <string> notes;
    in property <[SubtaskData]> tasks;
    in-out property <string> new-task;
    callback notes-edited(string);
    callback task-added(string);
    callback task-toggled(int);
    callback task-opened(int);
    callback edit();
    callback more();
    callback join(string);
    callback video-set(string);
    callback take-notes();
    callback copy-link();

    property <string> video-typed;

    vertical-stretch: 1;
    spacing: 0px;

    HorizontalLayout {
        padding-left: 4px;
        padding-bottom: 4px;
        spacing: 12px;
        Rectangle {
            y: 8px;
            width: 14px;
            height: 14px;
            border-radius: 7px;
            background: root.detail.color;
        }
        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 2px;
            Text {
                text: root.detail.title == "" ? "(No title)" : root.detail.title;
                font-family: Tokens.font-display;
                font-size: 22px;
                font-weight: 600;
                color: Tokens.text;
                wrap: word-wrap;
            }
            Text {
                text: root.detail.when;
                font-size: 15px;
                color: Tokens.text-secondary;
                wrap: word-wrap;
            }
        }
        if root.detail.editable: IconButton {
            icon: Icons.pencil;
            label: "Edit";
            button-size: 44px;
            icon-size: 22px;
            tinted: true;
            tint: Tokens.text-secondary;
            clicked => { root.edit(); }
        }
        IconButton {
            icon: Icons.more;
            label: "More";
            button-size: 44px;
            icon-size: 22px;
            tinted: true;
            tint: Tokens.text-secondary;
            clicked => { root.more(); }
        }
    }

    if root.detail.video-url != "": HorizontalLayout {
        padding-left: 4px;
        padding-right: 4px;
        padding-top: 12px;
        padding-bottom: 12px;
        BlockButton {
            text: root.detail.video-label;
            icon: Icons.video;
            clicked => { root.join(root.detail.video-url); }
        }
    }

    ScrollView {
        vertical-stretch: 1;
        mouse-drag-pan-enabled: true;
        content-width: self.visible-width;
        VerticalLayout {
            alignment: start;
            padding-bottom: 12px;
            if root.detail.repeats != "": PhoneFact {
                inset: 4px;
                first: true;
                icon: Icons.repeat;
                text: root.detail.repeats;
            }
            if root.detail.reminder != "": PhoneFact {
                inset: 4px;
                first: root.detail.repeats == "";
                icon: Icons.bell;
                text: root.detail.reminder;
            }
            PhoneFact {
                inset: 4px;
                first: root.detail.repeats == "" && root.detail.reminder == "";
                icon: Icons.calendar;
                text: root.detail.calendar;
                dot: root.detail.color;
                has-dot: true;
            }
            if root.detail.location != "": PhoneFact {
                inset: 4px;
                icon: Icons.map-pin;
                text: root.detail.location;
            }
            // No call yet: its link given here, and kept.
            if root.detail.video-url == "": PhoneRow {
                inset: 4px;
                Icon {
                    y: (parent.height - self.height) / 2;
                    data: Icons.video;
                    size: 18px;
                    tint: Tokens.text-muted;
                }
                TextField {
                    y: (parent.height - self.height) / 2;
                    horizontal-stretch: 1;
                    bare: true;
                    font-size: 15.5px;
                    accessible-label: "Video call link";
                    placeholder-text: "Video call link";
                    text <=> root.video-typed;
                    accepted(t) => { root.video-set(t); }
                }
            }
            if !root.detail.editable: Text {
                height: 36px;
                x: 4px;
                text: "From a subscribed calendar: read only.";
                font-size: 13px;
                color: Tokens.text-muted;
                vertical-alignment: center;
            }

            if root.detail.description != "": Rectangle {
                height: description.preferred-height + 24px;
                Rectangle {
                    x: 4px;
                    y: 12px;
                    width: parent.width - 8px;
                    height: parent.height - 12px;
                    border-radius: 12px;
                    background: Tokens.group;
                }
                description := Text {
                    x: 18px;
                    y: 24px;
                    width: parent.width - 36px;
                    text: root.detail.description;
                    font-size: 14px;
                    color: Tokens.text-secondary;
                    wrap: word-wrap;
                }
            }

            PhoneGroupTitle {
                x: 4px;
                text: "Tasks for it";
            }
            for t[i] in root.tasks: PhoneRow {
                first: i == 0;
                inset: 4px;
                tappable: true;
                clicked => { root.task-opened(t.id); }
                Check {
                    y: (parent.height - self.height) / 2;
                    animated: true;
                    size: 22px;
                    done: t.done;
                    label: t.title;
                    toggled => { root.task-toggled(t.id); }
                }
                Text {
                    text: t.title;
                    font-size: 15.5px;
                    color: t.done ? Tokens.text-muted : Tokens.text;
                    vertical-alignment: center;
                    overflow: elide;
                    horizontal-stretch: 1;
                }
            }
            PhoneRow {
                first: root.tasks.length == 0;
                inset: 4px;
                Icon {
                    y: (parent.height - self.height) / 2;
                    data: Icons.plus;
                    size: 18px;
                    tint: Tokens.text-muted;
                }
                TextField {
                    y: (parent.height - self.height) / 2;
                    horizontal-stretch: 1;
                    bare: true;
                    font-size: 15.5px;
                    accessible-label: "Add a task for this event";
                    placeholder-text: "Add a task";
                    text <=> root.new-task;
                    accepted(t) => {
                        if (t != "") {
                            root.task-added(t);
                        }
                    }
                }
            }

            PhoneGroupTitle {
                x: 4px;
                text: "Your notes";
            }
            HorizontalLayout {
                padding-left: 4px;
                padding-right: 4px;
                padding-top: 6px;
                Rectangle {
                    height: 80px;
                    border-radius: 12px;
                    background: Tokens.group;
                    TextArea {
                        x: 4px;
                        y: 2px;
                        width: parent.width - 8px;
                        height: parent.height - 4px;
                        bare: true;
                        font-size: 15px;
                        accessible-label: "My notes";
                        placeholder-text: "My notes, kept on this device";
                        text <=> root.notes;
                        edited(t) => { root.notes-edited(t); }
                    }
                }
            }
            HorizontalLayout {
                padding-left: 4px;
                padding-right: 4px;
                padding-top: 16px;
                spacing: 10px;
                alignment: start;
                CalPill {
                    outline: true;
                    icon: Icons.notes;
                    text: "Notes";
                    clicked => { root.take-notes(); }
                }
                CalPill {
                    outline: true;
                    icon: Icons.link;
                    text: "Copy link";
                    clicked => { root.copy-link(); }
                }
            }
        }
    }
}

// What an event is, when, where: a card beside it in the grid, or in the middle of
// the window when it was opened from elsewhere (Home, a task). On a phone, a sheet
// that pulls up, opened from anywhere.
export component EventDetailPanel inherits Rectangle {
    in property <EventDetailData> detail;
    /// What the user wrote about this event — theirs, even on a subscribed calendar.
    in-out property <string> notes;
    /// The tasks added from this event, done or not.
    in property <[SubtaskData]> tasks;
    in-out property <string> new-task;
    /// Where the event is in the window, when it was clicked there.
    in property <bool> anchored;
    in property <length> anchor-left;
    in property <length> anchor-right;
    in property <length> anchor-top;
    callback notes-edited(string);
    callback task-added(string);
    callback task-toggled(int);
    callback task-opened(int);
    callback edit();
    callback delete();
    callback dismissed();
    callback join(string);
    callback video-set(string);
    callback take-notes();
    /// On a phone: the event's "⋯" (its menu: colour, delete…), and its link copied.
    callback more();
    callback copy-link();

    if root.anchored || Layout.compact: Popover {
        width: 100%;
        height: 100%;
        anchor-left: root.anchor-left;
        anchor-right: root.anchor-right;
        anchor-top: root.anchor-top;
        card-width: 340px;
        dismissed => { root.dismissed(); }
        if Layout.compact: PhoneEventBody {
            detail: root.detail;
            notes <=> root.notes;
            tasks: root.tasks;
            new-task <=> root.new-task;
            notes-edited(t) => { root.notes-edited(t); }
            task-added(t) => { root.task-added(t); }
            task-toggled(id) => { root.task-toggled(id); }
            task-opened(id) => { root.task-opened(id); }
            edit => { root.edit(); }
            more => { root.more(); }
            join(u) => { root.join(u); }
            video-set(u) => { root.video-set(u); }
            take-notes => { root.take-notes(); }
            copy-link => { root.copy-link(); }
        }
        if !Layout.compact: EventBody {
            detail: root.detail;
            notes <=> root.notes;
            tasks: root.tasks;
            new-task <=> root.new-task;
            notes-edited(t) => { root.notes-edited(t); }
            task-added(t) => { root.task-added(t); }
            task-toggled(id) => { root.task-toggled(id); }
            task-opened(id) => { root.task-opened(id); }
            edit => { root.edit(); }
            delete => { root.delete(); }
            dismissed => { root.dismissed(); }
            join(u) => { root.join(u); }
            video-set(u) => { root.video-set(u); }
            take-notes => { root.take-notes(); }
        }
    }

    // Escape reaches the card even from a field, which hands the key up.
    if !root.anchored && !Layout.compact: FocusScope {
        enabled: false;
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                root.dismissed();
                return accept;
            }
            return reject;
        }
        Rectangle {
            background: Tokens.scrim;
        }
        TouchArea {
            clicked => { root.dismissed(); }
        }
        Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 380px;
            height: min(corps.preferred-height + 32px, parent.height - 60px);
            border-radius: Tokens.radius-large;
            background: Tokens.panel;
            border-width: 1px;
            border-color: Tokens.border-strong;
            drop-shadow-blur: Tokens.shadow-window-blur;
            drop-shadow-color: Tokens.shadow-window;
            drop-shadow-offset-y: Tokens.shadow-window-y;
            TouchArea {}
            corps := EventBody {
                x: 16px;
                y: 16px;
                width: parent.width - 32px;
                height: parent.height - 32px;
                detail: root.detail;
                notes <=> root.notes;
                tasks: root.tasks;
                new-task <=> root.new-task;
                notes-edited(t) => { root.notes-edited(t); }
                task-added(t) => { root.task-added(t); }
                task-toggled(id) => { root.task-toggled(id); }
                task-opened(id) => { root.task-opened(id); }
                edit => { root.edit(); }
                delete => { root.delete(); }
                dismissed => { root.dismissed(); }
                join(u) => { root.join(u); }
                video-set(u) => { root.video-set(u); }
                take-notes => { root.take-notes(); }
            }
        }
    }
}

// A date shown as words, that opens the small month when clicked.
export component DateButton inherits Rectangle {
    in property <string> text;
    in property <bool> open;
    callback clicked();

    height: 30px;
    border-radius: Tokens.radius-small;
    border-width: 1px;
    // Like a text field: the border says where the attention is, the background
    // never changes.
    border-color: root.open ? Tokens.accent : touch.has-hover ? Tokens.border-strong : Tokens.border;
    background: Tokens.surface;

    accessible-role: button;
    accessible-value: root.text;
    accessible-expanded: root.open;
    accessible-action-default => { root.clicked(); }

    HorizontalLayout {
        padding-left: Tokens.space-2;
        padding-right: Tokens.space-2;
        spacing: Tokens.space-2;
        Icon {
            y: (parent.height - self.height) / 2;
            data: Icons.calendar;
            size: 13px;
            tint: Tokens.text-muted;
        }
        Text {
            text: root.text;
            font-size: Tokens.size-body;
            color: Tokens.text;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }
        Icon {
            y: (parent.height - self.height) / 2;
            data: root.open ? Icons.chevron-up : Icons.chevron-down;
            size: 11px;
            tint: Tokens.text-muted;
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// The small month under a date: month by month, one click on the day.
export component DatePicker inherits Rectangle {
    in property <string> title;
    in property <[MonthCellData]> cells;
    callback navigate(int);
    callback chosen(string);

    height: 204px;
    vertical-stretch: 0;
    border-radius: Tokens.radius-medium;
    border-width: 1px;
    border-color: Tokens.border;
    background: Tokens.surface-low;

    MiniMonth {
        width: min(280px, parent.width - 2 * Tokens.space-2);
        x: (parent.width - self.width) / 2;
        y: Tokens.space-1;
        title: root.title;
        cells: root.cells;
        day-chosen(d) => { root.chosen(d); }
        navigate(n) => { root.navigate(n); }
    }
}

// Creating or changing an event in a local calendar.
export component EventEditorPanel inherits Rectangle {
    in property <bool> is-new;
    in-out property <string> title;
    in-out property <bool> all-day;
    in-out property <string> start-date;
    in-out property <string> start-time;
    in-out property <string> end-date;
    in-out property <string> end-time;
    in-out property <string> location;
    in-out property <string> notes;
    in property <[string]> calendars;
    in-out property <int> calendar-index;
    in property <[string]> reminders;
    in-out property <int> reminder-index;
    in property <[string]> repeats;
    in-out property <int> repeat-index;
    in property <string> error;
    /// The dates as read: "Mon 28 Sep 2026".
    in property <string> start-label;
    in property <string> end-label;
    /// Which date the small month is open for: 0 start, 1 end, -1 none.
    in property <int> picker: -1;
    in property <string> picker-title;
    in property <[MonthCellData]> picker-cells;

    callback save();
    callback dismissed();
    callback picker-requested(int);
    callback picker-navigate(int);
    callback picker-chosen(string);
    callback picker-closed();

    /// The times as minutes of the day, for a phone's keys; kept with the words above.
    in-out property <int> start-minute: 9 * 60;
    in-out property <int> end-minute: 10 * 60;
    /// The colours of `calendars`, in the same order.
    in property <[color]> calendar-colors;

    // --- A phone: the page of the mockups ("Nouvel événement"), in groups ---

    /// Which time the keys set: 0 the start, 1 the end.
    property <int> cible;
    /// The list open as a sheet: 1 the repetition, 2 the reminder, 3 the calendar.
    property <int> choix;
    property <[string]> options: root.choix == 1 ? root.repeats
        : root.choix == 2 ? root.reminders : root.calendars;
    property <int> option-choisie: root.choix == 1 ? root.repeat-index
        : root.choix == 2 ? root.reminder-index : root.calendar-index;
    /// The time the keys show, and the first of the six hours offered around it.
    property <int> valeur: root.cible == 0 ? root.start-minute : root.end-minute;
    property <int> premiere-heure: max(0, min(18, floor(root.valeur / 60) - 2));

    pure function hm(m: int) -> string {
        return (floor(m / 60) < 10 ? "0" : "") + floor(m / 60) + ":"
            + (mod(m, 60) < 10 ? "0" : "") + mod(m, 60);
    }
    /// A key pressed: the start moves the end with it on the same day, so the event
    /// keeps its length.
    function poser(m: int) {
        if (root.cible == 0) {
            let longueur = root.end-minute - root.start-minute;
            root.start-minute = m;
            root.start-time = root.hm(m);
            if (root.start-date == root.end-date) {
                root.end-minute = min(23 * 60 + 59, m + max(15, longueur));
                root.end-time = root.hm(root.end-minute);
            }
        } else {
            root.end-minute = m;
            root.end-time = root.hm(m);
        }
    }

    if Layout.compact: Rectangle {
        width: parent.width;
        height: parent.height;
        background: Tokens.background;

        FocusScope {
            width: parent.width;
            height: parent.height;
            enabled: false;
            key-pressed(event) => {
                if (event.text == Key.Escape || event.text == Key.Back) {
                    if (root.choix != 0) {
                        root.choix = 0;
                    } else if (root.picker >= 0) {
                        root.picker-closed();
                    } else {
                        root.dismissed();
                    }
                    return accept;
                }
                return reject;
            }

            // Nothing behind the page answers a touch.
            TouchArea {}

            VerticalLayout {
                padding-top: Layout.inset-top;

                // The bar (`.appbar.surf.line`): close, the title, Save.
                Rectangle {
                    height: 56px;
                    background: Tokens.surface;
                    HorizontalLayout {
                        padding-left: 6px;
                        padding-right: 12px;
                        spacing: 2px;
                        IconButton {
                            y: (parent.height - self.height) / 2;
                            icon: Icons.window-close;
                            label: "Close";
                            button-size: 44px;
                            icon-size: 18px;
                            tinted: true;
                            tint: Tokens.text-secondary;
                            clicked => { root.dismissed(); }
                        }
                        Text {
                            text: root.is-new ? "New event" : "Edit event";
                            font-family: Tokens.font-display;
                            font-size: 18px;
                            font-weight: 600;
                            color: Tokens.text;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            overflow: elide;
                        }
                        CalPill {
                            y: (parent.height - self.height) / 2;
                            text: "Save";
                            clicked => { root.save(); }
                        }
                    }
                    Rectangle {
                        y: parent.height - 1px;
                        height: 1px;
                        background: Tokens.border;
                    }
                }

                ScrollView {
                    vertical-stretch: 1;
                    mouse-drag-pan-enabled: true;
                    content-width: self.visible-width;
                    VerticalLayout {
                        alignment: start;
                        padding-left: 16px;
                        padding-right: 16px;
                        padding-top: 12px;
                        padding-bottom: 24px + Layout.inset-bottom;
                        spacing: 14px;

                        // What and where.
                        Rectangle {
                            height: quoi.preferred-height;
                            border-radius: 14px;
                            background: Tokens.surface;
                            quoi := VerticalLayout {
                                PhoneRow {
                                    first: true;
                                    row-height: 60px;
                                    // The title is not focused on opening: asked for while
                                    // the page is being made, the keyboard is the likely
                                    // cause of Iris stopping when an event was edited (6.5.0).
                                    TextField {
                                        y: (parent.height - self.height) / 2;
                                        horizontal-stretch: 1;
                                        bare: true;
                                        font-size: 19px;
                                        accessible-label: "Title";
                                        placeholder-text: "What is it?";
                                        text <=> root.title;
                                        accepted => { root.save(); }
                                    }
                                }
                                PhoneRow {
                                    Icon {
                                        y: (parent.height - self.height) / 2;
                                        data: Icons.map-pin;
                                        size: 18px;
                                        tint: Tokens.text-muted;
                                    }
                                    TextField {
                                        y: (parent.height - self.height) / 2;
                                        horizontal-stretch: 1;
                                        bare: true;
                                        font-size: 15.5px;
                                        accessible-label: "Location";
                                        placeholder-text: "Location";
                                        text <=> root.location;
                                    }
                                }
                            }
                        }

                        // When: all day, the start, the end, and the keys of the hour.
                        Rectangle {
                            height: quand.preferred-height;
                            border-radius: 14px;
                            background: Tokens.surface;
                            quand := VerticalLayout {
                                PhoneRow {
                                    first: true;
                                    Text {
                                        text: "All day";
                                        font-size: 15.5px;
                                        color: Tokens.text;
                                        vertical-alignment: center;
                                        horizontal-stretch: 1;
                                    }
                                    Toggle {
                                        y: (parent.height - self.height) / 2;
                                        label: "All day";
                                        on <=> root.all-day;
                                    }
                                }
                                for bout in 2: PhoneRow {
                                    Text {
                                        text: bout == 0 ? "Starts" : "Ends";
                                        font-size: 15.5px;
                                        color: Tokens.text;
                                        vertical-alignment: center;
                                        horizontal-stretch: 1;
                                    }
                                    // The date: the small month opens under it.
                                    Rectangle {
                                        y: (parent.height - self.height) / 2;
                                        width: jour.preferred-width + 22px;
                                        height: 30px;
                                        border-radius: 8px;
                                        background: root.picker == bout ? Tokens.accent-soft : Tokens.surface-active;
                                        accessible-role: button;
                                        accessible-label: bout == 0 ? "Start date" : "End date";
                                        accessible-value: jour.text;
                                        accessible-expanded: root.picker == bout;
                                        accessible-action-default => { root.picker-requested(bout); }
                                        jour := Text {
                                            text: bout == 0 ? root.start-label : root.end-label;
                                            font-size: 13.5px;
                                            color: root.picker == bout ? Tokens.accent : Tokens.text-secondary;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                        TouchArea {
                                            clicked => { root.picker-requested(bout); }
                                        }
                                    }
                                    // The time: the keys below set it.
                                    if !root.all-day: Rectangle {
                                        property <bool> vise: root.cible == bout;
                                        y: (parent.height - self.height) / 2;
                                        width: heure.preferred-width + 22px;
                                        height: 30px;
                                        border-radius: 8px;
                                        background: self.vise ? Tokens.accent-soft : Tokens.surface-active;
                                        accessible-role: button;
                                        accessible-label: bout == 0 ? "Start time" : "End time";
                                        accessible-value: heure.text;
                                        accessible-action-default => { root.cible = bout; }
                                        heure := Text {
                                            text: bout == 0 ? root.start-time : root.end-time;
                                            font-size: 13.5px;
                                            color: parent.vise ? Tokens.accent : Tokens.text-secondary;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                        TouchArea {
                                            clicked => { root.cible = bout; }
                                        }
                                    }
                                }
                                if root.picker >= 0: HorizontalLayout {
                                    padding: 8px;
                                    DatePicker {
                                        title: root.picker-title;
                                        cells: root.picker-cells;
                                        navigate(n) => { root.picker-navigate(n); }
                                        chosen(d) => { root.picker-chosen(d); }
                                    }
                                }
                                // The hour, then the quarter: quicker than a wheel.
                                if !root.all-day: PhoneRow {
                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        spacing: 6px;
                                        HorizontalLayout {
                                            spacing: 2px;
                                            for k in 6: Rectangle {
                                                property <int> h: root.premiere-heure + k;
                                                property <int> ecart: abs(self.h - floor(root.valeur / 60));
                                                horizontal-stretch: 1;
                                                height: 30px;
                                                border-radius: 8px;
                                                background: self.ecart == 0 ? Tokens.accent-soft : transparent;
                                                accessible-role: button;
                                                accessible-label: (self.h < 10 ? "0" : "") + self.h + " h";
                                                accessible-action-default => { root.poser(h * 60 + mod(root.valeur, 60)); }
                                                Text {
                                                    text: (h < 10 ? "0" : "") + h;
                                                    font-size: 16px;
                                                    font-weight: ecart == 0 ? 700 : 400;
                                                    color: ecart == 0 ? Tokens.accent
                                                        : ecart == 1 ? Tokens.text-muted : Tokens.text-faint;
                                                    horizontal-alignment: center;
                                                    vertical-alignment: center;
                                                }
                                                TouchArea {
                                                    clicked => { root.poser(h * 60 + mod(root.valeur, 60)); }
                                                }
                                            }
                                        }
                                        HorizontalLayout {
                                            spacing: 6px;
                                            for q in 4: Rectangle {
                                                property <bool> pris: floor(mod(root.valeur, 60) / 15) == q;
                                                horizontal-stretch: 1;
                                                height: 30px;
                                                border-radius: 8px;
                                                background: self.pris ? Tokens.accent-soft : transparent;
                                                accessible-role: button;
                                                accessible-label: q == 0 ? ":00" : ":" + (q * 15);
                                                accessible-action-default => { root.poser(floor(root.valeur / 60) * 60 + q * 15); }
                                                Text {
                                                    text: q == 0 ? ":00" : ":" + (q * 15);
                                                    font-size: 15px;
                                                    font-weight: pris ? 700 : 400;
                                                    color: pris ? Tokens.accent : Tokens.text;
                                                    horizontal-alignment: center;
                                                    vertical-alignment: center;
                                                }
                                                TouchArea {
                                                    clicked => { root.poser(floor(root.valeur / 60) * 60 + q * 15); }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        // How it repeats, its reminder, its calendar: each a list.
                        Rectangle {
                            height: reglages.preferred-height;
                            border-radius: 14px;
                            background: Tokens.surface;
                            reglages := VerticalLayout {
                                for n in 3: PhoneRow {
                                    first: n == 0;
                                    tappable: true;
                                    clicked => { root.choix = n + 1; }
                                    accessible-role: button;
                                    accessible-label: n == 0 ? "Repeat" : n == 1 ? "Reminder" : "Calendar";
                                    accessible-value: montre.text;
                                    accessible-action-default => { root.choix = n + 1; }
                                    Text {
                                        text: n == 0 ? "Repeat" : n == 1 ? "Reminder" : "Calendar";
                                        font-size: 15.5px;
                                        color: Tokens.text;
                                        vertical-alignment: center;
                                        horizontal-stretch: 1;
                                    }
                                    // A box the row stretches, the dot centred in it: a
                                    // `y` of its own in the row was written over.
                                    if n == 2 && root.calendar-colors.length > root.calendar-index: Rectangle {
                                        width: 8px;
                                        Rectangle {
                                            y: (parent.height - self.height) / 2;
                                            width: 8px;
                                            height: 8px;
                                            border-radius: 4px;
                                            background: root.calendar-colors[root.calendar-index];
                                        }
                                    }
                                    montre := Text {
                                        text: n == 0 ? (root.repeats.length > root.repeat-index ? root.repeats[root.repeat-index] : "")
                                            : n == 1 ? (root.reminders.length > root.reminder-index ? root.reminders[root.reminder-index] : "")
                                            : (root.calendars.length > root.calendar-index ? root.calendars[root.calendar-index] : "");
                                        font-size: 14.5px;
                                        color: Tokens.text-muted;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }
                                    Icon {
                                        y: (parent.height - self.height) / 2;
                                        data: Icons.chevron-right;
                                        size: 18px;
                                        tint: Tokens.text-faint;
                                    }
                                }
                            }
                        }

                        Rectangle {
                            height: 80px;
                            border-radius: 14px;
                            background: Tokens.surface;
                            TextArea {
                                x: 6px;
                                y: 6px;
                                width: parent.width - 12px;
                                height: parent.height - 12px;
                                bare: true;
                                font-size: 15.5px;
                                accessible-label: "Notes";
                                placeholder-text: "Notes";
                                text <=> root.notes;
                            }
                        }

                        if root.error != "": Text {
                            text: root.error;
                            font-size: 14px;
                            color: Tokens.error;
                            wrap: word-wrap;
                        }
                    }
                }
            }
        }

        // The repetition, the reminder or the calendar, picked from a sheet.
        if root.choix != 0: Rectangle {
            width: parent.width;
            height: parent.height;
            TouchArea {
                clicked => { root.choix = 0; }
            }
            MenuSurface {
                available-width: parent.width;
                available-height: parent.height;
                menu-height: liste.preferred-height + 8px;
                dismissed => { root.choix = 0; }
                liste := VerticalLayout {
                    padding: 4px;
                    MenuHeader {
                        text: root.choix == 1 ? "Repeat" : root.choix == 2 ? "Reminder" : "Calendar";
                    }
                    for nom[i] in root.options: MenuEntry {
                        icon: i == root.option-choisie ? Icons.check : "";
                        label: nom;
                        activated => {
                            if (root.choix == 1) {
                                root.repeat-index = i;
                            } else if (root.choix == 2) {
                                root.reminder-index = i;
                            } else {
                                root.calendar-index = i;
                            }
                            root.choix = 0;
                        }
                    }
                }
            }
        }
    }

    if !Layout.compact: PanelFrame {
        width: 100%;
        height: 100%;
        title: root.is-new ? "New event" : "Edit event";
        card-width: 520px;
        // The small month opens inside the card, which grows to hold it: nothing
        // floats over the other fields, so a click on any of them still lands.
        card-height: root.picker >= 0 ? 810px : 600px;
        dismissed => { root.dismissed(); }
        // The small month first: Escape folds it and leaves the event open.
        escaped => {
            if (root.picker >= 0) {
                root.picker-closed();
            } else {
                root.dismissed();
            }
        }

        Labelled {
            label: "Title";
            TextField {
                accessible-label: "Title";
                placeholder-text: "What is it?";
                text <=> root.title;
                // Opened to write: the first key goes to the title. Not on a phone:
                // the keyboard would cover the event being changed, and asked for
                // while the page was being made, it is the likely cause of Iris
                // stopping when an event was edited (6.5.0).
                init => {
                    if (!Layout.touch-input) {
                        self.focus();
                    }
                }
                accepted => { root.save(); }
            }
        }

        CheckBox {
            text: "All day";
            checked <=> root.all-day;
        }

        HorizontalLayout {
            spacing: Tokens.space-2;
            vertical-stretch: 0;
            Labelled {
                label: "Starts";
                DateButton {
                    accessible-label: "Start date";
                    text: root.start-label;
                    open: root.picker == 0;
                    clicked => { root.picker-requested(0); }
                }
            }
            if !root.all-day: Labelled {
                label: " ";
                width: 90px;
                TextField {
                    accessible-label: "Start time";
                    placeholder-text: "HH:MM";
                    text <=> root.start-time;
                }
            }
        }

        if root.picker == 0: DatePicker {
            title: root.picker-title;
            cells: root.picker-cells;
            navigate(n) => { root.picker-navigate(n); }
            chosen(d) => { root.picker-chosen(d); }
        }

        HorizontalLayout {
            spacing: Tokens.space-2;
            vertical-stretch: 0;
            Labelled {
                label: "Ends";
                DateButton {
                    accessible-label: "End date";
                    text: root.end-label;
                    open: root.picker == 1;
                    clicked => { root.picker-requested(1); }
                }
            }
            if !root.all-day: Labelled {
                label: " ";
                width: 90px;
                TextField {
                    accessible-label: "End time";
                    placeholder-text: "HH:MM";
                    text <=> root.end-time;
                }
            }
        }

        if root.picker == 1: DatePicker {
            title: root.picker-title;
            cells: root.picker-cells;
            navigate(n) => { root.picker-navigate(n); }
            chosen(d) => { root.picker-chosen(d); }
        }

        HorizontalLayout {
            spacing: Tokens.space-2;
            vertical-stretch: 0;
            Labelled {
                label: "Calendar";
                ComboBox {
                    model: root.calendars;
                    current-index <=> root.calendar-index;
                }
            }
            Labelled {
                label: "Repeats";
                ComboBox {
                    model: root.repeats;
                    current-index <=> root.repeat-index;
                }
            }
            Labelled {
                label: "Reminder";
                ComboBox {
                    model: root.reminders;
                    current-index <=> root.reminder-index;
                }
            }
        }

        Labelled {
            label: "Location";
            TextField {
                accessible-label: "Location";
                placeholder-text: "Where";
                text <=> root.location;
            }
        }

        Labelled {
            label: "Notes";
            vertical-stretch: 1;
            TextArea {
                accessible-label: "Notes";
                vertical-stretch: 1;
                text <=> root.notes;
            }
        }

        if root.error != "": Text {
            text: root.error;
            font-size: Tokens.size-small;
            color: Tokens.error;
            wrap: word-wrap;
        }

        HorizontalLayout {
            height: 28px;
            spacing: Tokens.space-2;
            vertical-stretch: 0;
            Rectangle {}
            CalButton {
                text: "Cancel";
                clicked => { root.dismissed(); }
            }
            CalButton {
                text: "Save";
                primary: true;
                clicked => { root.save(); }
            }
        }
    }
}

// Following a calendar published as a link.
export component SubscribePanel inherits Rectangle {
    in-out property <string> url;
    in-out property <string> name;
    in property <bool> busy;
    in property <string> error;

    callback subscribe();
    callback dismissed();

    PanelFrame {
        width: 100%;
        height: 100%;
        title: "Subscribe to a calendar";
        card-height: 340px;
        dismissed => { if (!root.busy) { root.dismissed(); } }

        Text {
            text: "Paste the calendar's public or secret link: the iCal / .ics address that "
                + "Google Calendar, Outlook, iCloud, a school or a club publishes. "
                + "Iris reads it now and every half hour after; it stays read-only here.";
            font-size: Tokens.size-small;
            color: Tokens.text-secondary;
            wrap: word-wrap;
        }

        Labelled {
            label: "Link";
            TextField {
                accessible-label: "Calendar link";
                placeholder-text: "webcal://… or https://….ics";
                text <=> root.url;
                init => { self.focus(); }
                accepted => { root.subscribe(); }
            }
        }

        Labelled {
            label: "Name (optional)";
            TextField {
                accessible-label: "Calendar name";
                placeholder-text: "Taken from the calendar when empty";
                text <=> root.name;
                accepted => { root.subscribe(); }
            }
        }

        if root.error != "": Text {
            text: root.error;
            font-size: Tokens.size-small;
            color: Tokens.error;
            wrap: word-wrap;
        }
        if root.busy: Text {
            text: "Reading the calendar…";
            font-size: Tokens.size-small;
            color: Tokens.text-muted;
        }

        Rectangle {}

        HorizontalLayout {
            height: 28px;
            spacing: Tokens.space-2;
            vertical-stretch: 0;
            Rectangle {}
            CalButton {
                text: "Cancel";
                enabled: !root.busy;
                clicked => { root.dismissed(); }
            }
            CalButton {
                text: "Subscribe";
                primary: true;
                enabled: !root.busy;
                clicked => { root.subscribe(); }
            }
        }
    }
}

// Calendars kept with a server, both ways (CalDAV): an address or a server, who signs
// in, a password. Iris finds the calendars itself.
export component ConnectCalendarsPanel inherits Rectangle {
    in-out property <string> server;
    in-out property <string> user;
    in-out property <string> password;
    in property <bool> busy;
    in property <string> error;

    callback connect();
    callback dismissed();

    PanelFrame {
        width: 100%;
        height: 100%;
        title: "Connect calendars from a server";
        card-height: 420px;
        dismissed => { if (!root.busy) { root.dismissed(); } }

        Text {
            text: "iCloud, Fastmail, Nextcloud, mailbox.org, Posteo and any CalDAV server. "
                + "What you change here is changed there, and the other way round. For iCloud "
                + "and Fastmail use an app password. For Gmail, add the mailbox to Iris with "
                + "Google's sign-in, then type its address here and no password.";
            font-size: Tokens.size-small;
            color: Tokens.text-secondary;
            wrap: word-wrap;
        }

        Labelled {
            label: "Address or server";
            TextField {
                accessible-label: "Address or server";
                placeholder-text: "you@icloud.com, or https://cloud.example.com/remote.php/dav";
                text <=> root.server;
                init => { self.focus(); }
                accepted => { root.connect(); }
            }
        }

        Labelled {
            label: "User name (when it is not the address)";
            TextField {
                accessible-label: "User name";
                text <=> root.user;
                accepted => { root.connect(); }
            }
        }

        Labelled {
            label: "Password";
            TextField {
                accessible-label: "Password";
                input-type: InputType.password;
                text <=> root.password;
                accepted => { root.connect(); }
            }
        }

        if root.error != "": Text {
            text: root.error;
            font-size: Tokens.size-small;
            color: Tokens.error;
            wrap: word-wrap;
        }
        if root.busy: Text {
            text: "Looking for your calendars…";
            font-size: Tokens.size-small;
            color: Tokens.text-muted;
        }

        Rectangle {}

        HorizontalLayout {
            height: 28px;
            spacing: Tokens.space-2;
            vertical-stretch: 0;
            Rectangle {}
            CalButton {
                text: "Cancel";
                enabled: !root.busy;
                clicked => { root.dismissed(); }
            }
            CalButton {
                text: "Connect";
                primary: true;
                enabled: !root.busy;
                clicked => { root.connect(); }
            }
        }
    }
}

// Right click on a calendar in the list.
export component CalendarContextMenu inherits Rectangle {
    in property <CalendarData> cal;
    in property <[color]> palette;
    in property <length> menu-x;
    in property <length> menu-y;

    callback color-chosen(int);
    callback refresh();
    callback rename();
    callback remove();
    callback dismissed();

    TouchArea {
        width: 100%;
        height: 100%;
        clicked => { root.dismissed(); }
    }

    MenuSurface {
        dismissed => { root.dismissed(); }
        available-width: root.width;
        available-height: root.height;
        menu-x: root.menu-x;
        menu-y: root.menu-y;
        menu-width: 220px;
        menu-height: entries.preferred-height + 8px;

        entries := VerticalLayout {
            padding: 4px;

            HorizontalLayout {
                padding-left: Tokens.space-2;
                padding-right: Tokens.space-2;
                height: 22px;
                Text {
                    text: root.cal.name;
                    font-size: 9px;
                    letter-spacing: 0.5px;
                    color: Tokens.text-muted;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }

            MenuSeparator {}

            if root.cal.subscribed || root.cal.remote: MenuEntry {
                icon: Icons.refresh;
                label: root.cal.remote ? "Sync now" : "Refresh now";
                activated => { root.refresh(); }
            }
            MenuEntry {
                icon: Icons.pencil;
                label: "Rename…";
                activated => { root.rename(); }
            }

            // The colour: one click on a swatch, no dialog.
            HorizontalLayout {
                padding-left: Tokens.space-2;
                padding-right: Tokens.space-2;
                padding-top: 4px;
                padding-bottom: 4px;
                spacing: 5px;
                height: 30px;
                for couleur[i] in root.palette: Rectangle {
                    width: 20px;
                    height: 20px;
                    cross-axis-self-alignment: center;
                    border-radius: 10px;
                    background: couleur;
                    border-width: root.cal.color == couleur ? 2px : (pastille.has-hover ? 2px : 0px);
                    border-color: root.cal.color == couleur ? Tokens.text : Tokens.border-strong;

                    accessible-role: button;
                    accessible-label: "Colour " + (i + 1);
                    accessible-action-default => { root.color-chosen(i); }

                    if root.cal.color == couleur: Icon {
                        data: Icons.check;
                        size: 11px;
                        weight: 3.0;
                        tint: white;
                    }
                    pastille := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.color-chosen(i); }
                    }
                }
                Rectangle {}
            }

            if root.cal.deletable: MenuSeparator {}

            if root.cal.deletable: MenuEntry {
                icon: Icons.trash;
                label: root.cal.remote ? "Disconnect " + root.cal.account + "…"
                    : root.cal.subscribed ? "Unsubscribe…" : "Delete calendar…";
                danger: true;
                activated => { root.remove(); }
            }
        }
    }
}

// What a right-click on an event offers: open it, change it, give it a colour of its
// own, delete it. Changing and deleting only in a calendar of one's own; a colour
// anywhere, subscribed calendars included, since it is kept on this computer.
export component EventContextMenu inherits Rectangle {
    in property <EventDetailData> event;
    in property <[color]> palette;
    in property <length> menu-x;
    in property <length> menu-y;

    callback open();
    callback edit();
    callback delete();
    /// A swatch of the palette; -1 for the calendar's colour again.
    callback color-chosen(int);
    callback copy-link();
    callback dismissed();

    TouchArea {
        width: 100%;
        height: 100%;
        clicked => { root.dismissed(); }
        // A right-click elsewhere closes it too, rather than being swallowed.
        pointer-event(ev) => {
            if (ev.button == PointerEventButton.right && ev.kind == PointerEventKind.down) {
                root.dismissed();
            }
        }
    }

    MenuSurface {
        dismissed => { root.dismissed(); }
        available-width: root.width;
        available-height: root.height;
        menu-x: root.menu-x;
        menu-y: root.menu-y;
        menu-width: 236px;
        menu-height: entries.preferred-height + 8px;

        entries := VerticalLayout {
            padding: 4px;

            MenuHeader {
                text: root.event.title;
            }

            MenuEntry {
                icon: Icons.calendar;
                label: "Open";
                activated => { root.open(); }
            }
            MenuEntry {
                icon: Icons.link;
                label: "Copy link for a note";
                activated => { root.copy-link(); }
            }
            if root.event.editable: MenuEntry {
                icon: Icons.pencil;
                label: "Edit…";
                activated => { root.edit(); }
            }

            MenuSeparator {}

            // Its colour: one click on a swatch; the ring marks the one it wears.
            HorizontalLayout {
                padding-left: Tokens.space-2;
                padding-right: Tokens.space-2;
                padding-top: 4px;
                padding-bottom: 2px;
                spacing: 5px;
                height: 30px;
                for couleur[i] in root.palette: rond := Rectangle {
                    property <bool> portee: root.event.own-color && root.event.color == couleur;
                    width: 20px;
                    height: 20px;
                    cross-axis-self-alignment: center;
                    border-radius: 10px;
                    background: couleur;
                    border-width: self.portee || pastille.has-hover ? 2px : 0px;
                    border-color: self.portee ? Tokens.text : Tokens.border-strong;

                    accessible-role: button;
                    accessible-label: "Event colour " + (i + 1);
                    accessible-action-default => { root.color-chosen(i); }

                    if rond.portee: Icon {
                        data: Icons.check;
                        size: 11px;
                        weight: 3.0;
                        tint: white;
                    }
                    pastille := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.color-chosen(i); }
                    }
                }
                Rectangle {}
            }
            if root.event.own-color: MenuEntry {
                icon: Icons.refresh;
                label: "Use the calendar's colour";
                activated => { root.color-chosen(-1); }
            }

            if root.event.editable: MenuSeparator {}
            if root.event.editable: MenuEntry {
                icon: Icons.trash;
                label: "Delete";
                danger: true;
                activated => { root.delete(); }
            }
        }
    }
}

// A new name for a calendar.
export component CalendarRenamePanel inherits Rectangle {
    /// Naming a calendar that does not exist yet, rather than renaming one.
    in property <bool> is-new;
    in-out property <string> name;
    in property <string> error;
    callback rename();
    callback dismissed();

    PanelFrame {
        width: 100%;
        height: 100%;
        title: root.is-new ? "New calendar" : "Rename calendar";
        card-height: 200px;
        dismissed => { root.dismissed(); }

        TextField {
            accessible-label: "Calendar name";
            placeholder-text: "Work, Family, Sport…";
            text <=> root.name;
            // Opened to type: the name is selected, the first key replaces it.
            init => {
                self.focus();
                self.select-all();
            }
            accepted => { root.rename(); }
        }

        if root.error != "": Text {
            text: root.error;
            font-size: Tokens.size-small;
            color: Tokens.error;
            wrap: word-wrap;
        }

        Rectangle {}

        HorizontalLayout {
            height: 28px;
            spacing: Tokens.space-2;
            vertical-stretch: 0;
            Rectangle {}
            CalButton {
                text: "Cancel";
                clicked => { root.dismissed(); }
            }
            CalButton {
                text: root.is-new ? "Create" : "Rename";
                primary: true;
                clicked => { root.rename(); }
            }
        }
    }
}

// Removing a calendar asks first: its events go with it.
export component CalendarDeletePanel inherits Rectangle {
    in property <CalendarData> cal;
    callback confirmed();
    callback dismissed();

    PanelFrame {
        kind: ModalKind.question;
        width: 100%;
        height: 100%;
        title: root.cal.remote ? "Disconnect this account?"
            : root.cal.subscribed ? "Unsubscribe from this calendar?" : "Delete this calendar?";
        card-height: 210px;
        dismissed => { root.dismissed(); }

        Text {
            text: root.cal.remote
                ? "The calendars of “" + root.cal.account + "” leave Iris. They stay on their "
                    + "server, untouched: connect the account again to bring them back."
                : root.cal.subscribed
                ? "“" + root.cal.name + "” and its events leave Iris. The calendar itself is not "
                    + "touched: you can subscribe again with its link."
                : "“" + root.cal.name + "” and every event in it are deleted from this computer. "
                    + "This cannot be undone.";
            font-size: Tokens.size-body;
            color: Tokens.text-secondary;
            wrap: word-wrap;
        }

        Rectangle {}

        HorizontalLayout {
            height: 28px;
            spacing: Tokens.space-2;
            vertical-stretch: 0;
            Rectangle {}
            CalButton {
                text: "Cancel";
                clicked => { root.dismissed(); }
            }
            CalButton {
                text: root.cal.remote ? "Disconnect" : root.cal.subscribed ? "Unsubscribe" : "Delete";
                primary: true;
                danger: true;
                clicked => { root.confirmed(); }
            }
        }
    }
}
