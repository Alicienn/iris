import { Tokens } from "@iris/theme/tokens.slint";
import { Floating } from "@iris/base/glass.slint";
import { Icon, Icons, IconButton } from "@iris/base/icons.slint";
import { TextField, TextArea } from "@iris/controls/field.slint";
import { EventDetailData, CalendarData, MonthCellData, SubtaskData } from "@iris/types.slint";
import { CalButton, MiniMonth } from "@iris/screens/calendar.slint";
import { MenuEntry, MenuHeader, MenuSeparator, MenuSurface } from "@iris/layout/menu.slint";
import { CheckBox, ComboBox } from "std-widgets.slint";
import { Modal, Popover } from "@iris/layout/frames.slint";
import { Button, ButtonKind, ButtonSize, Link } from "@iris/controls/button.slint";
import { Check } from "@iris/controls/choice.slint";
import { JoinButton } from "@iris/controls/video.slint";

// The frame of the calendar's, the tasks' and the tags' windows: the shared modal.
export component PanelFrame inherits Modal {}

// A label above a field.
export component Labelled inherits VerticalLayout {
    in property <string> label;
    spacing: 3px;
    vertical-stretch: 0;
    Text {
        text: root.label;
        font-size: 10px;
        color: Tokens.text-muted;
    }
    @children
}

// A task of an event: ticked here, opened in Tasks.
component EventTaskRow inherits Rectangle {
    in property <SubtaskData> task;
    callback toggled(int);
    callback opened(int);

    height: 28px;
    border-radius: Tokens.radius-small;
    background: ligne.has-hover ? Tokens.surface-hover : transparent;

    ligne := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.opened(root.task.id); }
    }

    HorizontalLayout {
        padding-left: 4px;
        padding-right: 4px;
        spacing: Tokens.space-2;
        Check {
            y: (parent.height - self.height) / 2;
            size: 16px;
            done: root.task.done;
            label: root.task.title;
            toggled => { root.toggled(root.task.id); }
        }
        Text {
            text: root.task.title;
            font-size: 13px;
            color: root.task.done ? Tokens.text-muted : Tokens.text;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }
        if ligne.has-hover: Text {
            text: "Open in Tasks";
            font-size: Tokens.size-small;
            color: Tokens.text-muted;
            vertical-alignment: center;
        }
    }
}

// A line of the event's card: an icon, the words, a quieter note after them.
component FactRow inherits HorizontalLayout {
    in property <string> icon;
    in property <string> text;
    in property <string> note;
    spacing: 10px;
    Icon {
        y: 2px;
        data: root.icon;
        size: 14px;
        tint: Tokens.text-muted;
    }
    Text {
        text: root.text;
        font-size: 13px;
        color: Tokens.text;
        wrap: word-wrap;
        horizontal-stretch: 1;
    }
    if root.note != "": Text {
        text: root.note;
        font-size: 12px;
        color: Tokens.text-muted;
    }
}

// What the card says of an event, beside it or in the middle of the window.
component EventBody inherits VerticalLayout {
    in property <EventDetailData> detail;
    in-out property <string> notes;
    in property <[SubtaskData]> tasks;
    in-out property <string> new-task;
    callback notes-edited(string);
    callback task-added(string);
    callback task-toggled(int);
    callback task-opened(int);
    callback edit();
    callback delete();
    callback dismissed();
    /// Its video call opened in the browser (or its app).
    callback join(string);
    /// A video call link given to it; empty takes it away.
    callback video-set(string);

    /// The link being typed or changed.
    property <bool> video-editing;
    property <string> video-typed;

    spacing: 12px;

    // Its colour, its title whole (it is often all that says what it is), the way out.
    HorizontalLayout {
        spacing: 10px;
        Rectangle {
            width: 4px;
            border-radius: 2px;
            background: root.detail.color;
        }
        Text {
            text: root.detail.title == "" ? "(No title)" : root.detail.title;
            font-family: Tokens.font-display;
            font-size: 18px;
            font-weight: 600;
            color: Tokens.text;
            wrap: word-wrap;
            horizontal-stretch: 1;
        }
        IconButton {
            icon: Icons.window-close;
            label: "Close";
            shortcut: "Esc";
            button-size: 26px;
            icon-size: 12px;
            clicked => { root.dismissed(); }
        }
    }

    FactRow {
        icon: Icons.clock;
        text: root.detail.when;
        note: root.detail.repeats;
    }
    if root.detail.location != "": FactRow {
        icon: Icons.map-pin;
        text: root.detail.location;
    }

    // Its video call: the service's button, one click to join; and the link, given or
    // changed in place.
    if root.detail.video-url != "" && !root.video-editing: HorizontalLayout {
        spacing: 8px;
        alignment: start;
        JoinButton {
            kind: root.detail.video-kind;
            text: root.detail.video-label;
            clicked => { root.join(root.detail.video-url); }
        }
        Link {
            y: (parent.height - self.height) / 2;
            text: "Change";
            label: "Change the video call link";
            clicked => {
                root.video-typed = root.detail.video-set != "" ? root.detail.video-set : root.detail.video-url;
                root.video-editing = true;
            }
        }
    }
    if root.detail.video-url == "" || root.video-editing: TextField {
        icon: Icons.video;
        accessible-label: "Video call link";
        placeholder-text: "Video call link (Meet, Teams, Zoom…)";
        text <=> root.video-typed;
        accepted(t) => {
            root.video-set(t);
            root.video-editing = false;
        }
    }
    FactRow {
        icon: root.detail.reminder != "" ? Icons.bell : Icons.calendar;
        text: root.detail.reminder != "" ? root.detail.reminder : root.detail.calendar;
        note: root.detail.reminder != "" ? root.detail.calendar : "";
    }

    if root.detail.description != "": Rectangle {
        border-radius: Tokens.radius-medium;
        border-width: 1px;
        border-color: Tokens.border;
        background: Tokens.surface-low;
        height: description.preferred-height + 20px;
        description := Text {
            x: 12px;
            width: parent.width - 24px;
            text: root.detail.description;
            font-size: 12px;
            color: Tokens.text-secondary;
            wrap: word-wrap;
        }
    }

    TextArea {
        height: 64px;
        vertical-stretch: 0;
        accessible-label: "My notes";
        placeholder-text: "My notes, kept on this computer";
        text <=> root.notes;
        edited(t) => { root.notes-edited(t); }
    }

    // What there is to do for it. Each one is a task in Tasks, due when the event
    // starts, and stays there if the calendar goes.
    VerticalLayout {
        spacing: 1px;
        HorizontalLayout {
            height: 22px;
            spacing: 8px;
            Text {
                text: "Tasks";
                font-size: 12px;
                font-weight: 600;
                color: Tokens.text-secondary;
                vertical-alignment: center;
            }
            Text {
                text: root.tasks.length > 0 ? root.tasks.length : "";
                font-size: 12px;
                color: Tokens.text-muted;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
        }
        for t in root.tasks: EventTaskRow {
            task: t;
            toggled(id) => { root.task-toggled(id); }
            opened(id) => { root.task-opened(id); }
        }
        TextField {
            icon: Icons.plus;
            bare: true;
            accessible-label: "Add a task for this event";
            placeholder-text: "Add a task";
            text <=> root.new-task;
            accepted(t) => {
                if (t != "") {
                    root.task-added(t);
                }
            }
        }
    }

    HorizontalLayout {
        height: 30px;
        spacing: 8px;
        if !root.detail.editable: Text {
            text: "From a subscribed calendar: read only.";
            font-size: 12px;
            color: Tokens.text-muted;
            vertical-alignment: center;
        }
        if root.detail.editable: Button {
            text: "Delete";
            icon: Icons.trash;
            size: ButtonSize.sm;
            clicked => { root.delete(); }
        }
        Rectangle { horizontal-stretch: 1; }
        if root.detail.editable: Button {
            text: "Edit";
            icon: Icons.pencil;
            kind: ButtonKind.primary;
            size: ButtonSize.sm;
            clicked => { root.edit(); }
        }
    }
}

// What an event is, when, where: a card beside it in the grid, or in the middle of
// the window when it was opened from elsewhere (Home, a task).
export component EventDetailPanel inherits Rectangle {
    in property <EventDetailData> detail;
    /// What the user wrote about this event — theirs, even on a subscribed calendar.
    in-out property <string> notes;
    /// The tasks added from this event, done or not.
    in property <[SubtaskData]> tasks;
    in-out property <string> new-task;
    /// Where the event is in the window, when it was clicked there.
    in property <bool> anchored;
    in property <length> anchor-left;
    in property <length> anchor-right;
    in property <length> anchor-top;
    callback notes-edited(string);
    callback task-added(string);
    callback task-toggled(int);
    callback task-opened(int);
    callback edit();
    callback delete();
    callback dismissed();
    callback join(string);
    callback video-set(string);

    if root.anchored: Popover {
        width: 100%;
        height: 100%;
        anchor-left: root.anchor-left;
        anchor-right: root.anchor-right;
        anchor-top: root.anchor-top;
        card-width: 340px;
        dismissed => { root.dismissed(); }
        EventBody {
            detail: root.detail;
            notes <=> root.notes;
            tasks: root.tasks;
            new-task <=> root.new-task;
            notes-edited(t) => { root.notes-edited(t); }
            task-added(t) => { root.task-added(t); }
            task-toggled(id) => { root.task-toggled(id); }
            task-opened(id) => { root.task-opened(id); }
            edit => { root.edit(); }
            delete => { root.delete(); }
            dismissed => { root.dismissed(); }
            join(u) => { root.join(u); }
            video-set(u) => { root.video-set(u); }
        }
    }

    // Escape reaches the card even from a field, which hands the key up.
    if !root.anchored: FocusScope {
        enabled: false;
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                root.dismissed();
                return accept;
            }
            return reject;
        }
        Rectangle {
            background: Tokens.scrim;
        }
        TouchArea {
            clicked => { root.dismissed(); }
        }
        Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 380px;
            height: min(corps.preferred-height + 32px, parent.height - 60px);
            border-radius: Tokens.radius-large;
            background: Tokens.panel;
            border-width: 1px;
            border-color: Tokens.border-strong;
            drop-shadow-blur: 40px;
            drop-shadow-color: #000000b0;
            drop-shadow-offset-y: 14px;
            TouchArea {}
            corps := EventBody {
                x: 16px;
                y: 16px;
                width: parent.width - 32px;
                height: parent.height - 32px;
                detail: root.detail;
                notes <=> root.notes;
                tasks: root.tasks;
                new-task <=> root.new-task;
                notes-edited(t) => { root.notes-edited(t); }
                task-added(t) => { root.task-added(t); }
                task-toggled(id) => { root.task-toggled(id); }
                task-opened(id) => { root.task-opened(id); }
                edit => { root.edit(); }
                delete => { root.delete(); }
                dismissed => { root.dismissed(); }
                join(u) => { root.join(u); }
                video-set(u) => { root.video-set(u); }
            }
        }
    }
}

// A date shown as words, that opens the small month when clicked.
export component DateButton inherits Rectangle {
    in property <string> text;
    in property <bool> open;
    callback clicked();

    height: 30px;
    border-radius: Tokens.radius-small;
    border-width: 1px;
    // Like a text field: the border says where the attention is, the background
    // never changes.
    border-color: root.open ? Tokens.accent : touch.has-hover ? Tokens.border-strong : Tokens.border;
    background: Tokens.surface;

    accessible-role: button;
    accessible-value: root.text;
    accessible-expanded: root.open;
    accessible-action-default => { root.clicked(); }

    HorizontalLayout {
        padding-left: Tokens.space-2;
        padding-right: Tokens.space-2;
        spacing: Tokens.space-2;
        Icon {
            y: (parent.height - self.height) / 2;
            data: Icons.calendar;
            size: 13px;
            tint: Tokens.text-muted;
        }
        Text {
            text: root.text;
            font-size: Tokens.size-body;
            color: Tokens.text;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }
        Icon {
            y: (parent.height - self.height) / 2;
            data: root.open ? Icons.chevron-up : Icons.chevron-down;
            size: 11px;
            tint: Tokens.text-muted;
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// The small month under a date: month by month, one click on the day.
export component DatePicker inherits Rectangle {
    in property <string> title;
    in property <[MonthCellData]> cells;
    callback navigate(int);
    callback chosen(string);

    height: 204px;
    vertical-stretch: 0;
    border-radius: Tokens.radius-medium;
    border-width: 1px;
    border-color: Tokens.border;
    background: Tokens.surface-low;

    MiniMonth {
        width: min(280px, parent.width - 2 * Tokens.space-2);
        x: (parent.width - self.width) / 2;
        y: Tokens.space-1;
        title: root.title;
        cells: root.cells;
        day-chosen(d) => { root.chosen(d); }
        navigate(n) => { root.navigate(n); }
    }
}

// Creating or changing an event in a local calendar.
export component EventEditorPanel inherits Rectangle {
    in property <bool> is-new;
    in-out property <string> title;
    in-out property <bool> all-day;
    in-out property <string> start-date;
    in-out property <string> start-time;
    in-out property <string> end-date;
    in-out property <string> end-time;
    in-out property <string> location;
    in-out property <string> notes;
    in property <[string]> calendars;
    in-out property <int> calendar-index;
    in property <[string]> reminders;
    in-out property <int> reminder-index;
    in property <[string]> repeats;
    in-out property <int> repeat-index;
    in property <string> error;
    /// The dates as read: "Mon 28 Sep 2026".
    in property <string> start-label;
    in property <string> end-label;
    /// Which date the small month is open for: 0 start, 1 end, -1 none.
    in property <int> picker: -1;
    in property <string> picker-title;
    in property <[MonthCellData]> picker-cells;

    callback save();
    callback dismissed();
    callback picker-requested(int);
    callback picker-navigate(int);
    callback picker-chosen(string);
    callback picker-closed();

    PanelFrame {
        width: 100%;
        height: 100%;
        title: root.is-new ? "New event" : "Edit event";
        card-width: 520px;
        // The small month opens inside the card, which grows to hold it: nothing
        // floats over the other fields, so a click on any of them still lands.
        card-height: root.picker >= 0 ? 810px : 600px;
        dismissed => { root.dismissed(); }
        // The small month first: Escape folds it and leaves the event open.
        escaped => {
            if (root.picker >= 0) {
                root.picker-closed();
            } else {
                root.dismissed();
            }
        }

        Labelled {
            label: "Title";
            TextField {
                accessible-label: "Title";
                placeholder-text: "What is it?";
                text <=> root.title;
                // Opened to write: the first key goes to the title.
                init => { self.focus(); }
                accepted => { root.save(); }
            }
        }

        CheckBox {
            text: "All day";
            checked <=> root.all-day;
        }

        HorizontalLayout {
            spacing: Tokens.space-2;
            vertical-stretch: 0;
            Labelled {
                label: "Starts";
                DateButton {
                    accessible-label: "Start date";
                    text: root.start-label;
                    open: root.picker == 0;
                    clicked => { root.picker-requested(0); }
                }
            }
            if !root.all-day: Labelled {
                label: " ";
                width: 90px;
                TextField {
                    accessible-label: "Start time";
                    placeholder-text: "HH:MM";
                    text <=> root.start-time;
                }
            }
        }

        if root.picker == 0: DatePicker {
            title: root.picker-title;
            cells: root.picker-cells;
            navigate(n) => { root.picker-navigate(n); }
            chosen(d) => { root.picker-chosen(d); }
        }

        HorizontalLayout {
            spacing: Tokens.space-2;
            vertical-stretch: 0;
            Labelled {
                label: "Ends";
                DateButton {
                    accessible-label: "End date";
                    text: root.end-label;
                    open: root.picker == 1;
                    clicked => { root.picker-requested(1); }
                }
            }
            if !root.all-day: Labelled {
                label: " ";
                width: 90px;
                TextField {
                    accessible-label: "End time";
                    placeholder-text: "HH:MM";
                    text <=> root.end-time;
                }
            }
        }

        if root.picker == 1: DatePicker {
            title: root.picker-title;
            cells: root.picker-cells;
            navigate(n) => { root.picker-navigate(n); }
            chosen(d) => { root.picker-chosen(d); }
        }

        HorizontalLayout {
            spacing: Tokens.space-2;
            vertical-stretch: 0;
            Labelled {
                label: "Calendar";
                ComboBox {
                    model: root.calendars;
                    current-index <=> root.calendar-index;
                }
            }
            Labelled {
                label: "Repeats";
                ComboBox {
                    model: root.repeats;
                    current-index <=> root.repeat-index;
                }
            }
            Labelled {
                label: "Reminder";
                ComboBox {
                    model: root.reminders;
                    current-index <=> root.reminder-index;
                }
            }
        }

        Labelled {
            label: "Location";
            TextField {
                accessible-label: "Location";
                placeholder-text: "Where";
                text <=> root.location;
            }
        }

        Labelled {
            label: "Notes";
            vertical-stretch: 1;
            TextArea {
                accessible-label: "Notes";
                vertical-stretch: 1;
                text <=> root.notes;
            }
        }

        if root.error != "": Text {
            text: root.error;
            font-size: Tokens.size-small;
            color: Tokens.error;
            wrap: word-wrap;
        }

        HorizontalLayout {
            height: 28px;
            spacing: Tokens.space-2;
            vertical-stretch: 0;
            Rectangle {}
            CalButton {
                text: "Cancel";
                clicked => { root.dismissed(); }
            }
            CalButton {
                text: "Save";
                primary: true;
                clicked => { root.save(); }
            }
        }
    }
}

// Following a calendar published as a link.
export component SubscribePanel inherits Rectangle {
    in-out property <string> url;
    in-out property <string> name;
    in property <bool> busy;
    in property <string> error;

    callback subscribe();
    callback dismissed();

    PanelFrame {
        width: 100%;
        height: 100%;
        title: "Subscribe to a calendar";
        card-height: 340px;
        dismissed => { if (!root.busy) { root.dismissed(); } }

        Text {
            text: "Paste the calendar's public or secret link: the iCal / .ics address that "
                + "Google Calendar, Outlook, iCloud, a school or a club publishes. "
                + "Iris reads it now and every half hour after; it stays read-only here.";
            font-size: Tokens.size-small;
            color: Tokens.text-secondary;
            wrap: word-wrap;
        }

        Labelled {
            label: "Link";
            TextField {
                accessible-label: "Calendar link";
                placeholder-text: "webcal://… or https://….ics";
                text <=> root.url;
                init => { self.focus(); }
                accepted => { root.subscribe(); }
            }
        }

        Labelled {
            label: "Name (optional)";
            TextField {
                accessible-label: "Calendar name";
                placeholder-text: "Taken from the calendar when empty";
                text <=> root.name;
                accepted => { root.subscribe(); }
            }
        }

        if root.error != "": Text {
            text: root.error;
            font-size: Tokens.size-small;
            color: Tokens.error;
            wrap: word-wrap;
        }
        if root.busy: Text {
            text: "Reading the calendar…";
            font-size: Tokens.size-small;
            color: Tokens.text-muted;
        }

        Rectangle {}

        HorizontalLayout {
            height: 28px;
            spacing: Tokens.space-2;
            vertical-stretch: 0;
            Rectangle {}
            CalButton {
                text: "Cancel";
                enabled: !root.busy;
                clicked => { root.dismissed(); }
            }
            CalButton {
                text: "Subscribe";
                primary: true;
                enabled: !root.busy;
                clicked => { root.subscribe(); }
            }
        }
    }
}

// Right click on a calendar in the list.
export component CalendarContextMenu inherits Rectangle {
    in property <CalendarData> cal;
    in property <[color]> palette;
    in property <length> menu-x;
    in property <length> menu-y;

    callback color-chosen(int);
    callback refresh();
    callback rename();
    callback remove();
    callback dismissed();

    TouchArea {
        width: 100%;
        height: 100%;
        clicked => { root.dismissed(); }
    }

    MenuSurface {
        available-width: root.width;
        available-height: root.height;
        menu-x: root.menu-x;
        menu-y: root.menu-y;
        menu-width: 220px;
        menu-height: entries.preferred-height + 8px;

        entries := VerticalLayout {
            padding: 4px;

            HorizontalLayout {
                padding-left: Tokens.space-2;
                padding-right: Tokens.space-2;
                height: 22px;
                Text {
                    text: root.cal.name;
                    font-size: 9px;
                    letter-spacing: 0.5px;
                    color: Tokens.text-muted;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }

            MenuSeparator {}

            if root.cal.subscribed: MenuEntry {
                icon: Icons.refresh;
                label: "Refresh now";
                activated => { root.refresh(); }
            }
            MenuEntry {
                icon: Icons.pencil;
                label: "Rename…";
                activated => { root.rename(); }
            }

            // The colour: one click on a swatch, no dialog.
            HorizontalLayout {
                padding-left: Tokens.space-2;
                padding-right: Tokens.space-2;
                padding-top: 4px;
                padding-bottom: 4px;
                spacing: 5px;
                height: 30px;
                for couleur[i] in root.palette: Rectangle {
                    width: 20px;
                    height: 20px;
                    y: (parent.height - self.height) / 2;
                    border-radius: 10px;
                    background: couleur;
                    border-width: root.cal.color == couleur ? 2px : (pastille.has-hover ? 2px : 0px);
                    border-color: root.cal.color == couleur ? Tokens.text : Tokens.border-strong;

                    accessible-role: button;
                    accessible-label: "Colour " + (i + 1);
                    accessible-action-default => { root.color-chosen(i); }

                    if root.cal.color == couleur: Icon {
                        data: Icons.check;
                        size: 11px;
                        weight: 3.0;
                        tint: white;
                    }
                    pastille := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.color-chosen(i); }
                    }
                }
                Rectangle {}
            }

            if root.cal.deletable: MenuSeparator {}

            if root.cal.deletable: MenuEntry {
                icon: Icons.trash;
                label: root.cal.subscribed ? "Unsubscribe…" : "Delete calendar…";
                danger: true;
                activated => { root.remove(); }
            }
        }
    }
}

// What a right-click on an event offers: open it, change it, give it a colour of its
// own, delete it. Changing and deleting only in a calendar of one's own; a colour
// anywhere, subscribed calendars included, since it is kept on this computer.
export component EventContextMenu inherits Rectangle {
    in property <EventDetailData> event;
    in property <[color]> palette;
    in property <length> menu-x;
    in property <length> menu-y;

    callback open();
    callback edit();
    callback delete();
    /// A swatch of the palette; -1 for the calendar's colour again.
    callback color-chosen(int);
    callback dismissed();

    TouchArea {
        width: 100%;
        height: 100%;
        clicked => { root.dismissed(); }
        // A right-click elsewhere closes it too, rather than being swallowed.
        pointer-event(ev) => {
            if (ev.button == PointerEventButton.right && ev.kind == PointerEventKind.down) {
                root.dismissed();
            }
        }
    }

    MenuSurface {
        available-width: root.width;
        available-height: root.height;
        menu-x: root.menu-x;
        menu-y: root.menu-y;
        menu-width: 236px;
        menu-height: entries.preferred-height + 8px;

        entries := VerticalLayout {
            padding: 4px;

            MenuHeader {
                text: root.event.title;
            }

            MenuEntry {
                icon: Icons.calendar;
                label: "Open";
                activated => { root.open(); }
            }
            if root.event.editable: MenuEntry {
                icon: Icons.pencil;
                label: "Edit…";
                activated => { root.edit(); }
            }

            MenuSeparator {}

            // Its colour: one click on a swatch; the ring marks the one it wears.
            HorizontalLayout {
                padding-left: Tokens.space-2;
                padding-right: Tokens.space-2;
                padding-top: 4px;
                padding-bottom: 2px;
                spacing: 5px;
                height: 30px;
                for couleur[i] in root.palette: rond := Rectangle {
                    property <bool> portee: root.event.own-color && root.event.color == couleur;
                    width: 20px;
                    height: 20px;
                    y: (parent.height - self.height) / 2;
                    border-radius: 10px;
                    background: couleur;
                    border-width: self.portee || pastille.has-hover ? 2px : 0px;
                    border-color: self.portee ? Tokens.text : Tokens.border-strong;

                    accessible-role: button;
                    accessible-label: "Event colour " + (i + 1);
                    accessible-action-default => { root.color-chosen(i); }

                    if rond.portee: Icon {
                        data: Icons.check;
                        size: 11px;
                        weight: 3.0;
                        tint: white;
                    }
                    pastille := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.color-chosen(i); }
                    }
                }
                Rectangle {}
            }
            if root.event.own-color: MenuEntry {
                icon: Icons.refresh;
                label: "Use the calendar's colour";
                activated => { root.color-chosen(-1); }
            }

            if root.event.editable: MenuSeparator {}
            if root.event.editable: MenuEntry {
                icon: Icons.trash;
                label: "Delete";
                danger: true;
                activated => { root.delete(); }
            }
        }
    }
}

// A new name for a calendar.
export component CalendarRenamePanel inherits Rectangle {
    /// Naming a calendar that does not exist yet, rather than renaming one.
    in property <bool> is-new;
    in-out property <string> name;
    in property <string> error;
    callback rename();
    callback dismissed();

    PanelFrame {
        width: 100%;
        height: 100%;
        title: root.is-new ? "New calendar" : "Rename calendar";
        card-height: 200px;
        dismissed => { root.dismissed(); }

        TextField {
            accessible-label: "Calendar name";
            placeholder-text: "Work, Family, Sport…";
            text <=> root.name;
            // Opened to type: the name is selected, the first key replaces it.
            init => {
                self.focus();
                self.select-all();
            }
            accepted => { root.rename(); }
        }

        if root.error != "": Text {
            text: root.error;
            font-size: Tokens.size-small;
            color: Tokens.error;
            wrap: word-wrap;
        }

        Rectangle {}

        HorizontalLayout {
            height: 28px;
            spacing: Tokens.space-2;
            vertical-stretch: 0;
            Rectangle {}
            CalButton {
                text: "Cancel";
                clicked => { root.dismissed(); }
            }
            CalButton {
                text: root.is-new ? "Create" : "Rename";
                primary: true;
                clicked => { root.rename(); }
            }
        }
    }
}

// Removing a calendar asks first: its events go with it.
export component CalendarDeletePanel inherits Rectangle {
    in property <CalendarData> cal;
    callback confirmed();
    callback dismissed();

    PanelFrame {
        width: 100%;
        height: 100%;
        title: root.cal.subscribed ? "Unsubscribe from this calendar?" : "Delete this calendar?";
        card-height: 210px;
        dismissed => { root.dismissed(); }

        Text {
            text: root.cal.subscribed
                ? "“" + root.cal.name + "” and its events leave Iris. The calendar itself is not "
                    + "touched: you can subscribe again with its link."
                : "“" + root.cal.name + "” and every event in it are deleted from this computer. "
                    + "This cannot be undone.";
            font-size: Tokens.size-body;
            color: Tokens.text-secondary;
            wrap: word-wrap;
        }

        Rectangle {}

        HorizontalLayout {
            height: 28px;
            spacing: Tokens.space-2;
            vertical-stretch: 0;
            Rectangle {}
            CalButton {
                text: "Cancel";
                clicked => { root.dismissed(); }
            }
            CalButton {
                text: root.cal.subscribed ? "Unsubscribe" : "Delete";
                primary: true;
                danger: true;
                clicked => { root.confirmed(); }
            }
        }
    }
}
