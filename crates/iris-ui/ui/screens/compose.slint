import { Avatar } from "@iris/base/atoms.slint";
import { Tokens } from "@iris/theme/tokens.slint";
import { Layout } from "@iris/theme/layout.slint";
import { TextField, TextArea } from "@iris/controls/field.slint";
import { Floating } from "@iris/base/glass.slint";
import { Icon, Icons, IconButton } from "@iris/base/icons.slint";
import { ListView } from "std-widgets.slint";
import { ComboBox } from "@iris/controls/pickers.slint";
import { MenuEntry, MenuHeader, MenuSurface } from "@iris/layout/menu.slint";
import { Modal, ModalKind, ModalFooter, Popover } from "@iris/layout/frames.slint";
import { FormatBar as KeyboardBar } from "@iris/controls/formatbar.slint";
import { Button, ButtonKind, BlockButton } from "@iris/controls/button.slint";
import { ScheduledMailData } from "@iris/types.slint";
import { Pill } from "@iris/controls/choice.slint";

/// One recipient of an address field, drawn as a chip.
export struct RecipientChipData {
    /// The name when there is one, else the address.
    label: string,
    address: string,
    /// It reads as an email address.
    valid: bool,
}

/// What a key typed in an address field leaves: the recipients made into chips (the
/// field's comma-separated form) and what is still being typed.
export struct RecipientEditData {
    head: string,
    pending: string,
}

/// What Iris knows of a recipient whose chip was clicked: what its mail says of them.
export struct RecipientCardData {
    /// The address asked about, as the chip has it: the card shows it only for that one.
    address: string,
    /// The name their mail carries, when the chip has none.
    name: string,
    initials: string,
    /// "12 messages received", empty for someone who never wrote.
    received: string,
    /// "Last message Tue 3 Oct 2026, 09:12", empty for someone who never wrote.
    last: string,
}

/// An earlier message of the conversation a reply answers, under what is written.
export struct QuotedMessageData {
    from: string,
    date: string,
    text: string,
}

// How the address fields cut what is typed into recipients: Rust's
// (`iris_ui::recipients::install`). Until it is wired, they are plain text fields.
export global ComposeRecipients {
    in property <bool> ready;
    /// The chips of a field's recipients.
    pure callback chips(string) -> [RecipientChipData];
    /// Every entry of a field, what is being typed included, as recipients.
    pure callback committed(string) -> string;
    /// The field's text: its recipients, then what is being typed.
    pure callback joined(string, string) -> string;
    /// The recipients and what is typed after them, once a key has been typed.
    pure callback typing(string, string) -> RecipientEditData;
    /// The recipients without the one at an index.
    pure callback remove(string, int) -> string;
    /// A field's recipients, one after the other, for saying whom a message goes to.
    pure callback listed(string) -> string;
}

// The messages waiting to be sent later: to whom, about what, when; each can go now,
// or come back into the composer to be changed (and leaves the waiting ones).
export component ScheduledPanel inherits Rectangle {
    in property <[ScheduledMailData]> rows;
    callback edit(int);
    callback send-now(int);
    callback dismissed();

    Modal {
        width: 100%;
        height: 100%;
        title: "Scheduled";
        card-width: 520px;
        fit: true;
        dismissed => { root.dismissed(); }

        for m in root.rows: Rectangle {
            height: 52px;
            HorizontalLayout {
                spacing: 10px;
                Icon {
                    y: (parent.height - self.height) / 2;
                    data: Icons.clock;
                    size: 16px;
                    tint: Tokens.accent;
                }
                VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 1;
                    Text {
                        text: m.subject == "" ? "(No subject)" : m.subject;
                        font-size: 13px;
                        font-weight: 600;
                        color: Tokens.text;
                        overflow: elide;
                    }
                    Text {
                        text: m.when + "  ·  to " + m.to;
                        font-size: 12px;
                        color: Tokens.text-muted;
                        overflow: elide;
                    }
                }
                IconButton {
                    y: (parent.height - self.height) / 2;
                    icon: Icons.pencil;
                    label: "Edit " + m.subject;
                    button-size: 28px;
                    clicked => { root.edit(m.id); }
                }
                IconButton {
                    y: (parent.height - self.height) / 2;
                    icon: Icons.send;
                    label: "Send " + m.subject + " now";
                    button-size: 28px;
                    clicked => { root.send-now(m.id); }
                }
            }
            Rectangle {
                y: parent.height - 1px;
                height: 1px;
                background: Tokens.border;
            }
        }
        if root.rows.length == 0: Text {
            text: "Nothing waiting.";
            font-size: 13px;
            color: Tokens.text-muted;
        }
    }
}

// One recipient of an address field: its name (or address) on a rounded chip, and a
// small cross that takes it out. One that is not an address is drawn in red. A click
// on the name opens the person's card at once.
component RecipientChip inherits Rectangle {
    in property <string> text;
    in property <string> address;
    in property <bool> valid: true;
    callback removed();
    callback opened();
    /// The widest the words may be: on a phone, the whole line beside the label.
    in property <length> cap: 220px;

    height: Layout.compact ? 30px : 22px;
    width: min(root.cap, mesure.preferred-width) + 34px;
    border-radius: self.height / 2;
    background: root.valid ? Tokens.surface-active : Tokens.error.transparentize(0.86);
    border-width: root.valid ? 0px : 1px;
    border-color: Tokens.error;

    // Measured apart: the words shown are cut to the chip, which is cut to them.
    mesure := Text {
        visible: false;
        text: root.text;
        font-size: Layout.compact ? 15px : Tokens.size-small;
    }

    // The name takes the click that opens the card, the cross aside. The address,
    // pointed at, when the chip shows a name.
    Rectangle {
        x: 0px;
        width: root.width - 22px;
        accessible-role: button;
        accessible-label: "Show " + (root.address == "" ? root.text : root.address);
        accessible-action-default => { root.opened(); }
        TouchArea {
            mouse-cursor: pointer;
            clicked => { root.opened(); }
        }
        if root.address != root.text: Tooltip { text: @markdown("\{root.address}"); }
    }

    Text {
        x: Layout.compact ? 12px : 10px;
        width: root.width - 34px;
        height: root.height;
        text: root.text;
        font-size: Layout.compact ? 15px : Tokens.size-small;
        color: root.valid ? Tokens.text : Tokens.error;
        vertical-alignment: center;
        overflow: elide;
    }

    Rectangle {
        x: root.width - (Layout.compact ? 24px : 20px);
        y: (root.height - self.height) / 2;
        width: Layout.compact ? 20px : 16px;
        height: self.width;
        border-radius: self.width / 2;
        background: retirer.has-hover ? Tokens.surface-hover : transparent;

        accessible-role: button;
        accessible-label: "Remove " + (root.address == "" ? root.text : root.address);
        accessible-action-default => { root.removed(); }

        Icon {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            data: Icons.window-close;
            size: 10px;
            tint: retirer.has-hover ? Tokens.text : Tokens.text-muted;
        }
        retirer := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.removed(); }
        }
    }
}

// One labelled field of the header block.
//
// An address field (`addresses`) makes each recipient a chip as soon as it is whole:
// a comma, a semicolon, a space after an address, Enter, leaving the field, or a
// suggestion picked. Backspace in the empty field takes the last chip back. The text
// behind it stays what sending reads: the recipients, comma separated.
component Field inherits VerticalLayout {
    in property <string> label;
    in property <string> placeholder;
    in-out property <string> value;
    /// Les correspondants qui ressemblent à ce qu'on tape. Vide : rien ne s'affiche.
    in property <[string]> suggestions;
    /// A phone's list: a name over its address, beside a face.
    in property <[string]> suggestion-names;
    in property <[string]> suggestion-addresses;
    in property <[string]> suggestion-initials;
    /// Take the keyboard as soon as the field appears.
    in property <bool> autofocus;
    /// Recipients, each made a chip.
    in property <bool> addresses;

    callback accepted();
    callback edited(string);
    callback picked(string);
    /// A chip clicked: its words and address, and where it is in the window (its left
    /// and right edges, its top), for the card to open beside it.
    callback chip-opened(string, string, length, length, length);
    out property <bool> has-focus: champ.has-focus;

    // On a phone, the mockups' rows (M10): fifty pixels, no box, a hairline across the
    // whole width under each, the accent and two pixels under the one being typed in.
    property <bool> tel: Layout.compact;
    property <length> etiquette: root.tel ? (root.label == "Subject" ? 56px : 40px) : 34px;
    /// A phone's line: a chip's, or the one being typed in under the chips.
    property <length> ligne: root.chips.length > 0 ? 38px : 50px;

    spacing: root.tel ? 0px : 2px;

    property <bool> puces: root.addresses && ComposeRecipients.ready;
    /// The recipients made into chips, and what is being typed after them.
    property <string> head;
    property <string> pending;
    property <[RecipientChipData]> chips: ComposeRecipients.chips(root.puces ? root.head : "");

    // Written from outside (a reply's sender, a suggestion picked, a draft reopened):
    // all of it becomes chips.
    function sync() {
        if (root.puces) {
            if (root.value != ComposeRecipients.joined(root.head, root.pending)) {
                root.head = ComposeRecipients.committed(root.value);
                root.pending = "";
            }
        } else if (root.value != root.pending) {
            root.pending = root.value;
        }
    }
    function typed(t: string) {
        if (root.puces) {
            let suite = ComposeRecipients.typing(root.head, t);
            // Each field of the local is read once: Slint's generated Rust moves them.
            root.head = suite.head;
            root.pending = suite.pending;
            root.value = ComposeRecipients.joined(root.head, root.pending);
        } else {
            root.value = t;
        }
        root.edited(root.value);
    }
    function commit() {
        if (root.puces && root.pending != "") {
            root.typed(root.pending + ",");
        }
    }
    function remove(i: int) {
        root.head = ComposeRecipients.remove(root.head, i);
        root.value = ComposeRecipients.joined(root.head, root.pending);
    }
    // A chip clicked is its field clicked: the cursor goes there (on a PC; a phone's
    // keyboard would rise over the card), and the card opens beside the chip.
    function open-chip(label: string, address: string, left: length, right: length, top: length) {
        if (!root.tel) {
            champ.focus();
        }
        root.chip-opened(label, address, left, right, top);
    }

    init => { root.sync(); }
    changed value => { root.sync(); }
    // Leaving the field (Tab, a click elsewhere) ends what was typed in it.
    property <bool> actif: champ.has-focus;
    changed actif => {
        if (!root.actif) {
            root.commit();
        }
    }

    HorizontalLayout {
        spacing: root.tel ? 12px : Tokens.space-2;
        padding-left: root.tel ? 18px : 0px;
        padding-right: root.tel ? 18px : 0px;
        // A phone's chips one under the other, then the line: never cut at the left.
        padding-top: root.tel && root.chips.length > 0 ? 6px : 0px;
        padding-bottom: root.tel && root.chips.length > 0 ? 6px : 0px;
        height: root.tel ? self.preferred-height : 30px;

        VerticalLayout {
            width: root.etiquette;
            alignment: start;
            Text {
                height: root.tel ? root.ligne : 30px;
                text: root.label;
                font-size: root.tel ? 15px : Tokens.size-small;
                color: Tokens.text-muted;
                vertical-alignment: center;
            }
        }

        colonne := VerticalLayout {
            horizontal-stretch: 1;
            spacing: 0px;

            if root.tel && root.chips.length > 0: VerticalLayout {
                for puce[i] in root.chips: HorizontalLayout {
                    alignment: start;
                    height: root.ligne;
                    RecipientChip {
                        y: (parent.height - self.height) / 2;
                        // From the window, not the column: the column's width comes from
                        // its chips, and back again would loop.
                        cap: Layout.window-width - 36px - root.etiquette - 12px - 34px;
                        text: puce.label;
                        address: puce.address;
                        valid: puce.valid;
                        removed => { root.remove(i); }
                        opened => {
                            root.open-chip(puce.label, puce.address, self.absolute-position.x,
                                self.absolute-position.x + self.width, self.absolute-position.y);
                        }
                    }
                }
            }

        // The field's box: its chips, then the line being typed in. Longer than the
        // box, it slides left to keep the cursor in view, as a line of text does.
        cadre := Rectangle {
            height: root.tel ? root.ligne : 30px;
            background: root.tel ? transparent : Tokens.surface;
            border-radius: Tokens.radius-small;
            border-width: root.tel ? 0px : 1px;
            border-color: champ.has-focus ? Tokens.accent : Tokens.border-strong;
            clip: true;
            animate border-color { duration: Tokens.instant; }

            // The whole box takes the click, the chips aside: one click puts the
            // cursor here.
            TouchArea {
                mouse-cursor: MouseCursor.text;
                clicked => { champ.focus(); }
            }

            rang := HorizontalLayout {
                x: min(0px, cadre.width - self.width);
                width: max(cadre.width, self.preferred-width);
                height: cadre.height;
                padding-left: root.chips.length > 0 && !root.tel ? 4px : 0px;
                spacing: 4px;

                if !root.tel: HorizontalLayout {
                    spacing: 4px;
                    for puce[i] in root.chips: RecipientChip {
                        y: (parent.height - self.height) / 2;
                        text: puce.label;
                        address: puce.address;
                        valid: puce.valid;
                        removed => { root.remove(i); }
                        opened => {
                            root.open-chip(puce.label, puce.address, self.absolute-position.x,
                                self.absolute-position.x + self.width, self.absolute-position.y);
                        }
                    }
                }

                // Backspace with nothing typed takes the last chip back. Seen before
                // the line, which would otherwise take the key and do nothing; never
                // focused itself, so it takes no click.
                FocusScope {
                    enabled: false;
                    min-width: 120px;
                    horizontal-stretch: 1;
                    capture-key-pressed(event) => {
                        if (root.puces && event.text == Key.Backspace && root.pending == ""
                            && root.chips.length > 0) {
                            root.remove(root.chips.length - 1);
                            return accept;
                        }
                        reject
                    }

                    champ := TextField {
                        width: parent.width;
                        height: parent.height;
                        bare: true;
                        // Ouvrir pour écrire, c'est vouloir écrire : sans cela, la
                        // première touche partait vers la liste derrière la fenêtre.
                        init => { if (root.autofocus) { self.focus(); } }
                        accessible-label: root.label;
                        placeholder-text: root.chips.length == 0 ? root.placeholder : "";
                        font-size: root.tel ? 15px : Tokens.size-body;
                        text <=> root.pending;
                        accepted => {
                            root.commit();
                            root.accepted();
                        }
                        edited(t) => { root.typed(t); }
                    }
                }
            }
        }
        } // colonne

        // What the row offers beside the field (Reply all, Cc Bcc).
        @children
    }

    if root.tel: Rectangle {
        height: champ.has-focus ? 2px : 1px;
        background: champ.has-focus ? Tokens.accent : Tokens.border;
    }

    // Les correspondants proposés, en pastilles sous le champ.
    //
    // Sous le champ et non par-dessus : une liste flottante demanderait une couche
    // au-dessus de tout, et ce fichier a déjà payé trois fois le prix de l'ordre
    // d'empilement. Ici rien ne recouvre rien — la fenêtre grandit de vingt-quatre
    // pixels le temps qu'on choisisse, et c'est tout.
    // On a phone, a card under the field as the mockups' C2: each a face, the name,
    // the address under it, a finger's height. Still under the field, never over.
    // Nothing offered before a letter is typed: an empty field asks for nothing.
    // The card stands out from the page: the panel's white, a border and the floating
    // shadow, inset from the edges.
    if Layout.compact && champ.has-focus && root.pending != "" && root.suggestions.length > 0: HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        padding-top: 2px;
        padding-bottom: 8px;
    Rectangle {
        height: liste-tel.preferred-height;
        border-radius: 14px;
        background: Tokens.panel;
        border-width: 1px;
        border-color: Tokens.border-strong;
        drop-shadow-blur: Tokens.shadow-float-blur;
        drop-shadow-offset-y: Tokens.shadow-float-y;
        drop-shadow-color: Tokens.shadow-float;
        liste-tel := VerticalLayout {
            padding-top: 4px;
            padding-bottom: 4px;
            for proposition[i] in root.suggestions: ligne-sugg := Rectangle {
                height: 56px;
                background: choix.pressed ? Tokens.surface-active : transparent;
                accessible-role: button;
                accessible-label: proposition;
                accessible-action-default => { root.picked(proposition); }
                property <string> nom: root.suggestion-names.length > i ? root.suggestion-names[i] : proposition;
                property <string> adresse: root.suggestion-addresses.length > i ? root.suggestion-addresses[i] : "";
                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    spacing: 12px;
                    Avatar {
                        y: (parent.height - self.height) / 2;
                        size: 32px;
                        initials: root.suggestion-initials.length > i ? root.suggestion-initials[i] : "";
                        tint: Tokens.accent;
                    }
                    VerticalLayout {
                        alignment: center;
                        spacing: 1px;
                        Text {
                            text: ligne-sugg.nom;
                            font-size: 15px;
                            color: Tokens.text;
                            overflow: elide;
                        }
                        if ligne-sugg.adresse != "": Text {
                            text: ligne-sugg.adresse;
                            font-size: 13px;
                            color: Tokens.text-muted;
                            overflow: elide;
                        }
                    }
                }
                choix := TouchArea {
                    clicked => { root.picked(proposition); }
                }
            }
        }
    }
    }
    if !Layout.compact && champ.has-focus && root.pending != "" && root.suggestions.length > 0: HorizontalLayout {
        padding-left: 34px + Tokens.space-2;
        spacing: Tokens.space-1;
        height: 24px;

        for proposition in root.suggestions: Rectangle {
            width: etiquette.preferred-width + 2 * Tokens.space-2;
            border-radius: Tokens.radius-small;
            background: pastille.has-hover ? Tokens.accent : Tokens.surface;
            border-width: 1px;
            border-color: Tokens.border;
            animate background { duration: Tokens.instant; }

            accessible-role: button;
            accessible-label: proposition;
            accessible-action-default => { root.picked(proposition); }

            etiquette := Text {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                text: proposition;
                font-size: Tokens.size-small;
                color: pastille.has-hover ? Tokens.accent-text : Tokens.text-secondary;
                overflow: elide;
            }

            pastille := TouchArea {
                clicked => { root.picked(proposition); }
            }
        }

        Rectangle {}
    }
}

// The formatting strip.
//
// Only what people actually reach for. A word processor's worth of controls in a
// mail window is a row of buttons nobody presses, taking the space the message needs.
component FormatBar inherits HorizontalLayout {
    callback apply(string);

    spacing: 1px;
    height: 26px;

    IconButton {
        icon: Icons.bold;
        label: "Bold";
        shortcut: "Ctrl+B";
        button-size: 26px;
        icon-size: 15px;
        clicked => { root.apply("bold"); }
    }
    IconButton {
        icon: Icons.italic;
        label: "Italic";
        shortcut: "Ctrl+I";
        button-size: 26px;
        icon-size: 15px;
        clicked => { root.apply("italic"); }
    }
    IconButton {
        icon: Icons.underline;
        label: "Underline";
        shortcut: "Ctrl+U";
        button-size: 26px;
        icon-size: 15px;
        clicked => { root.apply("underline"); }
    }

    Rectangle { width: Tokens.space-2; }

    IconButton {
        icon: Icons.link;
        label: "Insert link";
        shortcut: "Ctrl+K";
        button-size: 26px;
        icon-size: 15px;
        clicked => { root.apply("link"); }
    }
    IconButton {
        icon: Icons.list;
        label: "Bulleted list";
        button-size: 26px;
        icon-size: 15px;
        clicked => { root.apply("list"); }
    }
    IconButton {
        icon: Icons.quote;
        label: "Quote";
        button-size: 26px;
        icon-size: 15px;
        clicked => { root.apply("quote"); }
    }
    IconButton {
        icon: Icons.code;
        label: "Code";
        button-size: 26px;
        icon-size: 15px;
        clicked => { root.apply("code"); }
    }

    Rectangle {}
}

// An earlier message's words, under what is written: selected with the mouse and
// copied like any text, never written into.
component QuoteText inherits TextInput {
    read-only: true;
    single-line: false;
    wrap: word-wrap;
    color: Tokens.text-secondary;
    selection-background-color: Tokens.accent.transparentize(0.55);
    selection-foreground-color: Tokens.text;
    text-cursor-width: 0px;
}

// One thing known of a recipient on their card: what it is, its value, and a button
// that puts the value on the clipboard (a tick says it went).
component CardLine inherits Rectangle {
    in property <string> label;
    in property <string> value;
    /// The copy button's name: "Copy the address".
    in property <string> copy-label;
    callback copy(string);
    property <bool> copied;

    height: Layout.compact ? 52px : 40px;

    HorizontalLayout {
        spacing: 8px;
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            spacing: 1px;
            Text {
                text: root.label;
                font-size: Layout.compact ? 13px : Tokens.size-small;
                color: Tokens.text-muted;
                overflow: elide;
            }
            Text {
                text: root.value;
                font-size: Layout.compact ? 15px : Tokens.size-body;
                color: Tokens.text;
                overflow: elide;
            }
        }
        IconButton {
            y: (parent.height - self.height) / 2;
            icon: root.copied ? Icons.check : Icons.copy;
            label: root.copy-label;
            button-size: Layout.compact ? 40px : 28px;
            icon-size: Layout.compact ? 18px : 14px;
            clicked => {
                root.copy(root.value);
                root.copied = true;
            }
        }
    }
}

// Writing a message.
//
// A modal by default, because writing deserves the whole window, with one gesture to
// tuck it into the corner when a message needs checking mid-sentence. The two states
// are the same element at different sizes rather than two windows: the transition is
// then a single animation of x, y, width and height, and the draft cannot be lost in
// the handover because there is no handover.
// A message minimised: a bar at the foot of the window, the size the window shrinks to,
// its subject on it. A click brings it back.
export component ParkedDraft inherits Rectangle {
    in property <string> text;
    callback opened();

    property <float> entree: 0;
    init => { root.entree = 1; }
    animate entree { duration: Tokens.quick; easing: ease-out; }

    width: 300px;
    height: 40px;
    opacity: root.entree;
    border-radius: Tokens.radius-large;
    border-width: 1px;
    border-color: touche.has-hover ? Tokens.border-strong : Tokens.border;
    background: Tokens.panel;
    drop-shadow-blur: Tokens.shadow-float-blur;
    drop-shadow-offset-y: Tokens.shadow-float-y;
    drop-shadow-color: Tokens.shadow-float;

    accessible-role: button;
    accessible-label: "Open the draft " + root.text;
    accessible-action-default => { root.opened(); }

    touche := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.opened(); }
    }
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 10px;
        spacing: 8px;
        Icon {
            y: (parent.height - self.height) / 2;
            width: 14px;
            data: Icons.pencil;
            size: 13px;
            tint: Tokens.text-muted;
        }
        Text {
            text: root.text;
            font-size: Tokens.size-body;
            font-weight: Tokens.weight-bold;
            color: Tokens.text;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }
        Icon {
            y: (parent.height - self.height) / 2;
            width: 14px;
            data: Icons.window-maximise;
            size: 13px;
            tint: touche.has-hover ? Tokens.text : Tokens.text-muted;
        }
    }
}

export component ComposePanel inherits Rectangle {
    in property <[string]> senders;
    in property <int> sender-index;
    in property <string> error;
    in property <[string]> attachments;
    /// The question asked on closing a message with something in it.
    in-out property <bool> confirm-close;
    in-out property <bool> minimised;
    /// Where the bar it opens from sits, across; below zero, the right-hand corner.
    in property <length> parked-x: -1px;
    /// Minimised: taken down to a bar at the foot of the window, the window freed.
    callback park();
    in-out property <bool> show-cc;
    in-out property <string> to;
    in-out property <string> cc;
    in-out property <string> bcc;
    in-out property <string> subject;
    in-out property <string> body;

    /// Answering a conversation: "Reply" on the title, Reply all beside To, and the
    /// earlier messages under the body.
    in property <bool> replying;
    /// The others of the conversation are in copy.
    in property <bool> reply-all;
    /// There are others than the sender to answer.
    in property <bool> can-reply-all;
    /// Reply all switched on or off: the others put in copy, or taken out.
    callback reply-all-toggled(bool);
    /// The conversation's earlier messages, newest first, inside the writing field
    /// under what is written; each folds on its own (only on screen: what is sent
    /// quotes the conversation the same, folded or not).
    in property <[QuotedMessageData]> history;
    property <bool> quoting: root.replying && root.history.length > 0;

    /// A recipient's card, open beside the chip clicked: whom it is about (the chip's
    /// words and address) and where the chip is, in this panel's coordinates.
    in-out property <bool> card-open;
    property <string> card-label;
    property <string> card-address;
    property <length> card-left;
    property <length> card-right;
    property <length> card-top;
    /// What Iris knows of them, given by Rust once asked (`card-asked`: the chip's
    /// words, its address). It is about the chip clicked only when its address is.
    in property <RecipientCardData> card;
    callback card-asked(string, string);
    /// A value of the card, to the clipboard.
    callback copy(string);
    property <bool> card-known: root.card.address == root.card-address;
    /// The name, the chip's or else the one their mail carries; empty when neither.
    property <string> card-name: root.card-label != root.card-address ? root.card-label
        : (root.card-known ? root.card.name : "");
    function open-card(label: string, address: string, left: length, right: length, top: length) {
        root.card-label = label;
        root.card-address = address;
        root.card-left = left - root.absolute-position.x;
        root.card-right = right - root.absolute-position.x;
        root.card-top = top - root.absolute-position.y;
        root.card-open = true;
        root.card-asked(label, address);
    }
    // A card left open when the window last closed does not come back with it.
    init => { root.card-open = false; }
    // Tucked away or brought back, the chip it was beside has gone.
    changed minimised => { root.card-open = false; }
    /// Larger than the usual window: nine tenths of the application's, centred.
    in-out property <bool> expanded;

    // Whom it goes to, as the Send button says when pointed at.
    property <string> qui-a: ComposeRecipients.ready ? ComposeRecipients.listed(root.to) : root.to;
    property <string> qui-cc: ComposeRecipients.ready ? ComposeRecipients.listed(root.cc) : root.cc;
    property <string> qui-bcc: ComposeRecipients.ready ? ComposeRecipients.listed(root.bcc) : root.bcc;
    property <string> destinataires: (root.qui-a == "" ? "" : "To: " + root.qui-a)
        + (root.qui-cc == "" ? "" : (root.qui-a == "" ? "" : "  ·  ") + "Cc: " + root.qui-cc)
        + (root.qui-bcc == "" ? ""
            : (root.qui-a == "" && root.qui-cc == "" ? "" : "  ·  ") + "Bcc: " + root.qui-bcc);

    callback send();
    /// When to send it instead: its place among `later-options`.
    callback send-later(int);
    /// "This evening, 18:00", "Tomorrow morning, 08:00"…
    in property <[string]> later-options;
    property <bool> later-open;
    property <length> later-x;
    property <length> later-y;
    /// Closed with nothing in it.
    callback dismissed();
    /// Closed, and what was written thrown away.
    callback discard();
    callback save-draft();
    callback sender-chosen(int);

    /// Anything written, added or attached: closing would lose it.
    property <bool> has-content: root.to != "" || root.cc != "" || root.bcc != ""
        || root.subject != "" || root.body != "" || root.attachments.length > 0;
    callback attach();
    callback attach-image();
    callback remove-attachment(int);
    /// A formatting key: what, and the words chosen in the body (bytes). Gives where
    /// the cursor goes after it.
    callback format(string, int, int) -> int;
    // The body's chosen words, kept by the field; where the cursor goes back after a key.
    property <int> sel-start: -1;
    property <int> sel-end: -1;
    property <int> select-at;
    property <int> select-tick;
    function formater(what: string) {
        root.select-at = root.format(what, root.sel-start, root.sel-end);
        root.select-tick += 1;
    }
    /// Les correspondants proposés pour le champ en cours de saisie.
    in property <[string]> suggestions;
    in property <[string]> suggestion-names;
    in property <[string]> suggestion-addresses;
    in property <[string]> suggestion-initials;
    callback recipient-typed(string, string);
    callback recipient-picked(string, string);

    // The two shapes, fixed: the corners are worked out from these and not from the
    // size being animated, so the window rises and grows at once instead of growing
    // where it was, then travelling.
    // Expanded, nearly the whole window: not full screen, the application still shows
    // round it.
    // On a phone, the whole window: a page of its own over the place.
    /// On a phone: the whole screen, the mockups' bar at the top.
    property <bool> tel: Layout.compact && !root.minimised;
    property <length> grand-w: Layout.compact ? root.width : root.expanded ? root.width * 0.9 : min(720px, root.width - 80px);
    property <length> grand-h: Layout.compact ? root.height : root.expanded ? root.height * 0.9 : min(600px, root.height - 80px);

    // The veil fades out as the window shrinks: a minimised draft must not keep the
    // rest of the application behind glass.
    background: root.minimised ? transparent : Tokens.scrim;
    animate background { duration: Tokens.moderate; easing: ease-in-out; }

    // Escape reaches the window even while a field has the cursor: it asks what to
    // do with what is written, and a second Escape answers "keep writing". Never
    // focused itself, so it takes no click away from the fields.
    FocusScope {
        enabled: false;
        key-pressed(event) => {
            if (event.text != Key.Escape) {
                return reject;
            }
            // A recipient's card closes first, the message stays as it was.
            if (root.card-open) {
                root.card-open = false;
            } else if (root.confirm-close) {
                root.confirm-close = false;
            } else if (root.has-content) {
                root.minimised = false;
                root.confirm-close = true;
            } else {
                root.dismissed();
            }
            return accept;
        }

    if !root.minimised: TouchArea {
        clicked => { root.park(); }
    }

    frame := Floating {
        radius: Layout.compact && !root.minimised ? 0px : Tokens.radius-large;
        // The morph. One element, four animated properties — nothing is created or
        // destroyed between the two states, so the text being typed survives.
        x: root.minimised
            ? (root.parked-x >= 0 ? root.parked-x : root.width - 300px - Tokens.space-3)
            : (root.width - root.grand-w) / 2;
        y: root.minimised
            ? root.height - 40px - Tokens.space-3
            : root.tel ? 0px : (root.height - root.grand-h) / 2;
        width: root.minimised ? 300px : root.grand-w;
        // On a phone, above the keyboard: the formatting keys stand on it.
        height: root.minimised ? 40px : root.tel ? root.height - Layout.keyboard : root.grand-h;

        animate x, y, width, height {
            duration: Tokens.moderate;
            easing: cubic-bezier(0.2, 0, 0, 1);
        }

        TouchArea {}

        // Where the cursor goes to put the keyboard down (Send later's sheet must not
        // be hidden under it): no size, under everything, so it takes no click.
        puits := FocusScope {
            x: 0px;
            y: 0px;
            width: 0px;
            height: 0px;
        }

        VerticalLayout {
            // On a phone the rows run edge to edge, each with its own margins and
            // hairline, as the mockups' (M10).
            padding: root.minimised ? Tokens.space-2 : Tokens.space-4;
            padding-left: root.tel ? 0px : root.minimised ? Tokens.space-2 : Tokens.space-4;
            padding-right: root.tel ? 0px : root.minimised ? Tokens.space-2 : Tokens.space-4;
            // Clear of the status bar and the gesture bar on a phone.
            padding-top: root.tel ? Layout.inset-top + 2px : root.minimised ? Tokens.space-2 : Tokens.space-4;
            padding-bottom: root.tel ? (Layout.keyboard > 0 ? 0px : Layout.inset-bottom)
                : root.minimised ? Tokens.space-2 : Tokens.space-4;
            spacing: root.minimised || root.tel ? 0px : Tokens.space-2;
            animate padding, spacing { duration: Tokens.moderate; }

            // --- Title row, present in both states ---
            HorizontalLayout {
                spacing: Tokens.space-2;
                padding-left: root.tel ? 4px : 0px;
                padding-right: root.tel ? 8px : 0px;
                height: root.minimised ? 24px : root.tel ? 52px : 28px;

                // On a phone, the mockups' bar (C1): close at the left, large; the
                // title; attach, later and Send at the right. No sizes to choose: the
                // message is the screen.
                if root.tel: IconButton {
                    y: (parent.height - self.height) / 2;
                    icon: Icons.window-close;
                    label: "Close message";
                    button-size: 44px;
                    icon-size: 22px;
                    clicked => {
                        if (root.has-content) {
                            root.confirm-close = true;
                        } else {
                            root.dismissed();
                        }
                    }
                }
                Text {
                    text: root.minimised
                        ? (root.subject == "" ? "New message" : root.subject)
                        : root.replying ? "Reply" : "New message";
                    font-family: root.tel ? Tokens.font-display : Tokens.font-family;
                    font-size: root.minimised ? Tokens.size-body : root.tel ? 18px : Tokens.size-title;
                    font-weight: Tokens.weight-bold;
                    color: Tokens.text;
                    vertical-alignment: center;
                    overflow: elide;
                }

                Rectangle {}

                // Larger, for a long message, and back.
                if !root.minimised && !root.tel: IconButton {
                    icon: root.expanded ? Icons.window-restore : Icons.expand;
                    label: root.expanded ? "Restore the size" : "Expand";
                    button-size: 24px;
                    icon-size: 14px;
                    clicked => { root.expanded = !root.expanded; }
                }
                if !root.tel: IconButton {
                    icon: root.minimised ? Icons.window-maximise : Icons.minus;
                    label: root.minimised ? "Expand" : "Minimise";
                    button-size: 24px;
                    icon-size: 14px;
                    clicked => {
                        if (root.minimised) {
                            root.minimised = false;
                        } else {
                            root.park();
                        }
                    }
                }
                if root.tel: IconButton {
                    y: (parent.height - self.height) / 2;
                    icon: Icons.paperclip;
                    label: "Attach a file";
                    button-size: 44px;
                    icon-size: 21px;
                    clicked => {
                        puits.focus();
                        root.attach();
                    }
                }
                // Later: Android wakes Iris at the hour chosen, closed or not.
                if root.tel: IconButton {
                    y: (parent.height - self.height) / 2;
                    icon: Icons.clock;
                    label: "Send later";
                    button-size: 44px;
                    icon-size: 21px;
                    clicked => {
                        // The keyboard down first: the times rise from where it was.
                        puits.focus();
                        root.later-x = self.absolute-position.x - root.absolute-position.x;
                        root.later-y = self.absolute-position.y - root.absolute-position.y;
                        root.later-open = true;
                    }
                }
                if root.tel: Rectangle {
                    y: (parent.height - self.height) / 2;
                    width: envoi.preferred-width + 32px;
                    height: 36px;
                    border-radius: 18px;
                    background: envoi-touch.pressed ? Tokens.accent.darker(0.15) : Tokens.accent;
                    opacity: root.to != "" ? 1 : 0.5;
                    accessible-role: button;
                    accessible-label: "Send";
                    accessible-description: root.destinataires;
                    accessible-enabled: root.to != "";
                    accessible-action-default => { root.send(); }
                    envoi := HorizontalLayout {
                        x: 16px;
                        width: self.preferred-width;
                        spacing: 6px;
                        Icon {
                            y: (parent.height - self.height) / 2;
                            data: Icons.send;
                            size: 16px;
                            tint: Tokens.accent-text;
                        }
                        Text {
                            text: "Send";
                            font-size: 15px;
                            font-weight: 600;
                            color: Tokens.accent-text;
                            vertical-alignment: center;
                        }
                    }
                    envoi-touch := TouchArea {
                        clicked => { root.send(); }
                    }
                }
                if !root.tel: IconButton {
                    icon: Icons.window-close;
                    label: "Close message";
                    button-size: 24px;
                    icon-size: 14px;
                    clicked => {
                        if (root.has-content) {
                            root.minimised = false;
                            root.confirm-close = true;
                        } else {
                            root.dismissed();
                        }
                    }
                }
            }

            // Everything below is hidden while tucked away. `if` rather than opacity,
            // so a minimised draft costs nothing to keep on screen.
            if !root.minimised: Rectangle { height: 1px; background: Tokens.border; }

            // --- Who it comes from ---
            //
            // A picker rather than a fixed address: with a hundred mailboxes, sending
            // from the wrong one is the mistake that costs, and it is invisible until
            // the reply arrives somewhere unexpected.
            if !root.minimised: VerticalLayout {
                HorizontalLayout {
                    spacing: root.tel ? 12px : Tokens.space-2;
                    padding-left: root.tel ? 18px : 0px;
                    padding-right: root.tel ? 18px : 0px;
                    height: root.tel ? 50px : 30px;

                    Text {
                        width: root.tel ? 40px : 34px;
                        text: "From";
                        font-size: root.tel ? 15px : Tokens.size-small;
                        color: Tokens.text-muted;
                        vertical-alignment: center;
                    }
                    ComboBox {
                        bare: root.tel;
                        accessible-label: "From";
                        model: root.senders;
                        current-index: root.sender-index;
                        selected(value) => { root.sender-chosen(self.current-index); }
                    }
                }
                if root.tel: Rectangle { height: 1px; background: Tokens.border; }
            }

            if !root.minimised: Field {
                    label: "To";
                    addresses: true;
                    autofocus: root.to == "";
                    placeholder: root.tel ? "" : "Separate addresses with commas";
                    value <=> root.to;
                    suggestions: root.suggestions;
                    suggestion-names: root.suggestion-names;
                    suggestion-addresses: root.suggestion-addresses;
                    suggestion-initials: root.suggestion-initials;
                    edited(t) => { root.recipient-typed("to", t); }
                    picked(c) => { root.recipient-picked("to", c); }
                    chip-opened(l, a, g, d, h) => { root.open-card(l, a, g, d, h); }

                // A reply goes to the sender; this puts the others of the
                // conversation in copy, and takes them out again.
                if root.replying && root.can-reply-all: Rectangle {
                    width: tous.width;
                    height: 30px;
                    tous := Pill {
                        y: (parent.height - self.height) / 2;
                        text: "Reply all";
                        icon: Icons.reply-all;
                        on: root.reply-all;
                        toggled => { root.reply-all-toggled(!root.reply-all); }
                    }
                }

                // Cc and Bcc stay folded until asked for. Most messages have neither,
                // and two empty fields at the top of every draft is two lines of
                // furniture between the writer and the writing. The button stays, to
                // fold them again; a field with something in it never folds away.
                Rectangle {
                    width: root.tel ? 64px : 54px;
                    height: root.tel ? 38px : 30px;
                    border-radius: Tokens.radius-small;
                    background: root.show-cc ? Tokens.surface-active
                        : cc-touch.has-hover ? Tokens.surface-hover : transparent;

                    accessible-role: button;
                    accessible-label: root.show-cc ? "Fold Cc and Bcc" : "Add Cc and Bcc";
                    accessible-action-default => { root.show-cc = !root.show-cc; }

                    Text {
                        text: "Cc Bcc";
                        font-size: root.tel ? 14px : Tokens.size-small;
                        color: root.show-cc ? Tokens.text-secondary : Tokens.text-muted;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    cc-touch := TouchArea {
                        clicked => { root.show-cc = !root.show-cc; }
                    }
                }
            }

            if !root.minimised && (root.show-cc || root.cc != ""): Field {
                label: "Cc";
                addresses: true;
                placeholder: "Also send to";
                value <=> root.cc;
                suggestions: root.suggestions;
                suggestion-names: root.suggestion-names;
                suggestion-addresses: root.suggestion-addresses;
                suggestion-initials: root.suggestion-initials;
                edited(t) => { root.recipient-typed("cc", t); }
                picked(c) => { root.recipient-picked("cc", c); }
                chip-opened(l, a, g, d, h) => { root.open-card(l, a, g, d, h); }
            }
            if !root.minimised && (root.show-cc || root.bcc != ""): Field {
                label: "Bcc";
                addresses: true;
                placeholder: "Send without showing the address";
                value <=> root.bcc;
                suggestions: root.suggestions;
                suggestion-names: root.suggestion-names;
                suggestion-addresses: root.suggestion-addresses;
                suggestion-initials: root.suggestion-initials;
                edited(t) => { root.recipient-typed("bcc", t); }
                picked(c) => { root.recipient-picked("bcc", c); }
                chip-opened(l, a, g, d, h) => { root.open-card(l, a, g, d, h); }
            }

            if !root.minimised: Field {
                label: "Subject";
                placeholder: "Subject";
                value <=> root.subject;
            }

            if !root.minimised && !root.tel: Rectangle { height: 1px; background: Tokens.border; }

            // On a phone the formatting keys are over the keyboard, below.
            if !root.minimised && !root.tel: FormatBar {
                apply(what) => { root.formater(what); }
            }

            // On a phone the page itself, no box: the words start under the subject.
            if !root.minimised: HorizontalLayout {
                vertical-stretch: 1;
                padding-left: root.tel ? 10px : 0px;
                padding-right: root.tel ? 10px : 0px;
                padding-top: root.tel ? 6px : 0px;
                corps := TextArea {
                    // A reply or a mailto: link arrives with its recipient: the writing is
                    // what is left to do, from the very top of the field.
                    init => { if (root.to != "") { self.focus(); } }
                    bare: root.tel;
                    accessible-label: "Message";
                    placeholder-text: root.tel ? "Write…" : "Write your message…";
                    font-size: root.tel ? 16px : Tokens.size-body;
                    text <=> root.body;
                    changed selection-start => { root.sel-start = self.selection-start; }
                    changed selection-end => { root.sel-end = self.selection-end; }
                    property <int> tick: root.select-tick;
                    changed tick => { self.select(root.select-at, root.select-at); }
                    after-height: root.quoting ? fil.preferred-height : 0px;

                    // --- The conversation being answered ---
                    //
                    // In the same field as what is written, under it, in the same
                    // scroll: newest first, each message one level of quoting deeper
                    // than the one before it, a bar per level, as the reader draws them.
                    // Its words are selected and copied like any text, never written
                    // into; each message folds by its header. Only the screen: the body
                    // is what was written, and sending quotes the message answered
                    // under it as it always has (`EnReponse`).
                    // Given their width from the field: wrapped text asked for its
                    // height before it had a width came out a line tall.
                    // Nothing shows unless the field gives it room (`after-height`).
                    fil := VerticalLayout {
                        width: corps.inner-width;
                        height: self.preferred-height;
                        spacing: Tokens.space-2;
                        padding-bottom: Tokens.space-2;

                        // Where what is written ends and what it answers begins.
                        Rectangle {
                            height: 1px;
                            background: Tokens.border;
                        }

                        for m[i] in root.history: citation := VerticalLayout {
                            /// Folded to its header line.
                            property <bool> folded;
                            property <int> levels: min(i + 1, 4);
                            spacing: 2px;

                            Rectangle {
                                height: root.tel ? 36px : 24px;
                                accessible-role: button;
                                accessible-label: (citation.folded ? "Show the message from " : "Fold the message from ") + m.from;
                                accessible-action-default => { citation.folded = !citation.folded; }

                                plier := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { citation.folded = !citation.folded; }
                                }
                                HorizontalLayout {
                                    spacing: Tokens.space-1;
                                    Icon {
                                        y: (parent.height - self.height) / 2;
                                        data: citation.folded ? Icons.chevron-right : Icons.chevron-down;
                                        size: 12px;
                                        tint: plier.has-hover ? Tokens.text : Tokens.text-muted;
                                    }
                                    Text {
                                        text: m.from;
                                        font-size: root.tel ? 14px : Tokens.size-small;
                                        font-weight: Tokens.weight-bold;
                                        color: Tokens.text-secondary;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }
                                    Text {
                                        text: m.date;
                                        font-size: root.tel ? 14px : Tokens.size-small;
                                        color: Tokens.text-muted;
                                        vertical-alignment: center;
                                        overflow: elide;
                                        horizontal-stretch: 1;
                                    }
                                }
                            }

                            if !citation.folded: HorizontalLayout {
                                spacing: Tokens.space-2;

                                // The reader's quote bars: one per level.
                                HorizontalLayout {
                                    spacing: Tokens.space-2;
                                    for niveau in citation.levels: Rectangle {
                                        width: 3px;
                                        border-radius: 1.5px;
                                        background: Tokens.accent.transparentize(0.6);
                                    }
                                }
                                QuoteText {
                                    accessible-label: "Message from " + m.from;
                                    width: max(40px, corps.inner-width - (3px + Tokens.space-2) * citation.levels);
                                    text: m.text == "" ? "(Nothing to show)" : m.text;
                                    font-size: root.tel ? 15px : Tokens.size-small;
                                }
                            }
                        }
                    }
                }
            }

            // --- What is going with it ---
            if !root.minimised && root.attachments.length > 0: HorizontalLayout {
                spacing: Tokens.space-1;
                height: root.tel ? 40px : 24px;
                padding-left: root.tel ? 18px : 0px;
                padding-right: root.tel ? 18px : 0px;
                padding-top: root.tel ? 4px : 0px;
                padding-bottom: root.tel ? 8px : 0px;

                for name[i] in root.attachments: Rectangle {
                    width: label.preferred-width + 34px;
                    border-radius: Tokens.radius-small;
                    background: Tokens.surface;
                    border-width: 1px;
                    border-color: Tokens.border;

                    accessible-role: button;
                    accessible-label: "Remove " + name;
                    accessible-action-default => { root.remove-attachment(i); }

                    HorizontalLayout {
                        padding-left: Tokens.space-1;
                        padding-right: Tokens.space-1;
                        spacing: 2px;

                        Icon {
                            y: (parent.height - self.height) / 2;
                            data: Icons.paperclip;
                            size: 12px;
                            tint: Tokens.text-muted;
                        }
                        label := Text {
                            text: name;
                            font-size: Tokens.size-small;
                            color: Tokens.text-secondary;
                            vertical-alignment: center;
                        }
                        Icon {
                            y: (parent.height - self.height) / 2;
                            data: Icons.window-close;
                            size: 10px;
                            tint: retirer.has-hover ? Tokens.error : Tokens.text-muted;
                        }
                    }

                    retirer := TouchArea {
                        clicked => { root.remove-attachment(i); }
                    }
                }
                Rectangle {}
            }

            if !root.minimised && root.error != "": HorizontalLayout {
                padding-left: root.tel ? 18px : 0px;
                padding-right: root.tel ? 18px : 0px;
                padding-bottom: root.tel ? 8px : 0px;
                Text {
                    text: root.error;
                    font-size: Tokens.size-small;
                    color: Tokens.error;
                    wrap: word-wrap;
                }
            }

            // On a phone, the formatting keys over the keyboard, while it is up.
            if !root.minimised && root.tel && Layout.keyboard > 0: KeyboardBar {
                mail: true;
                vertical-stretch: 0;
                act(k) => {
                    if (k == "hide-keyboard") {
                        puits.focus();
                    } else {
                        root.formater(k);
                    }
                }
            }

            // --- The bottom row (on a phone, all of it is in the bar at the top) ---
            if !root.minimised && !root.tel: HorizontalLayout {
                spacing: Tokens.space-2;
                height: 28px;

                IconButton {
                    icon: Icons.paperclip;
                    label: "Attach a file";
                    button-size: 28px;
                    clicked => { root.attach(); }
                }
                IconButton {
                    icon: Icons.image;
                    label: "Insert an image";
                    button-size: 28px;
                    clicked => { root.attach-image(); }
                }

                Rectangle {}

                // Kept in the account's Drafts folder, to finish later or elsewhere.
                Rectangle {
                    width: brouillon.preferred-width + 2 * Tokens.space-3;
                    border-radius: Tokens.radius-small;
                    border-width: 1px;
                    border-color: Tokens.border;
                    background: brouillon-touch.has-hover ? Tokens.surface-hover : transparent;

                    accessible-role: button;
                    accessible-label: "Save draft";
                    accessible-action-default => { root.save-draft(); }

                    brouillon := Text {
                        text: "Save draft";
                        font-size: Tokens.size-small;
                        color: Tokens.text-secondary;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    brouillon-touch := TouchArea {
                        clicked => { root.save-draft(); }
                    }
                }

                // Later: when it should leave, from a short list; the message waits
                // in Iris until then.
                later-button := IconButton {
                    icon: Icons.clock;
                    label: "Send later";
                    button-size: 28px;
                    clicked => {
                        root.later-x = self.absolute-position.x - root.absolute-position.x;
                        root.later-y = self.absolute-position.y - root.absolute-position.y;
                        root.later-open = true;
                    }
                }

                // Send closes the window. For a few seconds after, a notice at the
                // bottom of the application can still take the message back, and
                // brings this window back with it, as it was.
                Rectangle {
                    width: 120px;
                    border-radius: Tokens.radius-small;
                    background: Tokens.accent;

                    accessible-role: button;
                    accessible-label: "Send";
                    accessible-description: root.destinataires;
                    accessible-enabled: root.to != "";
                    accessible-action-default => { root.send(); }

                    HorizontalLayout {
                        alignment: center;
                        spacing: Tokens.space-1;

                        Icon {
                            y: (parent.height - self.height) / 2;
                            data: Icons.send;
                            size: 14px;
                            tint: Tokens.accent-text;
                        }
                        Text {
                            text: "Send";
                            font-size: Tokens.size-small;
                            font-weight: Tokens.weight-bold;
                            color: Tokens.accent-text;
                            vertical-alignment: center;
                        }
                    }

                    TouchArea {
                        clicked => { root.send(); }
                    }

                    // Pointed at, exactly whom it goes to. A clear layer over the
                    // button, with no touch area: the click still reaches it.
                    if root.destinataires != "": Rectangle {
                        Tooltip { text: @markdown("\{root.destinataires}"); }
                    }
                }
            }
        }
    }

    // When to send it: the times Rust offers (this evening, tomorrow morning…), above
    // the clock that opened them.
    if root.later-open: Rectangle {
        TouchArea {
            clicked => { root.later-open = false; }
        }
        FocusScope {
            enabled: false;
            key-pressed(event) => {
                if (event.text == Key.Escape) {
                    root.later-open = false;
                    return accept;
                }
                return reject;
            }
        }
        MenuSurface {
            // The sheet of times closes, not the message under it.
            dismissed => { root.later-open = false; }
            available-width: root.width;
            available-height: root.height;
            menu-x: max(8px, root.later-x - 200px + 28px);
            menu-y: max(8px, root.later-y - self.menu-height - 6px);
            menu-width: 220px;
            menu-height: plus-tard.preferred-height + 8px;

            plus-tard := VerticalLayout {
                padding: 4px;
                MenuHeader { text: "Send later"; }
                for choix[i] in root.later-options: MenuEntry {
                    icon: Icons.clock;
                    label: choix;
                    activated => {
                        root.later-open = false;
                        root.send-later(i);
                    }
                }
            }
        }
    }

    // A recipient's card, open at once on a click on the chip, beside it (a sheet on a
    // phone): who it is, as far as their mail tells, each value with a button that
    // copies it. A click outside or Escape closes it; the field keeps the cursor.
    if root.card-open && !root.minimised: Popover {
        width: 100%;
        height: 100%;
        anchor-left: root.card-left;
        anchor-right: root.card-right;
        anchor-top: root.card-top;
        card-width: 300px;
        dismissed => { root.card-open = false; }

        HorizontalLayout {
            spacing: 12px;
            Avatar {
                y: (parent.height - self.height) / 2;
                size: 40px;
                initials: root.card-known ? root.card.initials : "";
                tint: Tokens.accent;
            }
            VerticalLayout {
                alignment: center;
                spacing: 1px;
                horizontal-stretch: 1;
                Text {
                    text: root.card-name != "" ? root.card-name : root.card-address;
                    font-size: Layout.compact ? 17px : 15px;
                    font-weight: Tokens.weight-bold;
                    color: Tokens.text;
                    overflow: elide;
                }
                if root.card-known && root.card.received != "": Text {
                    text: root.card.received;
                    font-size: Layout.compact ? 13px : Tokens.size-small;
                    color: Tokens.text-muted;
                    overflow: elide;
                }
            }
        }
        if root.card-name != "": CardLine {
            label: "Name";
            value: root.card-name;
            copy-label: "Copy the name";
            copy(v) => { root.copy(v); }
        }
        CardLine {
            label: "Email";
            value: root.card-address;
            copy-label: "Copy the address";
            copy(v) => { root.copy(v); }
        }
        if root.card-known && root.card.last != "": Text {
            text: root.card.last;
            font-size: Layout.compact ? 13px : Tokens.size-small;
            color: Tokens.text-muted;
            overflow: elide;
        }
    }

    // Closing a message with something in it asks what to do with it. Closing an
    // empty one just closes.
    // The app's own question: a sheet from the bottom on a phone, with its buttons a
    // thumb's size, the centred card on a PC.
    if root.confirm-close: Modal {
        kind: ModalKind.question;
        width: 100%;
        height: 100%;
        title: "Save this message as a draft?";
        wrap-title: true;
        close-label: "Keep writing";
        fit: true;
        dismissed => { root.confirm-close = false; }

        Text {
            text: "A draft is kept in the Drafts folder of the account it is written from.";
            font-size: Layout.compact ? 15px : 13px;
            color: Tokens.text-secondary;
            wrap: word-wrap;
        }
        if Layout.compact: VerticalLayout {
            spacing: 6px;
            BlockButton {
                text: "Save draft";
                clicked => {
                    root.confirm-close = false;
                    root.save-draft();
                }
            }
            BlockButton {
                text: "Discard";
                kind: ButtonKind.danger;
                clicked => {
                    root.confirm-close = false;
                    root.discard();
                }
            }
            BlockButton {
                text: "Keep writing";
                kind: ButtonKind.ghost;
                clicked => { root.confirm-close = false; }
            }
        }
        if !Layout.compact: ModalFooter {
            Button {
                text: "Discard";
                kind: ButtonKind.danger;
                clicked => {
                    root.confirm-close = false;
                    root.discard();
                }
            }
            Button {
                text: "Cancel";
                clicked => { root.confirm-close = false; }
            }
            Button {
                text: "Save draft";
                kind: ButtonKind.primary;
                clicked => {
                    root.confirm-close = false;
                    root.save-draft();
                }
            }
        }
    }
    }
}
