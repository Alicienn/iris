import { Layout, WidthClass } from "@iris/theme/layout.slint";
import { Tokens } from "@iris/theme/tokens.slint";
import { Icon, Icons, IconButton } from "@iris/base/icons.slint";
import { Hairline } from "@iris/base/atoms.slint";
import { TextField } from "@iris/controls/field.slint";
import { BlockButton, Button, ButtonKind, ButtonSize, Fab } from "@iris/controls/button.slint";
import { Check } from "@iris/controls/choice.slint";
import { Nav, SectionRow } from "@iris/lists/nav.slint";
import { EmptyState, Modal, ModalKind } from "@iris/layout/frames.slint";
import { MenuEntry, MenuHeader, MenuSeparator, MenuSurface } from "@iris/layout/menu.slint";
import { ScrollView } from "@iris/controls/scroll.slint";
import { SidebarFrame, WindowToolbar } from "@iris/shell/chrome.slint";
import { NoteSpaceData, NoteTreeRowData, NoteBlockData, NoteFoundData, NoteGraphNodeData, NoteViewBlock, NoteRectData } from "@iris/types.slint";
import { SheetView, SheetGrid } from "@iris/screens/sheet.slint";
import { FormatBar } from "@iris/controls/formatbar.slint";

// The block highlighted in the `/` menu, for the card beside it: what is typed, what
// it becomes (drawn by `family`), and what it is for. Set by Rust.
export global BlockPreview {
    in property <string> family;
    in property <string> source;
    in property <string> title;
    in property <string> body;
    in property <string> description;
    in property <int> level;
    in property <color> tint;
    in property <image> picture;
    in property <bool> has-picture;
    /// Raised for each block highlighted: its card plays again, once.
    in property <int> serial;

    /// The icon of a row of the `/` menu (its key is `block:<name>`).
    public pure function icon(key: string) -> string {
        return key == "block:h1" ? Icons.heading-1
            : key == "block:h2" ? Icons.heading-2
            : key == "block:h3" ? Icons.heading-3
            : key == "block:list" ? Icons.list
            : key == "block:num" ? Icons.list-numbered
            : key == "block:todo" ? Icons.checkbox
            : key == "block:quote" ? Icons.quote
            : key == "block:def" ? Icons.book
            : key == "block:thm" ? Icons.medal
            : key == "block:prop" ? Icons.diamond
            : key == "block:lem" ? Icons.stairs
            : key == "block:cor" ? Icons.follows
            : key == "block:proof" ? Icons.proof
            : key == "block:ex" ? Icons.bulb
            : key == "block:exo" ? Icons.pencil
            : key == "block:sol" ? Icons.check-circle
            : key == "block:q" ? Icons.question
            : key == "block:important" ? Icons.exclamation
            : key == "block:summary" ? Icons.summary
            : key == "block:note" ? Icons.info
            : key == "block:tip" ? Icons.sparkle
            : key == "block:warn" ? Icons.warning
            : key == "block:math" ? Icons.sigma
            : key == "block:code" ? Icons.code
            : key == "block:table" ? Icons.table
            : key == "block:rule" ? Icons.rule
            : key == "block:cols" ? Icons.columns
            : key == "block:fold" ? Icons.fold
            : key == "block:card" ? Icons.cards
            : key == "block:sheet" ? Icons.table
            : "";
    }
}

// What is selected in the open note beyond a line's words: whole blocks (dragged
// across, Shift and a click, Ctrl+A twice, Shift and an arrow at a block's edge), or
// cells of an embedded spreadsheet. Rust holds it; the blocks draw it, and the keys
// reach it here.
export global NoteSelect {
    /// The blocks selected, first to last (-1: none).
    in-out property <int> first: -1;
    in-out property <int> last: -1;
    /// Raised by Rust to hand the keyboard to the blocks selected.
    in-out property <int> blocks-serial;
    /// While the mouse is dragged from a block: that block, and where the pointer is
    /// (in the window).
    in-out property <int> drag-from: -1;
    in-out property <length> drag-y;
    /// The block the pointer is over while dragging; a Shift and a click on a block.
    callback drag(int, int);
    callback shift-clicked(int);
    /// A key while blocks are selected (`ctrl+c`, `delete`, `shift+up`…): true when used.
    callback blocks-key(string) -> bool;

    /// The embedded spreadsheet whose cells are selected (its block; -1: none), the
    /// cells selected (rows and columns as the note shows them) and the active one.
    in-out property <int> sheet-block: -1;
    in-out property <int> r1;
    in-out property <int> c1;
    in-out property <int> r2;
    in-out property <int> c2;
    in-out property <int> row;
    in-out property <int> col;
    /// The active cell typed in, what it holds, and where the cursor starts in it.
    in-out property <bool> editing;
    in-out property <string> edit-text;
    in-out property <int> edit-cursor;
    /// Raised by Rust to hand the keyboard to the cells.
    in-out property <int> cells-serial;
    /// Where the cell typed in is, in the editor.
    in-out property <length> edit-x;
    in-out property <length> edit-y;
    in-out property <length> edit-w;
    in-out property <length> edit-h;

    /// The icons the editor draws, by name.
    public pure function icon(name: string) -> string {
        return name == "check" ? Icons.check
            : name == "chevron-right" ? Icons.chevron-right
            : name == "chevron-down" ? Icons.chevron-down
            : name == "settings" ? Icons.settings
            : name == "open-external" ? Icons.open-external
            : name == "link" ? Icons.link
            : "";
    }
    callback cell-pressed(int, int, int, bool);
    callback cell-double-clicked(int, int, int);
    /// A key while cells are selected (`ctrl+c`, `up`, `type:x`…): true when used.
    callback cell-key(string) -> bool;
    /// The cell typed in (block, row, column) is done: what it holds, and how
    /// (`enter`, `tab`, `shift+tab`, `shift+enter`, `left`); `escape` drops what was typed.
    callback cell-committed(int, int, int, string, string);

    /// A key's name as Rust reads it: `ctrl+shift+up`, `delete`, `type:é`.
    public pure function key-name(event: KeyEvent) -> string {
        let ctrl = event.modifiers.control && !event.modifiers.alt;
        let prefixe = (ctrl ? "ctrl+" : "") + (event.modifiers.alt && !event.modifiers.control ? "alt+" : "")
            + (event.modifiers.shift ? "shift+" : "");
        let base = event.text == Key.UpArrow ? "up"
            : event.text == Key.DownArrow ? "down"
            : event.text == Key.LeftArrow ? "left"
            : event.text == Key.RightArrow ? "right"
            : event.text == Key.Return ? "enter"
            : event.text == Key.Tab ? "tab"
            : event.text == Key.Backtab ? "tab"
            : event.text == Key.Escape ? "escape"
            : event.text == Key.Delete ? "delete"
            : event.text == Key.Backspace ? "backspace"
            : event.text == Key.Home ? "home"
            : event.text == Key.End ? "end"
            : event.text == Key.PageUp ? "pageup"
            : event.text == Key.PageDown ? "pagedown"
            : event.text == Key.F2 ? "f2"
            : event.text == Key.F11 ? "f11"
            : "";
        if (base != "") {
            return prefixe + (event.text == Key.Backtab && !event.modifiers.shift ? "shift+" : "") + base;
        }
        if (event.text == "" || event.text == Key.Control || event.text == Key.Shift || event.text == Key.Alt) {
            return "";
        }
        // A character: typed as it is, unless Ctrl goes with it (AltGr is Ctrl+Alt).
        return ctrl ? prefixe + event.text : "type:" + event.text;
    }
}

// The card beside the `/` menu: the block's source typed, then what it becomes, then
// a line on what it is for. It plays once for each block highlighted (a timer that
// stops), never in a loop.
component BlockPreviewCard inherits Rectangle {
    property <float> phase: 1;
    property <int> demande: BlockPreview.serial;
    changed demande => { root.phase = 0; }
    Timer {
        interval: 24ms;
        running: root.phase < 1;
        triggered => { root.phase = min(1, root.phase + 0.018); }
    }
    // Typing, then the result coming in over it.
    property <float> tape: clamp(root.phase / 0.42, 0, 1);
    property <float> rendu: clamp((root.phase - 0.55) / 0.3, 0, 1);
    // A last touch: a box ticked, a fold opened, an answer shown.
    property <float> fin: clamp((root.phase - 0.86) / 0.14, 0, 1);

    width: 290px;
    height: carte.preferred-height;
    border-radius: Tokens.radius-medium;
    background: Tokens.surface;
    border-width: 1px;
    border-color: Tokens.border;
    drop-shadow-blur: 14px;
    drop-shadow-offset-y: 4px;
    drop-shadow-color: Tokens.shadow-float;

    carte := VerticalLayout {
        padding: 10px;
        spacing: 8px;
        scene := Rectangle {
            height: 118px;
            border-radius: 8px;
            background: Tokens.surface-low;
            clip: true;

            // What is typed, appearing as if typed.
            Rectangle {
                x: 14px;
                y: (parent.height - self.height) / 2 - root.rendu * 12px;
                height: 22px;
                width: min(source.preferred-width * root.tape, parent.width - 28px);
                clip: true;
                opacity: 1 - root.rendu;
                source := Text {
                    x: 0;
                    width: self.preferred-width;
                    height: parent.height;
                    text: BlockPreview.source;
                    font-family: Tokens.font-mono;
                    font-size: 13px;
                    color: Tokens.text;
                    vertical-alignment: center;
                }
            }
            Rectangle {
                x: 14px + min(source.preferred-width * root.tape, parent.width - 28px) + 1px;
                y: (parent.height - self.height) / 2 - root.rendu * 12px;
                width: 1.5px;
                height: 16px;
                background: Tokens.accent;
                opacity: root.phase < 0.55 ? 1 : 1 - root.rendu;
            }

            // What it becomes.
            Rectangle {
                x: 14px;
                y: 12px + (1 - root.rendu) * 10px;
                width: parent.width - 28px;
                height: parent.height - 24px;
                opacity: root.rendu;

                if BlockPreview.family == "heading": Text {
                    width: parent.width;
                    height: parent.height;
                    text: BlockPreview.title;
                    font-family: BlockPreview.level == 1 ? Tokens.font-display : Tokens.font-family;
                    font-size: BlockPreview.level == 1 ? 25px : BlockPreview.level == 2 ? 19px : 15.5px;
                    font-weight: 700;
                    color: Tokens.text;
                    vertical-alignment: center;
                    overflow: elide;
                }
                if BlockPreview.family == "bullet" || BlockPreview.family == "numbered"
                    || BlockPreview.family == "task": VerticalLayout {
                    alignment: center;
                    spacing: 6px;
                    for ligne[i] in [BlockPreview.title, BlockPreview.body]: HorizontalLayout {
                        spacing: 8px;
                        height: 20px;
                        if BlockPreview.family == "bullet": Text {
                            width: 12px;
                            text: "•";
                            font-size: 14px;
                            color: Tokens.text-secondary;
                            vertical-alignment: center;
                        }
                        if BlockPreview.family == "numbered": Text {
                            width: 16px;
                            text: (i + 1) + ".";
                            font-size: 13.5px;
                            color: Tokens.text-secondary;
                            vertical-alignment: center;
                        }
                        if BlockPreview.family == "task": Rectangle {
                            width: 16px;
                            Rectangle {
                                y: 2px;
                                width: 15px;
                                height: 15px;
                                border-radius: 4px;
                                border-width: 1.5px;
                                border-color: i == 0 && root.fin > 0.5 ? Tokens.accent : Tokens.border-strong;
                                background: i == 0 ? Tokens.accent.with-alpha(root.fin) : transparent;
                                Icon {
                                    data: Icons.check;
                                    size: 11px;
                                    weight: 2.4;
                                    tint: Tokens.accent-text;
                                    alpha: i == 0 ? root.fin : 0;
                                }
                            }
                        }
                        Text {
                            text: ligne;
                            font-size: 13.5px;
                            color: BlockPreview.family == "task" && i == 0 && root.fin > 0.5 ? Tokens.text-muted : Tokens.text;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                    }
                }
                if BlockPreview.family == "quote": HorizontalLayout {
                    spacing: 10px;
                    padding-top: 22px;
                    padding-bottom: 22px;
                    Rectangle {
                        width: 3px;
                        border-radius: 1.5px;
                        background: Tokens.border-strong;
                    }
                    Text {
                        text: BlockPreview.title;
                        font-size: 14px;
                        font-italic: true;
                        color: Tokens.text-muted;
                        wrap: word-wrap;
                        vertical-alignment: center;
                    }
                }
                if BlockPreview.family == "callout": Rectangle {
                    border-radius: 6px;
                    background: BlockPreview.tint.transparentize(0.88);
                    Rectangle {
                        x: 0;
                        width: 3px;
                        border-radius: 1.5px;
                        background: BlockPreview.tint;
                    }
                    VerticalLayout {
                        padding: 10px;
                        padding-left: 14px;
                        spacing: 4px;
                        alignment: start;
                        HorizontalLayout {
                            spacing: 6px;
                            Text {
                                text: BlockPreview.title;
                                font-size: 13.5px;
                                font-weight: 700;
                                color: BlockPreview.tint;
                                overflow: elide;
                                horizontal-stretch: 1;
                            }
                            Icon {
                                y: 2px;
                                data: BlockPreview.level == 1 && root.fin < 0.5 ? Icons.chevron-right : Icons.chevron-down;
                                size: 11px;
                                tint: BlockPreview.tint;
                            }
                        }
                        // Folded: its words come when the fold opens.
                        Text {
                            text: BlockPreview.body;
                            font-size: 13px;
                            color: Tokens.text;
                            wrap: word-wrap;
                            opacity: BlockPreview.level == 1 ? root.fin : 1;
                        }
                    }
                }
                if BlockPreview.family == "math": HorizontalLayout {
                    alignment: center;
                    if BlockPreview.has-picture: Image {
                        y: (parent.height - self.height) / 2;
                        source: BlockPreview.picture;
                        width: min(self.source.width * 1px / 2, parent.width);
                        height: self.width * self.source.height / max(1, self.source.width);
                    }
                    if !BlockPreview.has-picture: Text {
                        text: BlockPreview.body;
                        font-size: 17px;
                        color: Tokens.text;
                        vertical-alignment: center;
                    }
                }
                if BlockPreview.family == "code": Rectangle {
                    border-radius: 6px;
                    background: Tokens.surface;
                    VerticalLayout {
                        padding: 10px;
                        alignment: center;
                        spacing: 3px;
                        for l in [BlockPreview.title, BlockPreview.body]: Text {
                            text: l;
                            font-family: Tokens.font-mono;
                            font-size: 12.5px;
                            color: Tokens.text;
                        }
                    }
                }
                if BlockPreview.family == "table" || BlockPreview.family == "sheet": VerticalLayout {
                    alignment: center;
                    spacing: 6px;
                    if BlockPreview.family == "sheet": HorizontalLayout {
                        spacing: 6px;
                        Icon {
                            data: Icons.table;
                            size: 13px;
                            tint: Tokens.text-muted;
                        }
                        Text {
                            text: BlockPreview.title + ".sheet";
                            font-size: 12px;
                            color: Tokens.text-muted;
                        }
                    }
                    Rectangle {
                        height: 66px;
                        border-radius: 5px;
                        border-width: 1px;
                        border-color: Tokens.border;
                        clip: true;
                        VerticalLayout {
                            for rang[r] in BlockPreview.family == "sheet"
                                ? [["Item", "Price"], ["Books", "86.50"], ["Total", "=SUM"]]
                                : [["A", "B"], ["1", "2"], ["3", "4"]]: HorizontalLayout {
                                for cel[c] in rang: Rectangle {
                                    background: r == 0 ? Tokens.surface : transparent;
                                    border-width: 0.5px;
                                    border-color: Tokens.border;
                                    Text {
                                        x: 8px;
                                        text: cel;
                                        font-size: 12px;
                                        font-weight: r == 0 ? 600 : 400;
                                        color: Tokens.text;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }
                    }
                }
                if BlockPreview.family == "rule": VerticalLayout {
                    alignment: center;
                    spacing: 12px;
                    Text {
                        text: "Part one ends here.";
                        font-size: 12.5px;
                        color: Tokens.text-muted;
                    }
                    Rectangle {
                        height: 1px;
                        background: Tokens.border-strong;
                    }
                    Text {
                        text: "Part two begins.";
                        font-size: 12.5px;
                        color: Tokens.text-muted;
                    }
                }
                if BlockPreview.family == "cols": HorizontalLayout {
                    spacing: 10px;
                    padding-top: 14px;
                    padding-bottom: 14px;
                    for col in [BlockPreview.title, BlockPreview.body]: Rectangle {
                        border-radius: 6px;
                        border-width: 1px;
                        border-color: Tokens.border;
                        Text {
                            text: col;
                            font-size: 13px;
                            color: Tokens.text;
                        }
                    }
                }
                if BlockPreview.family == "fold": VerticalLayout {
                    alignment: center;
                    spacing: 6px;
                    HorizontalLayout {
                        spacing: 6px;
                        Icon {
                            y: 3px;
                            data: root.fin < 0.5 ? Icons.chevron-right : Icons.chevron-down;
                            size: 11px;
                            tint: Tokens.text-secondary;
                        }
                        Text {
                            text: BlockPreview.title;
                            font-size: 13.5px;
                            font-weight: 600;
                            color: Tokens.text;
                        }
                    }
                    Text {
                        text: "      " + BlockPreview.body;
                        font-size: 13px;
                        color: Tokens.text-secondary;
                        opacity: root.fin;
                    }
                }
                if BlockPreview.family == "card": VerticalLayout {
                    alignment: center;
                    spacing: 8px;
                    Rectangle {
                        height: 36px;
                        border-radius: 6px;
                        background: Tokens.surface;
                        border-width: 1px;
                        border-color: Tokens.border;
                        Text {
                            text: BlockPreview.title;
                            font-size: 14px;
                            font-weight: 600;
                            color: Tokens.text;
                        }
                    }
                    Rectangle {
                        height: 36px;
                        border-radius: 6px;
                        background: Tokens.accent.transparentize(0.88);
                        opacity: root.fin;
                        Text {
                            text: BlockPreview.body;
                            font-size: 14px;
                            color: Tokens.accent;
                        }
                    }
                }
            }
        }
        Text {
            text: BlockPreview.description;
            font-size: 12px;
            color: Tokens.text-muted;
            wrap: word-wrap;
        }
    }
}

// Notes: Markdown files in spaces, in a tree on the left, the open note on the right,
// written block by block. The block holding the cursor shows its source; every other
// block its rendering.

// --- The tree -------------------------------------------------------------------------

// A line of the tree: a folder (unfolded with its chevron), a note, a spreadsheet, an
// image or another file. Carried by the mouse onto a folder, it moves there.
component TreeRow inherits Rectangle {
    in property <NoteTreeRowData> item;
    /// This row's name is being edited.
    in property <bool> renaming;
    /// Something is being carried, and where the pointer is (window coordinates).
    in property <bool> carrying;
    in property <length> carry-x;
    in property <length> carry-y;
    /// Raised when what is carried is let go.
    in property <int> drop;
    in property <length> drop-x;
    in property <length> drop-y;

    callback clicked(string);
    callback toggled(string);
    callback menu(string, length, length);
    callback renamed(string, string);
    callback rename-cancelled();
    /// The row was pulled past a few pixels: it is carried (its key, name and kind).
    callback carry-started(string, string, int);
    /// What is carried came over this folder (true) or left it (false).
    callback target-changed(string, bool);
    callback carry-moved(length, length);
    callback carry-ended(length, length);
    /// What was carried was let go on this row (a folder, or a note: its folder).
    callback dropped(string);

    property <bool> folder: root.item.kind == 0;
    pure function inside(x: length, y: length) -> bool {
        return x >= self.absolute-position.x && x < self.absolute-position.x + self.width
            && y >= self.absolute-position.y && y < self.absolute-position.y + self.height;
    }
    property <bool> targeted: root.carrying && root.folder && !(root.pulled && root.pressed-here)
        && root.inside(root.carry-x, root.carry-y);
    changed targeted => { root.target-changed(root.item.name, root.targeted); }

    changed drop => {
        if (root.inside(root.drop-x, root.drop-y)) {
            root.dropped(root.item.key);
        }
    }

    height: Nav.row-height;
    border-radius: Tokens.radius-small;
    border-width: root.targeted ? 1.5px : 0px;
    border-color: Tokens.accent;
    background: root.targeted ? Tokens.accent.transparentize(0.8)
        : Nav.background(root.item.selected, touch.has-hover);
    animate background { duration: Tokens.instant; }
    // The row carried stays where it was, faded, while its card follows the pointer.
    opacity: root.pulled && root.pressed-here && root.carrying ? 0.45 : 1.0;

    accessible-role: list-item;
    accessible-label: root.item.name;
    accessible-item-selected: root.item.selected;
    accessible-expanded: root.folder && root.item.expanded;
    accessible-action-default => { root.clicked(root.item.key); }

    property <length> press-x;
    property <length> press-y;
    property <bool> pressed-here;
    property <bool> pulled;

    touch := TouchArea {
        mouse-cursor: root.pulled ? MouseCursor.grabbing : MouseCursor.default;
        pointer-event(event) => {
            if (event.button == PointerEventButton.right && event.kind == PointerEventKind.up) {
                root.menu(root.item.key,
                    self.absolute-position.x + self.mouse-x,
                    self.absolute-position.y + self.mouse-y);
            }
            if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                root.pressed-here = true;
                root.pulled = false;
                root.press-x = self.mouse-x;
                root.press-y = self.mouse-y;
            }
            if (event.button == PointerEventButton.left && event.kind == PointerEventKind.up) {
                if (root.pulled) {
                    root.carry-ended(self.absolute-position.x + self.mouse-x,
                        self.absolute-position.y + self.mouse-y);
                }
                root.pressed-here = false;
            }
        }
        moved => {
            // Under a finger a drag scrolls the tree: carrying is the mouse's.
            if (root.pressed-here && !root.pulled && !Layout.touch-input
                && (abs(self.mouse-x - root.press-x) > 4px || abs(self.mouse-y - root.press-y) > 4px)) {
                root.pulled = true;
                root.carry-started(root.item.key, root.item.name, root.item.kind);
            }
            if (root.pulled) {
                root.carry-moved(self.absolute-position.x + self.mouse-x,
                    self.absolute-position.y + self.mouse-y);
            }
        }
        clicked => {
            if (root.pulled) {
                root.pulled = false;
                return;
            }
            if (root.folder && self.mouse-x < 6px + root.item.depth * 14px + 18px) {
                root.toggled(root.item.key);
            } else {
                root.clicked(root.item.key);
            }
        }
        double-clicked => {
            if (root.folder) { root.toggled(root.item.key); }
        }
    }

    HorizontalLayout {
        padding-left: 6px + root.item.depth * 14px;
        padding-right: 6px;
        spacing: 5px;

        // The chevron of a folder; the room it takes, kept for a file, so names line up.
        Rectangle {
            width: 14px;
            if root.folder && root.item.has-children: Icon {
                data: root.item.expanded ? Icons.chevron-down : Icons.chevron-right;
                size: 11px;
                weight: 2.2;
                tint: Nav.count-ink(root.item.selected);
            }
        }
        Icon {
            y: (parent.height - self.height) / 2;
            data: root.item.kind == 0 ? Icons.folder
                : root.item.kind == 1 ? Icons.notes
                : root.item.kind == 2 ? Icons.table
                : root.item.kind == 3 ? Icons.image
                : Icons.paperclip;
            size: 15px;
            tint: Nav.icon-ink(root.item.selected,
                root.item.color.alpha > 0 ? root.item.color
                : root.item.kind == 0 ? Tokens.accent : Tokens.text-muted);
        }
        if !root.renaming: Text {
            text: root.item.name;
            font-size: Nav.label-size;
            color: Nav.ink(root.item.selected, false);
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }
        // Escape, which the field does not want, comes up here: the old name stays.
        if root.renaming: FocusScope {
            horizontal-stretch: 1;
            key-pressed(event) => {
                if (event.text == Key.Escape) {
                    root.rename-cancelled();
                    return accept;
                }
                reject
            }
            TextField {
                y: (parent.height - self.height) / 2;
                height: 22px;
                width: parent.width;
                text: root.item.name;
                font-size: Nav.label-size;
                init => {
                    self.focus();
                    self.select-all();
                }
                accepted(t) => { root.renamed(root.item.key, t); }
            }
        }
        if root.item.pinned: Icon {
            y: (parent.height - self.height) / 2;
            data: Icons.star;
            size: 11px;
            tint: Nav.count-ink(root.item.selected);
        }
    }
}

// --- The editor -----------------------------------------------------------------------

// A block of the open note.
//
// Edited, it is a TextInput holding its source, in the block's own size. Otherwise it
// is drawn: its words with their marks (StyledText), and what the kind adds — a bullet,
// a number, a checkbox, a callout's frame, a quote's bar, a table's grid.
//
// A click on a drawn block edits it. Ctrl+click on a link follows it: while Ctrl is
// held, the area that takes the click steps aside and lets the link have it.
component NoteBlock inherits Rectangle {
    in property <NoteBlockData> block;
    in property <int> index;
    in property <bool> focused;
    /// Raised by Rust to put the cursor in this block, at `focus-cursor`
    /// (`focus-anchor` for a selection), with the source it gives.
    in property <int> focus-serial;
    in property <int> focus-cursor;
    in property <int> focus-anchor;
    in property <bool> ctrl-held;

    callback edited(int, string, int);
    /// A key the block may want: its name, the cursor and anchor, whether the cursor is
    /// on the first and the last line. True when it was used.
    callback key(int, string, int, int, bool, bool) -> bool;
    callback clicked(int);
    callback link(string);
    callback task-toggled(int);
    callback fold-toggled(int);
    /// An embedded spreadsheet's column given a width (the sheet's pixels).
    callback col-resized(int, int, float);
    /// An embedded spreadsheet's option switched (`clip`).
    callback sheet-option(int, string);
    /// Where the cursor is in the window, for what pops up there; the cursor and the
    /// anchor, for a selection.
    callback caret(int, length, length, int, int);
    /// Ctrl pressed or let go while typing.
    callback ctrl-changed(bool);
    /// A popup is open over the cursor: Up, Down, Enter, Tab and Escape are its.
    in property <bool> popup;
    /// Reading mode: nothing is edited, a click on a link follows it.
    in property <bool> read-only;
    /// How wide the note's column is, for pictures.
    in property <length> available: 640px;
    /// A block of the note being written (not one beside): it can be selected whole.
    in property <bool> main;
    /// Selected whole (with others, or alone).
    in property <bool> selected;

    // Selected whole: tinted, as Notion does.
    background: root.selected ? Tokens.accent.transparentize(0.84) : transparent;
    border-radius: Tokens.radius-small;

    // Dragged across from another block: this one is where the pointer is.
    property <length> survol: NoteSelect.drag-y;
    changed survol => {
        if (root.main && NoteSelect.drag-from >= 0 && root.survol >= root.absolute-position.y
            && root.survol < root.absolute-position.y + root.height) {
            NoteSelect.drag(NoteSelect.drag-from, root.index);
        }
    }

    /// The embedded spreadsheet's cell (row `r`, column `k`) is selected, or active.
    pure function cellule-choisie(r: int, k: int) -> bool {
        return NoteSelect.sheet-block == root.index && r >= NoteSelect.r1 && r <= NoteSelect.r2
            && k >= NoteSelect.c1 && k <= NoteSelect.c2;
    }
    pure function cellule-active(r: int, k: int) -> bool {
        return NoteSelect.sheet-block == root.index && r == NoteSelect.row && k == NoteSelect.col;
    }

    property <bool> en-liste: root.block.kind == "bullet" || root.block.kind == "numbered"
        || root.block.kind == "task";
    property <bool> fixe: root.block.kind == "code" || root.block.kind == "math"
        || root.block.kind == "table" || root.block.kind == "properties";
    property <length> taille: root.block.kind == "heading"
        ? (root.block.level == 1 ? 27px : root.block.level == 2 ? 21.5px
            : root.block.level == 3 ? 18px : 15.5px)
        : root.fixe ? 13.5px : 15px;
    property <int> graisse: root.block.kind == "heading" ? 700 : 400;
    property <length> retrait: root.block.indent * 22px;
    // The width the words have, set rather than left to the row: a text that wraps
    // takes its height from its width, and a row asked for its height before it has
    // a width would make it one line, its other lines drawn over the blocks around.
    property <length> marque: root.block.kind == "bullet" ? 22px
        : root.block.kind == "numbered" || root.block.kind == "task" ? 26px
        : root.block.kind == "quote" ? 11px : 0px;
    property <length> largeur-mots: max(40px, root.available - root.retrait - root.marque);
    /// The mark that made the block is hidden while it is typed (Rust gives it apart).
    property <bool> masque: root.block.prefix-bytes > 0;
    /// An embedded spreadsheet's columns narrowed together to fit the column.
    property <float> echelle: root.block.sheet && root.block.widths-total > 0
        ? min(1, root.largeur-mots / (root.block.widths-total * 1px)) : 1;
    property <length> marge-haut: root.block.kind == "heading"
        ? (root.block.level <= 2 ? 14px : 8px) : 2px;

    min-height: root.block.kind == "blank" ? 12px : 0px;

    VerticalLayout {
        padding-top: root.marge-haut;
        padding-bottom: 2px;

        // Edited: the source, without the mark that made the block, which is drawn
        // instead (a bullet, a number, a box, a quote's bar; a heading's size).
        if root.focused: Rectangle {
            // A plate (code, maths, a table, an embedded sheet) holds its text with room
            // around it: the field sits 6px in, and the plate is that much taller.
            min-height: entree.preferred-height + (root.fixe ? 12px : 0px);
            background: root.fixe ? Tokens.surface-low : transparent;
            border-radius: root.fixe ? Tokens.radius-small : 0px;

            if root.masque && root.block.kind == "bullet": Text {
                x: root.retrait;
                width: 14px;
                text: root.block.indent == 0 ? "•" : root.block.indent == 1 ? "◦" : "▪";
                font-size: root.taille;
                color: Tokens.text-secondary;
                horizontal-alignment: center;
            }
            if root.masque && root.block.kind == "numbered": Text {
                x: root.retrait;
                width: 18px;
                text: root.block.number;
                font-size: root.taille;
                color: Tokens.text-secondary;
                horizontal-alignment: right;
            }
            if root.masque && root.block.kind == "task": Check {
                x: root.retrait + 1px;
                y: 3px;
                size: 16px;
                done: root.block.done;
                label: "Done";
                toggled => { root.task-toggled(root.index); }
            }
            if root.masque && root.block.kind == "quote": Rectangle {
                x: root.retrait;
                width: 3px;
                border-radius: 1.5px;
                background: Tokens.border-strong;
            }

            entree := TextInput {
                x: root.retrait + (root.fixe ? 8px : 0px) + (root.masque ? root.marque : 0px);
                y: root.fixe ? 6px : 0px;
                width: parent.width - self.x - (root.fixe ? 8px : 0px);
                text: root.block.source;
                font-size: root.taille;
                font-weight: root.graisse;
                font-family: root.fixe ? Tokens.font-mono : Tokens.font-family;
                color: Tokens.text;
                wrap: word-wrap;
                single-line: false;
                selection-background-color: Tokens.accent.transparentize(0.7);
                selection-foreground-color: Tokens.text;

                // Where the cursor is, line-wise: the first and the last lines send Up
                // and Down to the blocks around.
                property <length> curseur-x;
                property <length> curseur-y;
                property <int> serie: root.focus-serial;

                // Rust counts in the whole source; the field holds it without its mark.
                init => {
                    self.focus();
                    self.set-selection-offsets(max(0, root.focus-anchor - root.block.prefix-bytes),
                        max(0, root.focus-cursor - root.block.prefix-bytes));
                    en-vue.running = true;
                }
                changed serie => {
                    self.text = root.block.source;
                    self.focus();
                    self.set-selection-offsets(max(0, root.focus-anchor - root.block.prefix-bytes),
                        max(0, root.focus-cursor - root.block.prefix-bytes));
                    en-vue.running = true;
                }
                edited => {
                    root.edited(root.index, root.block.prefix + self.text,
                        self.cursor-position-byte-offset + root.block.prefix-bytes);
                }
                cursor-position-changed(p) => {
                    self.curseur-x = p.x;
                    self.curseur-y = p.y;
                    root.caret(root.index, self.absolute-position.x + p.x,
                        self.absolute-position.y + p.y + root.taille * 1.35,
                        self.cursor-position-byte-offset + root.block.prefix-bytes,
                        self.anchor-position-byte-offset + root.block.prefix-bytes);
                }
                key-released(event) => {
                    if (event.text == Key.Control) {
                        root.ctrl-changed(false);
                    }
                    EventResult.reject
                }
                key-pressed(event) => {
                    if (event.text == Key.Control) {
                        root.ctrl-changed(true);
                        return EventResult.reject;
                    }
                    // At the start of the words (after the hidden mark): the line's start.
                    let debut = self.cursor-position-byte-offset == 0 && self.anchor-position-byte-offset == 0;
                    let c = self.cursor-position-byte-offset + root.block.prefix-bytes;
                    let a = self.anchor-position-byte-offset + root.block.prefix-bytes;
                    let premiere = self.curseur-y < root.taille * 0.8;
                    let derniere = self.curseur-y + root.taille * 1.7 > self.height;
                    // A popup over the cursor takes the keys that choose in it.
                    if (root.popup && !event.modifiers.control) {
                        if (event.text == Key.UpArrow) { return root.key(root.index, "popup-up", c, a, premiere, derniere) ? EventResult.accept : EventResult.reject; }
                        if (event.text == Key.DownArrow) { return root.key(root.index, "popup-down", c, a, premiere, derniere) ? EventResult.accept : EventResult.reject; }
                        if (event.text == Key.Return || event.text == Key.Tab) { return root.key(root.index, "popup-accept", c, a, premiere, derniere) ? EventResult.accept : EventResult.reject; }
                        if (event.text == Key.Escape) { return root.key(root.index, "popup-close", c, a, premiere, derniere) ? EventResult.accept : EventResult.reject; }
                    }
                    let ctrl = event.modifiers.control && !event.modifiers.alt;
                    if (event.text == Key.Escape) {
                        return root.key(root.index, "escape", c, a, premiere, derniere) ? EventResult.accept : EventResult.reject;
                    }
                    if (event.text == Key.F11) {
                        return root.key(root.index, "f11", c, a, premiere, derniere) ? EventResult.accept : EventResult.reject;
                    }
                    if (event.text == Key.Return) {
                        let nom = ctrl ? "ctrl+enter" : event.modifiers.shift ? "shift+enter" : "enter";
                        return root.key(root.index, nom, c, a, premiere, derniere) ? EventResult.accept : EventResult.reject;
                    }
                    if (event.text == Key.Backspace && debut) {
                        return root.key(root.index, "backspace-start", c, a, premiere, derniere) ? EventResult.accept : EventResult.reject;
                    }
                    // At the end, Delete joins the next block (Rust knows where the end is).
                    if (event.text == Key.Delete && c == a) {
                        return root.key(root.index, "delete", c, a, premiere, derniere) ? EventResult.accept : EventResult.reject;
                    }
                    // Ctrl+Tab goes from tab to tab; Tab alone nests.
                    if (ctrl && (event.text == Key.Tab || event.text == Key.Backtab)) {
                        return root.key(root.index, event.modifiers.shift || event.text == Key.Backtab ? "ctrl+shift+tab" : "ctrl+tab", c, a, premiere, derniere) ? EventResult.accept : EventResult.reject;
                    }
                    if (event.text == Key.Tab) {
                        return root.key(root.index, event.modifiers.shift ? "shift+tab" : "tab", c, a, premiere, derniere) ? EventResult.accept : EventResult.reject;
                    }
                    if (event.modifiers.alt && !event.modifiers.control && event.text == Key.UpArrow) {
                        return root.key(root.index, "alt+up", c, a, premiere, derniere) ? EventResult.accept : EventResult.reject;
                    }
                    if (event.modifiers.alt && !event.modifiers.control && event.text == Key.DownArrow) {
                        return root.key(root.index, "alt+down", c, a, premiere, derniere) ? EventResult.accept : EventResult.reject;
                    }
                    // Shift and an arrow at the block's edge: whole blocks selected
                    // (Rust lets the field have it while its words are not all taken).
                    if (event.modifiers.shift && !event.modifiers.control && !event.modifiers.alt
                        && ((event.text == Key.UpArrow && premiere) || (event.text == Key.DownArrow && derniere))) {
                        return root.key(root.index, event.text == Key.UpArrow ? "shift+up" : "shift+down", c, a, premiere, derniere) ? EventResult.accept : EventResult.reject;
                    }
                    if (!event.modifiers.shift && event.text == Key.UpArrow && premiere) {
                        return root.key(root.index, "up", c, a, premiere, derniere) ? EventResult.accept : EventResult.reject;
                    }
                    if (!event.modifiers.shift && event.text == Key.DownArrow && derniere) {
                        return root.key(root.index, "down", c, a, premiere, derniere) ? EventResult.accept : EventResult.reject;
                    }
                    if (!event.modifiers.shift && event.text == Key.LeftArrow && debut) {
                        return root.key(root.index, "left-start", c, a, premiere, derniere) ? EventResult.accept : EventResult.reject;
                    }
                    if (!event.modifiers.shift && event.text == Key.RightArrow && c == a) {
                        return root.key(root.index, "right", c, a, premiere, derniere) ? EventResult.accept : EventResult.reject;
                    }
                    if (ctrl && event.text != "" && event.text != Key.Control && event.text != Key.Shift) {
                        let nom = (event.modifiers.shift ? "ctrl+shift+" : "ctrl+") + event.text;
                        return root.key(root.index, nom, c, a, premiere, derniere) ? EventResult.accept : EventResult.reject;
                    }
                    // A space (line starts), and the characters that come in pairs.
                    if (!event.modifiers.control && (event.text == " " || event.text == "(" || event.text == "["
                        || event.text == "{" || event.text == "$" || event.text == "`" || event.text == ")"
                        || event.text == "]" || event.text == "}")) {
                        return root.key(root.index, event.text, c, a, premiere, derniere) ? EventResult.accept : EventResult.reject;
                    }
                    EventResult.reject
                }
            }

            // The field kept in view once it is laid out: a line made at the foot of the
            // page is scrolled to before the next key, which a field out of view would
            // lose (Slint takes the keyboard from it).
            en-vue := Timer {
                interval: 1ms;
                running: false;
                triggered => {
                    self.running = false;
                    root.caret(root.index, entree.absolute-position.x + entree.curseur-x,
                        entree.absolute-position.y + entree.curseur-y + root.taille * 1.35,
                        entree.cursor-position-byte-offset + root.block.prefix-bytes,
                        entree.anchor-position-byte-offset + root.block.prefix-bytes);
                }
            }
        }

        // Drawn.
        if !root.focused: Rectangle {
            min-height: corps.preferred-height;

            corps := HorizontalLayout {
                padding-left: root.retrait;
                spacing: 8px;

                // A list item's mark.
                if root.block.kind == "bullet": Text {
                    width: 14px;
                    text: root.block.indent == 0 ? "•" : root.block.indent == 1 ? "◦" : "▪";
                    font-size: root.taille;
                    color: Tokens.text-secondary;
                    horizontal-alignment: center;
                }
                if root.block.kind == "numbered": Text {
                    min-width: 18px;
                    text: root.block.number;
                    font-size: root.taille;
                    color: Tokens.text-secondary;
                    horizontal-alignment: right;
                }
                if root.block.kind == "task": Rectangle {
                    width: 18px;
                    Check {
                        y: 3px;
                        size: 16px;
                        done: root.block.done;
                        label: "Done";
                        toggled => { root.task-toggled(root.index); }
                    }
                }
                // A quote's bar.
                if root.block.kind == "quote": Rectangle {
                    width: 3px;
                    border-radius: 1.5px;
                    background: Tokens.border-strong;
                }

                // A callout: its frame, its title line, its words unless folded.
                if root.block.kind == "callout": Rectangle {
                    width: root.largeur-mots;
                    border-radius: Tokens.radius-small;
                    background: root.block.tint.transparentize(0.9);
                    min-height: encadre.preferred-height;
                    Rectangle {
                        x: 0;
                        width: 3px;
                        border-radius: 1.5px;
                        background: root.block.tint;
                    }
                    encadre := VerticalLayout {
                        padding: 10px;
                        padding-left: 14px;
                        spacing: 4px;
                        HorizontalLayout {
                            spacing: 6px;
                            Text {
                                width: max(40px, root.largeur-mots - 48px);
                                text: root.block.number + (root.block.title != "" && root.block.number != "" ? " — " : "") + root.block.title;
                                font-size: 14px;
                                font-weight: 700;
                                color: root.block.tint;
                                wrap: word-wrap;
                            }
                            Rectangle {
                                width: 18px;
                                height: 18px;
                                accessible-role: button;
                                accessible-label: root.block.folded ? "Unfold" : "Fold";
                                accessible-action-default => { root.fold-toggled(root.index); }
                                Icon {
                                    data: root.block.folded ? Icons.chevron-right : Icons.chevron-down;
                                    size: 12px;
                                    tint: root.block.tint;
                                }
                                TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.fold-toggled(root.index); }
                                }
                            }
                        }
                        if !root.block.folded: StyledText {
                            width: max(40px, root.largeur-mots - 24px);
                            min-height: self.preferred-height;
                            vertical-alignment: top;
                            text: root.block.rich;
                            default-color: Tokens.text;
                            default-font-size: 14.5px;
                            link-color: Tokens.accent;
                            link-clicked(l) => { root.link(l); }
                        }
                    }
                }

                // A table: its cells, a grid.
                // An embedded spreadsheet takes its columns' widths from its sheet,
                // narrowed together when they do not fit.
                if root.block.kind == "table": Rectangle {
                    width: root.block.sheet ? min(root.largeur-mots, root.block.widths-total * 1px)
                        : root.largeur-mots;
                    min-height: grille.preferred-height;
                    border-width: 1px;
                    border-color: Tokens.border;
                    border-radius: Tokens.radius-small;
                    clip: true;

                    // The keys while cells are selected: beneath the cells, so it never
                    // takes their clicks; Rust hands it the keyboard.
                    if NoteSelect.sheet-block == root.index && !NoteSelect.editing: FocusScope {
                        focus-on-click: false;
                        property <int> serie: NoteSelect.cells-serial;
                        init => { self.focus(); }
                        changed serie => { self.focus(); }
                        key-pressed(event) => {
                            let nom = NoteSelect.key-name(event);
                            if (nom == "") { return reject; }
                            if (nom == "escape") {
                                // The cells let go, the keyboard back to the shortcuts.
                                NoteSelect.cell-key(nom);
                                root.key(root.index, "escape", 0, 0, false, false);
                                return accept;
                            }
                            return NoteSelect.cell-key(nom) ? accept : reject;
                        }
                    }

                    grille := VerticalLayout {
                        for ligne[r] in root.block.rows: HorizontalLayout {
                            for colonne[k] in root.block.columns: Rectangle {
                                width: root.block.sheet && k < root.block.widths.length
                                    ? root.block.widths[k] * 1px * root.echelle
                                    : root.largeur-mots / max(1, root.block.columns);
                                min-height: cellule.preferred-height + 10px;
                                background: root.cellule-choisie(r, k) ? Tokens.accent.transparentize(0.85)
                                    : r == 0 ? Tokens.surface-low : transparent;
                                border-width: root.cellule-active(r, k) ? 2px : 0.5px;
                                border-color: root.cellule-active(r, k) ? Tokens.accent : Tokens.border;
                                cellule := Text {
                                    x: 8px;
                                    width: parent.width - 16px;
                                    text: root.block.cells[r * root.block.columns + k];
                                    font-size: 13.5px;
                                    font-weight: r == 0 ? 600 : 400;
                                    color: Tokens.text;
                                    wrap: root.block.clip ? TextWrap.no-wrap : TextWrap.word-wrap;
                                    overflow: root.block.clip ? TextOverflow.elide : TextOverflow.clip;
                                    vertical-alignment: center;
                                    visible: !(NoteSelect.editing && root.cellule-active(r, k));
                                }
                                // A spreadsheet's cell: a click selects it (Shift: up to
                                // it), a double click types in it.
                                if root.block.sheet && !root.read-only: TouchArea {
                                    pointer-event(event) => {
                                        if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                                            NoteSelect.cell-pressed(root.index, r, k, event.modifiers.shift);
                                        }
                                    }
                                    double-clicked => { NoteSelect.cell-double-clicked(root.index, r, k); }
                                }
                                // Typed in: the cell's input (a formula as written).
                                if NoteSelect.editing && root.cellule-active(r, k): TextInput {
                                    x: 6px;
                                    width: parent.width - 12px;
                                    text: NoteSelect.edit-text;
                                    font-size: 13.5px;
                                    color: Tokens.text;
                                    vertical-alignment: center;
                                    single-line: true;
                                    selection-background-color: Tokens.accent.transparentize(0.7);
                                    selection-foreground-color: Tokens.text;
                                    accessible-role: text-input;
                                    accessible-label: "Cell";
                                    init => {
                                        self.focus();
                                        self.set-selection-offsets(NoteSelect.edit-cursor, NoteSelect.edit-cursor);
                                    }
                                    edited => { NoteSelect.edit-text = self.text; }
                                    // Clicked away: what was typed is kept.
                                    changed has-focus => {
                                        if (!self.has-focus) {
                                            NoteSelect.cell-committed(root.index, r, k, self.text, "left");
                                        }
                                    }
                                    key-pressed(event) => {
                                        let nom = NoteSelect.key-name(event);
                                        if (nom == "enter" || nom == "shift+enter" || nom == "tab" || nom == "shift+tab"
                                            || nom == "escape") {
                                            NoteSelect.cell-committed(root.index, r, k, self.text, nom);
                                            return accept;
                                        }
                                        reject
                                    }
                                }
                            }
                        }
                    }
                }

                // Code and maths: their text, fixed-width, on a plate. Maths drawn as an
                // image once it can be.
                if root.block.kind == "code" || (root.block.kind == "math" && !root.block.has-picture)
                    || root.block.kind == "properties": Rectangle {
                    width: root.largeur-mots;
                    min-height: fixe-texte.preferred-height + 14px;
                    background: Tokens.surface-low;
                    border-radius: Tokens.radius-small;
                    fixe-texte := Text {
                        x: 10px;
                        width: root.largeur-mots - 20px;
                        text: root.block.title;
                        font-family: Tokens.font-mono;
                        font-size: 13px;
                        color: root.block.kind == "properties" ? Tokens.text-muted : Tokens.text;
                        wrap: word-wrap;
                        vertical-alignment: center;
                    }
                }
                if root.block.has-picture: HorizontalLayout {
                    horizontal-stretch: 1;
                    alignment: root.block.kind == "math" ? LayoutAlignment.center : LayoutAlignment.start;
                    // As wide as it is, or the column: the column's width comes from
                    // the page, never from this layout, so nothing loops.
                    Image {
                        source: root.block.picture;
                        width: min(self.source.width * 1px / max(1.0, root.block.ratio),
                            root.available - root.retrait);
                        height: self.width * self.source.height / max(1, self.source.width);
                    }
                }

                if root.block.kind == "rule": Rectangle {
                    horizontal-stretch: 1;
                    height: 13px;
                    Hairline { y: 6px; }
                }

                // Words: a paragraph, a heading, a list item, a quote, a card.
                if root.block.kind == "paragraph" || root.block.kind == "heading"
                    || root.en-liste || root.block.kind == "quote" || root.block.kind == "flashcard"
                    || root.block.kind == "container" || (root.block.kind == "embed" && !root.block.has-picture): StyledText {
                    width: root.largeur-mots;
                    min-height: self.preferred-height;
                    vertical-alignment: top;
                    text: root.block.rich;
                    default-color: root.block.kind == "quote" || (root.block.kind == "task" && root.block.done)
                        ? Tokens.text-muted : Tokens.text;
                    default-font-size: root.taille;
                    link-color: Tokens.accent;
                    link-clicked(l) => { root.link(l); }
                }
            }

            // The click that edits; it steps aside while Ctrl is held, for links. It
            // leaves a checkbox, a callout's fold arrow and a spreadsheet's cells their
            // own clicks. Dragged to another block, it selects the blocks between; with
            // Shift, a click selects up to this block.
            TouchArea {
                property <bool> traine;
                x: root.block.kind == "task" ? root.retrait + 24px
                    : root.block.sheet ? root.retrait + min(root.largeur-mots, root.block.widths-total * 1px)
                    : 0px;
                width: max(0px, parent.width - self.x - (root.block.kind == "callout" ? 34px : 0px));
                enabled: !root.ctrl-held && !root.read-only;
                mouse-cursor: MouseCursor.text;
                pointer-event(event) => {
                    if (event.button != PointerEventButton.left) { return; }
                    if (event.kind == PointerEventKind.down) {
                        self.traine = false;
                        if (event.modifiers.shift && root.main) {
                            self.traine = true;
                            NoteSelect.shift-clicked(root.index);
                        }
                    } else if (event.kind == PointerEventKind.up && NoteSelect.drag-from >= 0) {
                        NoteSelect.drag-from = -1;
                    }
                }
                moved => {
                    if (self.pressed && root.main
                        && (self.mouse-y < 0px || self.mouse-y > self.height || self.traine)) {
                        self.traine = true;
                        NoteSelect.drag-from = root.index;
                        NoteSelect.drag-y = self.absolute-position.y + self.mouse-y;
                    }
                }
                clicked => {
                    if (!self.traine) {
                        root.clicked(root.index);
                    }
                }
            }

            // An embedded spreadsheet, over the click that edits: its columns' edges
            // carried to change their widths, a button to open it, and one for long words.
            if root.block.sheet: Rectangle {
                x: root.retrait;
                width: min(root.largeur-mots, root.block.widths-total * 1px);
                for bord[k] in root.block.edges: TouchArea {
                    x: bord * 1px * root.echelle - 4px;
                    width: 8px;
                    mouse-cursor: MouseCursor.col-resize;
                    pointer-event(event) => {
                        if (event.button == PointerEventButton.left && event.kind == PointerEventKind.up
                            && k < root.block.widths.length && self.mouse-x != self.pressed-x) {
                            root.col-resized(root.index, k,
                                max(30, root.block.widths[k] + (self.mouse-x - self.pressed-x) / 1px / root.echelle));
                        }
                    }
                }
                IconButton {
                    x: parent.width - 2 * self.width - 5px;
                    y: 3px;
                    icon: Icons.open-external;
                    label: "Open the spreadsheet";
                    button-size: 22px;
                    icon-size: 13px;
                    clicked => { root.sheet-option(root.index, "open"); }
                }
                IconButton {
                    x: parent.width - self.width - 3px;
                    y: 3px;
                    icon: Icons.settings;
                    label: root.block.clip ? "Wrap long words in their cells" : "Cut long words to one line";
                    button-size: 22px;
                    icon-size: 13px;
                    active: root.block.clip;
                    clicked => { root.sheet-option(root.index, "clip"); }
                }
            }
        }
    }
}

// --- On a phone ---------------------------------------------------------------------
//
// What the Android mockups (`..\Iris-design\android\notes.html`) draw in place of the
// side column and the toolbar: a page of the tree, a bar at the top of a note, sheets.
// Shown when the window is compact only; a PC keeps its columns.

// A button of a phone's top bar (the mockups' `.ib`): 44 pixels, its icon 22, grey.
component BarButton inherits IconButton {
    button-size: 44px;
    icon-size: 22px;
    tinted: true;
    tint: Tokens.text-secondary;
}

// A group's title over its rounded plate (`.grp-t`): "Pinned", "Folders".
component GroupTitle inherits Text {
    font-size: 13px;
    font-weight: 600;
    color: Tokens.text-muted;
    vertical-alignment: bottom;
}

// A line of the tree on a phone (`.tree .li`): 46 pixels, a folder's chevron, its
// icon, its name and, at the right, its count or when it changed. A folder opens and
// closes at a tap anywhere on it. A press held half a second asks for the row's menu,
// as a right-click does on a PC; a finger that moves is scrolling and asks nothing.
component PhoneTreeRow inherits Rectangle {
    in property <NoteTreeRowData> item;
    in property <bool> renaming;
    /// A row of the tree, stepped in by its depth; the pinned ones stand flat, without
    /// a chevron's room.
    in property <bool> nested: true;
    callback clicked(string);
    callback toggled(string);
    callback menu(string, length, length);
    callback renamed(string, string);
    callback rename-cancelled();

    property <bool> folder: root.item.kind == 0;
    /// Held long enough: the menu came, and the finger lifting is no tap.
    property <bool> held;
    property <bool> drifted;

    height: 46px;
    background: root.item.selected ? Tokens.surface-active
        : touch.pressed && !root.drifted ? Tokens.surface-hover : transparent;

    accessible-role: list-item;
    accessible-label: root.item.name;
    accessible-item-selected: root.item.selected;
    accessible-expanded: root.folder && root.item.expanded;
    accessible-action-default => { root.clicked(root.item.key); }

    touch := TouchArea {
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down) {
                root.held = false;
                root.drifted = false;
            }
            if (event.button == PointerEventButton.right && event.kind == PointerEventKind.up) {
                root.menu(root.item.key, self.absolute-position.x + self.mouse-x,
                    self.absolute-position.y + self.mouse-y);
            }
        }
        moved => {
            if (self.pressed && (abs(self.mouse-x - self.pressed-x) > 8px || abs(self.mouse-y - self.pressed-y) > 8px)) {
                root.drifted = true;
            }
        }
        clicked => {
            if (root.held || root.drifted) {
                root.held = false;
                return;
            }
            if (root.folder) {
                root.toggled(root.item.key);
            } else {
                root.clicked(root.item.key);
            }
        }
    }
    Timer {
        interval: 500ms;
        running: touch.pressed && !root.held && !root.drifted && !root.renaming;
        triggered => {
            root.held = true;
            root.menu(root.item.key, touch.absolute-position.x + touch.mouse-x,
                touch.absolute-position.y + touch.mouse-y);
        }
    }

    HorizontalLayout {
        padding-left: 16px + (root.nested ? root.item.depth * 24px : 0px);
        padding-right: 16px;
        spacing: 14px;
        // A folder's chevron; the room it takes kept for a file, so names line up.
        if root.nested: Rectangle {
            width: 14px;
            if root.folder && root.item.has-children: Icon {
                y: (parent.height - self.height) / 2;
                data: root.item.expanded ? Icons.chevron-down : Icons.chevron-right;
                size: 14px;
                weight: 2;
                tint: Tokens.text-muted;
            }
        }
        Icon {
            y: (parent.height - self.height) / 2;
            data: root.item.kind == 0 ? Icons.folder
                : root.item.kind == 1 ? Icons.notes
                : root.item.kind == 2 ? Icons.table
                : root.item.kind == 3 ? Icons.image
                : Icons.paperclip;
            size: 18px;
            tint: root.item.color.alpha > 0 ? root.item.color : Tokens.text-muted;
        }
        if !root.renaming: Text {
            text: root.item.name;
            font-size: 15.5px;
            // The chosen row, and a top folder open over what it holds, in bold.
            font-weight: root.item.selected || (root.nested && root.folder && root.item.expanded && root.item.depth == 0) ? 600 : 400;
            color: Tokens.text;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }
        // Escape, which the field does not want, comes up here: the old name stays.
        if root.renaming: FocusScope {
            horizontal-stretch: 1;
            key-pressed(event) => {
                if (event.text == Key.Escape) {
                    root.rename-cancelled();
                    return accept;
                }
                reject
            }
            TextField {
                y: (parent.height - self.height) / 2;
                height: 34px;
                width: parent.width;
                text: root.item.name;
                font-size: 15.5px;
                init => {
                    self.focus();
                    self.select-all();
                }
                accepted(t) => { root.renamed(root.item.key, t); }
            }
        }
        if root.item.meta != "": Text {
            text: root.item.meta;
            font-size: 14.5px;
            color: Tokens.text-muted;
            vertical-alignment: center;
        }
    }
}

// How many notes are open, in the top bar of a note (the mockups' N8): a small
// rounded square with the count; a tap lists them.
component CountButton inherits Rectangle {
    in property <int> count;
    callback clicked();
    width: 44px;
    height: 44px;
    border-radius: 22px;
    background: zone.pressed ? Tokens.surface-active : transparent;
    accessible-role: button;
    accessible-label: "Open notes";
    accessible-description: "" + root.count + " open";
    accessible-action-default => { root.clicked(); }
    Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 22px;
        height: 22px;
        border-radius: 6px;
        border-width: 1.7px;
        border-color: Tokens.text-secondary;
        Text {
            text: "" + root.count;
            font-size: 11px;
            font-weight: 700;
            color: Tokens.text-secondary;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
    zone := TouchArea {
        clicked => { root.clicked(); }
    }
}

// The quiet one of a phone's floating buttons (N3's "Revise 6"): the page's own plate
// and words, the accent kept for the pencil beside it.
component QuietFab inherits Rectangle {
    in property <string> text;
    in property <string> icon;
    callback clicked();
    width: rangee.preferred-width + 40px;
    height: 56px;
    border-radius: 18px;
    background: zone.pressed ? Tokens.surface-active : Tokens.surface;
    drop-shadow-blur: Tokens.shadow-float-blur;
    drop-shadow-offset-y: Tokens.shadow-float-y;
    drop-shadow-color: Tokens.shadow-float;
    accessible-role: button;
    accessible-label: root.text;
    accessible-action-default => { root.clicked(); }
    rangee := HorizontalLayout {
        x: 18px;
        width: self.preferred-width;
        spacing: 10px;
        Icon {
            y: (parent.height - self.height) / 2;
            data: root.icon;
            size: 18px;
            tint: Tokens.text;
        }
        Text {
            text: root.text;
            font-size: 15.5px;
            font-weight: 600;
            color: Tokens.text;
            vertical-alignment: center;
        }
    }
    zone := TouchArea {
        clicked => { root.clicked(); }
    }
}

// A grade of a flashcard on a phone (N7): its name in its colour, and under it how
// long it puts the card away.
component GradeButton inherits Rectangle {
    in property <string> text;
    in property <string> delay;
    in property <color> tint;
    callback clicked();
    horizontal-stretch: 1;
    height: 62px;
    border-radius: 22px;
    background: zone.pressed ? Tokens.surface-active : Tokens.well;
    accessible-role: button;
    accessible-label: root.text;
    accessible-description: root.delay;
    accessible-action-default => { root.clicked(); }
    VerticalLayout {
        alignment: center;
        Text {
            text: root.text;
            font-size: 15px;
            font-weight: 600;
            color: root.tint;
            horizontal-alignment: center;
        }
        if root.delay != "": Text {
            text: root.delay;
            font-size: 12px;
            color: Tokens.text-muted;
            horizontal-alignment: center;
        }
    }
    zone := TouchArea {
        clicked => { root.clicked(); }
    }
}

// --- The place ------------------------------------------------------------------------

export component NotesView inherits Rectangle {
    in property <[NoteSpaceData]> spaces;
    in property <int> space;
    in property <[NoteTreeRowData]> tree;
    in-out property <string> filter;
    /// A row whose name is being edited; empty when none.
    in property <string> renaming;

    in property <bool> open;
    in-out property <string> title;
    /// Where the note is: its folder, written out.
    in property <string> path;
    in property <string> status;
    in property <[NoteBlockData]> blocks;
    in property <int> focus-block;
    in property <int> focus-serial;
    in property <int> focus-cursor;
    in property <int> focus-anchor;
    in property <bool> ctrl-held;
    /// Raised to put the cursor in the title, its words selected (a new note).
    in property <int> title-serial;
    /// A new note's title waits to be selected, the field not made yet.
    in-out property <bool> title-pending;

    callback space-menu(length, length);
    callback row-clicked(string);
    callback row-toggled(string);
    callback row-menu(string, length, length);
    /// A right-click in the tree's empty room.
    callback area-menu(length, length);
    /// An embedded spreadsheet's column given a width; one of its options switched.
    callback col-resized(int, int, float);
    callback sheet-option(int, string);
    /// The note as plain text, in one field (the toolbar's button).
    in property <bool> source-mode;
    in property <string> source-text;
    in property <int> source-serial;
    in property <bool> source-select-all;
    callback source-toggled();
    callback source-edited(string);
    callback source-closed();
    /// The notes open in tabs (key: the note), and the one shown.
    in property <[NoteFoundData]> tabs;
    in property <int> tab-active;
    callback tab-chosen(int);
    callback tab-closed(int);
    callback tab-new();
    callback renamed(string, string);
    callback rename-cancelled();
    callback moved(string, string);
    callback new-note();
    callback new-folder();
    callback filter-edited(string);
    callback quick-open();

    callback block-edited(int, string, int);
    callback block-key(int, string, int, int, bool, bool) -> bool;
    callback block-clicked(int);
    callback link-clicked(string);
    callback task-toggled(int);
    callback fold-toggled(int);
    callback caret(int, length, length, int, int);
    callback title-accepted(string);
    /// The title being typed: the file follows once typing pauses.
    callback title-edited(string);
    /// The keyboard handed back to the shortcuts (Escape in the note).
    callback escaped();
    /// A click below the last block: the end of the note.
    callback end-clicked();
    callback ctrl-changed(bool);

    // What pops up over the cursor: the completion list, the formatting bubble over a
    // selection, a card about what the cursor is in (a link, a colour, a footnote, maths).
    in property <[NoteFoundData]> completion;
    in property <int> completion-highlight;
    // Where the cursor is in the window (the editor sets them), for what pops up.
    property <length> popup-x;
    property <length> popup-y;

    // The editor: the note drawn (`view`, `view-height` tall), the selection (`marks`)
    // and the cursor, all laid out by Rust.
    in property <[NoteViewBlock]> view;
    in property <length> view-height;
    in property <[NoteRectData]> marks;
    in property <length> caret-x;
    in property <length> caret-y;
    in property <length> caret-h;
    in property <bool> caret-visible;
    /// Raised when the cursor moved: the page scrolls to it, what pops up follows.
    in property <int> caret-serial;
    /// Raised to give the keyboard to the editor.
    in property <int> canvas-focus-serial;
    /// The pointer's shape over the note: 0 text, 1 a hand, 2 a column's edge, 3 an arrow.
    in property <int> canvas-cursor;
    callback canvas-width(length);
    callback canvas-pressed(length, length, bool, bool);
    callback canvas-dragged(length, length);
    callback canvas-released(length, length);
    callback canvas-hovered(length, length);
    callback canvas-key(string) -> bool;
    in property <bool> bubble;
    /// "", "link", "colour", "footnote", "math".
    in property <string> card;
    in property <string> card-title;
    in property <string> card-text;
    in property <image> card-picture;
    callback completion-chosen(int);
    callback format(string);
    callback card-open();

    // Beside the note: its outline, what mentions it, its tags and its length.
    in property <bool> side;
    in property <[NoteFoundData]> outline;
    in property <[NoteFoundData]> backlinks;
    in property <string> facts;
    callback side-toggled();
    callback outline-chosen(string);
    callback backlink-chosen(string);
    /// Reading mode: the whole note drawn as a page.
    in property <bool> reading;
    callback reading-toggled();
    /// Focus mode: the side column folded away, the note alone.
    in property <bool> focus-mode;
    /// Below 840 pixels: the tree shown as a page, instead of the note.
    in-out property <bool> tree-open: true;
    // A note opened from the tree: on a phone it takes the page.
    changed title => {
        if (Layout.width-class != WidthClass.expanded) {
            root.tree-open = false;
        }
    }
    callback focus-mode-toggled();
    /// The note has flashcards to revise.
    in property <bool> has-cards;
    callback revise();
    /// Another note open beside, to read while writing.
    in property <[NoteBlockData]> beside;
    in property <string> beside-title;
    callback beside-closed();
    /// A spreadsheet open in place of a note.
    in property <bool> sheet-open;
    callback new-sheet();
    /// The graph of the space's links.
    callback graph();

    // On a phone: what is pinned, over the tree, and under the space's name how many
    // notes it holds and how many flashcards wait.
    in property <[NoteTreeRowData]> pinned;
    in property <string> summary;
    /// The note's folder without the space: the breadcrumb of a phone's top bar.
    in property <string> folder;
    /// Under a phone's title, while reading: its tags, then "Edited yesterday · 1 240
    /// words". And how many flashcards it holds, on its Revise button.
    in property <[string]> tags;
    in property <string> meta;
    in property <int> cards;
    /// The sheet a phone shows over the note: "open" the notes open, "more" what else
    /// it can do, "outline" its headings and mentions. "" for none.
    in-out property <string> phone-sheet;

    // What is carried in the tree, and where the pointer is.
    property <string> carried;
    property <string> carried-name;
    property <int> carried-kind;
    /// The folder letting go would move it into ("" for none under the pointer).
    property <string> carry-target;
    property <string> dropped-key;
    property <length> carry-x;
    property <length> carry-y;
    property <int> drop;
    property <length> drop-x;
    property <length> drop-y;

    background: Tokens.surface;

    HorizontalLayout {
        // Below 840 pixels the tree is a page of its own, the one Notes opens on;
        // a note opens over it, and its "Notes" button brings the tree back. On a
        // phone that page is drawn as the mockups have it, further down.
        if !root.focus-mode && !Layout.compact: SidebarFrame {
            visible: Layout.width-class == WidthClass.expanded || root.tree-open;
            sidebar-width: root.tree-open && Layout.width-class != WidthClass.expanded
                ? Layout.window-width - (Layout.medium ? 80px : 0px)
                : Layout.width-class == WidthClass.expanded ? 232px : 0px;
            // The space: its colour and name; a click lists the others.
            Rectangle {
                height: 34px;
                border-radius: Tokens.radius-small;
                background: choix.has-hover && !Layout.touch-input ? Tokens.surface-hover : transparent;
                accessible-role: button;
                accessible-label: "Space: " + (root.space >= 0 && root.space < root.spaces.length ? root.spaces[root.space].name : "");
                accessible-action-default => { root.space-menu(self.absolute-position.x, self.absolute-position.y + self.height); }
                HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 8px;
                    spacing: 8px;
                    Rectangle {
                        y: (parent.height - self.height) / 2;
                        width: 10px;
                        height: 10px;
                        border-radius: 5px;
                        background: root.space >= 0 && root.space < root.spaces.length ? root.spaces[root.space].color : Tokens.accent;
                    }
                    Text {
                        text: root.space >= 0 && root.space < root.spaces.length ? root.spaces[root.space].name : "";
                        font-size: 14px;
                        font-weight: 600;
                        color: Tokens.text;
                        vertical-alignment: center;
                        overflow: elide;
                        horizontal-stretch: 1;
                    }
                    Icon {
                        y: (parent.height - self.height) / 2;
                        data: Icons.chevron-down;
                        size: 12px;
                        tint: Tokens.text-muted;
                    }
                }
                choix := TouchArea {
                    clicked => { root.space-menu(self.absolute-position.x, self.absolute-position.y + parent.height); }
                }
            }

            Rectangle { height: 6px; }
            TextField {
                height: 28px;
                icon: Icons.search;
                placeholder-text: "Filter";
                text <=> root.filter;
                edited(t) => { root.filter-edited(t); }
            }

            SectionRow {
                text: "Notes";
                IconButton {
                    y: (parent.height - self.height) / 2;
                    icon: Icons.folder;
                    label: "New folder";
                    button-size: 20px;
                    icon-size: 13px;
                    clicked => { root.new-folder(); }
                }
                IconButton {
                    y: (parent.height - self.height) / 2;
                    icon: Icons.table;
                    label: "New spreadsheet";
                    button-size: 20px;
                    icon-size: 13px;
                    clicked => { root.new-sheet(); }
                }
                IconButton {
                    y: (parent.height - self.height) / 2;
                    icon: Icons.plus;
                    label: "New note";
                    shortcut: "Ctrl+N";
                    button-size: 20px;
                    icon-size: 14px;
                    clicked => { root.new-note(); }
                }
            }

            arbre := ScrollView {
                vertical-stretch: 1;
                mouse-drag-pan-enabled: false;
                content-width: self.visible-width;
                VerticalLayout {
                    width: arbre.visible-width;
                    alignment: start;
                    for r in root.tree: TreeRow {
                        item: r;
                        renaming: root.renaming == r.key;
                        carrying: root.carried != "";
                        carry-x: root.carry-x;
                        carry-y: root.carry-y;
                        drop: root.drop;
                        drop-x: root.drop-x;
                        drop-y: root.drop-y;
                        clicked(k) => { root.row-clicked(k); }
                        toggled(k) => { root.row-toggled(k); }
                        menu(k, x, y) => { root.row-menu(k, x, y); }
                        renamed(k, t) => { root.renamed(k, t); }
                        rename-cancelled => { root.rename-cancelled(); }
                        carry-started(k, n, genre) => {
                            root.carried = k;
                            root.carried-name = n;
                            root.carried-kind = genre;
                            root.carry-target = "";
                        }
                        target-changed(nom, dessus) => {
                            if (dessus) {
                                root.carry-target = nom;
                            } else if (root.carry-target == nom) {
                                root.carry-target = "";
                            }
                        }
                        carry-moved(x, y) => {
                            root.carry-x = x;
                            root.carry-y = y;
                        }
                        carry-ended(x, y) => {
                            root.dropped-key = root.carried;
                            root.drop-x = x;
                            root.drop-y = y;
                            root.drop += 1;
                            root.carried = "";
                        }
                        dropped(cible) => {
                            if (root.dropped-key != "" && root.dropped-key != cible) {
                                root.moved(root.dropped-key, cible);
                            }
                        }
                    }
                    // Let go on the empty room below: the top of the space. It reaches the
                    // column's foot, and a right-click there offers what can be made.
                    Rectangle {
                        height: max(40px, arbre.visible-height - root.tree.length * Nav.row-height - 4px);
                        TouchArea {
                            pointer-event(event) => {
                                if (event.button == PointerEventButton.right && event.kind == PointerEventKind.up) {
                                    root.area-menu(self.absolute-position.x + self.mouse-x,
                                        self.absolute-position.y + self.mouse-y);
                                }
                            }
                        }
                        pure function inside(x: length, y: length) -> bool {
                            return x >= self.absolute-position.x && x < self.absolute-position.x + self.width
                                && y >= self.absolute-position.y && y < self.absolute-position.y + self.height;
                        }
                        property <bool> sous: root.carried != "" && self.inside(root.carry-x, root.carry-y);
                        changed sous => {
                            if (self.sous) {
                                root.carry-target = root.space >= 0 && root.space < root.spaces.length
                                    ? root.spaces[root.space].name : "the space";
                            } else if (root.carried != "") {
                                root.carry-target = "";
                            }
                        }
                        property <int> lache: root.drop;
                        changed lache => {
                            if (self.inside(root.drop-x, root.drop-y) && root.dropped-key != "") {
                                root.moved(root.dropped-key, "");
                            }
                        }
                        background: self.sous ? Tokens.accent.transparentize(0.85) : transparent;
                        border-radius: Tokens.radius-small;
                    }
                }
            }
        }

        VerticalLayout {
            horizontal-stretch: 1;
            visible: !(root.tree-open && Layout.width-class != WidthClass.expanded);
            max-width: root.tree-open && Layout.width-class != WidthClass.expanded ? 0px : 100000px;

            // A phone's top bar (the mockups' N2, N3, N5, N8): back to the tree; then,
            // writing, where the note is, Undo and Done; reading, the notes open, the
            // outline and the rest; a spreadsheet, its name, Undo and its menu.
            if Layout.compact: HorizontalLayout {
                height: 56px;
                vertical-stretch: 0;
                padding-left: 6px;
                padding-right: 6px;
                spacing: 2px;
                BarButton {
                    y: (parent.height - self.height) / 2;
                    icon: Icons.arrow-left;
                    label: "Back to the notes";
                    clicked => {
                        root.phone-sheet = "";
                        root.tree-open = true;
                    }
                }
                if root.open && !root.reading: Text {
                    text: root.folder;
                    font-size: 14px;
                    color: Tokens.text-muted;
                    vertical-alignment: center;
                    overflow: elide;
                    horizontal-stretch: 1;
                }
                if root.sheet-open: Text {
                    text: root.tab-active >= 0 && root.tab-active < root.tabs.length ? root.tabs[root.tab-active].title : "";
                    font-family: Tokens.font-display;
                    font-size: 18px;
                    font-weight: 600;
                    color: Tokens.text;
                    vertical-alignment: center;
                    overflow: elide;
                    horizontal-stretch: 1;
                }
                if !(root.open && !root.reading) && !root.sheet-open: Rectangle { horizontal-stretch: 1; }
                // Writing: one step back, and Done (back to reading). The `/` sheet
                // up, Undo steps aside as the mockups' N4.
                if root.open && !root.reading && root.completion.length == 0: BarButton {
                    y: (parent.height - self.height) / 2;
                    icon: Icons.undo;
                    label: "Undo";
                    clicked => { root.canvas-key("ctrl+z"); }
                }
                if root.open && !root.reading: BarButton {
                    y: (parent.height - self.height) / 2;
                    icon: Icons.check;
                    label: "Done";
                    tint: Tokens.accent;
                    clicked => {
                        if (root.source-mode) {
                            root.source-toggled();
                        } else {
                            root.reading-toggled();
                        }
                    }
                }
                // Reading: the notes open (when more than one), the outline, the rest.
                if root.open && root.reading && root.tabs.length > 1: CountButton {
                    y: (parent.height - self.height) / 2;
                    count: root.tabs.length;
                    clicked => { root.phone-sheet = "open"; }
                }
                if root.open && root.reading: BarButton {
                    y: (parent.height - self.height) / 2;
                    icon: Icons.list;
                    label: "Outline and links";
                    clicked => {
                        if (!root.side) {
                            root.side-toggled();
                        }
                        root.phone-sheet = "outline";
                    }
                }
                if root.open && root.reading: BarButton {
                    y: (parent.height - self.height) / 2;
                    icon: Icons.more;
                    label: "More";
                    clicked => { root.phone-sheet = "more"; }
                }
                // A spreadsheet: Undo, then its menu (rows, columns, export).
                if root.sheet-open: BarButton {
                    y: (parent.height - self.height) / 2;
                    icon: Icons.undo;
                    label: "Undo";
                    clicked => {
                        SheetGrid.action("undo");
                        SheetGrid.focus-serial += 1;
                    }
                }
                if root.sheet-open: BarButton {
                    y: (parent.height - self.height) / 2;
                    icon: Icons.more;
                    label: "Rows, columns, export";
                    clicked => {
                        SheetGrid.menu-x = self.absolute-position.x;
                        SheetGrid.menu-y = self.absolute-position.y + self.height;
                        SheetGrid.menu = "more";
                    }
                }
            }

            if !Layout.compact: WindowToolbar {
                if Layout.width-class != WidthClass.expanded: IconButton {
                    y: (parent.height - self.height) / 2;
                    icon: Icons.notes;
                    label: "Notes";
                    button-size: Layout.touch-input ? 44px : 30px;
                    icon-size: Layout.touch-input ? 22px : 18px;
                    clicked => { root.tree-open = true; }
                }
                Text {
                    text: root.path;
                    font-size: 12.5px;
                    color: Tokens.text-muted;
                    vertical-alignment: center;
                    overflow: elide;
                    horizontal-stretch: 1;
                }
                Text {
                    text: root.status;
                    font-size: 12px;
                    color: Tokens.text-muted;
                    vertical-alignment: center;
                }
                if root.open && root.has-cards: IconButton {
                    y: (parent.height - self.height) / 2;
                    icon: Icons.sparkle;
                    label: "Revise the flashcards";
                    button-size: 30px;
                    icon-size: 17px;
                    clicked => { root.revise(); }
                }
                if root.open: IconButton {
                    y: (parent.height - self.height) / 2;
                    icon: root.focus-mode ? Icons.collapse : Icons.expand;
                    label: root.focus-mode ? "Leave focus mode" : "Focus mode";
                    shortcut: "F11";
                    button-size: 30px;
                    icon-size: 17px;
                    active: root.focus-mode;
                    clicked => { root.focus-mode-toggled(); }
                }
                if root.open: IconButton {
                    y: (parent.height - self.height) / 2;
                    icon: Icons.code;
                    label: root.source-mode ? "Back to the blocks" : "Edit as plain text";
                    button-size: 30px;
                    icon-size: 17px;
                    active: root.source-mode;
                    clicked => { root.source-toggled(); }
                }
                if root.open: IconButton {
                    y: (parent.height - self.height) / 2;
                    icon: Icons.eye;
                    label: root.reading ? "Edit" : "Read";
                    shortcut: "Ctrl+R";
                    button-size: 30px;
                    icon-size: 17px;
                    active: root.reading;
                    clicked => { root.reading-toggled(); }
                }
                if root.open: IconButton {
                    y: (parent.height - self.height) / 2;
                    icon: Icons.sidebar;
                    label: "Outline and links";
                    button-size: 30px;
                    icon-size: 17px;
                    active: root.side;
                    clicked => { root.side-toggled(); }
                }
                IconButton {
                    y: (parent.height - self.height) / 2;
                    icon: Icons.graph;
                    label: "Links between the notes";
                    shortcut: "Ctrl+G";
                    button-size: 30px;
                    icon-size: 17px;
                    clicked => { root.graph(); }
                }
                IconButton {
                    y: (parent.height - self.height) / 2;
                    icon: Icons.search;
                    label: "Open a note";
                    shortcut: "Ctrl+O";
                    button-size: 30px;
                    icon-size: 17px;
                    clicked => { root.quick-open(); }
                }
                IconButton {
                    y: (parent.height - self.height) / 2;
                    icon: Icons.plus;
                    label: "New note";
                    shortcut: "Ctrl+N";
                    button-size: 30px;
                    icon-size: 18px;
                    tint: Tokens.accent;
                    tinted: true;
                    clicked => { root.new-note(); }
                }
            }

            // The notes open in tabs, as in Obsidian: a click shows one, its cross closes
            // it (a middle click too), + opens a new note in a new one. A phone lists
            // them in a sheet instead, from the count in its top bar.
            if root.tabs.length > 0 && !Layout.compact: Rectangle {
                height: 34px;
                background: Tokens.surface-low;
                Rectangle {
                    y: parent.height - 1px;
                    height: 1px;
                    background: Tokens.border;
                }
                HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 8px;
                    padding-top: 5px;
                    spacing: 2px;
                    alignment: start;
                    for t[i] in root.tabs: Rectangle {
                        property <bool> actif: i == root.tab-active;
                        width: min(200px, max(90px, titre-onglet.preferred-width + 46px));
                        border-radius: 7px;
                        background: self.actif ? Tokens.surface
                            : zone-onglet.has-hover ? Tokens.surface-hover : transparent;
                        border-width: self.actif ? 1px : 0px;
                        border-color: Tokens.border;
                        accessible-role: tab;
                        accessible-label: t.title;
                        accessible-item-selected: self.actif;
                        accessible-action-default => { root.tab-chosen(i); }
                        zone-onglet := TouchArea {
                            pointer-event(event) => {
                                if (event.button == PointerEventButton.middle && event.kind == PointerEventKind.up) {
                                    root.tab-closed(i);
                                }
                            }
                            clicked => { root.tab-chosen(i); }
                        }
                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 4px;
                            spacing: 4px;
                            titre-onglet := Text {
                                text: t.title;
                                font-size: 12.5px;
                                font-weight: i == root.tab-active ? 600 : 400;
                                color: i == root.tab-active ? Tokens.text : Tokens.text-secondary;
                                vertical-alignment: center;
                                overflow: elide;
                                horizontal-stretch: 1;
                            }
                            IconButton {
                                y: (parent.height - self.height) / 2;
                                icon: Icons.window-close;
                                label: "Close the tab";
                                shortcut: "Ctrl+W";
                                button-size: 20px;
                                icon-size: 10px;
                                clicked => { root.tab-closed(i); }
                            }
                        }
                    }
                    IconButton {
                        y: (parent.height - self.height) / 2 - 2px;
                        icon: Icons.plus;
                        label: "New tab";
                        shortcut: "Ctrl+T";
                        button-size: 24px;
                        icon-size: 13px;
                        clicked => { root.tab-new(); }
                    }
                }
            }

            if root.sheet-open: SheetView {
                vertical-stretch: 1;
            }

            if !root.open && !root.sheet-open: EmptyState {
                vertical-stretch: 1;
                text: Layout.compact ? "No note open. Pick one in the notes, or start one." : "No note open. Pick one on the left, or start one.";
                action: "New note";
                act => { root.new-note(); }
            }

            if root.open: HorizontalLayout {
              vertical-stretch: 1;
              page := ScrollView {
                horizontal-stretch: 1;
                mouse-drag-pan-enabled: false;
                content-width: self.visible-width;
                HorizontalLayout {
                    width: page.visible-width;
                    Rectangle { horizontal-stretch: 1; }
                    VerticalLayout {
                        horizontal-stretch: 1000;
                        max-width: 760px;
                        // A phone's page as the mockups' `.md`: 22 pixels each side.
                        padding-left: Layout.compact ? 22px : 36px;
                        padding-right: Layout.compact ? 22px : 36px;
                        padding-top: Layout.compact ? 12px : 28px;
                        padding-bottom: 120px;
                        alignment: start;
                        spacing: 0px;

                        // The note's name, which is its file's: Enter renames it.
                        titre := TextInput {
                            property <int> demande: root.title-serial;
                            changed demande => {
                                self.text = root.title;
                                self.focus();
                                self.select-all();
                                root.title-pending = false;
                            }
                            // A new note opened where none was: the title is made with it,
                            // its words selected so typing replaces them.
                            init => {
                                if (root.title-pending) {
                                    self.focus();
                                    self.select-all();
                                    root.title-pending = false;
                                }
                            }
                            edited => { root.title-edited(self.text); }
                            text: root.title;
                            font-family: Tokens.font-display;
                            // A phone's title (`.md h1`): 27 pixels, on as many lines
                            // as it takes; Enter still goes to the note.
                            font-size: Layout.compact ? 27px : 30px;
                            font-weight: Layout.compact ? 600 : 700;
                            color: Tokens.text;
                            single-line: !Layout.compact;
                            wrap: Layout.compact ? TextWrap.word-wrap : TextWrap.no-wrap;
                            selection-background-color: Tokens.accent.transparentize(0.7);
                            accessible-role: text-input;
                            accessible-label: "Note title";
                            // Typing breaks the binding: another note's title is put back
                            // by hand.
                            property <string> source: root.title;
                            changed source => { self.text = root.title; }
                            accepted => { root.title-accepted(self.text); }
                            key-pressed(event) => {
                                if (event.text == Key.Escape) {
                                    self.text = root.title;
                                    root.escaped();
                                    return accept;
                                }
                                if (event.text == Key.DownArrow || event.text == Key.Return) {
                                    root.title-accepted(self.text);
                                    root.block-clicked(0);
                                    return accept;
                                }
                                reject
                            }
                        }
                        // Read on a phone: the note's tags, when it was written, how long
                        // it is (the mockups' N3).
                        if Layout.compact && root.reading: HorizontalLayout {
                            padding-top: 4px;
                            spacing: 8px;
                            alignment: start;
                            for t in root.tags: Rectangle {
                                cross-axis-self-alignment: center;
                                width: etiquette.preferred-width + 14px;
                                height: etiquette.preferred-height + 4px;
                                border-radius: 5px;
                                background: Tokens.surface-active;
                                etiquette := Text {
                                    text: t;
                                    font-size: 12px;
                                    font-weight: 600;
                                    color: Tokens.text-secondary;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                            Text {
                                text: root.meta;
                                font-size: 13px;
                                color: Tokens.text-muted;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                        }
                        Rectangle { height: Layout.compact ? 10px : 14px; }

                        // The note, drawn as Rust laid it out: one surface for the whole
                        // text, its cursor and its selection; every key and click goes to
                        // Rust, which knows where each character is.
                        if !root.source-mode: Rectangle {
                            height: max(root.view-height, 40px);
                            property <length> largeur: min(760px, page.visible-width) - (Layout.compact ? 44px : 72px);
                            init => { root.canvas-width(self.largeur); }
                            changed largeur => { root.canvas-width(self.largeur); }

                            // Where the cursor is, in the window: what pops up goes there.
                            property <int> curseur-serie: root.caret-serial;
                            changed curseur-serie => {
                                // The cursor kept in view: the page scrolls to it.
                                if (root.caret-visible) {
                                    let haut = -page.content-y + 30px;
                                    let bas = -page.content-y + page.visible-height - 30px;
                                    let y-page = self.y + root.caret-y;
                                    let plancher = min(0px, page.visible-height - page.content-height);
                                    if (y-page + root.caret-h > bas) {
                                        page.content-y = max(plancher, -(y-page + root.caret-h + 30px - page.visible-height));
                                    } else if (y-page < haut) {
                                        page.content-y = min(0px, -(y-page - 30px));
                                    }
                                }
                                // What pops up goes under the cursor, where it is now.
                                root.popup-x = self.absolute-position.x + root.caret-x;
                                root.popup-y = self.absolute-position.y + root.caret-y + root.caret-h + 2px;
                            }

                            clavier := FocusScope {
                                focus-on-click: false;
                                property <int> serie: root.canvas-focus-serial;
                                changed serie => { self.focus(); }
                                key-pressed(event) => {
                                    if (event.text == Key.Control) {
                                        root.ctrl-changed(true);
                                        return reject;
                                    }
                                    let nom = NoteSelect.key-name(event);
                                    if (nom == "") { return reject; }
                                    let pris = root.canvas-key(nom);
                                    if (nom == "escape") {
                                        root.escaped();
                                        return accept;
                                    }
                                    return pris ? accept : reject;
                                }
                                key-released(event) => {
                                    if (event.text == Key.Control) {
                                        root.ctrl-changed(false);
                                    }
                                    reject
                                }

                                for b in root.view: Rectangle {
                                    y: b.y;
                                    height: b.h;
                                    for r in b.rects: Rectangle {
                                        x: r.x;
                                        y: r.y;
                                        width: r.w;
                                        height: r.h;
                                        background: r.color;
                                        border-radius: r.radius;
                                        border-color: r.border;
                                        border-width: r.border-width;
                                    }
                                    for p in b.images: Image {
                                        x: p.x;
                                        y: p.y;
                                        width: p.w;
                                        height: p.h;
                                        source: p.image;
                                    }
                                    for t in b.runs: Text {
                                        x: t.x;
                                        y: t.y;
                                        height: t.h;
                                        text: t.text;
                                        font-size: t.size;
                                        font-weight: t.weight;
                                        font-italic: t.italic;
                                        font-family: t.family == 1 ? Tokens.font-mono
                                            : t.family == 2 ? Tokens.font-display : Tokens.font-family;
                                        color: t.color;
                                        wrap: no-wrap;
                                        vertical-alignment: top;
                                    }
                                    for ic in b.icons: Icon {
                                        x: ic.x;
                                        y: ic.y;
                                        width: ic.size;
                                        height: ic.size;
                                        size: ic.size;
                                        data: NoteSelect.icon(ic.name);
                                        tint: ic.tint;
                                    }
                                }

                                // The selection, over the words, and the cursor.
                                for s in root.marks: Rectangle {
                                    x: s.x;
                                    y: s.y;
                                    width: s.w;
                                    height: s.h;
                                    background: s.color;
                                    border-radius: s.radius;
                                }
                                Rectangle {
                                    visible: root.caret-visible && !root.reading;
                                    x: root.caret-x;
                                    y: root.caret-y;
                                    width: 1.5px;
                                    height: root.caret-h;
                                    background: Tokens.text;
                                }

                                // Clicks, drags and the pointer's shape, all measured by Rust.
                                TouchArea {
                                    mouse-cursor: root.canvas-cursor == 1 ? MouseCursor.pointer
                                        : root.canvas-cursor == 2 ? MouseCursor.col-resize
                                        : root.canvas-cursor == 3 ? MouseCursor.default : MouseCursor.text;
                                    pointer-event(event) => {
                                        if (event.button != PointerEventButton.left) { return; }
                                        if (event.kind == PointerEventKind.down) {
                                            clavier.focus();
                                            root.canvas-pressed(self.mouse-x, self.mouse-y,
                                                event.modifiers.shift, event.modifiers.control);
                                        } else if (event.kind == PointerEventKind.up) {
                                            root.canvas-released(self.mouse-x, self.mouse-y);
                                        }
                                    }
                                    moved => {
                                        if (self.pressed) {
                                            root.canvas-dragged(self.mouse-x, self.mouse-y);
                                        }
                                    }
                                    property <length> survol-x: self.mouse-x;
                                    property <length> survol-y: self.mouse-y;
                                    changed survol-y => {
                                        if (!self.pressed && self.has-hover) { root.canvas-hovered(self.mouse-x, self.mouse-y); }
                                    }
                                    changed survol-x => {
                                        if (!self.pressed && self.has-hover) { root.canvas-hovered(self.mouse-x, self.mouse-y); }
                                    }
                                }

                                // A spreadsheet's cell typed in, over its cell.
                                if NoteSelect.editing: TextInput {
                                    x: NoteSelect.edit-x + 6px;
                                    y: NoteSelect.edit-y;
                                    width: max(20px, NoteSelect.edit-w - 12px);
                                    height: NoteSelect.edit-h;
                                    text: NoteSelect.edit-text;
                                    font-size: 13.5px;
                                    color: Tokens.text;
                                    vertical-alignment: center;
                                    single-line: true;
                                    selection-background-color: Tokens.accent.transparentize(0.7);
                                    selection-foreground-color: Tokens.text;
                                    accessible-role: text-input;
                                    accessible-label: "Cell";
                                    init => {
                                        self.focus();
                                        self.set-selection-offsets(NoteSelect.edit-cursor, NoteSelect.edit-cursor);
                                    }
                                    edited => { NoteSelect.edit-text = self.text; }
                                    // Ended by a key: the focus it then gives away is no click.
                                    property <bool> fini;
                                    // Clicked away: what was typed is kept.
                                    changed has-focus => {
                                        if (!self.has-focus && !self.fini) {
                                            NoteSelect.cell-committed(NoteSelect.sheet-block, NoteSelect.row, NoteSelect.col, self.text, "left");
                                        }
                                    }
                                    key-pressed(event) => {
                                        let nom = NoteSelect.key-name(event);
                                        if (nom == "enter" || nom == "shift+enter" || nom == "tab" || nom == "shift+tab"
                                            || nom == "escape") {
                                            self.fini = true;
                                            NoteSelect.cell-committed(NoteSelect.sheet-block, NoteSelect.row, NoteSelect.col, self.text, nom);
                                            clavier.focus();
                                            return accept;
                                        }
                                        reject
                                    }
                                }
                            }
                        }

                        // The whole note as plain text, in one field: selected with the
                        // mouse across lines, Ctrl+A, copied, pasted. Escape returns to the
                        // blocks. (Rust empties the blocks while it shows.)
                        if root.source-mode: Text {
                            text: "Plain text — Escape returns to the note's blocks.";
                            font-size: 11.5px;
                            color: Tokens.text-muted;
                        }
                        if root.source-mode: Rectangle {
                            min-height: texte-brut.preferred-height + 16px;
                            texte-brut := TextInput {
                                y: 8px;
                                width: parent.width;
                                text: root.source-text;
                                font-family: Tokens.font-mono;
                                font-size: 13.5px;
                                color: Tokens.text;
                                wrap: word-wrap;
                                single-line: false;
                                selection-background-color: Tokens.accent.transparentize(0.7);
                                selection-foreground-color: Tokens.text;
                                accessible-role: text-input;
                                accessible-label: "The note as plain text";
                                property <int> serie: root.source-serial;
                                init => {
                                    self.focus();
                                    if (root.source-select-all) { self.select-all(); }
                                }
                                changed serie => {
                                    self.text = root.source-text;
                                    self.focus();
                                    if (root.source-select-all) { self.select-all(); }
                                }
                                edited => { root.source-edited(self.text); }
                                key-pressed(event) => {
                                    if (event.text == Key.Escape) {
                                        root.source-closed();
                                        return accept;
                                    }
                                    reject
                                }
                            }
                        }

                        // Below the last block: a click writes at the end.
                        Rectangle {
                            height: 80px;
                            TouchArea {
                                enabled: !root.reading;
                                mouse-cursor: MouseCursor.text;
                                clicked => { root.end-clicked(); }
                            }
                        }
                    }
                    Rectangle { horizontal-stretch: 1; }
                }
              }

              // Another note beside, to read while writing: drawn, links followed.
              if root.beside.length > 0 && !Layout.compact: Rectangle {
                horizontal-stretch: 0.8;
                background: Tokens.surface;
                Rectangle {
                    x: 0;
                    width: 1px;
                    background: Tokens.border;
                }
                VerticalLayout {
                    x: 1px;
                    width: parent.width - 1px;
                    HorizontalLayout {
                        height: 38px;
                        padding-left: 16px;
                        padding-right: 8px;
                        Text {
                            text: root.beside-title;
                            font-size: 13px;
                            font-weight: 600;
                            color: Tokens.text;
                            vertical-alignment: center;
                            overflow: elide;
                            horizontal-stretch: 1;
                        }
                        IconButton {
                            y: (parent.height - self.height) / 2;
                            icon: Icons.window-close;
                            label: "Close the note beside";
                            button-size: 26px;
                            icon-size: 13px;
                            clicked => { root.beside-closed(); }
                        }
                    }
                    a-cote := ScrollView {
                        vertical-stretch: 1;
                        content-width: self.visible-width;
                        mouse-drag-pan-enabled: false;
                        VerticalLayout {
                            width: a-cote.visible-width;
                            alignment: start;
                            padding-left: 22px;
                            padding-right: 22px;
                            padding-bottom: 60px;
                            for b[i] in root.beside: NoteBlock {
                                block: b;
                                index: i;
                                focused: false;
                                read-only: true;
                                available: a-cote.visible-width - 44px;
                                link(l) => { root.link-clicked(l); }
                            }
                        }
                    }
                }
              }

              // Beside the note: its outline, what mentions it, its tags and length.
              if root.side && !Layout.compact: Rectangle {
                width: 250px;
                background: Tokens.surface-low;
                Rectangle {
                    x: 0;
                    width: 1px;
                    background: Tokens.border;
                }
                cote := ScrollView {
                    x: 1px;
                    width: parent.width - 1px;
                    content-width: self.visible-width;
                    mouse-drag-pan-enabled: false;
                    VerticalLayout {
                        width: cote.visible-width;
                        alignment: start;
                        padding: 12px;
                        spacing: 2px;
                        Text {
                            text: root.facts;
                            font-size: 11.5px;
                            color: Tokens.text-muted;
                            wrap: word-wrap;
                        }
                        SectionRow { text: "Outline"; }
                        if root.outline.length == 0: Text {
                            text: "No headings.";
                            font-size: 12px;
                            color: Tokens.text-muted;
                        }
                        for h in root.outline: Rectangle {
                            height: 26px;
                            border-radius: Tokens.radius-small;
                            background: plan.has-hover ? Tokens.surface-hover : transparent;
                            Text {
                                x: 6px + (h.detail.to-float() - 1) * 12px;
                                width: parent.width - self.x - 6px;
                                text: h.title;
                                font-size: 12.5px;
                                font-weight: h.detail == "1" ? 600 : 400;
                                color: Tokens.text;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                            plan := TouchArea {
                                clicked => { root.outline-chosen(h.key); }
                            }
                        }
                        SectionRow { text: "Mentioned in"; }
                        if root.backlinks.length == 0: Text {
                            text: "No note links here yet.";
                            font-size: 12px;
                            color: Tokens.text-muted;
                            wrap: word-wrap;
                        }
                        for l in root.backlinks: Rectangle {
                            min-height: lien-retour.preferred-height + 10px;
                            border-radius: Tokens.radius-small;
                            background: retour.has-hover ? Tokens.surface-hover : transparent;
                            lien-retour := VerticalLayout {
                                padding: 5px;
                                padding-left: 6px;
                                Text {
                                    text: l.title;
                                    font-size: 12.5px;
                                    font-weight: 600;
                                    color: Tokens.accent;
                                    overflow: elide;
                                }
                                Text {
                                    text: l.detail;
                                    font-size: 11.5px;
                                    color: Tokens.text-muted;
                                    wrap: word-wrap;
                                }
                            }
                            retour := TouchArea {
                                clicked => { root.backlink-chosen(l.key); }
                            }
                        }
                    }
                }
              }
            }

            // On a touch screen, the formatting a keyboard's Ctrl gives on a PC. Its
            // last key puts the keyboard away: the shortcuts take the keys back.
            if root.open && !root.reading && Layout.touch-input: FormatBar {
                vertical-stretch: 0;
                act(k) => {
                    if (k == "hide-keyboard") {
                        root.escaped();
                    } else {
                        root.canvas-key(k);
                    }
                }
            }
        }
    }

    // --- Over the cursor ---

    // The completion list: it scrolls to the row the arrows reach; the `/` menu shows
    // an icon on each row and, beside it, a card of the block highlighted.
    property <length> ligne-completion: root.completion.length > 0 && root.completion[0].detail != "" ? 40px : 30px;
    if root.completion.length > 0 && !Layout.compact: Rectangle {
        x: min(root.popup-x - root.absolute-position.x, root.width - 300px);
        y: min(root.popup-y - root.absolute-position.y, root.height - self.height - 8px);
        width: 290px;
        height: min(liste-completion.preferred-height, 312px);
        border-radius: Tokens.radius-medium;
        background: Tokens.surface;
        border-width: 1px;
        border-color: Tokens.border;
        drop-shadow-blur: 14px;
        drop-shadow-offset-y: 4px;
        drop-shadow-color: Tokens.shadow-float;
        clip: true;
        defile := Flickable {
            width: parent.width;
            height: parent.height;
            content-height: liste-completion.preferred-height;
            property <int> rang: root.completion-highlight;
            changed rang => {
                let haut = self.rang * root.ligne-completion + 4px;
                let bas = haut + root.ligne-completion;
                if (haut + self.content-y < 4px) {
                    self.content-y = 4px - haut;
                } else if (bas + self.content-y > self.height - 4px) {
                    self.content-y = self.height - 4px - bas;
                }
            }
            liste-completion := VerticalLayout {
                width: defile.width;
                padding: 4px;
                for c[i] in root.completion: Rectangle {
                    height: root.ligne-completion;
                    border-radius: Tokens.radius-small;
                    background: i == root.completion-highlight ? Tokens.accent : choix-completion.has-hover ? Tokens.surface-hover : transparent;
                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        spacing: 10px;
                        if BlockPreview.icon(c.key) != "": Icon {
                            y: (parent.height - self.height) / 2;
                            data: BlockPreview.icon(c.key);
                            size: 15px;
                            tint: i == root.completion-highlight ? Tokens.accent-text : Tokens.text-secondary;
                        }
                        VerticalLayout {
                            alignment: center;
                            Text {
                                text: c.title;
                                font-size: 13px;
                                color: i == root.completion-highlight ? Tokens.accent-text : Tokens.text;
                                overflow: elide;
                            }
                            if c.detail != "": Text {
                                text: c.detail;
                                font-size: 11px;
                                color: i == root.completion-highlight ? Tokens.accent-text : Tokens.text-muted;
                                overflow: elide;
                            }
                        }
                    }
                    choix-completion := TouchArea {
                        clicked => { root.completion-chosen(i); }
                    }
                }
            }
        }
    }
    // Beside it, on the side with room. A phone has no room: the icon says enough.
    if root.completion.length > 0 && BlockPreview.family != "" && !Layout.compact: BlockPreviewCard {
        property <length> gauche: min(root.popup-x - root.absolute-position.x, root.width - 300px);
        x: self.gauche + 290px + 8px + self.width <= root.width ? self.gauche + 298px : max(8px, self.gauche - self.width - 8px);
        y: min(root.popup-y - root.absolute-position.y, root.height - self.height - 8px);
    }

    // On a phone the list rises as a sheet over the keyboard, which stays up: typing
    // goes on filtering it (the mockups' N4). The `/` blocks stand in two columns,
    // each its icon and name; notes to link to, one a line with their folder.
    property <bool> completion-blocs: root.completion.length > 0 && BlockPreview.icon(root.completion[0].key) != "";
    property <length> case-largeur: (root.width - 16px) / 2;
    if root.completion.length > 0 && Layout.compact: Rectangle {
        y: root.height - self.height;
        width: root.width;
        height: min(liste-tel.height + 21px, 420px);
        border-top-left-radius: 22px;
        border-top-right-radius: 22px;
        background: Tokens.panel;
        drop-shadow-blur: Tokens.shadow-window-blur;
        drop-shadow-color: Tokens.shadow-window;
        clip: true;
        // Taps inside stay inside.
        TouchArea {}
        Rectangle {
            x: (parent.width - self.width) / 2;
            y: 8px;
            width: 40px;
            height: 5px;
            border-radius: 3px;
            background: Tokens.border-strong;
        }
        Flickable {
            y: 17px;
            height: parent.height - 17px;
            content-height: liste-tel.height + 4px;
            liste-tel := Rectangle {
                y: 4px;
                width: root.width;
                height: (root.completion-blocs ? ceil(root.completion.length / 2) * 56px : root.completion.length * 56px) + 14px;
                for c[i] in root.completion: Rectangle {
                    x: root.completion-blocs ? 8px + mod(i, 2) * root.case-largeur : 8px;
                    y: root.completion-blocs ? floor(i / 2) * 56px : i * 56px;
                    width: root.completion-blocs ? root.case-largeur : root.width - 16px;
                    height: 56px;
                    border-radius: 12px;
                    background: i == root.completion-highlight || choix-tel.pressed ? Tokens.surface-active : transparent;
                    accessible-role: button;
                    accessible-label: c.title;
                    accessible-action-default => { root.completion-chosen(i); }
                    HorizontalLayout {
                        padding-left: 14px;
                        padding-right: 14px;
                        spacing: 12px;
                        if BlockPreview.icon(c.key) != "" || !root.completion-blocs: Icon {
                            y: (parent.height - self.height) / 2;
                            data: BlockPreview.icon(c.key) != "" ? BlockPreview.icon(c.key) : Icons.notes;
                            size: 22px;
                            tint: Tokens.text-muted;
                        }
                        VerticalLayout {
                            alignment: center;
                            Text {
                                text: c.title;
                                font-size: 16px;
                                color: Tokens.text;
                                overflow: elide;
                            }
                            if !root.completion-blocs && c.detail != "": Text {
                                text: c.detail;
                                font-size: 13px;
                                color: Tokens.text-muted;
                                overflow: elide;
                            }
                        }
                    }
                    choix-tel := TouchArea {
                        clicked => { root.completion-chosen(i); }
                    }
                }
            }
        }
    }

    // The bubble over a selection: the marks, a colour, a link.
    if root.bubble && root.completion.length == 0: Rectangle {
        x: min(max(8px, root.popup-x - root.absolute-position.x - 120px), root.width - self.width - 8px);
        y: max(8px, root.popup-y - root.absolute-position.y - 74px);
        width: barre.preferred-width + 8px;
        height: 36px;
        border-radius: Tokens.radius-medium;
        background: Tokens.surface;
        border-width: 1px;
        border-color: Tokens.border;
        drop-shadow-blur: 12px;
        drop-shadow-offset-y: 3px;
        drop-shadow-color: #00000030;
        barre := HorizontalLayout {
            x: 4px;
            spacing: 1px;
            alignment: start;
            for f in [
                { k: "bold", t: "B", l: "Bold", s: "Ctrl+B" },
                { k: "italic", t: "I", l: "Italic", s: "Ctrl+I" },
                { k: "underline", t: "U", l: "Underline", s: "Ctrl+U" },
                { k: "strike", t: "S", l: "Strikethrough", s: "Ctrl+Shift+X" },
                { k: "highlight", t: "H", l: "Highlight", s: "Ctrl+Shift+H" },
                { k: "code", t: "</>", l: "Code", s: "Ctrl+E" },
                { k: "math", t: "∑", l: "Maths", s: "Ctrl+M" },
                { k: "link", t: "[[", l: "Link to a note", s: "Ctrl+L" },
                { k: "weblink", t: "↗", l: "Web link", s: "Ctrl+K" },
                { k: "colour", t: "A", l: "Colour", s: "Ctrl+Shift+1…7" },
            ]: Rectangle {
                y: 4px;
                width: max(28px, lettre.preferred-width + 14px);
                height: 28px;
                border-radius: Tokens.radius-small;
                background: bouton.has-hover ? Tokens.surface-hover : transparent;
                accessible-role: button;
                accessible-label: f.l;
                accessible-description: f.s;
                accessible-action-default => { root.format(f.k); }
                lettre := Text {
                    text: f.t;
                    font-size: 13.5px;
                    font-weight: f.k == "bold" ? 800 : 500;
                    font-italic: f.k == "italic";
                    color: f.k == "colour" ? Tokens.red : Tokens.text;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                Rectangle {
                    visible: f.k == "underline";
                    y: parent.height - 8px;
                    x: (parent.width - 10px) / 2;
                    width: 10px;
                    height: 1px;
                    background: Tokens.text;
                }
                Rectangle {
                    visible: f.k == "strike";
                    y: parent.height / 2;
                    x: (parent.width - 10px) / 2;
                    width: 10px;
                    height: 1px;
                    background: Tokens.text;
                }
                bouton := TouchArea {
                    clicked => { root.format(f.k); }
                }
                // Its name and shortcut, when pointed at a moment.
                if bouton.has-hover: Rectangle {
                    y: parent.height + 4px;
                    x: 0;
                    width: bulle-aide.preferred-width + 14px;
                    height: 22px;
                    border-radius: Tokens.radius-small;
                    background: Tokens.text;
                    bulle-aide := Text {
                        text: f.l + "  " + f.s;
                        font-size: 11px;
                        color: Tokens.surface;
                    }
                }
            }
        }
    }

    // A card about what the cursor is in: a link's note, a colour to change, a
    // footnote, maths.
    if root.card != "" && root.completion.length == 0 && !root.bubble: Rectangle {
        x: min(max(8px, root.popup-x - root.absolute-position.x), root.width - self.width - 8px);
        y: min(root.popup-y - root.absolute-position.y + 4px, root.height - self.height - 8px);
        width: root.card == "colour" ? 264px : 320px;
        height: carte.preferred-height + 12px;
        border-radius: Tokens.radius-medium;
        background: Tokens.surface;
        border-width: 1px;
        border-color: Tokens.border;
        drop-shadow-blur: 12px;
        drop-shadow-offset-y: 3px;
        drop-shadow-color: #00000030;
        carte := VerticalLayout {
            padding: 10px;
            spacing: 6px;
            if root.card-title != "": Text {
                text: root.card-title;
                font-size: 12.5px;
                font-weight: 600;
                color: Tokens.text;
                overflow: elide;
            }
            if root.card == "colour": HorizontalLayout {
                spacing: 6px;
                for teinte[i] in [Tokens.red, Tokens.orange, Tokens.yellow, Tokens.green, Tokens.blue, Tokens.purple, Tokens.grey]: Rectangle {
                    width: 24px;
                    height: 24px;
                    border-radius: 12px;
                    background: teinte;
                    border-width: pastille.has-hover ? 2px : 0px;
                    border-color: Tokens.text;
                    accessible-role: button;
                    accessible-label: "Colour " + (i + 1);
                    accessible-action-default => { root.format("colour:" + i); }
                    pastille := TouchArea {
                        clicked => { root.format("colour:" + i); }
                    }
                }
                Rectangle {
                    width: 24px;
                    height: 24px;
                    border-radius: 12px;
                    border-width: 1px;
                    border-color: Tokens.border-strong;
                    accessible-role: button;
                    accessible-label: "Default colour";
                    accessible-action-default => { root.format("colour:none"); }
                    Text {
                        text: "×";
                        color: Tokens.text-muted;
                        font-size: 14px;
                    }
                    TouchArea {
                        clicked => { root.format("colour:none"); }
                    }
                }
            }
            if root.card-picture.width > 0: Image {
                source: root.card-picture;
                width: min(self.source.width * 1px, 296px);
                height: self.width * self.source.height / max(1, self.source.width);
            }
            if root.card-text != "": Text {
                text: root.card-text;
                font-size: 12.5px;
                color: Tokens.text-secondary;
                wrap: word-wrap;
            }
            if root.card == "link": HorizontalLayout {
                alignment: end;
                Button {
                    text: "Open";
                    size: ButtonSize.sm;
                    clicked => { root.card-open(); }
                }
            }
        }
    }

    // What is carried, under the pointer: what it is, and where letting go puts it.
    if root.carried != "": Rectangle {
        x: root.carry-x - root.absolute-position.x + 14px;
        y: root.carry-y - root.absolute-position.y + 10px;
        width: max(nom-porte.preferred-width + 30px, ou-porte.preferred-width) + 22px;
        height: root.carry-target != "" ? 48px : 30px;
        border-radius: 8px;
        background: Tokens.surface-high;
        border-width: 1px;
        border-color: Tokens.border-strong;
        drop-shadow-blur: 14px;
        drop-shadow-offset-y: 4px;
        drop-shadow-color: Tokens.shadow-float;
        VerticalLayout {
            padding-left: 11px;
            padding-right: 11px;
            alignment: center;
            spacing: 2px;
            HorizontalLayout {
                spacing: 7px;
                Icon {
                    y: (parent.height - self.height) / 2;
                    data: root.carried-kind == 0 ? Icons.folder
                        : root.carried-kind == 1 ? Icons.notes
                        : root.carried-kind == 2 ? Icons.table
                        : root.carried-kind == 3 ? Icons.image : Icons.paperclip;
                    size: 14px;
                    tint: Tokens.text-secondary;
                }
                nom-porte := Text {
                    text: root.carried-name;
                    font-size: 12.5px;
                    font-weight: 600;
                    color: Tokens.text;
                    vertical-alignment: center;
                }
            }
            ou-porte := Text {
                visible: root.carry-target != "";
                text: root.carry-target == "" ? "" : "Move into “" + root.carry-target + "”";
                font-size: 11.5px;
                color: Tokens.text-muted;
            }
        }
    }

    // A note or a spreadsheet tapped in a phone's tree takes the page, even the one
    // already open (its title does not change, so nothing else would turn the page).
    function open-row(key: string, kind: int) {
        root.row-clicked(key);
        if (kind == 1 || kind == 2) {
            root.tree-open = false;
        }
    }

    // A phone's first page (the mockups' N1): the space's name, large, and what it
    // holds; what is pinned; then the folders, as a tree on one rounded plate. The
    // bar over it opens the graph, Quick open and what can be made.
    if Layout.compact && root.tree-open: Rectangle {
        background: Tokens.background;
        VerticalLayout {
            HorizontalLayout {
                height: 56px;
                padding-left: 6px;
                padding-right: 6px;
                spacing: 2px;
                Rectangle { horizontal-stretch: 1; }
                BarButton {
                    y: (parent.height - self.height) / 2;
                    icon: Icons.graph;
                    label: "Links between the notes";
                    clicked => { root.graph(); }
                }
                BarButton {
                    y: (parent.height - self.height) / 2;
                    icon: Icons.search;
                    label: "Open a note";
                    clicked => { root.quick-open(); }
                }
                BarButton {
                    y: (parent.height - self.height) / 2;
                    icon: Icons.more;
                    label: "New, and the space's folder";
                    clicked => { root.area-menu(self.absolute-position.x, self.absolute-position.y + self.height); }
                }
            }
            // The space: a tap lists the others.
            VerticalLayout {
                padding-left: 18px;
                padding-right: 18px;
                padding-top: 2px;
                padding-bottom: 10px;
                spacing: 2px;
                Rectangle {
                    height: 37px;
                    accessible-role: button;
                    accessible-label: "Space: " + (root.space >= 0 && root.space < root.spaces.length ? root.spaces[root.space].name : "");
                    accessible-action-default => { root.space-menu(self.absolute-position.x, self.absolute-position.y + self.height); }
                    HorizontalLayout {
                        alignment: start;
                        spacing: 6px;
                        Text {
                            text: root.space >= 0 && root.space < root.spaces.length ? root.spaces[root.space].name : "";
                            font-family: Tokens.font-display;
                            font-size: 32px;
                            font-weight: 600;
                            letter-spacing: -0.4px;
                            color: Tokens.text;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                        Icon {
                            y: (parent.height - self.height) / 2;
                            data: Icons.chevron-down;
                            size: 18px;
                            tint: Tokens.text;
                        }
                    }
                    TouchArea {
                        clicked => { root.space-menu(self.absolute-position.x, self.absolute-position.y + parent.height); }
                    }
                }
                if root.summary != "": Text {
                    text: root.summary;
                    font-size: 14px;
                    color: Tokens.text-muted;
                }
            }
            arbre-tel := ScrollView {
                vertical-stretch: 1;
                mouse-drag-pan-enabled: false;
                content-width: self.visible-width;
                VerticalLayout {
                    width: arbre-tel.visible-width;
                    alignment: start;
                    // Room under the last row for New note, floating over it.
                    padding-bottom: 88px;
                    if root.pinned.length > 0: HorizontalLayout {
                        padding-left: 32px;
                        padding-right: 32px;
                        padding-top: 18px;
                        padding-bottom: 7px;
                        GroupTitle { text: "Pinned"; }
                    }
                    if root.pinned.length > 0: HorizontalLayout {
                        padding-left: 16px;
                        padding-right: 16px;
                        Rectangle {
                            height: root.pinned.length * 46px;
                            border-radius: 14px;
                            background: Tokens.surface;
                            clip: true;
                            VerticalLayout {
                                for p in root.pinned: PhoneTreeRow {
                                    item: p;
                                    nested: false;
                                    renaming: root.renaming == p.key;
                                    clicked(k) => { root.open-row(k, p.kind); }
                                    toggled(k) => { root.row-toggled(k); }
                                    menu(k, x, y) => { root.row-menu(k, x, y); }
                                    renamed(k, t) => { root.renamed(k, t); }
                                    rename-cancelled => { root.rename-cancelled(); }
                                }
                            }
                        }
                    }
                    if root.tree.length > 0: HorizontalLayout {
                        padding-left: 32px;
                        padding-right: 32px;
                        padding-top: 18px;
                        padding-bottom: 7px;
                        GroupTitle { text: root.filter != "" ? "Found" : "Folders"; }
                    }
                    if root.tree.length > 0: HorizontalLayout {
                        padding-left: 16px;
                        padding-right: 16px;
                        Rectangle {
                            height: root.tree.length * 46px + 8px;
                            border-radius: 14px;
                            background: Tokens.surface;
                            clip: true;
                            VerticalLayout {
                                padding-top: 4px;
                                padding-bottom: 4px;
                                for r in root.tree: PhoneTreeRow {
                                    item: r;
                                    renaming: root.renaming == r.key;
                                    clicked(k) => { root.open-row(k, r.kind); }
                                    toggled(k) => { root.row-toggled(k); }
                                    menu(k, x, y) => { root.row-menu(k, x, y); }
                                    renamed(k, t) => { root.renamed(k, t); }
                                    rename-cancelled => { root.rename-cancelled(); }
                                }
                            }
                        }
                    }
                    if root.tree.length == 0 && root.pinned.length == 0: Text {
                        height: 120px;
                        text: "No note yet. New note starts one.";
                        font-size: 15px;
                        color: Tokens.text-muted;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }

    // Under the thumb on a phone, as the mockups draw them: New note over the tree; over
    // a note being read, the pencil (writing it) and, when it holds flashcards, Revise.
    if Layout.compact && root.tree-open: Fab {
        x: parent.width - self.width - 16px;
        y: parent.height - self.height - 16px;
        text: "New note";
        icon: Icons.plus;
        clicked => { root.new-note(); }
    }
    if Layout.compact && !root.tree-open && root.open && root.reading && !root.sheet-open: Fab {
        // Round: the pencil alone says it (`.fab.round`).
        width: 56px;
        x: parent.width - self.width - 16px;
        y: parent.height - self.height - 16px;
        text: "";
        icon: Icons.pencil;
        accessible-label: "Edit";
        clicked => { root.reading-toggled(); }
    }
    if Layout.compact && !root.tree-open && root.open && root.reading && !root.sheet-open && root.cards > 0: QuietFab {
        x: 16px;
        y: parent.height - self.height - 16px;
        text: "Revise " + root.cards;
        icon: Icons.cards;
        clicked => { root.revise(); }
    }
}

// The menu of a row of the tree.
export component NotesRowMenu inherits Rectangle {
    in property <length> menu-x;
    in property <length> menu-y;
    /// 0 folder, 1 note, 2 spreadsheet, 3 image, 4 other.
    in property <int> kind;
    in property <bool> pinned;
    /// The colours a folder can take, and its own (-1: none).
    in property <[color]> palette;
    in property <int> colour: -1;
    callback chosen(string);
    callback dismissed();

    TouchArea {
        width: 100%;
        height: 100%;
        clicked => { root.dismissed(); }
    }
    MenuSurface {
        dismissed => { root.dismissed(); }
        available-width: root.width;
        available-height: root.height;
        menu-x: root.menu-x;
        menu-y: root.menu-y;
        menu-width: 230px;
        menu-height: entries.preferred-height + 8px;
        entries := VerticalLayout {
            padding: 4px;
            if root.kind == 0: MenuEntry {
                icon: Icons.plus;
                label: "New note here";
                activated => { root.chosen("new-note"); }
            }
            if root.kind == 0: MenuEntry {
                icon: Icons.folder;
                label: "New folder here";
                activated => { root.chosen("new-folder"); }
            }
            if root.kind == 0: MenuEntry {
                icon: Icons.table;
                label: "New spreadsheet here";
                activated => { root.chosen("new-sheet"); }
            }
            if root.kind == 0: MenuEntry {
                icon: Icons.sparkle;
                label: "Revise its flashcards";
                activated => { root.chosen("revise"); }
            }
            if root.kind == 0: MenuSeparator {}
            // Its colour: a click on a swatch, the ring on the one it wears.
            if root.kind == 0: HorizontalLayout {
                padding-left: 10px;
                padding-right: 10px;
                padding-top: 4px;
                padding-bottom: 4px;
                spacing: 6px;
                height: 30px;
                aucune := Rectangle {
                    cross-axis-self-alignment: center;
                    width: 18px;
                    height: 18px;
                    border-radius: 9px;
                    border-width: root.colour < 0 || aucune-zone.has-hover ? 2px : 1px;
                    border-color: root.colour < 0 ? Tokens.text : Tokens.border-strong;
                    accessible-role: button;
                    accessible-label: "No colour";
                    accessible-action-default => { root.chosen("colour:none"); }
                    Path {
                        width: 100%;
                        height: 100%;
                        viewbox-width: 18;
                        viewbox-height: 18;
                        commands: "M 5 13 L 13 5";
                        stroke: Tokens.text-muted;
                        stroke-width: 1.5px;
                    }
                    aucune-zone := TouchArea {
                        clicked => { root.chosen("colour:none"); }
                    }
                }
                for c[i] in root.palette: Rectangle {
                    cross-axis-self-alignment: center;
                    width: 18px;
                    height: 18px;
                    border-radius: 9px;
                    background: c;
                    border-width: i == root.colour || zone.has-hover ? 2px : 0px;
                    border-color: Tokens.text;
                    accessible-role: button;
                    accessible-label: "Folder colour " + (i + 1);
                    accessible-action-default => { root.chosen("colour:" + i); }
                    zone := TouchArea {
                        clicked => { root.chosen("colour:" + i); }
                    }
                }
            }
            if root.kind == 0: MenuSeparator {}

            // Opening it. A phone has no tabs side by side, no note beside, no other
            // app to hand a file to: its menu is the mockups' N1 list.
            if (root.kind == 1 || root.kind == 2) && !Layout.compact: MenuEntry {
                icon: Icons.plus;
                label: "Open in a new tab";
                shortcut: "Ctrl+T";
                activated => { root.chosen("new-tab"); }
            }
            if root.kind == 1 && !Layout.compact: MenuEntry {
                icon: Icons.sidebar;
                label: "Open beside";
                shortcut: "Ctrl+\\";
                activated => { root.chosen("beside"); }
            }
            if root.kind == 4: MenuEntry {
                icon: Icons.table;
                label: "Open as a spreadsheet";
                activated => { root.chosen("import-sheet"); }
            }
            if root.kind != 0 && !Layout.compact: MenuEntry {
                icon: Icons.open-external;
                label: "Open with the default app";
                activated => { root.chosen("open-default"); }
            }
            if root.kind != 0 && (!Layout.compact || root.kind == 4): MenuSeparator {}

            // Arranging it.
            MenuEntry {
                icon: Icons.pencil;
                label: "Rename";
                shortcut: "F2";
                activated => { root.chosen("rename"); }
            }
            if root.kind != 0: MenuEntry {
                icon: Icons.layers;
                label: "Duplicate";
                activated => { root.chosen("duplicate"); }
            }
            MenuEntry {
                icon: Icons.move-to;
                label: "Move to…";
                activated => { root.chosen("move-to"); }
            }
            MenuEntry {
                icon: Icons.star;
                label: root.pinned ? "Unpin" : Layout.compact ? "Pin" : "Pin to the top";
                activated => { root.chosen("pin"); }
            }
            MenuSeparator {}

            // Taking it elsewhere. On a phone a note or a file copies its link at
            // once; a folder still offers its paths.
            copier := MenuEntry {
                property <bool> lien: Layout.compact && root.kind != 0;
                icon: self.lien ? Icons.link : Icons.copy;
                label: self.lien ? "Copy link" : "Copy path";
                chevron: !self.lien;
                open: root.sous;
                changed hovered => {
                    if (self.hovered && !self.lien) { root.ouvrir-sous(); }
                }
                activated => {
                    if (self.lien) {
                        root.chosen("copy-link");
                    } else {
                        root.ouvrir-sous();
                    }
                }
            }
            if root.kind == 1: MenuEntry {
                icon: Icons.history;
                label: Layout.compact ? "History" : "Version history…";
                activated => { root.chosen("history"); }
            }
            if root.kind == 1 && !Layout.compact: MenuEntry {
                icon: Icons.download;
                label: "Export as a web page…";
                activated => { root.chosen("export"); }
            }
            if root.kind == 1: MenuEntry {
                icon: Layout.compact ? Icons.open-external : Icons.notes;
                label: Layout.compact ? "Share" : "Print or save as PDF…";
                activated => { root.chosen("print"); }
            }
            if !Layout.compact: MenuEntry {
                icon: Icons.folder;
                label: "Show in Explorer";
                activated => { root.chosen("reveal"); }
            }
            MenuSeparator {}
            MenuEntry {
                icon: Icons.trash;
                label: Layout.compact ? "Delete" : "Move to the Recycle Bin";
                danger: true;
                activated => { root.chosen("delete"); }
            }
        }
    }

    // Copy path, beside its entry: as a link for a note, from the space, from the disk.
    property <bool> sous;
    property <length> sous-x;
    property <length> sous-y;
    function ouvrir-sous() {
        root.sous-x = copier.absolute-position.x - root.absolute-position.x + copier.width + 8px;
        root.sous-y = copier.absolute-position.y - root.absolute-position.y - 4px;
        root.sous = true;
    }
    if root.sous: MenuSurface {
        dismissed => { root.dismissed(); }
        available-width: root.width;
        available-height: root.height;
        menu-x: root.sous-x;
        menu-y: root.sous-y;
        menu-width: 230px;
        menu-height: sous-entrees.preferred-height + 8px;
        sous-entrees := VerticalLayout {
            padding: 4px;
            if root.kind != 0: MenuEntry {
                icon: Icons.link;
                label: "As a link for a note";
                activated => { root.chosen("copy-link"); }
            }
            MenuEntry {
                icon: Icons.notes;
                label: "From the space's folder";
                activated => { root.chosen("copy-rel"); }
            }
            MenuEntry {
                icon: Icons.folder;
                label: "From the root of the disk";
                activated => { root.chosen("copy-full"); }
            }
        }
    }
}

// The spaces, from the picker at the top of the side column.
export component NotesSpaceMenu inherits Rectangle {
    in property <length> menu-x;
    in property <length> menu-y;
    in property <[NoteSpaceData]> spaces;
    in property <int> current;
    callback chosen(int);
    callback new-space();
    callback open-folder();
    callback reveal();
    callback dismissed();

    TouchArea {
        width: 100%;
        height: 100%;
        clicked => { root.dismissed(); }
    }
    MenuSurface {
        dismissed => { root.dismissed(); }
        available-width: root.width;
        available-height: root.height;
        menu-x: root.menu-x;
        menu-y: root.menu-y;
        menu-width: 240px;
        menu-height: entries.preferred-height + 8px;
        entries := VerticalLayout {
            padding: 4px;
            MenuHeader { text: "Spaces"; }
            for s[i] in root.spaces: MenuEntry {
                icon: i == root.current ? Icons.check : "";
                label: s.name;
                activated => { root.chosen(i); }
            }
            MenuSeparator {}
            MenuEntry {
                icon: Icons.plus;
                label: "New space…";
                activated => { root.new-space(); }
            }
            // A phone has no folder of its own to pick or show.
            if Layout.folders: MenuEntry {
                icon: Icons.folder;
                label: "Open a folder as a space…";
                activated => { root.open-folder(); }
            }
            if Layout.folders: MenuEntry {
                icon: Icons.folder;
                label: "Show the space in Explorer";
                activated => { root.reveal(); }
            }
        }
    }
}

// A name asked for: a new space, a new folder.
export component NotesNamePanel inherits Rectangle {
    in property <string> title;
    in property <string> action;
    in-out property <string> name;
    in property <string> error;
    callback confirmed(string);
    callback dismissed();

    Modal {
        kind: ModalKind.question;
        width: 100%;
        height: 100%;
        title: root.title;
        card-height: 190px;
        card-width: 400px;
        dismissed => { root.dismissed(); }
        VerticalLayout {
            spacing: 10px;
            TextField {
                text <=> root.name;
                init => { self.focus(); }
                accepted(t) => { root.confirmed(t); }
            }
            if root.error != "": Text {
                text: root.error;
                font-size: Tokens.size-small;
                color: Tokens.error;
                wrap: word-wrap;
            }
            Rectangle {}
            HorizontalLayout {
                spacing: Tokens.space-2;
                Rectangle {}
                Button {
                    text: "Cancel";
                    clicked => { root.dismissed(); }
                }
                Button {
                    text: root.action;
                    kind: ButtonKind.primary;
                    clicked => { root.confirmed(root.name); }
                }
            }
        }
    }
}

// Revising a note's flashcards: the question, then its answer, then how it went.
export component NotesReviewPanel inherits Rectangle {
    in property <string> question;
    in property <string> answer;
    in property <bool> revealed;
    /// "3 of 12", or what was revised when it is over.
    in property <string> progress;
    in property <bool> finished;
    // A phone's page: what is revised (a folder, a note), the card shown of how many,
    // the note the card comes from, and how long each grade puts it away.
    in property <string> title;
    in property <int> position;
    in property <int> total;
    in property <string> source;
    in property <[string]> delays;
    callback reveal();
    callback graded(int);
    callback dismissed();

    // On a phone (the mockups' N7): a page of its own, one card at a time; a tap on
    // the card shows the answer, then the four grades are large buttons, each with
    // the time it gives.
    if Layout.compact: Rectangle {
        background: Tokens.background;
        FocusScope {
            enabled: false;
            key-pressed(event) => {
                if (event.text == Key.Escape || event.text == Key.Back) {
                    root.dismissed();
                    return accept;
                }
                return reject;
            }
            TouchArea {}
            VerticalLayout {
                padding-top: Layout.inset-top;
                padding-bottom: Layout.inset-bottom;
                HorizontalLayout {
                    height: 56px;
                    padding-left: 6px;
                    padding-right: 20px;
                    spacing: 2px;
                    BarButton {
                        y: (parent.height - self.height) / 2;
                        icon: Icons.window-close;
                        label: "Stop revising";
                        clicked => { root.dismissed(); }
                    }
                    Text {
                        text: root.title != "" ? "Revise · " + root.title : "Revise";
                        font-family: Tokens.font-display;
                        font-size: 18px;
                        font-weight: 600;
                        color: Tokens.text;
                        vertical-alignment: center;
                        overflow: elide;
                        horizontal-stretch: 1;
                    }
                    if root.total > 0: Text {
                        text: "" + root.position + " / " + root.total;
                        font-size: 14px;
                        color: Tokens.text-muted;
                        vertical-alignment: center;
                    }
                }
                // How far through.
                HorizontalLayout {
                    padding-left: 18px;
                    padding-right: 18px;
                    Rectangle {
                        height: 4px;
                        border-radius: 2px;
                        background: Tokens.surface-active;
                        Rectangle {
                            x: 0px;
                            width: parent.width * (root.total > 0 ? min(1, root.position / root.total) : 0);
                            border-radius: 2px;
                            background: Tokens.accent;
                        }
                    }
                }
                HorizontalLayout {
                    vertical-stretch: 1;
                    padding-left: 18px;
                    padding-right: 18px;
                    padding-top: 24px;
                    padding-bottom: 24px;
                    Rectangle {
                        border-radius: 18px;
                        background: Tokens.surface;
                        drop-shadow-blur: Tokens.shadow-card-blur;
                        drop-shadow-offset-y: Tokens.shadow-card-y;
                        drop-shadow-color: Tokens.shadow-card;
                        accessible-role: button;
                        accessible-label: root.revealed || root.finished ? "" : "Show the answer";
                        TouchArea {
                            clicked => {
                                if (!root.revealed && !root.finished) {
                                    root.reveal();
                                }
                            }
                        }
                        VerticalLayout {
                            padding-left: 22px;
                            padding-right: 22px;
                            padding-top: 24px;
                            padding-bottom: 24px;
                            spacing: 0px;
                            if root.finished: Text {
                                text: root.progress;
                                font-family: Tokens.font-display;
                                font-size: 20px;
                                font-weight: 600;
                                color: Tokens.text;
                                wrap: word-wrap;
                            }
                            if !root.finished: Text {
                                text: "Question";
                                font-size: 12.5px;
                                font-weight: 600;
                                color: Tokens.text-muted;
                            }
                            if !root.finished: Rectangle { height: 8px; }
                            if !root.finished: Text {
                                text: root.question;
                                font-family: Tokens.font-display;
                                font-size: 20px;
                                font-weight: 600;
                                color: Tokens.text;
                                wrap: word-wrap;
                            }
                            if !root.finished && root.revealed: Rectangle {
                                height: 41px;
                                Rectangle {
                                    y: 22px;
                                    height: 1px;
                                    background: Tokens.border;
                                }
                            }
                            if !root.finished && root.revealed: Text {
                                text: "Answer";
                                font-size: 12.5px;
                                font-weight: 600;
                                color: Tokens.text-muted;
                            }
                            if !root.finished && root.revealed: Rectangle { height: 8px; }
                            if !root.finished && root.revealed: Text {
                                text: root.answer;
                                font-size: 17px;
                                color: Tokens.text;
                                wrap: word-wrap;
                            }
                            Rectangle { vertical-stretch: 1; }
                            if !root.finished && !root.revealed: Text {
                                text: "Tap the card for the answer.";
                                font-size: 14px;
                                color: Tokens.text-muted;
                                horizontal-alignment: center;
                            }
                            if !root.finished && !root.revealed: Rectangle { height: 16px; }
                            if !root.finished && root.source != "": Text {
                                text: root.source;
                                font-size: 13px;
                                color: Tokens.text-muted;
                                overflow: elide;
                            }
                        }
                    }
                }
                if !root.finished && root.revealed: HorizontalLayout {
                    height: 62px + 16px;
                    padding-left: 16px;
                    padding-right: 16px;
                    padding-bottom: 16px;
                    spacing: 8px;
                    for g[i] in [
                        { label: "Again", tint: Tokens.red },
                        { label: "Hard", tint: Tokens.orange },
                        { label: "Good", tint: Tokens.green },
                        { label: "Easy", tint: Tokens.blue },
                    ]: GradeButton {
                        text: g.label;
                        tint: g.tint;
                        delay: i < root.delays.length ? root.delays[i] : "";
                        clicked => { root.graded(i); }
                    }
                }
                if !root.finished && !root.revealed: HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 16px;
                    padding-bottom: 16px;
                    BlockButton {
                        text: "Show the answer";
                        clicked => { root.reveal(); }
                    }
                }
                if root.finished: HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 16px;
                    padding-bottom: 16px;
                    BlockButton {
                        text: "Done";
                        clicked => { root.dismissed(); }
                    }
                }
            }
        }
    }

    if !Layout.compact: Modal {
        width: 100%;
        height: 100%;
        title: "Revise";
        card-width: 520px;
        card-height: 380px;
        dismissed => { root.dismissed(); }
        // Space shows the answer; 1 to 4 say how it went.
        touches := FocusScope {
            init => { self.focus(); }
            key-pressed(event) => {
                if (root.finished) {
                    if (event.text == Key.Return || event.text == " ") { root.dismissed(); return accept; }
                    return reject;
                }
                if (!root.revealed && (event.text == " " || event.text == Key.Return)) {
                    root.reveal();
                    return accept;
                }
                if (root.revealed && (event.text == "1" || event.text == "&")) { root.graded(0); return accept; }
                if (root.revealed && (event.text == "2" || event.text == "é")) { root.graded(1); return accept; }
                if (root.revealed && (event.text == "3" || event.text == "\"")) { root.graded(2); return accept; }
                if (root.revealed && (event.text == "4" || event.text == "'")) { root.graded(3); return accept; }
                reject
            }
            VerticalLayout {
                spacing: 14px;
                Text {
                    text: root.progress;
                    font-size: 12px;
                    color: Tokens.text-muted;
                }
                if !root.finished: Text {
                    text: root.question;
                    font-size: 19px;
                    font-weight: 600;
                    color: Tokens.text;
                    wrap: word-wrap;
                }
                if !root.finished && root.revealed: Rectangle {
                    height: 1px;
                    background: Tokens.border;
                }
                if !root.finished && root.revealed: Text {
                    text: root.answer;
                    font-size: 16px;
                    color: Tokens.text-secondary;
                    wrap: word-wrap;
                }
                Rectangle { vertical-stretch: 1; }
                if root.finished: HorizontalLayout {
                    alignment: end;
                    Button {
                        text: "Done";
                        kind: ButtonKind.primary;
                        clicked => { root.dismissed(); }
                    }
                }
                if !root.finished && !root.revealed: HorizontalLayout {
                    alignment: center;
                    Button {
                        text: "Show the answer  (Space)";
                        kind: ButtonKind.primary;
                        clicked => { root.reveal(); }
                    }
                }
                if !root.finished && root.revealed: HorizontalLayout {
                    spacing: 8px;
                    alignment: center;
                    for g[i] in ["Again", "Hard", "Good", "Easy"]: Button {
                        text: g + "  " + (i + 1);
                        kind: i == 2 ? ButtonKind.primary : ButtonKind.secondary;
                        clicked => { root.graded(i); }
                    }
                }
            }
        }
    }
}

// Quick open: a note by its name, typed loosely.
export component NotesQuickOpen inherits Rectangle {
    in-out property <string> query;
    in property <[NoteFoundData]> results;
    in property <int> highlighted;
    /// Searching the notes' words (tag:, path:, is:task) rather than their names.
    in property <bool> search;
    /// Picking the folder something moves into ("" when not moving).
    in property <string> moving;
    callback edited(string);
    callback moved(int);
    callback chosen(string);
    callback dismissed();

    Modal {
        width: 100%;
        height: 100%;
        title: root.moving != "" ? "Move “" + root.moving + "” to…"
            : root.search ? "Search the notes" : "Open a note";
        card-height: 420px;
        card-width: 520px;
        dismissed => { root.dismissed(); }
        VerticalLayout {
            spacing: 8px;
            FocusScope {
                height: champ.preferred-height;
                key-pressed(event) => {
                    if (event.text == Key.DownArrow) { root.moved(1); return accept; }
                    if (event.text == Key.UpArrow) { root.moved(-1); return accept; }
                    reject
                }
                champ := TextField {
                    width: 100%;
                    icon: Icons.search;
                    placeholder-text: root.moving != "" ? "Name of a folder"
                        : root.search ? "Words, tag:maths, path:Analyse, is:task" : "Name of a note";
                    text <=> root.query;
                    init => { self.focus(); }
                    edited(t) => { root.edited(t); }
                    accepted => {
                        if (root.highlighted >= 0 && root.highlighted < root.results.length) {
                            root.chosen(root.results[root.highlighted].key);
                        } else if (root.query != "" && !root.search && root.moving == "") {
                            root.chosen("new:" + root.query);
                        }
                    }
                }
            }
            for f[i] in root.results: Rectangle {
                height: 40px;
                border-radius: Tokens.radius-small;
                background: i == root.highlighted ? Tokens.accent : ligne.has-hover ? Tokens.surface-hover : transparent;
                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    spacing: 10px;
                    Icon {
                        y: (parent.height - self.height) / 2;
                        data: root.moving != "" ? Icons.folder : Icons.notes;
                        size: 15px;
                        tint: i == root.highlighted ? Tokens.accent-text : Tokens.text-muted;
                    }
                    VerticalLayout {
                        alignment: center;
                        Text {
                            text: f.title;
                            font-size: 13.5px;
                            color: i == root.highlighted ? Tokens.accent-text : Tokens.text;
                            overflow: elide;
                        }
                        if f.detail != "": Text {
                            text: f.detail;
                            font-size: 11.5px;
                            color: i == root.highlighted ? Tokens.accent-text : Tokens.text-muted;
                            overflow: elide;
                        }
                    }
                }
                ligne := TouchArea {
                    clicked => { root.chosen(f.key); }
                }
            }
            if root.results.length == 0 && root.query != "": Text {
                text: root.moving != "" ? "No folder by that name."
                    : root.search ? "Nothing found." : "No note by that name. Enter makes it.";
                font-size: 12.5px;
                color: Tokens.text-muted;
            }
            Rectangle {}
        }
    }
}

// The past versions of a note: one per session of editing, the last thirty. One
// picked shows its text; Restore puts it back (the version replaced is kept too).
export component NotesHistoryPanel inherits Rectangle {
    in property <[NoteFoundData]> versions;
    in property <int> chosen: -1;
    in property <string> preview;
    callback picked(int);
    callback restore();
    callback dismissed();

    Modal {
        width: 100%;
        height: 100%;
        title: "History of the note";
        card-width: min(root.width - 80px, 820px);
        card-height: min(root.height - 80px, 560px);
        dismissed => { root.dismissed(); }
        HorizontalLayout {
            spacing: 14px;
            liste := ScrollView {
                width: 230px;
                horizontal-stretch: 0;
                mouse-drag-pan-enabled: false;
                content-width: self.visible-width;
                VerticalLayout {
                    width: liste.visible-width;
                    alignment: start;
                    if root.versions.length == 0: Text {
                        text: "No earlier version yet: one is kept each time the note is edited again.";
                        wrap: word-wrap;
                        font-size: 12.5px;
                        color: Tokens.text-muted;
                    }
                    for v[i] in root.versions: Rectangle {
                        height: 46px;
                        border-radius: Tokens.radius-small;
                        background: i == root.chosen ? Tokens.surface-hover : zone.has-hover ? Tokens.surface-hover.transparentize(0.5) : transparent;
                        VerticalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            alignment: center;
                            Text {
                                text: v.title;
                                font-size: 13px;
                                font-weight: i == root.chosen ? 600 : 400;
                                color: Tokens.text;
                            }
                            Text {
                                text: v.detail;
                                font-size: 11.5px;
                                color: Tokens.text-muted;
                            }
                        }
                        zone := TouchArea {
                            clicked => { root.picked(i); }
                        }
                    }
                }
            }
            Rectangle {
                width: 1px;
                background: Tokens.border;
            }
            VerticalLayout {
                spacing: 10px;
                apercu := ScrollView {
                    vertical-stretch: 1;
                    mouse-drag-pan-enabled: false;
                    content-width: self.visible-width;
                    VerticalLayout {
                        width: apercu.visible-width;
                        alignment: start;
                        Text {
                            text: root.chosen < 0 ? "Pick a version on the left." : root.preview;
                            wrap: word-wrap;
                            font-family: Tokens.font-mono;
                            font-size: 12.5px;
                            color: root.chosen < 0 ? Tokens.text-muted : Tokens.text-secondary;
                        }
                    }
                }
                HorizontalLayout {
                    alignment: end;
                    Button {
                        text: "Restore this version";
                        kind: ButtonKind.primary;
                        enabled: root.chosen >= 0;
                        clicked => { root.restore(); }
                    }
                }
            }
        }
    }
}

// The notes of the space and their links, placed by their links: a click opens one.
export component NotesGraphPanel inherits Rectangle {
    in property <[NoteGraphNodeData]> nodes;
    /// Every link, as path commands in a 1000 × 1000 square.
    in property <string> edges;
    callback chosen(string);
    /// A phone's search in the bar: Quick open, in place of the graph.
    callback search();
    callback dismissed();

    // On a phone (the mockups' N6): a page, Graph at its top; a tap on a node lights
    // it and lays its card at the foot, whose Open opens the note.
    property <int> touche: -1;

    if Layout.compact: Rectangle {
        background: Tokens.background;
        FocusScope {
            enabled: false;
            key-pressed(event) => {
                if (event.text == Key.Escape || event.text == Key.Back) {
                    root.dismissed();
                    return accept;
                }
                return reject;
            }
            // Taps on the empty page put the card away.
            TouchArea {
                clicked => { root.touche = -1; }
            }
            VerticalLayout {
                padding-top: Layout.inset-top;
                padding-bottom: Layout.inset-bottom;
                HorizontalLayout {
                    height: 56px;
                    padding-left: 6px;
                    padding-right: 6px;
                    spacing: 2px;
                    BarButton {
                        y: (parent.height - self.height) / 2;
                        icon: Icons.arrow-left;
                        label: "Close the graph";
                        clicked => { root.dismissed(); }
                    }
                    Text {
                        text: "Graph";
                        font-family: Tokens.font-display;
                        font-size: 18px;
                        font-weight: 600;
                        color: Tokens.text;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                    BarButton {
                        y: (parent.height - self.height) / 2;
                        icon: Icons.search;
                        label: "Open a note";
                        clicked => { root.search(); }
                    }
                }
                cadre-tel := Rectangle {
                    vertical-stretch: 1;
                    clip: true;
                    carre-tel := Rectangle {
                        width: min(cadre-tel.width, cadre-tel.height) - 24px;
                        height: self.width;
                        x: (cadre-tel.width - self.width) / 2;
                        y: (cadre-tel.height - self.height) / 2;
                        Path {
                            width: 100%;
                            height: 100%;
                            viewbox-x: 0;
                            viewbox-y: 0;
                            viewbox-width: 1000;
                            viewbox-height: 1000;
                            commands: root.edges;
                            stroke: Tokens.border-strong;
                            stroke-width: 1.4px;
                        }
                        for n[i] in root.nodes: Rectangle {
                            property <bool> eclaire: i == root.touche || (root.touche < 0 && n.current);
                            property <length> d: (12 + n.size * 16) * 1px;
                            x: n.x * carre-tel.width - self.width / 2;
                            y: n.y * carre-tel.height - self.d / 2;
                            width: max(self.d, nom-noeud.preferred-width + 8px);
                            height: self.d + 22px;
                            Rectangle {
                                x: (parent.width - parent.d) / 2;
                                y: 0px;
                                width: parent.d;
                                height: parent.d;
                                border-radius: parent.d / 2;
                                background: parent.eclaire ? Tokens.accent : Tokens.grey;
                            }
                            nom-noeud := Text {
                                y: parent.d + 4px;
                                width: parent.width;
                                text: n.label;
                                font-size: 13px;
                                font-weight: parent.eclaire ? 600 : 400;
                                color: parent.eclaire ? Tokens.text : Tokens.text-secondary;
                                horizontal-alignment: center;
                            }
                            accessible-role: button;
                            accessible-label: n.label;
                            accessible-action-default => { root.touche = i; }
                            TouchArea {
                                clicked => { root.touche = i; }
                            }
                        }
                    }
                }
            }
            // The node tapped: its note, its links, and Open.
            if root.touche >= 0 && root.touche < root.nodes.length: Rectangle {
                x: 16px;
                width: parent.width - 32px;
                y: parent.height - self.height - 16px - Layout.inset-bottom;
                height: carte-noeud.preferred-height;
                border-radius: 18px;
                background: Tokens.surface;
                drop-shadow-blur: Tokens.shadow-card-blur;
                drop-shadow-offset-y: Tokens.shadow-card-y;
                drop-shadow-color: Tokens.shadow-card;
                TouchArea {}
                carte-noeud := HorizontalLayout {
                    padding: 16px;
                    spacing: 12px;
                    Icon {
                        cross-axis-self-alignment: center;
                        data: Icons.notes;
                        size: 22px;
                        tint: Tokens.accent;
                    }
                    VerticalLayout {
                        alignment: center;
                        horizontal-stretch: 1;
                        Text {
                            text: root.nodes[root.touche].label;
                            font-size: 15.5px;
                            font-weight: 600;
                            color: Tokens.text;
                            overflow: elide;
                        }
                        Text {
                            text: root.nodes[root.touche].detail;
                            font-size: 13px;
                            color: Tokens.text-muted;
                            overflow: elide;
                        }
                    }
                    Button {
                        cross-axis-self-alignment: center;
                        text: "Open";
                        kind: ButtonKind.primary;
                        size: ButtonSize.sm;
                        clicked => { root.chosen(root.nodes[root.touche].key); }
                    }
                }
            }
        }
    }

    if !Layout.compact: Modal {
        width: 100%;
        height: 100%;
        title: "Links between the notes";
        card-width: min(root.width - 60px, 1000px);
        card-height: min(root.height - 60px, 760px);
        dismissed => { root.dismissed(); }
        cadre := Rectangle {
            carre := Rectangle {
                width: min(cadre.width, cadre.height);
                height: self.width;
                x: (cadre.width - self.width) / 2;
                y: (cadre.height - self.height) / 2;
                Path {
                    width: 100%;
                    height: 100%;
                    viewbox-x: 0;
                    viewbox-y: 0;
                    viewbox-width: 1000;
                    viewbox-height: 1000;
                    commands: root.edges;
                    stroke: Tokens.border-strong;
                    stroke-width: 1px;
                }
                for n in root.nodes: Rectangle {
                    property <length> d: (5 + n.size * 9) * 1px;
                    x: n.x * carre.width - self.width / 2;
                    y: n.y * carre.height - self.d / 2;
                    width: max(self.d, etiquette.preferred-width + 6px);
                    height: self.d + 16px;
                    Rectangle {
                        x: (parent.width - parent.d) / 2;
                        y: 0px;
                        width: parent.d;
                        height: parent.d;
                        border-radius: parent.d / 2;
                        background: n.current ? Tokens.accent : zone.has-hover ? Tokens.accent.transparentize(0.3) : Tokens.text-muted;
                    }
                    etiquette := Text {
                        y: parent.d + 2px;
                        width: parent.width;
                        text: n.label;
                        font-size: 10.5px;
                        color: n.current || zone.has-hover ? Tokens.text : Tokens.text-muted;
                        horizontal-alignment: center;
                    }
                    zone := TouchArea {
                        mouse-cursor: MouseCursor.pointer;
                        clicked => { root.chosen(n.key); }
                    }
                }
            }
        }
    }
}

// The menu of the tree's empty room: what can be made at the top of the space.
export component NotesAreaMenu inherits Rectangle {
    in property <length> menu-x;
    in property <length> menu-y;
    callback chosen(string);
    callback dismissed();

    TouchArea {
        width: 100%;
        height: 100%;
        clicked => { root.dismissed(); }
        pointer-event(event) => {
            if (event.button == PointerEventButton.right && event.kind == PointerEventKind.down) {
                root.dismissed();
            }
        }
    }
    MenuSurface {
        dismissed => { root.dismissed(); }
        available-width: root.width;
        available-height: root.height;
        menu-x: root.menu-x;
        menu-y: root.menu-y;
        menu-width: 240px;
        menu-height: entries.preferred-height + 8px;
        entries := VerticalLayout {
            padding: 4px;
            MenuEntry {
                icon: Icons.plus;
                label: "New note";
                shortcut: "Ctrl+N";
                activated => { root.chosen("new-note"); }
            }
            MenuEntry {
                icon: Icons.table;
                label: "New spreadsheet";
                activated => { root.chosen("new-sheet"); }
            }
            MenuEntry {
                icon: Icons.folder;
                label: "New folder";
                activated => { root.chosen("new-folder"); }
            }
            if Layout.folders: MenuSeparator { }
            if Layout.folders: MenuEntry {
                icon: Icons.open-external;
                label: "Open the space's folder";
                activated => { root.chosen("reveal-space"); }
            }
        }
    }
}

// A phone's sheets over a note, rising from the bottom (the mockups' N8, and N3's two
// buttons): the notes open, which are the PC's tabs, with New and what else the note
// can do; that same rest alone, from ⋯; the note's outline and what mentions it, the
// PC's side column.
export component NotesPhoneSheet inherits Rectangle {
    /// "open", "more" or "outline".
    in property <string> kind;
    in property <[NoteFoundData]> tabs;
    in property <int> tab-active;
    in property <bool> has-cards;
    in property <bool> source-mode;
    in property <[NoteFoundData]> outline;
    in property <[NoteFoundData]> backlinks;
    in property <string> facts;
    /// "new", "history", "source", "print", "revise".
    callback chosen(string);
    callback tab-chosen(int);
    callback tab-closed(int);
    callback outline-chosen(string);
    callback backlink-chosen(string);
    callback dismissed();

    TouchArea {
        width: 100%;
        height: 100%;
        clicked => { root.dismissed(); }
    }
    MenuSurface {
        dismissed => { root.dismissed(); }
        available-width: root.width;
        available-height: root.height;
        menu-x: 0px;
        menu-y: 0px;
        menu-width: root.width;
        menu-height: min(contenu.preferred-height, root.height - 96px);
        contenu := VerticalLayout {
            padding-bottom: 4px;

            // The notes open: a tap shows one, × closes it, New opens a new one.
            if root.kind == "open": HorizontalLayout {
                height: 52px;
                padding-left: 20px;
                padding-right: 12px;
                padding-bottom: 8px;
                spacing: 8px;
                Text {
                    text: "Open notes";
                    font-family: Tokens.font-display;
                    font-size: 19px;
                    font-weight: 600;
                    color: Tokens.text;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                Button {
                    y: (parent.height - self.height) / 2;
                    text: "New";
                    icon: Icons.plus;
                    label: "New note";
                    kind: ButtonKind.ghost;
                    size: ButtonSize.sm;
                    clicked => { root.chosen("new"); }
                }
            }
            if root.kind == "open": VerticalLayout {
                for t[i] in root.tabs: HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 8px;
                    Rectangle {
                        height: 56px;
                        border-radius: 12px;
                        background: i == root.tab-active ? Tokens.surface-active
                            : ligne.pressed ? Tokens.surface-hover : transparent;
                        accessible-role: tab;
                        accessible-label: t.title;
                        accessible-item-selected: i == root.tab-active;
                        accessible-action-default => { root.tab-chosen(i); }
                        ligne := TouchArea {
                            clicked => { root.tab-chosen(i); }
                        }
                        HorizontalLayout {
                            padding-left: 16px;
                            padding-right: 4px;
                            spacing: 14px;
                            Icon {
                                y: (parent.height - self.height) / 2;
                                data: Icons.notes;
                                size: 18px;
                                tint: Tokens.text-muted;
                            }
                            VerticalLayout {
                                alignment: center;
                                horizontal-stretch: 1;
                                Text {
                                    text: t.title;
                                    font-size: 15.5px;
                                    font-weight: i == root.tab-active ? 600 : 400;
                                    color: Tokens.text;
                                    overflow: elide;
                                }
                                if t.detail != "": Text {
                                    text: t.detail;
                                    font-size: 13px;
                                    color: Tokens.text-muted;
                                    overflow: elide;
                                }
                            }
                            IconButton {
                                y: (parent.height - self.height) / 2;
                                icon: Icons.window-close;
                                label: "Close " + t.title;
                                button-size: 44px;
                                icon-size: 14px;
                                clicked => { root.tab-closed(i); }
                            }
                        }
                    }
                }
            }
            if root.kind == "open": MenuSeparator { }

            // What else the note can do.
            if root.kind == "open" || root.kind == "more": VerticalLayout {
                padding-left: 4px;
                padding-right: 4px;
                MenuEntry {
                    icon: Icons.history;
                    label: "Version history…";
                    activated => { root.chosen("history"); }
                }
                MenuEntry {
                    icon: Icons.code;
                    label: root.source-mode ? "Back to the blocks" : "Edit as plain text";
                    activated => { root.chosen("source"); }
                }
                MenuEntry {
                    icon: Icons.open-external;
                    label: "Share or export as PDF…";
                    activated => { root.chosen("print"); }
                }
                if root.kind == "more" && root.has-cards: MenuEntry {
                    icon: Icons.cards;
                    label: "Revise the flashcards";
                    activated => { root.chosen("revise"); }
                }
            }

            // The outline, then what mentions the note; its length and tags above.
            if root.kind == "outline": VerticalLayout {
                MenuHeader { text: "Outline"; }
                if root.facts != "": HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 16px;
                    padding-bottom: 6px;
                    Text {
                        text: root.facts;
                        font-size: 13px;
                        color: Tokens.text-muted;
                        wrap: word-wrap;
                    }
                }
                plan-tel := ScrollView {
                    height: min(plan-liste.preferred-height, root.height * 0.6);
                    mouse-drag-pan-enabled: false;
                    content-width: self.visible-width;
                    plan-liste := VerticalLayout {
                        width: plan-tel.visible-width;
                        alignment: start;
                        padding-left: 4px;
                        padding-right: 4px;
                        if root.outline.length == 0: HorizontalLayout {
                            height: 40px;
                            padding-left: 12px;
                            Text {
                                text: "No headings.";
                                font-size: 14px;
                                color: Tokens.text-muted;
                                vertical-alignment: center;
                            }
                        }
                        for h in root.outline: Rectangle {
                            height: 48px;
                            border-radius: 12px;
                            background: titre-zone.pressed ? Tokens.surface-active : transparent;
                            accessible-role: button;
                            accessible-label: h.title;
                            accessible-action-default => { root.outline-chosen(h.key); }
                            Text {
                                x: 14px + (h.detail.to-float() - 1) * 16px;
                                width: parent.width - self.x - 14px;
                                text: h.title;
                                font-size: 15.5px;
                                font-weight: h.detail == "1" ? 600 : 400;
                                color: Tokens.text;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                            titre-zone := TouchArea {
                                clicked => { root.outline-chosen(h.key); }
                            }
                        }
                        MenuSeparator { }
                        MenuHeader { text: "Mentioned in"; }
                        if root.backlinks.length == 0: HorizontalLayout {
                            height: 40px;
                            padding-left: 12px;
                            Text {
                                text: "No note links here yet.";
                                font-size: 14px;
                                color: Tokens.text-muted;
                                vertical-alignment: center;
                            }
                        }
                        for l in root.backlinks: Rectangle {
                            height: 56px;
                            border-radius: 12px;
                            background: retour-zone.pressed ? Tokens.surface-active : transparent;
                            accessible-role: button;
                            accessible-label: l.title;
                            accessible-action-default => { root.backlink-chosen(l.key); }
                            VerticalLayout {
                                padding-left: 14px;
                                padding-right: 14px;
                                alignment: center;
                                Text {
                                    text: l.title;
                                    font-size: 15.5px;
                                    font-weight: 600;
                                    color: Tokens.accent;
                                    overflow: elide;
                                }
                                Text {
                                    text: l.detail;
                                    font-size: 13px;
                                    color: Tokens.text-muted;
                                    overflow: elide;
                                }
                            }
                            retour-zone := TouchArea {
                                clicked => { root.backlink-chosen(l.key); }
                            }
                        }
                    }
                }
            }
        }
    }
}
