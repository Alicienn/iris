import { Tokens } from "@iris/theme/tokens.slint";
import { ChangelogRowData } from "@iris/types.slint";
import { Tag } from "@iris/controls/choice.slint";
import { Button, ButtonKind } from "@iris/controls/button.slint";
import { Hairline } from "@iris/base/atoms.slint";
import { Modal, ModalFooter } from "@iris/layout/frames.slint";
import { ScrollView } from "std-widgets.slint";

// What changed, version by version.
//
// One flat list rather than nested ones: versions, categories and changes are rows of
// three kinds, which is what a scrolling list draws best and what Rust builds in one
// pass.
component ChangelogList inherits ScrollView {
    in property <[ChangelogRowData]> rows;

    viewport-width: self.visible-width;
    viewport-height: lignes.preferred-height;

    // As wide as what shows, so a long change wraps: left to its own width, the
    // column took the length of the longest line and cut it off at the edge.
    lignes := VerticalLayout {
        width: root.visible-width;
        padding-right: 8px;
        spacing: 2px;

        for row[i] in root.rows: VerticalLayout {
            // A version: the number, its date, and a mark for the one installed.
            if row.kind == 0: VerticalLayout {
                padding-top: i == 0 ? 0px : 18px;
                HorizontalLayout {
                    spacing: 8px;
                    height: 24px;
                    Text {
                        text: row.text;
                        font-family: Tokens.font-display;
                        font-size: 16px;
                        font-weight: 600;
                        color: Tokens.text;
                        vertical-alignment: center;
                    }
                    Text {
                        text: row.detail;
                        font-size: 12px;
                        color: Tokens.text-muted;
                        vertical-alignment: center;
                    }
                    if row.tag != "": Tag {
                        y: (parent.height - self.height) / 2;
                        text: row.tag;
                    }
                    Rectangle {}
                }
            }

            // A category.
            if row.kind == 1: Text {
                text: row.text;
                font-size: 12px;
                font-weight: 600;
                color: Tokens.text-muted;
                height: 26px;
                vertical-alignment: bottom;
            }

            // One change.
            if row.kind == 2: HorizontalLayout {
                spacing: 8px;
                padding-left: 4px;
                Text {
                    text: "•";
                    font-size: 13px;
                    color: Tokens.text-muted;
                    width: 8px;
                    vertical-alignment: top;
                }
                Text {
                    text: row.text;
                    font-size: 13px;
                    color: Tokens.text-secondary;
                    wrap: word-wrap;
                    horizontal-stretch: 1;
                }
            }
        }
    }
}

// Every version and what it changed.
export component ChangelogPanel inherits Rectangle {
    in property <[ChangelogRowData]> rows;
    in property <string> version;

    callback dismissed();

    Modal {
        width: 100%;
        height: 100%;
        title: "Changelog";
        card-width: 560px;
        card-height: 620px;
        dismissed => { root.dismissed(); }

        Text {
            text: "You have " + root.version + ".";
            font-size: 12px;
            color: Tokens.text-muted;
        }
        Hairline {}
        ChangelogList {
            vertical-stretch: 1;
            rows: root.rows;
        }
    }
}

// Installing a newer version, after asking.
//
// The question comes with the answer to "what would I get": the changes since the
// installed version. An update offered without them is a button nobody has a reason
// to press — or a reason not to.
export component UpdatePanel inherits Rectangle {
    in property <string> current;
    in property <string> available;
    in property <[ChangelogRowData]> notes;
    /// Downloading or starting the installer: the choice has been made.
    in property <bool> busy;
    /// 0 to 1 while downloading.
    in property <float> progress;
    in property <string> status;
    in property <string> error;

    callback confirmed();
    callback dismissed();

    Modal {
        width: 100%;
        height: 100%;
        title: "Update Iris";
        card-width: 500px;
        card-height: 520px;
        // Not while installing: the choice is made, and this is the only thing saying
        // what is happening.
        dismissed => {
            if (!root.busy) {
                root.dismissed();
            }
        }

        Text {
            text: root.current + "  →  " + root.available + ". Iris will close, install it and "
                + "open again. Your mail and settings are kept.";
            font-size: 13px;
            color: Tokens.text-secondary;
            wrap: word-wrap;
        }

        Hairline {}

        ChangelogList {
            vertical-stretch: 1;
            rows: root.notes;
        }

        if root.busy: VerticalLayout {
            spacing: 4px;
            vertical-stretch: 0;
            Rectangle {
                height: 4px;
                border-radius: 2px;
                background: Tokens.surface-low;
                clip: true;
                Rectangle {
                    x: 0;
                    width: parent.width * clamp(root.progress, 0, 1);
                    height: 100%;
                    border-radius: 2px;
                    background: Tokens.accent;
                    animate width { duration: Tokens.quick; }
                }
            }
            Text {
                text: root.status;
                font-size: 12px;
                color: Tokens.text-muted;
            }
        }

        if root.error != "": Text {
            text: root.error;
            font-size: 12px;
            color: Tokens.error;
            wrap: word-wrap;
        }

        ModalFooter {
            Button {
                text: "Later";
                enabled: !root.busy;
                clicked => { root.dismissed(); }
            }
            Button {
                text: root.error != "" ? "Try again" : "Update now";
                kind: ButtonKind.primary;
                enabled: !root.busy;
                clicked => { root.confirmed(); }
            }
        }
    }
}
