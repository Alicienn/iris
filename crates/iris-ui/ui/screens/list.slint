import { Tokens } from "@iris/theme/tokens.slint";
import { TextField } from "@iris/controls/field.slint";
import { ThreadRowData } from "@iris/types.slint";
import { ListView } from "std-widgets.slint";
import { Icon, Icons, IconButton } from "@iris/base/icons.slint";
import { MenuEntry, MenuSeparator, MenuSurface } from "@iris/layout/menu.slint";
import { QueueTabs, Pill } from "@iris/controls/choice.slint";

// Une ligne de la liste.
//
// Elle ne calcule rien : tous ses champs arrivent prêts à dessiner. Une ligne qui
// formaterait sa date ferait ce travail soixante fois par seconde pendant un
// défilement, pour un texte qui ne change pas.
component ThreadRow inherits Rectangle {
    in property <ThreadRowData> data;
    in property <bool> selected;
    /// Un lot est en cours. Toutes les cases apparaissent, pas seulement celle de la
    /// ligne survolée : une fois qu'on en a coché une, la question posée par la liste
    /// n'est plus « lequel lire » mais « lesquels d'autres ».
    in property <bool> selection-mode;

    callback clicked();
    callback mark-toggled();
    callback mark-extended();
    callback drag-started();

    // Vrai entre un appui modifié et le relâchement qui le suit.
    property <bool> modified-click;

    /// La bande de gauche où un clic coche au lieu d'ouvrir.
    ///
    /// La case n'a plus de zone tactile à elle : c'est celle de la ligne qui lit
    /// l'abscisse du clic. Une seule zone par ligne, donc plus rien à se disputer — ni
    /// le survol, ni l'ordre de déclaration, ni le clic lui-même. La bande couvre la
    /// case et sa gouttière, parce que viser quinze pixels demande de la précision et
    /// que rater vers la droite ouvrirait le message.
    property <length> checkbox-zone: root.inset + Tokens.row-padding-x + root.lead + 6px;
    callback context-menu(length, length);

    height: Tokens.row-height;
    /// Short rows (compact density): no initials, the tick box alone leads.
    property <bool> compact: root.height < 44px;
    /// Tall rows (comfortable): the excerpt gets a line of its own.
    property <bool> airy: root.height >= 60px;
    property <length> lead: root.compact ? 15px : 28px;
    /// The row is a card inside the list, clear of its edges.
    property <length> inset: 8px;
    // Whatever happens inside, nothing is drawn over the next row.
    clip: true;

    fond := Rectangle {
        x: root.inset;
        y: 1px;
        width: parent.width - 2 * root.inset;
        height: parent.height - 2px;
        border-radius: Tokens.radius-medium;
        background: root.selected
            ? Tokens.surface-active
            : (row-touch.has-hover ? Tokens.surface-hover : transparent);
        animate background { duration: Tokens.instant; }
    }

    // Ce qu'un lecteur d'écran annonce. L'ordre suit celui de la lecture visuelle —
    // qui écrit, à quel sujet, quand — parce que c'est l'ordre dans lequel on décide
    // si un message mérite qu'on s'y arrête.
    accessible-role: list-item;
    accessible-label: root.data.from + ", " + root.data.subject + ", " + root.data.date;
    accessible-description: root.data.unread ? "Unread" : "Read";
    accessible-item-selected: root.selected;
    accessible-item-selectable: true;
    accessible-action-default => { root.clicked(); }

    // Unread: a dot in the margin, outside the card, where the eye runs down the list.
    if root.data.unread: Rectangle {
        x: 2px;
        y: (parent.height - self.height) / 2;
        width: 5px;
        height: 5px;
        border-radius: 2.5px;
        background: Tokens.text;
    }

    // Le glisser vers un dossier.
    //
    // La charge n'est pas transportée par le glisser : elle est **déjà connue**. Ce
    // qu'on déplace est le lot coché, ou à défaut la ligne empoignée, et c'est la même
    // règle que pour toutes les autres actions. Faire voyager un identifiant dans un
    // objet de transfert opaque, puis le relire à l'arrivée, ajouterait un second
    // chemin par lequel une action peut se tromper de cible.
    //
    // « move » seulement : glisser un message dans un dossier le range, ne le duplique
    // pas. Deux copies du même message dans deux dossiers, c'est ce qu'un client de
    // courrier doit éviter de produire par accident.
    in property <data-transfer> payload;

    // La zone de glissement **contient** le reste de la ligne.
    //
    // Elle était déclarée en frère, et vide. Slint met le dernier frère au-dessus et lui
    // donne l'événement en premier : la zone tactile de la ligne, déclarée après,
    // recouvrait entièrement la zone de glissement, qui ne voyait jamais un appui. Le
    // geste n'échouait pas — il n'existait pas, et rien ne se soulevait sous le curseur.
    //
    // Une `DragArea` est faite pour envelopper : elle laisse passer les clics vers ses
    // enfants et ne retient le pointeur qu'au-delà du seuil de glissement. C'est ce qui
    // permet à une même ligne d'être cliquable et déplaçable sans que les deux gestes se
    // disputent quoi que ce soit.
    drag := DragArea {
        allow-move: true;
        data: root.payload;
        changed dragging => {
            if (self.dragging) {
                root.drag-started();
            }
        }

    // Déclarée **avant** la mise en page, donc sous elle.
    //
    // Dans Slint, le dernier frère est au-dessus et reçoit l'événement le
    // premier. Cette zone était déclarée en dernier : elle recouvrait la case à
    // cocher, et cliquer la case ouvrait le message au lieu de le sélectionner.
    // Le geste existait, il n'atteignait jamais sa cible.
    row-touch := TouchArea {
        // Right-click is how everyone expects to reach the actions on a list row,
        // and it was reaching nothing.
        //
        // Ctrl and Shift are read here rather than in Rust: which row was clicked and
        // which keys were down are one event, and splitting them across the boundary
        // would mean guessing afterwards which click a modifier belonged to.
        pointer-event(event) => {
            if (event.button == PointerEventButton.right
                && event.kind == PointerEventKind.down) {
                // Plus de `root.clicked()` ici.
                //
                // Un clic droit ouvrait le message : il chargeait le corps dans la
                // colonne de lecture et le marquait lu, pour quelqu'un qui voulait
                // seulement voir la liste des actions — et qui la voulait peut-être
                // pour le jeter. Le menu emporte donc sa propre cible, et n'a plus
                // besoin que la sélection la désigne à sa place.
                // La position **absolue**, dans la fenêtre.
                //
                // C'était « mouse + root.y », où `root.y` est la position de la ligne
                // dans le viewport de la liste — pas à l'écran. Elle croît sans borne
                // à mesure qu'on défile, donc le menu s'ouvrait de plus en plus loin
                // vers le bas, ce qui de l'extérieur ressemble à du hasard. Et
                // l'appelant compensait en rajoutant des largeurs de colonnes écrites
                // en dur, qui cessaient d'être vraies dès qu'une colonne changeait.
                root.context-menu(
                    self.absolute-position.x + self.mouse-x,
                    self.absolute-position.y + self.mouse-y);
            } else if (event.button == PointerEventButton.left
                && event.kind == PointerEventKind.down) {
                if (event.modifiers.shift) {
                    root.modified-click = true;
                    root.mark-extended();
                } else if (event.modifiers.control) {
                    root.modified-click = true;
                    root.mark-toggled();
                }
            }
        }
        clicked => {
            // Un clic simple ouvre. Un clic modifié a déjà été traité à l'appui :
            // ouvrir en plus ferait deux choses pour un seul geste, et la seconde
            // serait celle que l'utilisateur n'a pas demandée.
            if (root.modified-click) {
                root.modified-click = false;
            } else if (self.mouse-x < root.checkbox-zone) {
                root.mark-toggled();
            } else {
                root.clicked();
            }
        }
    }

    HorizontalLayout {
        padding-left: root.inset + Tokens.row-padding-x - 2px;
        padding-right: root.inset + Tokens.row-padding-x - 2px;
        spacing: 10px;

        // What leads the row: the sender's face, and in its place the tick box when
        // the pointer is over the row or a batch is being made. One column, always
        // there: nothing moves when the box appears (a box that entered the layout
        // pushed the whole row sideways at every hover).
        Rectangle {
            width: root.lead;

            // The sender's mark: initials on a circle of their own colour. A list is
            // read by faces before names, and the same sender keeps the same mark.
            if !root.compact && root.data.initials != "": Rectangle {
                width: 28px;
                height: 28px;
                border-radius: 14px;
                background: root.data.sender-tint.transparentize(0.84);
                opacity: root.data.marked || root.selection-mode || row-touch.has-hover ? 0 : 1;

                Text {
                    text: root.data.initials;
                    font-size: 10px;
                    font-weight: 600;
                    color: root.data.sender-tint;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            Rectangle {
                width: 16px;
                height: 16px;
                border-radius: 4px;
                border-width: 1.5px;
                border-color: root.data.marked ? Tokens.accent : Tokens.border-strong;
                background: root.data.marked ? Tokens.accent : transparent;
                opacity: root.data.marked || root.selection-mode || row-touch.has-hover
                    ? 1.0
                    : 0.0;
                animate opacity { duration: Tokens.instant; }

                accessible-role: checkbox;
                accessible-label: "Select this conversation";
                accessible-checked: root.data.marked;
                accessible-action-default => { root.mark-toggled(); }

                if root.data.marked: Icon {
                    data: Icons.check;
                    size: 11px;
                    weight: 3.0;
                    tint: Tokens.accent-text;
                }
            }
        }

        VerticalLayout {
            // Compact rows hold two lines, not three: the subject and the excerpt
            // share the second. Three lines of text need about fifty pixels, and at
            // forty-five the excerpt was drawn over the next message.
            //
            // Centred rather than padded: fixed padding plus the lines came to more
            // than the row, and what did not fit was the bottom of the excerpt, its
            // j, g and ç. The margin is whatever the row has left over.
            spacing: 1px;
            alignment: center;
            horizontal-stretch: 1;
            min-width: 0;

            // First line: the mailbox's dot, the sender, how many messages, the date.
            HorizontalLayout {
                spacing: 6px;

                // The mailbox, as the dot it has in the accounts column: in the
                // unified view a hundred mailboxes would otherwise look alike.
                Rectangle {
                    y: (parent.height - self.height) / 2;
                    width: 7px;
                    height: 7px;
                    border-radius: 3.5px;
                    background: root.data.account-tint;
                }

                Text {
                    text: root.data.from;
                    font-size: 13px;
                    font-weight: root.data.unread ? 600 : 400;
                    color: root.data.unread ? Tokens.text : Tokens.text-secondary;
                    overflow: elide;
                    horizontal-stretch: 0;
                    max-width: self.preferred-width;
                }

                // Messages in the thread, left out at one: "1" everywhere says nothing.
                if root.data.message-count > 1: Rectangle {
                    y: (parent.height - self.height) / 2;
                    width: nombre.preferred-width + 10px;
                    height: 15px;
                    border-radius: 7.5px;
                    border-width: 1px;
                    border-color: Tokens.border-strong;
                    nombre := Text {
                        text: root.data.message-count;
                        font-size: 10px;
                        color: Tokens.text-muted;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                Rectangle { horizontal-stretch: 1; }

                Text {
                    text: root.data.date;
                    font-size: 11px;
                    font-weight: root.data.unread ? 600 : 400;
                    color: root.data.unread ? Tokens.text : Tokens.text-muted;
                    vertical-alignment: center;
                }
            }

            // Second line: the subject, then as much of the excerpt as fits, then
            // the marks. Tall rows give the excerpt a line of its own.
            HorizontalLayout {
                spacing: 6px;
                Text {
                    text: root.data.subject;
                    font-size: 13px;
                    font-weight: root.data.unread ? 600 : 400;
                    color: root.data.unread ? Tokens.text : Tokens.text-secondary;
                    overflow: elide;
                    horizontal-stretch: root.airy ? 1 : 0;
                    max-width: root.airy ? 10000px : self.preferred-width;
                }
                if !root.airy: Text {
                    text: root.data.preview;
                    font-size: 12px;
                    color: Tokens.text-muted;
                    vertical-alignment: center;
                    overflow: elide;
                    horizontal-stretch: 1;
                    min-width: 0px;
                }
                // Drawn, not typed: symbol characters are missing from most
                // interface fonts, and came out as empty boxes.
                if root.data.has-attachment: Icon {
                    y: (parent.height - self.height) / 2;
                    width: 12px;
                    data: Icons.paperclip;
                    size: 12px;
                    tint: Tokens.text-muted;
                }
                // The tracker is told by its shape: the default theme has no colour
                // for it.
                if root.data.has-tracker: Icon {
                    y: (parent.height - self.height) / 2;
                    width: 12px;
                    data: Icons.eye;
                    size: 12px;
                    tint: Tokens.text-muted;
                }
                if root.data.snoozed: Icon {
                    y: (parent.height - self.height) / 2;
                    width: 12px;
                    data: Icons.clock;
                    size: 12px;
                    tint: Tokens.text-muted;
                }
                if root.data.flagged: Icon {
                    y: (parent.height - self.height) / 2;
                    width: 12px;
                    data: Icons.star;
                    size: 12px;
                    filled: true;
                    tint: Tokens.warning;
                }
            }

            if root.airy: Text {
                text: root.data.preview;
                font-size: 12px;
                color: Tokens.text-muted;
                overflow: elide;
            }
        }
    }

    } // drag
}

// The menu a right-click opens.
//
// It carries the same actions as the reading toolbar and the same shortcuts, because
// three ways to do a thing that disagree about what it is called is worse than one.
export component ThreadContextMenu inherits Rectangle {
    in property <bool> unread;
    in property <bool> starred;
    in property <length> menu-x;
    in property <length> menu-y;

    callback open-thread();
    callback add-task();
    callback mark-done();
    callback archive();
    callback snooze(string);
    callback toggle-unread();
    callback toggle-star();
    callback delete-thread();
    callback view-source();
    callback dismissed();
    /// Un clic droit ailleurs : ferme ici, et rouvre là-bas.
    callback reopen-at(length, length);

    // The veil catches the click that closes the menu. Without it the menu stays up
    // until something else happens to take the focus.
    //
    // Il avale aussi le clic droit, et c'est ce qui rendait le menu si pénible à
    // déplacer : viser une autre ligne demandait de fermer d'abord, dans le vide, puis
    // de recliquer. Le voile ne peut pas laisser passer l'événement — rien ne le peut
    // dans Slint — alors il transmet le point, et la liste retrouve la ligne.
    TouchArea {
        width: 100%;
        height: 100%;
        clicked => { root.dismissed(); }
        pointer-event(event) => {
            if (event.button == PointerEventButton.right
                && event.kind == PointerEventKind.down) {
                root.dismissed();
                root.reopen-at(
                    self.absolute-position.x + self.mouse-x,
                    self.absolute-position.y + self.mouse-y);
            }
        }
    }

    MenuSurface {
        available-width: root.width;
        available-height: root.height;
        menu-x: root.menu-x;
        menu-y: root.menu-y;
        menu-width: 210px;
        menu-height: entries.preferred-height + 8px;

        entries := VerticalLayout {
            padding: 4px;

            MenuEntry {
                icon: Icons.envelope-open;
                label: "Open";
                activated => { root.open-thread(); root.dismissed(); }
            }
            MenuEntry {
                icon: Icons.check;
                label: "Mark as done";
                shortcut: "E";
                activated => { root.mark-done(); root.dismissed(); }
            }
            MenuEntry {
                icon: Icons.task;
                label: "Add to tasks";
                shortcut: "T";
                activated => { root.add-task(); root.dismissed(); }
            }
            MenuEntry {
                icon: Icons.archive;
                label: "Archive";
                shortcut: "A";
                activated => { root.archive(); root.dismissed(); }
            }
            // Trois échéances plutôt qu'une.
            //
            // « Demain » était la seule, figée à vingt-quatre heures dans le code — donc
            // un message reporté à vingt-trois heures revenait à vingt-trois heures le
            // lendemain, au moment précis où l'on ne veut pas de courrier. Les trois
            // choix couvrent ce que reporter veut dire en pratique : plus tard
            // aujourd'hui, demain matin, la semaine prochaine.
            MenuEntry {
                icon: Icons.clock;
                label: "Snooze until this evening";
                activated => { root.snooze("evening"); root.dismissed(); }
            }
            MenuEntry {
                icon: Icons.clock;
                label: "Snooze until tomorrow morning";
                shortcut: "S";
                activated => { root.snooze("tomorrow"); root.dismissed(); }
            }
            MenuEntry {
                icon: Icons.clock;
                label: "Snooze until Monday";
                activated => { root.snooze("monday"); root.dismissed(); }
            }

            MenuSeparator {}

            MenuEntry {
                icon: root.unread ? Icons.envelope-open : Icons.envelope-closed;
                label: root.unread ? "Mark as read" : "Mark as unread";
                shortcut: "R";
                activated => { root.toggle-unread(); root.dismissed(); }
            }
            MenuEntry {
                icon: Icons.star;
                label: root.starred ? "Remove star" : "Star";
                shortcut: "F";
                activated => { root.toggle-star(); root.dismissed(); }
            }

            MenuSeparator {}

            // Le message tel qu'il est arrivé. Rarement, et alors rien d'autre ne fait
            // l'affaire.
            MenuEntry {
                icon: Icons.code;
                label: "View source";
                activated => { root.view-source(); root.dismissed(); }
            }

            MenuEntry {
                icon: Icons.trash;
                label: "Delete";
                shortcut: "Shift+3";
                danger: true;
                activated => { root.delete-thread(); root.dismissed(); }
            }
        }
    }
}

// La barre des actions groupées.
//
// Elle **remplace** les onglets tant qu'un lot est coché, au lieu de s'ajouter au
// dessus. Deux raisons : la place, et le fait qu'un lot coché est un mode — ce qui va
// se passer ensuite porte sur les lignes cochées et sur rien d'autre, et une barre
// d'onglets encore visible au-dessus laisserait croire qu'on peut changer de file
// sans conséquence pour la sélection.
export component BulkBar inherits Rectangle {
    in property <int> count;
    in property <string> count-label;

    callback mark-done();
    callback archive();
    callback delete-selected();
    callback mark-read();
    callback mark-unread();
    callback select-all();
    callback clear();

    height: 30px;
    border-radius: Tokens.radius-medium;
    background: Tokens.surface-low;
    border-width: 1px;
    border-color: Tokens.border-strong;

    HorizontalLayout {
        padding-left: Tokens.space-2;
        padding-right: 3px;
        spacing: Tokens.space-1;

        Text {
            text: root.count-label + " selected";
            font-size: Tokens.size-small;
            font-weight: Tokens.weight-bold;
            color: Tokens.text;
            vertical-alignment: center;
        }

        Rectangle { width: Tokens.space-1; }

        // `y` explicite sur chacun.
        //
        // Un `IconButton` fait vingt-deux pixels de haut dans une barre qui en fait
        // trente : dans une disposition horizontale, un enfant de hauteur fixe se pose
        // en haut de sa case. Les cinq icônes flottaient donc quatre pixels au-dessus
        // de leur ligne, pendant que le texte « 2 selected », lui, se centrait.
        IconButton {
            y: (parent.height - self.height) / 2;
            icon: Icons.check;
            label: "Mark as done";
            shortcut: "E";
            button-size: 24px;
            icon-size: 14px;
            clicked => { root.mark-done(); }
        }
        IconButton {
            y: (parent.height - self.height) / 2;
            icon: Icons.archive;
            label: "Archive";
            shortcut: "A";
            button-size: 24px;
            icon-size: 14px;
            clicked => { root.archive(); }
        }
        IconButton {
            y: (parent.height - self.height) / 2;
            icon: Icons.envelope-open;
            label: "Mark as read";
            button-size: 24px;
            icon-size: 14px;
            clicked => { root.mark-read(); }
        }
        IconButton {
            y: (parent.height - self.height) / 2;
            icon: Icons.envelope-closed;
            label: "Mark as unread";
            button-size: 24px;
            icon-size: 14px;
            clicked => { root.mark-unread(); }
        }
        IconButton {
            y: (parent.height - self.height) / 2;
            icon: Icons.trash;
            label: "Delete";
            button-size: 24px;
            icon-size: 14px;
            danger: true;
            clicked => { root.delete-selected(); }
        }

        Rectangle {}

        // « Select all » en toutes lettres.
        //
        // C'était une icône de liste, et personne ne l'a reconnue — la demande d'un
        // bouton « tout sélectionner » est arrivée alors qu'il était déjà là. Aucun
        // dessin ne dit « tout », et les six voisins sont des verbes qu'une icône sait
        // porter : cocher, archiver, jeter. Celui-ci a besoin d'un mot.
        Rectangle {
            y: (parent.height - self.height) / 2;
            width: tout.preferred-width + 2 * Tokens.space-2;
            height: 24px;
            border-radius: Tokens.radius-small;
            background: tout-touch.has-hover ? Tokens.surface-hover : transparent;
            animate background { duration: Tokens.instant; }

            accessible-role: button;
            accessible-label: "Select everything loaded";
            accessible-description: "Ctrl+A";
            accessible-action-default => { root.select-all(); }

            tout := Text {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                text: "Select all";
                font-size: Tokens.size-small;
                color: Tokens.text-secondary;
            }

            tout-touch := TouchArea {
                clicked => { root.select-all(); }
            }

            Tooltip {
                text: @markdown("Select everything loaded  Ctrl+A");
            }
        }

        IconButton {
            y: (parent.height - self.height) / 2;
            icon: Icons.window-close;
            label: "Clear the selection";
            shortcut: "Esc";
            button-size: 24px;
            icon-size: 14px;
            clicked => { root.clear(); }
        }
    }
}

// La barre de recherche.
//
// Elle est au-dessus des onglets et non dans une fenêtre à part : chercher, c'est
// filtrer la colonne du milieu, et le résultat doit apparaître là où le regard est
// déjà posé.
export component SearchBar inherits VerticalLayout {
    in property <string> summary;
    in property <string> explanation;
    in property <bool> active;
    in-out property <string> query;

    callback submitted(string);
    callback cleared();

    public function focus-field() {
        field.focus();
        field.select-all();
    }

    padding-left: 14px;
    padding-right: 14px;
    padding-top: 12px;
    spacing: 4px;

    // Take the height it needs and no more. Inside a vertical layout every child
    // stretches by default, so with an empty list the search field was inflating to
    // fill the column — a text input the height of the window.
    vertical-stretch: 0;

    HorizontalLayout {
        spacing: 4px;
        vertical-stretch: 0;
        height: 34px;

        field := TextField {
            accessible-label: "Search";
            placeholder-text: "Search, from:marie is:unread";
            icon: Icons.search;
            shortcut: "Ctrl F";
            font-size: 13px;
            text <=> root.query;
            accepted(t) => { root.submitted(t); }
            // Vider le champ suffit à sortir : demander un second geste pour revenir
            // à la file serait une porte qui ne s'ouvre que dans un sens.
            edited(t) => {
                if (t == "" && root.active) { root.cleared(); }
            }
        }

        if root.active: Rectangle {
            width: 24px;
            border-radius: Tokens.radius-small;
            background: close-touch.has-hover ? Tokens.surface-hover : transparent;

            accessible-role: button;
            accessible-label: "Leave search";
            accessible-action-default => {
                root.query = "";
                root.cleared();
            }

            Icon {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                data: Icons.window-close;
                size: 12px;
                tint: close-touch.has-hover ? Tokens.text : Tokens.text-muted;
            }

            close-touch := TouchArea {
                clicked => {
                    root.query = "";
                    root.cleared();
                }
            }
        }
    }

    // Ce qui a été compris, rendu à l'utilisateur. Une syntaxe de recherche que
    // personne ne confirme est une syntaxe que personne n'apprend.
    if root.active: HorizontalLayout {
        spacing: Tokens.space-2;
        vertical-stretch: 0;

        Text {
            text: root.summary;
            font-size: Tokens.size-small;
            color: Tokens.text-secondary;
        }
        Text {
            text: root.explanation;
            font-size: Tokens.size-small;
            color: Tokens.text-muted;
            overflow: elide;
        }
    }
}

// La liste des conversations.
export component ThreadListView inherits VerticalLayout {
    in property <[ThreadRowData]> rows;
    in property <int> selected-id;
    in property <int> active-tab;
    in property <[int]> counts;
    in property <bool> loading;
    in property <string> empty-message: "Nothing to do.";
    in property <bool> searching;
    in property <[string]> count-labels;
    in property <[string]> count-fulls;
    // Le nom du dossier montré, quand ce n'en est pas une file. Il remplace les
    // onglets : « Trash » avec les trois files allumées au-dessus décrirait un écran
    // qui n'existe pas.
    in property <string> folder-name;
    in property <string> search-summary;
    in property <string> search-explanation;
    in property <int> marked-count;
    in property <data-transfer> drag-payload;
    in property <string> marked-label;
    in-out property <string> search-query;

    callback row-clicked(int);
    callback tab-selected(int);
    callback scrolled-near-end();
    callback search-submitted(string);
    callback search-cleared();
    callback folder-left();
    /// Le fil, la position, et son état — lu et épinglé.
    ///
    /// L'état voyage avec la demande parce que le menu ne sélectionne plus rien : il
    /// écrivait « Mark as read » d'après le fil ouvert dans la colonne de lecture, qui
    /// n'est plus celui sur lequel on vient de cliquer. La ligne, elle, le sait.
    callback row-context-menu(int, length, length, bool, bool);
    in property <bool> filter-unread;
    in property <bool> filter-attachments;
    in property <bool> filter-starred;
    callback filter-toggled(string);

    callback row-mark-toggled(int);
    callback row-mark-extended(int);
    callback row-drag-started(int);
    callback bulk-done();
    callback bulk-archive();
    callback bulk-delete();
    callback bulk-read();
    callback bulk-unread();
    callback bulk-select-all();
    callback bulk-clear();

    public function focus-search() {
        bar.focus-field();
    }

    /// Rouvre le menu contextuel sur la ligne qui se trouve à ce point de la fenêtre.
    ///
    /// Le voile qui ferme le menu couvre toute la fenêtre, donc un clic droit sur une
    /// autre ligne n'atteignait jamais cette ligne : il fallait cliquer dans le vide
    /// pour fermer, puis recliquer sur la ligne voulue. Trois gestes pour en faire un.
    ///
    /// Le voile renvoie donc le point ici, et la liste retrouve la ligne elle-même. Le
    /// calcul est exact plutôt qu'approché parce que toutes les lignes ont la même
    /// hauteur, fixée par le même jeton que celui qu'elles emploient : il n'y a pas
    /// d'estimation, seulement une division.
    ///
    /// Hors de la liste, ou au-delà de la dernière ligne, rien ne se passe — le menu
    /// s'est fermé et c'est tout ce qui était demandé. Ouvrir un menu sur la mauvaise
    /// ligne serait bien pire que de n'en ouvrir aucun : « Delete » y est.
    public function reopen-context-menu-at(px: length, py: length) {
        if (root.rows.length == 0) {
            return;
        }
        // Position du point dans le contenu défilé de la liste.
        let dans-liste = py - list.absolute-position.y + (-list.viewport-y);
        if (px < list.absolute-position.x
            || px > list.absolute-position.x + list.width
            || dans-liste < 0
            || dans-liste >= root.rows.length * Tokens.row-height) {
            return;
        }
        let index = floor(dans-liste / Tokens.row-height);
        let ligne = root.rows[index];
        root.row-context-menu(ligne.id, px, py, ligne.unread, ligne.flagged);
    }

    bar := SearchBar {
        active: root.searching;
        summary: root.search-summary;
        explanation: root.search-explanation;
        query <=> root.search-query;
        submitted(q) => { root.search-submitted(q); }
        cleared => { root.search-cleared(); }
    }

    // Pendant une recherche, les onglets disparaissent : les résultats ne sont pas
    // rangés par file, et laisser un onglet allumé au-dessus d'eux désignerait une
    // liste qui n'est pas celle qu'on regarde.
    // The tabs sit on a plate of their own rather than floating: three lozenges on
    // bare background read as debris, which is exactly how they looked.
    if root.marked-count > 0: Rectangle {
        vertical-stretch: 0;
        height: 38px;

        BulkBar {
            x: Tokens.space-2;
            y: 4px;
            width: parent.width - 2 * Tokens.space-2;
            count: root.marked-count;
            count-label: root.marked-label;
            mark-done => { root.bulk-done(); }
            archive => { root.bulk-archive(); }
            delete-selected => { root.bulk-delete(); }
            mark-read => { root.bulk-read(); }
            mark-unread => { root.bulk-unread(); }
            select-all => { root.bulk-select-all(); }
            clear => { root.bulk-clear(); }
        }
    }

    // Dans un dossier, son nom prend la place des onglets. Les trois files décrivent
    // un travail ; un dossier décrit un endroit, et laisser « À faire » allumé au
    // dessus du contenu de la corbeille désignerait une liste qui n'est pas celle
    // qu'on regarde.
    if !root.searching && root.marked-count == 0 && root.folder-name != "": Rectangle {
        vertical-stretch: 0;
        height: 38px;

        HorizontalLayout {
            x: Tokens.space-2;
            y: 4px;
            width: parent.width - 2 * Tokens.space-2;
            height: 30px;
            spacing: Tokens.space-2;

            Text {
                text: root.folder-name;
                font-family: Tokens.font-family;
                font-size: Tokens.size-body;
                font-weight: Tokens.weight-bold;
                color: Tokens.text;
                vertical-alignment: center;
            }

            Rectangle {}

            IconButton {
                icon: Icons.window-close;
                label: "Back to the queues";
                shortcut: "Esc";
                button-size: 24px;
                icon-size: 13px;
                clicked => { root.folder-left(); }
            }
        }
    }

    // The three queues are the list's title: the one shown large, the others quiet
    // beside it, each with what it holds.
    if !root.searching && root.marked-count == 0 && root.folder-name == "": HorizontalLayout {
        vertical-stretch: 0;
        height: 46px;
        padding-left: 16px;
        padding-right: 16px;
        padding-top: 8px;
        padding-bottom: 4px;

        QueueTabs {
            names: ["To do", "Waiting", "Done"];
            counts: root.count-labels;
            descriptions: [
                (root.counts.length > 0 ? root.counts[0] : 0) + " conversations",
                (root.counts.length > 1 ? root.counts[1] : 0) + " conversations",
                (root.counts.length > 2 ? root.counts[2] : 0) + " conversations",
            ];
            selected: root.active-tab;
            chosen(i) => { root.tab-selected(i); }
        }
        Rectangle { horizontal-stretch: 1; }
    }

    // Les filtres rapides.
    //
    // La recherche répond à « où est ce message dont je me souviens » ; un filtre répond
    // à « lesquels de ces deux cents me restent ». Deux gestes différents, et sur une
    // file de cent quatre-vingt-huit c'est le second qu'on fait le plus souvent.
    //
    // Cachés pendant une recherche et pendant un lot coché : dans les deux cas la
    // question posée par la liste est déjà autre chose, et un troisième réducteur
    // au-dessus rendrait indevinable ce qui est montré.
    if !root.searching && root.marked-count == 0: HorizontalLayout {
        vertical-stretch: 0;
        height: 34px;
        padding-left: 16px;
        padding-right: 16px;
        padding-bottom: 6px;
        spacing: 6px;

        Pill {
            text: "Unread";
            icon: Icons.envelope-closed;
            on: root.filter-unread;
            toggled => { root.filter-toggled("unread"); }
        }
        Pill {
            text: "Attachments";
            icon: Icons.paperclip;
            on: root.filter-attachments;
            toggled => { root.filter-toggled("attachments"); }
        }
        Pill {
            text: "Starred";
            icon: Icons.star;
            on: root.filter-starred;
            toggled => { root.filter-toggled("starred"); }
        }

        Rectangle {}

        // Une sortie visible. Un filtre laissé allumé fait croire à une boîte vide, et
        // c'est la panne la plus déroutante qu'un filtre puisse produire.
        if root.filter-unread || root.filter-attachments || root.filter-starred: Rectangle {
            width: 46px;
            border-radius: Tokens.radius-small;
            background: effacer.has-hover ? Tokens.surface-hover : transparent;

            accessible-role: button;
            accessible-label: "Clear the filters";
            accessible-action-default => { root.filter-toggled("none"); }

            Text {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                text: "Clear";
                font-size: Tokens.size-small;
                color: Tokens.text-muted;
            }
            effacer := TouchArea {
                clicked => { root.filter-toggled("none"); }
            }
        }
    }

    // La liste et son message de vide partagent une même case, au lieu d'être deux
    // frères qui s'étirent chacun de leur côté.
    //
    // Ils étaient deux blocs conditionnels, ce qui enfermait la vue de liste dans une
    // portée où plus rien ne pouvait la nommer — et la fonction qui retrouve une ligne
    // sous un point a besoin de sa position et de son défilement. La liste existe donc
    // toujours ; quand il n'y a rien dedans, elle ne dessine rien et le message passe
    // au travers.
    Rectangle {
        vertical-stretch: 1;

        if root.rows.length == 0 && !root.loading: VerticalLayout {
            alignment: center;
            Text {
                text: root.searching
                    ? "No results."
                    : (root.folder-name != ""
                        ? root.folder-name + " is empty."
                        : root.empty-message);
                font-size: Tokens.size-body;
                color: Tokens.text-muted;
                horizontal-alignment: center;
            }
        }

    list := ListView {
        for entry in root.rows: ThreadRow {
            data: entry;
            selected: entry.id == root.selected-id;
            selection-mode: root.marked-count > 0;
            payload: root.drag-payload;
            clicked => { root.row-clicked(entry.id); }
            drag-started => { root.row-drag-started(entry.id); }
            context-menu(x, y) => {
                root.row-context-menu(entry.id, x, y, entry.unread, entry.flagged);
            }
            mark-toggled => { root.row-mark-toggled(entry.id); }
            mark-extended => { root.row-mark-extended(entry.id); }
        }

        // Le chargement de la suite est déclenché par la position du défilement, pas
        // par un bouton : la liste doit paraître infinie.
        changed viewport-y => {
            if (-self.viewport-y + self.visible-height > self.viewport-height - 400px) {
                root.scrolled-near-end();
            }
        }
    }

    }
}
