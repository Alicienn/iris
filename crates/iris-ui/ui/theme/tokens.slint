// The design tokens, set from Rust by the theme showing (light or dark).
//
// Nothing in the interface writes a colour, a radius or a duration of its own: it
// comes from here, which is what lets one switch repaint the whole window.

export global Tokens {
    // --- Colours ---
    /// The window's ground.
    in-out property <color> background: #f2f2f4;
    /// The side columns: accounts, calendars, task lists.
    in-out property <color> surface-low: #ebebed;
    /// Lists, the reader, cards.
    in-out property <color> surface: #ffffff;
    /// Raised above the rest.
    in-out property <color> surface-high: #ffffff;
    /// What floats: menus, popovers, windows, tooltips.
    in-out property <color> panel: #ffffff;
    in-out property <color> surface-hover: #0000000a;
    in-out property <color> surface-active: #00000012;
    in-out property <color> border: #e3e3e6;
    in-out property <color> border-strong: #d1d1d6;
    in-out property <color> text: #1d1d1f;
    in-out property <color> text-secondary: #424245;
    in-out property <color> text-muted: #6e6e73;
    /// Placeholders, what is past, what cannot be used.
    in-out property <color> text-faint: #a1a1a6;
    /// The one colour for what to act on.
    in-out property <color> accent: #007aff;
    /// The accent as a ground: the chosen row, a filter that is on.
    in-out property <color> accent-soft: #007aff1f;
    in-out property <color> accent-text: #ffffff;
    in-out property <color> error: #ff3b30;
    in-out property <color> warning: #ff9500;
    in-out property <color> success: #34c759;
    in-out property <bool> dark: false;

    // --- Apple's system colours, for what is told by colour: today in red, the
    // calendars, the lists, the services. Lighter in the dark, as Apple has them. ---
    out property <color> red: dark ? #ff453a : #ff3b30;
    out property <color> orange: dark ? #ff9f0a : #ff9500;
    out property <color> yellow: dark ? #ffd60a : #ffcc00;
    out property <color> green: dark ? #30d158 : #34c759;
    out property <color> teal: dark ? #40c8e0 : #30b0c7;
    out property <color> blue: dark ? #0a84ff : #007aff;
    out property <color> purple: dark ? #bf5af2 : #af52de;
    out property <color> pink: dark ? #ff375f : #ff2d55;
    out property <color> grey: dark ? #98989d : #8e8e93;
    /// A segmented control's well, and the search field's.
    out property <color> well: dark ? #1c1c1e : #e4e4e8;
    /// A control raised in it: the chosen segment, a push button.
    out property <color> control: dark ? #3a3a3c : #ffffff;
    /// The sidebar's selection when the window has not the keyboard.
    out property <color> select-quiet: dark ? #3a3a3c : #dcdce0;

    // --- Shapes ---
    in-out property <length> radius-small: 6px;
    in-out property <length> radius-medium: 8px;
    in-out property <length> radius-large: 12px;
    /// Home's widgets, and the window itself.
    out property <length> radius-widget: 18px;

    // --- Spacing ---
    // Every margin of the interface is a multiple of this unit.
    in-out property <length> unit: 4px;

    // --- Type ---
    in-out property <string> font-family: "Segoe UI Variable Text";
    /// Titles: the same family, cut for display sizes.
    in-out property <string> font-display: "Segoe UI Variable Display";
    in-out property <string> font-mono: "Cascadia Mono";
    in-out property <length> size-small: 12px;
    in-out property <length> size-body: 13.5px;
    in-out property <length> size-title: 15px;
    in-out property <int> weight-body: 400;
    in-out property <int> weight-bold: 600;
    in-out property <float> line-height: 1.45;

    // --- Density ---
    in-out property <length> row-height: 56px;
    in-out property <length> row-padding-x: 14px;

    // --- Motion ---
    in-out property <duration> instant: 90ms;
    in-out property <duration> quick: 140ms;
    in-out property <duration> moderate: 220ms;

    /// Behind a window over the others: a light dimming, darker on the dark theme.
    out property <color> scrim: dark ? #00000059 : #00000026;
    /// An inset group on a page (settings' groups, the weekend, an invitation): lighter
    /// than the ground in dark, the ground's own grey in light.
    out property <color> group: dark ? #252527 : #f2f2f4;
    /// The shadow under what floats.
    out property <color> shadow: dark ? #00000073 : #0f0f191f;

    // Shadows by height, softer the lower: a card just off the page, then what floats
    // beside things (menus, popovers, panels), then a window over everything. Wider
    // and lighter rather than dark and tight.
    out property <color> shadow-card: dark ? #00000040 : #0f0f190d;
    out property <length> shadow-card-blur: 8px;
    out property <length> shadow-card-y: 1px;
    out property <color> shadow-float: dark ? #00000066 : #0f0f191a;
    out property <length> shadow-float-blur: 26px;
    out property <length> shadow-float-y: 8px;
    out property <color> shadow-window: dark ? #0000008c : #0f0f1929;
    out property <length> shadow-window-blur: 48px;
    out property <length> shadow-window-y: 16px;

    // Computed spacing, so that the multiplications are not scattered around.
    out property <length> space-1: unit;
    out property <length> space-2: unit * 2;
    out property <length> space-3: unit * 3;
    out property <length> space-4: unit * 4;
    out property <length> space-6: unit * 6;
}
