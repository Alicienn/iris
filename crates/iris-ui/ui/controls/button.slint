import { Tokens } from "@iris/theme/tokens.slint";
import { Layout } from "@iris/theme/layout.slint";
import { Icon, Icons, IconButton } from "@iris/base/icons.slint";

export { IconButton }

// What one presses. One button, in four kinds and two sizes, with its hover and
// pressed states drawn here and nowhere else.

export enum ButtonKind {
    /// The one thing to do here: filled with the accent.
    primary,
    /// A plate and a border.
    secondary,
    /// Words only, until the pointer comes.
    ghost,
    /// Destroys something: filled red.
    danger,
}

export enum ButtonSize { md, sm }

export component Button inherits Rectangle {
    in property <string> text;
    in property <string> icon;
    /// The key that does the same, shown after the words: "E".
    in property <string> shortcut;
    /// For a screen reader when the words are not enough: "Delete completed tasks".
    in property <string> label;
    in property <ButtonKind> kind: ButtonKind.secondary;
    in property <ButtonSize> size: ButtonSize.md;
    in property <bool> enabled: true;
    /// Its work is under way: the icon dims. Nothing loops.
    in property <bool> busy;
    callback clicked();

    property <bool> plein: root.kind == ButtonKind.primary || root.kind == ButtonKind.danger;
    property <color> encre: root.kind == ButtonKind.primary ? Tokens.accent-text
        : root.kind == ButtonKind.danger ? white
        : root.kind == ButtonKind.ghost && !touch.has-hover ? Tokens.text-secondary
        : Tokens.text;

    // The Mac's push button: low, a small radius, a raised white key when secondary.
    height: max(root.size == ButtonSize.sm ? 24px : 28px, Layout.touch-input ? 44px : 0px);
    width: rang.preferred-width + (root.size == ButtonSize.sm ? 20px : 24px);
    property <bool> releve: root.kind != ButtonKind.ghost;

    accessible-role: button;
    accessible-label: root.label != "" ? root.label : root.text;
    accessible-description: root.shortcut;
    accessible-enabled: root.enabled;
    accessible-action-default => { if (root.enabled) { root.clicked(); } }

    // Everything drawn is in this child, dimmed as one when disabled: an animated
    // background, a shadow or an opacity on the root made Slint copy the whole button
    // into each of its 96 places (the generated code outgrew the CI's memory, 7.0.0).
    Rectangle {
        opacity: root.enabled ? 1.0 : 0.45;
        Rectangle {
            border-radius: Tokens.radius-small;
            background: root.kind == ButtonKind.primary
                ? (touch.pressed ? Tokens.accent.darker(0.18) : touch.has-hover ? Tokens.accent.darker(0.07) : Tokens.accent)
                : root.kind == ButtonKind.danger
                ? (touch.pressed ? Tokens.error.darker(0.2) : touch.has-hover ? Tokens.error.darker(0.08) : Tokens.error)
                : (touch.pressed ? Tokens.surface-active : touch.has-hover ? Tokens.surface-hover
                    : root.kind == ButtonKind.secondary ? Tokens.control : transparent);
            drop-shadow-blur: root.releve ? 2px : 0px;
            drop-shadow-offset-y: root.releve ? 1px : 0px;
            drop-shadow-color: root.releve ? Tokens.shadow-card.with-alpha(0.18) : transparent;
            animate background { duration: Tokens.instant; }
        }

        // Centred: the same as a fixed inset for a button sized to its words, and right
        // for one given a width (the rail's New event).
        rang := HorizontalLayout {
            x: (root.width - self.width) / 2;
            width: self.preferred-width;
            spacing: 6px;
            if root.icon != "": Icon {
                y: (parent.height - self.height) / 2;
                data: root.icon;
                size: root.size == ButtonSize.sm ? 14px : 15px;
                weight: 1.6;
                tint: root.encre;
                alpha: root.busy ? 0.45 : 1.0;
            }
            if root.text != "": Text {
                text: root.text;
                font-size: root.size == ButtonSize.sm ? 12.5px : 13px;
                font-weight: root.plein ? 500 : 400;
                color: root.encre;
                vertical-alignment: center;
            }
            // The key is said to a screen reader and in the shortcuts' help, not drawn:
            // a keycap widened every button past the Mac's.
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

/// Words that lead somewhere: "Open ›", "Clear", "Mail 18".
/// A page's own button on a phone: the whole width, a pill, within the thumb's reach
/// (the Android mockups' `.btn.block`). Primary filled; secondary outlined; ghost the
/// accent's words alone.
export component BlockButton inherits Rectangle {
    in property <string> text;
    in property <string> label;
    in property <ButtonKind> kind: ButtonKind.primary;
    in property <bool> enabled: true;
    /// Drawn before the words: the Google mark, an icon.
    in property <string> icon;
    callback clicked();

    height: root.kind == ButtonKind.primary ? 52px : 50px;
    horizontal-stretch: 1;

    accessible-role: button;
    accessible-label: root.label != "" ? root.label : root.text;
    accessible-enabled: root.enabled;
    accessible-action-default => { if (root.enabled) { root.clicked(); } }

    // Drawn in a child, dimmed as one: an opacity on the root made Slint copy the
    // whole button into every place it is used (7.0.0).
    Rectangle {
        opacity: root.enabled ? 1.0 : 0.45;
        border-radius: root.height / 2;
        border-width: root.kind == ButtonKind.secondary ? 1px : 0px;
        border-color: Tokens.border-strong;
        background: root.kind == ButtonKind.primary
            ? (touch.pressed ? Tokens.accent.darker(0.18) : Tokens.accent)
            : root.kind == ButtonKind.secondary
            ? (touch.pressed ? Tokens.surface-active : Tokens.surface)
            : (touch.pressed ? Tokens.surface-hover : transparent);

        HorizontalLayout {
            alignment: center;
            spacing: 10px;
            if root.icon != "": Icon {
                y: (parent.height - self.height) / 2;
                data: root.icon;
                size: 18px;
                tint: root.kind == ButtonKind.primary ? Tokens.accent-text : Tokens.text;
            }
            @children
            Text {
                text: root.text;
                font-size: 15px;
                font-weight: 600;
                color: root.kind == ButtonKind.primary ? Tokens.accent-text
                    : root.kind == ButtonKind.ghost ? Tokens.accent : Tokens.text;
                vertical-alignment: center;
            }
        }
    }
    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

/// The one action of a phone's page, floating over the bottom right of what scrolls
/// (the Android mockups' `.fab`): an icon and its words.
export component Fab inherits Rectangle {
    in property <string> text;
    in property <string> icon;
    callback clicked();

    width: rang.preferred-width + 40px;
    height: 56px;
    border-radius: 18px;
    background: touch.pressed ? Tokens.accent.darker(0.18) : Tokens.accent;
    drop-shadow-blur: Tokens.shadow-float-blur;
    drop-shadow-offset-y: Tokens.shadow-float-y;
    drop-shadow-color: Tokens.shadow-float;

    accessible-role: button;
    accessible-label: root.text;
    accessible-action-default => { root.clicked(); }

    rang := HorizontalLayout {
        x: 18px;
        width: self.preferred-width;
        spacing: 10px;
        Icon {
            y: (parent.height - self.height) / 2;
            data: root.icon;
            size: 20px;
            tint: Tokens.accent-text;
        }
        Text {
            text: root.text;
            font-size: 15.5px;
            font-weight: 600;
            color: Tokens.accent-text;
            vertical-alignment: center;
        }
    }
    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

export component Link inherits Rectangle {
    in property <string> text;
    /// A figure after the words, brighter: "Mail 18".
    in property <string> count;
    in property <bool> chevron;
    in property <string> label;
    in property <length> font-size: 12px;
    callback clicked();

    width: rang.preferred-width + 12px;
    height: max(26px, Layout.touch-input ? 44px : 0px);

    // The plate as a child, so that Slint keeps one copy of the link (7.0.0).
    Rectangle {
        border-radius: Tokens.radius-small;
        background: touch.has-hover ? Tokens.surface-hover : transparent;
        animate background { duration: Tokens.instant; }
    }

    accessible-role: button;
    accessible-label: root.label != "" ? root.label : root.text;
    accessible-action-default => { root.clicked(); }

    rang := HorizontalLayout {
        x: 6px;
        width: self.preferred-width;
        spacing: 5px;
        Text {
            text: root.text;
            font-size: root.font-size;
            color: touch.has-hover ? Tokens.text : Tokens.text-secondary;
            vertical-alignment: center;
        }
        if root.count != "": Text {
            text: root.count;
            font-size: root.font-size;
            font-weight: 600;
            color: Tokens.text;
            vertical-alignment: center;
        }
        if root.chevron: Icon {
            y: (parent.height - self.height) / 2;
            data: Icons.chevron-right;
            size: 12px;
            weight: 2.2;
            tint: touch.has-hover ? Tokens.text : Tokens.text-secondary;
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}
