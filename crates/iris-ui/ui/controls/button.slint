import { Tokens } from "@iris/theme/tokens.slint";
import { Icon, Icons, IconButton } from "@iris/base/icons.slint";

export { IconButton }

// What one presses. One button, in four kinds and two sizes, with its hover and
// pressed states drawn here and nowhere else.

export enum ButtonKind {
    /// The one thing to do here: filled with the accent.
    primary,
    /// A plate and a border.
    secondary,
    /// Words only, until the pointer comes.
    ghost,
    /// Destroys something: filled red.
    danger,
}

export enum ButtonSize { md, sm }

export component Button inherits Rectangle {
    in property <string> text;
    in property <string> icon;
    /// The key that does the same, shown after the words: "E".
    in property <string> shortcut;
    /// For a screen reader when the words are not enough: "Delete completed tasks".
    in property <string> label;
    in property <ButtonKind> kind: ButtonKind.secondary;
    in property <ButtonSize> size: ButtonSize.md;
    in property <bool> enabled: true;
    /// Its work is under way: the icon dims. Nothing loops.
    in property <bool> busy;
    callback clicked();

    property <bool> plein: root.kind == ButtonKind.primary || root.kind == ButtonKind.danger;
    property <color> encre: root.kind == ButtonKind.primary ? Tokens.accent-text
        : root.kind == ButtonKind.danger ? white
        : root.kind == ButtonKind.ghost && !touch.has-hover ? Tokens.text-secondary
        : Tokens.text;

    // The Mac's push button: low, a small radius, a raised white key when secondary.
    height: root.size == ButtonSize.sm ? 24px : 28px;
    width: rang.preferred-width + (root.size == ButtonSize.sm ? 20px : 24px);
    border-radius: Tokens.radius-small;
    border-width: 0px;
    background: root.kind == ButtonKind.primary
        ? (touch.pressed ? Tokens.accent.darker(0.18) : touch.has-hover ? Tokens.accent.darker(0.07) : Tokens.accent)
        : root.kind == ButtonKind.danger
        ? (touch.pressed ? Tokens.error.darker(0.2) : touch.has-hover ? Tokens.error.darker(0.08) : Tokens.error)
        : (touch.pressed ? Tokens.surface-active : touch.has-hover ? Tokens.surface-hover
            : root.kind == ButtonKind.secondary ? Tokens.control : transparent);
    property <bool> releve: root.kind != ButtonKind.ghost;
    drop-shadow-blur: root.releve ? 2px : 0px;
    drop-shadow-offset-y: root.releve ? 1px : 0px;
    drop-shadow-color: root.releve ? Tokens.shadow-card.with-alpha(0.18) : transparent;
    opacity: root.enabled ? 1.0 : 0.45;
    animate background, border-color { duration: Tokens.instant; }

    accessible-role: button;
    accessible-label: root.label != "" ? root.label : root.text;
    accessible-description: root.shortcut;
    accessible-enabled: root.enabled;
    accessible-action-default => { if (root.enabled) { root.clicked(); } }

    // Centred: the same as a fixed inset for a button sized to its words, and right
    // for one given a width (the rail's New event).
    rang := HorizontalLayout {
        x: (root.width - self.width) / 2;
        width: self.preferred-width;
        spacing: 6px;
        if root.icon != "": Icon {
            y: (parent.height - self.height) / 2;
            data: root.icon;
            size: root.size == ButtonSize.sm ? 14px : 15px;
            weight: 1.6;
            tint: root.encre;
            alpha: root.busy ? 0.45 : 1.0;
        }
        if root.text != "": Text {
            text: root.text;
            font-size: root.size == ButtonSize.sm ? 12.5px : 13px;
            font-weight: root.plein ? 500 : 400;
            color: root.encre;
            vertical-alignment: center;
        }
        // The key is said to a screen reader and in the shortcuts' help, not drawn: a
        // keycap widened every button past the Mac's.
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

/// Words that lead somewhere: "Open ›", "Clear", "Mail 18".
export component Link inherits Rectangle {
    in property <string> text;
    /// A figure after the words, brighter: "Mail 18".
    in property <string> count;
    in property <bool> chevron;
    in property <string> label;
    in property <length> font-size: 12px;
    callback clicked();

    width: rang.preferred-width + 12px;
    height: 26px;
    border-radius: Tokens.radius-small;
    background: touch.has-hover ? Tokens.surface-hover : transparent;
    animate background { duration: Tokens.instant; }

    accessible-role: button;
    accessible-label: root.label != "" ? root.label : root.text;
    accessible-action-default => { root.clicked(); }

    rang := HorizontalLayout {
        x: 6px;
        width: self.preferred-width;
        spacing: 5px;
        Text {
            text: root.text;
            font-size: root.font-size;
            color: touch.has-hover ? Tokens.text : Tokens.text-secondary;
            vertical-alignment: center;
        }
        if root.count != "": Text {
            text: root.count;
            font-size: root.font-size;
            font-weight: 600;
            color: Tokens.text;
            vertical-alignment: center;
        }
        if root.chevron: Icon {
            y: (parent.height - self.height) / 2;
            data: Icons.chevron-right;
            size: 12px;
            weight: 2.2;
            tint: touch.has-hover ? Tokens.text : Tokens.text-secondary;
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}
