import { Tokens } from "@iris/theme/tokens.slint";
import { Icon, Icons } from "@iris/base/icons.slint";
import { Dot } from "@iris/base/atoms.slint";

// What one chooses: one of several (segments, the queue's tabs), on or off (pills,
// checks, toggles), and the small tags that say a priority.

/// One of a few options, side by side on a plate: Month, Week, Day.
export component Segmented inherits Rectangle {
    in property <[string]> options;
    in property <int> selected;
    /// An option can carry its colour when chosen (priorities). Empty: neutral.
    in property <[color]> tints;
    callback chosen(int);

    // Apple's segmented control: a grey well, the chosen segment a white key raised in
    // it with a small shadow.
    height: 26px;
    width: rang.preferred-width + 4px;
    border-radius: 7px;
    background: Tokens.well;

    rang := HorizontalLayout {
        x: 2px;
        y: 2px;
        height: parent.height - 4px;
        width: self.preferred-width;
        spacing: 0px;
        for option[i] in root.options: Rectangle {
            property <bool> on: i == root.selected;
            property <color> teinte: root.tints.length > i ? root.tints[i] : Tokens.text;
            width: mot.preferred-width + 24px;
            border-radius: 5px;
            background: self.on
                ? (root.tints.length > i ? self.teinte.transparentize(0.85) : Tokens.control)
                : transparent;
            drop-shadow-blur: self.on && root.tints.length <= i ? 2px : 0px;
            drop-shadow-color: #0000001f;
            drop-shadow-offset-y: 1px;
            border-width: self.on && root.tints.length <= i ? 1px : 0px;
            border-color: #0000000d;
            animate background { duration: Tokens.instant; }

            accessible-role: button;
            accessible-label: option;
            accessible-item-selected: self.on;
            accessible-action-default => { root.chosen(i); }

            mot := Text {
                text: option;
                font-size: 12px;
                font-weight: parent.on ? 500 : 400;
                color: parent.on ? (root.tints.length > i ? parent.teinte : Tokens.text)
                    : Tokens.text;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            touch := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.chosen(i); }
            }
        }
    }
}

/// The queue's tabs over the list: words on a plate when chosen, each with its count.
export component QueueTabs inherits Rectangle {
    in property <[string]> names;
    in property <[string]> counts;
    /// What a screen reader says of each: "1250 conversations".
    in property <[string]> descriptions;
    in property <int> selected;
    callback chosen(int);

    // Apple's segmented control: a grey well, the chosen queue a white key raised in it.
    height: 26px;
    width: onglets.preferred-width + 4px;
    border-radius: 7px;
    background: Tokens.well;

    // Where the chosen tab is: its key slides there rather than jumping, each tab
    // saying its place when it is the one.
    property <length> plaque-x;
    property <length> plaque-w;
    animate plaque-x, plaque-w { duration: 180ms; easing: cubic-bezier(0.2, 0, 0, 1); }

    Rectangle {
        x: 2px + root.plaque-x;
        y: 2px;
        width: root.plaque-w;
        height: parent.height - 4px;
        border-radius: 5px;
        background: Tokens.control;
        drop-shadow-blur: 2px;
        drop-shadow-offset-y: 1px;
        drop-shadow-color: #0000001f;
        border-width: 1px;
        border-color: #0000000d;
    }

    onglets := HorizontalLayout {
    x: 2px;
    y: 2px;
    width: self.preferred-width;
    height: parent.height - 4px;
    alignment: start;
    spacing: 0px;

    for nom[i] in root.names: onglet := Rectangle {
        property <bool> on: i == root.selected;
        width: rang.preferred-width + 24px;
        border-radius: 5px;
        background: transparent;

        init => {
            if (self.on) {
                root.plaque-x = self.x;
                root.plaque-w = self.width;
            }
        }
        changed on => {
            if (self.on) {
                root.plaque-x = self.x;
                root.plaque-w = self.width;
            }
        }
        changed x => {
            if (self.on) {
                root.plaque-x = self.x;
            }
        }
        changed width => {
            if (self.on) {
                root.plaque-w = self.width;
            }
        }

        accessible-role: tab;
        accessible-label: nom;
        accessible-description: root.descriptions.length > i ? root.descriptions[i] : "";
        accessible-item-selected: self.on;
        accessible-action-default => { root.chosen(i); }

        rang := HorizontalLayout {
            x: 12px;
            width: self.preferred-width;
            spacing: 5px;
            Text {
                text: nom;
                font-size: 12px;
                font-weight: onglet.on ? 500 : 400;
                color: Tokens.text;
                vertical-alignment: center;
            }
        }
        touch := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.chosen(i); }
        }
    }
    }
}

export enum PillKind {
    /// A filter, on or off.
    toggle,
    /// Something read from what was typed: a date, a list, a priority.
    token,
}

/// A rounded word: a filter to turn on, or what a typed line was understood to say.
export component Pill inherits Rectangle {
    in property <string> text;
    in property <string> icon;
    /// A dot of colour before the words (a list).
    in property <color> dot;
    in property <bool> has-dot;
    in property <bool> on;
    in property <PillKind> kind: PillKind.toggle;
    /// A colour for the words and the plate (a priority).
    in property <color> tint;
    in property <bool> tinted;
    callback toggled();

    property <bool> jeton: root.kind == PillKind.token;
    property <color> encre: root.tinted ? root.tint
        : root.on ? Tokens.accent
        : touch.has-hover ? Tokens.text : Tokens.text-secondary;

    // A chip: a small raised key as the Mac draws its push buttons, the accent's soft
    // ground when on.
    height: 24px;
    width: rang.preferred-width + 18px;
    border-radius: Tokens.radius-small;
    border-width: 0px;
    background: root.tinted ? root.tint.transparentize(0.88)
        : root.on ? Tokens.accent-soft
        : root.jeton ? Tokens.surface-active
        : touch.has-hover ? Tokens.surface-hover : Tokens.control;
    property <bool> releve: !root.jeton && !root.on && !root.tinted;
    drop-shadow-blur: root.releve ? Tokens.shadow-card-blur / 2 : 0px;
    drop-shadow-offset-y: root.releve ? 1px : 0px;
    drop-shadow-color: root.releve ? Tokens.shadow-card.with-alpha(0.15) : transparent;
    animate background { duration: Tokens.instant; }

    accessible-role: checkbox;
    accessible-label: root.text;
    accessible-checked: root.on;
    accessible-action-default => { root.toggled(); }

    rang := HorizontalLayout {
        x: 9px;
        width: self.preferred-width;
        spacing: 6px;
        if root.has-dot: Dot {
            y: (parent.height - self.height) / 2;
            tint: root.dot;
            size: 7px;
        }
        if root.icon != "": Icon {
            y: (parent.height - self.height) / 2;
            data: root.icon;
            size: 13px;
            tint: root.encre;
        }
        Text {
            text: root.text;
            font-size: 12.5px;
            font-weight: root.on || root.tinted ? 600 : 400;
            color: root.encre;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        enabled: !root.jeton;
        mouse-cursor: pointer;
        clicked => { root.toggled(); }
    }
}

export enum CheckShape { round, square }

/// A box to tick: round for a task, square (in its colour) for a selection.
export component Check inherits Rectangle {
    in property <bool> done;
    /// Round: late, the rim goes red.
    in property <bool> late;
    in property <CheckShape> shape: CheckShape.round;
    /// Square: its colour, filled when ticked.
    in property <color> tint: Tokens.success;
    in property <string> label;
    in property <length> size: 20px;
    /// Off: a picture of a check, the row around it takes the click.
    in property <bool> interactive: true;
    /// A thing done (a task, a step): the tick is drawn before it is said. Off for a
    /// setting (a calendar shown, a tag), which answers at once.
    in property <bool> animated;
    callback toggled();

    property <bool> rond: root.shape == CheckShape.round;
    // A round one fills with the accent, as Reminders' circles do.
    property <color> plein: root.rond ? Tokens.accent : root.tint;

    /// Ticked by a click, not yet told: the tick is drawn first, and said once drawn.
    /// Told at once, the list was redrawn before anything moved, and the box simply
    /// appeared full.
    property <bool> en-cours;
    /// What shows: ticked, or being ticked.
    out property <bool> shown-done: root.done || root.en-cours;
    /// How much of the tick is drawn, left to right.
    property <float> trace: root.shown-done ? 1 : 0;
    animate trace { duration: 240ms; easing: ease-out; }
    /// The little bump of the box as it fills.
    property <float> bond;
    animate bond { duration: 110ms; easing: ease-out; }

    width: root.size;
    height: root.size;

    accessible-role: checkbox;
    accessible-label: root.label;
    accessible-checked: root.done;
    accessible-action-default => { root.toggled(); }

    boite := Rectangle {
        width: root.size * (1 + 0.16 * root.bond);
        height: self.width;
        x: (root.size - self.width) / 2;
        y: (root.size - self.height) / 2;
        border-radius: root.rond ? self.width / 2 : 4px;
        border-width: 1.5px;
        border-color: root.shown-done ? root.plein
            : !root.rond ? root.tint
            : touch.has-hover ? Tokens.text-secondary
            : root.late ? Tokens.error : Tokens.text-faint;
        background: root.shown-done ? root.plein : touch.has-hover && root.rond ? Tokens.surface-hover : transparent;
        animate background, border-color { duration: Tokens.quick; }
    }

    // Pointed at, the tick it would make, in grey.
    if !root.shown-done && touch.has-hover && root.rond: Icon {
        data: Icons.check;
        size: root.size * 0.62;
        weight: 3.0;
        tint: Tokens.text-secondary;
    }
    // Ticked: drawn from the left, as a pen would.
    Rectangle {
        x: 0;
        y: 0;
        width: root.size * root.trace;
        height: root.size;
        clip: true;
        Icon {
            x: (root.size - self.width) / 2;
            y: (root.size - self.height) / 2;
            data: Icons.check;
            size: root.size * 0.62;
            weight: 3.0;
            tint: white;
        }
    }

    retombe := Timer {
        interval: 110ms;
        running: false;
        triggered => {
            self.running = false;
            root.bond = 0;
        }
    }
    dit := Timer {
        interval: 300ms;
        running: false;
        triggered => {
            self.running = false;
            root.en-cours = false;
            root.toggled();
        }
    }

    touch := TouchArea {
        enabled: root.interactive;
        mouse-cursor: pointer;
        clicked => {
            if (!root.animated) {
                root.toggled();
                return;
            }
            if (root.done || root.en-cours) {
                // Unticking needs no show; a second click while it is drawn is the
                // same click.
                if (!root.en-cours) {
                    root.toggled();
                }
                return;
            }
            root.en-cours = true;
            root.bond = 1;
            retombe.running = true;
            dit.running = true;
        }
    }
}

/// On or off, for a setting.
export component Toggle inherits Rectangle {
    in-out property <bool> on;
    in property <string> label;
    callback toggled();

    // The Mac's switch: green when on, a white knob with a small shadow.
    width: 38px;
    height: 22px;
    border-radius: 11px;
    background: root.on ? Tokens.green : Tokens.text.transparentize(0.86);
    animate background { duration: Tokens.quick; }

    accessible-role: switch;
    accessible-label: root.label;
    accessible-checked: root.on;
    accessible-action-default => { root.on = !root.on; root.toggled(); }

    Rectangle {
        x: root.on ? 18px : 2px;
        y: 2px;
        width: 18px;
        height: 18px;
        border-radius: 9px;
        background: #ffffff;
        drop-shadow-blur: 2px;
        drop-shadow-offset-y: 1px;
        drop-shadow-color: #00000033;
        animate x { duration: Tokens.quick; easing: cubic-bezier(0.2, 0, 0, 1); }
    }

    TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.on = !root.on;
            root.toggled();
        }
    }
}

/// A priority, told by a small coloured tag rather than by the colour of anything else.
export global Priority {
    public pure function tint(p: int) -> color {
        return p == 3 ? Tokens.error : p == 2 ? Tokens.warning : #5b8def;
    }
    public pure function name(p: int) -> string {
        return p == 3 ? "High" : p == 2 ? "Medium" : p == 1 ? "Low" : "";
    }
}

/// A short word on a plate of its colour.
export component Tag inherits Rectangle {
    in property <string> text;
    in property <color> tint: Tokens.text-secondary;

    width: nom.preferred-width + 14px;
    height: 18px;
    border-radius: 4px;
    background: root.tint.transparentize(0.86);

    nom := Text {
        text: root.text;
        font-size: 10px;
        font-weight: 600;
        color: root.tint;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

/// "High", "Medium", "Low", in their colour.
export component PriorityTag inherits Tag {
    in property <int> priority;
    text: Priority.name(root.priority);
    tint: Priority.tint(root.priority);
}
