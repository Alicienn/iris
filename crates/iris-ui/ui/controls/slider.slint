import { Tokens } from "@iris/theme/tokens.slint";

/// A level from 0 to 1 along a track: the sound's volume. The root stays bare (no
/// animation, shadow or opacity on it): the knob's shadow is on a child.
export component Slider inherits Rectangle {
    in property <float> value;
    in property <string> label;
    callback moved(float);

    height: 24px;
    horizontal-stretch: 1;
    accessible-role: slider;
    accessible-label: root.label;
    accessible-value: "\{round(root.value * 100)} %";
    accessible-value-minimum: 0;
    accessible-value-maximum: 100;
    accessible-value-step: 5;
    accessible-action-increment => { root.moved(min(1, root.value + 0.05)); }
    accessible-action-decrement => { root.moved(max(0, root.value - 0.05)); }

    property <length> knob: (root.width - 16px) * root.value;

    Rectangle {
        y: (parent.height - self.height) / 2;
        height: 4px;
        border-radius: 2px;
        background: Tokens.border-strong;
    }
    Rectangle {
        x: 0px;
        y: (parent.height - self.height) / 2;
        width: root.knob + 8px;
        height: 4px;
        border-radius: 2px;
        background: Tokens.accent;
    }
    // White in every theme, as the text size's knob.
    Rectangle {
        x: root.knob;
        y: (parent.height - self.height) / 2;
        width: 16px;
        height: 16px;
        border-radius: 8px;
        background: white;
        drop-shadow-blur: 3px;
        drop-shadow-offset-y: 1px;
        drop-shadow-color: #00000044;
    }
    zone := TouchArea {
        mouse-cursor: pointer;
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down) {
                root.moved(max(0, min(1, (self.mouse-x - 8px) / max(1px, root.width - 16px))));
            }
        }
        moved => {
            if (self.pressed) {
                root.moved(max(0, min(1, (self.mouse-x - 8px) / max(1px, root.width - 16px))));
            }
        }
    }
}
