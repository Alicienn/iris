import { Tokens } from "@iris/theme/tokens.slint";
import { Icon, Icons } from "@iris/base/icons.slint";

// The pieces screens are built from.
//
// One button, one check, one header, drawn once with their hover and pressed states.
// Screens that each drew their own drifted apart in size, radius and colour, and the
// drift is what makes an interface look assembled rather than designed.

/// A priority, told by a small coloured tag rather than by the colour of anything else.
export global Priority {
    public pure function tint(p: int) -> color {
        return p == 3 ? Tokens.error : p == 2 ? Tokens.warning : #5b8def;
    }
    public pure function name(p: int) -> string {
        return p == 3 ? "High" : p == 2 ? "Medium" : p == 1 ? "Low" : "";
    }
}

export enum ButtonKind {
    /// The one thing to do here: filled with the accent.
    primary,
    /// A plate and a border.
    secondary,
    /// Words only, until the pointer comes.
    ghost,
}

/// A button with words, and an icon if it helps.
export component Button inherits Rectangle {
    in property <string> text;
    in property <string> icon;
    in property <ButtonKind> kind: ButtonKind.secondary;
    in property <bool> enabled: true;
    /// Turning, for a button whose work is under way.
    in property <bool> busy;
    callback clicked();

    property <bool> plein: root.kind == ButtonKind.primary;
    property <color> encre: root.plein ? Tokens.accent-text : Tokens.text;

    height: 32px;
    width: rang.preferred-width + 28px;
    border-radius: Tokens.radius-medium;
    border-width: root.kind == ButtonKind.secondary ? 1px : 0px;
    border-color: touch.has-hover ? Tokens.border-strong : Tokens.border;
    background: root.plein
        ? (touch.pressed ? Tokens.accent.darker(0.18) : touch.has-hover ? Tokens.accent.darker(0.07) : Tokens.accent)
        : (touch.pressed ? Tokens.surface-active : touch.has-hover ? Tokens.surface-hover
            : root.kind == ButtonKind.secondary ? Tokens.surface : transparent);
    opacity: root.enabled ? 1.0 : 0.5;
    animate background, border-color { duration: Tokens.instant; }

    accessible-role: button;
    accessible-label: root.text;
    accessible-enabled: root.enabled;
    accessible-action-default => { if (root.enabled) { root.clicked(); } }

    rang := HorizontalLayout {
        x: 14px;
        spacing: 8px;
        if root.icon != "": Icon {
            y: (parent.height - self.height) / 2;
            data: root.icon;
            size: 14px;
            weight: 2.0;
            tint: root.encre;
            // Busy: the icon dims, and the words say what is under way. Nothing
            // loops: an animation that never stops keeps the processor awake.
            alpha: root.busy ? 0.45 : 1.0;
        }
        Text {
            text: root.text;
            font-size: Tokens.size-body;
            font-weight: 600;
            color: root.encre;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

/// "Open ›": the way from a summary to the place it summarises.
export component OpenLink inherits Rectangle {
    in property <string> text: "Open";
    in property <string> label;
    callback clicked();

    width: rang.preferred-width + 12px;
    height: 24px;
    border-radius: Tokens.radius-small;
    background: touch.has-hover ? Tokens.surface-hover : transparent;
    animate background { duration: Tokens.instant; }

    accessible-role: button;
    accessible-label: root.label != "" ? root.label : root.text;
    accessible-action-default => { root.clicked(); }

    rang := HorizontalLayout {
        x: 6px;
        width: self.preferred-width;
        spacing: 3px;
        Text {
            text: root.text;
            font-size: 12px;
            color: touch.has-hover ? Tokens.text : Tokens.text-secondary;
            vertical-alignment: center;
        }
        Icon {
            y: (parent.height - self.height) / 2;
            data: Icons.chevron-right;
            size: 12px;
            weight: 2.2;
            tint: touch.has-hover ? Tokens.text : Tokens.text-secondary;
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

/// The title of a column: its name, a count in a quieter voice, and its way out.
export component ColumnHeader inherits HorizontalLayout {
    in property <string> title;
    in property <string> count;
    in property <string> link-label;
    callback open();

    height: 28px;
    padding-left: 10px;
    padding-right: 4px;
    spacing: 8px;

    Text {
        text: root.title;
        font-size: 14px;
        font-weight: 600;
        color: Tokens.text;
        vertical-alignment: center;
    }
    Text {
        text: root.count;
        font-size: 12px;
        color: Tokens.text-muted;
        vertical-alignment: center;
        horizontal-stretch: 1;
    }
    OpenLink {
        y: (parent.height - self.height) / 2;
        label: root.link-label;
        clicked => { root.open(); }
    }
}

/// The round box of a task. Red-rimmed when it is late.
export component CheckCircle inherits Rectangle {
    in property <bool> done;
    in property <bool> overdue;
    in property <string> label;
    in property <length> size: 18px;
    callback toggled();

    width: root.size;
    height: root.size;
    border-radius: root.size / 2;
    border-width: 1.5px;
    border-color: root.done ? Tokens.success
        : touch.has-hover ? Tokens.text-secondary
        : root.overdue ? Tokens.error : Tokens.text-muted;
    background: root.done ? Tokens.success : touch.has-hover ? Tokens.surface-hover : transparent;
    animate background, border-color { duration: Tokens.quick; }

    accessible-role: checkbox;
    accessible-label: root.label;
    accessible-checked: root.done;
    accessible-action-default => { root.toggled(); }

    if root.done || touch.has-hover: Icon {
        data: Icons.check;
        size: root.size * 0.62;
        weight: 3.0;
        tint: root.done ? white : Tokens.text-secondary;
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.toggled(); }
    }
}

/// A person, as their initials on a disc of their own colour.
export component Avatar inherits Rectangle {
    in property <string> initials;
    in property <color> tint;
    in property <length> size: 30px;

    width: root.size;
    height: root.size;
    border-radius: root.size / 2;
    background: root.tint.transparentize(0.82);

    Text {
        text: root.initials;
        font-size: root.size * 0.36;
        font-weight: 600;
        color: root.tint;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

/// "High", "Medium", "Low", in their colour.
export component PriorityTag inherits Rectangle {
    in property <int> priority;

    width: nom.preferred-width + 12px;
    height: 16px;
    border-radius: 4px;
    background: Priority.tint(root.priority).transparentize(0.82);

    nom := Text {
        text: Priority.name(root.priority);
        font-size: 10px;
        font-weight: 600;
        color: Priority.tint(root.priority);
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

/// A small title over the lines that follow: "Next", "Later this week".
export component SubTitle inherits Text {
    font-size: 12px;
    color: Tokens.text-muted;
    vertical-alignment: bottom;
    height: 30px;
}
