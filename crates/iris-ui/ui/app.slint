    callback account-menu-aliases();
    in-out property <bool> alias-open;
    in property <string> alias-account;
    in property <[AliasData]> alias-rows;
    in property <string> alias-error;
    in-out property <string> alias-new-address;
    in-out property <string> alias-new-name;
    callback alias-added();
    callback alias-removed(int);
    in property <string> signature-account;
    in-out property <string> signature-text;
    callback signature-saved();
    callback account-menu-pin();
    callback account-menu-enable();
    callback account-menu-remove();
    callback account-menu-dismissed();
    callback unified-selected();
    callback scrolled-near-end();
    callback command-invoked(string);
    callback key-pressed(string);
    callback load-images();
    callback toggle-message(int);
    /// Annuler et rétablir, aux touches que tout le monde connaît.
    callback undo();
    callback redo();
    callback save-attachment(int);
    callback open-attachment(int);
    /// The invitation a message carries (its id): into the calendar, by UID.
    callback invite-accept(int);
    /// The event of an invitation, in the calendar: its key and its day.
    callback invite-open(string, string);
    /// An invitation answered: the message's id, and 0 Accept, 1 Maybe, 2 Decline.
    callback invite-answer(int, int);
    /// Leave the mailing list the message (its id) came from.
    callback unsubscribe(int);
    /// A tile of a message body, (message id, tile index), came near the screen or left it.
    callback body-tile-wanted(int, int);
    callback body-tile-released(int, int);
    /// Words chosen with the mouse in a body painted by the full engine: (message,
    /// tile, fractions across and down it, 0 pressed / 1 dragged).
    callback body-select(int, int, float, float, int);
    /// A click that selected nothing in such a body, and whether a link is under the
    /// pointer there: (message, tile, fractions across and down it).
    callback body-link(int, int, float, float);
    callback body-link-at(int, int, float, float) -> bool;
    /// A link clicked in a message shown as text: its target, as the message wrote it.
    callback message-link(string);
    /// Ctrl+C with the shortcuts: what is selected in a message goes to the clipboard.
    callback copy-requested();
    /// A right-click in a body painted by the full engine: (message, tile, fractions
    /// across and down it, the point in the window). Rust opens the link menu.
    callback body-menu(int, int, float, float, length, length);
    /// The link of the words of a text body under the pointer, and those words: what
    /// a right-click there acts on (main.rs). Empty when there is none.
    in-out property <string> hovered-link;
    in-out property <string> hovered-link-text;
    /// The menu a right-click in a message opens (see `LinkMenu`), filled by Rust.
    in-out property <bool> link-menu-open;
    in-out property <string> link-menu-kind;
    in-out property <string> link-menu-target;
    in-out property <string> link-menu-text;
    in-out property <bool> link-menu-selection;
    in-out property <length> link-menu-x;
    in-out property <length> link-menu-y;
    /// The message whose body the menu was opened over, -1 when not over a body:
    /// Copy and Select all are offered then.
    in-out property <int> link-menu-message: -1;
    /// That body is shown as text: its selection is the words' own (`MessageText`),
    /// copied and chosen here rather than by Rust.
    in-out property <bool> link-menu-text-body;
    callback link-menu-chosen(string);
    /// Every word of a message shown as text, to the clipboard: (message id).
    callback copy-message-text(int);
    /// A key to send again, once the shortcuts have the keyboard.
    callback key-redispatch(string);
    /// The width message bodies are shown at, as the reader reports it.
    callback reader-width(length);

    // --- The calendar ---
    /// Which workspace fills the window: 0 mail, 1 calendar, 2 tasks.
    /// 0 mail, 1 calendar, 2 tasks, 3 Home.
    in-out property <int> workspace <=> Chrome.workspace;
    /// What is open over the place in a narrow window, where each opening is a page of
    /// its own: `thread:4`, `compose`, `task:9`, `settings`… Empty for the place
    /// itself. A screen that opens one reports it with `navigated("page", …)`.
    in-out property <string> page;
    callback workspace-changed(int);

    // --- Home ---
    in property <string> home-greeting;
    in property <string> home-date;
    in property <string> home-summary;
    /// The one thing next, alone in the list; empty when nothing is coming.
    in property <[HomeItemData]> home-next;
    in property <string> home-mail-count;
    in property <string> home-events-count;
    in property <string> home-tasks-count;
    /// The widgets: the events after the next, today's first tasks and how many more,
    /// the first conversations to answer (sender, subject, initials, mailbox colour)
    /// and how many in all, how many wait for an answer, a goal, the week.
    /// Every mailbox, unfiltered and unfolded, for Home's side column.
    in property <[AccountRowData]> home-accounts;
    in property <[HomeItemData]> home-later;
    in property <[HomeItemData]> home-tasks;
    in property <int> home-tasks-more;
    in property <[HomeItemData]> home-threads;
    in property <int> home-answer-total;
    in property <int> home-waiting;
    in property <GoalData> home-goal;
    in property <bool> home-has-goal;
    in property <int> home-week-done;
    in property <[float]> home-week-bars;
    in property <int> home-week-today;
    /// Today's habits: a disc each, how many are done ("2 of 4"), the longest streak.
    in property <[HabitData]> home-habits;
    in property <string> home-habits-figure;
    in property <string> home-habits-foot;
    callback home-habit-toggled(int);
    /// A way out: "mail", "tasks", "calendar", "goals", "habits".
    callback home-open(string);
    callback home-thread-opened(int);
    callback home-goal-opened(int);
    callback home-task-opened(int);
    callback home-task-toggled(int);
    callback home-event-opened(string);

    // --- Back and forward, between the places visited ---
    in-out property <bool> can-go-back <=> Chrome.can-go-back;
    in-out property <bool> can-go-forward <=> Chrome.can-go-forward;
    callback nav-back();
    callback nav-forward();
    /// A place chosen in the interface: what it is ("account", "tag", "folder", "tab",
    /// "tasks", "calendar-mode"…) and which one. The history keeps it.
    callback navigated(string, string);
    in property <string> calendar-title;
    in property <int> calendar-mode;
    in property <[CalendarData]> calendars;
    in property <string> calendar-mini-title;
