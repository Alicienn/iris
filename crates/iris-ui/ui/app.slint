    callback calendar-quick-event(string, int, string);
    /// Today's tasks without a time, to drag onto the week.
    in property <[PlanTaskData]> calendar-to-plan;
    /// Right-click on an event: Rust makes it the chosen one and opens its menu there.
    callback calendar-event-menu(string, length, length);
    in-out property <bool> event-menu-open;
    in-out property <length> event-menu-x;
    in-out property <length> event-menu-y;
    /// A colour of its own for the chosen event, from the palette; -1: its calendar's.
    callback event-color-chosen(int);
    /// Ctrl+Z in the calendar: the last change made there, undone.
    callback calendar-undo();
    /// An event dragged to another time: (key, days later, minutes later).
    callback calendar-event-moved(string, int, int);
    /// An event stretched by its lower edge: (key, minutes added to its end).
    callback calendar-event-resized(string, int);
    /// An event being stretched, before it is let go: the week laid out again with it.
    callback calendar-event-stretching(string, int);
    /// A task let go on the week: (task, day, minute of the day).
    callback calendar-task-planned(int, string, int);
    callback calendar-toggled(int);
    callback calendar-refresh(int);

    // Right click on a calendar: refresh, rename, delete — the last two in panels.
