export { Tokens }

// La palette de commandes.
//
// Une seule entrée pour tout ce que l'application sait faire. C'est ce qui permet à
// l'interface de rester dépouillée : aucune fonction n'a besoin d'un bouton pour
// être atteignable.
component CommandPalette inherits Rectangle {
    in property <[CommandData]> commands;
    in property <int> highlighted;
    in-out property <string> query;

    callback accepted(string);
    callback dismissed();

    background: #00000066;

    TouchArea {
        clicked => { root.dismissed(); }
    }

    Floating {
        x: (parent.width - self.width) / 2;
        y: parent.height * 0.12;
        width: min(560px, parent.width - 80px);
        height: min(420px, parent.height * 0.6);

        VerticalLayout {
            padding: Tokens.space-3;
            spacing: Tokens.space-2;

            input := TextField {
                accessible-label: "Command";
                placeholder-text: "Command, account, search…";
                font-size: Tokens.size-title;
                text <=> root.query;
                accepted => {
                    if (root.commands.length > 0) {
                        root.accepted(root.commands[root.highlighted].id);
                    }
                }
            }

            Rectangle {
                height: 1px;
                background: Tokens.border;
            }

            ListView {
                for command[i] in root.commands: Rectangle {
                    height: 30px;
                    border-radius: Tokens.radius-small;
                    background: i == root.highlighted ? Tokens.surface-active : transparent;

                    HorizontalLayout {
                        padding-left: Tokens.space-2;
                        padding-right: Tokens.space-2;
                        spacing: Tokens.space-2;

                        Text {
                            text: command.label;
                            font-size: Tokens.size-body;
                            color: Tokens.text;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                        Rectangle {}
                        Text {
                            text: command.group;
                            font-size: Tokens.size-small;
                            color: Tokens.text-muted;
                            vertical-alignment: center;
                        }
                        if command.shortcut != "": Rectangle {
                            width: shortcut.preferred-width + Tokens.space-3;
                            height: 18px;
                            y: (parent.height - self.height) / 2;
                            border-radius: Tokens.radius-small;
                            background: Tokens.surface;
                            shortcut := Text {
                                text: command.shortcut;
                                font-size: 10px;
                                color: Tokens.text-secondary;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                                width: 100%;
                                height: 100%;
                            }
                        }
                    }

                    TouchArea {
                        clicked => { root.accepted(command.id); }
                    }
                }
            }
        }
    }
}

// A small word-and-icon button, sized for the status bar.
component StatusButton inherits Rectangle {
    in property <string> text;
    in property <string> icon;
    in property <string> tooltip;
    /// Drawn in the accent: something is waiting for the reader.
    in property <bool> highlighted;

    callback clicked();

    height: 18px;
    width: rang.preferred-width + 12px;
    border-radius: Tokens.radius-small;
    background: root.highlighted
        ? (touch.has-hover ? Tokens.accent.darker(0.1) : Tokens.accent)
        : (touch.has-hover ? Tokens.surface-hover : transparent);
    animate background { duration: Tokens.instant; }

    accessible-role: button;
    accessible-label: root.tooltip != "" ? root.tooltip : root.text;
    accessible-action-default => { root.clicked(); }

    rang := HorizontalLayout {
        x: 6px;
        spacing: 4px;
        Icon {
            y: (parent.height - self.height) / 2;
            data: root.icon;
            size: 11px;
            tint: root.highlighted ? Tokens.accent-text : Tokens.text-muted;
        }
        Text {
            text: root.text;
            font-size: 10px;
            font-weight: root.highlighted ? Tokens.weight-bold : Tokens.weight-body;
            color: root.highlighted ? Tokens.accent-text : Tokens.text-muted;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }

    if root.tooltip != "": Tooltip {
        text: @markdown("\{root.tooltip}");
    }
}

// Bandeau d'état, en bas : synchronisation, erreurs, annulation.
component StatusBar inherits Rectangle {
    in-out property <string> status;
    in property <bool> syncing;
    in property <int> pending-ops;
    in property <string> vitals;
    in property <string> last-sync;
    in property <string> version;
    /// A newer version, when one is published. Empty: up to date, or not yet asked.
    in property <string> update-version;

    callback open-changelog();
    callback open-update();

    height: 22px;

    // Un message d'état a une durée de vie.
    //
    // « Creating the folder on 2 mailbox(es)… » est resté affiché des heures après que
    // l'opération eut réussi. Un message de progression qui ne s'efface jamais finit
    // par décrire quelque chose de faux, et le lecteur apprend à ne plus lire la barre
    // — ce qui coûte le prochain message, celui qui comptait.
    //
    // Dix secondes : le temps de lire une phrase sans la chercher, et pas au-delà.
    // Le compteur repart à chaque nouveau message, sinon le second hériterait de ce
    // qui restait au premier.
    changed status => {
        if (root.status != "") {
            expiration.restart();
        }
    }

    expiration := Timer {
        interval: 10s;
        running: root.status != "";
        triggered() => {
            root.status = "";
        }
    }

    HorizontalLayout {
        padding-left: Tokens.space-3;
        padding-right: Tokens.space-3;
        spacing: Tokens.space-2;

        // La version, toujours là. C'est la première question posée quand quelque
        // chose ne va pas, et la seule réponse qui rende un rapport exploitable.
        Text {
            text: root.version;
            font-size: 10px;
            color: Tokens.text-muted;
            opacity: 0.65;
            vertical-alignment: center;
        }

        Text {
            text: root.status;
            font-size: 10px;
            color: Tokens.text-muted;
            vertical-alignment: center;
            overflow: elide;
        }

        Rectangle {}

        // Les opérations en attente de réconciliation sont annoncées, sans alarmer :
        // l'utilisateur doit savoir que quelque chose reste à transmettre, mais ce
        // n'est pas une erreur.
        if root.pending-ops > 0: Text {
            text: root.pending-ops + " waiting to be sent";
            font-size: 10px;
            color: Tokens.text-muted;
            vertical-alignment: center;
        }

        // What changed, and what could change: both next to the version they concern.
        // The update button exists only while there is something to install — a
        // permanent "Update" that does nothing teaches people to stop looking.
        StatusButton {
            y: (parent.height - self.height) / 2;
            text: "Changelog";
            icon: Icons.list;
            tooltip: "What changed in each version";
            clicked => { root.open-changelog(); }
        }

        if root.update-version != "": StatusButton {
            y: (parent.height - self.height) / 2;
            text: "Update now";
            icon: Icons.download;
            tooltip: "Iris " + root.update-version + " is available";
            highlighted: true;
            clicked => { root.open-update(); }
        }

        // When the servers were last heard from. An application that syncs on its own
        // schedule owes the reader an answer to "is this current", and the only
        // honest one is the time.
        if root.last-sync != "": Text {
            text: root.last-sync;
            font-size: 10px;
            color: Tokens.text-muted;
            vertical-alignment: center;
        }

        // What it is costing. Same reasoning: it works in the background, so it
        // should say what that costs rather than leave it to the task manager.
        if root.vitals != "": Text {
            text: root.vitals;
            font-size: 10px;
            color: Tokens.text-muted;
            vertical-alignment: center;
        }

        if root.syncing: Text {
            text: "Syncing…";
            font-size: 10px;
            color: Tokens.text-secondary;
            vertical-alignment: center;
        }
    }
}

export component AppWindow inherits Window {
    title: "Iris";
    // The system frame is replaced by our own. A dark application under a light
    // system frame reads as two programs stacked on each other, and the seam falls
    // exactly where the eye enters the window.
    no-frame: true;
    preferred-width: 1280px;
    preferred-height: 800px;
    min-width: 720px;
    min-height: 480px;
    background: Tokens.background;

    // La police de toute la fenêtre, en un seul endroit.
    //
    // Elle n'était posée nulle part. Le thème en déclarait une, une poignée d'éléments
    // la demandaient explicitement — les titres, l'expéditeur d'une ligne — et tout le
    // reste de l'application prenait celle que Slint choisit par défaut. Deux polices
    // cohabitaient donc à l'écran sans que personne l'ait décidé, et changer le jeton
    // n'en changeait qu'une.
    //
    // `default-font-family` la donne à tout ce qui n'en demande pas d'autre, c'est-à-
    // dire à presque tout : les déclarations restantes deviennent redondantes plutôt
    // que nécessaires.
    default-font-family: Tokens.font-family;
    default-font-size: Tokens.size-body;
    default-font-weight: Tokens.weight-body;

    // --- Données ---
    in property <[ThreadRowData]> rows;
    in property <[AccountRowData]> pinned-accounts;
    in property <[AccountRowData]> other-accounts;
    in property <MessageData> message;
    /// Le fil entier, du plus ancien au plus récent.
    in property <[MessageData]> messages;
    in property <[CommandData]> commands;
    in property <[int]> counts: [0, 0, 0];
    in property <[string]> count-labels: ["0", "0", "0"];
    in property <[string]> count-fulls: ["0", "0", "0"];

    in property <int> selected-thread: -1;
    in property <int> selected-account: 0;
    in property <int> active-tab: 0;
    in property <int> unified-count;
    in property <string> unified-label;
    in property <string> unified-full;
    in property <bool> account-menu-open;
    in property <string> account-menu-label;
    in property <bool> account-menu-pinned;
    // Enabled unless told otherwise: a menu that offers "Enable" on a working
    // mailbox describes a state the account is not in.
    in property <bool> account-menu-enabled: true;
    in-out property <length> account-menu-x;
    in-out property <length> account-menu-y;
    in property <bool> syncing-all;
    in property <string> sync-progress;
    in-out property <bool> sidebar-collapsed;
    in property <bool> conversation-empty: true;
    in property <bool> window-maximised;
    in property <bool> selected-unread;
    in property <bool> selected-starred;
    in property <bool> loading;
    in property <bool> syncing;
    in property <int> pending-ops;
    in-out property <string> status;
    /// La confirmation qui passe, au-dessus de tout le reste. Vide, il n'y en a pas.
    ///
    /// Elle double la barre d'état pour les quelques faits qu'on ne peut pas se
    /// permettre de manquer — un compte accepté par son serveur, par exemple.
    in-out property <string> toast;
    /// Le numéro de version, affiché en permanence en bas à gauche.
    in property <string> version;
    in property <string> vitals;
    in property <string> last-sync;

    // --- Changelog and updates ---
    in-out property <bool> changelog-open;
    in property <[ChangelogRowData]> changelog;
    /// The newer version on offer. Empty when there is none.
    in property <string> update-version;
    in-out property <bool> update-open;
    in property <[ChangelogRowData]> update-notes;
    in property <bool> update-busy;
    in property <float> update-progress;
    in property <string> update-status;
    in property <string> update-error;
    /// What the last check found, for the settings panel.
    in property <string> update-check-status;
    in property <bool> update-checking;
    callback check-for-updates();
    callback update-confirmed();

    in property <bool> sending;
    in property <int> undo-seconds;

    in-out property <bool> problem-open;
    in property <string> problem-account;
    in property <string> problem-message;
    in property <string> problem-advice;
    in property <bool> problem-needs-password;
    in property <bool> problem-busy;
    in property <string> problem-result;
    in-out property <string> problem-password;

    in-out property <bool> context-menu-open;
    in-out property <length> context-menu-x;
    in-out property <length> context-menu-y;
    /// Le fil sur lequel le menu agit — pas celui qui est ouvert à la lecture.
    ///
    /// Les deux étaient confondus, et c'est pourquoi un clic droit ouvrait le message.
    /// Ce sont deux questions différentes : « lequel je lis » et « lequel je vise ».
    in-out property <int> context-menu-thread;
    in-out property <bool> context-menu-unread;
    in-out property <bool> context-menu-starred;

    in-out property <bool> compose-open;
    in-out property <bool> compose-minimised;
    in-out property <bool> compose-show-cc;
    in property <[string]> compose-senders;
    in property <int> compose-sender-index;
    in property <[string]> compose-attachments;
    in property <bool> compose-sending;
    in property <int> compose-undo-seconds;
    in property <string> compose-error;
    in-out property <string> compose-to;
    in-out property <string> compose-cc;
    in-out property <string> compose-bcc;
    in-out property <string> compose-subject;
    in-out property <string> compose-body;

    in-out property <bool> modules-open;
    in property <[RuleRowData]> rules;
    in property <[PluginRowData]> plugins;
    in property <string> plugin-folder;
    in property <string> simulation;
    in-out property <string> new-rule-name;
    in-out property <string> new-rule-sender;

    in-out property <bool> add-account-open;
    in property <bool> add-account-busy;
    in property <bool> add-account-manual;
    in property <string> add-account-error;
    in property <string> add-account-hint;
    in-out property <string> new-email;
    in-out property <string> new-password;
    in-out property <string> new-imap-host;
    in-out property <string> new-imap-port: "993";
    in-out property <string> new-smtp-host;
    in-out property <string> new-smtp-port: "465";
    in-out property <bool> new-imap-tls: true;
    in-out property <bool> new-smtp-tls: true;

    in-out property <bool> settings-open;
    in property <[ThemeSwatchData]> themes;
    in property <int> active-theme;
    in property <int> density;
    in-out property <bool> reply-marks-waiting: true;
    in-out property <bool> new-message-reopens: true;
    in-out property <bool> follow-up-enabled: true;
    in-out property <int> follow-up-days: 3;
    in-out property <bool> notifications: true;
    in-out property <bool> start-at-login;
    in-out property <bool> handle-mailto;
    in-out property <bool> keep-running: true;
    in property <string> system-note;

    in-out property <bool> palette-open;
    in-out property <string> palette-query;
    in property <int> palette-highlighted;
    in property <bool> searching;
    in property <string> search-summary;
    in property <string> search-explanation;
    in-out property <string> search-query;
    in-out property <string> reply-text;
    in-out property <string> account-filter;

    // --- Événements ---
    callback thread-selected(int);
    callback tab-selected(int);
    callback account-filter-changed(string);
    callback problem-retry();
    callback problem-save-password();
    callback problem-disable();
    callback sync-account(int);
    callback sync-all();
    callback open-settings();
    callback window-minimise();
    callback window-toggle-maximise();
    callback window-close();
    callback window-drag(length, length);
    callback window-drag-started();
    callback thread-archive();
    callback thread-delete();

    // Les mêmes actions, sur un fil nommé plutôt que sur celui qui est ouvert.
    //
    // La barre d'outils agit sur ce qu'on lit ; le menu contextuel agit sur ce qu'on a
    // visé. Confondre les deux obligeait le clic droit à sélectionner d'abord, donc à
    // ouvrir le message pour pouvoir proposer de le jeter.
    callback menu-done(int);
    callback menu-archive(int);
    callback menu-snooze(int, string);
    callback menu-toggle-unread(int);
    callback menu-toggle-star(int);
    callback menu-delete(int);
    callback thread-toggle-unread();
    callback thread-toggle-star();
    callback thread-snooze();
    callback forward-thread();
    callback thread-done();
    callback account-selected(int);
    callback resume-account(int);
    in property <bool> add-account-editing;
    in property <[FolderNodeData]> folders;
    in property <string> selected-folder;
    // Le nom lisible du dossier ouvert, pour la colonne du milieu. Vide dans les
    // files : c'est ce qui décide si on montre les onglets ou un en-tête de dossier.
    in property <string> folder-name;
    in property <int> account-count;
    in property <int> marked-count;
    /// La charge d'un glisser. Opaque ici : construite côté Rust.
    in property <data-transfer> drag-payload;
    in property <string> marked-label;
    // Y a-t-il une icône dans la zone de notification pour faire revenir la fenêtre ?
    // Elle décide de ce que veut dire « fermer ».
    in property <bool> tray-available;
    in property <bool> browser-open;
    in property <bool> browser-loading;
    in property <string> browser-error;
    in property <string> browser-note;
    in property <[CatalogueRowData]> catalogue;
    in-out property <string> catalogue-url;
    in property <bool> plugin-settings-open;
    in property <string> plugin-settings-name;
    in-out property <string> plugin-settings-id;
    in property <string> plugin-settings-error;
    in property <[PluginSettingData]> plugin-settings;
    in property <bool> new-folder-open;
    in property <bool> folder-menu-open;
    in property <string> folder-menu-path;
    in property <bool> folder-menu-permanent;
    in-out property <length> folder-menu-x;
    in-out property <length> folder-menu-y;
    in property <bool> rename-folder-open;
    in property <string> rename-folder-current;
    in property <string> rename-folder-error;
    in-out property <string> rename-folder-name;
    in property <string> new-folder-error;
    in-out property <string> new-folder-name;
    callback folder-selected(string);
    callback folder-cleared();
    callback browser-requested();
    callback browser-refresh();
    callback browser-install(string);
    callback browser-install-folder();
    callback browser-dismissed();
    callback plugin-settings-requested(string);
    callback plugin-setting-changed(string, string);
    callback plugin-settings-dismissed();
    callback new-folder-requested();
    callback folder-dropped(string);
    callback folder-menu-requested(string);
    callback folder-menu-dismissed();
    callback folder-rename-requested();
    callback folder-rename-confirmed();
    callback folder-rename-dismissed();
    callback folder-delete-requested();
    in property <bool> folder-menu-emptyable;
    /// La clé brute — « role:trash » ou un chemin — pas le nom affiché.
    in-out property <string> folder-menu-key;
    callback folder-mark-read-requested();
    callback folder-empty-requested();
    callback new-folder-create();
    callback new-folder-dismissed();
    in property <bool> filter-unread;
    in property <bool> filter-attachments;
    in property <bool> filter-starred;
    callback filter-toggled(string);

    callback row-mark-toggled(int);
    callback row-drag-started(int);
    callback row-mark-extended(int);
    callback bulk-done();
    callback bulk-archive();
    callback bulk-delete();
    callback bulk-read();
    callback bulk-unread();
    callback bulk-select-all();
    callback bulk-clear();
    callback account-menu-requested(int);
    callback account-menu-sync();
    callback account-menu-edit();
    callback account-menu-password();
    callback account-menu-signature();
    in-out property <bool> signature-open;
    in property <string> signature-account;
    in-out property <string> signature-text;
    callback signature-saved();
    callback account-menu-pin();
    callback account-menu-enable();
    callback account-menu-remove();
    callback account-menu-dismissed();
    callback unified-selected();
    callback scrolled-near-end();
    callback command-invoked(string);
    callback key-pressed(string);
    callback send-reply();
    callback cancel-send();
    callback reply-all();
    callback load-images();
    callback toggle-message(int);
    /// Annuler et rétablir, aux touches que tout le monde connaît.
    callback undo();
    callback redo();
    callback save-attachment(int);
    callback open-attachment(int);
    /// A tile of a message body, (message id, tile index), came near the screen or left it.
    callback body-tile-wanted(int, int);
    callback body-tile-released(int, int);
    /// The width message bodies are shown at, as the reader reports it.
    callback reader-width(length);

    // --- The calendar ---
    /// Which workspace fills the window: 0 mail, 1 calendar.
    in-out property <int> workspace;
    callback workspace-changed(int);
    in property <string> calendar-title;
    in property <int> calendar-mode;
    in property <[CalendarData]> calendars;
    in property <string> calendar-mini-title;
    in property <[MonthCellData]> calendar-mini-cells;
    in property <[MonthCellData]> calendar-month-cells;
    in property <[WeekDayData]> calendar-week-days;
    in property <[TimedEventData]> calendar-week-events;
    in property <float> calendar-now-fraction: -1;
    in property <int> calendar-now-day: -1;
    callback calendar-navigate(int);
    callback calendar-today();
    callback calendar-mode-chosen(int);
    callback calendar-day-chosen(string);
    callback calendar-day-opened(string);
    callback calendar-mini-navigate(int);
    callback calendar-event-opened(string);
    callback calendar-new-event(string, int);
    callback calendar-toggled(int);
    callback calendar-refresh(int);
    callback calendar-remove(int);

    in-out property <bool> event-detail-open;
    in property <EventDetailData> event-detail;
    callback event-edit();
    callback event-delete();

    in-out property <bool> event-editor-open;
    in property <bool> editor-is-new;
    in-out property <string> editor-title;
    in-out property <bool> editor-all-day;
    in-out property <string> editor-start-date;
    in-out property <string> editor-start-time;
    in-out property <string> editor-end-date;
    in-out property <string> editor-end-time;
    in-out property <string> editor-location;
    in-out property <string> editor-notes;
    in property <[string]> editor-calendars;
    in-out property <int> editor-calendar-index;
    in property <[string]> editor-reminders;
    in-out property <int> editor-reminder-index;
    in property <[string]> editor-repeats;
    in-out property <int> editor-repeat-index;
    in property <string> editor-error;
    callback event-save();

    in-out property <bool> subscribe-open;
    in-out property <string> subscribe-url;
    in-out property <string> subscribe-name;
    in property <bool> subscribe-busy;
    in property <string> subscribe-error;
    callback subscribe-confirmed();
    /// Hidden in the tray: no body tile asks for pixels.
    in property <bool> bodies-suspended;
    /// Le message tel qu'il est arrivé, en-têtes compris.
    in-out property <bool> source-open;
    in property <string> source-subject;
    in property <string> source-text;
    in property <bool> source-unavailable;
    callback view-source();
    callback palette-query-changed(string);
    callback search-submitted(string);
    callback search-cleared();
    callback theme-chosen(int);
    callback density-chosen(int);
    callback automation-changed();
    callback system-changed();
    callback add-account-discover();
    callback add-account-save();
    callback add-account-manual-requested();
    callback add-account-dismissed();
    callback rule-toggled(string, bool);
    callback rule-simulated(string);
    callback rule-removed(string);
    callback rule-added();
    callback plugins-reloaded();
    callback compose-send();
    callback compose-cancel();
    callback compose-sender-chosen(int);
    callback compose-attach();
    callback compose-attach-image();
    callback compose-remove-attachment(int);
    callback compose-format(string);
    callback compose-dismissed();
    in property <[string]> compose-suggestions;
    callback compose-recipient-typed(string, string);
    callback compose-recipient-picked(string, string);

    // Appelée depuis Rust par Ctrl+F et par la palette : donner le focus est un
    // geste d'interface, il n'a pas à faire l'aller-retour par le vue-modèle.
    public function focus-search() {
        liste.focus-search();
    }

    forward-focus: shortcuts;

    /// A window is open over the rest: the mail behind it is out of reach.
    ///
    /// The shortcuts used to go straight through. With the new-message window open
    /// and no field clicked yet, "e" marked as done the thread displayed behind it.
    property <bool> modal-open: (root.compose-open && !root.compose-minimised)
        || root.settings-open || root.modules-open || root.add-account-open
        || root.problem-open || root.source-open || root.signature-open
        || root.changelog-open || root.update-open || root.browser-open
        || root.rename-folder-open || root.new-folder-open || root.palette-open
        || root.context-menu-open || root.folder-menu-open || root.account-menu-open
        || root.event-detail-open || root.event-editor-open || root.subscribe-open;

    // Closing a window hands the keyboard back to the shortcuts. Otherwise it stays
    // with a field that no longer exists, and the next key goes nowhere.
    changed modal-open => {
        if (!root.modal-open) {
            shortcuts.focus();
        }
    }

    // Toutes les touches passent par Rust : les raccourcis sont des données, pas du
    // code d'interface, et restent donc reconfigurables.
    //
    // **Under** everything else, and that placement is the fix for a whole family of
    // faults. A FocusScope that does not have the focus takes the click that would
    // give it the focus, and keeps it. This one covered the window from above: with a
    // field focused, a click on another field — or on a suggested address — only
    // brought the focus back here, and never reached what it was aimed at. Below,
    // it only receives the clicks nothing else wanted: a click on empty space still
    // returns the keyboard to the shortcuts.
    shortcuts := FocusScope {
        width: 100%;
        height: 100%;
        key-pressed(event) => {
            // Mail and calendar, from anywhere but an open window.
            if (event.modifiers.control && !root.modal-open
                && (event.text == "1" || event.text == "2")) {
                root.workspace = event.text == "1" ? 0 : 1;
                root.workspace-changed(root.workspace);
                return accept;
            }
            if (event.text == "k" && event.modifiers.control
                && (!root.modal-open || root.palette-open)) {
                root.palette-open = !root.palette-open;
                return accept;
            }
            // "c" writes a new message, the convention every mail client shares.
            if (event.text == "c" && !root.modal-open) {
                root.compose-open = true;
                return accept;
            }
            // Escape does not throw away a draft: leaving the window open is
            // recoverable, losing what someone wrote is not.
            if (event.text == Key.Escape && root.problem-open) {
                root.problem-open = false;
                return accept;
            }
            if (event.text == Key.Escape && root.context-menu-open) {
                root.context-menu-open = false;
                return accept;
            }
            if (event.text == Key.Escape && root.compose-open) {
                root.compose-open = false;
                return accept;
            }
            if (event.text == Key.Escape && root.event-editor-open) {
                root.event-editor-open = false;
                return accept;
            }
            if (event.text == Key.Escape && root.event-detail-open) {
                root.event-detail-open = false;
                return accept;
            }
            if (event.text == Key.Escape && root.subscribe-open && !root.subscribe-busy) {
                root.subscribe-open = false;
                return accept;
            }
            if (event.text == Key.Escape && root.changelog-open) {
                root.changelog-open = false;
                return accept;
            }
            // Not while installing: the choice is made, and the panel is the only
            // thing saying what is happening.
            if (event.text == Key.Escape && root.update-open && !root.update-busy) {
                root.update-open = false;
                return accept;
            }
            if (event.text == Key.Escape && root.source-open) {
                root.source-open = false;
                return accept;
            }
            if (event.text == Key.Escape && root.modules-open) {
                root.modules-open = false;
                return accept;
            }
            if (event.text == Key.Escape && root.add-account-open) {
                root.add-account-open = false;
                return accept;
            }
            if (event.text == Key.Escape && root.settings-open) {
                root.settings-open = false;
                return accept;
            }
            if (event.text == Key.Escape && root.palette-open) {
                root.palette-open = false;
                return accept;
            }
            // Nothing below this line reaches past an open window: Escape, handled
            // above, is the only key that concerns it.
            if (root.modal-open) {
                return accept;
            }
            // The calendar has its own keys, and none of the mail's: "e" in the
            // calendar must not mark as done a thread nobody can see.
            if (root.workspace == 1) {
                if (event.text == "t") { root.calendar-today(); }
                if (event.text == "n") { root.calendar-new-event("", -1); }
                if (event.text == "m") { root.calendar-mode-chosen(0); }
                if (event.text == "w") { root.calendar-mode-chosen(1); }
                if (event.text == "d") { root.calendar-mode-chosen(2); }
                if (event.text == Key.LeftArrow) { root.calendar-navigate(-1); }
                if (event.text == Key.RightArrow) { root.calendar-navigate(1); }
                return accept;
            }
            if (event.text == "f" && event.modifiers.control) {
                root.focus-search();
                return accept;
            }
            // Échap quitte la recherche avant tout le reste : c'est le geste de
            // sortie universel, et il doit marcher sans viser un bouton.
            if (event.text == Key.Escape && root.searching) {
                root.search-query = "";
                root.search-cleared();
                return accept;
            }

            // Échap vide la sélection avant tout le reste des files : c'est le geste
            // de sortie d'un mode, et un lot coché est un mode.
            if (event.text == Key.Escape && root.marked-count > 0) {
                root.bulk-clear();
                return accept;
            }

            // Suppr supprime. C'était « # », choisi parce qu'une lettre nue est trop
            // facile à heurter — mais Suppr n'est pas une lettre, personne ne
            // l'atteint par accident, et c'est la touche que tout le monde essaie en
            // premier. « # » reste, pour qui l'a appris.
            if (event.text == Key.Delete) {
                root.bulk-delete();
                return accept;
            }

            // Annuler et rétablir, aux touches de partout. Le clavier les envoie avant
            // que la table de raccourcis ne les voie, parce que ce sont des
            // combinaisons et que la table ne connaît que des touches nues.
            if (event.text == "z" && event.modifiers.control && event.modifiers.shift) {
                root.redo();
                return accept;
            }
            if (event.text == "Z" && event.modifiers.control) {
                root.redo();
                return accept;
            }
            if (event.text == "z" && event.modifiers.control) {
                root.undo();
                return accept;
            }
            if (event.text == "y" && event.modifiers.control) {
                root.redo();
                return accept;
            }

            root.key-pressed(event.text);
            return accept;
        }
    }

    Backdrop {
        width: 100%;
        height: 100%;

        // Removing the system frame removes the outline it drew. Without one, a dark
        // window on a dark desktop has no boundary at all — it looks like a hole
        // rather than a window.
        Rectangle {
            width: 100%;
            height: 100%;
            border-width: 1px;
            border-color: Tokens.border-strong;
            background: transparent;
        }

        VerticalLayout {
            TitleBar {
                title: "Iris";
                maximised: root.window-maximised;
                workspace: root.workspace;
                workspace-chosen(i) => {
                    root.workspace = i;
                    root.workspace-changed(i);
                    shortcuts.focus();
                }
                minimise => { root.window-minimise(); }
                toggle-maximise => { root.window-toggle-maximise(); }
                close => { root.window-close(); }
                drag(dx, dy) => { root.window-drag(dx, dy); }
                drag-started => { root.window-drag-started(); }
            }

            HorizontalLayout {
                // Colonne 1 : les comptes.
                Sidebar {
                    width: root.sidebar-collapsed ? 44px : 200px;
                    animate width { duration: Tokens.quick; easing: ease-in-out; }
                    pinned: root.pinned-accounts;
                    others: root.other-accounts;
                    selected-id: root.selected-account;
                    unified-count: root.unified-count;
                    unified-label: root.unified-label;
                    unified-full: root.unified-full;
                    filter <=> root.account-filter;
                    syncing: root.syncing-all;
                    sync-progress: root.sync-progress;
                    collapsed <=> root.sidebar-collapsed;
                    account-selected(id) => { root.account-selected(id); shortcuts.focus(); }
                    unified-selected => { root.unified-selected(); shortcuts.focus(); }
                    resume-account(id) => { root.resume-account(id); }
                    add-account => { root.add-account-open = true; }
                    filter-changed(t) => { root.account-filter-changed(t); }
                    sync-account(id) => { root.sync-account(id); }
                    sync-all => { root.sync-all(); }
                    open-settings => { root.settings-open = true; }
                    open-modules => { root.modules-open = true; }
                    open-plugin-browser => { root.browser-requested(); }
                    account-menu(id, mx, my) => {
                        root.account-menu-x = mx;
                        root.account-menu-y = my;
                        root.account-menu-requested(id);
                    }
                }

                Rectangle { width: 1px; background: Tokens.border; }

                // Colonne 1 bis : les dossiers.
                //
                // Une colonne à eux plutôt qu'une section de plus dans la barre des
                // comptes : les deux se croisent — « ce compte-là, dans ce
                // dossier-là » — et une liste où l'on choisit tantôt l'un tantôt
                // l'autre ne montre jamais les deux choix en même temps.
                // La colonne des dossiers ne se replie pas avec celle des comptes.
                // Le bouton dit « Collapse the accounts » : il repliait les deux, donc
                // il faisait une chose de plus que ce qu'il annonçait, et la seule
                // façon de garder les dossiers était de garder aussi les comptes.
                Glass {
                    width: 170px;
                    radius: 0px;
                    border-width: 0px;

                    VerticalLayout {
                        padding: Tokens.space-2;
                        spacing: Tokens.space-2;

                        // Écrire un message.
                        //
                        // L'éditeur existait en entier — destinataires, copie, copie
                        // cachée, pièces jointes, mise en forme — et rien à l'écran n'y
                        // menait : la touche « c » et la palette, c'est-à-dire deux
                        // choses qu'il faut déjà savoir. Une fonction qu'on ne peut
                        // atteindre qu'en connaissant son raccourci est une fonction
                        // qui n'existe pas pour celui qui ouvre l'application.
                        //
                        // En haut de la colonne, au-dessus des dossiers, là où tout
                        // client de courrier le met : c'est le seul bouton de cette
                        // fenêtre qui crée quelque chose au lieu d'agir sur ce qui est
                        // déjà là, et il mérite d'être le premier qu'on voie.
                        Rectangle {
                            height: 30px;
                            border-radius: Tokens.radius-small;
                            background: ecrire-touch.has-hover
                                ? Tokens.accent
                                : Tokens.accent.transparentize(0.12);
                            animate background { duration: Tokens.instant; }

                            accessible-role: button;
                            accessible-label: "Write a new message";
                            accessible-description: "C";
                            accessible-action-default => { root.compose-open = true; }

                            HorizontalLayout {
                                alignment: center;
                                spacing: Tokens.space-1;

                                Icon {
                                    y: (parent.height - self.height) / 2;
                                    data: Icons.pencil;
                                    size: 13px;
                                    tint: Tokens.accent-text;
                                }
                                Text {
                                    text: "New message";
                                    font-size: Tokens.size-small;
                                    font-weight: Tokens.weight-bold;
                                    color: Tokens.accent-text;
                                    vertical-alignment: center;
                                }
                            }

                            ecrire-touch := TouchArea {
                                clicked => { root.compose-open = true; }
                            }
                        }

                        FolderTree {
                            folders: root.folders;
                            selected-path: root.selected-folder;
                            accounts-total: root.account-count;
                            folder-selected(p) => { root.folder-selected(p); shortcuts.focus(); }
                            all-selected => { root.folder-cleared(); }
                            new-folder => { root.new-folder-requested(); }
                            folder-dropped(p) => { root.folder-dropped(p); }
                            folder-menu(p, mx, my) => {
                                root.folder-menu-x = mx;
                                root.folder-menu-y = my;
                                root.folder-menu-requested(p);
                            }
                        }
                    }
                }

                Rectangle {
                    width: 1px;
                    background: Tokens.border;
                }

                // Colonne 2 : la file de travail.
                Glass {
                    width: 340px;
                    radius: 0px;
                    border-width: 0px;

                    liste := ThreadListView {
                        width: 100%;
                        height: 100%;
                        rows: root.rows;
                        searching: root.searching;
                        search-summary: root.search-summary;
                        search-explanation: root.search-explanation;
                        search-query <=> root.search-query;
                        search-submitted(q) => { root.search-submitted(q); }
                        search-cleared => { root.search-cleared(); }
                        row-context-menu(id, mx, my, non-lu, epingle) => {
                            // Plus de `thread-selected` : un clic droit ouvrait le
                            // message, chargeait son corps et le marquait lu, pour
                            // quelqu'un qui voulait seulement voir les actions
                            // possibles — dont « Delete ». Le menu porte sa cible.
                            root.context-menu-thread = id;
                            root.context-menu-unread = non-lu;
                            root.context-menu-starred = epingle;
                            // Déjà en coordonnées de fenêtre. Rien à rajouter : la
                            // version précédente recollait des largeurs de colonnes
                            // écrites en dur, qui devenaient fausses à la première
                            // colonne ajoutée — et il y en a une de plus depuis.
                            root.context-menu-x = mx;
                            root.context-menu-y = my;
                            root.context-menu-open = true;
                        }
                        selected-id: root.selected-thread;
                        active-tab: root.active-tab;
                        counts: root.counts;
                        count-labels: root.count-labels;
                        count-fulls: root.count-fulls;
                        folder-name: root.folder-name;
                        folder-left => { root.folder-cleared(); }
                        marked-count: root.marked-count;
                        drag-payload: root.drag-payload;
                        marked-label: root.marked-label;
                        filter-unread: root.filter-unread;
                        filter-attachments: root.filter-attachments;
                        filter-starred: root.filter-starred;
                        filter-toggled(quoi) => { root.filter-toggled(quoi); }
                        row-mark-toggled(id) => { root.row-mark-toggled(id); }
                        row-drag-started(id) => { root.row-drag-started(id); }
                        row-mark-extended(id) => { root.row-mark-extended(id); }
                        bulk-done => { root.bulk-done(); }
                        bulk-archive => { root.bulk-archive(); }
                        bulk-delete => { root.bulk-delete(); }
                        bulk-read => { root.bulk-read(); }
                        bulk-unread => { root.bulk-unread(); }
                        bulk-select-all => { root.bulk-select-all(); }
                        bulk-clear => { root.bulk-clear(); }
                        loading: root.loading;
                        // Picking a thread with the mouse hands the keyboard to the
                        // shortcuts, so « e » acts on it even after a search field had it.
                        row-clicked(id) => { root.thread-selected(id); shortcuts.focus(); }
                        tab-selected(i) => { root.tab-selected(i); shortcuts.focus(); }
                        scrolled-near-end => { root.scrolled-near-end(); }
                    }
                }

                Rectangle { width: 1px; background: Tokens.border; }

                // Colonne 3 : la conversation.
                ConversationView {
                    body-width-changed(w) => { root.reader-width(w); }
                    message: root.message;
                    messages: root.messages;
                    toggle-message(id) => { root.toggle-message(id); }
                    empty: root.conversation-empty;
                    unread: root.selected-unread;
                    starred: root.selected-starred;
                    archive => { root.thread-archive(); }
                    delete-thread => { root.thread-delete(); }
                    toggle-unread => { root.thread-toggle-unread(); }
                    toggle-star => { root.thread-toggle-star(); }
                    snooze => { root.thread-snooze(); }
                    forward-thread => { root.forward-thread(); }
                    mark-done => { root.thread-done(); }
                    reply-text <=> root.reply-text;
                    sending: root.sending;
                    undo-seconds: root.undo-seconds;
                    send => { root.send-reply(); }
                    cancel-send => { root.cancel-send(); }
                    reply-all => { root.reply-all(); }
                    load-images => { root.load-images(); }
                    save-attachment(i) => { root.save-attachment(i); }
                    open-attachment(i) => { root.open-attachment(i); }
                    body-tile-wanted(m, t) => { root.body-tile-wanted(m, t); }
                    body-tile-released(m, t) => { root.body-tile-released(m, t); }
                    bodies-suspended: root.bodies-suspended;
                }
            }

            Rectangle { height: 1px; background: Tokens.border; }

            StatusBar {
                status <=> root.status;
                version: root.version;
                vitals: root.vitals;
                last-sync: root.last-sync;
                syncing: root.syncing;
                pending-ops: root.pending-ops;
                update-version: root.update-version;
                open-changelog => { root.changelog-open = true; }
                open-update => { root.update-open = true; }
            }
        }
    }

    // The calendar covers everything between the title bar and the status bar. Over
    // the mail rather than instead of it: coming back to the mail finds it exactly as
    // it was left - same list, same scroll, same open thread.
    if root.workspace == 1: CalendarView {
        x: 1px;
        y: 32px;
        width: parent.width - 2px;
        height: parent.height - 32px - 23px;
        title: root.calendar-title;
        mode: root.calendar-mode;
        calendars: root.calendars;
        mini-title: root.calendar-mini-title;
        mini-cells: root.calendar-mini-cells;
        month-cells: root.calendar-month-cells;
        week-days: root.calendar-week-days;
        week-events: root.calendar-week-events;
        now-fraction: root.calendar-now-fraction;
        now-day: root.calendar-now-day;
        navigate(n) => { root.calendar-navigate(n); }
        today => { root.calendar-today(); }
        mode-chosen(m) => { root.calendar-mode-chosen(m); }
        day-chosen(d) => { root.calendar-day-chosen(d); }
        day-opened(d) => { root.calendar-day-opened(d); }
        mini-navigate(n) => { root.calendar-mini-navigate(n); }
        event-opened(k) => { root.calendar-event-opened(k); }
        new-event(d, m) => { root.calendar-new-event(d, m); }
        calendar-toggled(id) => { root.calendar-toggled(id); }
        calendar-refresh(id) => { root.calendar-refresh(id); }
        calendar-remove(id) => { root.calendar-remove(id); }
        subscribe-requested => {
            root.subscribe-url = "";
            root.subscribe-name = "";
            root.subscribe-open = true;
        }
    }

    if root.event-detail-open: EventDetailPanel {
        width: 100%;
        height: 100%;
        detail: root.event-detail;
        edit => { root.event-edit(); }
        delete => { root.event-delete(); }
        dismissed => { root.event-detail-open = false; }
    }

    if root.event-editor-open: EventEditorPanel {
        width: 100%;
        height: 100%;
        is-new: root.editor-is-new;
        title <=> root.editor-title;
        all-day <=> root.editor-all-day;
        start-date <=> root.editor-start-date;
        start-time <=> root.editor-start-time;
        end-date <=> root.editor-end-date;
        end-time <=> root.editor-end-time;
        location <=> root.editor-location;
        notes <=> root.editor-notes;
        calendars: root.editor-calendars;
        calendar-index <=> root.editor-calendar-index;
        reminders: root.editor-reminders;
        reminder-index <=> root.editor-reminder-index;
        repeats: root.editor-repeats;
        repeat-index <=> root.editor-repeat-index;
        error: root.editor-error;
        save => { root.event-save(); }
        dismissed => { root.event-editor-open = false; }
    }

    if root.subscribe-open: SubscribePanel {
        width: 100%;
        height: 100%;
        url <=> root.subscribe-url;
        name <=> root.subscribe-name;
        busy: root.subscribe-busy;
        error: root.subscribe-error;
        subscribe => { root.subscribe-confirmed(); }
        dismissed => { root.subscribe-open = false; }
    }

    if root.problem-open: AccountProblemPanel {
        width: 100%;
        height: 100%;
        account: root.problem-account;
        message: root.problem-message;
        advice: root.problem-advice;
        needs-password: root.problem-needs-password;
        busy: root.problem-busy;
        result: root.problem-result;
        password <=> root.problem-password;
        retry => { root.problem-retry(); }
        save-password => { root.problem-save-password(); }
        disable-account => { root.problem-disable(); }
        dismissed => { root.problem-open = false; }
    }

    if root.browser-open: PluginBrowser {
        width: 100%;
        height: 100%;
        entries: root.catalogue;
        loading: root.browser-loading;
        error: root.browser-error;
        note: root.browser-note;
        catalogue-url <=> root.catalogue-url;
        refresh => { root.browser-refresh(); }
        install(id) => { root.browser-install(id); }
        install-from-folder => { root.browser-install-folder(); }
        dismissed => { root.browser-dismissed(); }
    }

    if root.folder-menu-open: FolderContextMenu {
        width: 100%;
        height: 100%;
        folder: root.folder-menu-path;
        permanent: root.folder-menu-permanent;
        emptyable: root.folder-menu-emptyable;
        mark-read => { root.folder-mark-read-requested(); }
        empty => { root.folder-empty-requested(); }
        menu-x: root.folder-menu-x;
        menu-y: root.folder-menu-y;
        rename => { root.folder-rename-requested(); }
        remove => { root.folder-delete-requested(); }
        dismissed => { root.folder-menu-dismissed(); }
    }

    if root.rename-folder-open: RenameFolderPanel {
        width: 100%;
        height: 100%;
        current: root.rename-folder-current;
        error: root.rename-folder-error;
        name <=> root.rename-folder-name;
        rename => { root.folder-rename-confirmed(); }
        dismissed => { root.folder-rename-dismissed(); }
    }

    if root.new-folder-open: NewFolderPanel {
        width: 100%;
        height: 100%;
        account-count: root.account-count;
        parent-path: root.selected-folder;
        error: root.new-folder-error;
        name <=> root.new-folder-name;
        create => { root.new-folder-create(); }
        dismissed => { root.new-folder-dismissed(); }
    }

    if root.account-menu-open: AccountContextMenu {
        width: 100%;
        height: 100%;
        account: root.account-menu-label;
        pinned: root.account-menu-pinned;
        enabled: root.account-menu-enabled;
        menu-x: root.account-menu-x;
        menu-y: root.account-menu-y;
        sync-now => { root.account-menu-sync(); }
        edit-account => { root.account-menu-edit(); }
        change-password => { root.account-menu-password(); }
        edit-signature => { root.account-menu-signature(); }
        toggle-pinned => { root.account-menu-pin(); }
        toggle-enabled => { root.account-menu-enable(); }
        remove-account => { root.account-menu-remove(); }
        dismissed => { root.account-menu-dismissed(); }
    }

    if root.context-menu-open: ThreadContextMenu {
        width: 100%;
        height: 100%;
        menu-x: root.context-menu-x;
        menu-y: root.context-menu-y;
        unread: root.context-menu-unread;
        starred: root.context-menu-starred;
        // Chaque action porte sa cible. « Ouvrir » est la seule qui sélectionne, parce
        // que c'est la seule qu'on lui demande de faire.
        open-thread => {
            root.context-menu-open = false;
            root.thread-selected(root.context-menu-thread);
        }
        mark-done => { root.menu-done(root.context-menu-thread); }
        archive => { root.menu-archive(root.context-menu-thread); }
        snooze(quand) => { root.menu-snooze(root.context-menu-thread, quand); }
        toggle-unread => { root.menu-toggle-unread(root.context-menu-thread); }
        toggle-star => { root.menu-toggle-star(root.context-menu-thread); }
        delete-thread => { root.menu-delete(root.context-menu-thread); }
        view-source => { root.view-source(); }
        dismissed => { root.context-menu-open = false; }
        reopen-at(px, py) => { liste.reopen-context-menu-at(px, py); }
    }

    if root.compose-open: ComposePanel {
        width: 100%;
        height: 100%;
        senders: root.compose-senders;
        sender-index: root.compose-sender-index;
        attachments: root.compose-attachments;
        sending: root.compose-sending;
        undo-seconds: root.compose-undo-seconds;
        error: root.compose-error;
        minimised <=> root.compose-minimised;
        show-cc <=> root.compose-show-cc;
        to <=> root.compose-to;
        cc <=> root.compose-cc;
        bcc <=> root.compose-bcc;
        subject <=> root.compose-subject;
        body <=> root.compose-body;
        send => { root.compose-send(); }
        cancel-send => { root.compose-cancel(); }
        sender-chosen(i) => { root.compose-sender-chosen(i); }
        attach => { root.compose-attach(); }
        attach-image => { root.compose-attach-image(); }
        remove-attachment(i) => { root.compose-remove-attachment(i); }
        format(f) => { root.compose-format(f); }
        suggestions: root.compose-suggestions;
        recipient-typed(champ, texte) => { root.compose-recipient-typed(champ, texte); }
        recipient-picked(champ, choix) => { root.compose-recipient-picked(champ, choix); }
        dismissed => { root.compose-dismissed(); root.compose-open = false; }
    }

    if root.source-open: SourcePanel {
        width: 100%;
        height: 100%;
        subject: root.source-subject;
        source: root.source-text;
        unavailable: root.source-unavailable;
        dismissed => { root.source-open = false; }
    }

    if root.signature-open: SignaturePanel {
        width: 100%;
        height: 100%;
        account: root.signature-account;
        signature <=> root.signature-text;
        saved => { root.signature-saved(); root.signature-open = false; }
        dismissed => { root.signature-open = false; }
    }

    if root.modules-open: ModulesPanel {
        width: 100%;
        height: 100%;
        rules: root.rules;
        plugins: root.plugins;
        plugin-folder: root.plugin-folder;
        simulation: root.simulation;
        new-rule-name <=> root.new-rule-name;
        new-rule-sender <=> root.new-rule-sender;
        rule-toggled(id, on) => { root.rule-toggled(id, on); }
        rule-simulated(id) => { root.rule-simulated(id); }
        rule-removed(id) => { root.rule-removed(id); }
        rule-added => { root.rule-added(); }
        plugins-reloaded => { root.plugins-reloaded(); }
        browse-plugins => { root.browser-requested(); }
        configure-plugin(id) => { root.plugin-settings-requested(id); }

        // Les réglages du module, dans cette fenêtre-ci et non dans une seconde
        // par-dessus. Le nom vide veut dire « la liste ».
        settings-plugin: root.plugin-settings-open ? root.plugin-settings-name : "";
        plugin-settings: root.plugin-settings;
        settings-error: root.plugin-settings-error;
        settings-changed(k, v) => { root.plugin-setting-changed(k, v); }
        settings-closed => { root.plugin-settings-dismissed(); }

        dismissed => {
            root.plugin-settings-dismissed();
            root.modules-open = false;
        }
    }

    if root.add-account-open: AccountSetupPanel {
        width: 100%;
        height: 100%;
        editing: root.add-account-editing;
        busy: root.add-account-busy;
        manual: root.add-account-manual;
        error: root.add-account-error;
        hint: root.add-account-hint;
        email <=> root.new-email;
        password <=> root.new-password;
        imap-host <=> root.new-imap-host;
        imap-port <=> root.new-imap-port;
        smtp-host <=> root.new-smtp-host;
        smtp-port <=> root.new-smtp-port;
        imap-tls <=> root.new-imap-tls;
        smtp-tls <=> root.new-smtp-tls;
        discover => { root.add-account-discover(); }
        save-manual => { root.add-account-save(); }
        switch-to-manual => { root.add-account-manual-requested(); }
        dismissed => { root.add-account-dismissed(); }
    }

    if root.settings-open: SettingsPanel {
        width: 100%;
        height: 100%;
        themes: root.themes;
        active-theme: root.active-theme;
        density: root.density;
        reply-marks-waiting <=> root.reply-marks-waiting;
        new-message-reopens <=> root.new-message-reopens;
        follow-up-enabled <=> root.follow-up-enabled;
        follow-up-days <=> root.follow-up-days;
        notifications <=> root.notifications;
        start-at-login <=> root.start-at-login;
        handle-mailto <=> root.handle-mailto;
        keep-running <=> root.keep-running;
        system-note: root.system-note;
        version: root.version;
        update-status: root.update-check-status;
        update-checking: root.update-checking;
        update-version: root.update-version;
        check-for-updates => { root.check-for-updates(); }
        install-update => { root.settings-open = false; root.update-open = true; }
        system-changed => { root.system-changed(); }
        theme-chosen(i) => { root.theme-chosen(i); }
        density-chosen(i) => { root.density-chosen(i); }
        automation-changed => { root.automation-changed(); }
        dismissed => { root.settings-open = false; }
    }

    if root.palette-open: CommandPalette {
        width: 100%;
        height: 100%;
        commands: root.commands;
        highlighted: root.palette-highlighted;
        query <=> root.palette-query;
        accepted(id) => {
            root.palette-open = false;
            root.command-invoked(id);
        }
        dismissed => { root.palette-open = false; }
    }

    if root.changelog-open: ChangelogPanel {
        width: 100%;
        height: 100%;
        rows: root.changelog;
        version: root.version;
        dismissed => { root.changelog-open = false; }
    }

    if root.update-open: UpdatePanel {
        width: 100%;
        height: 100%;
        current: root.version;
        available: "Iris " + root.update-version;
        notes: root.update-notes;
        busy: root.update-busy;
        progress: root.update-progress;
        status: root.update-status;
        error: root.update-error;
        confirmed => { root.update-confirmed(); }
        dismissed => { root.update-open = false; }
    }

    // En dernier : une confirmation recouverte par ce qu'elle confirme ne confirme
    // rien.
    if root.toast != "": Toast {
        width: 100%;
        height: 100%;
        message: root.toast;
        dismissed => { root.toast = ""; }
    }
}
