            until: root.goal.due-short;
            days <=> root.goal-time-days;
            start <=> root.goal-time-start;
            length <=> root.goal-time-length;
            error: root.goal-time-error;
            day-toggled(i) => { root.goal-time-day-toggled(i); }
            confirmed => { root.goal-time-confirmed(); }
            dismissed => { root.goal-time-open = false; }
        }

        if root.goal-delete-open: GoalDeletePanel {
            width: 100%;
            height: 100%;
            name: root.goal.title;
            confirmed => {
                root.goal-delete-open = false;
                root.goal-delete-confirmed();
            }
            dismissed => { root.goal-delete-open = false; }
        }

        if root.habit-new-open: NewHabitPanel {
            width: 100%;
            height: 100%;
            title <=> root.habit-new-title;
            icon <=> root.habit-new-icon;
            hue <=> root.habit-new-color;
            colors: root.habit-colors;
            kind <=> root.habit-new-kind;
            often <=> root.habit-new-often;
            days: root.habit-new-days;
            times <=> root.habit-new-times;
            amount <=> root.habit-new-amount;
            unit <=> root.habit-new-unit;
            goals: root.goal-names;
            goal <=> root.habit-new-goal;
            remind <=> root.habit-new-remind;
            error: root.habit-new-error;
            editing: root.habit-new-editing;
            day-toggled(i) => { root.habit-new-day-toggled(i); }
            confirmed => { root.habit-new-confirmed(); }
            dismissed => { root.habit-new-open = false; }
        }

        if root.habit-delete-open: HabitDeletePanel {
            width: 100%;
            height: 100%;
            name: root.habits-detail.title;
            confirmed => {
                root.habit-delete-open = false;
                root.habit-delete-confirmed();
            }
            dismissed => { root.habit-delete-open = false; }
        }

        if root.event-detail-open: EventDetailPanel {
            width: 100%;
            height: 100%;
            anchored: root.event-anchored;
            anchor-left: root.event-anchor-left;
            anchor-right: root.event-anchor-right;
            anchor-top: root.event-anchor-top;
            detail: root.event-detail;
            notes <=> root.event-notes;
            notes-edited(t) => { root.event-notes-edited(t); }
            tasks: root.event-tasks;
            new-task <=> root.event-new-task;
            task-added(t) => { root.event-task-added(t); }
            task-toggled(id) => { root.event-task-toggled(id); }
            task-opened(id) => { root.event-task-opened(id); }
            edit => { root.event-edit(); }
            delete => { root.event-delete(); }
            dismissed => { root.event-detail-open = false; }
            join(u) => { root.open-link(u); }
            video-set(u) => { root.event-video-set(u); }
            take-notes => {
                root.event-detail-open = false;
                root.event-take-notes();
            }
        }

        if root.event-editor-open: EventEditorPanel {
            width: 100%;
            height: 100%;
            is-new: root.editor-is-new;
            title <=> root.editor-title;
            all-day <=> root.editor-all-day;
            start-date <=> root.editor-start-date;
            start-time <=> root.editor-start-time;
            end-date <=> root.editor-end-date;
            end-time <=> root.editor-end-time;
            location <=> root.editor-location;
            notes <=> root.editor-notes;
            calendars: root.editor-calendars;
            calendar-index <=> root.editor-calendar-index;
            reminders: root.editor-reminders;
            reminder-index <=> root.editor-reminder-index;
            repeats: root.editor-repeats;
            repeat-index <=> root.editor-repeat-index;
            error: root.editor-error;
            start-label: root.editor-start-label;
            end-label: root.editor-end-label;
            picker: root.editor-picker;
            picker-title: root.editor-picker-title;
            picker-cells: root.editor-picker-cells;
            picker-requested(w) => { root.editor-picker-requested(w); }
            picker-navigate(n) => { root.editor-picker-navigate(n); }
            picker-chosen(d) => { root.editor-picker-chosen(d); }
            picker-closed => { root.editor-picker = -1; }
            save => { root.event-save(); }
            dismissed => { root.event-editor-open = false; }
        }

        // A right-click on an event. Rust has made it the chosen event, as a click does, so
        // Edit and Delete act on it through the same callbacks as its card.
        if root.event-menu-open: EventContextMenu {
            width: 100%;
            height: 100%;
            event: root.event-detail;
            palette: root.calendar-palette;
            menu-x: root.event-menu-x;
            menu-y: root.event-menu-y;
            open => {
                root.event-menu-open = false;
                root.event-anchored = true;
                root.event-detail-open = true;
            }
            edit => {
                root.event-menu-open = false;
                root.event-edit();
            }
            delete => {
                root.event-menu-open = false;
                root.event-delete();
                shortcuts.focus();
            }
            color-chosen(i) => {
                root.event-menu-open = false;
                root.event-color-chosen(i);
                shortcuts.focus();
            }
            copy-link => {
                root.event-menu-open = false;
                root.event-copy-link();
                shortcuts.focus();
            }
            dismissed => {
                root.event-menu-open = false;
                shortcuts.focus();
            }
        }

        if root.calendar-menu-open: CalendarContextMenu {
            width: 100%;
            height: 100%;
            cal: root.calendar-menu-cal;
            palette: root.calendar-palette;
            menu-x: root.calendar-menu-x;
            menu-y: root.calendar-menu-y;
            color-chosen(i) => {
                root.calendar-menu-open = false;
                root.calendar-color-chosen(root.calendar-menu-cal.id, i);
            }
            refresh => {
                root.calendar-menu-open = false;
                root.calendar-refresh(root.calendar-menu-cal.id);
            }
            rename => {
                root.calendar-menu-open = false;
                root.calendar-rename-new = false;
                root.calendar-rename-name = root.calendar-menu-cal.name;
                root.calendar-rename-open = true;
            }
            remove => {
                root.calendar-menu-open = false;
                root.calendar-delete-open = true;
            }
            dismissed => { root.calendar-menu-open = false; }
        }

        // Naming a calendar: a new one (-1), or the one the menu was opened on.
        if root.calendar-rename-open: CalendarRenamePanel {
            width: 100%;
            height: 100%;
            is-new: root.calendar-rename-new;
            name <=> root.calendar-rename-name;
            error: root.calendar-rename-error;
            rename => {
                root.calendar-rename-confirmed(
                    root.calendar-rename-new ? -1 : root.calendar-menu-cal.id,
                    root.calendar-rename-name);
            }
            dismissed => { root.calendar-rename-open = false; }
        }

        if root.calendar-delete-open: CalendarDeletePanel {
            width: 100%;
            height: 100%;
            cal: root.calendar-menu-cal;
            confirmed => {
                root.calendar-delete-open = false;
                root.calendar-delete-confirmed(root.calendar-menu-cal.id);
            }
            dismissed => { root.calendar-delete-open = false; }
        }

        if root.subscribe-open: SubscribePanel {
            width: 100%;
            height: 100%;
            url <=> root.subscribe-url;
            name <=> root.subscribe-name;
            busy: root.subscribe-busy;
            error: root.subscribe-error;
            subscribe => { root.subscribe-confirmed(); }
            dismissed => { root.subscribe-open = false; }
        }

        if root.notes-area-menu-open: NotesAreaMenu {
            width: 100%;
            height: 100%;
            menu-x: root.notes-row-menu-x;
            menu-y: root.notes-row-menu-y;
            chosen(action) => {
                root.notes-area-menu-open = false;
                if (action == "new-folder") {
                    root.notes-name = "";
                    root.notes-name-asked = "folder";
                } else {
                    root.notes-row-action(action, ".");
                }
            }
            dismissed => { root.notes-area-menu-open = false; }
        }

        if root.notes-row-menu-open: NotesRowMenu {
            width: 100%;
            height: 100%;
            menu-x: root.notes-row-menu-x;
            menu-y: root.notes-row-menu-y;
            kind: root.notes-row-menu-kind;
            pinned: root.notes-row-menu-pinned;
            palette: root.notes-folder-palette;
            colour: root.notes-row-menu-colour;
            chosen(action) => {
                root.notes-row-menu-open = false;
                if (action == "new-folder") {
                    root.notes-name = "";
                    root.notes-name-asked = "folder";
                } else {
                    root.notes-row-action(action, root.notes-row-menu-key);
                }
            }
            dismissed => { root.notes-row-menu-open = false; }
        }

        if root.notes-review-open: NotesReviewPanel {
            width: 100%;
            height: 100%;
            question: root.notes-review-question;
            answer: root.notes-review-answer;
            revealed: root.notes-review-revealed;
            progress: root.notes-review-progress;
            finished: root.notes-review-finished;
            reveal => { root.notes-review-reveal(); }
            graded(g) => { root.notes-review-graded(g); }
            dismissed => {
                root.notes-review-open = false;
                shortcuts.focus();
            }
        }

        if root.notes-space-menu-open: NotesSpaceMenu {
            width: 100%;
            height: 100%;
            menu-x: root.notes-space-menu-x;
            menu-y: root.notes-space-menu-y;
            spaces: root.notes-spaces;
            current: root.notes-space;
            chosen(i) => {
                root.notes-space-menu-open = false;
                root.notes-space-chosen(i);
            }
            new-space => {
                root.notes-space-menu-open = false;
                root.notes-name = "";
                root.notes-name-asked = "space";
            }
            open-folder => {
                root.notes-space-menu-open = false;
                root.notes-space-open-folder();
            }
            reveal => {
                root.notes-space-menu-open = false;
                root.notes-space-reveal();
            }
            dismissed => { root.notes-space-menu-open = false; }
        }

        if root.notes-name-asked != "": NotesNamePanel {
            width: 100%;
            height: 100%;
            title: root.notes-name-asked == "space" ? "New space"
                : root.notes-name-asked == "sheet" ? "Rename the sheet" : "New folder";
            action: root.notes-name-asked == "sheet" ? "Rename" : "Create";
            name <=> root.notes-name;
            error: root.notes-name-error;
            confirmed(t) => {
                if (root.notes-name-asked == "space") {
                    root.notes-space-new(t);
                } else if (root.notes-name-asked == "sheet") {
                    root.notes-name-asked = "";
                    SheetGrid.action("sheet-rename:" + t);
                    SheetGrid.focus-serial += 1;
                } else {
                    root.notes-new-folder(t);
                }
            }
            dismissed => {
                root.notes-name-asked = "";
                shortcuts.focus();
            }
        }

        if root.notes-history-open: NotesHistoryPanel {
            width: 100%;
            height: 100%;
            versions: root.notes-history;
            chosen: root.notes-history-chosen;
            preview: root.notes-history-preview;
            picked(i) => { root.notes-history-picked(i); }
            restore => {
                root.notes-history-restore();
                root.notes-history-open = false;
                shortcuts.focus();
            }
            dismissed => {
                root.notes-history-open = false;
                shortcuts.focus();
            }
        }

        if root.notes-graph-open: NotesGraphPanel {
            width: 100%;
            height: 100%;
            nodes: root.notes-graph-nodes;
            edges: root.notes-graph-edges;
            chosen(k) => {
                root.notes-graph-open = false;
                root.notes-graph-chosen(k);
                shortcuts.focus();
            }
            dismissed => {
                root.notes-graph-open = false;
                shortcuts.focus();
            }
        }

        if SheetGrid.menu != "": SheetMenu {
            width: 100%;
            height: 100%;
            chosen(action) => {
                SheetGrid.menu = "";
                if (action == "sheet-rename") {
                    root.notes-name = "";
                    root.notes-name-asked = "sheet";
                } else {
                    SheetGrid.action(action);
                    SheetGrid.focus-serial += 1;
                }
            }
            dismissed => {
                SheetGrid.menu = "";
                SheetGrid.focus-serial += 1;
            }
        }

        if root.notes-quick-open: NotesQuickOpen {
            width: 100%;
            height: 100%;
            query <=> root.notes-quick-query;
            results: root.notes-quick-results;
            highlighted: root.notes-quick-highlight;
            search: root.notes-quick-search;
            moving: root.notes-quick-moving;
            edited(t) => {
                root.notes-quick-highlight = 0;
                root.notes-quick-edited(t);
            }
            moved(d) => {
                root.notes-quick-highlight = max(0, min(root.notes-quick-results.length - 1,
                    root.notes-quick-highlight + d));
            }
            chosen(k) => {
                root.notes-quick-open = false;
                root.notes-quick-chosen(k);
            }
            dismissed => {
                root.notes-quick-open = false;
                shortcuts.focus();
            }
        }

        if root.connect-open: ConnectCalendarsPanel {
            width: 100%;
            height: 100%;
            server <=> root.connect-server;
            user <=> root.connect-user;
            password <=> root.connect-password;
            busy: root.connect-busy;
            error: root.connect-error;
            connect => { root.connect-confirmed(); }
            dismissed => {
                root.connect-open = false;
                root.connect-password = "";
                shortcuts.focus();
            }
        }

        if root.problem-open: AccountProblemPanel {
            width: 100%;
            height: 100%;
            account: root.problem-account;
            message: root.problem-message;
            advice: root.problem-advice;
            needs-password: root.problem-needs-password;
            sign-in: root.problem-sign-in;
            busy: root.problem-busy;
            result: root.problem-result;
            password <=> root.problem-password;
            retry => { root.problem-retry(); }
            save-password => { root.problem-save-password(); }
            sign-in-again => { root.problem-sign-in-again(); }
            disable-account => { root.problem-disable(); }
            dismissed => { root.problem-open = false; }
        }

        if root.folder-menu-open: FolderContextMenu {
            width: 100%;
            height: 100%;
            folder: root.folder-menu-path;
            permanent: root.folder-menu-permanent;
            emptyable: root.folder-menu-emptyable;
            mark-read => { root.folder-mark-read-requested(); }
            empty => { root.folder-empty-requested(); }
            menu-x: root.folder-menu-x;
            menu-y: root.folder-menu-y;
            rename => { root.folder-rename-requested(); }
            remove => { root.folder-delete-requested(); }
            dismissed => { root.folder-menu-dismissed(); }
        }

        if root.empty-folder-open: EmptyFolderPanel {
            width: 100%;
            height: 100%;
            folder: root.empty-folder-name;
            scope: root.empty-folder-scope;
            confirmed => {
                root.empty-folder-open = false;
                root.folder-empty-confirmed();
            }
            dismissed => { root.empty-folder-open = false; }
        }

        if root.rename-folder-open: RenameFolderPanel {
            width: 100%;
            height: 100%;
            current: root.rename-folder-current;
            error: root.rename-folder-error;
            name <=> root.rename-folder-name;
            rename => { root.folder-rename-confirmed(); }
            dismissed => { root.folder-rename-dismissed(); }
        }

        if root.new-folder-open: NewFolderPanel {
            width: 100%;
            height: 100%;
            parent-path: root.new-folder-parent;
            error: root.new-folder-error;
            name <=> root.new-folder-name;
            mailboxes: root.new-folder-mailboxes;
            chosen: root.new-folder-chosen;
            total: root.new-folder-total;
            all-shown-checked: root.new-folder-all-shown-checked;
            search <=> root.new-folder-search;
            search-changed(t) => { root.new-folder-search-changed(t); }
            mailbox-toggled(id) => { root.new-folder-mailbox-toggled(id); }
            select-all-toggled => { root.new-folder-select-all-toggled(); }
            create => { root.new-folder-create(); }
            dismissed => { root.new-folder-dismissed(); }
        }

        if root.account-menu-open: AccountContextMenu {
            width: 100%;
            height: 100%;
            account: root.account-menu-label;
            pinned: root.account-menu-pinned;
            enabled: root.account-menu-enabled;
            menu-x: root.account-menu-x;
            menu-y: root.account-menu-y;
            sync-now => { root.account-menu-sync(); }
            edit-account => { root.account-menu-edit(); }
            change-password => { root.account-menu-password(); }
            edit-signature => { root.account-menu-signature(); }
            edit-aliases => { root.account-menu-aliases(); }
            toggle-pinned => { root.account-menu-pin(); }
            toggle-enabled => { root.account-menu-enable(); }
            remove-account => { root.account-menu-remove(); }
            dismissed => { root.account-menu-dismissed(); }
            tags: root.account-menu-tags;
            tags-open <=> root.account-tags-open;
            tag-search <=> root.account-tag-search;
            tag-toggled(id) => { root.account-tag-toggled(id); }
            tag-search-changed(t) => { root.account-tag-search-changed(t); }
            tag-created(t) => { root.account-tag-created(t); }
            manage-tags => { root.tags-requested(); }
            // The row under the pointer, if it is an account, opens its own menu.
            reopen-at(px, py) => {
                root.account-probe-x = px;
                root.account-probe-y = py;
                root.account-probe += 1;
            }
        }

        if root.tags-open: TagsPanel {
            width: 100%;
            height: 100%;
            tags: root.account-tags;
            palette: root.tag-palette;
            error: root.tags-error;
            new-name <=> root.tags-new-name;
            created(t) => { root.tag-created(t); }
            renamed(id, nom) => { root.tag-renamed(id, nom); }
            color-chosen(id, i) => { root.tag-color-chosen(id, i); }
            deleted(id) => { root.tag-deleted(id); }
            moved(id, index) => { root.tag-moved(id, index); }
            dismissed => { root.tags-open = false; }
        }

        // On a phone the accounts and folders rise as a tall sheet over the list, as the
        // mockups' M3 has them: the same column as the PC's, on a plate with a handle,
        // pulled down or tapped outside to close.
        if root.mailboxes-open && Layout.compact: feuille-boites := Rectangle {
            property <length> tire;
            background: Tokens.scrim;
            TouchArea {
                clicked => {
                    root.mailboxes-open = false;
                    shortcuts.focus();
                }
            }
            Rectangle {
                y: 48px + Layout.inset-top + feuille-boites.tire;
                height: parent.height - 48px - Layout.inset-top;
                border-top-left-radius: 22px;
                border-top-right-radius: 22px;
                background: Tokens.panel;
                drop-shadow-blur: Tokens.shadow-window-blur;
                drop-shadow-color: Tokens.shadow-window;
                clip: true;
                TouchArea {}
                Rectangle {
                    x: (parent.width - self.width) / 2;
                    y: 8px;
                    width: 40px;
                    height: 5px;
                    border-radius: 3px;
                    background: Tokens.border-strong;
                }
                VerticalLayout {
                    padding-top: 18px;
                    padding-left: 8px;
                    padding-right: 8px;
                    padding-bottom: Layout.inset-bottom;
                    Sidebar {
                        vertical-stretch: 1;
                        folder-open: root.selected-folder != "";
                        pinned: root.pinned-accounts;
                        others: root.other-accounts;
                        selected-id: root.selected-account;
                        unified-count: root.unified-count;
                        unified-label: root.unified-label;
                        unified-full: root.unified-full;
                        filter <=> root.account-filter;
                        syncing: root.syncing-all;
                        sync-progress: root.sync-progress;
                        last-sync: root.last-sync;
                        account-total: root.account-count;
                        collapsed <=> root.sidebar-collapsed;
                        account-selected(id) => {
                            root.mailboxes-open = false;
                            root.account-selected(id);
                            root.navigated("account", "\{id}");
                            shortcuts.focus();
                        }
                        unified-selected => {
                            root.mailboxes-open = false;
                            root.unified-selected();
                            root.navigated("unified", "");
                            shortcuts.focus();
                        }
                        resume-account(id) => { root.resume-account(id); }
                        add-account => { root.add-account-open = true; }
                        filter-changed(t) => { root.account-filter-changed(t); }
                        sync-account(id) => { root.sync-account(id); }
                        sync-all => { root.sync-all(); }
                        open-tags => { root.tags-requested(); }
                        closed => {
                            root.mailboxes-open = false;
                            shortcuts.focus();
                        }
                        grouped: root.group-by-tags;
                        selected-tag: root.selected-tag;
                        tag-selected(t) => {
                            root.mailboxes-open = false;
                            root.tag-selected(t);
                            root.navigated("tag", "\{t}");
                            shortcuts.focus();
                        }
                        tag-fold-toggled(t) => { root.tag-fold-toggled(t); }
                        group-toggled => {
                            root.group-by-tags = !root.group-by-tags;
                            root.group-by-tags-changed();
                        }
                        probe: root.account-probe;
                        probe-x: root.account-probe-x;
                        probe-y: root.account-probe-y;
                        account-menu(id, mx, my) => {
                            root.account-menu-x = mx;
                            root.account-menu-y = my;
                            root.account-menu-requested(id);
                        }
                        // Brought back full size, even if it was tucked into the corner:
                        // New message is a request to write.
                        compose => {
                            root.compose-minimised = false;
                            root.compose-open = true;
                        }

                        // The folders, under the accounts: "this mailbox, in this folder"
                        // read down one column. Folded with it.
                        if !root.sidebar-collapsed: FolderTree {
                            vertical-stretch: 1;
                            folders: root.folders;
                            selected-path: root.selected-folder;
                            accounts-total: root.account-count;
                            folder-selected(p) => {
                                root.mailboxes-open = false;
                                root.folder-selected(p);
                                root.navigated("folder", p);
                                shortcuts.focus();
                            }
                            all-selected => {
                                root.mailboxes-open = false;
                                root.folder-cleared();
                                root.navigated("folder", "");
                            }
                            folder-fold-toggled(p) => {
                                root.folder-fold-toggled(p);
                                shortcuts.focus();
                            }
                            new-folder => { root.new-folder-requested(); }
                            scheduled: root.scheduled-count;
                            scheduled-requested => { root.scheduled-requested(); }
                            folder-dropped(p) => { root.folder-dropped(p); }
                            folder-menu(p, mx, my) => {
                                root.folder-menu-x = mx;
                                root.folder-menu-y = my;
                                root.folder-menu-requested(p);
                            }
                        }
                    }
                }
                TouchArea {
                    y: 0px;
                    height: 26px;
                    moved => {
                        feuille-boites.tire = max(0px, self.mouse-y - self.pressed-y);
                    }
                    pointer-event(e) => {
                        if (e.kind == PointerEventKind.up) {
                            if (feuille-boites.tire > 80px) {
                                root.mailboxes-open = false;
                            }
                            feuille-boites.tire = 0px;
                        }
                    }
                }
            }
        }

        if root.context-menu-open: ThreadContextMenu {
            width: 100%;
            height: 100%;
            menu-x: root.context-menu-x;
            menu-y: root.context-menu-y;
            unread: root.context-menu-unread;
            starred: root.context-menu-starred;
            subject: liste.menu-row.subject;
            from: liste.menu-row.from;
            message-count: liste.menu-row.message-count;
            // Chaque action porte sa cible. « Ouvrir » est la seule qui sélectionne, parce
            // que c'est la seule qu'on lui demande de faire.
            open-thread => {
                root.context-menu-open = false;
                root.thread-selected(root.context-menu-thread);
                // On a phone the conversation is a page: Open opens it, as a tap does.
                if (Layout.compact) {
                    root.page = "thread";
                    root.navigated("page", "thread");
                }
                shortcuts.focus();
            }
            add-task => { root.thread-to-task(root.context-menu-thread); }
            mark-done => { root.menu-done(root.context-menu-thread); }
            archive => { root.menu-archive(root.context-menu-thread); }
            snooze(quand) => { root.menu-snooze(root.context-menu-thread, quand); }
            toggle-unread => { root.menu-toggle-unread(root.context-menu-thread); }
            toggle-star => { root.menu-toggle-star(root.context-menu-thread); }
            delete-thread => { root.menu-delete(root.context-menu-thread); }
            view-source => { root.view-source(); }
            copy-link => { root.thread-copy-link(root.context-menu-thread); }
            select => { root.row-mark-toggled(root.context-menu-thread); }
            dismissed => { root.context-menu-open = false; }
            reopen-at(px, py) => { liste.reopen-context-menu-at(px, py); }
        }

        if root.link-menu-open: LinkMenu {
            width: 100%;
            height: 100%;
            kind: root.link-menu-kind;
            link-text: root.link-menu-text;
            has-selection: root.link-menu-selection;
            body: root.link-menu-message >= 0;
            menu-x: root.link-menu-x;
            menu-y: root.link-menu-y;
            chosen(c) => {
                if (root.link-menu-text-body && c == "copy-selection") {
                    if (MessageText.all-selected >= 0) {
                        root.copy-message-text(MessageText.all-selected);
                    } else {
                        // The words holding the selection copy it once they have let go
                        // of the keyboard (conversation.slint).
                        MessageText.copy-serial += 1;
                        root.status = "Copied.";
                    }
                } else if (root.link-menu-text-body && c == "select-all") {
                    MessageText.all-selected = root.link-menu-message;
                } else {
                    if (c == "select-all") {
                        MessageText.all-selected = -1;
                    }
                    root.link-menu-chosen(c);
                }
            }
            dismissed => {
                root.link-menu-open = false;
                shortcuts.focus();
            }
        }

        // The reading toolbar's menus: until when to snooze, and the rarer actions. They
        // act on the conversation being read.
        if root.reader-menu != "": ReaderMenu {
            width: 100%;
            height: 100%;
            kind: root.reader-menu;
            unread: root.selected-unread;
            menu-x: root.reader-menu-x;
            menu-y: root.reader-menu-y;
            snooze(quand) => { root.menu-snooze(root.selected-thread, quand); }
            forward-thread => { root.forward-thread(); }
            reply(tous) => { root.reply-requested(tous); }
            toggle-unread => { root.thread-toggle-unread(); }
            view-source => { root.view-source(); }
            starred: root.selected-starred;
            done => { root.thread-done(); }
            snooze-open => { root.reader-menu = "snooze"; }
            waiting => { root.thread-waiting(); }
            to-task => { root.thread-to-task(root.selected-thread); }
            archive => { root.thread-archive(); }
            toggle-star => { root.thread-toggle-star(); }
            delete-thread => { root.thread-delete(); }
            dismissed => { root.reader-menu = ""; }
        }

        if root.sort-menu-open: SortMenu {
            width: 100%;
            height: 100%;
            current: root.list-sort;
            menu-x: root.sort-menu-x;
            menu-y: root.sort-menu-y;
            chosen(i) => {
                root.sort-menu-open = false;
                root.sort-chosen(i);
                shortcuts.focus();
            }
            dismissed => {
                root.sort-menu-open = false;
                shortcuts.focus();
            }
        }

        if root.scheduled-open: ScheduledPanel {
            width: 100%;
            height: 100%;
            rows: root.scheduled-rows;
            edit(id) => {
                root.scheduled-open = false;
                root.scheduled-edit(id);
            }
            send-now(id) => { root.scheduled-send-now(id); }
            dismissed => {
                root.scheduled-open = false;
                shortcuts.focus();
            }
        }

        if root.compose-open: ComposePanel {
            width: 100%;
            height: 100%;
            senders: root.compose-senders;
            sender-index: root.compose-sender-index;
            attachments: root.compose-attachments;
            error: root.compose-error;
            minimised <=> root.compose-minimised;
            parked-x: root.compose-parked-x;
            park => {
                root.compose-park();
                shortcuts.focus();
            }
            show-cc <=> root.compose-show-cc;
            to <=> root.compose-to;
            cc <=> root.compose-cc;
            bcc <=> root.compose-bcc;
            subject <=> root.compose-subject;
            body <=> root.compose-body;
            replying: root.compose-replying;
            reply-all: root.compose-reply-all;
            can-reply-all: root.compose-can-reply-all;
            history: root.compose-history;
            reply-all-toggled(tous) => { root.compose-reply-all-toggled(tous); }
            send => { root.compose-send(); }
            later-options: root.compose-later-options;
            send-later(i) => { root.compose-send-later(i); }
            sender-chosen(i) => { root.compose-sender-chosen(i); }
            attach => { root.compose-attach(); }
            attach-image => { root.compose-attach-image(); }
            remove-attachment(i) => { root.compose-remove-attachment(i); }
            format(f) => { root.compose-format(f); }
            suggestions: root.compose-suggestions;
            suggestion-names: root.compose-suggestion-names;
            suggestion-addresses: root.compose-suggestion-addresses;
            suggestion-initials: root.compose-suggestion-initials;
            recipient-typed(champ, texte) => { root.compose-recipient-typed(champ, texte); }
            recipient-picked(champ, choix) => { root.compose-recipient-picked(champ, choix); }
            dismissed => { root.compose-dismissed(); root.compose-open = false; }
            confirm-close <=> root.compose-confirm-close;
            discard => { root.compose-discard(); }
            save-draft => { root.compose-save-draft(); }
        }

        // The messages minimised, as bars at the foot of the window, right to left.
        for titre[i] in root.parked-drafts: ParkedDraft {
            x: root.width - 12px - (i + 1) * 300px - i * 8px;
            y: root.height - 40px - 12px;
            text: titre;
            opened => { root.parked-open(i, self.x); }
        }

        if root.source-open: SourcePanel {
            width: 100%;
            height: 100%;
            subject: root.source-subject;
            source: root.source-text;
            unavailable: root.source-unavailable;
            dismissed => { root.source-open = false; }
        }

        if root.alias-open: AliasPanel {
            width: 100%;
            height: 100%;
            account: root.alias-account;
            rows: root.alias-rows;
            error: root.alias-error;
            new-address <=> root.alias-new-address;
            new-name <=> root.alias-new-name;
            added => { root.alias-added(); }
            removed(id) => { root.alias-removed(id); }
            dismissed => {
                root.alias-open = false;
                shortcuts.focus();
            }
        }

        if root.signature-open: SignaturePanel {
            width: 100%;
            height: 100%;
            account: root.signature-account;
            signature <=> root.signature-text;
            saved => { root.signature-saved(); root.signature-open = false; }
            dismissed => { root.signature-open = false; }
        }

        if root.modules-open: ModulesPanel {
            width: 100%;
            height: 100%;
            rules: root.rules;
            plugins: root.plugins;
            plugin-folder: root.plugin-folder;
            simulation: root.simulation;
            new-rule-name <=> root.new-rule-name;
            new-rule-sender <=> root.new-rule-sender;
            rule-toggled(id, on) => { root.rule-toggled(id, on); }
            rule-simulated(id) => { root.rule-simulated(id); }
            rule-removed(id) => { root.rule-removed(id); }
            rule-added => { root.rule-added(); }
            plugins-reloaded => { root.plugins-reloaded(); }
            configure-plugin(id) => { root.plugin-settings-requested(id); }

            // Les réglages du module, dans cette fenêtre-ci et non dans une seconde
            // par-dessus. Le nom vide veut dire « la liste ».
            settings-plugin: root.plugin-settings-open ? root.plugin-settings-name : "";
            plugin-settings: root.plugin-settings;
            settings-error: root.plugin-settings-error;
            settings-changed(k, v) => { root.plugin-setting-changed(k, v); }
            settings-closed => { root.plugin-settings-dismissed(); }

            dismissed => {
                root.plugin-settings-dismissed();
                root.modules-open = false;
            }
        }

        if root.add-account-open: AccountSetupPanel {
            width: 100%;
            height: 100%;
            editing: root.add-account-editing;
            busy: root.add-account-busy;
            manual: root.add-account-manual;
            error: root.add-account-error;
            hint: root.add-account-hint;
            email <=> root.new-email;
            password <=> root.new-password;
            username <=> root.new-username;
            imap-host <=> root.new-imap-host;
            imap-port <=> root.new-imap-port;
            smtp-host <=> root.new-smtp-host;
            smtp-port <=> root.new-smtp-port;
            imap-tls <=> root.new-imap-tls;
            smtp-tls <=> root.new-smtp-tls;
            discover => { root.add-account-discover(); }
            save-manual => { root.add-account-save(); }
            switch-to-manual => { root.add-account-manual-requested(); }
            import-profile => { root.add-account-import(); }
            profile-choices: root.profile-choices;
            profile-choice: root.profile-choice;
            profile-chosen(i) => { root.profile-chosen(i); }
            // Google: no password, the browser signs in once the address is looked up.
            google-ready: root.oauth-google-id != "";
            google => {
                root.new-password = "";
                root.add-account-google = true;
                root.add-account-discover();
            }
            dismissed => { root.add-account-dismissed(); }
        }
        if root.add-account-open && root.add-account-found: AccountFoundPage {
            width: 100%;
            height: 100%;
            address: root.add-account-found-address;
            source: root.add-account-found-source;
            incoming: root.add-account-found-incoming;
            outgoing: root.add-account-found-outgoing;
            keeper: root.add-account-found-keeper;
            syncing: root.syncing-all;
            progress: root.sync-progress;
            continued => {
                root.add-account-found = false;
                root.first-run = false;
                root.add-account-dismissed();
            }
            another => {
                root.add-account-found = false;
                root.new-email = "";
                root.new-password = "";
            }
        }

        // A page, as the Mac's: beside the place's side column, which stays (its foot,
        // with Settings, too), over what the place shows.
        if root.settings-open: SettingsPanel {
            x: Layout.compact ? 0px : root.rail + root.cote;
            y: Layout.inset-top;
            width: parent.width - self.x;
            group <=> root.settings-group;
            height: parent.height - root.pied - Layout.inset-top;
            appearance: root.appearance;
            accent-index: root.accent-index;
            accent-chosen(i) => { root.accent-chosen(i); }
            // On a phone a window opened from a page goes over it, and Back returns to
            // the page; the page is hidden meanwhile, those windows being drawn before
            // it. On a PC they replace the settings.
            covered: Layout.compact && (root.add-account-open || root.modules-open
                || root.signature-open || root.alias-open || root.tags-open
                || root.problem-open);
            visible: !self.covered;
            add-account => {
                if (!Layout.compact) { root.settings-open = false; }
                root.add-account-open = true;
            }
            first-name <=> root.first-name;
            first-name-changed(t) => { root.first-name-changed(t); }
            // One window for another: the modules replace the settings.
            open-modules => {
                if (!Layout.compact) { root.settings-open = false; }
                root.modules-open = true;
            }
            initials: root.profile-initials;
            accounts: root.settings-accounts;
            backup-when: root.backup-when;
            version-number: root.version-number;
            changelog: root.settings-changelog;
            open-changelog => { root.changelog-open = true; }
            rules: root.rules;
            plugins: root.plugins;
            rule-toggled(id, on) => { root.rule-toggled(id, on); }
            plugin-opened(id) => {
                root.modules-open = true;
                root.plugin-settings-requested(id);
            }
            // An account's page: its right-click menu asked for, as on a PC, and closed
            // at once; the page shows what the menu holds and does what it does.
            account <=> root.settings-account;
            account-label: root.account-menu-label;
            account-pinned: root.account-menu-pinned;
            account-enabled: root.account-menu-enabled;
            account-tags: root.account-menu-tags;
            account-page: root.account-page;
            account-opened(id) => {
                root.account-menu-requested(id);
                root.account-menu-dismissed();
            }
            account-edit => { root.account-menu-edit(); }
            account-password => { root.account-menu-password(); }
            account-signature => { root.account-menu-signature(); }
            account-aliases => { root.account-menu-aliases(); }
            account-enable => {
                root.account-menu-enable();
                root.account-menu-requested(root.settings-account);
                root.account-menu-dismissed();
            }
            account-pin => {
                root.account-menu-pin();
                root.account-menu-requested(root.settings-account);
                root.account-menu-dismissed();
            }
            account-remove => { root.account-menu-remove(); }
            account-tag-toggled(id) => { root.account-tag-toggled(id); }
            manage-tags => { root.tags-requested(); }
            density: root.density;
            text-size: root.text-size;
            reply-marks-waiting <=> root.reply-marks-waiting;
            new-message-reopens <=> root.new-message-reopens;
            follow-up-enabled <=> root.follow-up-enabled;
            follow-up-days <=> root.follow-up-days;
            notifications <=> root.notifications;
            start-at-login <=> root.start-at-login;
            handle-mailto <=> root.handle-mailto;
            keep-running <=> root.keep-running;
            home-at-startup <=> root.home-at-startup;
            mac-buttons <=> root.window-mac-buttons;
            undo-send-seconds <=> root.undo-send-seconds;
            sending-changed => { root.sending-changed(); }
            google-client-id <=> root.oauth-google-id;
            google-client-secret <=> root.oauth-google-secret;
            microsoft-client-id <=> root.oauth-microsoft-id;
            oauth-changed => { root.oauth-changed(); }
            system-note: root.system-note;
            version: root.version;
            update-status: root.update-check-status;
            update-checking: root.update-checking;
            update-version: root.update-version;
            check-for-updates => { root.check-for-updates(); }
            install-update => { root.settings-open = false; root.update-open = true; }
            backup-status: root.backup-status;
            restore-question: root.restore-question;
            backup-now => { root.backup-now(); }
            backup-open-folder => { root.backup-open-folder(); }
            notes-folder: root.notes-folder;
            notes-folder-open => { root.notes-folder-open(); }
            notes-folder-change => { root.notes-folder-change(); }
            notes-math-preview <=> root.notes-math-preview;
            notes-math-preview-toggled(on) => { root.notes-math-preview-toggled(on); }
            restore-choose => { root.restore-choose(); }
            restore-confirmed => { root.restore-confirmed(); }
            restore-cancelled => { root.restore-cancelled(); }
            export-ics => { root.export-ics(); }
            system-changed => { root.system-changed(); }
            appearance-chosen(i) => { root.appearance-chosen(i); }
            density-chosen(i) => { root.density-chosen(i); }
            text-size-chosen(p) => { root.text-size-chosen(p); }
            automation-changed => { root.automation-changed(); }
            devices: root.devices;
            join-code <=> root.join-code;
            device-summary: root.device-summary;
            device-question: root.device-question;
            pair-device => {
                root.pair-open = true;
                root.pair-requested();
            }
            sync-device(id) => { root.sync-device(id); }
            join-device(code) => { root.pair-join(code); }
            device-answered(yes) => { root.device-answered(yes); }
            dismissed => { root.settings-open = false; }
        }

        // A copy of Iris with no mailbox yet starts here (set by the app at launch).
        if root.first-run: WelcomePage {
            width: 100%;
            height: 100%;
            add-account => {
                root.first-run = false;
                root.add-account-open = true;
            }
            from-device => {
                root.first-run = false;
                root.settings-open = true;
                root.settings-group = "Devices";
            }
            restore => {
                root.first-run = false;
                root.restore-choose();
            }
            dismissed => {
                root.first-run = false;
                shortcuts.focus();
            }
        }

        if root.pair-open: PairPanel {
            width: 100%;
            height: 100%;
            code: root.pair-code;
            where: root.pair-where;
            digits: root.pair-digits;
            peer: root.pair-peer;
            summary: root.pair-summary;
            error: root.pair-error;
            copy-code => { root.pair-copy-code(); }
            dismissed => {
                root.pair-open = false;
                root.pair-closed();
                shortcuts.focus();
            }
        }

        if root.everywhere-open: EverywherePage {
            width: 100%;
            height: 100%;
            hits: root.everywhere-hits;
            text <=> root.everywhere-text;
            query(t) => { root.everywhere-query(t); }
            task-toggled(id) => { root.everywhere-task-toggled(id); }
            opened(hit) => {
                root.everywhere-open = false;
                if (hit.kind == "mail") {
                    root.home-thread-opened(hit.id.to-float());
                } else if (hit.kind == "task") {
                    root.home-task-opened(hit.id.to-float());
                } else if (hit.kind == "event") {
                    root.home-event-opened(hit.id);
                } else {
                    root.home-note-opened(hit.id);
                }
            }
            action(quoi) => {
                root.everywhere-open = false;
                if (quoi == "message") {
                    root.compose-minimised = false;
                    root.compose-open = true;
                } else if (quoi == "task") {
                    root.workspace = 2;
                    root.workspace-changed(2);
                    root.task-focus-add += 1;
                } else if (quoi == "event") {
                    root.calendar-new-event("", -1);
                } else if (quoi == "note") {
                    root.workspace = 4;
                    root.workspace-changed(4);
                    root.notes-new-note();
                } else {
                    root.sync-all();
                }
            }
            dismissed => {
                root.everywhere-open = false;
                shortcuts.focus();
            }
        }

        if root.palette-open: CommandPalette {
            width: 100%;
            height: 100%;
            commands: root.commands;
            highlighted: root.palette-highlighted;
            query <=> root.palette-query;
            query-changed(t) => { root.palette-query-changed(t); }
            accepted(id) => {
                root.palette-open = false;
                root.command-invoked(id);
            }
            dismissed => { root.palette-open = false; }
        }

        if root.shortcuts-help-open: ShortcutsHelp {
            width: 100%;
            height: 100%;
            dismissed => { root.shortcuts-help-open = false; }
        }

        if root.changelog-open: ChangelogPanel {
            width: 100%;
            height: 100%;
            rows: root.changelog;
            version: root.version;
            dismissed => { root.changelog-open = false; }
        }

        if root.update-open: UpdatePanel {
            width: 100%;
            height: 100%;
            current: root.version;
            available: "Iris " + root.update-version;
            notes: root.update-notes;
            busy: root.update-busy;
            progress: root.update-progress;
            status: root.update-status;
            error: root.update-error;
            confirmed => { root.update-confirmed(); }
            dismissed => { root.update-open = false; }
        }

        // En dernier : une confirmation recouverte par ce qu'elle confirme ne confirme
        // rien.
        if root.send-notice-open: SendNotice {
            width: 100%;
            height: 100%;
            message: root.send-notice-text;
            seconds: root.send-notice-seconds;
            undone => { root.send-undone(); }
        }

        if root.undo-snack != "": UndoSnack {
            width: 100%;
            height: 100%;
            message: root.undo-snack;
            foot: root.pied;
            undo => {
                root.undo-snack = "";
                root.undo();
            }
            dismissed => { root.undo-snack = ""; }
        }

        if root.toast != "": Toast {
            width: 100%;
            height: 100%;
            message: root.toast;
            dismissed => { root.toast = ""; }
        }
    }
}
