    // Appelée depuis Rust par Ctrl+F et par la palette : donner le focus est un
    // geste d'interface, il n'a pas à faire l'aller-retour par le vue-modèle.
    public function focus-search() {
        mail-toolbar.focus-search();
    }

    // The clipboard, reached through a text field of our own that nobody sees:
    // Slint gives no other way to it.
    presse := TextInput {
        x: -10px;
        y: -10px;
        width: 1px;
        height: 1px;
        opacity: 0;
        read-only: true;
        enabled: false;
    }
    /// Puts `text` on the clipboard.
    public function copy-text(text: string) {
        presse.text = text;
        presse.select-all();
        presse.copy();
    }

    forward-focus: shortcuts;

    /// A window is open over the rest: the mail behind it is out of reach.
    ///
    /// The shortcuts used to go straight through. With the new-message window open
    /// and no field clicked yet, "e" marked as done the thread displayed behind it.
    out property <bool> modal-open: (root.compose-open && !root.compose-minimised)
        || root.settings-open || root.modules-open || root.add-account-open
        || root.problem-open || root.source-open || root.signature-open || root.alias-open
        || root.changelog-open || root.update-open || root.tags-open || root.shortcuts-help-open
        || root.rename-folder-open || root.new-folder-open || root.palette-open
        || root.empty-folder-open || root.mailboxes-open || root.tasks-column-open
        || root.pair-open || root.first-run || root.everywhere-open
        || root.context-menu-open || root.folder-menu-open || root.account-menu-open
        || root.link-menu-open
        || root.event-detail-open || root.event-editor-open || root.subscribe-open
        || root.connect-open
        || root.notes-row-menu-open || root.notes-area-menu-open || root.notes-space-menu-open
        || root.notes-name-asked != ""
        || root.notes-quick-open || root.notes-review-open || SheetGrid.menu != ""
        || root.notes-history-open || root.notes-graph-open
        || root.calendar-menu-open || root.calendar-rename-open || root.calendar-delete-open
        || root.event-menu-open || root.scheduled-open || root.sort-menu-open
        || root.task-list-menu-open || root.task-list-name-open || root.task-list-delete-open
        || root.reader-menu != ""
        || root.goal-new-open || root.goal-time-open || root.goal-delete-open
        || root.task-later-open || root.task-slot-open
        || root.habit-new-open || root.habit-delete-open;

    // Closing a window hands the keyboard back to the shortcuts. Otherwise it stays
    // with a field that no longer exists, and the next key goes nowhere.
    changed modal-open => {
        if (!root.modal-open) {
            shortcuts.focus();
            // A spreadsheet open: its grid is where the keys go, as they went before.
            if (root.workspace == 4 && root.note-sheet-open) {
                SheetGrid.focus-serial += 1;
            }
        }
    }

    // Toutes les touches passent par Rust : les raccourcis sont des données, pas du
    // code d'interface, et restent donc reconfigurables.
    //
    // **Under** everything else, and that placement is the fix for a whole family of
    // faults. A FocusScope that does not have the focus takes the click that would
    // give it the focus, and keeps it. This one covered the window from above: with a
    // field focused, a click on another field — or on a suggested address — only
    // brought the focus back here, and never reached what it was aimed at. Below,
    // it only receives the clicks nothing else wanted: a click on empty space still
    // returns the keyboard to the shortcuts.
    shortcuts := FocusScope {
        width: 100%;
        height: 100%;
        key-released(event) => {
            if (event.text == Key.Control) {
                root.notes-ctrl-held = false;
            }
            reject
        }
        key-pressed(event) => {
            // Android's Back: what is open closes, then the page, then the history.
            if (event.text == Key.Back) {
                root.system-back();
                return accept;
            }
            // Ctrl held over a drawn note: its links take the click.
            if (event.text == Key.Control) {
                root.notes-ctrl-held = true;
                return reject;
            }
            // Home, mail, calendar, tasks and notes, from anywhere but an open window.
            if (event.modifiers.control && !root.modal-open
                && (event.text == "0" || event.text == "1" || event.text == "2"
                    || event.text == "3" || event.text == "4")) {
                root.workspace = event.text == "0" ? 3 : event.text == "1" ? 0
                    : event.text == "2" ? 1 : event.text == "3" ? 2 : 4;
                root.workspace-changed(root.workspace);
                return accept;
            }
            // Back and forward through the places visited, as in a browser.
            if (event.modifiers.alt && !root.modal-open && event.text == Key.LeftArrow) {
                root.nav-back();
                return accept;
            }
            if (event.modifiers.alt && !root.modal-open && event.text == Key.RightArrow) {
                root.nav-forward();
                return accept;
            }
            if (event.text == "k" && event.modifiers.control
                && (!root.modal-open || root.palette-open)) {
                root.palette-open = !root.palette-open;
                return accept;
            }
            // Ctrl+C copies what is selected in a message; it used to be taken for
            // "c" and opened a new message.
            if (event.text == "c" && event.modifiers.control) {
                if (!root.modal-open) {
                    // A message shown as text, all of it selected from its menu.
                    if (MessageText.all-selected >= 0) {
                        root.copy-message-text(MessageText.all-selected);
                    } else {
                        root.copy-requested();
                    }
                }
                return accept;
            }
            // "?" lists the keys.
            if (event.text == "?" && !root.modal-open) {
                root.shortcuts-help-open = true;
                return accept;
            }
            if (event.text == Key.Escape && root.shortcuts-help-open) {
                root.shortcuts-help-open = false;
                return accept;
            }
            if (event.text == Key.Escape && root.first-run) {
                root.first-run = false;
                return accept;
            }
            // The pairing panel sits over the settings: it closes first.
            if (event.text == Key.Escape && root.pair-open) {
                root.pair-open = false;
                root.pair-closed();
                return accept;
            }
            if (event.text == Key.Escape && root.mailboxes-open) {
                root.mailboxes-open = false;
                return accept;
            }
            if (event.text == Key.Escape && root.tasks-column-open) {
                root.tasks-column-open = false;
                return accept;
            }
            // A conversation open as a page on a phone: Escape is Back.
            if (event.text == Key.Escape && root.fil-en-page && !root.modal-open) {
                root.page = "";
                root.navigated("page", "");
                return accept;
            }
            // "c" writes a new message, the convention every mail client shares.
            if (event.text == "c" && !root.modal-open) {
                root.compose-minimised = false;
                root.compose-open = true;
                return accept;
            }
            // Escape does not throw away a draft: leaving the window open is
            // recoverable, losing what someone wrote is not.
            if (event.text == Key.Escape && root.problem-open) {
                root.problem-open = false;
                return accept;
            }
            if (event.text == Key.Escape && root.context-menu-open) {
                root.context-menu-open = false;
                return accept;
            }
            if (event.text == Key.Escape && root.reader-menu != "") {
                root.reader-menu = "";
                return accept;
            }
            if (event.text == Key.Escape && root.task-later-open) {
                root.task-later-open = false;
                return accept;
            }
            if (event.text == Key.Escape && root.task-slot-open) {
                root.task-slot-open = false;
                return accept;
            }
            // Escape asks, like the close button, when something is written; an
            // open question is answered "no" by Escape.
            if (event.text == Key.Escape && root.compose-open && root.compose-confirm-close) {
                root.compose-confirm-close = false;
                return accept;
            }
            if (event.text == Key.Escape && root.compose-open) {
                if (root.compose-has-content) {
                    root.compose-minimised = false;
                    root.compose-confirm-close = true;
                } else {
                    root.compose-dismissed();
                    root.compose-open = false;
                }
                return accept;
            }
            // The small month first: Escape folds it and leaves the event open.
            if (event.text == Key.Escape && root.event-editor-open && root.editor-picker >= 0) {
                root.editor-picker = -1;
                return accept;
            }
            if (event.text == Key.Escape && root.event-editor-open) {
                root.event-editor-open = false;
                return accept;
            }
            if (event.text == Key.Escape && root.task-list-menu-open) {
                root.task-list-menu-open = false;
                return accept;
            }
            if (event.text == Key.Escape && root.task-list-name-open) {
                root.task-list-name-open = false;
                return accept;
            }
            if (event.text == Key.Escape && root.task-list-delete-open) {
                root.task-list-delete-open = false;
                return accept;
            }
            if (event.text == Key.Escape && root.link-menu-open) {
                root.link-menu-open = false;
                return accept;
            }
            if (event.text == Key.Escape && root.empty-folder-open) {
                root.empty-folder-open = false;
                return accept;
            }
            if (event.text == Key.Escape && root.calendar-menu-open) {
                root.calendar-menu-open = false;
                return accept;
            }
            if (event.text == Key.Escape && root.event-menu-open) {
                root.event-menu-open = false;
                return accept;
            }
            if (event.text == Key.Escape && root.scheduled-open) {
                root.scheduled-open = false;
                return accept;
            }
            if (event.text == Key.Escape && root.sort-menu-open) {
                root.sort-menu-open = false;
                return accept;
            }
            if (event.text == Key.Escape && root.calendar-rename-open) {
                root.calendar-rename-open = false;
                return accept;
            }
            if (event.text == Key.Escape && root.calendar-delete-open) {
                root.calendar-delete-open = false;
                return accept;
            }
            if (event.text == Key.Escape && root.event-detail-open) {
                root.event-detail-open = false;
                return accept;
            }
            if (event.text == Key.Escape && root.subscribe-open && !root.subscribe-busy) {
                root.subscribe-open = false;
                return accept;
            }
            if (event.text == Key.Escape && SheetGrid.menu != "") {
                SheetGrid.menu = "";
                return accept;
            }
            if (event.text == Key.Escape && root.notes-history-open) {
                root.notes-history-open = false;
                return accept;
            }
            if (event.text == Key.Escape && root.notes-graph-open) {
                root.notes-graph-open = false;
                return accept;
            }
            if (event.text == Key.Escape && root.notes-review-open) {
                root.notes-review-open = false;
                return accept;
            }
            if (event.text == Key.Escape && root.notes-quick-open) {
                root.notes-quick-open = false;
                return accept;
            }
            if (event.text == Key.Escape && root.notes-name-asked != "") {
                root.notes-name-asked = "";
                return accept;
            }
            if (event.text == Key.Escape && root.notes-area-menu-open) {
                root.notes-area-menu-open = false;
                return accept;
            }
            if (event.text == Key.Escape && root.notes-row-menu-open) {
                root.notes-row-menu-open = false;
                return accept;
            }
            if (event.text == Key.Escape && root.notes-space-menu-open) {
                root.notes-space-menu-open = false;
                return accept;
            }
            if (event.text == Key.Escape && root.connect-open && !root.connect-busy) {
                root.connect-open = false;
                root.connect-password = "";
                return accept;
            }
            if (event.text == Key.Escape && root.tags-open) {
                root.tags-open = false;
                return accept;
            }
            if (event.text == Key.Escape && root.account-menu-open) {
                root.account-menu-dismissed();
                return accept;
            }
            if (event.text == Key.Escape && root.changelog-open) {
                root.changelog-open = false;
                return accept;
            }
            // Not while installing: the choice is made, and the panel is the only
            // thing saying what is happening.
            if (event.text == Key.Escape && root.update-open && !root.update-busy) {
                root.update-open = false;
                return accept;
            }
            if (event.text == Key.Escape && root.source-open) {
                root.source-open = false;
                return accept;
            }
            if (event.text == Key.Escape && root.modules-open) {
                root.modules-open = false;
                return accept;
            }
            if (event.text == Key.Escape && root.add-account-open) {
                root.add-account-open = false;
                return accept;
            }
            // On a phone, an account's page goes back to the accounts, a group of
            // settings open as a page to the list.
            if (event.text == Key.Escape && root.settings-open && root.settings-account >= 0) {
                root.settings-account = -1;
                return accept;
            }
            if (event.text == Key.Escape && root.settings-open && root.settings-group != "") {
                root.settings-group = "";
                return accept;
            }
            if (event.text == Key.Escape && root.settings-open) {
                root.settings-open = false;
                return accept;
            }
            if (event.text == Key.Escape && root.palette-open) {
                root.palette-open = false;
                return accept;
            }
            // Nothing below this line reaches past an open window: Escape, handled
            // above, is the only key that concerns it.
            if (root.modal-open) {
                return accept;
            }
            // Home has no keys of its own, and the mail's do not reach through it.
            if (root.workspace == 3) {
                return accept;
            }
            // Notes: a new one, one opened by name; none of the mail's keys.
            if (root.workspace == 4) {
                if (event.modifiers.control && event.text == "n") {
                    root.notes-new-note();
                }
                // A note by name, opened here or (Ctrl+\) beside the one open.
                if (event.modifiers.control && (event.text == "o" || event.text == "\\")) {
                    root.notes-quick-beside = event.text == "\\";
                    root.notes-quick-moving = "";
                    root.notes-quick-search = false;
                    root.notes-quick-query = "";
                    root.notes-quick-highlight = 0;
                    root.notes-quick-open = true;
                    root.notes-quick-edited("");
                }
                // Search in the notes' words.
                if (event.modifiers.control && event.modifiers.shift
                    && (event.text == "f" || event.text == "F")) {
                    root.notes-quick-beside = false;
                    root.notes-quick-moving = "";
                    root.notes-quick-search = true;
                    root.notes-quick-query = "";
                    root.notes-quick-highlight = 0;
                    root.notes-quick-open = true;
                    root.notes-quick-edited("");
                }
                if (event.modifiers.control && (event.text == "r" || event.text == "R")) {
                    root.note-reading-toggled();
                }
                if (event.text == Key.F11) {
                    root.note-focus-mode-toggled();
                }
                if (event.modifiers.control && (event.text == "g" || event.text == "G")) {
                    root.notes-graph-requested();
                }
                // Tabs.
                if (event.modifiers.control && (event.text == "t" || event.text == "T")) {
                    root.notes-tab-new();
                }
                if (event.modifiers.control && (event.text == "w" || event.text == "W")) {
                    root.notes-tab-closed(root.notes-tab-active);
                }
                if (event.modifiers.control && root.notes-tabs.length > 1
                    && (event.text == Key.Tab || event.text == Key.Backtab)) {
                    root.notes-tab-chosen(event.modifiers.shift || event.text == Key.Backtab
                        ? mod(root.notes-tab-active + root.notes-tabs.length - 1, root.notes-tabs.length)
                        : mod(root.notes-tab-active + 1, root.notes-tabs.length));
                }
                if (event.text == Key.F2 && root.notes-tree.length > 0) {
                    root.notes-row-action("rename", "");
                }
                if (event.text == Key.Return && root.note-open) {
                    root.note-end-clicked();
                }
                return accept;
            }
            // The calendar has its own keys, and none of the mail's: "e" in the
            // calendar must not mark as done a thread nobody can see.
            if (root.workspace == 1) {
                // The last change made in the calendar, undone: a move, a stretch, a
                // delete, a colour.
                if (event.text == "z" && event.modifiers.control) {
                    root.calendar-undo();
                    return accept;
                }
                if (event.text == "t") { root.calendar-today(); }
                if (event.text == "n") { root.calendar-new-event("", -1); }
                if (event.text == "m" || event.text == "w" || event.text == "d") {
                    let m = event.text == "m" ? 0 : event.text == "w" ? 1 : 2;
                    root.calendar-mode-chosen(m);
                    root.navigated("calendar-mode", "\{m}");
                }
                if (event.text == Key.LeftArrow) { root.calendar-navigate(-1); }
                if (event.text == Key.RightArrow) { root.calendar-navigate(1); }
                return accept;
            }
            // The habits, in Tasks: N puts the cursor in the line that adds one, the
            // arrows move, space ticks today.
            if (root.workspace == 2 && root.tasks-habits) {
                if (event.text == "n") { root.habits-focus-add += 1; }
                if (event.text == Key.DownArrow || event.text == "j") { root.habit-move(1); }
                if (event.text == Key.UpArrow || event.text == "k") { root.habit-move(-1); }
                if (event.text == " ") { root.habit-toggle-selected(); }
                if (event.text == Key.Escape && root.habits-has-detail) { root.habit-detail-closed(); }
                return accept;
            }
            // The tasks have their own keys too, a goal's page among them.
            if (root.workspace == 2) {
                if (event.text == "z" && event.modifiers.control) {
                    root.task-undo();
                    return accept;
                }
                if (event.text == "n") { root.task-focus-add += 1; }
                if (event.text == Key.DownArrow || event.text == "j") { root.task-move(1); }
                if (event.text == Key.UpArrow || event.text == "k") { root.task-move(-1); }
                if (event.text == " ") { root.task-toggle-selected(); }
                if (event.text == Key.Delete && root.task-has-detail) { root.task-delete(); }
                if (event.text == "d" && root.task-has-detail) { root.task-picker-toggled(); }
                // "l": later, for the task shown; the menu in the middle of the window.
                if (event.text == "l" && root.task-has-detail && !root.task-detail.done) {
                    root.task-later-id = root.task-detail.id;
                    root.task-later-x = root.width / 2 - 120px;
                    root.task-later-y = root.height / 3;
                    root.task-later-requested(root.task-detail.id);
                }
                if (event.text == Key.Escape) {
                    if (root.task-picker-open) {
                        root.task-picker-open = false;
                    } else if (root.task-has-detail) {
                        root.task-detail-closed();
                    }
                }
                return accept;
            }
            // "t": the selected conversation goes to the tasks.
            if (event.text == "t" && !event.modifiers.control && root.selected-thread >= 0) {
                root.thread-to-task(root.selected-thread);
                return accept;
            }
            // Ctrl+R answers the conversation being read, in the composer; with Shift,
            // everyone in it. Bare R stays read or unread.
            if (event.modifiers.control && (event.text == "r" || event.text == "R")
                && root.selected-thread >= 0 && !root.conversation-empty) {
                root.reply-requested(event.modifiers.shift);
                return accept;
            }
            if (event.text == "f" && event.modifiers.control) {
                root.focus-search();
                return accept;
            }
            // Échap quitte la recherche avant tout le reste : c'est le geste de
            // sortie universel, et il doit marcher sans viser un bouton.
            if (event.text == Key.Escape && root.searching) {
                root.search-query = "";
                root.search-cleared();
                return accept;
            }
            // Escape brings the accounts and the list back after reading full screen.
            if (event.text == Key.Escape && root.reading-focus) {
                root.reading-focus = false;
                return accept;
            }

            // Échap vide la sélection avant tout le reste des files : c'est le geste
            // de sortie d'un mode, et un lot coché est un mode.
            if (event.text == Key.Escape && root.marked-count > 0) {
                root.bulk-clear();
                return accept;
            }

            // Suppr supprime. C'était « # », choisi parce qu'une lettre nue est trop
            // facile à heurter — mais Suppr n'est pas une lettre, personne ne
            // l'atteint par accident, et c'est la touche que tout le monde essaie en
            // premier. « # » reste, pour qui l'a appris.
            if (event.text == Key.Delete) {
                root.bulk-delete();
                return accept;
            }

            // Annuler et rétablir, aux touches de partout. Le clavier les envoie avant
            // que la table de raccourcis ne les voie, parce que ce sont des
            // combinaisons et que la table ne connaît que des touches nues.
            if (event.text == "z" && event.modifiers.control && event.modifiers.shift) {
                root.redo();
                return accept;
            }
            if (event.text == "Z" && event.modifiers.control) {
                root.redo();
                return accept;
            }
            if (event.text == "z" && event.modifiers.control) {
                root.undo();
                return accept;
            }
            if (event.text == "y" && event.modifiers.control) {
                root.redo();
                return accept;
            }

            root.key-pressed(event.text);
            return accept;
        }
    }

    // The window's frame, shared by every place: what its buttons and its switcher ask.
    property <int> chrome-request <=> Chrome.request-id;
    changed chrome-request => {
        if (Chrome.request == "workspace") {
            if (Chrome.request-arg == root.workspace) {
                root.place-root();
            }
            root.workspace = Chrome.request-arg;
            root.workspace-changed(Chrome.request-arg);
            shortcuts.focus();
        } else if (Chrome.request == "minimise") {
            root.window-minimise();
        } else if (Chrome.request == "maximise") {
            root.window-toggle-maximise();
        } else if (Chrome.request == "close") {
            root.window-close();
        } else if (Chrome.request == "back") {
            root.nav-back();
            shortcuts.focus();
        } else if (Chrome.request == "forward") {
            root.nav-forward();
            shortcuts.focus();
        } else if (Chrome.request == "settings") {
            root.settings-open = true;
        } else if (Chrome.request == "palette") {
            // On a phone, Home's magnifier: the search everywhere, as a page.
            if (Layout.compact) {
                root.everywhere-open = true;
            } else {
                root.palette-open = true;
            }
        }
    }
    property <int> chrome-drag-start <=> Chrome.drag-start-id;
    changed chrome-drag-start => { root.window-drag-started(); }
    property <int> chrome-drag <=> Chrome.drag-id;
    changed chrome-drag => { root.window-drag(Chrome.drag-dx, Chrome.drag-dy); }

    /// A conversation is open as a page over the list (a phone).
    property <bool> fil-en-page: Layout.compact && root.page == "thread";
    /// Below 840 pixels, the accounts and folders opened from the list's title, as a
    /// page the whole width. Choosing one closes it.
    in-out property <bool> mailboxes-open;
    /// Below 840 pixels, the tasks' column (the views, the habits, the goals, the
    /// lists) open as a page from the list's "Lists" button.
    in-out property <bool> tasks-column-open;
    /// The search everywhere, a page of its own on a phone (`partout.rs`).
    in-out property <bool> everywhere-open;
    in-out property <string> everywhere-text;
    in property <[EverywhereHitData]> everywhere-hits;
    callback everywhere-query(string);
    callback everywhere-task-toggled(string);
    /// What a swipe just did to a conversation, with Undo under it ("" when none).
    in-out property <string> undo-snack;
    /// What the window keeps at its foot: the status bar, or in a narrow window the
    /// five places above the system's gesture bar.
    property <length> pied: Layout.compact ? max(66px + Layout.inset-bottom, root.clavier) : 30px;
    /// What the phone's keyboard covers at the foot of the window while it is up. The
    /// places end above it, as they end above the tabs: the line being typed in (a
    /// task to add) rises over the keyboard instead of staying under it.
    property <length> clavier: self.virtual-keyboard-size.height > 0
        ? max(0px, self.height - self.virtual-keyboard-position.y) : 0px;
    /// What the rail of places takes at the left, at medium width.
    property <length> rail: Layout.medium ? 80px : 0px;
    /// The accounts column folded to a strip: 0 open, 1 folded, animated between.
    property <float> pli: root.sidebar-collapsed ? 1 : 0;
    animate pli { duration: Tokens.quick; easing: ease-in-out; }

    // Android's Back, whatever has the keyboard: a field of New message, the reader,
    // a window. It reaches the app before them (the shortcuts below take it only when
    // they have the keyboard), and the app closes what is open, then the page, then
    // goes back in the history. Never focused, never in the way of a click.
    FocusScope {
        focus-on-click: false;
        width: 100%;
        height: 100%;
        capture-key-pressed(event) => {
            if (event.text == Key.Back) {
                root.system-back();
                return accept;
            }
            reject
        }

        Backdrop {
            width: 100%;
            height: 100%;

            // Removing the system frame removes the outline it drew. Without one, a dark
            // window on a dark desktop has no boundary at all — it looks like a hole
            // rather than a window.
            Rectangle {
                width: 100%;
                height: 100%;
                border-width: 1px;
                border-color: Tokens.border-strong;
                background: transparent;
            }

            VerticalLayout {
                // The status bar, when the system draws it over the window; the
                // keyboard, which hides the tabs while it is up.
                padding-top: Layout.inset-top;
                padding-bottom: Layout.compact ? root.clavier : 0px;
                padding-left: root.rail;
                HorizontalLayout {
                    // The mail's columns, only while the mail is shown. The calendar, the
                    // tasks and Home are laid over them, and a part of those without a
                    // touch area of its own let the click through to the mail underneath
                    // ("Today" opened New message); the software renderer, redrawing only
                    // what changed, painted bits of the mail through them while a task was
                    // carried. Hidden, the mail is neither drawn nor hit.
                    visible: root.workspace == 0;
                    // Colonne 1 : les comptes, in the window's sidebar under the places.
                    SidebarFrame {
                    // Reading full screen: the accounts and the list step aside. So they
                    // do below 840 pixels, where the title of the list opens them as a
                    // page of their own, the whole width.
                    // On a phone the mailboxes are a sheet over the list instead (below).
                    visible: (root.mailboxes-open && !Layout.compact)
                        || (!root.reading-focus && Layout.width-class == WidthClass.expanded);
                    // Only the folding is animated: a window that changes layout (or a
                    // window given its size at start) gets its columns at once.
                    sidebar-width: root.mailboxes-open && Layout.compact ? 0px
                        : root.mailboxes-open ? Layout.window-width - root.rail
                        : root.reading-focus || Layout.width-class != WidthClass.expanded ? 0px
                        : 232px - 168px * root.pli;
                    compact: root.sidebar-collapsed;
                    Sidebar {
                        vertical-stretch: 1;
                        folder-open: root.selected-folder != "";
                        pinned: root.pinned-accounts;
                        others: root.other-accounts;
                        selected-id: root.selected-account;
                        unified-count: root.unified-count;
                        unified-label: root.unified-label;
                        unified-full: root.unified-full;
                        filter <=> root.account-filter;
                        syncing: root.syncing-all;
                        sync-progress: root.sync-progress;
                        last-sync: root.last-sync;
                        account-total: root.account-count;
                        collapsed <=> root.sidebar-collapsed;
                        account-selected(id) => {
                            root.mailboxes-open = false;
                            root.account-selected(id);
                            root.navigated("account", "\{id}");
                            shortcuts.focus();
                        }
                        unified-selected => {
                            root.mailboxes-open = false;
                            root.unified-selected();
                            root.navigated("unified", "");
                            shortcuts.focus();
                        }
                        resume-account(id) => { root.resume-account(id); }
                        add-account => { root.add-account-open = true; }
                        filter-changed(t) => { root.account-filter-changed(t); }
                        sync-account(id) => { root.sync-account(id); }
                        sync-all => { root.sync-all(); }
                        open-tags => { root.tags-requested(); }
                        closed => {
                            root.mailboxes-open = false;
                            shortcuts.focus();
                        }
                        grouped: root.group-by-tags;
                        selected-tag: root.selected-tag;
                        tag-selected(t) => {
                            root.mailboxes-open = false;
                            root.tag-selected(t);
                            root.navigated("tag", "\{t}");
                            shortcuts.focus();
                        }
                        tag-fold-toggled(t) => { root.tag-fold-toggled(t); }
                        group-toggled => {
                            root.group-by-tags = !root.group-by-tags;
                            root.group-by-tags-changed();
                        }
                        probe: root.account-probe;
                        probe-x: root.account-probe-x;
                        probe-y: root.account-probe-y;
                        account-menu(id, mx, my) => {
                            root.account-menu-x = mx;
                            root.account-menu-y = my;
                            root.account-menu-requested(id);
                        }
                        // Brought back full size, even if it was tucked into the corner:
                        // New message is a request to write.
                        compose => {
                            root.compose-minimised = false;
                            root.compose-open = true;
                        }

                        // The folders, under the accounts: "this mailbox, in this folder"
                        // read down one column. Folded with it.
                        if !root.sidebar-collapsed: FolderTree {
                            vertical-stretch: 1;
                            folders: root.folders;
                            selected-path: root.selected-folder;
                            accounts-total: root.account-count;
                            folder-selected(p) => {
                                root.mailboxes-open = false;
                                root.folder-selected(p);
                                root.navigated("folder", p);
                                shortcuts.focus();
                            }
                            all-selected => {
                                root.mailboxes-open = false;
                                root.folder-cleared();
                                root.navigated("folder", "");
                            }
                            folder-fold-toggled(p) => {
                                root.folder-fold-toggled(p);
                                shortcuts.focus();
                            }
                            new-folder => { root.new-folder-requested(); }
                            scheduled: root.scheduled-count;
                            scheduled-requested => { root.scheduled-requested(); }
                            folder-dropped(p) => { root.folder-dropped(p); }
                            folder-menu(p, mx, my) => {
                                root.folder-menu-x = mx;
                                root.folder-menu-y = my;
                                root.folder-menu-requested(p);
                            }
                        }
                    }
                    }

                    VerticalLayout {
                    horizontal-stretch: 1;
                    // The mailboxes open as a page: the list and the reader step aside
                    // (on a phone they rise as a sheet over the list, which stays).
                    visible: !root.mailboxes-open || Layout.compact;
                    max-width: root.mailboxes-open && !Layout.compact ? 0px : 100000px;
                    mail-toolbar := MailToolbar {
                        lights: root.reading-focus;
                        page: root.fil-en-page;
                        title-opens: Layout.width-class != WidthClass.expanded;
                        title-clicked => { root.mailboxes-open = true; }
                        // Back pops the page from the history, which closes it.
                        back => {
                            root.nav-back();
                            if (root.fil-en-page) {
                                root.page = "";
                            }
                            shortcuts.focus();
                        }
                        title: root.folder-name != "" ? root.folder-name : "All accounts";
                        subtitle: root.folder-name != "" ? ""
                            : (root.counts.length > 0 ? root.counts[0] : 0) + " to do";
                        queues: root.folder-name == "" && !root.searching;
                        count-labels: root.count-labels;
                        counts: root.counts;
                        active-tab: root.active-tab;
                        has-thread: !root.conversation-empty;
                        starred: root.selected-starred;
                        focused: root.reading-focus;
                        searching: root.searching;
                        search-query <=> root.search-query;
                        tab-selected(i) => {
                            root.tab-selected(i);
                            root.navigated("tab", "\{i}");
                            shortcuts.focus();
                        }
                        compose => {
                            root.compose-minimised = false;
                            root.compose-open = true;
                        }
                        mark-done => { root.thread-done(); }
                        waiting => { root.thread-waiting(); }
                        to-task => { root.thread-to-task(root.selected-thread); }
                        archive => { root.thread-archive(); }
                        delete-thread => { root.thread-delete(); }
                        toggle-star => { root.thread-toggle-star(); }
                        toggle-focus => { root.reading-focus = !root.reading-focus; }
                        snooze-menu(mx, my) => {
                            root.reader-menu-x = mx;
                            root.reader-menu-y = my;
                            root.reader-menu = "snooze";
                        }
                        more-menu(mx, my) => {
                            root.reader-menu-x = mx;
                            root.reader-menu-y = my;
                            root.reader-menu = "more";
                        }
                        search-submitted(q) => { root.search-submitted(q); }
                        search-cleared => { root.search-cleared(); }
                    }
                    // On a phone's list, the large head of the mockup (M1).
                    // Conversations selected on a phone: their bar takes the title's place.
                    if Layout.compact && !root.fil-en-page && root.marked-count > 0: PhoneSelectionBar {
                        count-label: root.marked-label;
                        mark-done => { root.bulk-done(); }
                        archive => { root.bulk-archive(); }
                        delete-selected => { root.bulk-delete(); }
                        mark-read => { root.bulk-read(); }
                        select-all => { root.bulk-select-all(); }
                        clear => { root.bulk-clear(); }
                    }
                    if Layout.compact && !root.fil-en-page && !root.searching && mail-toolbar.hidden
                        && root.marked-count == 0: PhoneMailHeader {
                        title: root.folder-name != "" ? root.folder-name : "All accounts";
                        subtitle: (root.folder-name != "" ? ""
                            : (root.counts.length > 0 ? root.counts[0] : 0) + " to do")
                            + (root.last-sync != "" && root.folder-name == "" ? " · " + root.last-sync.to-lowercase() : "");
                        queues: root.folder-name == "";
                        count-labels: root.count-labels;
                        counts: root.counts;
                        active-tab: root.active-tab;
                        title-clicked => { root.mailboxes-open = true; }
                        search => { mail-toolbar.focus-search(); }
                        tab-selected(i) => {
                            root.tab-selected(i);
                            root.navigated("tab", "\{i}");
                            shortcuts.focus();
                        }
                    }
                    HorizontalLayout {
                    // Colonne 2 : la file de travail. On a phone the whole width, until a
                    // conversation is opened over it; on a foldable a narrower column.
                    Rectangle {
                        visible: !self.cache;
                        // Bounds rather than a width: a width taken from the parent would
                        // loop through the layout.
                        property <bool> cache: root.reading-focus || root.fil-en-page
                            || (root.mailboxes-open && !Layout.compact);
                        min-width: self.cache || Layout.compact ? 0px : Layout.medium ? 300px : 360px;
                        max-width: self.cache ? 0px : Layout.compact ? 100000px : Layout.medium ? 300px : 360px;
                        horizontal-stretch: Layout.compact && !self.cache ? 1 : 0;
                        // On a phone the window's grey ground, the conversations white
                        // cards on it under their day (the mockups' M1).
                        background: Layout.compact ? Tokens.background : Tokens.surface;

                        liste := ThreadListView {
                            width: 100%;
                            height: 100%;
                            rows: root.rows;
                            searching: root.searching;
                            search-summary: root.search-summary;
                            search-explanation: root.search-explanation;
                            search-query <=> root.search-query;
                            search-submitted(q) => { root.search-submitted(q); }
                            search-cleared => { root.search-cleared(); }
                            search-pills: root.search-pills;
                            search-pill(i) => { root.search-pill(i); }
                            row-context-menu(id, mx, my, non-lu, epingle) => {
                                // Plus de `thread-selected` : un clic droit ouvrait le
                                // message, chargeait son corps et le marquait lu, pour
                                // quelqu'un qui voulait seulement voir les actions
                                // possibles — dont « Delete ». Le menu porte sa cible.
                                root.context-menu-thread = id;
                                root.context-menu-unread = non-lu;
                                root.context-menu-starred = epingle;
                                // Déjà en coordonnées de fenêtre. Rien à rajouter : la
                                // version précédente recollait des largeurs de colonnes
                                // écrites en dur, qui devenaient fausses à la première
                                // colonne ajoutée — et il y en a une de plus depuis.
                                root.context-menu-x = mx;
                                root.context-menu-y = my;
                                root.context-menu-open = true;
                            }
                            selected-id: root.selected-thread;
                            menu-target: root.context-menu-open ? root.context-menu-thread : -1;
                            active-tab: root.active-tab;
                            counts: root.counts;
                            count-labels: root.count-labels;
                            count-fulls: root.count-fulls;
                            folder-name: root.folder-name;
                            inbox-zero-streak: root.inbox-zero-streak;
                            folder-left => { root.folder-cleared(); }
                            marked-count: root.marked-count;
                            drag-payload: root.drag-payload;
                            marked-label: root.marked-label;
                            filter-unread: root.filter-unread;
                            filter-attachments: root.filter-attachments;
                            filter-starred: root.filter-starred;
                            filter-toggled(quoi) => { root.filter-toggled(quoi); }
                            sort-label: root.list-sort == 1 ? "Sender" : root.list-sort == 2 ? "Subject"
                                : root.list-sort == 3 ? "Size" : "Date";
                            sort-menu(x, y) => {
                                root.sort-menu-x = x;
                                root.sort-menu-y = y;
                                root.sort-menu-open = true;
                            }
                            row-mark-toggled(id) => { root.row-mark-toggled(id); }
                            row-drag-started(id) => { root.row-drag-started(id); }
                            row-mark-extended(id) => { root.row-mark-extended(id); }
                            // The same actions the right-click menu carries, on the row.
                            row-quick(id, what) => {
                                if (what == "done") {
                                    root.menu-done(id);
                                } else if (what == "snooze") {
                                    root.menu-snooze(id, "tomorrow");
                                } else {
                                    root.menu-archive(id);
                                }
                                // A finger's swipe, on a phone: say it, and offer it back.
                                if (Layout.touch-input) {
                                    root.undo-snack = what == "done" ? "Done"
                                        : what == "snooze" ? "Snoozed until tomorrow morning"
                                        : "Archived";
                                }
                                shortcuts.focus();
                            }
                            bulk-done => { root.bulk-done(); }
                            bulk-archive => { root.bulk-archive(); }
                            bulk-delete => { root.bulk-delete(); }
                            bulk-read => { root.bulk-read(); }
                            bulk-unread => { root.bulk-unread(); }
                            bulk-select-all => { root.bulk-select-all(); }
                            bulk-clear => { root.bulk-clear(); }
                            loading: root.loading;
                            // Picking a thread with the mouse hands the keyboard to the
                            // shortcuts, so « e » acts on it even after a search field had it.
                            row-clicked(id) => {
                                root.thread-selected(id);
                                // On a phone the conversation is a page over the list.
                                if (Layout.compact) {
                                    root.page = "thread";
                                    root.navigated("page", "thread");
                                }
                                shortcuts.focus();
                            }
                            tab-selected(i) => {
                                root.tab-selected(i);
                                root.navigated("tab", "\{i}");
                                shortcuts.focus();
                            }
                            scrolled-near-end => { root.scrolled-near-end(); }
                        }
                        // On a phone, New message floats over the list's bottom right.
                        if Layout.compact && !root.searching && root.marked-count == 0: Fab {
                            x: parent.width - self.width - 16px;
                            y: parent.height - self.height - 16px;
                            text: "New message";
                            icon: Icons.pencil;
                            clicked => {
                                root.compose-minimised = false;
                                root.compose-open = true;
                            }
                        }
                    }

                    Rectangle { width: root.reading-focus || Layout.compact ? 0px : 1px; background: Tokens.border; }

                    // Colonne 3 : la conversation, on the plain surface the list has. On a
                    // phone only as a page, opened from the list.
                    Rectangle {
                    visible: (!Layout.compact || root.fil-en-page) && !root.mailboxes-open;
                    // A zero maximum alone lost to the reader's own minimum width: on a phone
                    // it kept a strip of the screen, and the list only what was left.
                    min-width: (Layout.compact && !root.fil-en-page) || root.mailboxes-open ? 0px : 200px;
                    max-width: (Layout.compact && !root.fil-en-page) || root.mailboxes-open ? 0px : 100000px;
                    horizontal-stretch: (Layout.compact && !root.fil-en-page) || root.mailboxes-open ? 0 : 1;
                    background: Tokens.surface;
                    ConversationView {
                        width: 100%;
                        height: 100%;
                        body-width-changed(w) => { root.reader-width(w); }
                        message: root.message;
                        messages: root.messages;
                        toggle-message(id) => { root.toggle-message(id); }
                        empty: root.conversation-empty;
                        starred: root.selected-starred;
                        account-email: root.selected-account-email;
                        folder-label: root.selected-folder-label;
                        folder-all: root.selected-folder-all;
                        folder-alarming: root.selected-folder-alarming;
                        account-tint: root.selected-account-tint;
                        focused: root.reading-focus;
                        archive => { root.thread-archive(); }
                        delete-thread => { root.thread-delete(); }
                        toggle-star => { root.thread-toggle-star(); }
                        waiting => { root.thread-waiting(); }
                        toggle-focus => { root.reading-focus = !root.reading-focus; }
                        snooze-menu(mx, my) => {
                            root.reader-menu-x = mx;
                            root.reader-menu-y = my;
                            root.reader-menu = "snooze";
                        }
                        more-menu(mx, my) => {
                            root.reader-menu-x = mx;
                            root.reader-menu-y = my;
                            root.reader-menu = "more";
                        }
                        mark-done => { root.thread-done(); }
                        to-task => { root.thread-to-task(root.selected-thread); }
                        reply(tous) => { root.reply-requested(tous); }
                        reply-menu(mx, my) => {
                            root.reader-menu-x = mx;
                            root.reader-menu-y = my;
                            root.reader-menu = "reply";
                        }
                        load-images => { root.load-images(); }
                        save-attachment(i) => { root.save-attachment(i); }
                        open-attachment(i) => { root.open-attachment(i); }
                        invite-accept(id) => { root.invite-accept(id); }
                        invite-open(k, d) => { root.invite-open(k, d); }
                        invite-answer(id, a) => { root.invite-answer(id, a); }
                        unsubscribe(id) => { root.unsubscribe(id); }
                        body-tile-wanted(m, t) => { root.body-tile-wanted(m, t); }
                        body-tile-released(m, t) => { root.body-tile-released(m, t); }
                        body-select(m, t, x, y, p) => {
                            // Words chosen in another body end a "Select all" of a text one.
                            MessageText.all-selected = -1;
                            root.body-select(m, t, x, y, p);
                        }
                        body-link(m, t, x, y) => { root.body-link(m, t, x, y); }
                        body-link-at(m, t, x, y) => { return root.body-link-at(m, t, x, y); }
                        message-link(l) => { root.message-link(l); }
                        body-menu(m, t, fx, fy, x, y) => { root.body-menu(m, t, fx, fy, x, y); }
                        // Left, it is forgotten only if it was still this block's: the
                        // next block may have said it was under the pointer first.
                        message-link-hovered(on, l, t) => {
                            if (on) {
                                root.hovered-link = l;
                                root.hovered-link-text = t;
                            } else if (root.hovered-link == l) {
                                root.hovered-link = "";
                                root.hovered-link-text = "";
                            }
                        }
                        // The text had no use for the key: the shortcuts get it, and
                        // the keyboard with it.
                        keys-left(t) => {
                            shortcuts.focus();
                            // The menu opened over the words, which kept the keyboard:
                            // Escape closes it at once.
                            if (t == Key.Escape && root.link-menu-open) {
                                root.link-menu-open = false;
                            } else {
                                root.key-redispatch(t);
                            }
                        }
                        // A right-click in a body shown as text: Copy what its words have
                        // selected, Select all of them. The words keep the keyboard, and
                        // their selection with it, until the menu closes.
                        text-menu(id, x, y) => {
                            root.link-menu-kind = "";
                            root.link-menu-target = "";
                            root.link-menu-text = "";
                            root.link-menu-selection = MessageText.has-selection
                                || MessageText.all-selected >= 0;
                            root.link-menu-message = id;
                            root.link-menu-text-body = true;
                            root.link-menu-x = x;
                            root.link-menu-y = y;
                            root.link-menu-open = true;
                        }
                        bodies-suspended: root.bodies-suspended;
                    }
                    }
                    }
                    }
                }

                if Layout.compact && root.clavier == 0: TabBar {}
                if !Layout.compact: StatusBar {
                    side: root.cote;
                    status <=> root.status;
                    version: root.version;
                    vitals: root.vitals;
                    syncing: root.syncing;
                    pending-ops: root.pending-ops;
                    update-version: root.update-version;
                    open-changelog => { root.changelog-open = true; }
                    open-update => { root.update-open = true; }
                }
            }

            // The places down the left at medium width; the columns step aside for it.
            if Layout.medium: NavRail {
                x: 0px;
                y: 0px;
                height: parent.height - root.pied;
            }
        }

        // The calendar covers everything between the title bar and the status bar. Over
        // the mail rather than instead of it: coming back to the mail finds it exactly as
        // it was left - same list, same scroll, same open thread.
        // Flush with the window, as the mail is: a pixel's inset, kept from the old
        // frame, showed as a pale line all round.
        if root.workspace == 1: CalendarView {
            x: root.rail;
            y: Layout.inset-top;
            width: parent.width - root.rail;
            height: parent.height - root.pied - Layout.inset-top;
            title: root.calendar-title;
            mode: root.calendar-mode;
            calendars: root.calendars;
            mini-title: root.calendar-mini-title;
            mini-cells: root.calendar-mini-cells;
            month-cells: root.calendar-month-cells;
            week-days: root.calendar-week-days;
            week-events: root.calendar-week-events;
            agenda: root.calendar-agenda;
            now-fraction: root.calendar-now-fraction;
            now-day: root.calendar-now-day;
            navigate(n) => { root.calendar-navigate(n); }
            today => { root.calendar-today(); }
            mode-chosen(m) => {
                root.calendar-mode-chosen(m);
                root.navigated("calendar-mode", "\{m}");
            }
            day-chosen(d) => { root.calendar-day-chosen(d); }
            day-opened(d) => { root.calendar-day-opened(d); }
            mini-navigate(n) => { root.calendar-mini-navigate(n); }
            event-anchored(l, r, t) => {
                root.event-anchored = true;
                root.event-anchor-left = l;
                root.event-anchor-right = r;
                root.event-anchor-top = t;
            }
            event-opened(k) => { root.calendar-event-opened(k); }
            new-event(d, m) => { root.calendar-new-event(d, m); }
            quick-event(d, m, t) => { root.calendar-quick-event(d, m, t); }
            // The line typed in the grid is saved or dropped: the keys go back to the
            // calendar's shortcuts.
            draft-closed => { shortcuts.focus(); }
            to-plan: root.calendar-to-plan;
            event-moved(k, d, m) => { root.calendar-event-moved(k, d, m); }
            event-menu(k, x, y) => {
                // Where the card opens if "Open" is chosen: beside the pointer.
                root.event-anchor-left = x;
                root.event-anchor-right = x;
                root.event-anchor-top = y;
                root.calendar-event-menu(k, x, y);
            }
            event-resized(k, m) => { root.calendar-event-resized(k, m); }
            event-stretching(k, m) => { root.calendar-event-stretching(k, m); }
            task-planned(id, d, m) => { root.calendar-task-planned(id, d, m); }
            calendar-toggled(id) => { root.calendar-toggled(id); }
            calendar-refresh(id) => { root.calendar-refresh(id); }
            // The bin on a row asks first, like the menu.
            calendar-remove(c) => {
                root.calendar-menu-cal = c;
                root.calendar-delete-open = true;
            }
            calendar-menu(c, x, y) => {
                root.calendar-menu-cal = c;
                root.calendar-menu-x = x;
                root.calendar-menu-y = y;
                root.calendar-menu-open = true;
            }
            calendar-new => {
                root.calendar-rename-new = true;
                root.calendar-rename-name = "";
                root.calendar-rename-open = true;
            }
            subscribe-requested => {
                root.subscribe-url = "";
                root.subscribe-name = "";
                root.subscribe-open = true;
            }
            connect-requested => {
                root.connect-server = "";
                root.connect-user = "";
                root.connect-password = "";
                root.connect-open = true;
            }
        }

        // The tasks, the goals among them. While the habits show, only the tasks'
        // column, the habits beside it.
        if root.workspace == 2: TasksView {
            x: root.rail;
            y: Layout.inset-top;
            width: root.tasks-habits
                ? (Layout.width-class == WidthClass.expanded ? 232px
                    : root.tasks-column-open ? parent.width - root.rail : 0px)
                : parent.width - root.rail;
            column-open <=> root.tasks-column-open;
            height: parent.height - root.pied - Layout.inset-top;
            column-only: root.tasks-habits;
            habits-shown: root.tasks-habits;
            habits-count: root.habits-nav-count;
            title: root.tasks-title;
            subtitle: root.tasks-subtitle;
            overview: root.task-overview;
            add-tokens: root.task-add-tokens;
            add-edited(t) => { root.task-add-edited(t); }
            open-calendar => {
                root.workspace = 1;
                root.workspace-changed(1);
                shortcuts.focus();
            }
            clear-completed => { root.task-clear-completed(); }
            plan-day => { root.task-plan-day(); }
            unplan-day => { root.task-unplan-day(); }
            task-dropped(id, cle) => { root.task-dropped(id, cle); }
            task-reordered(porte, cible, dessus) => { root.task-reordered(porte, cible, dessus); }
            places: root.task-places;
            rows: root.task-rows;
            add-text <=> root.task-add-text;
            add-hint: root.task-add-hint;
            focus-add-request: root.task-focus-add;
            asking: root.task-asking;
            add-answered(t) => { root.task-add-answered(t); }
            asked-estimate(m) => { root.task-asked-estimate(m); }
            has-detail: root.task-has-detail;
            detail: root.task-detail;
            detail-title <=> root.task-detail-title;
            detail-notes <=> root.task-detail-notes;
            detail-time <=> root.task-detail-time;
            lists: root.task-lists;
            reminders: root.task-reminders;
            repeats: root.task-repeats;
            picker-open: root.task-picker-open;
            picker-title: root.task-picker-title;
            picker-cells: root.task-picker-cells;
            page: root.task-page;
            goals: root.goals;
            nudges: root.goal-nudges;
            goal: root.goal;
            goal-log: root.goal-log;
            goal-chart: root.goal-chart;
            goal-now-x: root.goal-now-x;
            goal-now-y: root.goal-now-y;
            goal-start-label: root.goal-start-label;
            goal-note <=> root.goal-note;
            goal-names: root.goal-names;
            new-goal => { root.goal-new-requested(); }
            goal-logged(t) => { root.goal-logged(t); }
            goal-entry-removed(id) => { root.goal-entry-removed(id); }
            milestone-toggled(id) => { root.milestone-toggled(id); }
            milestone-added(t) => { root.milestone-added(t); }
            make-time => { root.goal-time-requested(); }
            goal-delete => { root.goal-delete-open = true; }
            goal-edit => { root.goal-edit-requested(); }
            goal-renamed(t) => { root.goal-renamed(t); }
            // The title's field closed: the keys go back to the shortcuts.
            goal-rename-closed => { shortcuts.focus(); }
            task-goal-chosen(i) => { root.task-goal-chosen(i); }
            task-later(id, x, y) => {
                root.task-later-id = id;
                root.task-later-x = x;
                root.task-later-y = y;
                root.task-later-requested(id);
            }
            slot-requested(x, y) => {
                root.task-slot-x = x;
                root.task-slot-y = y;
                root.task-slot-requested();
            }
            unbook => { root.task-unbook(); }
            estimate-chosen(m) => { root.task-estimate-chosen(m); }
            estimate-typed(t) => { root.task-estimate-typed(t); }
            // Picking a place or a task with the mouse hands the keyboard back to the
            // shortcuts: the arrows and the space bar then act on the column.
            place-chosen(k) => {
                // On a phone the column was a page of its own: the place chosen replaces it.
                self.column-open = false;
                // "habits": the habits beside the column; any other place, its tasks.
                root.tasks-habits = k == "habits";
                root.task-place-chosen(k);
                root.navigated("tasks", k);
                shortcuts.focus();
            }
            place-menu(p, x, y) => {
                root.task-list-menu-place = p;
                root.task-list-menu-x = x;
                root.task-list-menu-y = y;
                root.task-list-menu-open = true;
            }
            list-new => {
                root.task-list-name-new = true;
                root.task-list-name = "";
                root.task-list-name-open = true;
            }
            add(t) => { root.task-add(t); }
            row-selected(r) => {
                root.task-row-selected(r);
                shortcuts.focus();
            }
            toggled(id) => { root.task-toggled(id); }
            title-edited(t) => { root.task-title-edited(t); }
            notes-edited(t) => { root.task-notes-edited(t); }
            time-edited(t) => { root.task-time-edited(t); }
            picker-toggled => { root.task-picker-toggled(); }
            picker-navigate(n) => { root.task-picker-navigate(n); }
            picker-chosen(d) => { root.task-picker-chosen(d); }
            due-cleared => { root.task-due-cleared(); }
            reminder-chosen(i) => { root.task-reminder-chosen(i); }
            repeat-chosen(i) => { root.task-repeat-chosen(i); }
            priority-chosen(p) => { root.task-priority-chosen(p); }
            list-chosen(i) => { root.task-list-chosen(i); }
            step-added(t) => { root.task-step-added(t); }
            step-toggled(id) => { root.task-step-toggled(id); }
            step-removed(id) => { root.task-step-removed(id); }
            open-mail => { root.task-open-mail(); }
            copy-link => { root.task-copy-link(); }
            // The panel closes with the task: the keyboard goes back to the shortcuts,
            // so Ctrl+Z reaches them.
            delete => {
                root.task-delete();
                shortcuts.focus();
            }
            detail-closed => {
                root.task-detail-closed();
                shortcuts.focus();
            }
        }

        // Home, over everything like the other workspaces.
        if root.workspace == 4: NotesView {
            x: root.rail;
            y: Layout.inset-top;
            width: parent.width - root.rail;
            height: parent.height - root.pied - Layout.inset-top;
            spaces: root.notes-spaces;
            space: root.notes-space;
            tree: root.notes-tree;
            filter <=> root.notes-filter;
            renaming: root.notes-renaming;
            open: root.note-open;
            title: root.note-title;
            path: root.note-path;
            status: root.note-status;
            blocks: root.note-blocks;
            focus-block: root.note-focus;
            focus-serial: root.note-focus-serial;
            focus-cursor: root.note-focus-cursor;
            focus-anchor: root.note-focus-anchor;
            title-serial: root.note-title-serial;
            title-pending <=> root.note-title-pending;
            title-edited(t) => { root.note-title-edited(t); }
            ctrl-held: root.notes-ctrl-held;
            space-menu(x, y) => {
                root.notes-space-menu-x = x;
                root.notes-space-menu-y = y;
                root.notes-space-menu-open = true;
            }
            row-clicked(k) => { root.notes-row-clicked(k); }
            row-toggled(k) => { root.notes-row-toggled(k); }
            row-menu(k, x, y) => {
                root.notes-row-menu-key = k;
                root.notes-row-menu-x = x;
                root.notes-row-menu-y = y;
                root.notes-row-action("menu", k);
                root.notes-row-menu-open = true;
            }
            source-mode: root.note-source-mode;
            source-text: root.note-source-text;
            source-serial: root.note-source-serial;
            source-select-all: root.note-source-select-all;
            source-toggled => { root.note-source-toggled(); }
            source-edited(t) => { root.note-source-edited(t); }
            source-closed => { root.note-source-closed(); }
            col-resized(k, c, w) => { root.note-col-resized(k, c, w); }
            sheet-option(k, o) => { root.note-sheet-option(k, o); }
            tabs: root.notes-tabs;
            tab-active: root.notes-tab-active;
            tab-chosen(i) => { root.notes-tab-chosen(i); }
            tab-closed(i) => { root.notes-tab-closed(i); }
            tab-new => { root.notes-tab-new(); }
            area-menu(x, y) => {
                root.notes-row-menu-x = x;
                root.notes-row-menu-y = y;
                // What is made goes at the top of the space.
                root.notes-row-action("area", ".");
                root.notes-area-menu-open = true;
            }
            renamed(k, t) => {
                root.notes-renamed(k, t);
                shortcuts.focus();
            }
            rename-cancelled => {
                root.notes-rename-cancelled();
                shortcuts.focus();
            }
            moved(k, cible) => { root.notes-moved(k, cible); }
            new-note => { root.notes-new-note(); }
            new-folder => {
                root.notes-name = "";
                root.notes-name-asked = "folder";
            }
            filter-edited(t) => { root.notes-filter-edited(t); }
            quick-open => {
                root.notes-quick-beside = false;
                root.notes-quick-moving = "";
                root.notes-quick-search = false;
                root.notes-quick-query = "";
                root.notes-quick-highlight = 0;
                root.notes-quick-open = true;
                root.notes-quick-edited("");
            }
            block-edited(k, t, c) => { root.note-block-edited(k, t, c); }
            block-key(k, n, c, a, p, d) => {
                if (n == "ctrl+o" || n == "ctrl+\\") {
                    root.notes-quick-beside = n == "ctrl+\\";
                    root.notes-quick-moving = "";
                    root.notes-quick-search = false;
                    root.notes-quick-query = "";
                    root.notes-quick-highlight = 0;
                    root.notes-quick-open = true;
                    root.notes-quick-edited("");
                    return true;
                }
                return root.note-block-key(k, n, c, a, p, d);
            }
            block-clicked(k) => { root.note-block-clicked(k); }
            link-clicked(l) => { root.note-link-clicked(l); }
            task-toggled(k) => { root.note-task-toggled(k); }
            fold-toggled(k) => { root.note-fold-toggled(k); }
            caret(k, x, y, c, a) => { root.note-caret(k, x, y, c, a); }
            completion: root.note-completion;
            completion-highlight: root.note-completion-highlight;
            view: root.note-view;
            view-height: root.note-view-height;
            marks: root.note-marks;
            caret-x: root.note-caret-x;
            caret-y: root.note-caret-y;
            caret-h: root.note-caret-h;
            caret-visible: root.note-caret-visible;
            caret-serial: root.note-caret-serial;
            canvas-focus-serial: root.note-canvas-focus-serial;
            canvas-cursor: root.note-canvas-cursor;
            canvas-width(w) => { root.note-canvas-width(w); }
            canvas-pressed(x, y, s, c) => { root.note-canvas-pressed(x, y, s, c); }
            canvas-dragged(x, y) => { root.note-canvas-dragged(x, y); }
            canvas-released(x, y) => { root.note-canvas-released(x, y); }
            canvas-hovered(x, y) => { root.note-canvas-hovered(x, y); }
            canvas-key(n) => {
                if (n == "ctrl+o" || n == "ctrl+\\") {
                    root.notes-quick-beside = n == "ctrl+\\";
                    root.notes-quick-moving = "";
                    root.notes-quick-search = false;
                    root.notes-quick-query = "";
                    root.notes-quick-highlight = 0;
                    root.notes-quick-open = true;
                    root.notes-quick-edited("");
                    return true;
                }
                return root.note-canvas-key(n);
            }
            bubble: root.note-bubble;
            card: root.note-card;
            card-title: root.note-card-title;
            card-text: root.note-card-text;
            card-picture: root.note-card-picture;
            completion-chosen(i) => { root.note-completion-chosen(i); }
            format(k) => { root.note-format(k); }
            card-open => { root.note-card-open(); }
            side: root.note-side;
            outline: root.note-outline;
            backlinks: root.note-backlinks;
            facts: root.note-facts;
            side-toggled => { root.note-side-toggled(); }
            outline-chosen(k) => { root.note-outline-chosen(k); }
            backlink-chosen(k) => { root.note-backlink-chosen(k); }
            reading: root.note-reading;
            reading-toggled => { root.note-reading-toggled(); }
            focus-mode: root.note-focus-mode;
            focus-mode-toggled => { root.note-focus-mode-toggled(); }
            has-cards: root.note-has-cards;
            revise => { root.note-revise(); }
            beside: root.note-beside;
            beside-title: root.note-beside-title;
            beside-closed => { root.note-beside-closed(); }
            sheet-open: root.note-sheet-open;
            new-sheet => { root.notes-new-sheet(); }
            graph => { root.notes-graph-requested(); }
            title-accepted(t) => { root.note-title-accepted(t); }
            escaped => { shortcuts.focus(); }
            end-clicked => { root.note-end-clicked(); }
            ctrl-changed(b) => { root.notes-ctrl-held = b; }
        }

        if root.workspace == 3: HomeView {
            x: root.rail;
            y: Layout.inset-top;
            width: parent.width - root.rail;
            height: parent.height - root.pied - Layout.inset-top;
            greeting: root.home-greeting;
            date: root.home-date;
            summary: root.home-summary;
            next: root.home-next;
            mail-count: root.home-mail-count;
            events-count: root.home-events-count;
            tasks-count: root.home-tasks-count;
            later: root.home-later;
            tasks: root.home-tasks;
            tasks-more: root.home-tasks-more;
            threads: root.home-threads;
            waiting: root.home-waiting;
            goal: root.home-goal;
            has-goal: root.home-has-goal;
            week-done: root.home-week-done;
            week-bars: root.home-week-bars;
            week-today: root.home-week-today;
            streak: root.inbox-zero-streak;
            accounts: root.home-accounts;
            last-sync: root.last-sync;
            notes: root.home-notes;
            cards-due: root.home-cards-due;
            note-opened(k) => { root.home-note-opened(k); shortcuts.focus(); }
            thread-opened(id) => { root.home-thread-opened(id); shortcuts.focus(); }
            goal-opened(id) => { root.home-goal-opened(id); shortcuts.focus(); }
            compose => {
                root.compose-minimised = false;
                root.compose-open = true;
            }
            opened(t) => { root.home-open(t); shortcuts.focus(); }
            task-opened(id) => { root.home-task-opened(id); shortcuts.focus(); }
            task-toggled(id) => { root.home-task-toggled(id); }
            event-opened(k) => { root.home-event-opened(k); }
            join(u) => { root.open-link(u); }
            habits: root.home-habits;
            habits-figure: root.home-habits-figure;
            habits-foot: root.home-habits-foot;
            habit-toggled(id) => { root.home-habit-toggled(id); }
        }

        // The habits, in Tasks: beside the tasks' column, drawn alone above.
        if root.workspace == 2 && root.tasks-habits: HabitsView {
            x: root.rail + (Layout.width-class == WidthClass.expanded ? 232px : 0px);
            visible: !root.tasks-column-open;
            y: Layout.inset-top;
            width: parent.width - self.x;
            height: parent.height - root.pied - Layout.inset-top;
            lists-requested => { root.tasks-column-open = true; }
            mode: root.habits-mode;
            title: root.habits-title;
            dates: root.habits-dates;
            note: root.habits-note;
            count: root.habits-count;
            rows: root.habits-rows;
            labels: root.habits-labels;
            today: root.habits-today;
            has-detail: root.habits-has-detail;
            detail: root.habits-detail;
            add-text <=> root.habits-add-text;
            focus-add-request: root.habits-focus-add;
            mode-chosen(m) => { root.habits-mode-chosen(m); }
            new-habit => { root.habit-new-requested(); }
            // Choosing a habit with the mouse hands the keyboard back to the shortcuts:
            // space then ticks it.
            selected(id) => {
                root.habit-selected(id);
                shortcuts.focus();
            }
            cell-clicked(id, d) => { root.habit-cell-clicked(id, d); }
            add(t) => { root.habit-quick-add(t); }
            edit => { root.habit-edit-requested(); }
            delete => { root.habit-delete-open = true; }
            closed => {
                root.habit-detail-closed();
                shortcuts.focus();
            }
            goal-opened(id) => {
                root.habit-goal-opened(id);
                shortcuts.focus();
            }
            amount-step(n) => { root.habit-amount-step(n); }
        }

        if root.task-list-menu-open: TaskListMenu {
            width: 100%;
            height: 100%;
            place: root.task-list-menu-place;
            // The last list stays: a task always has somewhere to go.
            can-delete: root.task-places.length > 5;
            menu-x: root.task-list-menu-x;
            menu-y: root.task-list-menu-y;
            rename => {
                root.task-list-menu-open = false;
                root.task-list-name-new = false;
                root.task-list-name = root.task-list-menu-place.name;
                root.task-list-name-open = true;
            }
            remove => {
                root.task-list-menu-open = false;
                root.task-list-delete-open = true;
            }
            dismissed => { root.task-list-menu-open = false; }
        }

        if root.task-list-name-open: TaskListNamePanel {
            width: 100%;
            height: 100%;
            is-new: root.task-list-name-new;
            name <=> root.task-list-name;
            error: root.task-list-name-error;
            confirmed => {
                root.task-list-name-confirmed(root.task-list-name-new,
                    root.task-list-menu-place.list-id, root.task-list-name);
            }
            dismissed => { root.task-list-name-open = false; }
        }

        if root.task-list-delete-open: TaskListDeletePanel {
            width: 100%;
            height: 100%;
            name: root.task-list-menu-place.name;
            count: root.task-list-menu-place.count;
            confirmed => {
                root.task-list-delete-open = false;
                root.task-list-delete-confirmed(root.task-list-menu-place.list-id);
            }
            dismissed => { root.task-list-delete-open = false; }
        }

        if root.task-later-open: LaterMenu {
            width: 100%;
            height: 100%;
            task: root.task-later-title;
            menu-x: root.task-later-x;
            menu-y: root.task-later-y;
            chosen(quand) => { root.task-later-chosen(quand); }
            pick-date => { root.task-later-pick-date(); }
            dismissed => { root.task-later-open = false; }
        }

        if root.task-slot-open: SlotPicker {
            width: 100%;
            height: 100%;
            day: root.task-slot-day;
            need: root.task-slot-need;
            busy: root.task-slot-busy;
