    /// The theme showing is dark. The style's own controls (check boxes, spin boxes,
    /// scroll bars) follow it: set by Rust each time it applies a theme.
    in property <bool> scheme-dark;
    changed scheme-dark => {
        Palette.color-scheme = root.scheme-dark ? ColorScheme.dark : ColorScheme.light;
    }
    // At first light, before any change: a light theme on a dark Windows must not keep
    // the style's dark controls.
    init => {
        Palette.color-scheme = root.scheme-dark ? ColorScheme.dark : ColorScheme.light;
        if (self.width > 0) {
            Layout.window-width = self.width;
        }
        if (self.height > 0) {
            Layout.window-height = self.height;
        }
        root.take-safe-area();
    }
    // What the system draws over the window (Android's status and gesture bars), as
    // the system reports it, again on every change: rotated, the keyboard's
    // navigation, a phone that ignores the request to keep its bars outside.
    function take-safe-area() {
        if (self.safe-area-insets.top > 0 || self.safe-area-insets.bottom > 0) {
            Layout.inset-top = self.safe-area-insets.top;
            Layout.inset-bottom = self.safe-area-insets.bottom;
        }
    }
    changed safe-area-insets => { root.take-safe-area(); }

    /// What a place shows over itself that is not a window and not in the history
    /// closes, one layer per call: a search, a task's or a habit's page, the tasks'
    /// column. True when something closed. Android's Back asks it after the windows.
    public function close-layer() -> bool {
        if (root.searching) {
            root.search-query = "";
            root.search-cleared();
            return true;
        }
        if (root.reading-focus) {
            root.reading-focus = false;
            return true;
        }
        if (root.workspace == 2 && root.tasks-column-open) {
            root.tasks-column-open = false;
            return true;
        }
        if (root.workspace == 2 && root.task-has-detail) {
            root.task-detail-closed();
            shortcuts.focus();
            return true;
        }
        if (root.workspace == 2 && root.habits-has-detail) {
            root.habit-detail-closed();
            shortcuts.focus();
            return true;
        }
        return false;
    }

    /// The place chosen again from the tabs: back to its first screen. The mail's
    /// list, out of the conversation and the mailboxes; the calendar on today; the
    /// tasks without a task open.
    function place-root() {
        if (root.searching) {
            root.search-query = "";
            root.search-cleared();
        }
        if (root.workspace == 0) {
            root.mailboxes-open = false;
            root.reading-focus = false;
            if (root.page != "") {
                root.page = "";
                root.navigated("page", "");
            }
        } else if (root.workspace == 1) {
            root.calendar-today();
        } else if (root.workspace == 2) {
            root.tasks-column-open = false;
            if (root.task-has-detail) { root.task-detail-closed(); }
            if (root.habits-has-detail) { root.habit-detail-closed(); }
        }
    }
    callback density-chosen(int);
    /// The text size chosen in Settings, in percent.
    callback text-size-chosen(int);

