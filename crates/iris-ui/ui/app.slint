    /// Something is written in the new-message window: closing it asks first.
    property <bool> compose-has-content: root.compose-to != "" || root.compose-cc != ""
        || root.compose-bcc != "" || root.compose-subject != "" || root.compose-body != ""
        || root.compose-attachments.length > 0;
    in property <[string]> compose-suggestions;
