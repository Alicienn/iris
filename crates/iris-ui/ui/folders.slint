import { Tokens } from "tokens.slint";
import { FolderNodeData } from "types.slint";
import { Icon, Icons, IconButton } from "icons.slint";
import { Floating } from "glass.slint";
import { MenuEntry, MenuSeparator, MenuSurface } from "menu.slint";
import { ListView, LineEdit } from "std-widgets.slint";

// Une ligne de l'arborescence.
//
// L'indentation est la seule chose qui dise la hiérarchie : pas de triangle de
// dépliage. Une arborescence de courrier fait deux niveaux dans la quasi-totalité des
// cas, et un dossier replié est un dossier qu'on ne trouve pas.
component FolderRow inherits Rectangle {
    in property <FolderNodeData> node;
    in property <bool> selected;
    in property <int> accounts-total;

    callback clicked();
    callback dropped();
    callback context-menu(length, length);

    // Un dossier de courrier se reconnaît à sa forme avant de se lire. Ceux que
    // l'utilisateur crée n'ont pas de rôle et prennent l'icône ordinaire.
    property <string> icon-for-role:
        root.node.role == "inbox" ? Icons.inbox
        : root.node.role == "sent" ? Icons.send
        : root.node.role == "drafts" ? Icons.pencil
        : root.node.role == "trash" ? Icons.trash
        : root.node.role == "junk" ? Icons.warning
        : root.node.role == "archive" ? Icons.archive
        : Icons.folder;

    height: 24px;
    border-radius: Tokens.radius-small;
    // Le survol d'un glisser se marque plus fort qu'un survol de souris : c'est le
    // moment où l'utilisateur doit être certain de l'endroit où il lâche, et une
    // nuance de gris de plus ne suffirait pas à le lui dire.
    background: depot.has-drag
        ? Tokens.accent.transparentize(0.75)
        : (root.selected
            ? Tokens.surface-active
            : (touch.has-hover ? Tokens.surface-hover : transparent));
    border-width: depot.has-drag ? 1px : 0px;
    border-color: Tokens.accent;
    animate background { duration: Tokens.instant; }

    // La cible du glisser **contient** la ligne, elle n'est pas posée à côté.
    //
    // Elle était déclarée en premier et vide, et la zone tactile de la ligne, déclarée
    // en dernier, passait par-dessus. Le pointeur ne descendait donc jamais jusqu'ici :
    // aucun cadre ne s'allumait à l'approche, aucun lâcher n'arrivait. Le symétrique
    // exact du défaut côté liste, et il fallait les deux pour que le geste marche.
    depot := DropArea {
        can-drop(event) => {
            return DragAction.move;
        }
        dropped(event) => {
            root.dropped();
            return DragAction.move;
        }

    accessible-role: list-item;
    accessible-label: root.node.name;
    accessible-item-selected: root.selected;
    accessible-description: root.node.count + " conversations, on "
        + root.node.accounts + " mailboxes";
    accessible-action-default => { root.clicked(); }

    Rectangle {
        x: 0;
        width: root.selected ? 2px : 0px;
        height: 100%;
        border-radius: 1px;
        background: Tokens.accent;
        animate width { duration: Tokens.instant; }
    }

    HorizontalLayout {
        padding-left: Tokens.space-2 + root.node.depth * 12px;
        padding-right: Tokens.space-1;
        spacing: Tokens.space-1;

        Icon {
            y: (parent.height - self.height) / 2;
            data: root.icon-for-role;
            size: 13px;
            tint: root.selected ? Tokens.text : Tokens.text-muted;
        }

        Text {
            text: root.node.name;
            font-size: Tokens.size-small;
            font-weight: root.selected ? Tokens.weight-bold : Tokens.weight-body;
            color: root.selected ? Tokens.text : Tokens.text-secondary;
            vertical-alignment: center;
            overflow: elide;
        }

        Rectangle {}

        // Un dossier qui n'est pas sur toutes les boîtes se signale. Sans cela
        // « Devis » a l'air d'être partout alors qu'il est sur trois comptes, et le
        // courrier rangé dedans semble disparaître depuis les autres.
        //
        // Jamais sur un dossier de rôle : « Spam » n'est pas absent d'une boîte qui
        // n'en a pas, il n'y a simplement rien reçu, et un avertissement sur les six
        // premières lignes de l'arborescence n'avertirait plus de rien.
        if !root.node.permanent && root.node.accounts > 0
            && root.node.accounts < root.accounts-total: Icon {
            y: (parent.height - self.height) / 2;
            data: Icons.exclamation;
            size: 11px;
            tint: Tokens.warning;
        }

        if root.node.count > 0: Text {
            text: root.node.count-label;
            font-size: Tokens.size-small;
            color: Tokens.text-muted;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        // Clic droit : renommer, supprimer. Les mêmes coordonnées absolues que
        // partout ailleurs, pour la même raison.
        pointer-event(event) => {
            if (event.button == PointerEventButton.right
                && event.kind == PointerEventKind.down) {
                root.context-menu(
                    self.absolute-position.x + self.mouse-x,
                    self.absolute-position.y + self.mouse-y);
            }
        }
        clicked => { root.clicked(); }
    }

    } // depot
}

// L'arborescence des dossiers.
export component FolderTree inherits VerticalLayout {
    in property <[FolderNodeData]> folders;
    in property <string> selected-path;
    in property <int> accounts-total;

    callback folder-selected(string);
    callback all-selected();
    callback new-folder();
    callback folder-dropped(string);
    callback folder-menu(string, length, length);

    spacing: 1px;

    HorizontalLayout {
        vertical-stretch: 0;
        height: 18px;

        Text {
            text: "FOLDERS";
            font-size: 9px;
            letter-spacing: 1px;
            color: Tokens.text-muted;
            vertical-alignment: center;
        }

        Rectangle {}

        IconButton {
            icon: Icons.plus;
            label: "New folder";
            button-size: 18px;
            icon-size: 12px;
            clicked => { root.new-folder(); }
        }
    }

    // « Tous » d'abord : sans cette ligne, on entre dans un dossier et plus rien ne
    // dit comment revenir à la vue complète.
    Rectangle {
        vertical-stretch: 0;
        height: 24px;
        border-radius: Tokens.radius-small;
        background: root.selected-path == ""
            ? Tokens.surface-active
            : (tout-touch.has-hover ? Tokens.surface-hover : transparent);

        accessible-role: list-item;
        accessible-label: "All folders";
        accessible-item-selected: root.selected-path == "";
        accessible-action-default => { root.all-selected(); }

        HorizontalLayout {
            padding-left: Tokens.space-2;
            spacing: Tokens.space-1;

            // Une pile de dossiers, pas l'icône de la boîte de réception : celle-ci
            // est juste en dessous, sur la ligne « Inbox », et deux lignes voisines
            // avec le même dessin donnent deux fois la même promesse.
            Icon {
                y: (parent.height - self.height) / 2;
                data: Icons.layers;
                size: 13px;
                tint: root.selected-path == "" ? Tokens.text : Tokens.text-muted;
            }
            Text {
                text: "All folders";
                font-size: Tokens.size-small;
                font-weight: root.selected-path == ""
                    ? Tokens.weight-bold
                    : Tokens.weight-body;
                color: root.selected-path == "" ? Tokens.text : Tokens.text-secondary;
                vertical-alignment: center;
            }
            Rectangle {}
        }

        tout-touch := TouchArea {
            clicked => { root.all-selected(); }
        }
    }

    ListView {
        vertical-stretch: 1;
        for node in root.folders: FolderRow {
            node: node;
            accounts-total: root.accounts-total;
            selected: node.path == root.selected-path;
            clicked => { root.folder-selected(node.path); }
            dropped => { root.folder-dropped(node.path); }
            context-menu(mx, my) => { root.folder-menu(node.path, mx, my); }
        }
    }
}

// La fenêtre « nouveau dossier ».
//
// Elle dit sur combien de boîtes le dossier va être créé, parce que c'est la partie
// surprenante : partout ailleurs, créer un dossier crée un dossier.
export component NewFolderPanel inherits Rectangle {
    in property <int> account-count;
    in property <string> parent-path;
    in property <string> error;
    in-out property <string> name;

    callback create();
    callback dismissed();

    background: Tokens.scrim;

    TouchArea {
        clicked => { root.dismissed(); }
    }

    Floating {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: min(420px, parent.width - 80px);
        height: 220px;

        TouchArea {}

        VerticalLayout {
            padding: Tokens.space-4;
            spacing: Tokens.space-3;

            HorizontalLayout {
                vertical-stretch: 0;
                height: 26px;

                Text {
                    text: "New folder";
                    font-family: Tokens.font-family;
                    font-size: Tokens.size-title;
                    font-weight: Tokens.weight-bold;
                    color: Tokens.text;
                    vertical-alignment: center;
                }
                Rectangle {}
                IconButton {
                    icon: Icons.window-close;
                    label: "Cancel";
                    button-size: 24px;
                    icon-size: 13px;
                    clicked => { root.dismissed(); }
                }
            }

            LineEdit {
                accessible-label: "Folder name";
                placeholder-text: "Quotes";
                font-size: Tokens.size-body;
                text <=> root.name;
                accepted => { root.create(); }
            }

            Text {
                text: root.parent-path == ""
                    ? "It will be created on all " + root.account-count + " mailboxes."
                    : "Inside " + root.parent-path + ", on all "
                        + root.account-count + " mailboxes.";
                font-size: Tokens.size-small;
                color: Tokens.text-muted;
                wrap: word-wrap;
            }

            if root.error != "": Text {
                text: root.error;
                font-size: Tokens.size-small;
                color: Tokens.error;
                wrap: word-wrap;
            }

            Rectangle {}

            HorizontalLayout {
                vertical-stretch: 0;
                height: 28px;
                spacing: Tokens.space-2;

                Rectangle {}

                Rectangle {
                    width: 110px;
                    border-radius: Tokens.radius-small;
                    background: Tokens.accent;

                    accessible-role: button;
                    accessible-label: "Create the folder";
                    accessible-enabled: root.name != "";
                    accessible-action-default => { root.create(); }

                    Text {
                        text: "Create";
                        font-size: Tokens.size-small;
                        font-weight: Tokens.weight-bold;
                        color: Tokens.accent-text;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    TouchArea {
                        clicked => { root.create(); }
                    }
                }
            }
        }
    }
}

// Le menu qu'un clic droit sur un dossier ouvre.
//
// Deux actions, et seulement sur les dossiers que quelqu'un a créés. La corbeille,
// les indésirables et la boîte de réception appartiennent au serveur : les proposer à
// la suppression offrirait un geste qui échouerait, ou pire, réussirait localement et
// les ferait revenir à la synchronisation suivante.
export component FolderContextMenu inherits Rectangle {
    in property <string> folder;
    in property <bool> permanent;
    in property <length> menu-x;
    in property <length> menu-y;

    callback rename();
    callback remove();
    callback dismissed();

    TouchArea {
        width: 100%;
        height: 100%;
        clicked => { root.dismissed(); }
    }

    MenuSurface {
        available-width: root.width;
        available-height: root.height;
        menu-x: root.menu-x;
        menu-y: root.menu-y;
        menu-width: 220px;
        menu-height: entries.preferred-height + 8px;

        entries := VerticalLayout {
            padding: 4px;

            HorizontalLayout {
                padding-left: Tokens.space-2;
                padding-right: Tokens.space-2;
                height: 22px;
                Text {
                    text: root.folder;
                    font-size: 9px;
                    letter-spacing: 0.5px;
                    color: Tokens.text-muted;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }

            MenuSeparator {}

            if root.permanent: HorizontalLayout {
                padding-left: Tokens.space-2;
                padding-right: Tokens.space-2;
                height: 26px;
                Text {
                    text: "The server owns this folder.";
                    font-size: Tokens.size-small;
                    color: Tokens.text-muted;
                    vertical-alignment: center;
                    wrap: word-wrap;
                }
            }

            if !root.permanent: MenuEntry {
                icon: Icons.pencil;
                label: "Rename…";
                activated => { root.rename(); root.dismissed(); }
            }

            if !root.permanent: MenuEntry {
                icon: Icons.trash;
                label: "Delete folder…";
                danger: true;
                activated => { root.remove(); root.dismissed(); }
            }
        }
    }
}

// Renommer un dossier.
export component RenameFolderPanel inherits Rectangle {
    in property <string> current;
    in property <string> error;
    in-out property <string> name;

    callback rename();
    callback dismissed();

    background: Tokens.scrim;

    TouchArea {
        clicked => { root.dismissed(); }
    }

    Floating {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: min(420px, parent.width - 80px);
        height: 200px;

        TouchArea {}

        VerticalLayout {
            padding: Tokens.space-4;
            spacing: Tokens.space-3;

            HorizontalLayout {
                vertical-stretch: 0;
                height: 26px;
                Text {
                    text: "Rename folder";
                    font-family: Tokens.font-family;
                    font-size: Tokens.size-title;
                    font-weight: Tokens.weight-bold;
                    color: Tokens.text;
                    vertical-alignment: center;
                }
                Rectangle {}
                IconButton {
                    icon: Icons.window-close;
                    label: "Cancel";
                    button-size: 24px;
                    icon-size: 13px;
                    clicked => { root.dismissed(); }
                }
            }

            LineEdit {
                accessible-label: "New folder name";
                font-size: Tokens.size-body;
                text <=> root.name;
                accepted => { root.rename(); }
            }

            Text {
                text: "Renamed on every mailbox that has it. The mail stays inside.";
                font-size: Tokens.size-small;
                color: Tokens.text-muted;
                wrap: word-wrap;
            }

            if root.error != "": Text {
                text: root.error;
                font-size: Tokens.size-small;
                color: Tokens.error;
                wrap: word-wrap;
            }

            Rectangle {}

            HorizontalLayout {
                vertical-stretch: 0;
                height: 28px;
                Rectangle {}
                Rectangle {
                    width: 110px;
                    border-radius: Tokens.radius-small;
                    background: Tokens.accent;

                    accessible-role: button;
                    accessible-label: "Rename the folder";
                    accessible-action-default => { root.rename(); }

                    Text {
                        text: "Rename";
                        font-size: Tokens.size-small;
                        font-weight: Tokens.weight-bold;
                        color: Tokens.accent-text;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    TouchArea {
                        clicked => { root.rename(); }
                    }
                }
            }
        }
    }
}
