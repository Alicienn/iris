import { Tokens } from "tokens.slint";
import { TextField } from "field.slint";
import { AccountRowData, AccountTagData } from "types.slint";
import { Glass } from "glass.slint";
import { Icon, Icons, IconButton } from "icons.slint";
import { MenuEntry, MenuSeparator, MenuSurface } from "menu.slint";
import { ListView, ScrollView } from "std-widgets.slint";
import { Nav, SectionTitle, SelectionMark } from "nav.slint";

component SectionLabel inherits SectionTitle {}

component AccountRow inherits Rectangle {
    in property <AccountRowData> account;
    in property <bool> selected;
    in property <bool> compact;
    /// Listed under a tag's title.
    in property <bool> nested;

    callback clicked();
    callback resume();
    callback sync();
    callback context-menu(length, length);
    /// A tag's title: its accounts folded away or back.
    callback fold-toggled();
    /// Where the chevron of a tag's title ends.
    property <length> fold-zone: 22px;

    /// A right click that landed on an open menu's veil, and where. The row under
    /// that point opens its own menu: without this, a second right click on another
    /// account closed nothing and opened nothing.
    in property <int> probe;
    in property <length> probe-x;
    in property <length> probe-y;

    changed probe => {
        if (!root.account.header
            && root.probe-x >= self.absolute-position.x
            && root.probe-x < self.absolute-position.x + self.width
            && root.probe-y >= self.absolute-position.y
            && root.probe-y < self.absolute-position.y + self.height) {
            root.context-menu(root.probe-x, root.probe-y);
        }
    }

    // Vrai pendant la seconde qui suit un clic sur la synchronisation.
    //
    // Le bouton renvoyait le geste dans le vide : la synchronisation d'une seule boîte
    // dure parfois moins d'une seconde et n'a pas d'état visible à elle, donc cliquer
    // ne produisait rien du tout à l'écran. On ne pouvait pas savoir si le clic avait
    // porté, et le réflexe est alors de recliquer.
    //
    // Ce qu'on montre n'est pas une animation décorative : la flèche devient une coche.
    // C'est le seul signe qui dise « c'est parti » plutôt que « ça tourne », et c'est la
    // vérité — la demande est envoyée, le reste se passe ailleurs et se lit dans la
    // barre d'état.
    property <bool> just-synced;

    confirmation := Timer {
        interval: 1200ms;
        running: root.just-synced;
        triggered => { root.just-synced = false; }
    }

    height: 26px;
    border-radius: Tokens.radius-small;
    background: Nav.background(root.selected, touch.has-hover);
    animate background { duration: Tokens.instant; }

    // A tag's title, when the accounts are grouped by tag. Read like a folder that
    // holds its accounts: a chevron that folds them away, the tag in its colour, its
    // name, how many. A click on it shows the mail of those accounts only.
    if root.account.header: HorizontalLayout {
        padding-left: root.compact ? 0px : 2px;
        padding-right: Tokens.space-1;
        spacing: 4px;
        alignment: root.compact ? LayoutAlignment.center : LayoutAlignment.stretch;

        if !root.compact: Rectangle {
            y: (parent.height - self.height) / 2;
            width: 18px;
            height: 18px;
            border-radius: 4px;
            background: touch.has-hover && touch.mouse-x < root.fold-zone
                ? Tokens.surface-active : transparent;

            accessible-role: button;
            accessible-label: (root.account.folded ? "Unfold " : "Fold ") + root.account.label;
            accessible-action-default => { root.fold-toggled(); }

            Icon {
                data: root.account.folded ? Icons.chevron-right : Icons.chevron-down;
                size: 10px;
                tint: Tokens.text-muted;
            }
        }
        Icon {
            y: (parent.height - self.height) / 2;
            data: Icons.tag;
            size: 13px;
            tint: root.account.tag-id == 0 ? Tokens.text-muted : root.account.tint;
        }
        if !root.compact: Text {
            text: root.account.label;
            font-size: Tokens.size-body;
            font-weight: Tokens.weight-bold;
            color: root.selected ? Tokens.text : Tokens.text-secondary;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }
        if !root.compact: Text {
            text: root.account.members;
            font-size: Tokens.size-small;
            color: Tokens.text-muted;
            vertical-alignment: center;
        }
    }

    accessible-role: list-item;
    accessible-label: root.account.label;
    accessible-item-selected: root.selected;
    accessible-description: root.account.header
        ? root.account.members + " accounts"
        : !root.account.needs-attention
        ? root.account.count + " to do"
        : root.account.problem != ""
            ? "Sync failed: " + root.account.problem
            : "Paused after repeated failures";
    accessible-action-default => { root.clicked(); }

    // The selected account gets a mark on its left edge, the same one the calendars
    // and the task lists use. Colour alone was carrying this before, and at these
    // opacities it was not carrying it at all.
    SelectionMark {
        on: root.selected;
        row-height: root.height;
    }

    if !root.account.header: HorizontalLayout {
        // Under a tag, a step in: the tag reads as the folder that holds them.
        padding-left: root.compact ? 14px : root.nested ? 26px : 10px;
        padding-right: Tokens.space-1;
        spacing: Tokens.space-2;
        alignment: root.compact ? LayoutAlignment.center : LayoutAlignment.stretch;

        // The mailbox's colour, as a dot like the calendars' and the lists'. It was
        // a bar, and beside the bar that marks the selected row it read as a second
        // selection.
        Rectangle {
            width: 8px;
            height: 8px;
            y: (parent.height - self.height) / 2;
            border-radius: 4px;
            background: root.account.tint;
        }

        // Une adresse tronquée est une adresse illisible.
        //
        // La colonne fait deux cents pixels et une adresse professionnelle en fait
        // davantage : « contact@ma-scierie… » et « contact@techni-eur… » ne se
        // distinguent que par ce que l'ellipse mange. Sur cent boîtes, deux qui se
        // ressemblent au début se ressemblent complètement, et l'infobulle est le seul
        // endroit où l'adresse entière tient sans élargir la colonne pour tout le monde.
        if !root.compact: Text {
            text: root.account.label;
            font-size: Tokens.size-body;
            font-weight: root.selected ? Tokens.weight-bold : Tokens.weight-body;
            color: root.selected ? Tokens.text : Tokens.text-secondary;
            vertical-alignment: center;
            overflow: elide;

            Tooltip {
                text: @markdown("\{root.account.label}");
            }
        }

        Rectangle {}

        // A paused account is a problem the user has to be able to act on, so the
        // marker is a button. Signalling a fault without offering the gesture that
        // repairs it sends people hunting for something that is already on screen.
        //
        // A bare exclamation in red, not a warning triangle: the triangle is the
        // glyph for "careful", and this is not a caution, it is a mailbox that has
        // stopped working. Red carries that on its own at thirteen pixels, where the
        // triangle's outline mostly reads as a smudge.
        // `y` explicite, comme tout ce qui l'entoure dans cette rangée.
        //
        // Un `IconButton` a une hauteur fixe ; dans une disposition horizontale, un
        // enfant de hauteur fixe se pose en haut de sa case. Il flottait donc au-dessus
        // de la ligne de texte, décalé de trois pixels vers le haut, sur une rangée de
        // vingt-six. La pastille de couleur et le compteur, eux, se centraient déjà —
        // c'est ce décalage entre voisins qui se voyait, plus que la position elle-même.
        if root.account.needs-attention: IconButton {
            y: (parent.height - self.height) / 2;
            icon: Icons.exclamation;
            // The tooltip says what failed, so the mark answers "what is wrong"
            // before the click answers "what do I do".
            label: root.account.problem != ""
                ? "Sync failed: " + root.account.problem + ". Click for details."
                : "Fix " + root.account.label;
            icon-size: 15px;
            button-size: 20px;
            tint: Tokens.error;
            tinted: true;
            clicked => { root.resume(); }
        }

        // Syncing one mailbox on demand, without waiting for the schedule or
        // dragging the other ninety-nine along with it.
        //
        // Visible aussi pendant la confirmation : le bouton n'apparaît qu'au survol, et
        // sans cela la coche disparaîtrait avec le curseur — c'est-à-dire au moment
        // précis où l'on regarde ailleurs pour voir ce qui s'est passé.
        if (touch.has-hover || root.just-synced)
            && !root.compact && !root.account.needs-attention: IconButton {
            y: (parent.height - self.height) / 2;
            icon: root.just-synced ? Icons.check : Icons.refresh;
            label: root.just-synced
                ? "Syncing " + root.account.label + "…"
                : "Sync " + root.account.label;
            icon-size: 13px;
            button-size: 20px;
            tint: Tokens.accent;
            tinted: root.just-synced;
            active: root.just-synced;
            clicked => {
                root.just-synced = true;
                root.sync();
            }
        }

        if !root.compact && root.account.count > 0
            && !touch.has-hover && !root.just-synced: Text {
            text: root.account.count-label;
            font-size: Tokens.size-small;
            color: Tokens.text-muted;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        // Right-click reaches the account's own actions, the same way it reaches a
        // thread's. A mailbox whose password has changed is the case that matters:
        // the settings screen is three clicks and a scroll away from the row that is
        // already telling you something is wrong.
        pointer-event(event) => {
            if (!root.account.header && event.button == PointerEventButton.right
                && event.kind == PointerEventKind.down) {
                // Absolue, comme pour les lignes de messages : la liste des comptes
                // est virtualisée elle aussi, et `root.y` y désigne une position dans
                // le viewport, pas à l'écran.
                root.context-menu(
                    self.absolute-position.x + self.mouse-x,
                    self.absolute-position.y + self.mouse-y);
            }
        }
        // On a tag's title the chevron folds, the rest shows the tag's mail. One
        // touch area reads where it was hit, as the message rows do: two areas one
        // above the other would fight over the click.
        clicked => {
            if (root.account.header && !root.compact && self.mouse-x < root.fold-zone) {
                root.fold-toggled();
            } else {
                root.clicked();
            }
        }
    }
}

// La barre latérale : les comptes.
//
// Avec cent boîtes, l'ordre de création n'a aucun sens. Trois sections seulement :
// la vue unifiée, les comptes épinglés, puis le reste — filtrable, parce qu'on ne
// parcourt pas cent lignes à l'œil.
//
// It collapses to a strip of colour bars. On a laptop the accounts column is the
// least useful two hundred pixels on screen once you know which mailbox you are in,
// and it is the obvious thing to give back to the message list.
export component Sidebar inherits Glass {
    in property <[AccountRowData]> pinned;
    in property <[AccountRowData]> others;
    in property <int> selected-id;
    in property <int> unified-count;
    in property <string> unified-label;
    in property <string> unified-full;
    in property <bool> syncing;
    in property <string> sync-progress;
    in-out property <string> filter;
    in-out property <bool> collapsed;
    /// The accounts are listed under their tags.
    in property <bool> grouped;
    /// The tag whose accounts' mail is shown, -1 for none (0 is "No tag").
    in property <int> selected-tag: -1;
    in property <int> probe;
    in property <length> probe-x;
    in property <length> probe-y;

    callback account-selected(int);
    callback group-toggled();
    /// A tag's title clicked: the mail of its accounts.
    callback tag-selected(int);
    callback tag-fold-toggled(int);
    callback open-tags();
    callback unified-selected();
    callback resume-account(int);
    callback add-account();
    callback filter-changed(string);
    callback sync-account(int);
    callback sync-all();
    callback open-settings();
    callback open-modules();
    callback account-menu(int, length, length);

    radius: 0px;
    border-width: 0px;
    // No clipping here, deliberately. It would contain the row above, but it would
    // also cut every tooltip these buttons raise, and a tooltip that stops at the
    // panel edge is worse than the overflow it prevents. The row is fixed where it
    // was broken instead: the filter field can now shrink.

    VerticalLayout {
        padding: Tokens.space-2;
        spacing: Tokens.space-1;

        // --- Top row: filter, add, collapse ---
        HorizontalLayout {
            spacing: Tokens.space-1;
            vertical-stretch: 0;
            height: 26px;
            // Alone in the collapsed rail, the chevron sat against the left edge.
            alignment: root.collapsed ? LayoutAlignment.center : LayoutAlignment.stretch;

            if !root.collapsed: TextField {
                accessible-label: "Filter accounts";
                placeholder-text: "Filter…";
                font-size: Tokens.size-small;
                // A LineEdit asks for a comfortable width and gets it: with two
                // buttons beside it the row wanted more than the column has, and a
                // horizontal layout that cannot fit its children does not shrink
                // them — it overflows. The chevron was landing in the message list.
                min-width: 40px;
                horizontal-stretch: 1;
                text <=> root.filter;
                // The filtering happens in Rust, over the real list. Doing it here
                // would mean the interface deciding what exists, and it was doing
                // neither: the field was wired to nothing at all.
                edited(t) => { root.filter-changed(t); }
            }

            if !root.collapsed: IconButton {
                icon: Icons.plus;
                label: "Add an account";
                button-size: 24px;
                horizontal-stretch: 0;
                clicked => { root.add-account(); }
            }

            IconButton {
                icon: root.collapsed ? Icons.chevron-right : Icons.chevron-left;
                label: root.collapsed ? "Show account names" : "Collapse the accounts";
                button-size: 24px;
                horizontal-stretch: 0;
                clicked => { root.collapsed = !root.collapsed; }
            }
        }

        if !root.collapsed: SectionLabel { text: "UNIFIED"; }

        AccountRow {
            compact: root.collapsed;
            account: {
                id: 0,
                label: "All accounts",
                count: root.unified-count,
                count-label: root.unified-label,
                count-full: root.unified-full,
                pinned: false,
                needs-attention: false,
                tint: Tokens.text-muted,
            };
            selected: root.selected-tag < 0 && root.selected-id == 0;
            clicked => { root.unified-selected(); }
            sync => { root.sync-all(); }
        }

        if !root.collapsed && root.pinned.length > 0: SectionLabel { text: "PINNED"; }

        for account in root.pinned: AccountRow {
            account: account;
            compact: root.collapsed;
            selected: root.selected-tag < 0 && account.id == root.selected-id;
            probe: root.probe;
            probe-x: root.probe-x;
            probe-y: root.probe-y;
            clicked => { root.account-selected(account.id); }
            resume => { root.resume-account(account.id); }
            sync => { root.sync-account(account.id); }
            context-menu(mx, my) => { root.account-menu(account.id, mx, my); }
        }

        // The title of the list, and beside it the switch that groups it by tag: the
        // choice sits where its effect shows.
        if !root.collapsed: HorizontalLayout {
            height: 18px;
            vertical-stretch: 0;
            SectionLabel {
                text: root.grouped ? "ACCOUNTS BY TAG" : "ACCOUNTS";
                vertical-alignment: center;
            }
            Rectangle {}
            IconButton {
                y: (parent.height - self.height) / 2;
                icon: Icons.tag;
                label: root.grouped ? "Show accounts in one list" : "Group accounts by tag";
                button-size: 18px;
                icon-size: 11px;
                active: root.grouped;
                tinted: root.grouped;
                tint: Tokens.accent;
                clicked => { root.group-toggled(); }
            }
        }

        // La liste des autres comptes est virtualisée : cent lignes ne doivent pas
        // coûter cent éléments vivants.
        ListView {
            vertical-stretch: 1;
            for account in root.others: AccountRow {
                account: account;
                compact: root.collapsed;
                nested: root.grouped;
                selected: account.header
                    ? account.tag-id == root.selected-tag
                    : root.selected-tag < 0 && account.id == root.selected-id;
                probe: root.probe;
                probe-x: root.probe-x;
                probe-y: root.probe-y;
                fold-toggled => { root.tag-fold-toggled(account.tag-id); }
                clicked => {
                    if (account.header) {
                        root.tag-selected(account.tag-id);
                    } else {
                        root.account-selected(account.id);
                    }
                }
                resume => { root.resume-account(account.id); }
                sync => { root.sync-account(account.id); }
                context-menu(mx, my) => { root.account-menu(account.id, mx, my); }
            }
        }

        // Nothing matched the filter. Saying so beats an empty column, which reads as
        // "there are no accounts" rather than "none of them are called that".
        if !root.collapsed && root.others.length == 0 && root.pinned.length == 0
            && root.filter != "": Text {
            text: "No account matches.";
            font-size: Tokens.size-small;
            color: Tokens.text-muted;
        }

        // --- Bottom row: sync everything, and the way into settings ---
        Rectangle { height: 1px; background: Tokens.border; }

        // Collapsed, the column has 28px of content for a row that wants 112: the
        // row overflowed into the folders column, where three of its four buttons
        // sat half-hidden behind the folders' glass. Stacked, they fit, and each
        // keeps its tooltip — which also carries the progress the text had shown.
        if root.collapsed: HorizontalLayout {
            alignment: center;
            vertical-stretch: 0;

            VerticalLayout {
                spacing: Tokens.space-1;

                IconButton {
                    icon: Icons.refresh;
                    label: !root.syncing ? "Sync all accounts"
                        : root.sync-progress != "" ? "Syncing… " + root.sync-progress
                        : "Syncing…";
                    shortcut: "F5";
                    button-size: 24px;
                    active: root.syncing;
                    clicked => { root.sync-all(); }
                }
                IconButton {
                    icon: Icons.blocks;
                    label: "Modules: rules and plugins";
                    button-size: 24px;
                    clicked => { root.open-modules(); }
                }
                IconButton {
                    icon: Icons.tag;
                    label: "Manage tags";
                    button-size: 24px;
                    clicked => { root.open-tags(); }
                }
                IconButton {
                    icon: Icons.gear;
                    label: "Settings";
                    shortcut: "Ctrl+,";
                    button-size: 24px;
                    clicked => { root.open-settings(); }
                }
            }
        }

        if !root.collapsed: HorizontalLayout {
            spacing: Tokens.space-1;
            vertical-stretch: 0;
            height: 26px;

            IconButton {
                icon: Icons.refresh;
                label: root.syncing ? "Syncing…" : "Sync all accounts";
                shortcut: "F5";
                button-size: 24px;
                active: root.syncing;
                clicked => { root.sync-all(); }
            }

            if root.sync-progress != "": Text {
                text: root.sync-progress;
                font-size: Tokens.size-small;
                color: Tokens.text-muted;
                vertical-alignment: center;
                overflow: elide;
            }

            Rectangle {}

            // Les modules, puis les tags des adresses, à côté des réglages.
            IconButton {
                icon: Icons.blocks;
                label: "Modules: rules and plugins";
                button-size: 24px;
                clicked => { root.open-modules(); }
            }

            IconButton {
                icon: Icons.tag;
                label: "Manage tags";
                button-size: 24px;
                clicked => { root.open-tags(); }
            }

            IconButton {
                icon: Icons.gear;
                label: "Settings";
                shortcut: "Ctrl+,";
                button-size: 24px;
                clicked => { root.open-settings(); }
            }
        }
    }
}

// What a right-click on an account offers.
//
// Everything here was already possible and none of it was reachable from the row it
// applies to: syncing meant hovering for a button that only appears on hover, and
// changing a password meant the account failing first so the warning marker would
// appear. An account whose password you know has changed should not have to break
// before you can fix it.
export component AccountContextMenu inherits Rectangle {
    in property <string> account;
    in property <bool> enabled: true;
    in property <bool> pinned;
    in property <length> menu-x;
    in property <length> menu-y;
    /// The tags, each ticked if this account carries it — already filtered by the
    /// search, in Rust.
    in property <[AccountTagData]> tags;
    in-out property <bool> tags-open;
    in-out property <string> tag-search;

    callback sync-now();
    callback edit-account();
    callback change-password();
    callback edit-signature();
    callback toggle-pinned();
    callback toggle-enabled();
    callback remove-account();
    callback dismissed();
    callback tag-toggled(int);
    callback tag-search-changed(string);
    callback tag-created(string);
    callback manage-tags();
    /// A right click outside the menu: it closes, and whatever was under the pointer
    /// may open its own.
    callback reopen-at(length, length);

    // Escape from the search field folds the tags first, then closes the menu.
    FocusScope {
        enabled: false;
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                if (root.tags-open) {
                    root.tags-open = false;
                } else {
                    root.dismissed();
                }
                return accept;
            }
            return reject;
        }

    TouchArea {
        width: 100%;
        height: 100%;
        clicked => { root.dismissed(); }
        pointer-event(event) => {
            if (event.button == PointerEventButton.right && event.kind == PointerEventKind.down) {
                // Passed on first, while this menu still exists; closed after.
                root.reopen-at(self.absolute-position.x + self.mouse-x,
                    self.absolute-position.y + self.mouse-y);
                root.dismissed();
            }
        }
    }

    if root.tags-open: MenuSurface {
        available-width: root.width;
        available-height: root.height;
        menu-x: root.menu-x + 232px;
        menu-y: root.menu-y + 96px;
        menu-width: 220px;
        menu-height: choix.preferred-height + 8px;

        choix := VerticalLayout {
            padding: 4px;
            spacing: 2px;

            TextField {
                accessible-label: "Search tags";
                placeholder-text: "Search or create a tag";
                font-size: Tokens.size-small;
                text <=> root.tag-search;
                // Opened to find a tag: the first key searches.
                init => { self.focus(); }
                edited(t) => { root.tag-search-changed(t); }
                accepted(t) => {
                    if (root.tags.length == 0 && t != "") {
                        root.tag-created(t);
                    } else if (root.tags.length == 1) {
                        root.tag-toggled(root.tags[0].id);
                    }
                }
            }

            // Scrolls past eight tags: a hundred of them must not make the menu
            // taller than the window.
            ScrollView {
                height: min(root.tags.length * 28px, 224px);
                visible: root.tags.length > 0;
                VerticalLayout {
                    for tag in root.tags: Rectangle {
                        height: 28px;
                        border-radius: Tokens.radius-small;
                        background: choix-touch.has-hover ? Tokens.surface-hover : transparent;

                        accessible-role: checkbox;
                        accessible-label: tag.name;
                        accessible-checked: tag.checked;
                        accessible-action-default => { root.tag-toggled(tag.id); }

                        HorizontalLayout {
                            padding-left: Tokens.space-2;
                            padding-right: Tokens.space-2;
                            spacing: Tokens.space-2;
                            Rectangle {
                                y: (parent.height - self.height) / 2;
                                width: 14px;
                                height: 14px;
                                border-radius: 4px;
                                border-width: 1.5px;
                                border-color: tag.color;
                                background: tag.checked ? tag.color : transparent;
                                if tag.checked: Icon {
                                    data: Icons.check;
                                    size: 10px;
                                    weight: 3.0;
                                    tint: white;
                                }
                            }
                            Text {
                                text: tag.name;
                                font-size: Tokens.size-small;
                                color: Tokens.text;
                                vertical-alignment: center;
                                overflow: elide;
                                horizontal-stretch: 1;
                            }
                        }
                        choix-touch := TouchArea {
                            clicked => { root.tag-toggled(tag.id); }
                        }
                    }
                }
            }

            if root.tags.length == 0 && root.tag-search != "": MenuEntry {
                icon: Icons.plus;
                label: "Create “" + root.tag-search + "”";
                activated => { root.tag-created(root.tag-search); }
            }
            if root.tags.length == 0 && root.tag-search == "": Text {
                height: 26px;
                text: "No tags yet.";
                font-size: Tokens.size-small;
                color: Tokens.text-muted;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            MenuSeparator {}
            MenuEntry {
                icon: Icons.pencil;
                label: "Manage tags…";
                activated => { root.manage-tags(); root.dismissed(); }
            }
        }
    }

    MenuSurface {
        available-width: root.width;
        available-height: root.height;
        menu-x: root.menu-x;
        menu-y: root.menu-y;
        menu-width: 230px;
        menu-height: entries.preferred-height + 8px;

        entries := VerticalLayout {
            padding: 4px;

            // The address, so a menu opened on the wrong row says so before anything
            // is done to it.
            HorizontalLayout {
                padding-left: Tokens.space-2;
                padding-right: Tokens.space-2;
                height: 22px;
                Text {
                    text: root.account;
                    font-size: 9px;
                    letter-spacing: 0.5px;
                    color: Tokens.text-muted;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }

            MenuSeparator {}

            MenuEntry {
                icon: Icons.refresh;
                label: "Sync now";
                activated => { root.sync-now(); root.dismissed(); }
            }
            MenuEntry {
                icon: Icons.key;
                label: "Change password…";
                activated => { root.change-password(); root.dismissed(); }
            }
            MenuEntry {
                icon: Icons.pencil;
                label: "Edit account…";
                activated => { root.edit-account(); root.dismissed(); }
            }
            // Par compte, et donc ici plutôt que dans les réglages généraux : c'est la
            // raison d'avoir plusieurs comptes qu'on ne signe pas une facture comme on
            // écrit à sa sœur.
            MenuEntry {
                icon: Icons.quote;
                label: "Signature…";
                activated => { root.edit-signature(); root.dismissed(); }
            }

            // Opens beside the menu rather than replacing it: the account stays named
            // at the top while its tags are chosen.
            MenuEntry {
                icon: Icons.tag;
                label: "Tags";
                shortcut: root.tags-open ? "‹" : "›";
                activated => { root.tags-open = !root.tags-open; }
            }

            MenuSeparator {}

            MenuEntry {
                icon: Icons.star;
                label: root.pinned ? "Unpin" : "Pin to the top";
                activated => { root.toggle-pinned(); root.dismissed(); }
            }
            MenuEntry {
                icon: root.enabled ? Icons.window-close : Icons.check;
                label: root.enabled ? "Disable" : "Enable";
                activated => { root.toggle-enabled(); root.dismissed(); }
            }

            MenuSeparator {}

            MenuEntry {
                icon: Icons.trash;
                label: "Remove from Iris…";
                danger: true;
                activated => { root.remove-account(); root.dismissed(); }
            }
        }
    }
    }
}
