import { Tokens } from "tokens.slint";
import { AccountRowData } from "types.slint";
import { Glass } from "glass.slint";
import { Icon, Icons, IconButton } from "icons.slint";
import { MenuEntry, MenuSeparator, MenuSurface } from "menu.slint";
import { ListView, LineEdit } from "std-widgets.slint";

component SectionLabel inherits Text {
    font-size: 9px;
    letter-spacing: 1px;
    color: Tokens.text-muted;
}

component AccountRow inherits Rectangle {
    in property <AccountRowData> account;
    in property <bool> selected;
    in property <bool> compact;

    callback clicked();
    callback resume();
    callback sync();
    callback context-menu(length, length);

    height: 26px;
    border-radius: Tokens.radius-small;
    background: root.selected
        ? Tokens.surface-active
        : (touch.has-hover ? Tokens.surface-hover : transparent);
    animate background { duration: Tokens.instant; }

    accessible-role: list-item;
    accessible-label: root.account.label;
    accessible-item-selected: root.selected;
    accessible-description: root.account.needs-attention
        ? "Paused after repeated failures"
        : root.account.count + " to do";
    accessible-action-default => { root.clicked(); }

    // The selected account gets a bar on its left edge, the same marker the message
    // list uses. Colour alone was carrying this before, and at these opacities it was
    // not carrying it at all.
    Rectangle {
        x: 0;
        width: root.selected ? 2px : 0px;
        height: 100%;
        border-radius: 1px;
        background: Tokens.accent;
        animate width { duration: Tokens.instant; }
    }

    HorizontalLayout {
        padding-left: Tokens.space-2;
        padding-right: Tokens.space-1;
        spacing: Tokens.space-2;

        Rectangle {
            width: 3px;
            height: 12px;
            y: (parent.height - self.height) / 2;
            border-radius: 2px;
            background: root.account.tint;
        }

        if !root.compact: Text {
            text: root.account.label;
            font-size: Tokens.size-body;
            font-weight: root.selected ? Tokens.weight-bold : Tokens.weight-body;
            color: root.selected ? Tokens.text : Tokens.text-secondary;
            vertical-alignment: center;
            overflow: elide;
        }

        Rectangle {}

        // A paused account is a problem the user has to be able to act on, so the
        // marker is a button. Signalling a fault without offering the gesture that
        // repairs it sends people hunting for something that is already on screen.
        //
        // A bare exclamation in red, not a warning triangle: the triangle is the
        // glyph for "careful", and this is not a caution, it is a mailbox that has
        // stopped working. Red carries that on its own at thirteen pixels, where the
        // triangle's outline mostly reads as a smudge.
        if root.account.needs-attention: IconButton {
            icon: Icons.exclamation;
            label: "Fix " + root.account.label;
            icon-size: 15px;
            button-size: 20px;
            tint: Tokens.error;
            tinted: true;
            clicked => { root.resume(); }
        }

        // Syncing one mailbox on demand, without waiting for the schedule or
        // dragging the other ninety-nine along with it.
        if touch.has-hover && !root.compact && !root.account.needs-attention: IconButton {
            icon: Icons.refresh;
            label: "Sync " + root.account.label;
            icon-size: 13px;
            button-size: 20px;
            clicked => { root.sync(); }
        }

        if !root.compact && root.account.count > 0 && !touch.has-hover: Text {
            text: root.account.count-label;
            font-size: Tokens.size-small;
            color: Tokens.text-muted;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        // Right-click reaches the account's own actions, the same way it reaches a
        // thread's. A mailbox whose password has changed is the case that matters:
        // the settings screen is three clicks and a scroll away from the row that is
        // already telling you something is wrong.
        pointer-event(event) => {
            if (event.button == PointerEventButton.right
                && event.kind == PointerEventKind.down) {
                root.context-menu(self.mouse-x + root.x, self.mouse-y + root.y);
            }
        }
        clicked => { root.clicked(); }
    }
}

// La barre latérale : les comptes.
//
// Avec cent boîtes, l'ordre de création n'a aucun sens. Trois sections seulement :
// la vue unifiée, les comptes épinglés, puis le reste — filtrable, parce qu'on ne
// parcourt pas cent lignes à l'œil.
//
// It collapses to a strip of colour bars. On a laptop the accounts column is the
// least useful two hundred pixels on screen once you know which mailbox you are in,
// and it is the obvious thing to give back to the message list.
export component Sidebar inherits Glass {
    in property <[AccountRowData]> pinned;
    in property <[AccountRowData]> others;
    in property <int> selected-id;
    in property <int> unified-count;
    in property <string> unified-label;
    in property <string> unified-full;
    in property <bool> syncing;
    in property <string> sync-progress;
    in-out property <string> filter;
    in-out property <bool> collapsed;

    callback account-selected(int);
    callback unified-selected();
    callback resume-account(int);
    callback add-account();
    callback filter-changed(string);
    callback sync-account(int);
    callback sync-all();
    callback open-settings();
    callback account-menu(int, length, length);

    radius: 0px;
    border-width: 0px;
    // No clipping here, deliberately. It would contain the row above, but it would
    // also cut every tooltip these buttons raise, and a tooltip that stops at the
    // panel edge is worse than the overflow it prevents. The row is fixed where it
    // was broken instead: the filter field can now shrink.

    VerticalLayout {
        padding: Tokens.space-2;
        spacing: Tokens.space-1;

        // --- Top row: filter, add, collapse ---
        HorizontalLayout {
            spacing: Tokens.space-1;
            vertical-stretch: 0;
            height: 26px;

            if !root.collapsed: LineEdit {
                accessible-label: "Filter accounts";
                placeholder-text: "Filter…";
                font-size: Tokens.size-small;
                // A LineEdit asks for a comfortable width and gets it: with two
                // buttons beside it the row wanted more than the column has, and a
                // horizontal layout that cannot fit its children does not shrink
                // them — it overflows. The chevron was landing in the message list.
                min-width: 40px;
                horizontal-stretch: 1;
                text <=> root.filter;
                // The filtering happens in Rust, over the real list. Doing it here
                // would mean the interface deciding what exists, and it was doing
                // neither: the field was wired to nothing at all.
                edited(t) => { root.filter-changed(t); }
            }

            if !root.collapsed: IconButton {
                icon: Icons.plus;
                label: "Add an account";
                button-size: 24px;
                horizontal-stretch: 0;
                clicked => { root.add-account(); }
            }

            IconButton {
                icon: root.collapsed ? Icons.chevron-right : Icons.chevron-left;
                label: root.collapsed ? "Show account names" : "Collapse the accounts";
                button-size: 24px;
                horizontal-stretch: 0;
                clicked => { root.collapsed = !root.collapsed; }
            }
        }

        if !root.collapsed: SectionLabel { text: "UNIFIED"; }

        AccountRow {
            compact: root.collapsed;
            account: {
                id: 0,
                label: "All accounts",
                count: root.unified-count,
                count-label: root.unified-label,
                count-full: root.unified-full,
                pinned: false,
                needs-attention: false,
                tint: Tokens.text-muted,
            };
            selected: root.selected-id == 0;
            clicked => { root.unified-selected(); }
            sync => { root.sync-all(); }
        }

        if !root.collapsed && root.pinned.length > 0: SectionLabel { text: "PINNED"; }

        for account in root.pinned: AccountRow {
            account: account;
            compact: root.collapsed;
            selected: account.id == root.selected-id;
            clicked => { root.account-selected(account.id); }
            resume => { root.resume-account(account.id); }
            sync => { root.sync-account(account.id); }
            context-menu(mx, my) => { root.account-menu(account.id, mx, my + self.y); }
        }

        if !root.collapsed && root.others.length > 0: SectionLabel { text: "ACCOUNTS"; }

        // La liste des autres comptes est virtualisée : cent lignes ne doivent pas
        // coûter cent éléments vivants.
        ListView {
            vertical-stretch: 1;
            for account in root.others: AccountRow {
                account: account;
                compact: root.collapsed;
                selected: account.id == root.selected-id;
                clicked => { root.account-selected(account.id); }
                resume => { root.resume-account(account.id); }
                sync => { root.sync-account(account.id); }
                context-menu(mx, my) => { root.account-menu(account.id, mx, my + parent.y); }
            }
        }

        // Nothing matched the filter. Saying so beats an empty column, which reads as
        // "there are no accounts" rather than "none of them are called that".
        if !root.collapsed && root.others.length == 0 && root.pinned.length == 0
            && root.filter != "": Text {
            text: "No account matches.";
            font-size: Tokens.size-small;
            color: Tokens.text-muted;
        }

        // --- Bottom row: sync everything, and the way into settings ---
        Rectangle { height: 1px; background: Tokens.border; }

        HorizontalLayout {
            spacing: Tokens.space-1;
            vertical-stretch: 0;
            height: 26px;

            IconButton {
                icon: Icons.refresh;
                label: root.syncing ? "Syncing…" : "Sync all accounts";
                shortcut: "F5";
                button-size: 24px;
                active: root.syncing;
                clicked => { root.sync-all(); }
            }

            if !root.collapsed && root.sync-progress != "": Text {
                text: root.sync-progress;
                font-size: Tokens.size-small;
                color: Tokens.text-muted;
                vertical-alignment: center;
                overflow: elide;
            }

            Rectangle {}

            IconButton {
                icon: Icons.gear;
                label: "Settings";
                shortcut: "Ctrl+,";
                button-size: 24px;
                clicked => { root.open-settings(); }
            }
        }
    }
}

// What a right-click on an account offers.
//
// Everything here was already possible and none of it was reachable from the row it
// applies to: syncing meant hovering for a button that only appears on hover, and
// changing a password meant the account failing first so the warning marker would
// appear. An account whose password you know has changed should not have to break
// before you can fix it.
export component AccountContextMenu inherits Rectangle {
    in property <string> account;
    in property <bool> enabled: true;
    in property <bool> pinned;
    in property <length> menu-x;
    in property <length> menu-y;

    callback sync-now();
    callback edit-account();
    callback change-password();
    callback toggle-pinned();
    callback toggle-enabled();
    callback remove-account();
    callback dismissed();

    TouchArea {
        width: 100%;
        height: 100%;
        clicked => { root.dismissed(); }
    }

    MenuSurface {
        available-width: root.width;
        available-height: root.height;
        menu-x: root.menu-x;
        menu-y: root.menu-y;
        menu-width: 230px;
        menu-height: entries.preferred-height + 8px;

        entries := VerticalLayout {
            padding: 4px;

            // The address, so a menu opened on the wrong row says so before anything
            // is done to it.
            HorizontalLayout {
                padding-left: Tokens.space-2;
                padding-right: Tokens.space-2;
                height: 22px;
                Text {
                    text: root.account;
                    font-size: 9px;
                    letter-spacing: 0.5px;
                    color: Tokens.text-muted;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }

            MenuSeparator {}

            MenuEntry {
                icon: Icons.refresh;
                label: "Sync now";
                activated => { root.sync-now(); root.dismissed(); }
            }
            MenuEntry {
                icon: Icons.key;
                label: "Change password…";
                activated => { root.change-password(); root.dismissed(); }
            }
            MenuEntry {
                icon: Icons.pencil;
                label: "Edit account…";
                activated => { root.edit-account(); root.dismissed(); }
            }

            MenuSeparator {}

            MenuEntry {
                icon: Icons.star;
                label: root.pinned ? "Unpin" : "Pin to the top";
                activated => { root.toggle-pinned(); root.dismissed(); }
            }
            MenuEntry {
                icon: root.enabled ? Icons.window-close : Icons.check;
                label: root.enabled ? "Disable" : "Enable";
                activated => { root.toggle-enabled(); root.dismissed(); }
            }

            MenuSeparator {}

            MenuEntry {
                icon: Icons.trash;
                label: "Remove from Iris…";
                danger: true;
                activated => { root.remove-account(); root.dismissed(); }
            }
        }
    }
}
